# Copy to .env at the repository root and adjust. One file serves both halves: the api reads it
# through `process.loadEnvFile`, and vite reads it because `envDir` points here.

# =================================================================================================
# Backend - the api
#
# Every variable in this section is declared in backend/src/env.ts through `loadConfig`, which
# reports all missing ones in a single boot error rather than dying on the first. None of them
# reaches the browser: vite hands the bundle only names that start with `VITE_`.
# =================================================================================================

# The port this process binds. 3200, because vite holds 3100 and Explorer reserves 3000/3001.
PORT=3200

NODE_ENV=development

# The database. Create it once with:
#   psql -U postgres -c "create database nura_games"
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/nura_games
# The most connections the server holds open to Postgres at once.
DATABASE_POOL_MAX=10

# Build the schema from the entities when the server starts. Unset, it follows NODE_ENV: every
# development boot syncs, and a production start does not - there the sync is the deliberate
# `npm run schema:sync`. Set true or false to override either way. It is the same syncSchema either
# way: the extensions, TypeORM's synchronize(), then the DESC and partial indexes no decorator can
# say and every CHECK rewritten - never a bare synchronize: true, which would drop those indexes.
# A database holding rows from before a NOT NULL column or a new CHECK cannot be synced onto; boot
# says so and names the rebuild, because nothing here migrates rows.
# DATABASE_SYNC=true

# Signs session cookies and realtime tickets. There is no default and there must not be one:
# `serializeCookie` has no `signed` option and the framework ships no keyring, so this value is
# the only thing standing between a cookie and a forged session.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The origin the browser actually uses. It is the SIWE `domain` and `URI`, the WebSocket origin
# check, and the cookie's site. Never derived from a request header - a header is
# attacker-controlled, and this value decides what a signature means.
PUBLIC_ORIGIN=http://localhost:3100

# The chain a wallet signature is made against, as a DECIMAL EIP-155 id. It is the SIWE message's
# `Chain ID` field, which parsers read as a number - a chain NAME there is rejected by every one
# of them. Empty means "whatever network the wallet is already on", and no switch is requested.
# Nurachain is 1020.
NURA_CHAIN_ID=1020

# A JSON-RPC url, used only for the ERC-1271 `eth_call` that verifies a smart-contract wallet
# (a Safe, say). Without it a contract wallet cannot sign in; ordinary key-holding wallets are
# verified locally and need nothing here. The profile registry below is read through it too.
NURA_RPC_URL=https://rpc.nurachain.net

# The NuraProfile registry - the ERC-1967 proxy, NOT the implementation - and the stateless lens
# beside it. Both, with NURA_RPC_URL, or the profile page shows nothing about the chain: a
# deployment pointed at no registry says so rather than failing, exactly as push does without
# VAPID keys. These are the Nurachain deployment of 2026-09-05. The implementation behind the
# proxy is 0x8ff69542387343fe8a9e053779f23058fBbA7f71 and does not go here; the SocialVerifier,
# 0xc81bF5e81a9aB9447eeE873b916538750f3161D8, is not read by this product.
NURA_PROFILE_ADDRESS=0x8CFbcEf737BE3C67A52A20Ae3DCC685ACF759460
NURA_PROFILE_LENS_ADDRESS=0xE8BD8Fc19907274b3CF87Bd72F4cd92Ca3c62F05

# Requests a minute per address, for /api and /ws. The responsive matrix pulls 600 pages from
# one address as fast as it can, which is abusive traffic by any honest measure - raise this for
# a load run rather than shipping a limit shaped around a test.
API_RATE_MAX=600

# Serving the built client from this process.
#
# LEAVE IT UNSET unless you mean it. In development it is off, because vite owns the browser on
# 3100 and proxies /api, /ws and /_image here - two processes, and this one must not also answer
# for `/`. In production it is ON, because then this process IS the server.
#
# Setting it to false explicitly still wins, for a deployment that really does put a CDN or another
# process in front of the client. Set that way by accident, `npm run build && npm start` answers the
# api and 404s every page - and it reads as a browser problem, because a tab still holding the app
# from the dev server keeps working while a fresh one gets nothing.
# SERVE_PAGES=false

# Stack traces point into dist/ without this, because the CLI spawns node with no flags.
NODE_OPTIONS=--enable-source-maps

# Web Push. All three together or none: a half-configured push asks for permission and then
# never delivers, which is worse than not asking. A push from this server carries NO payload,
# so there is no content key here - the notice says something happened and the app says what.
#   node -e "const {generateKeyPairSync}=require('node:crypto');const p=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=p.privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+j.d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@nura.games

# Voice at the table. The media goes directly between players; this server only introduces them.
# With nothing here, players on one network still hear each other and players behind two routers
# do not. STUN is a comma list of stun: urls. TURN uses the TURN REST scheme: the secret stays
# here and each browser gets a username that expires in an hour, so point VOICE_TURN_SECRET at the
# same static-auth-secret your coturn uses.
VOICE_STUN_URLS=
VOICE_TURN_URLS=
VOICE_TURN_SECRET=

# =================================================================================================
# Frontend - the browser
#
# Only `VITE_`-prefixed names reach the bundle, and everything in this section is PUBLIC by
# construction: vite inlines these values into JavaScript any visitor can read. Nothing secret
# belongs here.
#
# Every one of these is optional. `data/chain.ts` falls back for each, and with no chain id at all
# the app signs in on whatever network the wallet is already on and requests no switch.
# =================================================================================================

# The chain a wallet signature is made against, as a DECIMAL EIP-155 id. It becomes the SIWE
# message's `Chain ID`, which every parser reads as a number - a chain NAME there is refused.
# It has to agree with NURA_CHAIN_ID above: the browser asks the wallet to switch to this one and
# the server verifies the signature against its own, so two values that disagree mean every
# sign-in is refused with nothing on screen explaining why.
VITE_NURA_CHAIN_ID=1020

VITE_NURA_CHAIN_NAME=NuraChain
VITE_NURA_CURRENCY_NAME=Nura
VITE_NURA_CURRENCY_SYMBOL=NURA

# Comma-separated, both of them. They are handed to the wallet in `wallet_addEthereumChain`,
# which is what lets somebody add NuraChain from inside the sign-in flow rather than by hand.
VITE_NURA_RPC_URL=https://rpc.nurachain.net
VITE_NURA_EXPLORER_URL=https://explorer.nurachain.net

# Where "learn about NuraChain" points.
VITE_NURA_SITE=https://nurachain.net

# The origin people reach this site on, with no trailing slash. A link preview needs an absolute
# og:image, so the build writes it against this; left empty, the image stays relative.
VITE_PUBLIC_ORIGIN=
