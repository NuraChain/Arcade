# Copy to .env at the repository root and fill in the first three. That is all a server needs.
# Whatever differs between development and production follows from the command: `npm run dev` is
# development, `npm start` and the systemd service are production, and NODE_ENV in this file is
# never read. Every other setting has a value in the code. One file serves both halves: the api
# reads it, and so does vite, which only ever takes PUBLIC_ORIGIN from it.

# =================================================================================================
# Needed
# =================================================================================================

# The database. Create it once with:
#   psql -U postgres -c "create database nura_games"
DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/nura_games

# Signs session cookies and realtime tickets, and keys the franking of reported messages. There is
# no default and there must not be one: `serializeCookie` has no `signed` option and the framework
# ships no keyring, so this value is the only thing standing between a cookie and a forged
# session. Production refuses one under 32 characters.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The origin the browser actually uses, such as https://play.example.com. It is the SIWE `domain`
# and `URI`, the WebSocket origin check, the check every write is held to, the cookie's site, and
# the address a link preview's picture is written against. Never derived from a request header - a
# header is attacker-controlled, and this value decides what a signature means. Left out in
# development it is the dev server, http://localhost:3100; production refuses to start without it.
PUBLIC_ORIGIN=

# =================================================================================================
# Optional features: each is off while its lines are left out or empty
# =================================================================================================

# The one wallet address that may open /admin.
ADMIN_WALLET_ADDRESS=

# Web Push. All three together or none: a half-configured push subscribes a browser and then
# never delivers, which is worse than not subscribing. With none, a device is still told what
# happened while a tab is open. A push from this server carries NO payload,
# so there is no content key here - the worker asks the api what happened, over the reader's
# own session, and says that.
#   node -e "const {generateKeyPairSync}=require('node:crypto');const p=generateKeyPairSync('ec',{namedCurve:'prime256v1'});const j=p.privateKey.export({format:'jwk'});console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),Buffer.from(j.x,'base64url'),Buffer.from(j.y,'base64url')]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+j.d)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@nura.games

# Voice at the table. The sound goes straight between two players whenever their browsers can reach
# each other; when they cannot, this server carries it over the page's own connection. So every call
# works with nothing here: players on one network talk directly, and players behind two routers are
# carried by this server. STUN and TURN let more of them talk directly, which costs this server
# nothing and saves a little delay. STUN is a comma list of stun: urls. TURN uses the TURN REST
# scheme: the secret stays here and each browser gets a username that expires in an hour, so point
# VOICE_TURN_SECRET at the same static-auth-secret your coturn uses.
VOICE_STUN_URLS=
VOICE_TURN_URLS=
VOICE_TURN_SECRET=

# NuraChain, the Nurachain deployment of 2026-09-05. NURA_CHAIN_ID is the DECIMAL EIP-155 id a
# wallet row records and a contract wallet is checked on. NURA_RPC_URL verifies a smart-contract
# wallet (a Safe, say) and reads the profile registry; ordinary key-holding wallets are verified
# locally and need none of this. The registry is the ERC-1967 proxy, NOT the implementation
# (0x8ff69542387343fe8a9e053779f23058fBbA7f71), with the stateless lens beside it. The explorer's
# Etherscan-compatible api is where a wallet's NFTs are read. Leave the block out and the server
# reads no chain: the profile page shows nothing about it and the NFT count is not drawn.
NURA_CHAIN_ID=1020
NURA_RPC_URL=https://rpc.nurachain.net
NURA_PROFILE_ADDRESS=0x8CFbcEf737BE3C67A52A20Ae3DCC685ACF759460
NURA_PROFILE_LENS_ADDRESS=0xE8BD8Fc19907274b3CF87Bd72F4cd92Ca3c62F05
NURA_EXPLORER_API=https://explorer.nurachain.net/api

# Paid tables: playing for NURA. NURA_VAULT_ADDRESS is the ArcadeVault the SmartContract project
# deploys with `npm run deploy:nurachain:arcade`. NURA_REFEREE_KEY is the private key (0x and 64 hex
# digits) of the address the vault was given as its referee: the only key that can lock players'
# signed stakes into a game and pay its winners. It is a hot key, so fund it with a little NURA for
# gas and nothing more; the vault's admin can revoke it in one transaction. Paid tables exist only
# when both are set beside NURA_RPC_URL and NURA_CHAIN_ID; leave either out and every table is free.
NURA_VAULT_ADDRESS=
NURA_REFEREE_KEY=

# =================================================================================================
# Numbers with a value in the code: write one only to change it
# =================================================================================================

# The port this process binds, on 127.0.0.1, for nginx to forward to. vite proxies to 3200 in
# development.
# PORT=3200

# Requests a minute per address, for /api and /ws. The responsive matrix pulls 600 pages from
# one address as fast as it can, which is abusive traffic by any honest measure - raise this for
# a load run rather than shipping a limit shaped around a test. The two sign-in routes, which a
# caller who is not signed in can make rows and accounts with, get a twentieth of it and never
# fewer than ten: 30 a minute at 600.
# API_RATE_MAX=600

# The most connections the server holds open to Postgres at once.
# DATABASE_POOL_MAX=10
