import BrandLogo from '../components/layout/brand-logo.component.azeroth';
import BrandMark from '../components/layout/brand-mark.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Spinner from '../components/ui/spinner.component.azeroth';
import Icon from '../icons/icon.component.azeroth';
import { heldUp } from '../lib/held-up.ts';
import { useLocale } from '../stores/locale.store.ts';

export default component NotFoundPage(props: { holding?: boolean })
{
    const locale = useLocale();

    derived waiting = props.holding === true && heldUp();

    derived titled = waiting ? 'held-title' : 'missing-title';

    <Show when={ waiting || props.holding !== true }>
        <main class="flex min-h-dvh items-center justify-center bg-void px-4 py-10">
            <section class="hero-surface w-full max-w-[30rem] rounded-hero p-7 text-center sm:p-9" role={ waiting ? 'status' : undefined } aria-labelledby={ titled }>
                <a href="/" class="mx-auto mb-8 flex w-max items-center gap-2.5">
                    <BrandLogo size="lg" />
                    <BrandMark class="text-ui-lg text-text" />
                </a>
                <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-accent/30 bg-accent/12 text-accent">
                    <Show when={ waiting } fallback={ <Icon name="discover" size={ 28 } /> }>
                        <Spinner size={ 28 } />
                    </Show>
                </span>
                <h1 id={ titled } class="title mt-5 text-ui-3xl">{ locale.t(waiting ? 'held.title' : 'notFound.title') }</h1>
                <p class="mx-auto mt-2 max-w-[36ch] text-ui-md text-muted">{ locale.t(waiting ? 'held.lead' : 'notFound.lead') }</p>
                <Show when={ !waiting }>
                    <div class="mt-7 flex justify-center">
                        <span class="glow-cta flex rounded-control">
                            <Button href="/" variant="primary" size="lg" icon="forward">{ locale.t('notFound.cta') }</Button>
                        </span>
                    </div>
                </Show>
            </section>
        </main>
    </Show>
}
