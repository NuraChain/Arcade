import BrandLogo from '../components/layout/brand-logo.component.azeroth';
import BrandMark from '../components/layout/brand-mark.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Icon from '../icons/icon.component.azeroth';
import { useLocale } from '../stores/locale.store.ts';

export default component ErrorPage(props: { reset: () => void; error?: unknown })
{
    const locale = useLocale();

    derived detail = ((): string =>
    {
        const error = props.error;
        if (error === undefined || error === null)
        {
            return '';
        }
        return error instanceof Error ? `${ error.name }: ${ error.message }` : String(error);
    })();

    mount
    {
        if (props.error !== undefined && props.error !== null)
        {
            console.error('[nura] a page threw and the error boundary caught it', props.error);
        }
    }

    <main class="flex min-h-dvh items-center justify-center bg-void px-4 py-10">
        <section class="hero-surface w-full max-w-[30rem] rounded-hero p-7 text-center sm:p-9" aria-labelledby="error-title">
            <a href="/" class="mx-auto mb-8 flex w-max items-center gap-2.5">
                <BrandLogo size="lg" />
                <BrandMark class="text-ui-lg text-text" />
            </a>
            <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-danger/30 bg-danger/12 text-danger">
                <Icon name="alert" size={ 28 } />
            </span>
            <h1 id="error-title" class="title mt-5 text-ui-3xl">{ locale.t('error.title') }</h1>
            <p class="mx-auto mt-2 max-w-[36ch] text-ui-md text-muted">{ locale.t('error.lead') }</p>

            <Show when={ import.meta.env.DEV && detail !== '' }>
                { () =>
                    <pre class="mt-5 max-w-full overflow-x-auto rounded-tile border border-danger/40 bg-danger/10 px-3 py-2 text-start text-ui-xs text-danger">{ detail }</pre>
                }
            </Show>

            <div class="mt-7 flex justify-center">
                <Button variant="primary" size="lg" leading="refresh" onClick={ () => props.reset() }>{ locale.t('error.cta') }</Button>
            </div>
        </section>
    </main>
}
