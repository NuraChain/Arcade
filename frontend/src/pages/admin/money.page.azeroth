import { useHead } from 'azerothjs';

import AdminVault from '../../components/admin/admin-vault.component.azeroth';
import AdminHead from '../../components/admin/admin-head.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';

export default component MoneyPage()
{
    const locale = useLocale();

    useHead({ title: () => locale.t('admin.section.money') });

    <div class="flex flex-col">
        <AdminHead title={ locale.t('admin.section.money') } />
        <AdminVault />
    </div>
}
