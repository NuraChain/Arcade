import { createResource, untrack, useHead } from 'azerothjs';

import { REPORT_LISTS, type ReportList } from '../../../../backend/src/domains/admin/roles.ts';
import type { AdminReports } from '../../../../backend/src/schemas.ts';
import { client } from '../../api.ts';
import AdminEmpty from '../../components/admin/admin-empty.component.azeroth';
import ReportRow, { REPORT_COLUMNS, type AdminReportRow } from '../../components/admin/report-row.component.azeroth';
import AdminHead from '../../components/admin/admin-head.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import FilterBar from '../../components/ui/filter-bar.component.azeroth';
import LoadMore from '../../components/ui/load-more.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { attempt } from '../../lib/attempt.ts';
import { useAddress } from '../../lib/page-param.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useReports } from '../../stores/reports.store.ts';

interface Tail
{
    from: AdminReports;
    rows: AdminReportRow[];
    cursor: string | undefined;
}

const LIST_WORDS: Record<ReportList, MessageKey> = {
    received: 'admin.reports.list.received',
    reviewed: 'admin.reports.list.reviewed',
    actioned: 'admin.reports.list.actioned',
    all: 'admin.reports.list.all'
};

const queryOf = (list: ReportList) => (list === 'received' ? {} : { status: list });

export default component ReportsPage()
{
    const locale = useLocale();
    const address = useAddress();
    const desk = useReports();

    useHead({ title: () => locale.t('admin.section.reports') });

    derived list = REPORT_LISTS.find((one) => one === address.text('status')) ?? 'received';

    state tail = null as Tail | null;

    state paging = false;

    const first = createResource(() => list, (asked) => client.admin.reports({ query: queryOf(asked) }), { name: 'admin.reports' });

    derived page = first.data() ?? null;

    effect
    {
        const answered = page;

        if (answered !== null)
        {
            untrack(() => desk.told(answered.waiting));
        }
    }

    derived trouble = first.error();

    derived waiting = page === null && trouble === null;

    derived failed = page === null && trouble !== null;

    derived continued = tail !== null && tail.from === page ? tail : null;

    derived rows = page === null ? [] : [...page.rows, ...(continued?.rows ?? [])];

    derived cursor = continued === null ? page?.cursor : continued.cursor;

    derived more = cursor !== undefined;

    derived listed = rows.length > 0;

    derived empty = page !== null && rows.length === 0;

    derived quiet = list === 'received';

    derived blank = locale.t(quiet ? 'admin.reports.none' : 'admin.reports.noneListed');

    derived blankLead = quiet ? locale.t('admin.reports.noneLead') : undefined;

    derived lists = REPORT_LISTS.map((one) => ({
        id: one,
        label: locale.t(LIST_WORDS[one]),
        ...(one === 'received' && page !== null ? { count: page.waiting } : {})
    }));

    const choose = (id: string) =>
    {
        address.write({ status: id === 'received' ? '' : id });
    };

    const older = async () =>
    {
        const from = page;
        const after = cursor;
        const kept = continued?.rows ?? [];

        if (from === null || after === undefined || paging)
        {
            return;
        }

        paging = true;

        await attempt((async () =>
        {
            const next = await client.admin.reports({ query: { ...queryOf(list), cursor: after } });

            if (first.data() === from)
            {
                tail = { from, rows: [...kept, ...next.rows], cursor: next.cursor };
                desk.told(next.waiting);
            }
        })());

        paging = false;
    };

    <div class="flex flex-col gap-6 @container">
        <AdminHead title={ locale.t('admin.section.reports') } lead={ locale.t('admin.reports.lead') } how={ locale.t('admin.reports.how') } />

        <FilterBar items={ lists } value={ list } label={ locale.t('admin.reports.lists') } onChange={ choose } />

        <Show when={ waiting }>
            { () => <Skeleton lines={ 5 } avatar /> }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('admin.reports.failed') } onRetry={ () => void first.refetch() } /> }
        </Show>

        <Show when={ empty }>
            { () => <AdminEmpty icon="flag" title={ blank } lead={ blankLead } /> }
        </Show>

        <Show when={ listed }>
            <div class="flex flex-col">
                <div class="overflow-hidden rounded-panel border border-line bg-field">
                    <div class={ `hidden gap-x-4 border-b border-line px-4 py-2.5 text-ui-xs font-semibold text-faint @3xl:grid ${ REPORT_COLUMNS }` } aria-hidden="true" data-columns>
                        <span class="col-start-2">{ locale.t('admin.reports.column.report') }</span>
                        <span>{ locale.t('admin.reports.column.reason') }</span>
                        <span>{ locale.t('admin.reports.column.filed') }</span>
                        <span>{ locale.t('admin.reports.column.status') }</span>
                    </div>
                    <ul class="divide-y divide-line" data-reports>
                        <For each={ rows } key={ (one) => one.id } let={ row }>
                            <li>
                                <ReportRow report={ row } />
                            </li>
                        </For>
                    </ul>
                </div>
                <Show when={ more }>
                    <LoadMore label={ locale.t('admin.reports.more') } loading={ paging } onMore={ () => void older() } />
                </Show>
            </div>
        </Show>
    </div>
}
