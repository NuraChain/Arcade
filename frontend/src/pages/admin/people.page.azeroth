import { createResource, untrack, useHead } from 'azerothjs';

import { PEOPLE_LISTS, type PeopleList } from '../../../../backend/src/domains/admin/roles.ts';
import type { AdminPeople } from '../../../../backend/src/schemas.ts';
import { client } from '../../api.ts';
import PersonRow, { type AdminPersonRow } from '../../components/admin/person-row.component.azeroth';
import PageHeader from '../../components/app/page-header.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import FilterBar from '../../components/ui/filter-bar.component.azeroth';
import LoadMore from '../../components/ui/load-more.component.azeroth';
import SearchInput from '../../components/ui/search-input.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { attempt } from '../../lib/attempt.ts';
import { useAddress } from '../../lib/page-param.ts';
import { runtime } from '../../lib/runtime.ts';
import type { MessageKey } from '../../locales/en.ts';
import { SEARCH_PAUSE_MS } from '../../services/search.service.ts';
import { useLocale } from '../../stores/locale.store.ts';

interface Asked
{
    list: PeopleList;
    q: string;
}

interface Tail
{
    from: AdminPeople;
    rows: AdminPersonRow[];
    cursor: string | undefined;
}

const LIST_WORDS: Record<PeopleList, MessageKey> = {
    newest: 'admin.people.list.newest',
    suspended: 'admin.people.list.suspended',
    minors: 'admin.people.list.minors',
    staff: 'admin.people.list.staff',
    reported: 'admin.people.list.reported'
};

const queryOf = (asked: Asked) => ({
    ...(asked.list === 'newest' ? {} : { list: asked.list }),
    ...(asked.q === '' ? {} : { q: asked.q })
});

export default component PeoplePage()
{
    const locale = useLocale();
    const address = useAddress();

    useHead({ title: () => locale.t('admin.section.people') });

    derived list = PEOPLE_LISTS.find((one) => one === address.text('list')) ?? 'newest';

    derived q = address.text('q').trim();

    state typed = untrack(() => address.text('q'));

    state tail = null as Tail | null;

    state paging = false;

    let pending: (() => void) | null = null;

    const first = createResource(() => ({ list, q }), (asked) => client.admin.people({ query: queryOf(asked) }), { name: 'admin.people' });

    mount
    {
        return () =>
        {
            pending?.();
            pending = null;
        };
    }

    derived page = first.data() ?? null;

    derived trouble = first.error();

    derived waiting = page === null && trouble === null;

    derived failed = page === null && trouble !== null;

    derived continued = tail !== null && tail.from === page ? tail : null;

    derived rows = page === null ? [] : [...page.rows, ...(continued?.rows ?? [])];

    derived cursor = continued === null ? page?.cursor : continued.cursor;

    derived more = cursor !== undefined;

    derived listed = rows.length > 0;

    derived empty = page !== null && rows.length === 0;

    derived blank = locale.t(q !== '' || list !== 'newest' ? 'admin.people.noneFound' : 'admin.people.none');

    derived lists = PEOPLE_LISTS.map((one) => ({ id: one, label: locale.t(LIST_WORDS[one]) }));

    const apply = () =>
    {
        pending?.();
        pending = null;
        address.write({ q: typed.trim() });
    };

    const search = (value: string) =>
    {
        typed = value;
        pending?.();
        pending = runtime().clock.after(SEARCH_PAUSE_MS, apply);
    };

    const choose = (id: string) =>
    {
        address.write({ list: id === 'newest' ? '' : id });
    };

    const older = async () =>
    {
        const from = page;
        const after = cursor;
        const kept = continued?.rows ?? [];

        if (from === null || after === undefined || paging)
        {
            return;
        }

        paging = true;

        await attempt((async () =>
        {
            const next = await client.admin.people({ query: { ...queryOf({ list, q }), cursor: after } });

            if (first.data() === from)
            {
                tail = { from, rows: [...kept, ...next.rows], cursor: next.cursor };
            }
        })());

        paging = false;
    };

    <div class="flex flex-col gap-6">
        <PageHeader title={ locale.t('admin.section.people') } lead={ locale.t('admin.people.lead') } flush />

        <div class="flex flex-col gap-4">
            <SearchInput
                class="max-w-xl"
                value={ typed }
                label={ locale.t('admin.people.search') }
                placeholder={ locale.t('admin.people.search') }
                onInput={ search }
                onEnter={ apply }
            />
            <FilterBar items={ lists } value={ list } label={ locale.t('admin.people.lists') } onChange={ choose } />
        </div>

        <Show when={ waiting }>
            { () => <Skeleton lines={ 5 } avatar /> }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('admin.people.failed') } onRetry={ () => void first.refetch() } /> }
        </Show>

        <Show when={ empty }>
            { () => <EmptyState icon="people" title={ blank } /> }
        </Show>

        <Show when={ listed }>
            <div class="flex flex-col">
                <ul class="divide-y divide-line overflow-hidden rounded-panel border border-line bg-field" data-people>
                    <For each={ rows } key={ (one) => one.handle } let={ row }>
                        <li>
                            <PersonRow person={ row } />
                        </li>
                    </For>
                </ul>
                <Show when={ more }>
                    <LoadMore label={ locale.t('admin.people.more') } loading={ paging } onMore={ () => void older() } />
                </Show>
            </div>
        </Show>
    </div>
}
