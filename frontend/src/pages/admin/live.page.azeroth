import { createResource, useHead } from 'azerothjs';

import type { AdminLive } from '../../../../backend/src/schemas.ts';
import { client } from '../../api.ts';
import AdminEmpty from '../../components/admin/admin-empty.component.azeroth';
import LiveRow, { LIVE_COLUMNS, type AdminLiveRow } from '../../components/admin/live-row.component.azeroth';
import AdminHead from '../../components/admin/admin-head.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import LoadMore from '../../components/ui/load-more.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { attempt } from '../../lib/attempt.ts';
import { whileSeen } from '../../lib/while-seen.ts';
import { useLocale } from '../../stores/locale.store.ts';

interface Tail
{
    from: AdminLive;
    rows: AdminLiveRow[];
    cursor: string | undefined;
}

export default component LivePage()
{
    const locale = useLocale();

    useHead({ title: () => locale.t('admin.section.live') });

    state tail = null as Tail | null;

    state paging = false;

    const first = createResource(() => client.admin.live({ query: {} }), { name: 'admin.live' });

    mount
    {
        return whileSeen(() => void first.refetch());
    }

    derived page = first.data() ?? null;

    derived trouble = first.error();

    derived waiting = page === null && trouble === null;

    derived failed = page === null && trouble !== null;

    derived continued = tail !== null && tail.from === page ? tail : null;

    derived rows = page === null ? [] : [...page.rows, ...(continued?.rows ?? [])];

    derived cursor = continued === null ? page?.cursor : continued.cursor;

    derived more = cursor !== undefined;

    derived listed = rows.length > 0;

    derived empty = page !== null && rows.length === 0;

    derived total = page?.total ?? 0;

    derived count = locale.n(total);

    derived countLabel = locale.plural('admin.live.count', total);

    const older = async () =>
    {
        const from = page;
        const after = cursor;
        const kept = continued?.rows ?? [];

        if (from === null || after === undefined || paging)
        {
            return;
        }

        paging = true;

        await attempt((async () =>
        {
            const next = await client.admin.live({ query: { cursor: after } });

            if (first.data() === from)
            {
                tail = { from, rows: [...kept, ...next.rows], cursor: next.cursor };
            }
        })());

        paging = false;
    };

    <div class="flex flex-col gap-6 @container">
        <AdminHead title={ locale.t('admin.section.live') } lead={ locale.t('admin.live.lead') } how={ locale.t('admin.live.how') } />

        <div class="flex flex-wrap items-center gap-3">
            <Button variant="outline" size="sm" leading="refresh" onClick={ () => void first.refetch() }>{ locale.t('admin.overview.read') }</Button>
            <span class="text-ui-sm text-muted" data-count><span class="tally font-semibold text-text">{ count }</span> { countLabel }</span>
        </div>

        <Show when={ waiting }>
            { () => <Skeleton lines={ 5 } avatar /> }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('admin.live.failed') } onRetry={ () => void first.refetch() } /> }
        </Show>

        <Show when={ empty }>
            { () => <AdminEmpty icon="signal" title={ locale.t('admin.live.none') } /> }
        </Show>

        <Show when={ listed }>
            <div class="flex flex-col">
                <div class="overflow-hidden rounded-panel border border-line bg-field">
                    <div class={ `hidden gap-x-4 border-b border-line px-4 py-2.5 text-ui-xs font-semibold text-faint @2xl:grid ${ LIVE_COLUMNS }` } aria-hidden="true" data-columns>
                        <span class="col-start-2">{ locale.t('admin.live.column.person') }</span>
                        <span>{ locale.t('admin.live.column.doing') }</span>
                        <span>{ locale.t('admin.live.column.since') }</span>
                    </div>
                    <ul class="divide-y divide-line" data-live>
                        <For each={ rows } key={ (one) => one.handle } let={ row }>
                            <li data-person={ row.handle }>
                                <LiveRow row={ row } />
                            </li>
                        </For>
                    </ul>
                </div>
                <Show when={ more }>
                    <LoadMore label={ locale.t('admin.live.more') } loading={ paging } onMore={ () => void older() } />
                </Show>
            </div>
        </Show>
    </div>
}
