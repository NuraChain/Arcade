import { useHead, useNavigate, useQuery, type MountNode } from 'azerothjs';

import '../icons/all.ts';
import WalletPanel from '../components/app/wallet-panel.component.azeroth';
import SiteFooter from '../components/layout/site-footer.component.azeroth';
import SiteHeader from '../components/layout/site-header.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import '../locales/app-catalogue.ts';
import { safeNext } from '../lib/guards.ts';
import { useAccount } from '../stores/account.store.ts';
import { useLocale } from '../stores/locale.store.ts';
import { useWallet } from '../stores/wallet.store.ts';

export default component SignInPage()
{
    const locale = useLocale();
    const account = useAccount();
    const wallet = useWallet();
    const query = useQuery();
    const { navigate } = useNavigate();

    useHead({ title: () => `${ locale.t('wallet.title') } · ${ locale.t('app.title') }` });

    mount
    {
        return wallet.start();
    }

    const leave = () =>
    {
        navigate(safeNext(query().next), { replace: true });
    };

    /**
     * The wallet chooser, on the page that IS the connect surface.
     *
     * `WalletPanel` connects to whichever provider EIP-6963 put first, which is the right default
     * and the wrong only option: somebody with both MetaMask and Trust Wallet installed had no way
     * to say which one, and somebody with neither was told to install MetaMask specifically. The
     * landing page has had the chooser all along and this page did not.
     *
     * Held in a plain `let` with a separate boolean, because a setter treats a bare function as an
     * updater - assigning a component into a signal CALLS it with the previous value.
     */
    let Chooser: ((props: { close: () => void; navigate: (to: string) => void }) => MountNode) | null = null;

    state chooserOpen = false;
    state chooserLoaded = false;

    const openChooser = () =>
    {
        chooserOpen = true;
        if (chooserLoaded)
        {
            return;
        }
        void import('../components/layout/connect-dialog.component.azeroth').then((module) =>
        {
            Chooser = module.default;
            chooserLoaded = true;
        });
    };

    <div class="[--page-pad:max(1rem,env(safe-area-inset-left),env(safe-area-inset-right))] sm:[--page-pad:max(1.5rem,env(safe-area-inset-left),env(safe-area-inset-right))] lg:[--page-pad:max(2rem,env(safe-area-inset-left),env(safe-area-inset-right))] relative flex min-h-dvh flex-col overflow-hidden bg-void text-text">
        <div class="pointer-events-none absolute -top-40 start-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-48 -end-24 h-[26rem] w-[26rem] rounded-full bg-live/10 blur-3xl" aria-hidden="true"></div>

        <SiteHeader cta={ false } />

        <main id="main" class="page-pad safe-b relative mx-auto flex w-full max-w-[40rem] flex-1 flex-col pb-12 pt-24 sm:pt-28">
            <h1 class="sr-only">{ locale.t('wallet.title') }</h1>

            <WalletPanel
                onConnected={ (established) =>
                {
                    account.adoptWallet(established);
                    leave();
                } }
            />

            <div class="mt-3 flex justify-center">
                <Button variant="ghost" size="sm" leading="wallet" onClick={ openChooser }>
                    { locale.t('wallet.other') }
                </Button>
            </div>

            <Show when={ chooserOpen && chooserLoaded }>
                { () => Chooser!({ close: () => chooserOpen = false, navigate: () => leave() }) }
            </Show>
        </main>

        <SiteFooter />
    </div>
}
