import PersonRecord from '../../components/social/person-record.component.azeroth';
import { createResource, useHead, useNavigate, useParams } from 'azerothjs';

import { client } from '../../api.ts';
import Page from '../../components/app/page.component.azeroth';
import PersonActions from '../../components/social/person-actions.component.azeroth';
import ProfileHeader from '../../components/social/profile-header.component.azeroth';
import Badge from '../../components/ui/badge.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useRecord } from '../../stores/record.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { openTable } from '../../lib/open-table.ts';
import { attempt } from '../../lib/attempt.ts';
import Panel from '../../components/ui/panel.component.azeroth';

export default component PersonPage()
{
    const locale = useLocale();
    const social = useSocial();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const chat = useChat();
    const lobby = useLobby();
    const overlay = useOverlay();
    const shell = useShell();
    const params = useParams();
    const people = usePeople();
    const record = useRecord();
    const { navigate } = useNavigate();

    const view = createResource(
        () => params().handle ?? null,
        (handle) => client.social.person({ params: { handle } }),
        { name: 'social.person' }
    );

    effect
    {
        const fetched = view.data()?.person;

        if (fetched !== undefined)
        {
            people.remember([fetched]);
        }
    }

    derived person = view.data()?.person ?? people.byHandle(params().handle ?? '') ?? null;

    derived name = person === null ? locale.t('person.notFound') : person.displayName;

    useHead({ title: () => name });

    mount
    {
        return shell.claimTitle(() => name);
    }

    derived relation = person === null ? 'none' : social.relation(person.id);

    derived asked = person === null ? '' : social.incoming().find((request) => request.from === person!.id)?.id ?? '';

    derived mutual = view.data()?.mutual ?? 0;

    derived dot = person === null ? null : presence.dot(person.id);

    derived held = record.record();

    derived stats = [
        { label: locale.t('profile.stat.games'), value: (held?.games ?? []).reduce((sum, one) => sum + one.played, 0) },
        { label: locale.t('profile.stat.wins'), value: (held?.games ?? []).reduce((sum, one) => sum + one.won, 0) },
        { label: locale.t('profile.stat.achievements'), value: (held?.achievements.scopes ?? []).reduce((total, one) => total + one.earned, 0) }
    ];

    const play = (): void =>
    {
        if (person !== null)
        {
            const game = catalogue.featured();
            openTable(lobby.host(game, catalogue.defaults(game), [person.id]), navigate);
        }
    };

    const message = (): void =>
    {
        if (person !== null)
        {
            void chat.openDirect(person.id).then((id) => navigate(`/app/chats/${ id }`));
        }
    };

    <Page label={ name }>
        <Show
            when={ person !== null }
            fallback={ <EmptyState icon="people" title={ locale.t('person.notFound') } action={ locale.t('app.nav.friends') } to="/app/friends" class="py-12" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <ProfileHeader
                        person={ person! }
                        presence={ dot }
                        bio={ locale.text(person!.bio) }
                        stats={ stats }
                        badges={
                            <span class="contents">
                                <Show when={ dot === 'online' || dot === 'away' }>
                                    <Badge dot text={ dot === 'away' ? locale.t('common.away') : locale.t('common.online') } tone={ dot === 'away' ? 'gold' : 'live' } />
                                </Show>
                                <Show when={ mutual > 0 }>
                                    <Badge dot text={ locale.plural('person.mutual', mutual) } tone="accent" />
                                </Show>
                                <Show when={ person?.isMinor === true }>
                                    <span class="inline-flex h-6 items-center gap-1.5 rounded-full border border-live/30 bg-live/12 px-2.5 text-ui-xs font-semibold text-live">
                                        <Icon name="shield" size={ 12 } />
                                        { locale.t('person.minor') }
                                    </span>
                                </Show>
                            </span>
                        }
                        actions={
                            <span class="contents">
                                <Show when={ relation !== 'blocked' }>
                                    <span class="contents">
                                        <Button variant="primary" leading="play" block class="col-span-2" onClick={ play }>{ locale.t('person.play') }</Button>
                                        <Button variant="secondary" leading="chats" block onClick={ message }>{ locale.t('person.message') }</Button>
                                        <Show when={ relation === 'none' }>
                                            <Button
                                                variant="outline"
                                                leading="friend-add"
                                                block
                                                loading={ social.working(person!.id) }
                                                onClick={ () => void attempt(social.add(person!.id), locale.t('person.added')) }
                                            >
                                                { locale.t('person.add') }
                                            </Button>
                                        </Show>
                                        <Show when={ relation === 'outgoing' }>
                                            <Button variant="outline" leading="clock" block loading={ social.working(person!.id) } onClick={ () => void attempt(social.withdraw(person!.id)) }>{ locale.t('person.withdraw') }</Button>
                                        </Show>
                                        <Show when={ relation === 'incoming' }>
                                            <Button variant="outline" leading="friend-check" block loading={ social.working(asked) } onClick={ () => void attempt(social.accept(asked)) }>{ locale.t('person.accept') }</Button>
                                        </Show>
                                        <Show when={ relation === 'friend' }>
                                            <Button variant="outline" leading="friend-check" block disabled>{ locale.t('person.friends') }</Button>
                                        </Show>
                                    </span>
                                </Show>
                                <Button variant="ghost" leading="more" block class="col-span-2" onClick={ () => overlay.open(PersonActions, { personId: person!.id }, { label: locale.t('actions.title') }) }>{ locale.t('actions.title') }</Button>
                            </span>
                        }
                    />

                    <Show when={ relation === 'blocked' }>
                        { () =>
                            <Panel tone="danger" class="text-center">
                                <p class="text-ui-md font-semibold text-text">{ locale.t('person.blockedTitle', { name: locale.text(person!.displayName).split(' ')[0] }) }</p>
                                <p class="mt-1 text-ui-sm text-muted">{ locale.t('person.blockedLead') }</p>
                                <Button
                                    variant="outline"
                                    size="sm"
                                    class="mt-3"
                                    loading={ social.working(person!.id) }
                                    onClick={ () => void attempt(social.unblock(person!.id), locale.t('actions.unblocked', { name: locale.text(person!.displayName).split(' ')[0] })) }
                                >
                                    { locale.t('actions.unblock', { name: locale.text(person!.displayName).split(' ')[0] }) }
                                </Button>
                            </Panel>
                        }
                    </Show>

                    <PersonRecord handle={ person!.id } />
                </div>
            }
        </Show>
    </Page>
}
