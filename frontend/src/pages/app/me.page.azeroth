import { createResource, useHead, useNavigate, useQuery } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import PersonRecord, { type RecordPart } from '../../components/social/person-record.component.azeroth';
import ChainFaceFailed from '../../components/social/chain-face-failed.component.azeroth';
import ProfileHeader from '../../components/social/profile-header.component.azeroth';
import Badge from '../../components/ui/badge.component.azeroth';
import Tabs from '../../components/ui/tabs.component.azeroth';
import ProfileSheet from '../../components/app/profile-sheet.component.azeroth';
import { signOut } from '../../components/app/sign-out.ts';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import { COPY_CHIP } from '../../components/ui/variants.ts';
import { client } from '../../api.ts';
import Icon from '../../icons/icon.component.azeroth';
import { shortAddress } from '../../lib/wallet.ts';
import { copyText } from '../../lib/clipboard.ts';

import { useAccount } from '../../stores/account.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useRecord } from '../../stores/record.store.ts';
import { useSession } from '../../stores/session.store.ts';
import { useSocial } from '../../stores/social.store.ts';

const TABS = ['achievements', 'games'];

export default component MePage()
{
    const locale = useLocale();
    const overlay = useOverlay();
    const account = useAccount();
    const social = useSocial();
    const record = useRecord();
    const session = useSession();

    const { replace } = useNavigate();
    const address = useQuery();

    derived tab = TABS.find((one) => one === address().tab) ?? 'achievements';

    const show = (id: string) => replace(id === 'achievements' ? '/app/me' : `/app/me?tab=${ id }`);

    const PARTS: Record<string, RecordPart[]> = {
        achievements: ['achievements'],
        games: ['record', 'history']
    };

    const editProfile = () =>
    {
        void overlay.open(ProfileSheet, {}, { label: locale.t('profile.title') }).closed.then(() => face.refetch());
    };

    const editPicture = () =>
    {
        void overlay.open(ProfileSheet, { only: 'picture' as const }, { label: locale.t('profile.pictureTitle') }).closed.then(() => face.refetch());
    };

    state leaving = false;

    const leave = async () =>
    {
        leaving = true;
        leaving = await signOut();
    };

    const copyAddress = async () =>
    {
        const address = account.address();
        if (address === null)
        {
            return;
        }
        await copyText(address, 'wallet.address.copied', { dedupe: 'wallet.address' });
    };

    useHead({ title: () => locale.t('app.nav.profile') });

    derived user = account.user();

    const face = createResource(
        () => user === null ? null : { handle: user.handle, lang: locale.locale() },
        (asked) => client.chain.person({ params: { handle: asked.handle }, query: { lang: asked.lang } }),
        { name: 'chain.person' }
    );

    derived shown = face.data()?.profile;

    derived held = record.record();

    const nfts = createResource(
        () => account.address(),
        () => client.chain.nfts({ query: { limit: '0' } }),
        { name: 'chain.nfts' }
    );

    const retryChain = () =>
    {
        face.refetch();
        nfts.refetch();
    };

    derived nftStat = nfts.data()?.configured === true
        ? [{ label: locale.t('profile.stat.nfts'), value: nfts.data()!.total, to: '/app/me/nfts' }]
        : [];

    derived stats = [
        { label: locale.t('profile.stat.friends'), value: social.friends().length },
        { label: locale.t('profile.stat.games'), value: (held?.games ?? []).reduce((sum, one) => sum + one.played, 0) },
        { label: locale.t('profile.stat.achievements'), value: (held?.achievements.scopes ?? []).reduce((total, one) => total + one.earned, 0) },
        ...nftStat
    ];

    const share = async () =>
    {
        const link = `${ window.location.origin }/app/people/${ user?.handle ?? '' }`;
        await copyText(link, 'me.shared');
    };

    derived unpublished = face.data()?.configured === true && shown === undefined;

    <Page label={ locale.t('app.nav.profile') }>
        <Show
            when={ user !== null }
            fallback={
                <Show when={ !leaving }>
                    { () => <EmptyState icon="me" title={ locale.t('person.notFound') } action={ locale.t('app.nav.home') } to="/app" class="py-12" /> }
                </Show>
            }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <ProfileHeader
                        person={ { displayName: shown?.displayName ?? '', hue: user!.hue, handle: user!.handle, avatar: shown?.avatar ?? '' } }
                        presence={ null }
                        bio={ shown?.bio ?? '' }
                        stats={ stats }
                        progress={ held?.progress ?? null }
                        joined={ session.account()?.joinedAt ?? '' }
                        pictureLabel={ locale.t('profile.pictureChange') }
                        onPicture={ editPicture }
                        mine
                        eyebrow={
                            <button
                                type="button"
                                class={ COPY_CHIP }
                                aria-label={ locale.t('wallet.address.copy') }
                                onClick={ () => void copyAddress() }
                            >
                                <Icon name="key" size={ 12 } class="shrink-0 text-live" />
                                <span class="tally">{ shortAddress(account.address() ?? '') }</span>
                                <Icon name="copy" size={ 12 } class="shrink-0 text-accent" />
                            </button>
                        }
                        badges={
                            <span class="contents">
                                <Show when={ unpublished }>
                                    <Badge dot text={ locale.t('me.chain.absent') } tone="gold" />
                                </Show>
                            </span>
                        }
                        corner={
                            <span class="contents">
                                <IconButton icon="settings" label={ locale.t('me.settings') } variant="bare" size="xs" to="/app/me/settings" />
                                <IconButton icon="edit" label={ locale.t('me.edit') } variant="bare" size="xs" onClick={ editProfile } />
                                <IconButton icon="share" label={ locale.t('me.share') } variant="bare" size="xs" onClick={ () => void share() } />
                                <IconButton icon="sign-out" label={ locale.t('app.nav.signOut') } variant="bare" size="xs" flip disabled={ leaving } onClick={ () => void leave() } />
                            </span>
                        }
                    />

                    <Show when={ face.error() !== null }>
                        { () => <ChainFaceFailed onRetry={ retryChain } /> }
                    </Show>

                    <div class="sticky top-[calc(var(--page-pad)*-1)] z-10 bleed bleed-pad -mb-2 bg-void/85 backdrop-blur-md backdrop-saturate-150">
                        <Tabs
                            label={ locale.t('me.tabs') }
                            value={ tab }
                            onChange={ show }
                            items={ [
                                { id: 'achievements', label: locale.t('me.tab.achievements') },
                                { id: 'games', label: locale.t('me.tab.games') }
                            ] }
                        />
                    </div>

                    <PersonRecord handle={ user!.handle } history mine show={ PARTS[tab] } />
                </div>
            }
        </Show>
    </Page>
}
