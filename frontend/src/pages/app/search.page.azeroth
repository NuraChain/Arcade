import type { GameId } from '../../data/games.ts';
import { useHead, useNavigate, useQuery } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import { gameNameOf, groupNameOf, titleOf } from '../../components/chat/chat-title.ts';
import GameIcon from '../../components/games/game-icon.component.azeroth';
import FriendRow from '../../components/social/friend-row.component.azeroth';
import GroupCard from '../../components/social/group-card.component.azeroth';
import FilterBar from '../../components/ui/filter-bar.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import Pagination from '../../components/ui/pagination.component.azeroth';
import SearchInput from '../../components/ui/search-input.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import type { Conversation } from '../../data/chat.ts';
import Icon from '../../icons/icon.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSearch, SEARCH_SCOPES, type SearchScope } from '../../stores/search.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import Panel from '../../components/ui/panel.component.azeroth';
import { pagingFor, visible } from '../../lib/pagination.ts';
import { useDevice } from '../../stores/device.store.ts';

const PEOPLE_PAGE = 8;
const MESSAGE_PAGE = 10;

const NOWHERE: Conversation = {
    id: '',
    kind: 'direct',
    expireAfter: null,
    participants: [],
    groupId: null,
    tableId: null,
    game: null,
    title: null,
    pinned: false,
    lastReadAt: 0,
    quiet: false
};

export default component SearchPage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    const gameName = (game: GameId) => locale.t(catalogue.byId(game).nameKey);
    const search = useSearch();
    const chat = useChat();
    const groups = useGroups();

    const whereOf = (conversationId: string) => chat.conversation(conversationId) ?? NOWHERE;
    const social = useSocial();
    const people = usePeople();
    const device = useDevice();

    derived paging = pagingFor(device.posture() === 'phone');
    const { navigate } = useNavigate();

    const asked = useQuery();

    mount
    {
        social.want('people');

        const term = asked().q;

        if (typeof term === 'string' && term.trim() !== '')
        {
            search.setQuery(term);
        }
    }

    useHead({ title: () => locale.t('app.nav.search') });

    state peoplePage = 1;
    state messagePage = 1;

    derived results = search.results();

    derived query = search.query();

    effect
    {
        search.query();
        search.scope();
        peoplePage = 1;
        messagePage = 1;
    }

    derived recents = search.recents();

    derived asking = query.trim() !== '';

    derived remembered = recents.length > 0;

    derived found = results.total > 0;

    derived foundPeople = results.people.length > 0;

    derived foundGames = results.games.length > 0;

    derived foundGroups = results.groups.length > 0;

    derived foundMessages = results.messages.length > 0;

    derived hidden = results.locked > 0;

    derived everybody = search.everybody();

    derived looking = search.searching();

    derived unanswered = search.failed();

    derived peopled = search.scope() === 'all' || search.scope() === 'people';

    derived further = asking && peopled && !everybody;

    derived settled = !looking && !unanswered;

    const widen = () => search.setScope('people');

    const run = (term: string) =>
    {
        search.setQuery(term);
        search.remember(term);
    };

    <Page label={ locale.t('app.nav.search') }>
        <header class="pb-4">
            <h1 class="sr-only">{ locale.t('app.nav.search') }</h1>
            <SearchInput
                value={ query }
                onInput={ (value) => search.setQuery(value) }
                placeholder={ locale.t('search.placeholder') }
                label={ locale.t('app.nav.search') }
                autofocus
                onEnter={ () => search.remember(query) }
            />
        </header>

        <FilterBar
            label={ locale.t('search.scope.all') }
            class="mb-5"
            value={ search.scope() }
            onChange={ (id) => search.setScope(id as SearchScope) }
            items={ SEARCH_SCOPES.map((scope) => ({ id: scope, label: locale.t(`search.scope.${ scope }`) })) }
        />

        <Show
            when={ asking }
            fallback={
                <div class="flex flex-col gap-6">
                    <Show when={ remembered }>
                        <section>
                            <SectionHeading title={ locale.t('search.recent') } />
                            <ul class="flex flex-col divide-y divide-line rounded-panel border border-line bg-field px-2" aria-label={ locale.t('search.recent') }>
                                <For each={ recents } key={ (term) => term } let={ term }>
                                    <li class="flex items-center gap-2 rounded-tile px-2 hover:bg-raised/60">
                                        <button
                                            type="button"
                                            class="flex min-h-11 flex-1 cursor-pointer items-center gap-3 text-start text-ui-base text-text"
                                            onClick={ () => run(term) }
                                        >
                                            <Icon name="history" size={ 16 } class="text-faint" />
                                            <span class="truncate">{ term }</span>
                                        </button>
                                        <IconButton icon="close" label={ locale.t('search.clear') } variant="ghost" size="sm" onClick={ () => search.forget(term) } />
                                    </li>
                                </For>
                            </ul>
                        </section>
                    </Show>
                    <EmptyState icon="search" title={ locale.t('search.start') } lead={ locale.t('search.startLead') } class="py-8" />

                    <p class="flex items-start gap-2 px-1 text-ui-xs text-faint">
                        <Icon name="lock" size={ 13 } class="mt-0.5 shrink-0" />
                        <span>{ locale.t('search.thisDevice') }</span>
                    </p>
                </div>
            }
        >
            { () =>
                <div class="flex flex-col gap-5">
                <Show when={ everybody }>
                    <p class="flex items-start gap-2 px-1 text-ui-xs text-faint">
                        <Icon name="people" size={ 13 } class="mt-0.5 shrink-0" />
                        <span>{ locale.t('search.peopleElsewhere') }</span>
                    </p>
                </Show>
                <Show when={ looking }>
                    <p class="px-1 text-ui-sm text-muted" role="status">{ locale.t('search.searching') }</p>
                </Show>
                <Show when={ unanswered }>
                    <div class="flex flex-wrap items-center gap-3 rounded-tile border border-line bg-field px-3 py-2 text-ui-sm text-muted" role="status">
                        <Icon name="alert" size={ 15 } class="shrink-0 text-gold" />
                        <span class="min-w-0 flex-1">{ locale.t('search.peopleFailed') }</span>
                        <Button variant="outline" size="sm" onClick={ () => search.retry() }>{ locale.t('common.retry') }</Button>
                    </div>
                </Show>
                <Show
                    when={ found }
                    fallback={
                        <Show when={ settled }>
                            <EmptyState icon="search" title={ locale.t('search.empty', { query }) } lead={ locale.t('search.emptyLead') } class="py-10" />
                        </Show>
                    }
                >
                    { () =>
                        <div class="flex flex-col gap-7">
                            <p class="text-ui-sm text-faint">{ locale.plural('search.results', results.total) }</p>

                            <Show when={ foundPeople }>
                                <section>
                                    <SectionHeading title={ locale.t('search.scope.people') } />
                                    <ul class="flex flex-col divide-y divide-line rounded-panel border border-line bg-field px-2" aria-label={ locale.t('search.scope.people') }>
                                        <For each={ visible(results.people, PEOPLE_PAGE, peoplePage, paging) } key={ (person) => person.id } let={ person }>
                                            <li>
                                                <FriendRow person={ person } subtitle={ `@${ person.handle }` } />
                                            </li>
                                        </For>
                                    </ul>
                                    <Pagination
                                        total={ results.people.length }
                                        size={ PEOPLE_PAGE }
                                        page={ peoplePage }
                                        mode={ paging }
                                        label={ locale.t('search.scope.people') }
                                        onPage={ (page) => peoplePage = page }
                                    />
                                </section>
                            </Show>

                            <Show when={ foundGames }>
                                <section>
                                    <SectionHeading title={ locale.t('search.scope.games') } />
                                    <ul class="flex flex-col gap-2" aria-label={ locale.t('search.scope.games') }>
                                        <For each={ results.games } key={ (game) => game.id } let={ game }>
                                            <li>
                                                <Panel to={ `/app/games/${ game.slug }` } pad="sm" class="flex items-center gap-3">
                                                    <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-tile border border-line bg-raised/60">
                                                        <GameIcon game={ game.id } class="h-12 w-12" />
                                                    </span>
                                                    <span class="flex min-w-0 flex-1 flex-col">
                                                        <span class="truncate text-ui-md font-semibold text-text">{ locale.t(game.nameKey) }</span>
                                                        <span class="truncate text-ui-xs text-muted">{ locale.t(game.blurbKey) }</span>
                                                    </span>
                                                    <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                                                </Panel>
                                            </li>
                                        </For>
                                    </ul>
                                </section>
                            </Show>

                            <Show when={ foundGroups }>
                                <section>
                                    <SectionHeading title={ locale.t('search.scope.groups') } />
                                    <ul class="grid gap-2 @2xl:grid-cols-2 @6xl:grid-cols-3" aria-label={ locale.t('search.scope.groups') }>
                                        <For each={ results.groups } key={ (group) => group.id } let={ group }>
                                            <li class="flex min-w-0">
                                                <GroupCard group={ group } class="flex-1" />
                                            </li>
                                        </For>
                                    </ul>
                                </section>
                            </Show>

                            <Show when={ hidden }>
                                { () =>
                                    <p class="flex items-start gap-2 rounded-tile border border-line bg-field px-3 py-2 text-ui-sm text-muted">
                                        <Icon name="lock" size={ 15 } class="mt-0.5 shrink-0" />
                                        <span>{ locale.t('search.locked', { count: String(results.locked) }) }</span>
                                    </p>
                                }
                            </Show>

                            <Show when={ foundMessages }>
                                <section>
                                    <SectionHeading title={ locale.t('search.scope.chats') } />
                                    <ul class="flex flex-col divide-y divide-line rounded-panel border border-line bg-field px-2" aria-label={ locale.t('search.scope.chats') }>
                                        <For each={ visible(results.messages, MESSAGE_PAGE, messagePage, paging) } key={ (message) => message.id } let={ message }>
                                            <li>
                                                <button
                                                    type="button"
                                                    class="flex w-full cursor-pointer flex-col gap-0.5 rounded-tile px-3 py-2 text-start transition-colors hover:bg-raised/60"
                                                    onClick={ () => navigate(`/app/chats/${ message.conversationId }`) }
                                                >
                                                    <span class="truncate text-ui-base text-text">{ locale.text(message.text) }</span>
                                                    <span class="truncate text-ui-xs text-faint">
                                                        { locale.t('search.in', { where: locale.text(titleOf(whereOf(message.conversationId), chat.me(), people.byHandle, { group: groupNameOf(whereOf(message.conversationId), groups.byId), game: gameNameOf(whereOf(message.conversationId), gameName) })) }) }
                                                        <span class="mx-1.5 inline-block h-1 w-1 rounded-full bg-faint align-middle" aria-hidden="true"></span>
                                                        { locale.relative(message.at) }
                                                    </span>
                                                </button>
                                            </li>
                                        </For>
                                    </ul>
                                    <Pagination
                                        total={ results.messages.length }
                                        size={ MESSAGE_PAGE }
                                        page={ messagePage }
                                        mode={ paging }
                                        label={ locale.t('search.scope.chats') }
                                        onPage={ (page) => messagePage = page }
                                    />
                                </section>
                            </Show>
                        </div>
                    }
                </Show>
                <Show when={ further }>
                    <Button variant="outline" size="md" leading="people" class="self-start" onClick={ widen }>{ locale.t('search.everybody', { query }) }</Button>
                </Show>
                </div>
            }
        </Show>
    </Page>
}
