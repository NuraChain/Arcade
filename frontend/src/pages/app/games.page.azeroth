import { useHead } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import PageHeader from '../../components/app/page-header.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import GameGrid from '../../components/games/game-grid.component.azeroth';
import FilterBar from '../../components/ui/filter-bar.component.azeroth';
import type { GameCategory } from '../../data/games.ts';
import { useAddress } from '../../lib/page-param.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

const CATEGORIES: readonly GameCategory[] = ['cards', 'board'];

export default component GamesPage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const address = useAddress();

    useHead({ title: () => locale.t('app.nav.games') });

    derived filter = CATEGORIES.find((one) => one === address.text('category')) ?? 'all';

    derived games = catalogue.games.filter((game) => filter === 'all' || game.category === filter);

    derived totals = catalogue.totals();

    derived building = !catalogue.loading() && catalogue.games.some((game) => catalogue.status(game.id) !== 'disabled' && !catalogue.playable(game.id));

    derived pausing = !catalogue.loading() && catalogue.games.some((game) => catalogue.status(game.id) === 'disabled');

    derived lead = [locale.t('games.lead'), building ? locale.t('games.leadSoon') : '', pausing ? locale.t('games.leadPaused') : ''].filter((part) => part !== '').join(' ');

    <Page label={ locale.t('app.nav.games') } onRefresh={ () => catalogue.refresh() }>
        <PageHeader
            title={ locale.t('app.nav.games') }
            lead={ lead }
            actions={
                <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-ui-sm text-muted">
                    <span class="flex items-center gap-2">
                        <span class="live-dot h-2 w-2" aria-hidden="true"></span>
                        <span><span class="tally font-semibold text-text">{ locale.n(totals.playersOnline) }</span> { locale.plural('games.live.playingLabel', totals.playersOnline) }</span>
                    </span>
                    <span class="h-1 w-1 rounded-full bg-faint" aria-hidden="true"></span>
                    <span><span class="tally font-semibold text-text">{ locale.n(totals.tablesOpen) }</span> { locale.plural('games.live.tablesLabel', totals.tablesOpen) }</span>
                    <Button variant="outline" size="sm" leading="watch" to="/app/watch">{ locale.t('watch.page.link') }</Button>
                    <Button variant="outline" size="sm" leading="trophy" to="/app/leaderboard">{ locale.t('app.nav.leaderboard') }</Button>
                </p>
            }
        />

        <FilterBar
            label={ locale.t('games.filter.all') }
            class="mb-5"
            value={ filter }
            onChange={ (id) => address.write({ category: id === 'all' ? '' : id }) }
            items={ [
                { id: 'all', label: locale.t('games.filter.all'), count: catalogue.games.length },
                { id: 'cards', label: locale.t('games.category.cards'), icon: 'cards', count: catalogue.games.filter((game) => game.category === 'cards').length },
                { id: 'board', label: locale.t('games.category.board'), icon: 'dice', count: catalogue.games.filter((game) => game.category === 'board').length }
            ] }
        />

        <GameGrid games={ games } detailed label={ locale.t('app.nav.games') } />
    </Page>
}
