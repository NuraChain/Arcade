import { Dynamic, type MountNode, onCleanup, untrack, useHead, useNavigate, useParams, useRoute } from 'azerothjs';

import ConfirmSheet from '../../components/app/confirm-sheet.component.azeroth';
import Page from '../../components/app/page.component.azeroth';
import PlayHeader from '../../components/games/play-header.component.azeroth';
import TableDock from '../../components/games/table-dock.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { inPlay } from '../../data/match.ts';
import Icon from '../../icons/icon.component.azeroth';
import Badge from '../../components/ui/badge.component.azeroth';
import { runtime } from '../../lib/runtime.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { SHORT_MAX, useDevice } from '../../stores/device.store.ts';
import { useVoice } from '../../stores/voice.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useBoard, type EventBatch } from '../../stores/match.store.ts';
import { startBed } from '../../stores/bed-loader.ts';
import type { BedState } from '../../game/bed.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { useWatch, type Watched as WatchedGame } from '../../stores/watch.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { TOAST_ACTION_DURATION, useToasts } from '../../stores/toasts.store.ts';
import { useVault } from '../../stores/vault.store.ts';
import Panel from '../../components/ui/panel.component.azeroth';
import type { MatchView } from '../../api.ts';
import { plainOf } from '../../lib/markdown.ts';
import { holdScreen } from '../../lib/wake-lock.ts';
import { watchEdge, watchFold, watchSheet, type SheetSize } from '../../lib/sheet-room.ts';
import { chunk, reloadPage } from '../../lib/chunks.ts';
import { leaveLead, whyRefused } from '../../lib/open-table.ts';
import { copyText } from '../../lib/clipboard.ts';
import { joinVoice } from '../../lib/join-voice.ts';
import { BOARDS, drawable, rematchOf, stakedOf, type BoardComponent, type Rematch, type Staked } from '../../components/games/boards.ts';
import { WATCH_DELAY_MS, turnMs } from '../../../../backend/src/domains/match/turns.ts';

export default component PlayPage()
{
    const locale = useLocale();
    const lobby = useLobby();
    const voice = useVoice();
    const board = useBoard();
    const settings = useSettings();
    const catalogue = useCatalogue();
    const device = useDevice();
    const watch = useWatch();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const vaults = useVault();
    const params = useParams();
    const { navigate } = useNavigate();
    const chat = useChat();
    const people = usePeople();

    const mine = untrack(() => params().id ?? '');

    state chatOpen = false;

    state chatWide = false;

    state arena: HTMLElement | null = null;

    let sheetBox: HTMLElement | null = null;

    state starting = false;

    let Board: BoardComponent | null = null;

    let Chat: ((props: { conversationId: string; class?: string; closeIcon?: 'panel-close' | 'close'; wide?: boolean; onResize?: () => void; onClose?: () => void }) => MountNode) | null = null;

    state chatReady = false;

    let Watched: ((props: { watch: WatchedGame; events: EventBatch; onDone?: () => void }) => MountNode) | null = null;

    let watchAsked = false;

    state watchReady = false;

    state watchLost = false;

    let Lobby: typeof import('../../components/games/lobby-panel.component.azeroth').default | null = null;

    let lobbyAsked = false;

    state lobbyReady = false;

    state lobbyLost = false;

    let talk: Record<string, string> = {};

    let version = 0;

    state stamp = 0;

    const publish = () =>
    {
        version += 1;
        stamp = version;
    };

    derived speech = ((): Record<string, string> => (stamp >= 0 ? { ...talk } : {}))();

    let heard = new Set<string>();

    let primed = false;

    let hush: (() => void)[] = [];

    let offer = '';

    const stranded = new Map<string, string>();

    const withdraw = () =>
    {
        if (offer !== '')
        {
            toasts.dismiss(offer);
            offer = '';
        }
    };

    state drawn = '';

    const route = useRoute();

    effect
    {
        const here = route().pathname;
        const id = params().id ?? '';

        if (id !== '' && here.startsWith('/app/play/'))
        {
            lobby.open(id);
        }
    }

    mount
    {
        const release = shell.claimTitle(() => title);

        void import('../../components/games/table-chat.component.azeroth').then((module) =>
        {
            Chat = module.default;
            chatReady = true;
        });

        return () =>
        {
            release();
            withdraw();

            for (const toast of stranded.values())
            {
                toasts.dismiss(toast);
            }

            stranded.clear();

            if (untrack(voice.table) === mine)
            {
                voice.leave();
            }

            for (const stop of hush)
            {
                stop();
            }
            hush = [];

            const held = untrack(lobby.openId);

            if (held === mine || held === '')
            {
                lobby.close();
                board.close();
                watch.close();
            }
        };
    }

    derived table = lobby.table();

    derived loading = lobby.loading() && table === null;

    derived failed = lobby.failed() !== null && table === null && !lobby.loading();

    derived seated = table?.mine !== undefined;

    derived talkable = seated && table !== null && table.voice !== 'off' && table.status !== 'closed';

    let entered = '';

    effect
    {
        const id = talkable ? table!.id : null;
        const joined = voice.table();

        if (id === null)
        {
            entered = '';
        }

        if (joined !== null && joined !== id)
        {
            voice.leave();
            return;
        }

        if (id !== null && joined === null && id !== entered && untrack(settings.settings).voiceAutoJoin)
        {
            entered = id;
            void joinVoice(id);
        }
    }

    derived amHost = table?.chairs.find((chair) => chair.seat === table!.mine)?.host === true;

    effect
    {
        const apart = voice.unreached();

        for (const who of apart)
        {
            if (!stranded.has(who))
            {
                const person = people.byHandle(who);

                stranded.set(who, toasts.show({
                    kind: 'warning',
                    icon: 'voice-off',
                    text: locale.t('voice.unreached', { name: person === null ? who : locale.text(person.displayName) }),
                    duration: TOAST_ACTION_DURATION,
                    dedupe: `voice-unreached-${ who }`
                }));
            }
        }

        for (const [who, toast] of [...stranded])
        {
            if (!apart.includes(who))
            {
                toasts.dismiss(toast);
                stranded.delete(who);
            }
        }
    }

    let offered = '';

    effect
    {
        const id = talkable ? table!.id : null;
        const calling = voice.table() !== null;

        if (id === null || calling)
        {
            withdraw();
        }

        if (id === null)
        {
            offered = '';
            return;
        }

        if (!calling && !untrack(settings.settings).voiceAutoJoin && id !== offered)
        {
            offered = id;
            offer = toasts.show({
                kind: 'info',
                icon: 'voice',
                text: locale.t(untrack(lobby.table)?.voice === 'team' ? 'voice.offeredTeam' : 'voice.offered'),
                action: { label: locale.t('voice.join'), run: () => void joinVoice(id) },
                dedupe: `voice-offer-${ id }`
            });
        }
    }

    const switchVoice = () =>
    {
        const current = untrack(lobby.table);

        if (current === null)
        {
            return;
        }

        const on = current.voice === 'off';

        void lobby.setVoice(current.id, on ? 'table' : 'off')
            .then(() => toasts.show({ kind: 'success', text: locale.t(on ? 'voice.turnedOn' : 'voice.turnedOff'), dedupe: 'table-voice' }))
            .catch((error: unknown) => toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, 'voice.switchFailed', 'voice.refused.playing')), dedupe: 'table-voice' }));
    };

    const switchScope = () =>
    {
        const current = untrack(lobby.table);

        if (current === null || current.voice === 'off')
        {
            return;
        }

        const next = current.voice === 'team' ? 'table' : 'team';

        void lobby.setVoice(current.id, next)
            .then(() => toasts.show({ kind: 'success', text: locale.t(next === 'team' ? 'voice.nowTeam' : 'voice.nowTable'), dedupe: 'table-voice' }))
            .catch((error: unknown) => toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, 'voice.switchFailed', 'voice.refused.playing')), dedupe: 'table-voice' }));
    };

    derived behind = seated && table?.matchId !== undefined && board.match()?.id !== table?.matchId;

    derived unfetched = behind && board.lost();

    derived showing = !unfetched && board.match() !== null && board.match()!.tableId === table?.id;

    derived awake = showing && board.match()!.finishedAt === undefined;

    effect
    {
        if (awake)
        {
            onCleanup(holdScreen());
        }
    }

    state bed: BedState = 'off';

    derived backdrop = table !== null && table.id === mine && table.status !== 'closed' ? table.game : '';

    effect
    {
        if (backdrop !== '')
        {
            const quiet = startBed(mine, backdrop as GameId, (state) => bed = state);

            onCleanup(() =>
            {
                quiet();
                bed = 'off';
            });
        }
    }

    derived ready = table !== null
        && table.status === 'ready'
        && table.chairs.every((chair) => chair.ready);

    derived title = table !== null
        ? locale.t(catalogue.byId(table.game as GameId).nameKey)
        : (loading ? locale.t('common.loading') : locale.t('play.notFound'));

    useHead({ title: () => title });

    derived sideways = device.landscape() && device.height() <= SHORT_MAX;

    derived floating = !sideways && (device.posture() === 'sidebar' || (device.posture() === 'rail' && device.landscape()));

    derived hasChat = seated && table?.conversationId !== undefined;

    derived room = table?.conversationId ?? '';

    derived opened = table !== null && table.status !== 'closed' ? table : null;

    derived missing = !loading && !failed && table === null;

    derived closed = table?.status === 'closed';

    derived closedLead = locale.t(table?.closedBy === 'staff' ? 'play.closedLead.staff' : 'play.closedLead');

    derived dealing = behind && !showing && !unfetched;

    derived lobbyOpen = seated && !showing && !behind;

    derived removed = table?.removed === true;

    derived seatOffered = !removed;

    derived spectated = watch.view();

    derived watching = !seated && table !== null && (table.matchId !== undefined || spectated?.match.tableId === table.id);

    derived standing = !seated && !showing && table !== null && table.matchId === undefined && !watching;

    derived roomOpen = lobbyOpen || standing;

    derived paused = table !== null && catalogue.status(table.game as GameId) === 'disabled';

    derived startable = !showing && ready && seated && table?.stake === undefined && !paused;

    derived watched = watchReady ? spectated : null;

    derived callAt = talkable ? table?.id : undefined;

    derived settledCall = table !== null && table.status !== 'closed' && !(table.teams && table.matchId !== undefined);

    derived hostVoice = amHost && settledCall ? table!.voice !== 'off' : undefined;

    derived hostScope = amHost && settledCall && table!.teams && table!.voice !== 'off' ? table!.voice === 'team' : undefined;

    derived railOpen = settings.settings().railOpen;

    derived cardOpen = floating && hasChat && railOpen;

    derived sheetVisible = !floating && hasChat && chatOpen;

    onCleanup(toasts.lift());

    derived halfSheet = sheetVisible && !sideways && !chatWide;

    state sheet: SheetSize | null = null;

    effect
    {
        if (!halfSheet || arena === null || sheetBox === null)
        {
            sheet = null;
            return;
        }

        onCleanup(watchSheet(arena, sheetBox, (size) => sheet = size));
    }

    derived over = halfSheet && sheet !== null && sheet.height > sheet.pad;

    state folded = false;

    effect
    {
        if (sheetVisible || floating || sideways || arena === null)
        {
            folded = false;
            return;
        }

        onCleanup(watchFold(arena, (fold) => folded = fold));
    }

    derived besideSheet = sheetVisible && sideways;

    derived underHead = sheetVisible && !sideways && chatWide;

    state head = 0;

    effect
    {
        const header = underHead ? arena?.querySelector<HTMLElement>('header') ?? null : null;

        if (header === null)
        {
            head = 0;
            return;
        }

        onCleanup(watchEdge(header, (bottom) => head = bottom));
    }

    derived rowStyle = [
        halfSheet && sheet !== null ? `--sheet: ${ sheet.pad }px; --sheet-h: ${ sheet.height }px` : '',
        underHead && head > 0 ? `--head: ${ head }px` : ''
    ].filter(Boolean).join('; ');

    derived chatShown = cardOpen || sheetVisible;

    derived openChat = hasChat && !chatShown
        ? () =>
        {
            if (floating)
            {
                settings.update({ railOpen: true });
                return;
            }

            chatOpen = true;
        }
        : undefined;

    const closeChat = () =>
    {
        if (floating)
        {
            settings.update({ railOpen: false });
            return;
        }

        chatOpen = false;
    };

    derived said = chat.openId() === room ? chat.messages() : [];

    derived unread = room === '' ? 0 : chat.unread(room);

    derived preview = ((): string =>
    {
        if (unread === 0)
        {
            return '';
        }

        const last = [...said].reverse().find((message) => message.kind === 'text' && message.from !== lobby.me());

        if (last === undefined)
        {
            return '';
        }

        const person = people.byHandle(last.from);

        return `${ person === null ? last.from : locale.text(person.displayName) }: ${ plainOf(locale.text(last.text), locale.t('chat.spoilerPreview')) }`;
    })();

    effect
    {
        const lines = said;
        const settled = chat.openId() === room && room !== '' && !chat.threadLoading();
        const fresh = lines.filter((message) => message.kind === 'text' && !heard.has(message.id));

        if (!primed)
        {
            if (settled)
            {
                primed = true;
                heard = new Set(lines.map((message) => message.id));
            }
            return;
        }

        heard = new Set([...heard, ...lines.map((message) => message.id)]);

        for (const message of fresh)
        {
            const who = message.from;
            const text = plainOf(locale.text(message.text), locale.t('chat.spoilerPreview'));

            talk = { ...talk, [who]: text };
            publish();

            hush.push(runtime().clock.after(4500, () =>
            {
                if (talk[who] === text)
                {
                    talk = Object.fromEntries(Object.entries(talk).filter(([key]) => key !== who));
                    publish();
                }
            }));
        }
    }

    effect
    {
        const open = chatShown;
        const waiting = unread;

        if (open && waiting > 0 && room !== '')
        {
            void chat.markRead(room);
        }
    }

    derived gone = (() =>
    {
        const current = board.match();

        return showing && current !== null && current.finishedAt === undefined
            && current.players.some((player) => player.seat === current.mine && player.result !== undefined);
    })();

    derived resigning = (() =>
    {
        const current = board.match();

        return seated && showing && current !== null && inPlay(current);
    })();

    const resign = async () =>
    {
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('match.resign.title'),
                lead: locale.t('match.resign.lead'),
                confirm: locale.t('match.resign.confirm'),
                destructive: true
            },
            { label: locale.t('match.resign.title') }
        ).closed;

        if (yes === true)
        {
            await board.resign();
        }
    };

    derived playing = showing ? (board.match()?.game ?? '') : '';

    derived played = playing !== '' && drawn === playing ? board.match() : null;

    state boardFailed = false;

    const draw = (want: string) =>
    {
        boardFailed = false;

        const load = BOARDS[want];

        if (load === undefined)
        {
            return;
        }

        void load().then((module) =>
        {
            if (playing !== want)
            {
                return;
            }

            Board = module.default;
            drawn = want;
        }).catch(() =>
        {
            if (playing === want)
            {
                boardFailed = true;
            }
        });
    };

    const reload = () => void reloadPage();

    const retry = () =>
    {
        if (unfetched)
        {
            void board.refresh().catch(() => undefined);
            return;
        }

        reload();
    };

    effect
    {
        const want = playing;

        if (want === '' || want === drawn)
        {
            return;
        }

        draw(want);
    }

    derived rematch = table !== null && seated ? rematchOf(table) : undefined;

    derived vaultHeld = vaults.state();

    derived vaultOpen = vaultHeld !== null && vaultHeld.configured ? vaultHeld : null;

    derived staked = table === null ? undefined : stakedOf(table, vaultOpen?.fee ?? 0, vaultOpen?.chainId ?? 0, vaultOpen?.balances?.free);

    derived paidSeat = seated && table?.stake !== undefined;

    effect
    {
        if (paidSeat)
        {
            onCleanup(vaults.listen());
        }
    }

    const boardProps = (match: MatchView): { match: MatchView; events: EventBatch; starting: boolean; onAgain?: () => void; rematch?: Rematch; stake?: Staked; speech: Record<string, string>; turnMs: number } => ({
        match,
        events: board.events(),
        starting,
        onAgain: seated ? () => void again() : undefined,
        rematch,
        stake: staked,
        speech,
        turnMs: turnMs(table?.mode ?? 'live')
    });

    effect
    {
        const id = table?.matchId;

        if (id !== undefined && seated)
        {
            if (board.openId() !== id)
            {
                board.open(id);
            }

            return;
        }

        const held = board.match();

        if (held === null || held.tableId !== table?.id || id !== undefined)
        {
            board.close();
        }
    }

    const drawWatch = () =>
    {
        watchAsked = true;

        void chunk(() => import('../../components/games/watch-board.component.azeroth'))().then((module) =>
        {
            Watched = module.default;
            watchReady = true;
        }).catch(() =>
        {
            watchLost = true;
        });
    };

    const leaveWatch = () => watch.close();

    const rewatch = () =>
    {
        if (Watched === null)
        {
            reload();
        }
        else
        {
            watch.retry();
        }
    };

    effect
    {
        const id = table?.matchId;
        const here = table?.id;

        if (seated || here === undefined)
        {
            watch.close();
        }
        else if (id !== undefined)
        {
            watch.open(id);

            if (!watchAsked)
            {
                drawWatch();
            }
        }
        else if (untrack(() => watch.view())?.match.tableId === here)
        {
            watch.settle();
        }
        else
        {
            watch.close();
        }
    }

    const drawLobby = () =>
    {
        lobbyAsked = true;

        void chunk(() => import('../../components/games/lobby-panel.component.azeroth'))().then((module) =>
        {
            Lobby = module.default;
            lobbyReady = true;
        }).catch(() =>
        {
            lobbyLost = true;
        });
    };

    effect
    {
        if (!lobbyAsked && (roomOpen || lobby.seated().some((one) => one.id === mine && one.matchId === undefined)))
        {
            drawLobby();
        }
    }

    const invite = (tableId: string) =>
    {
        void import('../../components/games/invite-sheet.component.azeroth')
            .then((module) => overlay.open(module.default, { tableId }, { label: locale.t('play.lobby.invite') }))
            .catch(() => toasts.show({ kind: 'warning', text: locale.t('common.actionFailed'), dedupe: 'invite-sheet' }));
    };

    const starter = (step: (tableId: string) => Promise<void>) => async () =>
    {
        if (table === null || starting)
        {
            return;
        }

        starting = true;

        try
        {
            await step(table.id);
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, 'state.errorLead')) });
        }
        finally
        {
            starting = false;
        }
    };

    const begin = starter((tableId) => lobby.begin(tableId));

    const again = starter(async (tableId) =>
    {
        if (table?.stake === undefined)
        {
            await lobby.again(tableId, board.match()?.id);
            return;
        }

        if (staked?.short !== undefined)
        {
            toasts.show({ kind: 'warning', text: locale.t('tables.refused.paid-funds'), dedupe: 'paid-funds' });
            return;
        }

        const signed = await vaults.signStake(tableId);

        if ('said' in signed)
        {
            toasts.show({ kind: 'warning', text: locale.t(signed.said) });
            return;
        }

        await lobby.again(tableId, board.match()?.id, signed.signature);
    });

    const copyLink = async () =>
    {
        if (table === null)
        {
            return;
        }
        await copyText(`${ window.location.origin }/app/play/${ table.id }`, 'play.lobby.copied');
    };

    const sitDown = async () =>
    {
        if (table === null)
        {
            return;
        }
        try
        {
            const seat = await lobby.claim(table.id);

            toasts.show(seat === null
                ? { kind: 'warning', text: locale.t('play.table.tooLate') }
                : { kind: 'success', text: locale.t('play.table.satDown') });
        }
        catch (error)
        {
            toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, 'common.actionFailed', 'play.table.playing')), dedupe: 'sit-down' });
            void lobby.refresh();
        }
    };

    const leave = async (live: MatchView | null) =>
    {
        if (table === null)
        {
            return;
        }
        const id = table.id;
        const lead = leaveLead(live, table.taken);
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.leave.title'),
                lead: locale.t(lead),
                confirm: locale.t('play.lobby.leave'),
                destructive: true
            },
            { label: locale.t('play.leave.title') }
        ).closed;

        if (yes === true)
        {
            try
            {
                await lobby.leave(id, lead === 'play.leave.forfeit');
                navigate('/app/games');
            }
            catch (error)
            {
                toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, 'common.actionFailed', 'play.leave.started')), dedupe: 'leave-table' });
                void lobby.refresh();
            }
        }
    };

    const end = async () =>
    {
        if (table === null)
        {
            return;
        }
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.close.title'),
                lead: locale.t('play.close.lead'),
                confirm: locale.t('play.close.confirm'),
                destructive: true
            },
            { label: locale.t('play.close.title') }
        ).closed;

        if (yes === true)
        {
            try
            {
                await lobby.end(table.id);
                navigate('/app/games');
            }
            catch (error)
            {
                toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, 'common.actionFailed', 'play.close.refused')) });
            }
        }
    };

    <Page label={ title } fill class="page-table">
        <Show when={ loading }>
            { () =>
                <div class="flex flex-col gap-4 pt-4">
                    <Skeleton class="h-8 w-48" />
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                    </div>
                </div>
            }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ () => void lobby.refresh() } class="py-12" /> }
        </Show>

        <Show when={ missing }>
            { () =>
                <EmptyState
                    icon="seat"
                    title={ locale.t('play.notFound') }
                    lead={ locale.t('play.notFoundLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ closed }>
            { () =>
                <EmptyState
                    icon="clock"
                    title={ locale.t('play.closed') }
                    lead={ closedLead }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ opened } let={ shown }>
            <div class="flex min-h-0 flex-1 gap-4" style={ rowStyle === '' ? undefined : rowStyle }>
                <div
                    ref={ (element) => arena = element }
                    data-sheet={ over ? 'over' : (halfSheet ? 'half' : undefined) }
                    data-beside={ besideSheet ? (chatWide ? 'wide' : 'narrow') : undefined }
                    data-bed={ bed === 'off' ? undefined : bed }
                    class={ () => [ 'flex min-h-0 min-w-0 flex-1 flex-col gap-2 bg-void', halfSheet ? 'pb-[var(--sheet,48dvh)]' : '', cardOpen ? (chatWide ? 'pe-[31.5rem]' : 'pe-[24.5rem]') : '' ].filter(Boolean).join(' ') }
                >
                    <PlayHeader
                        table={ shown }
                        others={ lobby.seated().filter((one) => one.id !== shown.id) }
                        compact={ halfSheet || besideSheet || folded }
                        bare={ besideSheet }
                        class={ besideSheet ? (chatWide ? 'pe-[min(30rem,85vw)]' : 'pe-[min(23rem,60vw)]') : undefined }
                        tools={
                            <span class="flex items-center gap-2">
                                <TableDock
                                    code={ shown.code }
                                    animals={ playing === 'chess' }
                                    target={ arena }
                                    upright={ playing === 'ludo' }
                                    onChat={ floating ? undefined : openChat }
                                    onResign={ resigning ? () => void resign() : undefined }
                                    onLeave={ seated && showing ? () => void leave(board.match()) : undefined }
                                    voice={ callAt }
                                    hostVoice={ hostVoice }
                                    onHostVoice={ switchVoice }
                                    hostScope={ hostScope }
                                    onHostScope={ switchScope }
                                />
                                <Show when={ floating && hasChat && !cardOpen }>
                                    { () =>
                                        <button
                                            type="button"
                                            class="table-pill flex min-h-11 max-w-[16rem] cursor-pointer items-center gap-2.5 rounded-full border border-line-strong bg-lifted py-1 ps-1 pe-4 text-start"
                                            aria-label={ locale.t('play.table.chatShow') }
                                            onClick={ () => openChat?.() }
                                        >
                                            <span class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent-fill text-accent-ink">
                                                <Icon name="chats" size={ 18 } />
                                                <Show when={ unread > 0 }>
                                                    { () => <Badge count={ unread } tone="danger" class="absolute -end-1 -top-1" /> }
                                                </Show>
                                            </span>
                                            <span class="flex min-w-0 flex-col">
                                                <span class="text-ui-sm font-semibold text-text">{ locale.t('play.tab.chat') }</span>
                                                <Show when={ preview !== '' }>
                                                    { () => <span class="truncate text-ui-xs text-muted" dir="auto">{ preview }</span> }
                                                </Show>
                                            </span>
                                        </button>
                                    }
                                </Show>
                            </span>
                        }
                    />

                    <Show when={ gone }>
                        <p data-gone role="status" class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-0.5 text-ui-xs text-muted">
                            <Icon name="activity" size={ 14 } class="shrink-0 text-accent" />
                            <span class="font-semibold text-text">{ locale.t('watch.gone') }</span>
                            <span>{ locale.plural('watch.behind.seconds', WATCH_DELAY_MS / 1000) }</span>
                        </p>
                    </Show>

                    <Show when={ played } let={ match }>
                        <Dynamic component={ Board! } props={ () => boardProps(match) } />
                    </Show>

                    <Show when={ unfetched || (playing !== '' && drawn !== playing && boardFailed) }>
                        { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ retry } class="py-12" /> }
                    </Show>

                    <Show when={ playing !== '' && !drawable(playing) }>
                        { () =>
                            <EmptyState
                                icon="dice"
                                title={ locale.t('match.cannotDraw') }
                                lead={ locale.t('match.cannotDrawLead') }
                                action={ locale.t('match.cannotDrawAction') }
                                onAction={ reload }
                                class="py-12"
                            />
                        }
                    </Show>

                    <Show when={ dealing || (playing !== '' && drawable(playing) && drawn !== playing && !boardFailed) }>
                        { () =>
                            <div class="flex flex-col gap-3" aria-busy="true">
                                <Skeleton class="aspect-[16/10] w-full rounded-hero" />
                                <Skeleton class="h-24 w-full rounded-panel" />
                            </div>
                        }
                    </Show>


                    <Show when={ watching }>
                        { () =>
                            <div class="flex min-h-0 flex-1 flex-col gap-3">
                                <Show when={ watched } let={ seen }>
                                    <Dynamic component={ Watched! } props={ () => ({ watch: seen, events: watch.events(), onDone: leaveWatch }) } />
                                </Show>
                                <Show when={ watch.refused() }>
                                    { () =>
                                        <Panel pad="lg" class="items-center text-center">
                                            <p data-unwatchable class="max-w-[44ch] text-ui-base text-muted">{ locale.t('watch.refused') }</p>
                                        </Panel>
                                    }
                                </Show>
                                <Show when={ watch.failed() || watchLost }>
                                    { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ rewatch } class="py-12" /> }
                                </Show>
                            </div>
                        }
                    </Show>

                    <Show when={ roomOpen && lobbyReady }>
                        { () =>
                            <Dynamic
                                component={ Lobby! }
                                props={ () => ({
                                    table: shown,
                                    starting,
                                    removed,
                                    paused,
                                    onStart: startable ? () => void begin() : undefined,
                                    onSit: standing && seatOffered ? () => void sitDown() : undefined,
                                    onInvite: () => invite(shown.id),
                                    onCopyLink: () => void copyLink(),
                                    onLeave: () => void leave(null),
                                    onClose: amHost && lobbyOpen ? () => void end() : undefined
                                }) }
                            />
                        }
                    </Show>

                    <Show when={ roomOpen && lobbyLost }>
                        { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ reload } class="py-12" /> }
                    </Show>

                </div>

                <Show when={ hasChat }>
                    { () =>
                        <div
                            ref={ (element) => sheetBox = element }
                            class={ () => [
                                'flex flex-col overflow-hidden bg-field',
                                floating
                                    ? [
                                        'table-card fixed bottom-5 end-5 z-30 rounded-panel border border-line-strong',
                                        chatWide ? 'w-[min(30rem,calc(100vw-2.5rem))] h-[calc(100dvh-6.5rem)]' : 'w-[min(23rem,calc(100vw-2.5rem))] h-[min(34rem,calc(100dvh-6.5rem))]'
                                    ].join(' ')
                                    : (sideways
                                        ? [
                                            'table-sheet fixed inset-y-0 end-0 z-30 border-s border-line-strong',
                                            chatWide ? 'w-[min(30rem,85vw)]' : 'w-[min(23rem,60vw)]'
                                        ]
                                        : [
                                            'table-sheet fixed inset-x-0 bottom-0 z-30 rounded-t-sheet border-t border-line-strong',
                                            chatWide ? 'top-[calc(var(--head,0.5rem)+0.25rem)]' : 'h-[var(--sheet-h,48dvh)]'
                                        ]).join(' '),
                                chatShown ? '' : 'hidden'
                            ].filter(Boolean).join(' ') }
                        >
                            <Show when={ chatReady }>
                                { () =>
                                    <Dynamic
                                        component={ Chat! }
                                        props={ () => ({
                                            conversationId: room,
                                            class: 'min-h-0 flex-1',
                                            closeIcon: 'close' as const,
                                            wide: chatWide,
                                            onResize: () => chatWide = !chatWide,
                                            onClose: closeChat
                                        }) }
                                    />
                                }
                            </Show>
                        </div>
                    }
                </Show>
            </div>
        </Show>
    </Page>
}
