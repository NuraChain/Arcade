import { bootClient } from '@azerothjs/kit/client';

import App from './App.azeroth';
import { setRuntime } from './lib/runtime.ts';
import { loadCatalogue } from './stores/locale.store.ts';

if (import.meta.env.DEV)
{
    const seed = Number(new URLSearchParams(window.location.search).get('seed'));
    if (Number.isFinite(seed) && seed > 0)
    {
        setRuntime({ seed });
    }

    try
    {
        const { installDevtools } = await import('@azerothjs/devtools');
        installDevtools();
    }
    catch (error)
    {
        console.warn('[dev] devtools unavailable; continuing without the panel.', error);
    }
}

if (document.documentElement.lang === 'fa')
{
    await loadCatalogue('fa');
}

bootClient(App);
