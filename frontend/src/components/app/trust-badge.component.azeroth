import type { Attestation } from '../../api.ts';
import Icon from '../../icons/icon.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';

const ICON: Record<Attestation, IconName> = {
    wallet: 'verified',
    contract: 'shield',
    server: 'info'
};

const SAYS: Record<Attestation, MessageKey> = {
    wallet: 'devices.attested.wallet',
    contract: 'devices.attested.contract',
    server: 'devices.attested.server'
};

const HINT: Record<Attestation, MessageKey> = {
    wallet: 'devices.attested.walletHint',
    contract: 'devices.attested.contractHint',
    server: 'devices.attested.serverHint'
};

const TONE: Record<Attestation, string> = {
    wallet: 'text-live',
    contract: 'text-accent',
    server: 'text-muted'
};

/**
 * Who vouched for a device.
 *
 * `attested` is REQUIRED and there is no default. That is the whole design: a device this server
 * asserts on the strength of a session alone must not be able to render as wallet-verified because
 * somebody forgot to pass the prop, and the way to guarantee that is to make forgetting it fail to
 * compile rather than fail quietly on a screen.
 *
 * **The hint is the product's own `Tooltip`, not `title`.** It was the browser's for a while, which
 * on this badge is the worst place for it: the difference between a wallet-attested device and one
 * this server merely asserts is the whole of the peer story, and a native `title` cannot be styled,
 * cannot be reached by a finger at all, waits about a second, and renders in the OS's font at the
 * OS's size - which on a Persian page is a Latin font drawing Persian text.
 */
export default component TrustBadge(props: { attested: Attestation; class?: string })
{
    const locale = useLocale();

    <Tooltip label={ locale.t(HINT[props.attested]) }>
        <span
            class={ [
                'inline-flex items-center gap-1 text-ui-xs font-semibold',
                TONE[props.attested],
                props.class ?? ''
            ].join(' ') }
        >
            <Icon name={ ICON[props.attested] } size={ 14 } />
            { locale.t(SAYS[props.attested]) }
        </span>
    </Tooltip>
}
