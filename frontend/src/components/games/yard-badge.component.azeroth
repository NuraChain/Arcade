import DieFace from './die-face.component.azeroth';
import TablePlate, { type PlateTeam } from './table-plate.component.azeroth';
import { goneKey, type PlateTone } from './plate-tag.ts';
import { INITIAL } from './seats.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { nextMissForfeits } from '../../../../backend/src/domains/match/turns.ts';
import type { LudoSeat, MatchPlayer } from '../../data/match.ts';

const PIPS = [0, 1, 2, 3];

export default component YardBadge(props: {
    player: MatchPlayer;
    seat: LudoSeat;
    corner: string;
    mine?: number;
    active: boolean;
    controls: number;
    colours: string[];
    partner: boolean;
    die?: number;
    finished: boolean;
    bubble?: string;
    remainingMs?: number;
    turnMs?: number;
})
{
    const locale = useLocale();
    const people = usePeople();

    derived person = people.byHandle(props.player.who);

    derived mine = props.player.seat === props.mine;

    derived turn = props.active && !props.finished;

    derived name = mine
        ? locale.t('match.you')
        : (person === null ? props.player.who : locale.text(person.displayName));

    derived missed = props.player.timeouts ?? 0;

    derived warned = nextMissForfeits(missed) && !props.finished;

    derived routine = props.player.result === undefined && !props.seat.out && missed === 0;

    derived helping = routine && turn && props.controls !== props.player.seat;

    derived partnered = routine && !helping && props.partner;

    derived sided = props.colours.length > 1;

    derived paint = sided
        ? `--ink: var(--ludo-${ props.seat.colour }); --team-a: var(--ludo-${ props.colours[0] }); --team-b: var(--ludo-${ props.colours[1] })`
        : `--ink: var(--ludo-${ props.seat.colour })`;

    derived says = (() =>
    {
        if (props.player.result === 'won')
        {
            return locale.t('card.won');
        }

        if (props.seat.out || props.player.result === 'abandoned')
        {
            return locale.t(goneKey(props.player.exit));
        }

        if (props.player.result === 'lost')
        {
            return locale.t('card.lost');
        }

        if (props.player.result === 'void')
        {
            return locale.t('card.void');
        }

        if (missed > 0)
        {
            return locale.plural('card.missed', missed);
        }

        if (!turn)
        {
            return locale.t('card.waiting');
        }

        return mine ? locale.t('card.yourTurn') : locale.t('card.turn');
    })();

    derived tag = (() =>
    {
        if (!routine)
        {
            return says;
        }

        if (helping)
        {
            return locale.t('card.helping');
        }

        return partnered ? locale.t('card.partner') : undefined;
    })();

    derived team = ((): PlateTeam | undefined =>
    {
        if (!sided)
        {
            return undefined;
        }

        if (mine || partnered)
        {
            return { side: props.seat.side };
        }

        if (props.partner)
        {
            return { side: props.seat.side, says: locale.t('card.partner') };
        }

        return {
            side: props.seat.side,
            says: props.mine === undefined ? locale.t('team.n', { n: locale.n(props.seat.side + 1) }) : locale.t('card.opponent')
        };
    })();

    derived tone = ((): PlateTone =>
    {
        if (warned)
        {
            return 'danger';
        }

        if (props.player.result === 'won')
        {
            return 'live';
        }

        return missed > 0 && !props.finished ? 'gold' : 'neutral';
    })();

    <div class="yard-badge flex min-inline-0 data-[corner=top-left]:[grid-area:tl] data-[corner=top-right]:[grid-area:tr] data-[corner=bottom-left]:[grid-area:bl] data-[corner=bottom-right]:[grid-area:br] data-[corner$=left]:justify-start data-[corner$=right]:justify-end fit-wide:data-[corner^=top]:[align-self:start] fit-wide:data-[corner^=bottom]:[align-self:end]" data-corner={ props.corner } style={ paint }>
        <TablePlate
            who={ props.player.who }
            name={ name }
            turn={ turn }
            remainingMs={ props.remainingMs }
            turnMs={ props.turnMs }
            ink={ `var(--ludo-${ props.seat.colour })` }
            dim={ props.seat.out }
            tag={ tag }
            tone={ tone }
            team={ team }
            bubble={ props.bubble }
            below={ props.corner.startsWith('top') }
            anchor={ props.corner.endsWith('right') ? 'end' : 'start' }
            marker={ <span class="grid place-items-center inline-[1.1rem] block-[1.1rem] rounded-[999px] bg-(--ink) text-white text-[0.625rem] font-extrabold leading-none [box-shadow:0_0_0_2px_var(--void)]" aria-hidden="true">{ INITIAL[props.seat.colour] }</span> }
            facts={
                <span class="contents">
                    <span class="flex flex-none items-center gap-[3px]" role="img" aria-label={ locale.plural('match.tokens', props.seat.home) }>
                        <For each={ PIPS } key={ (pip) => pip } let={ pip }>
                            <span class="flex-none rounded-[999px] border-[color:color-mix(in_oklab,var(--ink)_75%,transparent)] data-[home=true]:border-[color:var(--ink)] data-[home=true]:bg-(--ink) data-[home=true]:[box-shadow:0_0_6px_-1px_var(--ink)] inline-[0.5rem] block-[0.5rem] border-[1.5px]" data-home={ pip < props.seat.home ? 'true' : 'false' } aria-hidden="true"></span>
                        </For>
                    </span>
                    <Show when={ routine }>
                        { () => <span class="sr-only">{ says }</span> }
                    </Show>
                </span>
            }
            trail={ props.die !== undefined && turn
                ? <span class="block flex-none inline-[1.75rem] block-[1.75rem] [filter:drop-shadow(0_4px_6px_rgb(0_0_0/0.55))]"><DieFace value={ props.die! } size="fill" label={ locale.t('match.turn.rolled', { die: locale.n(props.die!) }) } /></span>
                : undefined }
        />
    </div>
}
