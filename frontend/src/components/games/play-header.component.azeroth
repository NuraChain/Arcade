import { Link, useNavigate, type Child } from 'azerothjs';

import Rail from '../ui/rail.component.azeroth';
import GameIcon from './game-icon.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useConnection } from '../../stores/connection.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { TableSummary } from '../../api.ts';
import { copyText } from '../../lib/clipboard.ts';
import { leave, useShell } from '../../stores/shell.store.ts';
import { faceOf } from '../../lib/clocks.ts';
import { nuraOf } from '../../lib/nura.ts';

export default component PlayHeader(props: { table: TableSummary; others: TableSummary[]; tools?: Child; compact?: boolean; bare?: boolean; class?: string })
{
    const locale = useLocale();
    const shell = useShell();
    const { back, replace } = useNavigate();

    const goBack = () => leave({ back, replace }, shell.depth(), '/app/games');

    const copyCode = () =>
    {
        void copyText(props.table.code, 'play.dock.codeCopied', { dedupe: 'table-code' });
    };
    const catalogue = useCatalogue();

    derived nameOf = (game: string) => locale.t(catalogue.byId(game as GameId).nameKey);

    derived waitingOn = props.others.filter((table) => table.yourTurn === true);

    derived waiting = waitingOn.length;

    derived listed = props.compact === true ? waitingOn : [...waitingOn, ...props.others.filter((table) => table.yourTurn !== true)];

    derived listing = listed.length > 0;

    derived beside = listing && props.compact !== true;

    derived voiced = props.table.voice !== 'off';

    derived paid = props.table.stake !== undefined;

    derived clocked = props.table.clock !== undefined;

    derived clockFace = props.table.clock === undefined ? '' : faceOf(locale, props.table.clock);

    derived stakeFigure = locale.n(nuraOf(props.table.stake ?? '0'), { maximumFractionDigits: 4 });

    const connection = useConnection();

    derived link = connection.state();

    derived linked = link === 'online' || link === 'restored';

    <header class={ () => [ '@container/head min-w-0', props.class ?? '' ].filter(Boolean).join(' ') }>
        <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2 @2xl:flex-nowrap">
            <div class={ () => (beside ? '@container/title flex min-w-0 flex-1 items-center gap-3 @2xl:flex-[0_1_22rem]' : '@container/title flex min-w-0 flex-1 items-center gap-3') }>
                <IconButton icon="back" label={ locale.t('app.nav.back') } onClick={ goBack } flip class="shrink-0" />
                <span class="hidden shrink-0 @min-[14rem]/title:block">
                    <GameIcon game={ props.table.game as GameId } class="h-10 w-10" />
                </span>
                <div class="min-w-0 flex-1">
                    <h1 class="truncate text-ui-lg font-bold text-text @min-[14rem]/title:text-ui-xl">{ nameOf(props.table.game) }</h1>
                    <p class="flex min-w-0 items-center gap-2 overflow-x-clip text-ui-xs text-muted">
                        <Show
                            when={ linked }
                            fallback={
                                <span class={ () => [ 'flex min-w-0 items-center gap-1.5 font-semibold', link === 'offline' ? 'text-danger' : 'text-accent' ].join(' ') } role="status">
                                    <Icon name={ link === 'offline' ? 'wifi-off' : 'history' } size={ 12 } class="shrink-0" />
                                    <span class="truncate">{ locale.t(link === 'offline' ? 'play.link.offline' : 'play.link.reconnecting') }</span>
                                </span>
                            }
                        >
                            { () =>
                                <>
                                    <span class="shrink-0">{ props.table.teams ? locale.t('create.format.teams') : locale.plural('common.players', props.table.seats) }</span>
                                    <span class="h-1 w-1 shrink-0 rounded-full bg-faint" aria-hidden="true"></span>
                                    <span class="truncate">{ locale.t(props.table.mode === 'turns' ? 'games.mode.turns' : 'games.mode.live') }</span>
                                    <Show when={ clocked }>
                                        <span class="tally shrink-0" data-clock><span class="sr-only">{ locale.t('create.clock') } </span>{ clockFace }</span>
                                    </Show>
                                    <Show when={ paid }>
                                        <span class="shrink-0 rounded-full bg-madder px-1.5 text-ui-2xs font-semibold text-bright-ink" data-stake><span class="sr-only">{ locale.t('create.stake') } </span><span class="tally">{ stakeFigure }</span> NURA</span>
                                    </Show>
                                    <Show when={ voiced }>
                                        { () =>
                                            <span class="flex shrink-0 items-center gap-1 text-accent">
                                                <Icon name="voice" size={ 12 } />
                                                <span class="hidden @min-[26rem]/title:inline">{ locale.t(props.table.voice === 'team' ? 'voice.teamHas' : 'voice.tableHas') }</span>
                                                <span class="sr-only @min-[26rem]/title:hidden">{ locale.t(props.table.voice === 'team' ? 'voice.teamHas' : 'voice.tableHas') }</span>
                                            </span>
                                        }
                                    </Show>
                                </>
                            }
                        </Show>
                        <span class="hidden h-1 w-1 shrink-0 rounded-full bg-faint @min-[21rem]/title:block" aria-hidden="true"></span>
                        <button
                            type="button"
                            class="tally -my-3 hidden min-h-11 shrink-0 @min-[21rem]/title:flex cursor-pointer items-center gap-1 rounded-control px-1 font-semibold uppercase tracking-wide text-muted transition-colors hover:text-text"
                            aria-label={ locale.t('play.dock.copy', { code: props.table.code.toUpperCase() }) }
                            onClick={ () => copyCode() }
                        >
                            { props.table.code }
                            <Icon name="copy" size={ 12 } class="text-faint" />
                        </button>
                    </p>
                </div>
            </div>

            <Show when={ props.tools !== undefined && props.bare !== true }>
                { () => <div class="order-2 shrink-0 @2xl:order-3">{ props.tools }</div> }
            </Show>

            <Show when={ listing }>
                { () =>
                    <nav
                        class={ () => [
                            'play-others flex min-w-0 items-center',
                            props.compact === true
                                ? 'order-1 max-w-[6.5rem] shrink-0'
                                : 'order-3 basis-full @2xl:order-2 @2xl:min-w-0 @2xl:flex-1 @2xl:justify-end'
                        ].join(' ') }
                        aria-label={ locale.t('play.tables') }
                    >
                        <p class="sr-only">
                            { locale.t('play.tables') }
                            <Show when={ waiting > 0 }>
                                { () => <span>, <span class="tally">{ locale.n(waiting) }</span> { locale.plural('play.tables.waiting', waiting) }</span> }
                            </Show>
                        </p>
                        <Rail class="-mx-1 max-w-full" inner="px-1">
                        <ul class="flex shrink-0 gap-2">
                            <For each={ listed } key={ (table) => table.id } let={ table }>
                                <li class="shrink-0">
                                    <Show
                                        when={ props.compact === true }
                                        fallback={
                                            <Link
                                                to={ `/app/play/${ table.id }` }
                                                class={ () => [
                                                    'relative flex h-11 items-center gap-2 rounded-full border ps-1.5 pe-3 text-ui-sm font-semibold transition-colors @2xl/head:pe-1.5 @4xl/head:pe-3',
                                                    table.yourTurn === true
                                                        ? 'border-live/50 bg-live/10 text-text hover:bg-live/15'
                                                        : 'border-line bg-field text-muted hover:border-line-strong hover:text-text'
                                                ].join(' ') }
                                            >
                                                <GameIcon game={ table.game as GameId } class="h-8 w-8" />
                                                <span class="contents @2xl/head:block @2xl/head:sr-only @4xl/head:contents" data-words>
                                                    <span class="max-w-[9rem] truncate">{ nameOf(table.game) }</span>
                                                    <span class="shrink-0 text-ui-xs font-normal uppercase tracking-wide opacity-70">{ table.code }</span>
                                                    <Show when={ table.yourTurn === true }>
                                                        { () => <Badge dot text={ locale.t('card.yourTurn') } tone="live" /> }
                                                    </Show>
                                                </span>
                                                <Show when={ table.yourTurn === true }>
                                                    { () => <span class="absolute -end-0.5 -top-0.5 hidden h-3 w-3 rounded-full border-2 border-void bg-live @2xl/head:block @4xl/head:hidden" aria-hidden="true"></span> }
                                                </Show>
                                            </Link>
                                        }
                                    >
                                        { () =>
                                            <Link
                                                to={ `/app/play/${ table.id }` }
                                                class="relative flex h-11 w-11 items-center justify-center rounded-full border border-live/50 bg-live/10 transition-colors hover:bg-live/15"
                                            >
                                                <GameIcon game={ table.game as GameId } class="h-8 w-8" />
                                                <span class="absolute -end-0.5 -top-0.5 h-3 w-3 rounded-full border-2 border-void bg-live" aria-hidden="true"></span>
                                                <span class="sr-only">{ nameOf(table.game) } <span class="tally">{ table.code }</span>, { locale.t('card.yourTurn') }</span>
                                            </Link>
                                        }
                                    </Show>
                                </li>
                            </For>
                        </ul>
                        </Rail>
                    </nav>
                }
            </Show>
        </div>
    </header>
}
