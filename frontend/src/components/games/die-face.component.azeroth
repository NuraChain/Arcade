import { createDie, type Die } from '../../game/stage/die.ts';

const TILT = 19;

const faced = (value: number) => Number.isInteger(value) && value >= 1 && value <= 6;

export default component DieFace(props: { value: number; size?: 'sm' | 'md' | 'fill'; label: string })
{
    let host: HTMLSpanElement | null = null;
    let die: Die | null = null;

    derived box = props.size === 'sm'
        ? 'h-7 w-7'
        : (props.size === 'fill' ? 'h-full w-full' : 'h-10 w-10');

    effect
    {
        const face = props.value;

        if (faced(face))
        {
            die?.show(face, TILT);
        }
    }

    mount
    {
        const made = createDie({ flat: true });

        made.node.style.setProperty('--die', '72cqmin');
        made.node.style.left = '50%';
        made.node.style.top = '50%';
        made.show(faced(props.value) ? props.value : 1, TILT);
        host?.append(made.node);
        die = made;

        return () =>
        {
            made.dispose();
            die = null;
        };
    }

    <span
        class={ () => ['relative inline-block shrink-0 [container-type:size]', box].join(' ') }
        role="img"
        aria-label={ props.label }
        ref={ (element) => host = element }
    ></span>
}
