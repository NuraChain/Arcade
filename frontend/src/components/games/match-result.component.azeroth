import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { playersOf, scoreOf, type MatchPlayer } from '../../data/match.ts';
import type { MatchView } from '../../api.ts';
import type { Rematch } from './boards.ts';

export default component MatchResult(props: { match: MatchView; mine?: number; busy?: boolean; onAgain?: () => void; rematch?: Rematch })
{
    const locale = useLocale();
    const people = usePeople();

    const rankOf = (player: MatchPlayer) => player.place ?? (player.result === 'won' ? 1 : 2);

    derived chairs = playersOf(props.match)
        .map((player) => ({ player, score: scoreOf(props.match, player.seat) }))
        .sort((a, b) =>
            rankOf(a.player) - rankOf(b.player)
            || (a.player.side ?? a.player.seat) - (b.player.side ?? b.player.seat)
            || a.player.seat - b.player.seat);

    derived sided = new Set(chairs.map((chair) => chair.player.side ?? chair.player.seat)).size < chairs.length;

    derived home = props.match.players.find((player) => player.seat === props.mine)?.side;

    const titleOf = (side: number) =>
        home === undefined
            ? locale.t('team.n', { n: locale.n(side + 1) })
            : locale.t(side === home ? 'team.yours' : 'team.theirs');

    derived groups = sided
        ? [...new Set(chairs.map((chair) => chair.player.side ?? chair.player.seat))].map((side) => ({
            key: `side-${ side }`,
            says: titleOf(side) as string | undefined,
            chairs: chairs.filter((chair) => (chair.player.side ?? chair.player.seat) === side)
        }))
        : [{ key: 'all', says: undefined as string | undefined, chairs }];

    derived ranked = props.match.view.kind === 'poker';

    derived voided = props.match.outcome !== 'won';

    derived uncounted = props.mine !== undefined && props.match.players.some((player) => player.seat === props.mine && player.result === 'void');

    derived mineWon = props.mine !== undefined && props.match.players.some((player) => player.seat === props.mine && player.result === 'won');

    derived winners = props.match.players.filter((player) => player.result === 'won');

    const nameOf = (handle: string) =>
    {
        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    derived headline = (() =>
    {
        if (voided)
        {
            return locale.t('match.over.void');
        }

        if (mineWon)
        {
            return locale.t('match.won.you');
        }

        if (winners.length === 0)
        {
            return locale.t('match.over.nobody');
        }

        return locale.plural('match.won.them', winners.length, { names: locale.list(winners.map((player) => nameOf(player.who))) });
    })();

    derived asking = props.onAgain !== undefined && props.rematch !== undefined;

    derived ready = props.rematch?.ready === true;

    derived waiting = (props.rematch?.waiting ?? []).map(nameOf);

    derived free = props.rematch?.empty ?? 0;

    derived startable = ready && waiting.length === 0 && free === 0;

    const moved = (player: MatchPlayer) =>
        player.ratingAfter === undefined || player.ratingBefore === undefined
            ? null
            : player.ratingAfter - player.ratingBefore;

    const signed = (points: number) => `${ points >= 0 ? '+' : '−' }${ locale.n(Math.abs(points)) }`;

    <Panel pad="md" stack="md" tone={ voided ? 'field' : 'accent' }>
        <div class="flex items-center gap-3">
            <span
                class={ () => [
                    'flex h-11 w-11 shrink-0 items-center justify-center rounded-full',
                    voided ? 'bg-raised text-muted' : 'bg-win/15 text-win'
                ].join(' ') }
                aria-hidden="true"
            >
                <Icon name={ voided ? 'clock' : 'trophy' } size={ 22 } />
            </span>
            <p class="min-w-0 flex-1 text-ui-lg font-semibold text-text" aria-live="polite">{ headline }</p>
        </div>

        <For each={ groups } key={ (group) => group.key } let={ group }>
            <div class="flex flex-col gap-1.5">
                <Show when={ group.says } let={ said }>
                    <p class="label text-ui-2xs text-faint" aria-hidden="true">{ said }</p>
                </Show>
                <ul class="flex flex-col gap-1.5" aria-label={ group.says }>
                    <For each={ group.chairs } key={ (chair) => chair.player.seat } let={ chair }>
                        <li class="flex items-center gap-2 rounded-tile bg-raised/50 px-2.5 py-2">
                            <Show
                                when={ ranked && chair.player.place !== undefined }
                                fallback={
                                    <span
                                        class="tally flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-fill text-ui-2xs font-bold text-accent-ink"
                                        aria-hidden="true"
                                    >
                                        { locale.n(chair.score) }
                                    </span>
                                }
                            >
                                { () =>
                                    <span
                                        class="flex h-6 min-w-6 shrink-0 items-center justify-center rounded-full bg-accent-fill px-1.5 text-ui-2xs font-bold text-accent-ink"
                                        data-place={ chair.player.place }
                                    >
                                        { locale.ordinal('match.place', chair.player.place ?? 0) }
                                    </span>
                                }
                            </Show>
                            <span class="min-w-0 flex-1 truncate text-ui-sm text-text" dir="auto">
                                { chair.player.seat === props.mine ? locale.t('match.you') : nameOf(chair.player.who) }
                            </span>
                            <Show when={ chair.player.result !== undefined }>
                                { () =>
                                    <span class="shrink-0 text-ui-2xs text-muted">
                                        { locale.t(`history.result.${ chair.player.result! }`) }
                                    </span>
                                }
                            </Show>
                            <Show when={ moved(chair.player) !== null }>
                                { () =>
                                    <span
                                        class={ () => [
                                            'tally inline-flex shrink-0 items-center gap-1.5 text-ui-xs font-semibold',
                                            moved(chair.player)! >= 0 ? 'text-win' : 'text-muted'
                                        ].join(' ') }
                                    >
                                        <span>{ signed(moved(chair.player)!) }</span>
                                        <span class="h-1 w-1 rounded-full bg-current opacity-60" aria-hidden="true"></span>
                                        <span>{ locale.n(chair.player.ratingAfter!) }</span>
                                    </span>
                                }
                            </Show>
                        </li>
                    </For>
                </ul>
            </div>
        </For>

        <Show when={ voided }>
            { () => <p class="text-ui-xs text-muted">{ locale.t('match.over.voidLead') }</p> }
        </Show>

        <Show when={ !voided && uncounted }>
            { () => <p class="text-ui-xs text-muted">{ locale.t('match.over.voidMine') }</p> }
        </Show>

        <Show when={ asking }>
            { () =>
                <div class="flex flex-col gap-2">
                    <Show when={ !ready }>
                        { () =>
                            <Button variant="primary" size="lg" leading="play" loading={ props.busy === true } onClick={ () => props.onAgain?.() }>
                                { locale.t('match.rematch') }
                            </Button>
                        }
                    </Show>
                    <Show when={ startable }>
                        { () =>
                            <Button variant="primary" size="lg" leading="play" loading={ props.busy === true } onClick={ () => props.onAgain?.() }>
                                { locale.t('match.start') }
                            </Button>
                        }
                    </Show>
                    <div class="flex flex-col gap-1" aria-live="polite">
                        <Show when={ ready && waiting.length > 0 }>
                            { () =>
                                <p class="flex items-center gap-2 text-ui-sm text-muted">
                                    <Icon name="clock" size={ 15 } class="shrink-0" />
                                    <span class="min-w-0">{ locale.t('match.rematch.waiting', { names: locale.list(waiting) }) }</span>
                                </p>
                            }
                        </Show>
                        <Show when={ free > 0 }>
                            { () =>
                                <p class="flex items-center gap-2 text-ui-sm text-muted">
                                    <Icon name="seat" size={ 15 } class="shrink-0" />
                                    <span class="min-w-0">{ locale.plural('match.rematch.empty', free) }</span>
                                </p>
                            }
                        </Show>
                    </div>
                </div>
            }
        </Show>
    </Panel>
}
