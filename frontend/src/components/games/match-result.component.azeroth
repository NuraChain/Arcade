import { Link, untrack } from 'azerothjs';
import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { explorerTx, nuraOf } from '../../lib/nura.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { playersOf, scoreOf, type MatchPlayer } from '../../data/match.ts';
import type { MatchView, TableMoney } from '../../api.ts';
import type { Rematch, Staked } from './boards.ts';
import { potOf, shareOf } from '../../../../backend/src/domains/stake/policy.ts';
import { resultWord } from './plate-tag.ts';

const PAYING = new Set(['settling', 'settled', 'refunding', 'refunded', 'reclaimed']);

export default component MatchResult(props: { match: MatchView; mine?: number; busy?: boolean; onAgain?: () => void; rematch?: Rematch; stake?: Staked })
{
    const locale = useLocale();
    const people = usePeople();

    const rankOf = (player: MatchPlayer) => player.place ?? (player.result === 'won' ? 1 : 2);

    derived chairs = playersOf(props.match)
        .map((player) => ({ player, score: scoreOf(props.match, player.seat) }))
        .sort((a, b) =>
            rankOf(a.player) - rankOf(b.player)
            || (a.player.side ?? a.player.seat) - (b.player.side ?? b.player.seat)
            || a.player.seat - b.player.seat);

    derived sided = new Set(chairs.map((chair) => chair.player.side ?? chair.player.seat)).size < chairs.length;

    derived home = props.match.players.find((player) => player.seat === props.mine)?.side;

    const titleOf = (side: number) =>
        home === undefined
            ? locale.t('team.n', { n: locale.n(side + 1) })
            : locale.t(side === home ? 'team.yours' : 'team.theirs');

    derived groups = sided
        ? [...new Set(chairs.map((chair) => chair.player.side ?? chair.player.seat))].map((side) => ({
            key: `side-${ side }`,
            says: titleOf(side) as string | undefined,
            chairs: chairs.filter((chair) => (chair.player.side ?? chair.player.seat) === side)
        }))
        : [{ key: 'all', says: undefined as string | undefined, chairs }];

    derived ranked = props.match.view.kind === 'poker';

    state kept = null as { id: string; money: TableMoney } | null;

    effect
    {
        const now = props.stake?.money;
        const id = props.match.id;

        if (now !== undefined && PAYING.has(now.state))
        {
            untrack(() => kept = { id, money: now });
        }
    }

    derived money = props.stake?.money !== undefined && PAYING.has(props.stake.money.state)
        ? props.stake.money
        : (kept !== null && kept.id === props.match.id ? kept.money : undefined);

    derived payees = money?.winners ?? [];

    derived awaiting = money === undefined && props.stake?.money?.state === 'open';

    derived drawn = props.match.outcome === 'drawn';

    derived voided = props.match.outcome !== 'won' && !drawn && payees.length === 0 && !awaiting;

    derived staffed = props.match.voided === true;

    derived tooEarly = voided && !staffed;

    derived uncounted = props.mine !== undefined && props.match.players.some((player) => player.seat === props.mine && player.result === 'void');

    derived mineWon = props.mine !== undefined && (payees.length > 0
        ? payees.includes(props.mine)
        : props.match.players.some((player) => player.seat === props.mine && player.result === 'won'));

    derived winners = payees.length > 0
        ? props.match.players.filter((player) => payees.includes(player.seat))
        : props.match.players.filter((player) => player.result === 'won');

    derived uncountedLine = locale.t(payees.length > 0 ? 'match.over.voidPaid' : 'match.over.voidMine');

    const nameOf = (handle: string) =>
    {
        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    derived headline = (() =>
    {
        if (staffed)
        {
            return locale.t('match.over.staff');
        }

        if (voided)
        {
            return locale.t('match.over.void');
        }

        if (drawn)
        {
            return locale.t('match.over.drawn');
        }

        if (mineWon)
        {
            return locale.t('match.won.you');
        }

        if (winners.length === 0)
        {
            return locale.t('match.over.nobody');
        }

        return locale.plural('match.won.them', winners.length, { names: locale.list(winners.map((player) => nameOf(player.who))) });
    })();

    derived ending = props.match.view.kind === 'chess' ? props.match.view.over?.reason ?? null : null;

    derived reason = ending === null ? '' : locale.t(`chess.reason.${ ending }`);

    derived reasoned = reason !== '';

    derived asking = props.onAgain !== undefined && props.rematch !== undefined;

    derived ready = props.rematch?.ready === true;

    derived waiting = (props.rematch?.waiting ?? []).map(nameOf);

    derived free = props.rematch?.empty ?? 0;

    derived paid = props.stake !== undefined;

    derived startable = ready && waiting.length === 0 && free === 0 && !paid;

    derived locking = paid && ready && waiting.length === 0 && free === 0;

    derived short = paid && !ready && props.stake?.short !== undefined;

    derived shortLine = locale.t('play.stake.short', { free: locale.n(nuraOf(props.stake?.short ?? '0'), { maximumFractionDigits: 4 }) });

    derived moneyLine = (() =>
    {
        const stake = props.stake;

        if (stake === undefined || props.mine === undefined || money === undefined)
        {
            return '';
        }

        if (money.state === 'reclaimed')
        {
            return locale.t('match.money.reclaimed');
        }

        if (payees.length === 0)
        {
            return locale.t(money.state === 'refunded' ? 'match.money.refunded' : 'match.money.refunding');
        }

        const amount = BigInt(stake.amount);

        if (!payees.includes(props.mine))
        {
            return locale.t('match.money.lost', { amount: locale.n(nuraOf(amount), { maximumFractionDigits: 4 }) });
        }

        const share = shareOf(potOf(amount, props.match.players.length), money.feeBps, payees.length);

        return locale.t(money.state === 'settled' ? 'match.money.won' : 'match.money.winning', { amount: locale.n(nuraOf(share), { maximumFractionDigits: 4 }) });
    })();

    derived moneyShown = moneyLine !== '';

    derived checkTo = `/app/me/wallet/check/${ props.match.id }`;

    derived moneyLink = money?.closeTx === undefined || props.stake === undefined ? null : explorerTx(props.stake.chainId, money.closeTx);

    const moved = (player: MatchPlayer) =>
        player.ratingAfter === undefined || player.ratingBefore === undefined
            ? null
            : player.ratingAfter - player.ratingBefore;

    const signed = (points: number) => `${ points >= 0 ? '+' : '−' }${ locale.n(Math.abs(points)) }`;

    <Panel pad="md" stack="md" tone={ voided ? 'field' : 'accent' }>
        <div class="flex items-center gap-3">
            <span
                class={ () => [
                    'flex h-11 w-11 shrink-0 items-center justify-center rounded-full',
                    voided ? 'bg-raised text-muted' : (drawn ? 'bg-gold/15 text-gold' : 'bg-win/15 text-win')
                ].join(' ') }
                aria-hidden="true"
            >
                <Icon name={ voided ? 'clock' : (drawn ? 'equal' : 'trophy') } size={ 22 } />
            </span>
            <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <p class="text-ui-lg font-semibold text-text" aria-live="polite">{ headline }</p>
                <Show when={ reasoned }>
                    { () => <p class="text-ui-sm text-muted">{ reason }</p> }
                </Show>
            </div>
        </div>

        <For each={ groups } key={ (group) => group.key } let={ group }>
            <div class="flex flex-col gap-1.5">
                <Show when={ group.says } let={ said }>
                    <p class="label text-ui-2xs text-faint" aria-hidden="true">{ said }</p>
                </Show>
                <ul class="flex flex-col gap-1.5" aria-label={ group.says }>
                    <For each={ group.chairs } key={ (chair) => chair.player.seat } let={ chair }>
                        <li class="flex items-center gap-2 rounded-tile bg-raised/50 px-2.5 py-2">
                            <Show
                                when={ ranked && chair.player.place !== undefined }
                                fallback={
                                    <span
                                        class="tally flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-accent-fill text-ui-2xs font-bold text-accent-ink"
                                        aria-hidden="true"
                                    >
                                        { locale.n(chair.score) }
                                    </span>
                                }
                            >
                                { () =>
                                    <span
                                        class="flex h-6 min-w-6 shrink-0 items-center justify-center rounded-full bg-accent-fill px-1.5 text-ui-2xs font-bold text-accent-ink"
                                        data-place={ chair.player.place }
                                    >
                                        { locale.ordinal('match.place', chair.player.place ?? 0) }
                                    </span>
                                }
                            </Show>
                            <span class="min-w-0 flex-1 truncate text-ui-sm text-text" dir="auto">
                                { chair.player.seat === props.mine ? locale.t('match.you') : nameOf(chair.player.who) }
                            </span>
                            <Show when={ chair.player.result !== undefined }>
                                { () =>
                                    <span class="shrink-0 text-ui-2xs text-muted">
                                        { resultWord(locale, chair.player.result!, chair.player.exit) }
                                    </span>
                                }
                            </Show>
                            <Show when={ moved(chair.player) !== null }>
                                { () =>
                                    <span
                                        class={ () => [
                                            'tally inline-flex shrink-0 items-center gap-1.5 text-ui-xs font-semibold',
                                            moved(chair.player)! >= 0 ? 'text-win' : 'text-muted'
                                        ].join(' ') }
                                    >
                                        <span>{ signed(moved(chair.player)!) }</span>
                                        <span class="h-1 w-1 rounded-full bg-current opacity-60" aria-hidden="true"></span>
                                        <span>{ locale.n(chair.player.ratingAfter!) }</span>
                                    </span>
                                }
                            </Show>
                        </li>
                    </For>
                </ul>
            </div>
        </For>

        <Show when={ moneyShown }>
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ui-sm font-semibold text-madder" data-money>
                <Icon name="coins" size={ 15 } class="shrink-0" />
                <span class="min-w-0">{ moneyLine }</span>
                <Show when={ moneyLink } let={ href }>
                    <a class="font-semibold text-accent hover:underline" href={ href } target="_blank" rel="noopener noreferrer">{ locale.t('vault.tx') }</a>
                </Show>
            </p>
        </Show>

        <Show when={ moneyShown }>
            <Link to={ () => checkTo } class="inline-flex min-h-11 items-center gap-1.5 self-start text-ui-sm font-semibold text-accent hover:underline" data-check>
                <Icon name="shield" size={ 15 } class="shrink-0" />
                <span>{ locale.t('match.check') }</span>
            </Link>
        </Show>

        <Show when={ staffed }>
            { () => <p class="text-ui-xs text-muted" data-staffed>{ locale.t('match.over.staffLead') }</p> }
        </Show>

        <Show when={ tooEarly }>
            { () => <p class="text-ui-xs text-muted">{ locale.t('match.over.voidLead') }</p> }
        </Show>

        <Show when={ !voided && !awaiting && uncounted && !staffed }>
            { () => <p class="text-ui-xs text-muted">{ uncountedLine }</p> }
        </Show>

        <Show when={ asking }>
            { () =>
                <div class="flex flex-col gap-2">
                    <Show when={ !ready }>
                        { () =>
                            <Button variant="primary" size="lg" leading="play" loading={ props.busy === true } onClick={ () => props.onAgain?.() }>
                                { locale.t('match.rematch') }
                            </Button>
                        }
                    </Show>
                    <Show when={ short }>
                        { () =>
                            <div class="flex flex-col" data-short>
                                <p class="text-ui-sm font-semibold text-gold">{ shortLine }</p>
                                <Link to="/app/me/wallet" class="inline-flex min-h-11 items-center self-start text-ui-sm font-semibold text-accent hover:underline">{ locale.t('vault.title') }</Link>
                            </div>
                        }
                    </Show>
                    <Show when={ startable }>
                        { () =>
                            <Button variant="primary" size="lg" leading="play" loading={ props.busy === true } onClick={ () => props.onAgain?.() }>
                                { locale.t('match.start') }
                            </Button>
                        }
                    </Show>
                    <div class="flex flex-col gap-1" aria-live="polite">
                        <Show when={ locking }>
                            { () =>
                                <p class="flex items-center gap-2 text-ui-sm text-muted">
                                    <Icon name="lock" size={ 15 } class="shrink-0" />
                                    <span class="min-w-0">{ locale.t('play.stake.locking') }</span>
                                </p>
                            }
                        </Show>
                        <Show when={ ready && waiting.length > 0 }>
                            { () =>
                                <p class="flex items-center gap-2 text-ui-sm text-muted">
                                    <Icon name="clock" size={ 15 } class="shrink-0" />
                                    <span class="min-w-0">{ locale.t('match.rematch.waiting', { names: locale.list(waiting) }) }</span>
                                </p>
                            }
                        </Show>
                        <Show when={ free > 0 }>
                            { () =>
                                <p class="flex items-center gap-2 text-ui-sm text-muted">
                                    <Icon name="seat" size={ 15 } class="shrink-0" />
                                    <span class="min-w-0">{ locale.plural('match.rematch.empty', free) }</span>
                                </p>
                            }
                        </Show>
                    </div>
                </div>
            }
        </Show>
    </Panel>
}
