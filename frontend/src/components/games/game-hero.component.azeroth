import type { Game } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';
import Chip from '../ui/chip.component.azeroth';
import GameArt from './game-art.component.azeroth';
import LiveStats from './live-stats.component.azeroth';
import SeatCount from './seat-count.component.azeroth';

export default component GameHero(props: { game: Game; onQuickPlay: () => void })
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    derived known = !catalogue.loading();

    derived playable = known && catalogue.playable(props.game.id);

    derived rules = catalogue.rules(props.game.id);

    derived name = locale.t(props.game.nameKey);

    <section class="hero-surface overflow-hidden rounded-hero" aria-labelledby="game-title">
        <div class="grid @3xl:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)] @3xl:items-center">
            <div class="p-3 pb-0 @3xl:order-2 @3xl:p-5">
                <GameArt game={ props.game.id } priority class="rounded-panel border border-line shadow-2" />
            </div>
            <div class="flex min-w-0 flex-col gap-4 p-5 @xl:p-7">
                <div class="flex flex-wrap items-center gap-2">
                    <Chip icon={ props.game.category === 'cards' ? 'cards' : 'dice' }>{ locale.t(props.game.categoryKey) }</Chip>
                    <Chip icon="people"><SeatCount game={ props.game } /></Chip>
                    <Show when={ rules.partners }>{ () => <Chip icon="versus">{ locale.t('games.partners') }</Chip> }</Show>
                    <Show when={ rules.stakes === 'play-money' }>{ () => <Chip icon="coins" tone="accent">{ locale.t('games.stakes.playMoney') }</Chip> }</Show>
                </div>
                <div>
                    <h1 id="game-title" class="title text-ui-3xl @xl:text-ui-4xl">{ name }</h1>
                    <p class="mt-2 max-w-[48ch] text-ui-md text-muted">{ locale.t(props.game.blurbKey) }</p>
                </div>
                <LiveStats game={ props.game.id } />
                <Show when={ known }>
                    <Show
                        when={ playable }
                        fallback={
                            <p class="flex items-start gap-2 rounded-tile border border-line bg-void/40 p-3 text-ui-sm text-muted">
                                <Icon name="clock" size={ 16 } class="mt-0.5 shrink-0 text-muted" />
                                <span>{ locale.t('games.soonLead') }</span>
                            </p>
                        }
                    >
                        { () =>
                            <div class="hidden flex-wrap gap-3 sm:flex">
                                <span class="glow-cta flex rounded-control">
                                    <Button variant="primary" size="lg" leading="play" icon="forward" class="whitespace-nowrap" onClick={ () => props.onQuickPlay() }>{ locale.t('app.nav.quickPlay') }</Button>
                                </span>
                                <Button variant="outline" size="lg" leading="add" class="whitespace-nowrap" to={ `/app/games/${ props.game.slug }/create` }>{ locale.t('games.create') }</Button>
                            </div>
                        }
                    </Show>
                </Show>
                <ul class="flex flex-wrap gap-2" aria-label={ locale.t('game.modes') }>
                    <For each={ [...rules.modes] } key={ (mode) => mode } let={ mode }>
                        <li class="flex items-center gap-2 whitespace-nowrap rounded-full border border-line bg-void/40 px-3 py-1.5 text-ui-xs text-muted">
                            <Icon name={ mode === 'live' ? 'zap' : 'clock' } size={ 13 } class={ mode === 'live' ? 'text-live' : '' } />
                            <span class="font-semibold text-text">{ locale.t(mode === 'live' ? 'games.mode.live' : 'games.mode.turns') }</span>
                            <span class="hidden @xl:inline @3xl:hidden @6xl:inline">{ locale.t(mode === 'live' ? 'games.mode.liveHint' : 'games.mode.turnsHint') }</span>
                        </li>
                    </For>
                </ul>
            </div>
        </div>
    </section>
}
