import { untrack } from 'azerothjs';

import BoardCanvas from './board-canvas.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import TableResult from './table-result.component.azeroth';
import DieFace from './die-face.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import YardBadge from './yard-badge.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { SHORT_MAX, useDevice } from '../../stores/device.store.ts';
import { useBoard, type EventBatch } from '../../stores/match.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import type { MatchView } from '../../api.ts';
import type { Rematch } from './boards.ts';
import type { BoardGoal, BoardHandle, BoardOptions, Facts } from '../../game/bridge.ts';
import { chairsOf, ludoOf, type LudoSeat, type MatchPlayer } from '../../data/match.ts';
import { seatsFor } from './seats.ts';
import { turnChime } from './table-cues.ts';
import { CELL, FRAME_ROUND, MARGIN } from '../../game/layout.ts';
import { HISTORY, feltOf, keyOf, type Felt, type Told } from '../../game/ludo-felt.ts';
import { createSound, type SoundHandle } from '../../game/sound.ts';
import { createPresenter, type Sight, type Table } from '../../game/stage/presenter.ts';
import { createStage } from '../../game/stage/stage.ts';
import { coachOf, goalsOf, movedTo, pieceFor } from '../../game/helpers/ludo.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { partnerOf, variantOf } from '../../../../backend/src/domains/match/sides.ts';

const STAGE = `--cell-cq: ${ (CELL * 100).toFixed(4) }cqi; --margin-cq: ${ (MARGIN * 100).toFixed(4) }cqi; border-radius: ${ (FRAME_ROUND * 100).toFixed(3) }%`;

const PRESS_MS = 400;

const HURRY_MS = 8000;

const NOTHING: ReadonlySet<string> = new Set();

const NO_GOALS: readonly BoardGoal[] = [];

const SPENT = { 'no-move': 'match.stuck', 'three-sixes': 'match.sixes', wasted: 'match.wasted' } as const;

export default component MatchBoard(props: { match: MatchView; events: EventBatch; starting?: boolean; onAgain?: () => void; rematch?: Rematch; speech?: Record<string, string>; turnMs?: number; onPresenting?: (busy: boolean) => void })
{
    const locale = useLocale();
    const board = useBoard();
    const device = useDevice();
    const people = usePeople();
    const settings = useSettings();

    derived game = props.match;

    derived help = settings.settings();

    derived ludo = ludoOf(game) ?? { kind: 'ludo' as const, die: undefined, moves: [], controls: 0, seats: [] };

    derived chairs = chairsOf(game);

    derived mine = game.mine;

    derived over = game.finishedAt !== undefined;

    derived turnOf = game.players.find((player) => player.seat === game.turn);

    derived sided = new Set(ludo.seats.map((seat) => seat.side)).size < ludo.seats.length;

    derived partner = mine === undefined ? null : partnerOf(mine, { seats: game.seats, variant: variantOf(sided) });

    derived helping = !over && game.turn !== undefined && ludo.controls !== game.turn;

    const nameFor = (seat: number | undefined) =>
    {
        const player = game.players.find((one) => one.seat === seat);

        if (player === undefined)
        {
            return '';
        }

        return people.byHandle(player.who)?.displayName ?? player.who;
    };

    derived nameOf = nameFor(turnOf?.seat);

    derived owner = nameFor(ludo.controls);

    derived says = (() =>
    {
        if (mine !== undefined && mine === game.turn)
        {
            if (ludo.die !== undefined)
            {
                return locale.t('match.turn.rolled', { die: locale.n(ludo.die) });
            }

            return helping ? locale.t('match.turn.helping', { name: owner }) : locale.t('match.turn.yours');
        }

        if (!helping)
        {
            return locale.t('match.turn.theirs', { name: nameOf });
        }

        return mine === ludo.controls
            ? locale.t('match.turn.helpingYours', { name: nameOf })
            : locale.t('match.turn.helpingTheirs', { name: nameOf, partner: owner });
    })();

    state ahead: { id: string; rev: number; board: NonNullable<ReturnType<typeof movedTo>> } | null = null;

    state facts: Facts | null = null;

    state presenting = false;

    state rigged = false;

    state said = '';

    state passed = '';

    state shownRev = 0;

    state handed = false;

    derived drawn = ahead !== null && ahead.id === game.id && ahead.rev === game.rev ? ahead.board : ludo;

    derived tokens = seatsFor(drawn, mine);

    derived movable = new Set(tokens.filter((token) => token.playable).map((token) => token.key));

    derived goals = movable.size === 0 ? NO_GOALS : goalsOf(drawn).map((goal) => ({ key: keyOf(drawn.controls, goal.piece), to: goal.to, takes: goal.takes }));

    derived result = over && !presenting;

    derived yours = !over && mine !== undefined && mine === game.turn;

    derived hurried = game.remainingMs !== undefined && game.remainingMs < HURRY_MS;

    derived landed = hurried || shownRev >= game.rev;

    derived homeAt = (seat: number, told: number) => facts?.home[seat] ?? told;

    derived gone = (seat: LudoSeat) => (facts === null ? seat.out : facts.out.includes(seat.seat));

    derived seatAt = (seat: LudoSeat): LudoSeat => (seat.out === gone(seat) ? seat : { ...seat, out: gone(seat) });

    derived playerAt = (player: MatchPlayer, seat: LudoSeat): MatchPlayer =>
    {
        if (player.result === undefined || result || gone(seat))
        {
            return player;
        }

        const { result: _unshown, exit: _how, ...playing } = player;

        return playing;
    };

    derived dieAt = (seat: number) =>
    {
        if (facts === null)
        {
            return seat === game.turn ? ludo.die : undefined;
        }

        return facts.die !== null && facts.plate && facts.die.roller === seat ? facts.die.face : undefined;
    };

    const CORNER: Record<string, string> = {
        red: 'top-left',
        green: 'top-right',
        blue: 'bottom-left',
        yellow: 'bottom-right'
    };

    derived seatCards = chairs.map((chair) => ({
        player: chair.player,
        seat: chair.seat,
        corner: CORNER[chair.seat.colour] ?? 'top-left',
        colours: ludo.seats.filter((one) => one.side === chair.seat.side).map((one) => one.colour)
    }));

    derived sideways = device.landscape() && device.height() <= SHORT_MAX;

    derived tip = over || !landed ? null : coachOf(ludo, mine, game.turn, props.events.events.flatMap((event) => event.log.kind === 'ludo' ? event.log.moves : []));

    derived winners = ludo.seats
        .filter((seat) => game.players.some((player) => player.seat === seat.seat && player.result === 'won'))
        .map((seat) => seat.colour);

    let table: BoardHandle | null = null;
    let sound: SoundHandle | null = null;

    const report = (error: unknown) => console.error(error);

    const stage = createStage({ clock: runtime().clock, quiet: () => device.reducedMotion(), report });

    const sightNow = (): Sight<Felt> => ({ id: game.id, rev: game.rev, seat: mine ?? null, view: feltOf(drawn, game.turn, winners) });

    const proxy: Table<Felt, Told> = {
        kind: 'ludo',
        history: HISTORY,
        reset: (sight) => table?.reset(sight),
        same: (sight) => table?.same(sight) ?? true,
        settle: (sight, ctx) => table?.settle(sight, ctx),
        play: (acts, sight, ctx) => table?.play(acts, sight, ctx),
        estimate: (acts) => table?.estimate(acts) ?? 0
    };

    const presenter = createPresenter<Felt, Told>({ stage, clock: runtime().clock, table: proxy, sight: () => untrack(sightNow), report });

    const level = () =>
    {
        if (!presenter.presenting())
        {
            shownRev = untrack(() => game.rev);
        }
    };

    const unwatch = presenter.watch((busy) =>
    {
        presenting = busy;
        props.onPresenting?.(busy);

        if (!busy)
        {
            passed = '';
            level();
        }
    });

    const chime = turnChime(() => sound);

    const offering = () => (handed ? mine ?? null : null);

    const attach = (made: BoardHandle | null) =>
    {
        table = made;

        rigged = made !== null;

        if (made === null)
        {
            facts = null;

            return;
        }

        made.reset(untrack(sightNow));
        made.offer(untrack(offering));
        made.lit(untrack(() => (landed ? movable : NOTHING)), untrack(() => help.hintMoves), untrack(() => goals));
    };

    effect
    {
        const batch = props.events;

        void game.id;
        void game.rev;

        untrack(() =>
        {
            presenter.see(batch);
            level();
        });
    }

    effect
    {
        const keys = landed ? movable : NOTHING;
        const marks = goals;
        const hints = help.hintMoves;

        untrack(() => table?.lit(keys, hints, marks));
    }

    effect
    {
        const can = board.canRoll();
        const told = landed;

        untrack(() =>
        {
            if (!can)
            {
                handed = false;
            }
            else if (told)
            {
                handed = true;
            }
        });
    }

    effect
    {
        const seat = offering();

        untrack(() => table?.offer(seat));
    }

    effect
    {
        const next = says;
        const told = landed;

        if (told)
        {
            said = next;
        }
    }

    effect
    {
        const mineNow = yours;

        untrack(() => chime(mineNow));
    }

    effect
    {
        const on = help.sound;

        untrack(() => sound?.setEnabled(on));
    }

    mount
    {
        sound = createSound(untrack(() => help.sound));

        return () =>
        {
            unwatch();
            props.onPresenting?.(false);
            presenter.dispose();
            sound?.dispose();
            sound = null;
        };
    }

    const pick = async (key: string) =>
    {
        const [seat, piece] = key.split('-').map(Number);
        const held = untrack(() => ludo);
        const reader = untrack(() => mine);
        const moving = reader !== undefined && reader === untrack(() => game.turn) && seat === held.controls;
        const legal = moving ? pieceFor(held, piece) : null;

        if (legal === null || !board.moves().includes(legal))
        {
            return;
        }

        if (legal !== piece)
        {
            table?.swap(key, keyOf(seat, legal));
        }

        await moveNow(legal);
    };

    const moveNow = async (piece: number) =>
    {
        const seat = untrack(() => mine);
        const current = untrack(() => ludo);
        const id = untrack(() => game.id);
        const rev = untrack(() => game.rev);
        const next = seat === undefined || untrack(board.busy) ? null : movedTo(current, piece);

        if (next !== null)
        {
            const to = next.seats.find((one) => one.seat === current.controls)?.tokens.find((token) => token.piece === piece)?.at;
            const key = keyOf(current.controls, piece);

            ahead = { id, rev, board: next };

            if (to !== undefined)
            {
                presenter.act(async () =>
                {
                    await table?.advance(key, to);
                }, PRESS_MS);
            }
        }

        const outcome = await board.move(piece);

        if (outcome === 'stale' || outcome === 'failed')
        {
            ahead = null;
            presenter.act((ctx) => table?.settle(untrack(sightNow), ctx));
        }
    };

    const roll = async () =>
    {
        table?.rattle(true);

        if (presenter.presenting())
        {
            presenter.act(() => undefined);
        }

        const outcome = await board.roll();

        if (outcome === 'stale' || outcome === 'failed')
        {
            table?.rattle(false);
        }
    };

    const gear: Omit<BoardOptions, 'host' | 'plate'> = {
        stage,
        sound: () => sound,
        feel: (kind) =>
        {
            if (untrack(() => mine) !== undefined)
            {
                haptic(kind);
            }
        },
        onPick: (key) => void pick(key),
        onFacts: (next) =>
        {
            facts = next;
        },
        onPass: (roller, face, fate) =>
        {
            const whose = untrack(() => mine) === roller ? 'you' : 'them';

            passed = locale.t(`${ SPENT[fate] }.${ whose }`, { name: untrack(() => nameFor(roller)), die: locale.n(face) });
        }
    };

    <div data-rev={ props.match.rev } data-presenting={ presenting ? 'true' : undefined } class="table-stage p-2.5 rounded-hero [background:radial-gradient(ellipse_70%_60%_at_50%_42%,rgb(255_184_110/0.16),transparent_70%),radial-gradient(ellipse_85%_80%_at_50%_50%,transparent_52%,rgb(6_3_1/0.62)_100%),#3A2110_url('/board/ludo-table.webp')_center/cover_no-repeat] [box-shadow:inset_0_1px_0_rgb(255_255_255/0.07),inset_0_0_0_1px_rgb(0_0_0/0.45),0_24px_48px_-28px_rgb(0_0_0/0.9)] slim:mx-[calc(0.375rem_-_var(--page-pad,1rem))]">
        <div class="table-grid ludo-grid">
            <div class="table-fit">
                <div class="ludo-frame [--plate-row:3rem] [--plate-col:9.5rem] [direction:ltr] grid grid-cols-[minmax(0,1fr)_minmax(0,1fr)] [grid-template-areas:'tl_tr'_'board_board'_'bl_br'] items-center gap-2 inline-[min(100cqw,100cqh_-_2_*_var(--plate-row)_-_1rem)] fit-wide:grid-cols-[var(--plate-col)_auto_var(--plate-col)] fit-wide:grid-rows-[minmax(0,1fr)_minmax(0,1fr)] fit-wide:[grid-template-areas:'tl_board_tr'_'bl_board_br'] fit-wide:inline-auto fit-wide:gap-x-3 fit-wide:[--plate-col:6.5rem] fit-short:[--plate-col:5.75rem] fit-short:[--plate-row:2.75rem]">
                    <For each={ seatCards } key={ (entry) => entry.player.seat } let={ entry }>
                        <div class="contents">
                            <YardBadge
                                player={ playerAt(entry.player, entry.seat) }
                                seat={ seatAt(entry.seat) }
                                home={ homeAt(entry.player.seat, entry.seat.home) }
                                corner={ entry.corner }
                                mine={ mine }
                                active={ entry.player.seat === game.turn }
                                controls={ ludo.controls }
                                colours={ entry.colours }
                                partner={ entry.player.seat === partner }
                                die={ dieAt(entry.player.seat) }
                                finished={ over }
                                bubble={ props.speech?.[entry.player.who] }
                                remainingMs={ game.remainingMs }
                                turnMs={ props.turnMs }
                            />
                        </div>
                    </For>

                    <div class="board-stage table-surface isolate @container [box-shadow:0_26px_40px_-20px_rgb(0_0_0/0.85),0_3px_8px_rgb(0_0_0/0.45)] [grid-area:board]" style={ STAGE }>
                        <BoardCanvas game={ game.game } tokens={ tokens } rig={ gear } onTable={ attach } />

                        <Show when={ board.canRoll() }>
                            { () =>
                                <button
                                    type="button"
                                    class="board-roll group/roll absolute z-[6] left-[50%] top-[50%] grid place-items-center inline-[max(3.5rem,calc(var(--cell-cq)*3.2))] block-[max(3.5rem,calc(var(--cell-cq)*3.2))] [translate:-50%_-50%] rounded-[calc(var(--cell-cq)*0.8)] cursor-pointer [-webkit-tap-highlight-color:transparent] disabled:cursor-progress focus-visible:[outline:3px_solid_var(--accent)] focus-visible:outline-offset-2"
                                    aria-label={ locale.t('match.roll') }
                                    disabled={ board.busy() }
                                    onClick={ () => void roll() }
                                >
                                    <Show when={ !rigged }>
                                        { () =>
                                            <span class="inline-[70%] block-[70%] [filter:drop-shadow(0_8px_10px_rgb(0_0_0/0.55))] motion-safe:animate-[roll-bob_1.4s_ease-in-out_infinite] group-active/roll:[scale:0.92] motion-safe:group-disabled/roll:animate-[roll-shake_0.45s_linear_infinite]" aria-hidden="true">
                                                <DieFace value={ 5 } size="fill" label={ locale.t('match.roll') } />
                                            </span>
                                        }
                                    </Show>
                                </button>
                            }
                        </Show>
                    </div>
                </div>
            </div>

            <Show when={ !over }>
                { () =>
                    <section class="table-bar ludo-bar">
                        <p class="sr-only" aria-live="polite">{ passed === '' ? said : passed }</p>
                        <CoachLine tip={ tip } lamp />
                        <Show when={ sideways }>
                            { () =>
                                <p class="ludo-upright">
                                    <Icon name="phone" size={ 14 } class="shrink-0" />
                                    <span>{ locale.t('match.upright') }</span>
                                </p>
                            }
                        </Show>
                        <TurnClock remainingMs={ game.remainingMs } over={ over } yours={ yours } class="ludo-clock" />
                    </section>
                }
            </Show>
        </div>

        <Show when={ result }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } rematch={ props.rematch } />
            }
        </Show>
    </div>
}
