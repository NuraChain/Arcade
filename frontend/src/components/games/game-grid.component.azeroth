import type { Game } from '../../data/games.ts';
import GameCard from './game-card.component.azeroth';

export default component GameGrid(props: {
    games: Game[];
    compact?: boolean;
    detailed?: boolean;
    label: string;
    class?: string;
})
{
    <ul
        class={ [
            'grid grid-cols-2 gap-3 @md:gap-4',
            props.compact === true ? '@2xl:grid-cols-3' : '@6xl:grid-cols-4',
            props.class ?? ''
        ].filter(Boolean).join(' ') }
        aria-label={ props.label }
    >
        <For each={ props.games } key={ (game) => game.id } let={ game }>
            <li class="@container flex min-w-0">
                <GameCard game={ game } compact={ props.compact } detailed={ props.detailed } class="flex-1" />
            </li>
        </For>
    </ul>
}
