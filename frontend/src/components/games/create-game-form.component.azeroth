import { ApiError } from '../../api.ts';
import { whyRefused } from '../../lib/open-table.ts';
import type { Game, GameId } from '../../data/games.ts';
import type { Person } from '../../data/person.ts';
import type { MessageKey } from '../../locales/en.ts';
import { cubeLive } from '../../../../backend/src/domains/match/backgammon/cube.ts';
import { teamsOf } from '../../../../backend/src/domains/table/teams.ts';
import { formatsOf, isValidTable, type Blinds, type TableConfig, type TableFormat, type TableMode, type TablePrivacy } from '../../data/tables.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useSocial } from '../../stores/social.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Chip from '../ui/chip.component.azeroth';
import SearchInput from '../ui/search-input.component.azeroth';
import Segmented from '../ui/segmented.component.azeroth';
import Toggle from '../ui/switch.component.azeroth';
import { PANEL_TONE } from '../ui/variants.ts';

const TEAMS_HINT: Partial<Record<GameId, MessageKey>> = {
    hokm: 'create.teamsHint.hokm'
};

export default component CreateGameForm(props: { game: Game; onCreated: (tableId: string) => void })
{
    const locale = useLocale();
    const toasts = useToasts();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const account = useAccount();
    const presence = usePresence();
    const people = usePeople();
    const social = useSocial();

    derived rules = catalogue.rules(props.game.id);
    derived defaults = catalogue.defaults(props.game.id);

    state seats = defaults.seats;
    state paired = defaults.teams;
    state mode = defaults.mode as TableMode;
    state privacy = defaults.privacy as TablePrivacy;
    state target = defaults.target;
    state cube = defaults.cube;
    state blinds = defaults.blinds as Blinds;
    state chat = defaults.chat;
    state voice = defaults.voice;
    state invitees = [] as string[];
    state query = '';
    state pending = false;

    derived hasCube = rules.hasCube;

    derived hasBlinds = rules.hasBlinds;

    derived cubeOffered = cubeLive(target, true);

    derived cubed = cubeLive(target, cube);

    derived formats = formatsOf(rules);

    derived choosable = formats.length > 1;

    derived teams = teamsOf(rules.partners, seats, paired);

    derived teamsHint = teams ? TEAMS_HINT[props.game.id] ?? null : null;

    derived config = { game: props.game.id, seats, mode, privacy, target, cube: cubed, blinds, chat, voice, teams } satisfies TableConfig;

    derived tooMany = invitees.length > seats - 1;

    derived valid = isValidTable(config, rules) && !tooMany;

    derived friends = ((): Person[] =>
    {
        const user = account.user();
        if (user === null)
        {
            return [];
        }
        const needle = query.trim().toLowerCase();
        const rank = (person: Person): number => (presence.isOnline(person.id) ? 0 : 1);
        return social.friends()
            .map((id) => people.byHandle(id))
            .filter((person): person is Person => person !== null)
            .filter((person) => needle === '' || person.displayName.toLowerCase().includes(needle) || person.handle.includes(needle))
            .sort((a, b) => rank(a) - rank(b));
    })();

    derived privacyHint = locale.t(privacy === 'friends'
        ? 'create.privacy.friendsHint'
        : (privacy === 'public' ? 'create.privacy.publicHint' : 'create.privacy.inviteHint'));

    const choose = (format: TableFormat) =>
    {
        seats = format.seats;
        paired = format.teams;
    };

    const toggleInvite = (id: string) =>
    {
        invitees = invitees.includes(id) ? invitees.filter((entry) => entry !== id) : [...invitees, id];
    };

    const submit = () =>
    {
        if (!valid || pending)
        {
            return;
        }
        pending = true;
        void lobby.host(props.game.id, config, invitees)
            .then((tableId) => props.onCreated(tableId))
            .catch((error: unknown) =>
            {
                pending = false;
                const refused = error instanceof ApiError && error.status >= 400 && error.status < 500;
                toasts.show({ kind: 'warning', text: locale.t(whyRefused(error, refused ? 'create.refused' : 'state.errorLead')) });
            });
    };

    <form
        class="flex flex-col gap-7"
        onSubmit={ (event) =>
        {
            event.preventDefault();
            submit();
        } }
    >
        <Show when={ choosable }>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('create.seats') }</legend>
                <ul class="flex flex-wrap gap-2">
                    <For each={ formats } key={ (format) => `${ format.seats }/${ format.teams }` } let={ format }>
                        <li>
                            <Chip icon={ format.teams ? 'versus' : 'people' } selected={ seats === format.seats && teams === format.teams } onClick={ () => choose(format) }>
                                <span>{ format.teams ? locale.t('create.format.teams') : locale.plural('common.players', format.seats) }</span>
                            </Chip>
                        </li>
                    </For>
                </ul>
                <Show when={ teamsHint } let={ hint }>
                    <p class="text-ui-xs text-faint">{ locale.t(hint) }</p>
                </Show>
            </fieldset>
        </Show>

        <Show when={ rules.modes.length > 1 }>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('create.pace') }</legend>
                <Segmented
                    block
                    label={ locale.t('create.pace') }
                    value={ mode }
                    items={ [
                        { id: 'live', label: locale.t('games.mode.live'), icon: 'zap' },
                        { id: 'turns', label: locale.t('games.mode.turns'), icon: 'clock' }
                    ] }
                    onChange={ (id) => mode = id as TableMode }
                />
                <p class="text-ui-xs text-faint">{ locale.t(mode === 'live' ? 'games.mode.liveHint' : 'games.mode.turnsHint') }</p>
            </fieldset>
        </Show>

        <fieldset class="flex flex-col gap-2">
            <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('create.privacy') }</legend>
            <Segmented
                block
                label={ locale.t('create.privacy') }
                value={ privacy }
                items={ [
                    { id: 'invite', label: locale.t('create.privacy.invite'), icon: 'lock' },
                    { id: 'friends', label: locale.t('create.privacy.friends'), icon: 'people' },
                    { id: 'public', label: locale.t('create.privacy.public'), icon: 'discover' }
                ] }
                onChange={ (id) => privacy = id as TablePrivacy }
            />
            <p class="text-ui-xs text-faint">{ privacyHint }</p>
        </fieldset>

        <Show when={ rules.targets.length > 0 }>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('create.target') }</legend>
                <ul class="flex flex-wrap gap-2">
                    <For each={ [...rules.targets] } key={ (value) => value } let={ value }>
                        <li>
                            <Chip icon="target" selected={ target === value } onClick={ () => target = value }>
                                <span>{ locale.plural(props.game.id === 'hokm' ? 'create.target.hands' : 'create.target.points', value) }</span>
                            </Chip>
                        </li>
                    </For>
                </ul>
            </fieldset>
        </Show>

        <Show when={ hasCube }>
            <Toggle
                checked={ cubed }
                disabled={ !cubeOffered }
                label={ locale.t('create.cube') }
                description={ locale.t(cubeOffered ? 'create.cubeHint' : 'create.cubeNone') }
                onChange={ (checked) => cube = checked }
            />
        </Show>

        <Show when={ hasBlinds }>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('create.blinds') }</legend>
                <Segmented
                    block
                    label={ locale.t('create.blinds') }
                    value={ blinds }
                    items={ [
                        { id: 'low', label: locale.t('create.blinds.low') },
                        { id: 'mid', label: locale.t('create.blinds.mid') },
                        { id: 'high', label: locale.t('create.blinds.high') }
                    ] }
                    onChange={ (id) => blinds = id as Blinds }
                />
                <p class="text-ui-xs text-faint">{ locale.t('games.stakes.playMoneyHint') }</p>
            </fieldset>
        </Show>

        <Toggle checked={ chat } label={ locale.t('create.chat') } description={ locale.t('create.chatHint') } onChange={ (checked) => chat = checked } />

        <Toggle checked={ voice !== 'off' } label={ locale.t('create.voice') } description={ locale.t('create.voiceHint') } onChange={ (checked) => voice = checked ? 'table' : 'off' } />

        <fieldset class="flex flex-col gap-3">
            <legend class="label mb-2 flex w-full items-center justify-between text-ui-sm text-muted">
                <span>{ locale.t('create.invite') }</span>
                <span class={ [ 'tally text-ui-xs font-semibold', tooMany ? 'text-danger' : 'text-accent' ].join(' ') }>{ locale.plural('create.invited', invitees.length) }</span>
            </legend>
            <p class="text-ui-xs text-faint">{ locale.t('create.inviteHint') }</p>
            <Show when={ teams }>
                <p class="text-ui-xs text-faint">{ locale.t('create.partnerHint') }</p>
            </Show>
            <SearchInput value={ query } onInput={ (value) => query = value } placeholder={ locale.t('create.search') } label={ locale.t('create.search') } />
            <Show when={ tooMany }>
                <p class="flex items-center gap-1.5 text-ui-sm font-semibold text-danger" role="alert">
                    <Icon name="alert" size={ 14 } />
                    { locale.t('create.tooMany') }
                </p>
            </Show>
            <ul class={ `flex max-h-72 flex-col gap-0.5 overflow-y-auto rounded-panel p-1.5 ${ PANEL_TONE.field }` } aria-label={ locale.t('create.invite') }>
                <For each={ friends } key={ (person) => person.id } let={ person }>
                    <li>
                        <button
                            type="button"
                            class={ [
                                'flex min-h-12 w-full cursor-pointer items-center gap-3 rounded-tile px-2 py-1.5 text-start transition-colors hover:bg-raised/70',
                                invitees.includes(person.id) ? 'bg-accent/10' : ''
                            ].filter(Boolean).join(' ') }
                            aria-pressed={ invitees.includes(person.id) }
                            onClick={ () => toggleInvite(person.id) }
                        >
                            <Avatar person={ person } size="sm" presence={ presence.dot(person.id) } />
                            <span class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-ui-base font-semibold text-text" dir="auto">{ person.displayName }</span>
                                <span class="truncate text-ui-xs text-muted" dir="ltr">@{ person.handle }</span>
                            </span>
                            <span class={ [
                                'flex h-6 w-6 items-center justify-center rounded-full border transition-colors',
                                invitees.includes(person.id) ? 'border-accent-fill bg-accent-fill text-accent-ink' : 'border-line text-transparent'
                            ].join(' ') } aria-hidden="true">
                                <Icon name="selected" size={ 14 } />
                            </span>
                        </button>
                    </li>
                </For>
                <Show when={ friends.length === 0 }>
                    <li class="px-3 py-4 text-center text-ui-sm text-faint">{ locale.t('create.noFriends') }</li>
                </Show>
            </ul>
        </fieldset>

        <Button variant="primary" size="lg" block submit leading={ invitees.length > 0 ? 'invite' : 'add' } disabled={ !valid } loading={ pending }>
            { invitees.length > 0 ? locale.t('create.submitInvite') : locale.t('create.submit') }
        </Button>
    </form>
}
