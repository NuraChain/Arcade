import { untrack } from 'azerothjs';

import CardFace from './card-face.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import TableResult from './table-result.component.azeroth';
import HokmSeat, { SIDE_TONE } from './hokm-seat.component.azeroth';
import type { SeatMark } from './hokm-mark.component.azeroth';
import { plateTag } from './plate-tag.ts';
import IconButton from '../ui/icon-button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { FACE_KEY, SUITS, SUIT_ICON, arrangeHand, rankOf, suitOf, type Suit } from '../../data/cards.ts';
import { aroundTable, type Chair } from './table-seats.ts';
import { hokmOf } from '../../data/match.ts';
import { coachOf, outcomeOf } from '../../game/helpers/hokm.ts';
import { BANNER_IN, BANNER_OUT, CARRY, COLLECT_GAP, NAMING, PLUS, SHUFFLE, TURN, TURN_GAP, dealGap, dealtIn, gatherOrder, holdBefore, openingPackets, restPackets, spanOf, type Packet } from '../../game/hokm-beats.ts';
import { EMPTY, HISTORY, before, feltOf, sameAs, step, unplay, type Felt, type Laid, type Told } from '../../game/hokm-felt.ts';
import { EASE, TIMING, centreOf, flightFrames, outside, rectIn, type Rect } from '../../game/motion.ts';
import { createSound, type SoundHandle } from '../../game/sound.ts';
import { anchor, cardAt, cardNode, drawn, stackNode, turnNode } from '../../game/stage/cards.ts';
import { hashOf } from '../../game/stage/curves.ts';
import type { Ctx } from '../../game/stage/director.ts';
import type { Act } from '../../game/stage/feed.ts';
import { launch, turn } from '../../game/stage/flight.ts';
import { createPresenter, type Presenter, type Sight, type Table } from '../../game/stage/presenter.ts';
import { createStage, type Stage } from '../../game/stage/stage.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { useBoard, type EventBatch } from '../../stores/match.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';
import type { Rematch } from './boards.ts';

type Side = 'bottom' | 'top' | 'left' | 'right' | 'top-left' | 'top-right';

const FOUR: readonly Side[] = ['bottom', 'right', 'top', 'left'];

const REACH: Record<Side, readonly [number, number]> = {
    'bottom': [0, 1],
    'top': [0, -1],
    'left': [-1, 0],
    'right': [1, 0],
    'top-left': [-0.8, -0.6],
    'top-right': [0.8, -0.6]
};

const RED_SUITS: readonly Suit[] = ['hearts', 'diamonds'];

const ROW_LIMIT = 13;

const TWO_ROWS_FROM = 480;

const CARD_MIN = 38.4;

const CARD_FLOOR = 56;

const CARD_MAX = 84;

const SHOWS = 22.5;

const FAN_TILT = 6;

const FAN_PIVOT = 0.9;

const FAN_MS = 320;

const BACKS_SHOWN = 10;

const BACK_W = 30;

const DEALT_CAP = 2000;

const REST_CAP = 2500;

const HURRY_MS = 8000;

const SIGN_IN: Keyframe[] = [{ opacity: 0, scale: '0.8' }, { opacity: 1, scale: '1' }];

const KOT_IN: Keyframe[] = [{ opacity: 0, scale: '1.6', rotate: '-8deg' }, { opacity: 1, scale: '1', rotate: '0deg' }];

const SIGN_OUT: Keyframe[] = [{ opacity: 1 }, { opacity: 0 }];

const STRUCK: Keyframe[] = [{ scale: '1.2' }, { scale: '1' }];

const STRUCK_MS = 220;

const PLUS_GAP = 14;

const PLUS_DRIFT = 22;

const tiltOf = (card: number) => ((card * 37) % 11) - 5;

const suitNamed = (said: string | null) => SUITS.find((suit) => suit === said) ?? null;

const markOf = (seat: number, hakem: number, dealer: number): SeatMark => (seat === hakem ? 'hakem' : (seat === dealer ? 'dealer' : null));

const noPlate = (seat: number) => ({ row: { seat, side: 0, held: 0, tricks: 0, out: false }, side: 'top' as Side, mark: null, backs: 0 });

export default component HokmBoard(props: { match: MatchView; events: EventBatch; starting?: boolean; onAgain?: () => void; rematch?: Rematch; speech?: Record<string, string>; turnMs?: number; onPresenting?: (busy: boolean) => void })
{
    const locale = useLocale();
    const board = useBoard();
    const device = useDevice();
    const people = usePeople();
    const settings = useSettings();

    state sorted = false;

    state picked: number | null = null;

    state shown: Felt | null = null;

    state lying: { cards: readonly Laid[]; took: number } | null = null;

    state landing: readonly number[] = [];

    state banner: { points: number; kot: boolean; ours: boolean } | null = null;

    state sent: { id: string; card: number; rev: number; gone: boolean } | null = null;

    state lifted: { card: number; at: number; keyed: boolean } | null = null;

    state sliding = false;

    state kept: number | null = null;

    state seen: { round: number; cards: ReadonlySet<number> } = untrack(() => ({ round: hokmOf(props.match)?.round ?? 0, cards: new Set(hokmOf(props.match)?.hand ?? []) }));

    state dealing: { counts: readonly number[]; won: readonly number[] | null; deck: number | null; stock: number | null } | null = null;

    state stale: readonly number[] = untrack(() => hokmOf(props.match)?.hand ?? []);

    state carried: { hakem: boolean; dealer: boolean } = { hakem: false, dealer: false };

    state ghost = false;

    state token: { suit: Suit; pledged: boolean } | null = null;

    state presenting = false;

    state result = untrack(() => props.match.finishedAt !== undefined);

    state away: readonly number[] = [];

    derived game = props.match;

    derived view = hokmOf(game);

    derived over = game.finishedAt !== undefined;

    derived sending = sent !== null && sent.id === game.id && sent.rev === game.rev ? sent : null;

    derived mine = game.mine;

    derived current = view !== null && view.round === seen.round;

    derived unseen = new Set((view?.hand ?? []).filter((card) => !current || !seen.cards.has(card)));

    derived veiled = unseen.size > 0;

    derived capped = veiled && current;

    derived whoAt = (seat: number) => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number) =>
    {
        const who = whoAt(seat);

        if (who === '')
        {
            return '';
        }

        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (view.phase === 'trump')
        {
            return view.hakem === mine
                ? (veiled ? '' : locale.t('hokm.trump.yours'))
                : locale.t('hokm.trump.theirs', { name: nameOf(view.hakem) });
        }

        if (view.phase === 'discard')
        {
            return view.turn === mine
                ? locale.t('hokm.discard.yours', { count: locale.n(view.discard ?? 0) })
                : locale.t('hokm.discard.theirs', { name: nameOf(view.turn) });
        }

        if (view.phase === 'draw')
        {
            return view.turn === mine
                ? locale.t('hokm.draw.yours')
                : locale.t('hokm.draw.theirs', { name: nameOf(view.turn) });
        }

        return view.turn === mine
            ? locale.t('match.turn.yours')
            : locale.t('match.turn.theirs', { name: nameOf(view.turn) });
    })();

    derived needed = view?.needed;

    derived chairs = aroundTable(game.seats, mine ?? null);

    const sideOf = (chair: Chair): Side =>
    {
        if (chair.place === 0)
        {
            return 'bottom';
        }

        if (game.seats === 2)
        {
            return 'top';
        }

        if (game.seats === 3)
        {
            return chair.place === 1 ? 'top-right' : 'top-left';
        }

        return FOUR[chair.place] ?? 'top';
    };

    derived felt = shown ?? (view === null ? EMPTY : feltOf(view, game.seats));

    derived plates = felt.chairs.map((row) =>
    {
        const chair = chairs[row.seat];
        const held = dealing?.counts[row.seat] ?? row.held;
        const tricks = dealing?.won?.[row.seat] ?? row.tricks;
        const mark = markOf(row.seat, felt.hakem, felt.dealer);

        return {
            row: { ...row, held, tricks },
            side: sideOf(chair),
            mark: mark !== null && carried[mark] ? null : mark,
            backs: row.seat === mine ? 0 : Math.min(held, BACKS_SHOWN)
        };
    });

    derived seated = plates.map((plate) => plate.row.seat);

    derived plateAt = (seat: number) => plates.find((plate) => plate.row.seat === seat) ?? noPlate(seat);

    derived deckAt = dealing !== null ? dealing.deck : (felt.phase === 'trump' && felt.seats > 2 && felt.round > 0 ? felt.dealer : null);

    derived decked = deckAt !== null;

    derived deckReach = REACH[plateAt(deckAt ?? 0).side];

    derived teamed = view !== null && new Set(view.seats.map((row) => row.side)).size < view.seats.length;

    derived home = view?.seats.find((row) => row.seat === mine)?.side;

    const teamOf = (row: { seat: number; side: number }) =>
    {
        if (!teamed)
        {
            return undefined;
        }

        if (row.seat === mine)
        {
            return { side: row.side };
        }

        return {
            side: row.side,
            says: home === undefined
                ? locale.t('team.n', { n: locale.n(row.side + 1) })
                : locale.t(row.side === home ? 'card.partner' : 'card.opponent')
        };
    };

    derived laid = {
        cards: (lying ?? felt).cards.map((one: Laid) => ({ ...one, side: sideOf(chairs[one.seat]) })),
        took: lying?.took ?? null
    };

    derived turnAt = result ? null : (lying?.took ?? laid.cards.find((one) => landing.includes(one.card))?.seat ?? felt.turn);

    derived legal = new Set(view === null || over ? [] : view.plays);

    derived myTurn = view !== null && !over && view.phase === 'tricks' && view.turn === mine;

    derived owed = view !== null && !over && mine !== undefined && (view.phase === 'trump' ? view.hakem === mine : view.turn === mine);

    derived acting = owed && !(view !== null && view.phase === 'trump' && veiled);

    derived spare = veiled && owed ? game.remainingMs : undefined;

    derived chosen = picked !== null && myTurn && legal.has(picked) ? picked : null;

    derived choosing = view !== null && !over && view.phase === 'trump' && view.hakem === mine && !veiled && token === null;

    derived due = view !== null && !over && view.phase === 'discard' && view.turn === mine ? (view.discard ?? 0) : 0;

    derived discarding = due > 0;

    derived picks = discarding && view !== null ? away.filter((card) => view!.hand.includes(card)) : [];

    derived offered = view !== null && !over && view.phase === 'draw' && view.turn === mine && view.offer !== undefined ? { card: view.offer } : null;

    derived drawing = offered !== null;

    derived glimpsed = view !== null && !over && view.glimpse !== undefined ? { card: view.glimpse } : null;

    derived putting = discarding && picks.length === due;

    derived stocked = felt.stock !== null;

    derived dealt = view !== null;

    derived trump = suitNamed(felt.trump);

    derived last = felt.took;

    derived stockLive = putting || drawing;

    derived piled = stocked || (dealing !== null && felt.seats === 2);

    derived stockLeft = dealing?.stock ?? felt.stock;

    derived counted = stockLeft !== null;

    derived stockBacks = [0, 1, 2].slice(0, Math.min(3, stockLeft ?? (piled ? 3 : 0)));

    derived tagOf = (seat: number) =>
    {
        const player = game.players.find((one) => one.seat === seat);

        if (player === undefined || !over || result)
        {
            return plateTag(locale, player, over);
        }

        const { result: _unshown, ...playing } = player;

        return plateTag(locale, playing, over);
    };

    derived hints = settings.settings();

    derived outcomeFor = (card: number) =>
    {
        const says = hints.hintOutcome && myTurn && legal.has(card) && view !== null ? outcomeOf(card, view, game.seats) : null;

        return says === null ? null : locale.t(says.key);
    };

    derived tip = view === null || over || (veiled && view.phase === 'trump') ? null : coachOf(view, mine, game.seats);

    derived following = myTurn && legal.size < (view?.hand.length ?? 0) && !(hints.hintRules && tip !== null);

    derived sortable = (view?.hand.length ?? 0) > 1 && !veiled;

    derived holds = view === null ? [] : (sorted ? arrangeHand(view.hand, view.trump) : [...view.hand])
        .filter((card) => !(sending !== null && sending.gone && card === sending.card));

    derived fresh = lifted === null || holds.includes(lifted.card)
        ? holds
        : [...holds.slice(0, lifted.at), lifted.card, ...holds.slice(lifted.at)];

    derived hand = current ? fresh : stale;

    derived handed = view !== null && !result && (hand.length > 0 || mine !== undefined);

    derived footed = view !== null && !result;

    state room = { width: 0, height: 0 };

    derived rowed = (cards: readonly number[]): number[][] =>
    {
        if (cards.length === 0)
        {
            return [];
        }

        const least = Math.max(CARD_MIN, Math.min(CARD_FLOOR, room.height * 0.12));
        const card = Math.min(CARD_MAX, Math.max(least, Math.min(room.width * 0.125, room.height * 0.1)));
        const shows = (room.width - card) / Math.max(1, cards.length - 1);

        return cards.length <= ROW_LIMIT || room.height < TWO_ROWS_FROM || shows >= SHOWS
            ? [[...cards]]
            : [cards.slice(0, Math.ceil(cards.length / 2)), cards.slice(Math.ceil(cards.length / 2))];
    };

    derived rows = rowed(hand);

    derived roomy = Math.max(1, rows.length, felt.phase === 'trump' ? rowed(Array.from({ length: felt.full }, (_, nth) => nth)).length : 0);

    derived stop = kept !== null && hand.includes(kept) ? kept : (hand.find((card) => legal.has(card)) ?? hand[0] ?? null);

    derived handTricks = felt.points.map((_, side) =>
        felt.chairs.filter((row) => row.side === side).reduce((sum, row) => sum + row.tricks, 0));

    derived sides = felt.points.map((points, index) => ({
        index,
        points,
        tricks: handTricks[index] ?? 0,
        names: locale.list(felt.chairs.filter((row) => row.side === index).map((row) => nameOf(row.seat)))
    }));

    const fan = (index: number, count: number) =>
    {
        const middle = (count - 1) / 2;
        const tilt = middle === 0 ? 0 : (index - middle) / middle;

        return `--i: ${ index }; --n: ${ count }; --t: ${ tilt.toFixed(3) }`;
    };

    const rankSays = (card: number) =>
    {
        const rank = rankOf(card);

        return FACE_KEY[rank] === undefined ? locale.n(Number(rank)) : locale.t(FACE_KEY[rank]);
    };

    const cardSays = (card: number) =>
        locale.t('hokm.card', { rank: rankSays(card), suit: locale.t(`hokm.suit.${ suitOf(card) }` as never) });

    const cardLabel = (card: number) =>
    {
        const play = locale.t('hokm.play', { card: cardSays(card) });
        const says = outcomeFor(card);

        return says === null ? play : `${ play }. ${ says }`;
    };

    const playCard = async (card: number, keyed: boolean) =>
    {
        if (!legal.has(card))
        {
            return;
        }

        const face = find(`.card-hold[data-card="${ card }"] .card-face`);
        const seat = untrack(() => mine);
        const { id, rev } = untrack(() => game);

        if (layer !== null && face !== null)
        {
            origins.set(card, rectIn(layer, face));
        }

        picked = null;
        haptic('select');

        if (seat !== undefined && presenter !== null)
        {
            let gone = false;

            lifted = { card, at: hand.indexOf(card), keyed };
            sent = { id, card, rev, gone };
            presenter.predict({ rev, covers: (moves) => (gone ? (moves[0]?.e === 'card' && moves[0].card === card ? 1 : null) : 0) });
            presenter.act((ctx) =>
            {
                if (sending === null || sending.card !== card)
                {
                    return;
                }

                const own = originOf(card);

                gone = true;
                sent = { id, card, rev, gone };

                return lay(ctx.stage, seat, card, own);
            }, TIMING.FLY);
        }

        const outcome = await board.play({ kind: 'hokm', verb: 'card', card });

        if (outcome === 'stale' || outcome === 'failed')
        {
            refuse(id, card, rev);
        }
    };

    const touchCard = (card: number, keyed: boolean) =>
    {
        if (!legal.has(card) || board.busy())
        {
            return;
        }

        if (!device.coarse() || chosen === card)
        {
            void playCard(card, keyed);
            return;
        }

        picked = card;
        haptic('tick');
    };

    const struck = (stage: Stage) =>
    {
        sound?.play('trump');
        sound?.play('card-place', { gain: 0.6 });

        for (const one of [find('.hokm-medal'), find('.hokm-token')])
        {
            if (one !== null)
            {
                stage.animate(one, STRUCK, { duration: STRUCK_MS, easing: EASE.pop, quiet: 'skip' });
            }
        }
    };

    const name = (from: Rect | null, stage: Stage) =>
    {
        const disc = find('.hokm-token');
        const to = spotOf(disc);

        if (disc === null || from === null || to === null)
        {
            struck(stage);

            return Promise.resolve();
        }

        return stage.animate(disc, flightFrames(from, to), { duration: NAMING, easing: EASE.fly, landed: () => struck(stage) }).done;
    };

    const unname = () =>
    {
        if (token === null || !token.pledged)
        {
            return;
        }

        presenter?.predict(null);
        token = null;
        sound?.play('deny');
        haptic('deny');
    };

    const callTrump = async (suit: Suit, event: MouseEvent) =>
    {
        const rev = untrack(() => game.rev);
        const from = spotOf(find(`.hokm-choose-suit[data-suit="${ suit }"]`));
        const keyed = event.detail === 0;
        const next = stop;

        haptic('select');

        if (presenter !== null && rig !== null)
        {
            token = { suit, pledged: true };
            presenter.predict({ rev, covers: (moves) => (moves[0]?.e === 'trump' ? 0 : null) });
            named = name(from, rig);

            if (keyed && next !== null)
            {
                stand(next);
            }
        }

        const outcome = await board.play({ kind: 'hokm', verb: 'trump', suit });

        if (outcome === 'stale' || outcome === 'failed')
        {
            unname();
        }
    };

    const toggleAway = (card: number) =>
    {
        if (!discarding || board.busy())
        {
            return;
        }

        if (!picks.includes(card) && picks.length >= due)
        {
            sound?.play('deny');
            haptic('deny');
            return;
        }

        away = picks.includes(card) ? picks.filter((one) => one !== card) : [...picks, card];
        haptic('tick');
    };

    const putDown = async () =>
    {
        if (picks.length !== due)
        {
            return;
        }

        const cards = [...picks].sort((a, b) => a - b);

        away = [];
        haptic('select');
        await board.play({ kind: 'hokm', verb: 'discard', cards });
    };

    const draw = async (verb: 'keep' | 'reject') =>
    {
        haptic('select');
        await board.play({ kind: 'hokm', verb });
    };

    const pressStock = () =>
    {
        void (drawing ? draw('reject') : putDown());
    };

    let arena: HTMLElement | null = null;
    let layer: HTMLElement | null = null;
    let sound: SoundHandle | null = null;
    let presenter: Presenter<Told> | null = null;
    let rig: Stage | null = null;
    let steady: () => void = () => undefined;
    let held: Felt = EMPTY;
    let wasActing = untrack(() => acting);
    let chimedDraw = -1;
    const origins = new Map<number, Rect>();

    const viewFelt = () => (view === null ? EMPTY : feltOf(view, game.seats));

    const sightNow = (): Sight<Felt> | null =>
    {
        if (view === null)
        {
            return null;
        }

        const now = feltOf(view, game.seats);

        return {
            id: game.id,
            rev: game.rev,
            seat: mine ?? null,
            view: sending !== null && sending.gone && mine !== undefined ? step(now, { e: 'card', seat: mine, card: sending.card }) : now
        };
    };

    const find = (selector: string) => arena?.querySelector<HTMLElement>(selector) ?? null;

    const panOf = (rect: Rect | null) =>
    {
        const width = layer?.clientWidth ?? 0;

        return rect === null || width === 0 ? 0 : Math.max(-0.5, Math.min(0.5, centreOf(rect).x / width - 0.5));
    };

    const plateOf = (seat: number) => find(`.hokm-seat[data-seat="${ seat }"] .table-plate`);

    const seatRect = (seat: number) =>
        (layer === null ? null : anchor(layer, [find(`.hokm-seat[data-seat="${ seat }"] .hokm-pile`), plateOf(seat)]));

    const handOr = (seat: number) =>
    {
        const own = seat === mine ? find('.hokm-hand') : null;

        return own !== null && layer !== null ? rectIn(layer, own) : seatRect(seat);
    };

    const sideAt = (seat: number) => held.chairs.find((chair) => chair.seat === seat)?.side ?? seat % 2;

    const heldAt = (felt: Felt) => Array.from({ length: felt.seats }, (_, seat) => felt.chairs.find((chair) => chair.seat === seat)?.held ?? 0);

    const wonAt = (felt: Felt) => Array.from({ length: felt.seats }, (_, seat) => felt.chairs.find((chair) => chair.seat === seat)?.tricks ?? 0);

    const withMe = (side: number | undefined) => mine !== undefined && side !== undefined && sideAt(mine) === side;

    const originOf = (card: number) =>
    {
        const face = find(`.card-hold[data-card="${ card }"] .card-face`);
        const from = face === null || layer === null ? origins.get(card) : rectIn(layer, face);

        origins.delete(card);

        return from ?? null;
    };

    const places = () => new Map([...(arena?.querySelectorAll<HTMLElement>('.hokm-hand > li') ?? [])].map((slot) =>
    {
        const box = slot.getBoundingClientRect();
        const tilt = Number(slot.style.getPropertyValue('--t'));
        const swung = Math.sin(tilt * FAN_TILT * Math.PI / 180) * FAN_PIVOT * slot.offsetHeight;

        return [slot.querySelector<HTMLElement>('.card-hold')?.dataset.card ?? '', { slot, tilt, x: box.left + box.width / 2 - swung, y: box.top + box.height / 2 }] as const;
    }));

    const follow = (before: ReturnType<typeof places>) =>
    {
        for (const [card, now] of places())
        {
            const was = before.get(card);
            const dx = (was?.x ?? now.x) - now.x;
            const dy = (was?.y ?? now.y) - now.y;

            if (rig === null || was === undefined || (Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5))
            {
                continue;
            }

            rig.animate(now.slot, [
                { translate: `${ dx }px ${ dy }px`, rotate: `${ (was.tilt - now.tilt) * FAN_TILT }deg`, composite: 'add' },
                { translate: '0px 0px', rotate: '0deg', composite: 'add' }
            ], { duration: FAN_MS, easing: EASE.snap, quiet: 'skip' });
        }
    };

    const rearrange = (change: () => void) =>
    {
        const before = places();

        steady();
        sliding = true;
        steady = runtime().clock.after(FAN_MS, () => sliding = false);
        change();
        follow(before);
    };

    const resort = () => rearrange(() => sorted = !sorted);

    const stand = (card: number) => find(`.card-hold[data-card="${ card }"]`)?.focus({ preventScroll: true });

    const walk = (event: KeyboardEvent, card: number) =>
    {
        const flat = rows.flat();
        const at = flat.indexOf(card);
        const row = rows.findIndex((one) => one.includes(card));
        const across = rows[row]?.indexOf(card) ?? 0;
        const facing = (line: number[] | undefined) => (line === undefined ? undefined : line[Math.min(across, line.length - 1)]);
        const to = new Map([
            ['ArrowRight', flat[(at + 1) % flat.length]],
            ['ArrowLeft', flat[(at - 1 + flat.length) % flat.length]],
            ['ArrowDown', facing(rows[row + 1])],
            ['ArrowUp', facing(rows[row - 1])],
            ['Home', flat[0]],
            ['End', flat[flat.length - 1]]
        ]).get(event.key);

        if (to === undefined || event.altKey || event.ctrlKey || event.metaKey)
        {
            return;
        }

        event.preventDefault();
        stand(to);
    };

    const backSpot = (seat: number) =>
    {
        const top = find(`.hokm-seat[data-seat="${ seat }"] .hokm-pile > .card-back:last-child`);
        const around = seatRect(seat);

        return layer !== null && drawn(top) ? rectIn(layer, top) : (around === null ? null : cardAt(around, BACK_W));
    };

    const lay = (stage: Stage, seat: number, card: number, own: Rect | null) =>
    {
        const back = seat === mine || stage.quiet() ? null : backSpot(seat);

        if (seat === mine)
        {
            stale = stale.filter((one) => one !== card);
        }

        if (seat === mine && lifted !== null && lifted.card === card)
        {
            const free = () => lifted = null;
            const flat = rows.flat();
            const next = flat[flat.indexOf(card) + 1] ?? flat[flat.indexOf(card) - 1];
            const here = find(`.card-hold[data-card="${ card }"]`);
            const stood = lifted.keyed && here !== null && document.activeElement === here;

            if (rowed(hand.filter((one) => one !== card)).length === rows.length)
            {
                free();
            }
            else
            {
                rearrange(free);
            }

            if (next !== undefined && stood)
            {
                stand(next);
            }
        }

        held = step(held, { e: 'card', seat, card });
        landing = [...landing, card];
        shown = held;

        const target = find(`.hokm-trick[data-card="${ card }"]`);

        if (layer === null || target === null)
        {
            landing = landing.filter((one) => one !== card);

            return Promise.resolve();
        }

        const to = rectIn(layer, target);
        const from = own ?? back ?? cardAt(seatRect(seat) ?? to, to.width * 0.6);
        const landed = () =>
        {
            landing = landing.filter((one) => one !== card);
            sound?.play('card-place', { gain: 0.9 });
        };

        sound?.play('card-slide', { pan: panOf(from) });

        return back === null
            ? launch(stage, layer, cardNode(card, to.width), from, to, {
                duration: seat === mine ? TIMING.FLY : TIMING.FLY_THEIRS,
                easing: EASE.fly,
                toRotate: tiltOf(card),
                fromOpacity: own === null ? 0 : 1,
                landed
            }).done
            : turn(stage, layer, turnNode(card, to.width), back, to, { duration: TIMING.FLY_THEIRS, easing: EASE.fly, flip: EASE.flip, toRotate: tiltOf(card), landed }).done;
    };

    const tally = (stage: Stage, seat: number) =>
    {
        const place = find(`.hokm-seat[data-seat="${ seat }"]`);
        const cloth = find('.hokm-table');

        if (layer === null || place === null || cloth === null || stage.quiet())
        {
            return;
        }

        const spot = outside(rectIn(layer, place), centreOf(rectIn(layer, cloth)), PLUS_GAP);
        const drifted = (by: number) => `calc(-50% + ${ spot.dx * by }px) calc(-50% + ${ spot.dy * by }px)`;
        const plus = document.createElement('span');

        plus.className = 'hokm-plus tally';
        plus.dir = 'ltr';
        plus.textContent = `+${ locale.n(1) }`;
        plus.style.left = `${ spot.x }px`;
        plus.style.top = `${ spot.y }px`;
        layer.append(plus);
        stage.animate(plus, [
            { opacity: 0, translate: drifted(-PLUS_DRIFT / 2), offset: 0 },
            { opacity: 1, translate: drifted(0), offset: 0.2 },
            { opacity: 1, translate: drifted(PLUS_DRIFT / 2), offset: 0.7 },
            { opacity: 0, translate: drifted(PLUS_DRIFT), offset: 1 }
        ], { duration: PLUS, easing: 'ease-out', fill: 'both', landed: () => plus.remove() });
    };

    const take = async (seat: number, next: Told | undefined, ctx: Ctx) =>
    {
        const cards = gatherOrder(held.cards, seat);

        lying = { cards: held.cards, took: seat };

        if (withMe(sideAt(seat)))
        {
            sound?.play('trick');
            haptic('select');
        }

        await (next === undefined ? ctx.linger(TIMING.HOLD, TIMING.HOLD_MIN) : ctx.stage.wait(holdBefore(next)));

        const plate = plateOf(seat);
        const to = plate === null || layer === null ? null : rectIn(layer, plate);
        const from = cards.map((one) =>
        {
            const real = find(`.hokm-trick[data-card="${ one.card }"]`);

            return real === null || layer === null ? null : rectIn(layer, real);
        });

        sound?.play('card-gather', { pan: panOf(to) });
        lying = { cards: [], took: seat };

        await Promise.all(cards.map((one, nth) =>
        {
            const start = from[nth];

            return layer === null || to === null || start === null
                ? Promise.resolve()
                : launch(ctx.stage, layer, cardNode(one.card, start.width), start, cardAt(to, start.width), {
                    duration: TIMING.GATHER,
                    easing: EASE.gather,
                    delay: nth * TIMING.GATHER_GAP,
                    fromRotate: tiltOf(one.card),
                    toScale: 0.45,
                    toOpacity: 0,
                    fadeFrom: 0.6,
                    quiet: 'skip'
                }).done;
        }));

        if (!ctx.live())
        {
            return;
        }

        held = step(held, { e: 'trick', seat });
        shown = held;
        lying = null;
        tally(ctx.stage, seat);
    };

    const call = async (move: Told, ctx: Ctx) =>
    {
        const ours = withMe(move.side);
        const kot = move.kot === true;

        held = step(held, move);
        shown = held;
        banner = { points: move.points ?? 0, kot, ours };

        if (kot)
        {
            sound?.play('win');
        }
        else if (ours)
        {
            sound?.play('hand-won');
        }

        if (ours)
        {
            haptic(kot ? 'kot' : 'hand');
        }

        const sign = find('.hokm-banner');

        if (sign !== null)
        {
            ctx.stage.animate(sign, kot ? KOT_IN : SIGN_IN, { duration: BANNER_IN, easing: EASE.pop });
        }

        await ctx.stage.wait(TIMING.BANNER - BANNER_OUT);

        if (sign !== null)
        {
            ctx.stage.animate(sign, SIGN_OUT, { duration: BANNER_OUT, easing: 'ease-in', fill: 'forwards', quiet: 'out' });
        }

        await ctx.stage.wait(BANNER_OUT);
        banner = null;
    };

    const slide = (stage: Stage, from: Rect | null, around: Rect | null, rate: number) =>
    {
        const to = around === null ? null : cardAt(around, BACK_W);

        sound?.play('card-slide', { pan: panOf(to), rate });

        return layer === null || from === null || to === null
            ? Promise.resolve()
            : launch(stage, layer, cardNode(null, BACK_W), from, to, { duration: TIMING.DEAL_FLY, easing: EASE.fly, toOpacity: 0, fadeFrom: 0.8, quiet: 'skip' }).done;
    };

    const show = (cards: readonly number[]) =>
    {
        if (current)
        {
            seen = { round: seen.round, cards: new Set([...seen.cards, ...cards]) };
        }
    };

    const deckSpot = () =>
    {
        const top = find('.hokm-deck > .card-back:last-child') ?? find('.hokm-stock-pile > .card-back:last-child');
        const dealer = seatRect(held.dealer);

        return top !== null && layer !== null ? rectIn(layer, top) : (dealer === null ? null : cardAt(dealer, BACK_W));
    };

    const handSpot = () =>
    {
        const row = find('.hokm-hands');
        const face = find('.hokm-hand .card-face');

        return row === null || layer === null ? null : cardAt(rectIn(layer, row), face?.offsetWidth || BACK_W);
    };

    const open = (stage: Stage, cards: readonly number[], from: Rect | null) => Promise.all([...cards]
        .sort((one, other) => hand.indexOf(one) - hand.indexOf(other))
        .map((card, nth) =>
        {
            const face = find(`.card-hold[data-card="${ card }"] .card-face`);
            const to = face === null || layer === null ? null : rectIn(layer, face);

            if (layer === null || from === null || to === null)
            {
                show([card]);

                return Promise.resolve();
            }

            return turn(stage, layer, turnNode(card, to.width), from, to, { duration: TURN, delay: nth * TURN_GAP, easing: EASE.snap, landed: () => show([card]) }).done;
        }));

    const send = (stage: Stage, packet: Packet, cards: readonly number[] | null, rate: number) =>
    {
        const from = deckSpot();
        const pile = seatRect(packet.seat);
        const to = cards === null ? (pile === null ? null : cardAt(pile, BACK_W)) : handSpot();
        let opened: Promise<unknown> = Promise.resolve();
        const landed = () =>
        {
            if (dealing !== null)
            {
                dealing = { ...dealing, counts: dealing.counts.map((count, seat) => (seat === packet.seat ? count + packet.count : count)) };
            }

            if (cards !== null)
            {
                opened = open(stage, cards, to);
            }
        };

        if (dealing !== null && dealing.stock !== null)
        {
            dealing = { ...dealing, stock: dealing.stock - packet.count };
        }

        sound?.play('card-slide', { pan: panOf(to), rate });

        if (layer === null || from === null || to === null)
        {
            landed();

            return opened;
        }

        return launch(stage, layer, stackNode(packet.count, to.width), from, to, {
            duration: TIMING.DEAL_FLY,
            easing: EASE.fly,
            toOpacity: cards === null ? 0 : 1,
            fadeFrom: cards === null ? 0.8 : undefined,
            quiet: 'skip',
            landed
        }).done.then(() => opened);
    };

    const markOn = (seat: number) => find(`.hokm-seat[data-seat="${ seat }"] .table-plate-marker`);

    const spotOf = (place: Element | null) => (place === null || layer === null ? null : rectIn(layer, place));

    const fold = (stage: Stage, cards: readonly number[], to: Rect) =>
    {
        const faces = cards.map((card) =>
        {
            const face = find(`.card-hold[data-card="${ card }"] .card-face`);

            return { card, at: face === null || layer === null ? null : cardAt(rectIn(layer, face), face.offsetWidth || BACK_W) };
        });

        return Promise.all(faces.map((one) => (layer === null || one.at === null
            ? Promise.resolve()
            : turn(stage, layer, turnNode(one.card, to.width), one.at, to, { duration: TURN, easing: EASE.snap, down: true }).done)));
    };

    const collect = async (had: readonly number[], won: readonly number[], ctx: Ctx) =>
    {
        const flown: Promise<void>[] = [];
        const to = deckSpot();
        const left = had.map((count, seat) => ({ seat, count: count + won[seat] * had.length }))
            .filter((one) => one.count > 0)
            .sort((one, other) => Number(other.seat === mine) - Number(one.seat === mine));

        const leave = async (one: { seat: number; count: number }) =>
        {
            const fanned = one.seat === mine && !current && stale.length > 0;
            const pile = seatRect(one.seat);
            const from = fanned ? handSpot() : (pile === null ? null : cardAt(pile, BACK_W));
            const closed = fanned && from !== null ? fold(ctx.stage, stale, from) : null;

            if (dealing !== null)
            {
                dealing = {
                    ...dealing,
                    counts: dealing.counts.map((count, seat) => (seat === one.seat ? 0 : count)),
                    won: dealing.won === null ? null : dealing.won.map((count, seat) => (seat === one.seat ? 0 : count))
                };
            }

            if (fanned)
            {
                stale = [];
            }

            if (closed !== null)
            {
                await closed;
            }

            if (!ctx.live() || layer === null || from === null || to === null)
            {
                return;
            }

            await launch(ctx.stage, layer, stackNode(one.count, to.width), from, to, {
                duration: TIMING.DEAL_FLY,
                easing: EASE.gather,
                quiet: 'skip',
                landed: () =>
                {
                    ghost = false;
                }
            }).done;
        };

        if (left.length === 0)
        {
            return;
        }

        sound?.play('card-gather');

        for (const [nth, one] of left.entries())
        {
            if (!ctx.live())
            {
                return;
            }

            flown.push(leave(one));

            if (nth < left.length - 1)
            {
                await ctx.stage.wait(COLLECT_GAP);
            }
        }

        await Promise.all(flown);
    };

    const carry = (mark: 'hakem' | 'dealer', from: Rect | null, stage: Stage) =>
    {
        const seat = mark === 'hakem' ? held.hakem : held.dealer;
        const drawn = markOn(seat)?.firstElementChild?.cloneNode(true);
        const to = spotOf(markOn(seat));
        const clone = document.createElement('div');

        if (stage.quiet() || layer === null || from === null || to === null || !(drawn instanceof Element))
        {
            return Promise.resolve();
        }

        clone.append(drawn);
        carried = { ...carried, [mark]: true };

        return launch(stage, layer, clone, from, to, {
            duration: CARRY,
            easing: EASE.fly,
            landed: () =>
            {
                carried = { ...carried, [mark]: false };
            }
        }).done;
    };

    const pass = async (from: { hakem: number; dealer: number; crown: Rect | null; hand: Rect | null; deck: Rect | null }, stage: Stage) =>
    {
        const deck = find('.hokm-deck');
        const to = spotOf(deck);
        const moved: Promise<void>[] = [];

        if (from.dealer !== held.dealer && deck !== null && from.deck !== null && to !== null)
        {
            moved.push(stage.animate(deck, [
                { translate: `${ centreOf(from.deck).x - centreOf(to).x }px ${ centreOf(from.deck).y - centreOf(to).y }px`, composite: 'add' },
                { translate: '0px 0px', composite: 'add' }
            ], { duration: CARRY, easing: EASE.fly }).done);
        }

        if (from.dealer !== held.dealer)
        {
            moved.push(carry('dealer', from.hand, stage));
        }

        if (from.hakem !== held.hakem)
        {
            moved.push(carry('hakem', from.crown, stage));
        }

        await Promise.all(moved);
    };

    const dealOut = async (packets: readonly Packet[], shuffled: boolean, ctx: Ctx) =>
    {
        const gap = dealGap(packets.length);
        const flown: Promise<unknown>[] = [];
        const own = dealtIn([...unseen], packets.filter((one) => one.seat === mine).map((one) => one.count), hashOf(game.id, held.round, shuffled ? 'deal' : 'rest'));

        if (shuffled)
        {
            sound?.play('card-shuffle', { gain: 0.7 });
            await ctx.stage.wait(SHUFFLE);
        }

        for (const [nth, packet] of packets.entries())
        {
            if (!ctx.live())
            {
                return;
            }

            flown.push(send(ctx.stage, packet, packet.seat === mine ? (own.shift() ?? []) : null, 0.97 + (nth % 3) * 0.04));

            if (nth < packets.length - 1)
            {
                await ctx.stage.wait(gap);
            }
            else if (dealing !== null && held.phase !== 'trump')
            {
                dealing = { ...dealing, deck: null };
            }
        }

        await Promise.all(flown);
    };

    const drawOne = (stage: Stage, seat: number) =>
    {
        const stock = find('.hokm-stock-pile');

        return slide(stage, stock === null || layer === null ? null : cardAt(rectIn(layer, stock), BACK_W), handOr(seat), 1).then(() =>
        {
            if (seat === mine)
            {
                show([...unseen]);
            }
        });
    };

    const play = async (acts: readonly Act<Told>[], ctx: Ctx) =>
    {
        const moves = acts.flatMap((act) => act.moves);
        let flying: Promise<void>[] = [];

        const down = () =>
        {
            const landed = Promise.all(flying);

            flying = [];

            return landed;
        };

        await Promise.resolve();

        for (const [index, move] of moves.entries())
        {
            const next = moves[index + 1];

            if (!ctx.live())
            {
                return;
            }

            if (move.e === 'card' && move.seat !== undefined && move.card !== undefined)
            {
                flying.push(lay(ctx.stage, move.seat, move.card, move.seat === mine ? originOf(move.card) : null));

                if (next?.e === 'card')
                {
                    await ctx.stage.wait(TIMING.SEQ_GAP);
                }

                continue;
            }

            await down();

            if (!ctx.live())
            {
                return;
            }

            if (move.e === 'trick' && move.seat !== undefined)
            {
                await ctx.stage.wait(TIMING.SETTLE);
                await take(move.seat, next, ctx);

                continue;
            }

            if (move.e === 'hand')
            {
                await call(move, ctx);

                continue;
            }

            if (move.e === 'finish')
            {
                if (withMe(move.side))
                {
                    sound?.play('win');
                    haptic('win');
                }

                continue;
            }

            const had = heldAt(held);
            const won = wonAt(held);

            if (move.e === 'deal' && [...had, ...won].some((count) => count > 0))
            {
                ghost = !ctx.stage.quiet();
                dealing = { counts: had, won, deck: held.seats === 2 ? null : held.dealer, stock: null };
                await collect(had, won, ctx);

                if (!ctx.live())
                {
                    return;
                }
            }

            const leaving = move.e === 'deal'
                ? { hakem: held.hakem, dealer: held.dealer, crown: spotOf(markOn(held.hakem)), hand: spotOf(markOn(held.dealer)), deck: spotOf(find('.hokm-deck')) }
                : null;

            held = step(held, move);

            if (leaving !== null)
            {
                const packets = openingPackets(held.seats, held.hakem);

                ghost = false;
                seen = seen.round === held.round ? seen : { round: held.round, cards: new Set() };
                dealing = {
                    counts: had.map(() => 0),
                    won: null,
                    deck: held.seats === 2 ? null : held.dealer,
                    stock: held.stock === null ? null : held.stock + packets.reduce((sum, one) => sum + one.count, 0)
                };
                shown = held;
                await pass(leaving, ctx.stage);
                await dealOut(packets, true, ctx);
            }
            else if (move.e === 'trump')
            {
                const suit = suitNamed(move.suit ?? null);

                if (suit !== null && (token === null || !token.pledged || token.suit !== suit))
                {
                    token = { suit, pledged: false };
                    named = name(spotOf(markOn(held.hakem)), ctx.stage);
                }

                await named;

                if (!ctx.live())
                {
                    return;
                }

                dealing = held.seats === 2 ? null : { counts: had, won: null, deck: held.dealer, stock: null };
                shown = held;
                token = null;
                await ctx.stage.wait(TIMING.FADE);
                await dealOut(restPackets(held.seats, held.full, held.hakem), false, ctx);
            }
            else
            {
                shown = held;
            }

            if (move.e === 'draw' && move.seat !== undefined)
            {
                await drawOne(ctx.stage, move.seat);
            }
            else if (move.e === 'discard')
            {
                sound?.play('card-place', { gain: 0.5 });
            }

            if (ctx.live())
            {
                dealing = null;
            }
        }

        await down();
    };

    const reset = (sight: Sight<Felt>) =>
    {
        layer?.replaceChildren();
        origins.clear();
        held = sight.view;
        dealing = null;
        ghost = false;
        carried = { hakem: false, dealer: false };
        token = null;
        seen = { round: view?.round ?? 0, cards: new Set(heldAt(held)[mine ?? -1] === 0 ? [] : (view?.hand ?? [])) };
        shown = held;
        lying = null;
        landing = [];
        banner = null;
        lifted = null;
    };

    const rest = () =>
    {
        result = over;
        seen = { round: view?.round ?? 0, cards: new Set(view?.hand ?? []) };

        if (sending === null || !sending.gone)
        {
            held = viewFelt();
            shown = held;
        }
    };

    const mend = () =>
    {
        const sight = sightNow();

        if (presenter?.presenting() === true)
        {
            return;
        }

        result = over;

        if (presenter !== null && sight !== null && !sameAs(held, sight.view))
        {
            reset(sight);
        }
    };

    const staging: Table<Felt, Told> = {
        kind: 'hokm',
        history: HISTORY,
        before: (sight) => ({ ...sight, view: before(sight.view) }),
        reset,
        same: (sight) => sameAs(held, sight.view),
        settle: reset,
        play: (acts, _sight, ctx) => play(acts, ctx),
        estimate: (acts) => spanOf(acts.flatMap((act) => act.moves), game.seats, mine ?? null)
    };

    const refuse = (id: string, card: number, rev: number) =>
    {
        const same = () => sent !== null && sent.id === id && sent.card === card && sent.rev === rev;

        origins.delete(card);

        if (!same())
        {
            return;
        }

        presenter?.predict(null);

        if (sent?.gone !== true)
        {
            sent = null;
            lifted = null;

            return;
        }

        presenter?.act(() =>
        {
            if (same() && mine !== undefined)
            {
                sent = null;
                held = unplay(held, mine, card);
                shown = held;
            }
        });
    };

    let named: Promise<void> = Promise.resolve();

    let uncap: () => void = () => undefined;

    effect
    {
        const hidden = capped;

        untrack(() =>
        {
            uncap();
            uncap = hidden ? runtime().clock.after(view?.phase === 'trump' ? DEALT_CAP : REST_CAP, () => show([...unseen])) : () => undefined;
        });
    }

    let unhurry: () => void = () => undefined;

    effect
    {
        const left = spare;

        untrack(() =>
        {
            const all = () =>
            {
                seen = { round: view?.round ?? 0, cards: new Set(view?.hand ?? []) };
            };

            unhurry();
            unhurry = () => undefined;

            if (left !== undefined && left < HURRY_MS)
            {
                all();
            }
            else if (left !== undefined)
            {
                unhurry = runtime().clock.after(left - HURRY_MS, all);
            }
        });
    }

    effect
    {
        const mirrored = fresh;
        const on = current;

        untrack(() =>
        {
            if (on)
            {
                stale = mirrored;
            }
        });
    }

    effect
    {
        const batch = props.events;

        void game.id;
        void game.rev;

        untrack(() =>
        {
            presenter?.see(batch);
            mend();
        });
    }

    effect
    {
        const yours = acting;

        untrack(() =>
        {
            const now = hokmOf(props.match);
            const drawn = now !== null && now.phase === 'draw';

            if (yours && !wasActing && !(drawn && chimedDraw === now.round))
            {
                sound?.play('turn', { urgent: true });
                haptic('ready');
            }

            if (yours && drawn)
            {
                chimedDraw = now.round;
            }

            wasActing = yours;
        });
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => sound?.setEnabled(on));
    }

    state cramped = false;

    let judging = 0;

    let judgedAt = '';

    let feltWatch: ResizeObserver | null = null;

    let watchedFelt: Element | null = null;

    const judgeFelt = () =>
    {
        judging = 0;

        const table = arena?.querySelector<HTMLElement>('.hokm-table') ?? null;

        if (table !== watchedFelt && feltWatch !== null)
        {
            if (watchedFelt !== null)
            {
                feltWatch.unobserve(watchedFelt);
            }

            if (table !== null)
            {
                feltWatch.observe(table);
            }

            watchedFelt = table;
        }

        if (table === null)
        {
            return;
        }

        const size = `${ Math.round(room.width) }x${ Math.round(room.height) }`;
        const solids = [...table.querySelectorAll('.hokm-seat .table-plate, .hokm-seat .hokm-pile')]
            .map((one) => one.getBoundingClientRect())
            .filter((box) => box.width > 0 && box.height > 0);
        const clash = [...table.querySelectorAll('.hokm-felt-info > .hokm-chip')].some((chip) =>
        {
            const box = chip.getBoundingClientRect();

            return box.width > 0 && solids.some((other) => box.left < other.right && other.left < box.right && box.top < other.bottom && other.top < box.bottom);
        });
        const next = clash || (size === judgedAt && cramped);

        judgedAt = size;

        if (next !== cramped)
        {
            cramped = next;
        }
    };

    const judgeSoon = () =>
    {
        if (judging === 0 && typeof requestAnimationFrame !== 'undefined')
        {
            judging = requestAnimationFrame(judgeFelt);
        }
    };

    effect
    {
        void room;
        void plates;

        untrack(judgeSoon);
    }

    mount
    {
        let unwatch: () => void = () => undefined;

        sound = createSound(untrack(() => settings.settings().sound));

        if (layer !== null)
        {
            const clock = runtime().clock;
            const report = (error: unknown) => console.error(error);
            rig = createStage({ clock, quiet: () => device.reducedMotion(), report });
            presenter = createPresenter<Felt, Told>({ stage: rig, clock, table: staging, sight: () => untrack(sightNow), report });
            unwatch = presenter.watch((busy) =>
            {
                presenting = busy;
                props.onPresenting?.(busy);

                if (!busy)
                {
                    untrack(rest);
                }
            });

            untrack(() => presenter!.see(props.events));
        }

        void document.fonts?.ready.then(judgeSoon);

        feltWatch = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(judgeSoon);

        const watcher = typeof ResizeObserver === 'undefined' || arena === null
            ? null
            : new ResizeObserver(([entry]) =>
            {
                const { width, height } = entry.contentRect;

                if (Math.abs(width - room.width) > 1 || Math.abs(height - room.height) > 1)
                {
                    room = { width, height };
                }
            });

        if (watcher !== null && arena !== null)
        {
            watcher.observe(arena);
        }

        return () =>
        {
            watcher?.disconnect();
            feltWatch?.disconnect();

            if (judging !== 0)
            {
                cancelAnimationFrame(judging);
            }

            unwatch();
            props.onPresenting?.(false);
            presenter?.dispose();
            presenter = null;
            rig = null;
            steady();
            uncap();
            unhurry();
            sound?.dispose();
            sound = null;
        };
    }

    <div data-rev={ props.match.rev } data-presenting={ presenting ? 'true' : undefined } data-felt={ cramped ? 'cramped' : undefined } class="table-stage hokm-stage" ref={ (element) => arena = element }>
        <div class="table-grid hokm-grid">
            <Show when={ dealt }>
                { () =>
                    <div class="table-fit">
                        <div class="table-surface hokm-table">
                            <div class="hokm-medal" data-set={ trump === null ? undefined : 'true' } aria-hidden="true">
                                <Show when={ trump } let={ suit } fallback={ <Icon name="crest-crown" size={ 20 } class="text-gold" /> }>
                                    <Icon name={ SUIT_ICON[suit] } size={ 20 } class={ RED_SUITS.includes(suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                </Show>
                            </div>

                            <Show when={ token } let={ call }>
                                <span class="hokm-token" data-suit={ call.suit } aria-hidden="true">
                                    <Icon name={ SUIT_ICON[call.suit] } size={ 20 } class={ RED_SUITS.includes(call.suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                </span>
                            </Show>

                            <div class="hokm-felt-info" aria-hidden="true">
                                <span class="hokm-chip">
                                    <Show
                                        when={ trump }
                                        let={ suit }
                                        fallback={ <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" /> }
                                    >
                                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-text">
                                            <Icon name={ SUIT_ICON[suit] } size={ 12 } class={ RED_SUITS.includes(suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                        </span>
                                    </Show>
                                    <span>{ locale.t('hokm.round', { n: locale.n(felt.round) }) }</span>
                                </span>
                                <span class="hokm-chip">
                                    <For each={ sides } key={ (side) => side.index } let={ side }>
                                        <span class="flex items-center gap-1">
                                            <span class={ () => [ 'h-2 w-2 rounded-full bg-current', SIDE_TONE[side.index % SIDE_TONE.length] ].join(' ') }></span>
                                            <span class="tally font-bold text-white">{ locale.n(side.points) }</span>
                                        </span>
                                    </For>
                                    <span class="tally text-white/60">/{ locale.n(view!.target) }</span>
                                </span>
                            </div>

                            <For each={ seated } key={ (seat) => seat } let={ seat }>
                                <div class="hokm-seat" data-side={ plateAt(seat).side } data-seat={ seat }>
                                    <HokmSeat
                                        side={ plateAt(seat).side }
                                        who={ whoAt(seat) }
                                        name={ nameOf(seat) }
                                        turn={ seat === turnAt }
                                        yours={ seat === mine }
                                        remainingMs={ game.remainingMs }
                                        turnMs={ props.turnMs }
                                        out={ plateAt(seat).row.out }
                                        team={ teamOf(plateAt(seat).row) }
                                        tag={ tagOf(seat)?.text }
                                        tone={ tagOf(seat)?.tone }
                                        bubble={ props.speech?.[whoAt(seat)] }
                                        mark={ plateAt(seat).mark }
                                        colour={ plateAt(seat).row.side }
                                        tricks={ plateAt(seat).row.tricks }
                                        held={ plateAt(seat).row.held }
                                        backs={ plateAt(seat).backs }
                                    />
                                </div>
                            </For>

                            <Show when={ decked }>
                                { () =>
                                    <span class="hokm-deck" data-ghost={ ghost ? 'true' : undefined } style={ `--dx: ${ deckReach[0] }; --dy: ${ deckReach[1] }` } aria-hidden="true">
                                        <span class="card-back" style="--i: 0"></span>
                                        <span class="card-back" style="--i: 1"></span>
                                        <span class="card-back" style="--i: 2"></span>
                                    </span>
                                }
                            </Show>

                            <Show when={ piled }>
                                { () =>
                                    <div class="hokm-stock" data-live={ stockLive ? 'true' : undefined } data-ghost={ ghost ? 'true' : undefined }>
                                        <span class="hokm-stock-pile" aria-hidden="true">
                                            <For each={ stockBacks } key={ (back) => back } let={ back }>
                                                <span class="card-back" style={ `--i: ${ back }` }></span>
                                            </For>
                                        </span>
                                        <span class="hokm-chip hokm-stock-count" data-idle={ counted ? undefined : 'true' } aria-hidden="true"><span class="tally">{ locale.n(stockLeft ?? 0) }</span></span>
                                        <Show when={ discarding }>
                                            { () =>
                                                <span class="hokm-stock-due" data-full={ putting ? 'true' : undefined } aria-hidden="true">
                                                    <span class="tally">{ locale.n(picks.length) }/{ locale.n(due) }</span>
                                                </span>
                                            }
                                        </Show>
                                        <Show when={ stockLive }>
                                            { () =>
                                                <button
                                                    type="button"
                                                    class="hokm-stock-press"
                                                    aria-label={ drawing ? locale.t('hokm.draw.next') : locale.t('hokm.discard.put', { count: locale.n(due) }) }
                                                    disabled={ board.busy() }
                                                    onClick={ pressStock }
                                                ></button>
                                            }
                                        </Show>
                                    </div>
                                }
                            </Show>

                            <Show when={ choosing }>
                                { () =>
                                    <div class="hokm-choose" dir={ locale.dir() }>
                                        <p class="hokm-choose-title">{ locale.t('hokm.trump.choose') }</p>
                                        <ul class="hokm-choose-suits">
                                            <For each={ [...SUITS] } key={ (suit) => suit } let={ suit }>
                                                <li class="flex min-w-0">
                                                    <button
                                                        type="button"
                                                        class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-tile border border-white/15 bg-void/85 px-2 text-ui-sm font-semibold text-text shadow-2 transition hover:border-accent hover:bg-lifted disabled:cursor-not-allowed disabled:opacity-50"
                                                        disabled={ board.busy() }
                                                        onClick={ (event: MouseEvent) => void callTrump(suit, event) }
                                                    >
                                                        <span class="hokm-choose-suit flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-text" data-suit={ suit }>
                                                            <Icon name={ SUIT_ICON[suit] } size={ 16 } class={ RED_SUITS.includes(suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                                        </span>
                                                        <span class="hokm-choose-name truncate">{ locale.t(`hokm.suit.${ suit }` as never) }</span>
                                                    </button>
                                                </li>
                                            </For>
                                        </ul>
                                    </div>
                                }
                            </Show>

                            <Show when={ offered } let={ drawn }>
                                <button
                                    type="button"
                                    class="hokm-offer"
                                    aria-label={ locale.t('hokm.draw.keep', { card: cardSays(drawn.card) }) }
                                    disabled={ board.busy() }
                                    onClick={ () => void draw('keep') }
                                >
                                    <CardFace card={ drawn.card } />
                                </button>
                            </Show>

                            <Show when={ glimpsed } let={ seen }>
                                <span class="hokm-glimpse" aria-hidden="true"><CardFace card={ seen.card } /></span>
                            </Show>

                            <For each={ laid.cards } key={ (one) => one.card } let={ one }>
                                <div
                                    class="hokm-trick"
                                    data-card={ one.card }
                                    data-landing={ landing.includes(one.card) ? 'true' : undefined }
                                    data-took={ one.seat === laid.took ? 'true' : 'false' }
                                    style={ `--dx: ${ REACH[one.side][0] }; --dy: ${ REACH[one.side][1] }; --tilt: ${ tiltOf(one.card) }deg` }
                                    aria-hidden="true"
                                >
                                    <CardFace card={ one.card } />
                                </div>
                            </For>

                            <Show when={ last } let={ taken }>
                                <div class="hokm-last-tile" aria-hidden="true">
                                    <span class="hokm-last-title">{ locale.t('hokm.lastTrick') }</span>
                                    <ul class="hokm-last">
                                        <For each={ taken.cards } key={ (card) => card } let={ card }>
                                            <li><CardFace card={ card } /></li>
                                        </For>
                                    </ul>
                                </div>
                            </Show>

                            <Show when={ banner } let={ called }>
                                <div class="hokm-banner" data-kot={ called.kot ? 'true' : 'false' } data-ours={ called.ours ? 'true' : 'false' } dir={ locale.dir() } aria-hidden="true">
                                    <Show when={ called.kot } fallback={ <span class="tally">+{ locale.n(called.points) }</span> }>
                                        { () => <span>{ locale.t('hokm.kot') }</span> }
                                    </Show>
                                </div>
                            </Show>

                            <ul class="sr-only">
                                <For each={ laid.cards } key={ (one) => one.card } let={ one }>
                                    <li>{ locale.t('hokm.played', { name: nameOf(one.seat), card: cardSays(one.card) }) }</li>
                                </For>
                            </ul>

                            <aside class="hokm-side sr-only" aria-label={ locale.t('hokm.summary') }>
                                <section>
                                    <h3>{ locale.t('hokm.trump') }</h3>
                                    <p>{ trump === null ? locale.t('hokm.trump.none') : locale.t(`hokm.suit.${ trump }` as never) }</p>
                                    <p>{ felt.hakem === mine ? locale.t('hokm.hakem.you') : locale.t('hokm.hakem', { name: nameOf(felt.hakem) }) }</p>
                                    <Show when={ stocked }>
                                        { () => <p>{ locale.plural('hokm.stock', felt.stock ?? 0) }</p> }
                                    </Show>
                                </section>
                                <section>
                                    <h3>{ locale.t('hokm.score') }</h3>
                                    <p>{ locale.t('hokm.round', { n: locale.n(felt.round) }) }</p>
                                    <Show when={ needed !== undefined } fallback={ <p>{ locale.t('hokm.needed.triple') }</p> }>
                                        { () => <p>{ locale.n(needed!) } { locale.plural('hokm.needed', needed!) }</p> }
                                    </Show>
                                    <dl>
                                        <For each={ sides } key={ (side) => side.index } let={ side }>
                                            <div>
                                                <dt>{ side.names }</dt>
                                                <dd>
                                                    <span>{ locale.t('hokm.points', { points: locale.n(side.points), target: locale.n(view!.target) }) }</span>
                                                    <span>{ locale.plural('hokm.tricks', side.tricks) }</span>
                                                </dd>
                                            </div>
                                        </For>
                                    </dl>
                                </section>
                                <section>
                                    <h3>{ locale.t('hokm.lastTrick') }</h3>
                                    <p>{ last === null ? locale.t('hokm.lastTrick.none') : locale.t('hokm.table.took', { name: nameOf(last.seat) }) }</p>
                                </section>
                            </aside>
                        </div>
                    </div>
                }
            </Show>

            <Show when={ footed }>
                { () =>
                    <div class="table-hand hokm-foot" data-tools={ mine !== undefined ? 'true' : undefined }>
                        <section class="table-bar hokm-rail">
                            <p class="sr-only" aria-live="polite">{ says }</p>
                            <Show when={ following }>
                                { () => <p class="sr-only">{ locale.t('hokm.follow') }</p> }
                            </Show>
                            <Show when={ glimpsed } let={ seen }>
                                <p class="sr-only">{ locale.t('hokm.draw.glimpse', { card: cardSays(seen.card) }) }</p>
                            </Show>
                            <span class="hokm-rail-end">
                                <Show when={ sortable }>
                                    { () => <IconButton icon="sort" label={ locale.t('hokm.sort') } variant="secondary" pressed={ sorted } class="hokm-sort" onClick={ resort } /> }
                                </Show>
                                <span class="hokm-chip hokm-bar-trump" aria-hidden="true">
                                    <Show
                                        when={ trump }
                                        let={ suit }
                                        fallback={ <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" /> }
                                    >
                                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-text">
                                            <Icon name={ SUIT_ICON[suit] } size={ 12 } class={ RED_SUITS.includes(suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                        </span>
                                    </Show>
                                </span>
                            </span>
                            <span class="hokm-rail-end">
                                <span class="hokm-chip hokm-bar-score" aria-hidden="true">
                                    <For each={ sides } key={ (side) => side.index } let={ side }>
                                        <span class="flex items-center gap-1">
                                            <span class={ () => [ 'h-2 w-2 rounded-full bg-current', SIDE_TONE[side.index % SIDE_TONE.length] ].join(' ') }></span>
                                            <span class="tally font-bold text-white">{ locale.n(side.points) }</span>
                                        </span>
                                    </For>
                                </span>
                                <span class="contents" dir={ locale.dir() }>
                                    <CoachLine tip={ tip } lamp />
                                </span>
                            </span>
                        </section>
                        <Show when={ handed }>
                            { () =>
                                <div class="hokm-hands" data-sliding={ sliding ? 'true' : undefined } style={ `--rows: ${ roomy }` }>
                                <For each={ rows } key={ (_, index) => index } let={ row }>
                                    <ul class="hokm-hand" style={ `--n: ${ row.length }` } aria-label={ locale.t('hokm.hand') }>
                                        <For each={ row } key={ (card) => card } let={ card } index={ index }>
                                            <li style={ fan(index, row.length) } data-dealt={ current && unseen.has(card) ? 'false' : undefined }>
                                                <button
                                                    type="button"
                                                    class="card-hold"
                                                    data-card={ card }
                                                    data-legal={ discarding ? 'true' : (myTurn ? (hints.hintMoves ? (legal.has(card) ? 'true' : 'false') : 'hidden') : 'idle') }
                                                    data-picked={ chosen === card || picks.includes(card) || lifted?.card === card ? 'true' : undefined }
                                                    data-go={ chosen === card ? 'true' : undefined }
                                                    tabindex={ stop === card ? 0 : -1 }
                                                    aria-disabled={ board.busy() || (!discarding && !legal.has(card)) ? 'true' : undefined }
                                                    aria-label={ discarding ? cardSays(card) : cardLabel(card) }
                                                    aria-pressed={ discarding ? picks.includes(card) : (device.coarse() ? chosen === card : undefined) }
                                                    onFocus={ () => kept = card }
                                                    onKeyDown={ (event: KeyboardEvent) => walk(event, card) }
                                                    onClick={ (event: MouseEvent) => (discarding ? toggleAway(card) : touchCard(card, event.detail === 0)) }
                                                >
                                                    <CardFace card={ card } />
                                                </button>
                                            </li>
                                        </For>
                                    </ul>
                                </For>
                                </div>
                            }
                        </Show>
                    </div>
                }
            </Show>
        </div>

        <Show when={ result }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } rematch={ props.rematch } />
            }
        </Show>

        <div class="board-flight" aria-hidden="true" inert ref={ (element) => layer = element }></div>
    </div>
}
