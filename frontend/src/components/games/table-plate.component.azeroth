import { onCleanup, untrack, type Child } from 'azerothjs';

import Avatar from '../ui/avatar.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { aboutPerson } from '../../lib/person-menu.ts';
import { runtime } from '../../lib/runtime.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useVoice } from '../../stores/voice.store.ts';
import type { PlateTone } from './plate-tag.ts';

export interface PlateTeam
{
    side: number;
    says?: string;
}

export default component TablePlate(props: {
    who: string;
    name: string;
    turn?: boolean;
    remainingMs?: number;
    turnMs?: number;
    marker?: Child;
    facts?: Child;
    tag?: string;
    tone?: PlateTone;
    dim?: boolean;
    bubble?: string;
    below?: boolean;
    anchor?: 'start' | 'end' | 'centre';
    ink?: string;
    trail?: Child;
    team?: PlateTeam;
})
{
    const people = usePeople();
    const voice = useVoice();
    const device = useDevice();
    const account = useAccount();
    const locale = useLocale();

    derived theirs = account.user()?.handle !== props.who;

    const STILL_OVER_MS = 10 * 60 * 1000;

    const STEP_MS = 1000;

    const SLOW_STEP_MS = 60_000;

    state beat = runtime().clock.now();

    let heardAt = untrack(() => runtime().clock.now());

    let stop: () => void = () => undefined;

    effect
    {
        void props.remainingMs;

        const at = runtime().clock.now();

        heardAt = at;
        beat = at;
    }

    derived quiet = device.reducedMotion();

    derived long = props.remainingMs !== undefined && props.remainingMs > STILL_OVER_MS;

    derived step = props.turn === true && quiet && !long ? STEP_MS : SLOW_STEP_MS;

    effect
    {
        const every = step;

        untrack(() =>
        {
            stop();
            stop = runtime().clock.every(every, () => beat = runtime().clock.now());
        });
    }

    onCleanup(() => stop());

    derived speaking = voice.speaking(props.who);

    derived marker = props.marker;

    derived marked = marker !== undefined;

    derived facts = props.facts;

    derived stated = facts !== undefined;

    derived trail = props.trail;

    derived trailed = trail !== undefined;

    derived tag = props.tag ?? '';

    derived tagged = tag !== '';

    derived tone = props.tone ?? 'neutral';

    derived clock = ((): { key: string; style: string; still: boolean }[] =>
    {
        if (props.turn !== true || props.remainingMs === undefined || props.turnMs === undefined || props.turnMs <= 0)
        {
            return [];
        }

        if (!long && !quiet)
        {
            return [{ key: `${ props.who }-${ props.remainingMs }`, style: `--from: ${ Math.min(1, props.remainingMs / props.turnMs).toFixed(4) }; --ms: ${ Math.round(props.remainingMs) }ms`, still: false }];
        }

        const left = Math.max(0, props.remainingMs - (beat - heardAt));

        return [{ key: `${ props.who }-still`, style: `--from: ${ Math.min(1, left / props.turnMs).toFixed(4) }`, still: true }];
    })();

    <div
        class="table-plate"
        data-turn={ props.turn === true ? 'true' : undefined }
        data-dim={ props.dim === true ? 'true' : undefined }
        data-bubble={ props.below === true ? 'below' : undefined }
        data-anchor={ props.anchor }
        data-team={ props.team?.side }
        data-speaking={ speaking ? 'true' : undefined }
        style={ props.ink === undefined ? undefined : `--ink: ${ props.ink }` }
        aria-current={ props.turn === true ? 'true' : undefined }
    >
        <span class="table-plate-avatar" data-speaking={ speaking ? 'true' : undefined }>
            <Avatar person={ people.byHandle(props.who) } size="sm" ringOn="void" />
            <For each={ clock } key={ (one) => one.key } let={ one }>
                <svg class="table-plate-clock" viewBox="0 0 40 40" style={ one.style } data-still={ one.still ? 'true' : undefined } aria-hidden="true">
                    <circle cx="20" cy="20" r="18.5" pathLength="100"></circle>
                </svg>
            </For>
            <Show when={ marked }>
                { () => <span class="table-plate-marker">{ marker }</span> }
            </Show>
            <Show when={ props.team } let={ team }>
                <span class="table-plate-team" data-side={ team.side }>
                    <Show when={ team.says } let={ said }>
                        <span class="sr-only">{ said }</span>
                    </Show>
                </span>
            </Show>
            <Show when={ voice.mark(props.who) } let={ mark }>
                <span class="table-plate-voice" data-mark={ mark } aria-hidden="true">
                    <Icon name={ mark === 'muted' ? 'voice-off' : 'voice' } size={ 10 } />
                </span>
            </Show>
        </span>
        <span class="table-plate-text">
            <span class="table-plate-name" dir="auto">{ props.name }</span>
            <Show when={ stated }>
                { () => <span class="table-plate-facts">{ facts }</span> }
            </Show>
        </span>
        <Show when={ tagged }>
            { () => <span class="table-plate-tag" data-tone={ tone }>{ tag }</span> }
        </Show>
        <Show when={ trailed }>
            { () => <span class="table-plate-trail">{ trail }</span> }
        </Show>
        <Show when={ props.bubble } let={ said }>
            <span class="table-plate-bubble" dir="auto" role="status">{ said }</span>
        </Show>
        <Show when={ theirs }>
            { () => <button type="button" class="table-plate-press" tabindex="-1" aria-haspopup="dialog" aria-label={ locale.t('actions.about', { name: props.name }) } onClick={ () => aboutPerson(props.who) }></button> }
        </Show>
    </div>
}
