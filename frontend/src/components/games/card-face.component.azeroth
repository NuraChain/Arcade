import { RANKS } from '../../data/cards.ts';

export default component CardFace(props: { card: number })
{
    derived rank = props.card % RANKS.length;

    derived suit = Math.floor(props.card / RANKS.length);

    <span class="card-face" style={ `--at-rank: ${ rank }; --at-suit: ${ suit }` } aria-hidden="true" />
}
