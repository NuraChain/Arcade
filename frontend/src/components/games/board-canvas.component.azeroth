import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { CELL, MARGIN } from '../../game/layout.ts';
import { FINISHED } from '../../game/board/path.ts';
import type { BoardHandle, BoardOptions, BoardToken } from '../../game/bridge.ts';
import { sceneFor } from '../../game/scenes.ts';

export default component BoardCanvas(props: { game: string; tokens: readonly BoardToken[]; rig: Omit<BoardOptions, 'host' | 'plate'>; onTable: (table: BoardHandle | null) => void })
{
    const device = useDevice();
    const locale = useLocale();
    const overlay = useOverlay();

    let host: HTMLDivElement | null = null;
    let handle: BoardHandle | null = null;

    state failed = false;

    mount
    {
        let dropped = false;

        void (async () =>
        {
            if (host === null)
            {
                return;
            }

            try
            {
                const scene = sceneFor(props.game);

                if (scene === null)
                {
                    failed = true;
                    return;
                }

                const loaded = await scene();

                if (dropped || host === null)
                {
                    return;
                }

                handle = await loaded.open({ host, ...props.rig });

                if (dropped)
                {
                    handle.dispose();
                    handle = null;
                    return;
                }

                handle.still(device.reducedMotion());

                if (overlay.blocking())
                {
                    handle.pause();
                }

                props.onTable(handle);
            }
            catch
            {
                props.onTable(null);
                handle?.dispose();
                handle = null;
                failed = true;
            }
        })();

        return () =>
        {
            dropped = true;
            props.onTable(null);
            handle?.dispose();
            handle = null;
        };
    }

    effect
    {
        const reduced = device.reducedMotion();

        handle?.still(reduced);
    }

    effect
    {
        const blocking = overlay.blocking();

        if (blocking)
        {
            handle?.pause();
        }
        else
        {
            handle?.resume();
        }
    }

    <div
        class="board-plate [direction:ltr] relative isolate @container inline-full block-full bg-[url('/board/ludo-board.svg')] bg-[length:100%_100%] bg-no-repeat rounded-panel overflow-hidden"
        role="img"
        aria-label={ locale.t('match.board') }
        style={ `--rim:${ (MARGIN * 100).toFixed(4) }cqi; --cell:${ (CELL * 100).toFixed(4) }cqi` }
    >
        <div class="board-canvas absolute inset-0" aria-hidden="true" ref={ (element) => host = element }></div>

        <Show when={ failed }>
            { () =>
                <For each={ [...props.tokens] } key={ (token) => token.key } let={ token }>
                    <span
                        class="board-token absolute inset-s-0 inset-bs-0 inline-[calc(var(--cell)*0.80)] block-[calc(var(--cell)*0.80)] [translate:calc(var(--rim)_+_var(--at-col)_*_var(--cell)_+_var(--cell)_*_0.10)_calc(var(--rim)_+_var(--at-row)_*_var(--cell)_+_var(--cell)_*_0.10)] z-[calc(var(--at-row)*10)] origin-[50%_62.5%] [transition:translate_var(--duration-ui,180ms)_var(--ease-ui,ease)] motion-reduce:[transition:none] data-home:[scale:0.62]"
                        aria-hidden="true"
                        data-home={ token.at === FINISHED ? 'true' : undefined }
                        style={ `--at-col:${ token.col }; --at-row:${ token.row }; --pawn: url('/board/pawn-${ token.colour }.svg'); --tone: var(--ludo-${ token.colour })` }
                    ></span>
                </For>
            }
        </Show>
    </div>
}
