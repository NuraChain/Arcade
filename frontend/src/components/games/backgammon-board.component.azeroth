import { untrack } from 'azerothjs';

import Rail from '../ui/rail.component.azeroth';
import TableResult from './table-result.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import TablePlate from './table-plate.component.azeroth';
import { plateTag } from './plate-tag.ts';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { backgammonOf } from '../../data/match.ts';
import { useBoard, type EventBatch } from '../../stores/match.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { turnChime } from './table-cues.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { diceOf, stage } from '../../../../backend/src/domains/match/backgammon/moves.ts';
import type { Hop } from '../../../../backend/src/domains/match/backgammon/board.ts';
import { coachOf, hits, outcomeOf } from '../../game/helpers/backgammon.ts';
import { createBackgammonTable, HOP_MS, type BackgammonTable } from '../../game/board/backgammon-table.ts';
import { feltOf, seedOf, type Felt, type Told } from '../../game/backgammon-felt.ts';
import { createSound, type SoundHandle } from '../../game/sound.ts';
import type { Ctx } from '../../game/stage/director.ts';
import { createPresenter, type Presenter, type Sight } from '../../game/stage/presenter.ts';
import { createStage } from '../../game/stage/stage.ts';
import {
    BAR_LEFT,
    BAR_WIDTH,
    BOTTOM,
    FIELD_LEFT,
    FIELD_RIGHT,
    FRAME,
    HEIGHT,
    MIDDLE,
    POINT_HEIGHT,
    POINT_WIDTH,
    TOP,
    TRAY,
    TRAY_LEFT,
    WIDTH,
    columnOf,
    pointAt
} from '../../game/backgammon-layout.ts';
import type { MatchView } from '../../api.ts';
import type { Rematch } from './boards.ts';

type Tone = 'light' | 'dark';

interface Spike
{
    point: number;
    path: string;
    shade: 'a' | 'b';
}

interface Staged
{
    at: string;
    hops: readonly Hop[];
}

interface Picked
{
    at: string;
    spot: number;
}

const NONE: readonly Hop[] = [];

const POINTS = Array.from({ length: 24 }, (_, index) => index + 1);

const SPIKES: readonly Spike[] = POINTS.map((point) =>
{
    const column = columnOf(point);
    const base = column.row === 'top' ? TOP : BOTTOM;
    const tip = column.row === 'top' ? TOP + POINT_HEIGHT : BOTTOM - POINT_HEIGHT;

    return {
        point,
        path: `${ column.x },${ base } ${ column.x + POINT_WIDTH },${ base } ${ column.x + POINT_WIDTH / 2 },${ tip }`,
        shade: point % 2 === 0 ? 'a' : 'b'
    };
});

const covered = (moves: readonly Told[], mine: readonly Hop[]) =>
    (mine.every((hop, index) => moves[index]?.e === 'move' && moves[index].from === hop.from && moves[index].to === hop.to) ? mine.length : null);

export default component BackgammonBoard(props: { match: MatchView; events: EventBatch; starting?: boolean; onAgain?: () => void; rematch?: Rematch; speech?: Record<string, string>; turnMs?: number })
{
    const locale = useLocale();
    const board = useBoard();
    const device = useDevice();
    const people = usePeople();

    state staged: Staged = { at: '', hops: NONE };

    state picked: Picked | null = null;

    state presenting = false;

    derived game = props.match;

    derived at = `${ game.id }:${ game.rev }`;

    derived hops = staged.at === at ? staged.hops : NONE;

    derived chosen = picked !== null && picked.at === at ? picked.spot : null;

    derived view = backgammonOf(game);

    derived over = game.finishedAt !== undefined;

    derived mine = game.mine;

    derived viewer = mine ?? 0;

    const toneOf = (seat: number): Tone => (seat === 0 ? 'light' : 'dark');

    derived rowOf = (seat: number): readonly number[] =>
        view?.seats.find((row) => row.seat === seat)?.checkers ?? [];

    derived whoAt = (seat: number) => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number) =>
    {
        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const who = whoAt(seat);
        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived myTurn = view !== null && !over && mine !== undefined && view.turn === mine;

    const settings = useSettings();

    derived hints = settings.settings().hintMoves;

    derived told = settings.settings().hintOutcome;

    let layer: HTMLElement | null = null;
    let men: BackgammonTable | null = null;
    let presenter: Presenter<Told> | null = null;
    let sound: SoundHandle | null = null;

    const chime = turnChime(() => sound);

    effect
    {
        const yours = myTurn;

        untrack(() => chime(yours && props.match.mine !== undefined));
    }

    derived plan = myTurn && view!.phase === 'move' && view!.dice.length === 2
        ? stage({ me: [...rowOf(viewer)], them: [...rowOf(1 - viewer)] }, view!.dice, hops)
        : null;

    derived near = plan?.at.me ?? rowOf(viewer);

    derived far = plan?.at.them ?? rowOf(1 - viewer);

    derived sources = new Set(chosen === null && hints ? (plan?.next ?? []).map((hop) => hop.from) : []);

    derived targets = chosen === null || !hints ? [] : (plan?.next ?? []).filter((hop) => hop.from === chosen).map((hop) => hop.to);

    derived lights = new Set<number>(chosen === null ? [...sources] : [...sources, chosen]);

    derived aimed = new Set(targets.filter((to) => to !== 0));

    derived trayLit = targets.includes(0);

    derived dice = view === null || view.dice.length < 2 ? [] : diceOf(view.dice);

    derived spent = (() =>
    {
        const left = [...dice];
        const used = dice.map(() => false);

        for (const hop of hops)
        {
            const distance = hop.from - hop.to;
            let found = left.indexOf(distance);

            if (found < 0 && hop.to === 0)
            {
                const bigger = left.filter((face) => face > distance).sort((a, b) => a - b)[0];

                found = bigger === undefined ? -1 : left.indexOf(bigger);
            }

            if (found >= 0)
            {
                const face = left[found];

                left.splice(found, 1);

                const slot = dice.findIndex((one, index) => one === face && !used[index]);

                if (slot >= 0)
                {
                    used[slot] = true;
                }
            }
        }

        return used;
    })();

    derived diceSaid = view === null || over || view.dice.length === 0
        ? ''
        : locale.t('backgammon.dice', { dice: locale.list(view.dice.map((face) => locale.n(face))) });

    const spotSays = (spot: number) =>
    {
        if (spot === 25)
        {
            return locale.t('backgammon.bar');
        }

        return spot === 0 ? locale.t('backgammon.off') : locale.n(spot);
    };

    const outcomeAt = (hop: Hop) => (told && plan !== null ? outcomeOf(plan.at, hop) : null);

    const hopSays = (hop: Hop) =>
    {
        const said = outcomeAt(hop);

        return locale.t(said === null ? 'backgammon.hop' : `helpers.backgammon.hop.${ said }`, { from: spotSays(hop.from), to: spotSays(hop.to) });
    };

    derived tip = myTurn
        ? coachOf({ phase: view!.phase, side: { me: [...rowOf(viewer)], them: [...rowOf(1 - viewer)] }, dice: view!.dice, staged: hops, doubling: view!.doubling, cube: view!.cube })
        : null;

    derived options = [...(plan?.next ?? [])].sort((a, b) => b.from - a.from || b.to - a.to);

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (view.phase === 'double')
        {
            const offered = locale.n(view.cube * 2);

            if (view.turn === mine)
            {
                return locale.t('backgammon.doubled.you', { name: nameOf(1 - view.turn), cube: offered });
            }

            return mine === undefined
                ? locale.t('backgammon.doubled.watch', { name: nameOf(1 - view.turn), cube: offered })
                : locale.t('backgammon.doubled.them', { name: nameOf(view.turn), cube: offered });
        }

        if (!myTurn)
        {
            return locale.t('match.turn.theirs', { name: nameOf(view.turn) });
        }

        if (view.phase === 'roll')
        {
            return locale.t('backgammon.turn.roll');
        }

        if (plan?.done === true && hops.length > 0)
        {
            return locale.t('backgammon.turn.confirm');
        }

        return locale.t('backgammon.turn.move', { dice: locale.list(view.dice.map((face) => locale.n(face))) });
    })();

    derived stacksSaid = (seat: number) =>
    {
        const row = seat === viewer ? near : far;
        const own = seat === viewer;
        const parts = POINTS
            .map((point) => ({ point: own ? point : 25 - point, count: row[own ? point : 25 - point] ?? 0 }))
            .filter((entry) => entry.count > 0)
            .map((entry) => locale.t('backgammon.stack', { count: locale.n(entry.count), point: locale.n(own ? entry.point : 25 - entry.point) }));

        if ((row[25] ?? 0) > 0)
        {
            parts.push(locale.t('backgammon.stack.bar', { count: locale.n(row[25]) }));
        }

        if ((row[0] ?? 0) > 0)
        {
            parts.push(locale.t('backgammon.stack.off', { count: locale.n(row[0]) }));
        }

        return `${ nameOf(seat) }: ${ locale.list(parts) }`;
    };

    derived ready = view !== null;

    derived result = over && !presenting;

    derived barOpen = view !== null && !over;

    derived rolling = myTurn && view!.phase === 'roll';

    derived mayDouble = rolling && view!.doubling;

    derived answering = myTurn && view!.phase === 'double';

    derived staging = plan !== null;

    derived offered = options.length > 0;

    derived whole = plan?.done === true && hops.length > 0;

    derived cubed = view?.cubed === true;

    derived crawford = view?.crawford === true;

    derived diceTold = diceSaid !== '';

    const sightNow = (): Sight<Felt> | null =>
    {
        if (view === null)
        {
            return null;
        }

        return {
            id: game.id,
            rev: game.rev,
            seat: mine ?? null,
            view: { ...feltOf(view, viewer, over, seedOf(game.id, game.rev)), near, far, spent }
        };
    };

    effect
    {
        const batch = props.events;

        void game.id;
        void game.rev;

        untrack(() => presenter?.see(batch));
    }

    effect
    {
        const spots = lights;

        untrack(() => men?.lit(spots));
    }

    effect
    {
        const spots = aimed;

        untrack(() => men?.aim(spots));
    }

    effect
    {
        void locale.locale();

        untrack(() => men?.relabel());
    }

    effect
    {
        const used = spent;
        const seed = seedOf(game.id, game.rev);

        untrack(() => men?.spend(used, seed));
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => sound?.setEnabled(on));
    }

    mount
    {
        let unwatch: () => void = () => undefined;

        sound = createSound(untrack(() => settings.settings().sound));

        if (layer !== null)
        {
            const clock = runtime().clock;
            const report = (error: unknown) => console.error(error);
            const rig = createStage({ clock, quiet: () => device.reducedMotion(), report });

            men = createBackgammonTable({
                host: layer,
                stage: rig,
                sound: () => sound,
                feel: (kind) =>
                {
                    if (mine !== undefined)
                    {
                        haptic(kind);
                    }
                },
                say: (value) => locale.n(value)
            });
            presenter = createPresenter<Felt, Told>({ stage: rig, clock, table: men, sight: () => untrack(sightNow), report });
            unwatch = presenter.watch((busy) =>
            {
                presenting = busy;
            });

            untrack(() =>
            {
                presenter!.see(props.events);
                men!.lit(lights);
                men!.aim(aimed);
            });
        }

        return () =>
        {
            unwatch();
            presenter?.dispose();
            men?.dispose();
            presenter = null;
            men = null;
            sound?.dispose();
            sound = null;
        };
    }

    const mend = async (ctx: Ctx) =>
    {
        const sight = untrack(sightNow);

        if (men !== null && sight !== null)
        {
            await men.settle(sight, ctx);
        }
    };

    const guess = (next: readonly Hop[]) =>
    {
        const rev = game.rev;

        presenter?.predict(next.length === 0 ? null : { rev, covers: (moves) => covered(moves, next) });
    };

    const add = (hop: Hop) =>
    {
        const hit = plan === null ? false : hits(outcomeOf(plan.at, hop));
        const next = [...hops, hop];

        staged = { at, hops: next };
        picked = null;
        haptic('tick');
        guess(next);
        presenter?.act(async (ctx) =>
        {
            if (men !== null && !(await men.hop({ side: 'near', from: hop.from, to: hop.to, hit })))
            {
                await mend(ctx);
            }
        }, HOP_MS);
    };

    const undo = () =>
    {
        const last = hops[hops.length - 1];

        if (last === undefined)
        {
            return;
        }

        const next = hops.slice(0, -1);
        const earlier = view === null ? null : stage({ me: [...rowOf(viewer)], them: [...rowOf(1 - viewer)] }, view.dice, next);
        const hit = earlier === null ? false : hits(outcomeOf(earlier.at, last));

        staged = { at, hops: next };
        picked = null;
        guess(next);
        presenter?.act(async (ctx) =>
        {
            if (men !== null && !(await men.unhop({ side: 'near', from: last.from, to: last.to, hit })))
            {
                await mend(ctx);
            }
        }, HOP_MS);
    };

    const tap = (event: PointerEvent) =>
    {
        const held = plan;

        if (held === null || board.busy())
        {
            return;
        }

        const box = (event.currentTarget as SVGSVGElement).getBoundingClientRect();
        const found = pointAt((event.clientX - box.left) / box.width * WIDTH, (event.clientY - box.top) / box.height * HEIGHT);

        if (found === null)
        {
            picked = null;
            return;
        }

        const spot = found === 'bar' ? 25 : (found === 'tray' ? 0 : found);

        if (chosen !== null)
        {
            const hop = held.next.find((one) => one.from === chosen && one.to === spot);

            if (hop !== undefined)
            {
                add(hop);
                return;
            }
        }

        const leaving = held.next.filter((one) => one.from === spot);

        if (leaving.length === 0)
        {
            picked = null;
            return;
        }

        if (new Set(leaving.map((one) => one.to)).size === 1)
        {
            add(leaving[0]);
            return;
        }

        picked = { at, spot };
    };

    const play = async (verb: 'roll' | 'double' | 'take' | 'drop') =>
    {
        haptic('select');

        if (verb === 'roll')
        {
            sound?.play('die-shake', { gain: 0.8 });
        }

        await board.play({ kind: 'backgammon', verb });
    };

    const submit = async () =>
    {
        if (!whole)
        {
            return;
        }

        haptic('select');
        await board.play({ kind: 'backgammon', verb: 'move', hops: [...hops] });
    };

    derived plates = [1 - viewer, viewer].map((seat) => ({
        seat,
        tone: toneOf(seat),
        row: view?.seats.find((one) => one.seat === seat)
    }));

    <div data-rev={ props.match.rev } data-presenting={ presenting ? 'true' : undefined } class="table-stage bg-stage">
        <div class="table-grid bg-grid">
            <Show when={ ready }>
                { () =>
                    <span class="contents">
                        <For each={ plates } key={ (plate) => plate.seat } let={ plate }>
                            <div class={ () => (plate.seat === viewer ? 'table-hand bg-plate bg-plate-out' : 'table-top bg-plate bg-plate-out') }>
                                <TablePlate
                                    who={ whoAt(plate.seat) }
                                    name={ nameOf(plate.seat) }
                                    turn={ !over && view!.turn === plate.seat }
                                    remainingMs={ game.remainingMs }
                                    turnMs={ props.turnMs }
                                    tag={ plateTag(locale, game.players.find((one) => one.seat === plate.seat), over)?.text }
                                    tone={ plateTag(locale, game.players.find((one) => one.seat === plate.seat), over)?.tone }
                                    bubble={ props.speech?.[whoAt(plate.seat)] }
                                    below={ plate.seat !== viewer }
                                    anchor={ plate.seat === viewer ? 'end' : 'start' }
                                    marker={ <span class={ () => (plate.tone === 'light' ? 'bg-checker bg-checker-light' : 'bg-checker bg-checker-dark') } aria-hidden="true"></span> }
                                    facts={
                                        <span class="contents">
                                            <span>{ locale.t('backgammon.score', { score: locale.n(plate.row?.score ?? 0), target: locale.n(view!.target) }) }</span>
                                            <span>{ locale.plural('backgammon.pips', plate.row?.pips ?? 0) }</span>
                                        </span>
                                    }
                                />
                            </div>
                        </For>

                        <div class="table-fit">
                            <div class="table-surface bg-board">
                                <div class="relative h-full [direction:ltr]">
                                    <svg
                                        viewBox={ `0 0 ${ WIDTH } ${ HEIGHT }` }
                                        class={ () => [ 'block h-full w-full select-none touch-manipulation rounded-panel', staging ? 'cursor-pointer' : '' ].filter(Boolean).join(' ') }
                                        aria-hidden="true"
                                        onPointerUp={ tap }
                                    >
                                        <rect x="0" y="0" width={ WIDTH } height={ HEIGHT } rx="22" fill="var(--nard-frame)" />
                                        <rect x={ FIELD_LEFT } y={ TOP } width={ FIELD_RIGHT - FIELD_LEFT } height={ BOTTOM - TOP } rx="6" fill="var(--nard-field)" />
                                        <rect x={ BAR_LEFT } y={ TOP - 6 } width={ BAR_WIDTH } height={ BOTTOM - TOP + 12 } fill="var(--nard-frame)" />
                                        <rect
                                            x={ TRAY_LEFT }
                                            y={ TOP }
                                            width={ TRAY }
                                            height={ BOTTOM - TOP }
                                            rx="8"
                                            fill="var(--nard-tray)"
                                            stroke={ trayLit ? 'var(--accent)' : 'none' }
                                            stroke-width="6"
                                        />
                                        <line x1={ TRAY_LEFT + 8 } y1={ MIDDLE } x2={ TRAY_LEFT + TRAY - 8 } y2={ MIDDLE } stroke="var(--nard-frame)" stroke-width="4" />

                                        <For each={ [...SPIKES] } key={ (spike) => spike.point } let={ spike }>
                                            <g>
                                                <polygon points={ spike.path } fill={ spike.shade === 'a' ? 'var(--nard-point-a)' : 'var(--nard-point-b)' } />
                                            </g>
                                        </For>

                                        <rect x={ FRAME / 2 } y={ FRAME / 2 } width={ WIDTH - FRAME } height={ HEIGHT - FRAME } rx="16" fill="none" stroke="var(--nard-inlay)" stroke-width="3" />
                                    </svg>

                                    <div class="bg-layer" aria-hidden="true" ref={ (element) => layer = element }></div>

                                    <Show when={ diceTold }>
                                        { () =>
                                            <span class="sr-only" role="img" aria-label={ diceSaid }></span>
                                        }
                                    </Show>

                                </div>

                                <div class="sr-only">
                                    <p>{ stacksSaid(viewer) }</p>
                                    <p>{ stacksSaid(1 - viewer) }</p>
                                </div>
                            </div>

                            <For each={ plates } key={ (plate) => plate.seat } let={ plate }>
                                <div class="bg-plate bg-plate-in" data-me={ plate.seat === viewer ? 'true' : undefined }>
                                    <TablePlate
                                        who={ whoAt(plate.seat) }
                                        name={ nameOf(plate.seat) }
                                        turn={ !over && view!.turn === plate.seat }
                                        remainingMs={ game.remainingMs }
                                        turnMs={ props.turnMs }
                                        tag={ plateTag(locale, game.players.find((one) => one.seat === plate.seat), over)?.text }
                                        tone={ plateTag(locale, game.players.find((one) => one.seat === plate.seat), over)?.tone }
                                        bubble={ props.speech?.[whoAt(plate.seat)] }
                                        below={ plate.seat !== viewer }
                                        anchor={ plate.seat === viewer ? 'end' : 'start' }
                                        marker={ <span class={ () => (plate.tone === 'light' ? 'bg-checker bg-checker-light' : 'bg-checker bg-checker-dark') } aria-hidden="true"></span> }
                                        facts={
                                            <span class="contents">
                                                <span>{ locale.t('backgammon.score', { score: locale.n(plate.row?.score ?? 0), target: locale.n(view!.target) }) }</span>
                                                <span>{ locale.plural('backgammon.pips', plate.row?.pips ?? 0) }</span>
                                            </span>
                                        }
                                    />
                                </div>
                            </For>
                        </div>
                    </span>
                }
            </Show>

            <Show when={ barOpen }>
                { () =>
                    <section class="table-bar bg-bar">
                        <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
                            <p class="min-w-0 flex-[1_1_8rem] text-ui-base font-semibold text-text" aria-live="polite">{ says }</p>
                            <TurnClock remainingMs={ game.remainingMs } over={ over } yours={ myTurn } />
                        </div>

                        <p class="bg-info flex min-w-0 flex-wrap items-center gap-x-3 gap-y-0.5 text-ui-2xs text-muted">
                            <span>{ locale.t('backgammon.match', { target: locale.n(view!.target), round: locale.n(view!.round) }) }</span>
                            <Show when={ cubed }>
                                { () =>
                                    <span class="flex items-center gap-1">
                                        <Icon name="dice" size={ 12 } />
                                        { view!.owner === undefined
                                            ? locale.t('backgammon.cube.centre', { cube: locale.n(view!.cube) })
                                            : locale.t('backgammon.cube.owner', { cube: locale.n(view!.cube), name: nameOf(view!.owner) }) }
                                    </span>
                                }
                            </Show>
                            <Show when={ crawford }>
                                { () => <span class="font-semibold text-gold">{ locale.t('backgammon.crawford') }</span> }
                            </Show>
                        </p>

                        <CoachLine tip={ tip } />

                        <Show when={ rolling }>
                            { () =>
                                <div class="flex flex-wrap gap-2">
                                    <span class="glow-cta flex rounded-control">
                                        <Button variant="primary" size="lg" leading="dice" loading={ board.busy() } onClick={ () => void play('roll') }>
                                            { locale.t('backgammon.roll') }
                                        </Button>
                                    </span>
                                    <Show when={ mayDouble }>
                                        { () =>
                                            <Button variant="secondary" size="lg" disabled={ board.busy() } onClick={ () => void play('double') }>
                                                { locale.t('backgammon.double', { cube: locale.n(view!.cube * 2) }) }
                                            </Button>
                                        }
                                    </Show>
                                </div>
                            }
                        </Show>

                        <Show when={ answering }>
                            { () =>
                                <div class="flex flex-wrap gap-2">
                                    <Button variant="primary" size="lg" loading={ board.busy() } onClick={ () => void play('take') }>
                                        { locale.t('backgammon.take', { cube: locale.n(view!.cube * 2) }) }
                                    </Button>
                                    <Button variant="destructive" size="lg" disabled={ board.busy() } onClick={ () => void play('drop') }>
                                        { locale.t('backgammon.drop') }
                                    </Button>
                                </div>
                            }
                        </Show>

                        <Show when={ staging }>
                            { () =>
                                <div class="flex min-w-0 flex-col gap-2">
                                    <div class="flex min-w-0 gap-2">
                                        <IconButton icon="undo" label={ locale.t('backgammon.undo') } variant="secondary" disabled={ hops.length === 0 || board.busy() } onClick={ undo } />
                                        <span class={ () => [ 'flex min-w-0 flex-1 rounded-control', whole ? 'glow-cta' : '' ].filter(Boolean).join(' ') }>
                                            <Button
                                                variant="primary"
                                                size="md"
                                                block
                                                leading="selected"
                                                disabled={ !whole }
                                                loading={ board.busy() }
                                                onClick={ () => void submit() }
                                            >
                                                { locale.t('backgammon.play') }
                                            </Button>
                                        </span>
                                    </div>

                                    <Show when={ offered }>
                                        { () =>
                                            <div class="flex min-w-0 flex-col gap-1">
                                                <p class="bg-info text-ui-xs text-muted">{ locale.t('backgammon.pick') }</p>
                                                <Rail class="-mx-1" inner="px-1 py-0.5">
                                                    <ul class="flex shrink-0 gap-1.5" aria-label={ locale.t('backgammon.moves') }>
                                                        <For each={ options } key={ (hop) => `${ hop.from }/${ hop.to }` } let={ hop }>
                                                            <li class="flex shrink-0">
                                                                <button
                                                                    type="button"
                                                                    class={ () => [
                                                                        'inline-flex h-9 min-w-11 cursor-pointer items-center justify-center whitespace-nowrap rounded-control border px-2.5 text-ui-sm font-semibold transition-colors coarse:h-11 disabled:cursor-not-allowed disabled:opacity-50',
                                                                        chosen === hop.from ? 'border-accent bg-accent/15 text-text' : 'border-line-strong bg-raised text-text hover:border-accent'
                                                                    ].join(' ') }
                                                                    disabled={ board.busy() }
                                                                    aria-label={ hopSays(hop) }
                                                                    onClick={ () => add(hop) }
                                                                >
                                                                    { spotSays(hop.from) }
                                                                    <Icon name="chevron-right" size={ 14 } class="icon-flip mx-0.5 text-muted" />
                                                                    { spotSays(hop.to) }
                                                                    <Show when={ hits(outcomeAt(hop)) }>
                                                                        { () => <span class="ms-1.5 text-ui-2xs font-semibold text-gold">{ locale.t('helpers.backgammon.tag.hit') }</span> }
                                                                    </Show>
                                                                </button>
                                                            </li>
                                                        </For>
                                                    </ul>
                                                </Rail>
                                            </div>
                                        }
                                    </Show>
                                </div>
                            }
                        </Show>
                    </section>
                }
            </Show>
        </div>

        <Show when={ result }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } rematch={ props.rematch } />
            }
        </Show>
    </div>
}
