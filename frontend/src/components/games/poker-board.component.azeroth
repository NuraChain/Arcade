import { untrack } from 'azerothjs';

import CardFace from './card-face.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import PokerSeat from './poker-seat.component.azeroth';
import TableResult from './table-result.component.azeroth';
import { plateTag, type PlateTag } from './plate-tag.ts';
import Button from '../ui/button.component.azeroth';
import Slider from '../ui/slider.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { FACE_KEY, rankOf, suitOf } from '../../data/cards.ts';
import { seatBets, type Box } from '../../game/chip-spot.ts';
import { aroundStadium, type Spot } from '../../game/poker-seats.ts';
import { pokerOf } from '../../data/match.ts';
import { coachOf, handOf, pressed, priceOf, type PokerVerb } from '../../game/helpers/poker.ts';
import { EASE, centreOf, rectIn, type Rect } from '../../game/motion.ts';
import { BOARD_GAP, CARD_GAP, CHIP_FLY, DEAL_LEAD, DEAL_SLIDE, DISC_GAP, GATHER, GATHER_GAP, KNOCK, POT_SPAN, POT_WON, WIN_AFTER, slidesFor, spanOf } from '../../game/poker-beats.ts';
import { EMPTY, HISTORY, STILL, before, drawnOf, feltOf, flying, sameAs, step, swept, through, type Air, type Felt, type Told } from '../../game/poker-felt.ts';
import { createSound, type SoundHandle } from '../../game/sound.ts';
import { discsFor, pour } from '../../game/stage/chips.ts';
import type { Ctx } from '../../game/stage/director.ts';
import type { Act } from '../../game/stage/feed.ts';
import { createPresenter, type Presenter, type Sight, type Table } from '../../game/stage/presenter.ts';
import { createStage } from '../../game/stage/stage.ts';
import { useBoard, type EventBatch } from '../../stores/match.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { turnChime } from './table-cues.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';
import type { Rematch } from './boards.ts';

const BOARD_SLOTS = [0, 1, 2, 3, 4];

const POCKETS = [0, 1];

const CHIP_GAP = 4;

const ROUND = 1;

const PUCK_IN = 0.15;

const UNSEATED = {
    row: { seat: -1, stack: 0, bet: 0, folded: false, allIn: false, out: true },
    x: 50,
    y: 50,
    ux: 0,
    uy: 0,
    lies: 'flat' as Spot['lies'],
    live: false,
    tag: null as PlateTag | null
};

export default component PokerBoard(props: { match: MatchView; events: EventBatch; starting?: boolean; onAgain?: () => void; rematch?: Rematch; speech?: Record<string, string>; turnMs?: number; onPresenting?: (busy: boolean) => void })
{
    const locale = useLocale();
    const board = useBoard();
    const device = useDevice();
    const people = usePeople();

    state amount = 0;

    state raising = false;

    state shown: Felt | null = null;

    state presenting = false;

    derived game = props.match;

    derived view = pokerOf(game);

    derived over = game.finishedAt !== undefined;

    derived result = over && !presenting;

    derived mine = game.mine;

    derived viewer = mine ?? 0;

    derived felt = shown ?? (view === null ? EMPTY : feltOf(view, mine ?? null));

    derived count = view?.seats.length ?? game.seats;

    derived whoAt = (seat: number) => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number) =>
    {
        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const who = whoAt(seat);
        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived chips = (value: number) => locale.n(value);

    derived myTurn = view !== null && !over && mine !== undefined && view.turn === mine;

    const settings = useSettings();

    let sound: SoundHandle | null = null;

    const chime = turnChime(() => sound);

    effect
    {
        const yours = myTurn;

        untrack(() => chime(yours && props.match.mine !== undefined));
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => sound?.setEnabled(on));
    }

    let root: HTMLElement | null = null;
    let layer: HTMLElement | null = null;
    let presenter: Presenter<Told> | null = null;
    let held: Felt = EMPTY;
    let air: Air = STILL;
    let sent: { id: string; rev: number; move: Told } | null = null;

    state coming: readonly number[] = STILL.bets;

    state ratio = ROUND;

    let laying = 0;

    const feltNode = () => root?.querySelector<HTMLElement>('.poker-table') ?? null;

    const shape = () =>
    {
        const box = feltNode()?.getBoundingClientRect();
        const lying = box !== undefined && box.width > 0 && box.height > 0 ? Math.round((box.width / box.height) * 100) / 100 : null;

        if (lying === null || lying === untrack(() => ratio))
        {
            return false;
        }

        ratio = lying;

        return true;
    };

    const seatChips = () =>
    {
        laying = 0;

        const cloth = feltNode();

        if (cloth === null)
        {
            return;
        }

        if (shape())
        {
            reseat();
            return;
        }

        const table = cloth.getBoundingClientRect();
        const solid = (element: Element | null): Box[] =>
        {
            const box = element?.getBoundingClientRect();

            return box !== undefined && box.width > 0 && box.height > 0 ? [box] : [];
        };
        const reach = (element: Element): Box[] =>
        {
            const halo = getComputedStyle(element, '::before');
            const out = (side: string) => Math.max(0, -(parseFloat(side) || 0));

            return solid(element).map((box) => ({ left: box.left - out(halo.left), top: box.top - out(halo.top), right: box.right + out(halo.right), bottom: box.bottom + out(halo.bottom) }));
        };
        const joined = (boxes: readonly Box[]): Box => ({
            left: Math.min(...boxes.map((box) => box.left)),
            top: Math.min(...boxes.map((box) => box.top)),
            right: Math.max(...boxes.map((box) => box.right)),
            bottom: Math.max(...boxes.map((box) => box.bottom))
        });
        const atSeat = (seat: Element) => untrack(() => plateAt(Number(seat.getAttribute('data-seat'))));
        const puck = cloth.querySelector<HTMLElement>('.poker-puck');
        const dealer = puck === null ? null : cloth.querySelector(`.poker-seat[data-seat="${ puck.dataset.seat ?? '' }"]`);
        const [plate] = solid(dealer);

        if (puck !== null && dealer !== null && plate !== undefined)
        {
            const [face] = [...solid(dealer.querySelector('.table-plate-avatar')), plate];
            const size = puck.offsetWidth;
            const within = (wanted: number, from: number, to: number) => Math.min(Math.max(wanted, from), to - size);
            const inset = (face.bottom - face.top) * PUCK_IN;
            const across = within(face.right - inset - size / 2, plate.left, plate.right);
            const down = within((atSeat(dealer).y < 50 ? face.bottom - inset : face.top + inset) - size / 2, plate.top, plate.bottom);

            puck.style.translate = `${ (across - table.left).toFixed(1) }px ${ (down - table.top).toFixed(1) }px`;
            puck.dataset.placed = 'true';
        }

        const chips = [...cloth.querySelectorAll<HTMLElement>('.poker-seat > .poker-bet')];
        const spots = seatBets(
            chips.map((chip) =>
            {
                const seat = chip.parentElement!;
                const { ux, uy } = atSeat(seat);
                const cards = solid(seat.querySelector('.poker-backs'));

                return {
                    plate: joined([seat.getBoundingClientRect(), ...cards]),
                    width: chip.offsetWidth,
                    height: chip.offsetHeight,
                    toward: { x: ux, y: uy },
                    lead: cards[0]
                };
            }),
            table,
            [...cloth.querySelectorAll('.table-plate, .poker-backs')].flatMap(solid),
            [...cloth.querySelectorAll('.poker-centre > *, .poker-last > summary')].flatMap(reach),
            CHIP_GAP
        );

        chips.forEach((chip, index) =>
        {
            const spot = spots[index];

            chip.dataset.placed = 'true';

            if (spot === null)
            {
                chip.style.removeProperty('left');
                chip.style.removeProperty('top');
                chip.style.removeProperty('translate');
                return;
            }

            const from = chip.parentElement!.getBoundingClientRect();

            chip.style.left = `${ (spot.left - from.left).toFixed(1) }px`;
            chip.style.top = `${ (spot.top - from.top).toFixed(1) }px`;
            chip.style.translate = 'none';
        });
    };

    const reseat = () =>
    {
        if (laying === 0 && typeof requestAnimationFrame !== 'undefined')
        {
            laying = requestAnimationFrame(seatChips);
        }
    };

    const resized = () =>
    {
        shape();
        reseat();
    };

    const sending = () => (sent !== null && sent.id === game.id && sent.rev === game.rev ? sent : null);

    const sightNow = (): Sight<Felt> | null =>
    {
        if (view === null)
        {
            return null;
        }

        const now = feltOf(view, mine ?? null);
        const ahead = sending();

        return { id: game.id, rev: game.rev, seat: mine ?? null, view: ahead === null ? now : step(now, ahead.move) };
    };

    const show = () =>
    {
        shown = drawnOf(held, air);
        coming = air.bets;
    };

    const reset = (sight: Sight<Felt>) =>
    {
        layer?.replaceChildren();
        air = STILL;
        held = sameAs(held, sight.view) ? held : sight.view;
        show();
    };

    const find = (selector: string) => root?.querySelector<HTMLElement>(selector) ?? null;

    const boxOf = (element: Element | null) =>
    {
        const box = layer === null || element === null ? null : rectIn(layer, element);

        return box !== null && box.width > 0 && box.height > 0 ? box : null;
    };

    const plateOf = (seat: number) => find(`.poker-seat[data-seat="${ seat }"] .table-plate`);

    const spotOf = (seat: number) => boxOf(find(`.poker-seat[data-seat="${ seat }"] > .poker-bet > .chip-stack`));

    const potSpot = () => boxOf(find('.poker-pot > .chip-stack'));

    const discAt = (place: Rect, like: Rect): Rect =>
    {
        const middle = centreOf(place);

        return { x: middle.x - like.width / 2, y: middle.y - like.height / 2, width: like.width, height: like.height };
    };

    const stackAt = (felt: Felt, seat: number) => felt.chairs.find((chair) => chair.seat === seat)?.stack ?? 0;

    const lift = (seat: number, toBet: number, toStack: number) =>
    {
        air = flying(air, held.chairs.length, seat, toBet, toStack);
        show();
    };

    const pause = async (ms: number, ctx: Ctx) =>
    {
        await ctx.stage.wait(ms);

        return ctx.live();
    };

    const chipsIn = async (seat: number, next: Felt, heavy: boolean, ctx: Ctx) =>
    {
        const chips = stackAt(held, seat) - stackAt(next, seat);
        const from = boxOf(plateOf(seat));

        held = next;
        lift(seat, chips, 0);
        seatChips();

        const to = spotOf(seat);

        if (layer !== null && from !== null && to !== null && chips > 0)
        {
            await pour(ctx.stage, layer, from, to, { discs: discsFor(chips, held.blinds.big), duration: CHIP_FLY, gap: DISC_GAP, easing: EASE.fly }).done;
        }

        if (ctx.live())
        {
            lift(seat, 0 - chips, 0);
            sound?.play(heavy ? 'chips-stack' : 'chip-lay');
        }
    };

    const chipsBack = async (seat: number, next: Felt, ctx: Ctx) =>
    {
        const chips = stackAt(next, seat) - stackAt(held, seat);
        const from = spotOf(seat) ?? potSpot();
        const plate = boxOf(plateOf(seat));

        held = next;
        lift(seat, 0, chips);

        if (layer !== null && from !== null && plate !== null && chips > 0)
        {
            await pour(ctx.stage, layer, from, discAt(plate, from), { discs: discsFor(chips, held.blinds.big), duration: CHIP_FLY, gap: DISC_GAP, easing: EASE.fly }).done;
        }

        if (ctx.live())
        {
            lift(seat, 0, 0 - chips);
        }
    };

    const gather = async (ctx: Ctx) =>
    {
        const to = potSpot();
        const piles = held.chairs.filter((chair) => chair.bet > 0).map((chair) => ({ from: spotOf(chair.seat), discs: discsFor(chair.bet, held.blinds.big) }));
        const over = layer;

        if (piles.length === 0)
        {
            return;
        }

        held = swept(held);
        show();

        if (over !== null && to !== null)
        {
            await Promise.all(piles.flatMap((pile, at) => (pile.from === null
                ? []
                : [pour(ctx.stage, over, pile.from, to, { discs: pile.discs, duration: GATHER, gap: DISC_GAP, easing: EASE.gather, delay: at * GATHER_GAP }).done])));
        }
    };

    const knock = async (seat: number, ctx: Ctx) =>
    {
        const plate = plateOf(seat);

        sound?.play('tick');

        if (plate !== null)
        {
            await ctx.stage.animate(plate, [{ translate: '0 0' }, { translate: '0 0.2rem', offset: 0.35 }, { translate: '0 0' }], { duration: KNOCK, quiet: 'skip' }).done;
        }
    };

    const scene = async (move: Told, next: Felt, ctx: Ctx) =>
    {
        const seat = move.seat ?? -1;
        const mineToo = seat === mine;

        if (move.e === 'blind' || move.e === 'call' || move.e === 'raise' || move.e === 'allin')
        {
            await chipsIn(seat, next, move.e === 'allin', ctx);

            return;
        }

        if (move.e === 'refund')
        {
            await chipsBack(seat, next, ctx);

            return;
        }

        if (move.e === 'board' || move.e === 'show' || move.e === 'pot')
        {
            await gather(ctx);

            if (!ctx.live())
            {
                return;
            }
        }

        held = next;
        show();

        if (move.e === 'check')
        {
            await knock(seat, ctx);
        }
        else if (move.e === 'deal')
        {
            const slides = slidesFor(held.chairs.length);

            sound?.play('card-shuffle', { gain: 0.6 });

            for (let card = 0; card < slides; card += 1)
            {
                ctx.stage.after(DEAL_LEAD + card * DEAL_SLIDE, () => sound?.play('card-slide', { gain: 0.7, rate: 0.97 + (card % 3) * 0.04 }));
            }

            await pause(DEAL_LEAD + slides * DEAL_SLIDE, ctx);
        }
        else if (move.e === 'fold')
        {
            sound?.play('card-gather', { gain: 0.6 });
            await pause(CARD_GAP, ctx);
        }
        else if (move.e === 'board')
        {
            for (let card = 0; card < (move.cards?.length ?? 0); card += 1)
            {
                sound?.play('card-place');

                if (!await pause(BOARD_GAP, ctx))
                {
                    return;
                }
            }
        }
        else if (move.e === 'show')
        {
            sound?.play('card-fan', { gain: 0.6 });
            await pause(CARD_GAP, ctx);
        }
        else if (move.e === 'pot')
        {
            const won = mine !== undefined && (move.winners ?? []).includes(mine);

            sound?.play('chips-stack');

            if (won)
            {
                haptic('hand');
                ctx.stage.after(POT_WON, () => sound?.play('hand-won'));
            }

            await pause(POT_SPAN, ctx);
        }
        else if (move.e === 'bust' && mineToo)
        {
            sound?.play('pass');
            haptic('hit');
        }
        else if (move.e === 'finish' && mineToo)
        {
            if (await pause(WIN_AFTER, ctx))
            {
                sound?.play('win');
                haptic('win');
            }
        }
    };

    const play = async (acts: readonly Act<Told>[], sight: Sight<Felt>, ctx: Ctx) =>
    {
        const moves = acts.flatMap((act) => act.moves);

        await Promise.resolve();

        const tables = ctx.live() ? through(held, moves, sight.view) : [];

        for (const [at, move] of moves.slice(0, tables.length).entries())
        {
            await scene(move, tables[at], ctx);

            if (!ctx.live())
            {
                return;
            }
        }
    };

    const takeBack = async (ctx: Ctx) =>
    {
        const sight = sightNow();
        const seat = sight?.seat ?? -1;

        if (sight === null)
        {
            return;
        }

        if (stackAt(sight.view, seat) > stackAt(held, seat))
        {
            sound?.play('deny');
            await chipsBack(seat, sight.view, ctx);
        }

        if (ctx.live())
        {
            reset(sight);
        }
    };

    const mend = () =>
    {
        const sight = sightNow();

        if (presenter !== null && !presenter.presenting() && sight !== null)
        {
            reset(sight);
        }
    };

    const staging: Table<Felt, Told> = {
        kind: 'poker',
        history: HISTORY,
        before: (sight) => ({ ...sight, view: before(sight.view) }),
        reset,
        same: (sight) => sameAs(held, sight.view),
        settle: reset,
        play,
        estimate: (acts) => spanOf(acts.flatMap((act) => act.moves), untrack(() => count))
    };

    effect
    {
        const batch = props.events;

        void game.id;
        void game.rev;

        untrack(() =>
        {
            presenter?.see(batch);
            mend();
        });
    }

    mount
    {
        const watcher = typeof ResizeObserver === 'undefined' || root === null ? null : new ResizeObserver(resized);
        const cloth = feltNode();
        const clock = runtime().clock;
        const report = (error: unknown) => console.error(error);
        sound = createSound(untrack(() => settings.settings().sound));

        const made = createPresenter<Felt, Told>({
            stage: createStage({ clock, quiet: () => device.reducedMotion(), report }),
            clock,
            table: staging,
            sight: () => untrack(sightNow),
            report
        });
        const unwatch = made.watch((busy) =>
        {
            presenting = busy;
            props.onPresenting?.(busy);

            if (!busy)
            {
                untrack(mend);
            }
        });

        presenter = made;
        untrack(() => made.see(props.events));
        shape();

        if (watcher !== null && root !== null)
        {
            watcher.observe(root);
        }

        if (watcher !== null && cloth !== null)
        {
            watcher.observe(cloth);
        }

        void document.fonts?.ready.then(reseat);

        return () =>
        {
            watcher?.disconnect();

            if (laying !== 0)
            {
                cancelAnimationFrame(laying);
            }

            unwatch();
            props.onPresenting?.(false);
            made.dispose();
            presenter = null;
            sound?.dispose();
            sound = null;
        };
    }

    derived toCall = view?.toCall ?? 0;

    derived canRaise = myTurn && view?.minRaiseTo !== undefined && view?.maxRaiseTo !== undefined;

    derived low = view?.minRaiseTo ?? 0;

    derived high = view?.maxRaiseTo ?? 0;

    derived highest = view === null ? 0 : Math.max(0, ...view.seats.map((row) => row.bet));

    derived myRow = view?.seats.find((row) => row.seat === viewer);

    derived myChair = felt.chairs.find((chair) => chair.seat === viewer);

    derived tip = view === null || over ? null : coachOf(view, mine);

    derived captioned = settings.settings().hintOutcome;

    derived holding = captioned && mine !== undefined ? handOf(felt) : null;

    derived price = view === null || over || !captioned ? null : priceOf(view, mine);

    derived handNamed = ((): string =>
    {
        const hand = holding;

        if (hand === null)
        {
            return '';
        }

        return locale.t(`helpers.poker.hand.${ hand.category }` as never, {
            top: locale.t(`helpers.poker.rank.one.${ hand.top }` as never),
            tops: locale.t(`helpers.poker.rank.many.${ hand.top }` as never),
            seconds: hand.second === null ? '' : locale.t(`helpers.poker.rank.many.${ hand.second }` as never)
        });
    })();

    derived onBoard = holding?.board === true;

    derived handSays = handNamed === '' ? '' : locale.t(onBoard ? 'helpers.poker.board' : 'helpers.poker.best', { hand: handNamed });

    derived handBrief = onBoard ? locale.t('helpers.poker.board.brief', { hand: handNamed }) : handNamed;

    derived costSays = price === null ? '' : locale.t('helpers.poker.cost', { chips: chips(price.chips), pot: chips(price.pot) });

    derived answered = `${ game.id } ${ game.rev }`;

    effect
    {
        const floor = low;

        void answered;

        amount = floor;
        raising = false;
    }

    derived chosen = Math.min(high, Math.max(low, amount));

    derived potSized = (share: number) =>
    {
        const target = highest + Math.round(((view?.pot ?? 0) + toCall) * share);

        return Math.min(high, Math.max(low, target));
    };

    derived turnSeat = view?.turn;

    derived button = felt.button;

    derived stateOf = (row: { seat: number; out: boolean; folded: boolean; allIn: boolean }): PlateTag | null =>
    {
        if (row.out)
        {
            return { text: locale.t('poker.out'), tone: 'neutral' };
        }

        if (row.allIn)
        {
            return { text: locale.t('poker.allIn'), tone: 'madder' };
        }

        if (row.folded)
        {
            return { text: locale.t('poker.folded'), tone: 'neutral' };
        }

        const player = game.players.find((one) => one.seat === row.seat);

        if (player === undefined || !over || result)
        {
            return plateTag(locale, player, over);
        }

        const { result: _unshown, ...plain } = player;

        return plateTag(locale, plain, over);
    };

    derived ring = aroundStadium(count, ratio);

    derived plates = new Map(felt.chairs.map((row): [number, typeof UNSEATED] =>
    {
        const spot = ring[(row.seat - viewer + count) % count] ?? UNSEATED;

        return [row.seat, {
            row,
            x: spot.x,
            y: spot.y,
            ux: spot.ux,
            uy: spot.uy,
            lies: spot.lies,
            live: !row.folded && !row.out,
            tag: stateOf(row)
        }];
    }));

    derived chairs = [...plates.keys()];

    const plateAt = (seat: number) => plates.get(seat) ?? UNSEATED;

    derived betOn = (seat: number) =>
    {
        const lying = plateAt(seat).row.bet;

        return lying > 0 ? lying : (coming[seat] ?? 0);
    };

    const placed = (seat: number) =>
    {
        const { x, y, ux, uy } = plateAt(seat);

        return `--x: ${ x.toFixed(2) }; --y: ${ y.toFixed(2) }; --ux: ${ ux.toFixed(3) }; --uy: ${ uy.toFixed(3) }`;
    };

    effect
    {
        void plates;

        untrack(reseat);
    }

    derived seated = view !== null;

    derived playing = !over;

    derived blindsSay = view === null ? '' : `${ chips(felt.blinds.small) }/${ chips(felt.blinds.big) }`;

    derived streetSays = locale.t(`poker.street.${ felt.street }` as never);

    derived blindsTold = view === null
        ? ''
        : `${ locale.t('poker.blinds') }, ${ streetSays }, ${ locale.plural('poker.next', felt.blinds.next) }, ${ locale.t('poker.hand', { n: locale.n(felt.hand) }) }, ${ locale.t('poker.level', { level: locale.n(felt.blinds.level) }) }`;

    derived slots = BOARD_SLOTS.map((slot) => ({ slot, cards: felt.board.slice(slot, slot + 1) }));

    derived potSays = locale.t('poker.pot', { chips: chips(felt.pot) });

    derived potDiscs = discsFor(felt.pot, felt.blinds.big);

    derived layers = felt.pots;

    derived sided = layers.length > 1;

    derived potsSay = locale.list(layers.map((pot, index) => locale.t(index === 0 ? 'poker.main' : 'poker.side', { chips: chips(pot.amount) })));

    derived lastKnown = felt.last !== null;

    derived lastShown = felt.last === null ? [] : felt.last.shown.map((row) => ({ ...row, cards: [...row.cards] }));

    derived lastTabled = lastShown.length > 0;

    derived pockets = POCKETS.map((slot) => ({ slot, cards: felt.hole.slice(slot, slot + 1) }));

    derived handed = view !== null && !result && mine !== undefined && myChair !== undefined && !myChair.out;

    derived opening = highest === 0;

    derived raiseSays = chosen >= high
        ? locale.t('poker.allin', { chips: chips(high) })
        : (opening ? locale.t('poker.betTo', { chips: chips(chosen) }) : locale.t('poker.raiseTo', { chips: chips(chosen) }));

    const rankSays = (card: number) =>
    {
        const rank = rankOf(card);

        return FACE_KEY[rank] === undefined ? locale.n(Number(rank)) : locale.t(FACE_KEY[rank]);
    };

    const cardSays = (card: number) =>
        locale.t('hokm.card', { rank: rankSays(card), suit: locale.t(`hokm.suit.${ suitOf(card) }` as never) });

    const cardsSay = (cards: readonly number[]) => locale.list(cards.map(cardSays));

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (mine !== undefined && myChair?.out === true)
        {
            return locale.t('poker.turn.out');
        }

        if (myTurn)
        {
            return toCall === 0 ? locale.t('poker.turn.check') : locale.t('poker.turn.call', { chips: chips(toCall) });
        }

        return view.turn === undefined ? '' : locale.t('match.turn.theirs', { name: nameOf(view.turn) });
    })();

    derived lastSays = ((): string[] =>
    {
        const last = felt.last;

        if (last === null)
        {
            return [];
        }

        return last.pots.map((pot) =>
        {
            const names = locale.list(pot.winners.map(nameOf));
            const shown = last.shown.find((row) => pot.winners.includes(row.seat));

            return shown === undefined
                ? locale.t('poker.last.won', { name: names, chips: chips(pot.amount) })
                : locale.t('poker.last.with', { name: names, chips: chips(pot.amount), category: locale.t(`poker.category.${ shown.category }` as never) });
        });
    })();

    const unsend = (id: string, rev: number) =>
    {
        if (sent === null || sent.id !== id || sent.rev !== rev)
        {
            return;
        }

        sent = null;
        presenter?.predict(null);
        presenter?.act((ctx) => takeBack(ctx));
    };

    const send = async (verb: PokerVerb, amount?: number) =>
    {
        const current = untrack(() => view);
        const seat = untrack(() => mine);
        const id = untrack(() => game.id);
        const rev = untrack(() => game.rev);

        if (current !== null && seat !== undefined && presenter !== null && !untrack(board.busy))
        {
            const move = pressed(current, seat, verb, amount);

            sent = { id, rev, move };
            presenter.predict({ rev, covers: (moves) => (moves[0]?.e === move.e && moves[0].seat === seat && moves[0].amount === move.amount ? 1 : null) });
            presenter.act((ctx) => scene(move, step(held, move), ctx), spanOf([move], untrack(() => count)));
        }

        const outcome = await board.play(verb === 'raise' ? { kind: 'poker', verb, amount: amount ?? 0 } : { kind: 'poker', verb });

        if (outcome === 'stale' || outcome === 'failed')
        {
            unsend(id, rev);
        }
    };

    const act = async (verb: 'fold' | 'check' | 'call' | 'allin') =>
    {
        haptic('select');
        raising = false;
        await send(verb);
    };

    derived owing = toCall > 0;

    derived priced = myTurn && costSays !== '';

    derived choosing = raising && canRaise;

    derived ranged = low < high;

    derived raisable = canRaise && ranged;

    derived shoving = canRaise && !ranged;

    derived named = handSays !== '';

    derived callSays = toCall >= (myRow?.stack ?? 0)
        ? locale.t('poker.callAllIn', { chips: chips(myRow?.stack ?? 0) })
        : locale.t('poker.call', { chips: chips(toCall) });

    const letGo = (event: PointerEvent) =>
    {
        const on = event.target instanceof Element ? event.target : null;
        const last = root?.querySelector<HTMLDetailsElement>('.poker-last') ?? null;

        if (last !== null && last.open && on?.closest('.poker-last') == null)
        {
            last.open = false;
        }
    };

    mount
    {
        document.addEventListener('pointerdown', letGo, true);

        return () => document.removeEventListener('pointerdown', letGo, true);
    }

    const openRaise = () =>
    {
        raising = !raising;
    };

    const raise = async () =>
    {
        haptic('select');
        raising = false;

        await (chosen >= high ? send('allin') : send('raise', chosen));
    };

    <div data-rev={ props.match.rev } data-presenting={ presenting ? 'true' : undefined } class="table-stage poker-stage" ref={ (element) => root = element }>
        <div class="table-grid poker-grid">
            <Show when={ seated }>
                { () =>
                    <div class="table-fit">
                        <div class="table-surface poker-table" role="group" aria-label={ locale.t('poker.table') } data-seats={ count }>
                            <div class="poker-centre">
                                <ul class="poker-board" aria-label={ locale.t('poker.board') }>
                                    <For each={ slots } key={ (one) => one.slot } let={ one }>
                                        <li class="poker-slot">
                                            <For each={ one.cards } key={ (card) => card } let={ card }>
                                                <span class="flex" role="img" aria-label={ cardSays(card) }>
                                                    <CardFace card={ card } />
                                                </span>
                                            </For>
                                        </li>
                                    </For>
                                </ul>
                                <div class="poker-tally">
                                    <details class="poker-last" dir={ locale.dir() }>
                                        <summary>
                                            <Icon name="history" size={ 13 } />
                                            <span class="sr-only">{ locale.t('poker.last') }</span>
                                        </summary>
                                        <div class="poker-last-panel">
                                            <Show
                                                when={ lastKnown }
                                                fallback={ <p class="text-ui-xs text-muted">{ locale.t('poker.last.none') }</p> }
                                            >
                                                { () =>
                                                    <div class="flex flex-col gap-2">
                                                        <For each={ lastSays } key={ (line, index) => `${ index }-${ line }` } let={ line }>
                                                            <p class="text-ui-xs font-semibold text-text">{ line }</p>
                                                        </For>
                                                        <Show when={ lastTabled }>
                                                            { () =>
                                                                <ul class="flex flex-col gap-1.5 [--card-w:1.9rem]">
                                                                    <For each={ lastShown } key={ (row) => row.seat } let={ row }>
                                                                        <li class="flex min-w-0 items-center gap-2">
                                                                            <span class="flex gap-0.5" role="img" aria-label={ cardsSay(row.cards) }>
                                                                                <For each={ row.cards } key={ (card) => card } let={ card }>
                                                                                    <span class="flex">
                                                                                        <CardFace card={ card } />
                                                                                    </span>
                                                                                </For>
                                                                            </span>
                                                                            <span class="min-w-0 truncate text-ui-2xs text-muted" dir="auto">{ nameOf(row.seat) }</span>
                                                                            <span class="ms-auto shrink-0 text-ui-2xs font-semibold text-text">{ locale.t(`poker.category.${ row.category }` as never) }</span>
                                                                        </li>
                                                                    </For>
                                                                </ul>
                                                            }
                                                        </Show>
                                                    </div>
                                                }
                                            </Show>
                                        </div>
                                    </details>
                                    <p class="poker-pot">
                                        <span class="chip-stack" data-chips={ potDiscs } aria-hidden="true"></span>
                                        <span>{ potSays }</span>
                                    </p>
                                    <p class="poker-blinds">
                                        <span class="tally" aria-hidden="true">{ blindsSay }</span>
                                        <span class="sr-only">{ blindsTold }</span>
                                    </p>
                                </div>
                                <Show when={ sided }>
                                    { () => <p class="poker-pots">{ potsSay }</p> }
                                </Show>
                            </div>

                            <For each={ chairs } key={ (seat) => seat } let={ seat }>
                                <div class="poker-seat" data-seat={ seat } data-lies={ plateAt(seat).lies } style={ placed(seat) }>
                                    <PokerSeat
                                        who={ whoAt(seat) }
                                        name={ nameOf(seat) }
                                        turn={ !over && turnSeat === seat }
                                        own={ seat === mine }
                                        remainingMs={ game.remainingMs }
                                        turnMs={ props.turnMs }
                                        dim={ !plateAt(seat).live }
                                        tag={ plateAt(seat).tag?.text }
                                        tone={ plateAt(seat).tag?.tone }
                                        bubble={ props.speech?.[whoAt(seat)] }
                                        below={ plateAt(seat).y < 50 }
                                        anchor={ plateAt(seat).x > 60 ? 'end' : (plateAt(seat).x < 40 ? 'start' : 'centre') }
                                        button={ button === seat }
                                        stack={ chips(plateAt(seat).row.stack) }
                                        holds={ plateAt(seat).live && seat !== mine }
                                        bet={ betOn(seat) > 0 ? chips(betOn(seat)) : '' }
                                        discs={ discsFor(betOn(seat), felt.blinds.big) }
                                        landing={ plateAt(seat).row.bet === 0 }
                                    />
                                </div>
                            </For>

                            <span class="poker-puck" data-seat={ button } aria-hidden="true">D</span>
                        </div>

                        <Show when={ playing }>
                            { () => <p class="sr-only" aria-live="polite">{ says }</p> }
                        </Show>
                        <Show when={ priced }>
                            { () => <p class="poker-cost sr-only">{ costSays }</p> }
                        </Show>
                    </div>
                }
            </Show>

            <Show when={ handed }>
                { () =>
                    <div class="table-hand poker-hand">
                        <Show when={ choosing }>
                            { () =>
                                <div class="poker-raise">
                                    <Show when={ ranged }>
                                        { () =>
                                            <div class="flex flex-col gap-2">
                                                <Slider
                                                    value={ chosen }
                                                    min={ low }
                                                    max={ high }
                                                    step={ 1 }
                                                    label={ locale.t('poker.raise.label') }
                                                    valueText={ chips(chosen) }
                                                    onChange={ (value) => amount = Math.round(value) }
                                                />
                                                <div class="flex flex-wrap gap-1.5">
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = low }>{ locale.t('poker.preset.min') }</Button>
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = potSized(0.5) }>{ locale.t('poker.preset.half') }</Button>
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = potSized(1) }>{ locale.t('poker.preset.pot') }</Button>
                                                </div>
                                            </div>
                                        }
                                    </Show>
                                    <Button variant={ chosen >= high ? 'secondary' : 'primary' } size="lg" block disabled={ board.busy() } onClick={ () => void raise() }>
                                        { raiseSays }
                                    </Button>
                                </div>
                            }
                        </Show>

                        <div class="poker-own">
                            <Show when={ named }>
                                { () => <p class="sr-only">{ handSays }</p> }
                            </Show>
                            <Show when={ captioned }>
                                { () => <p class="poker-hand-name" aria-hidden="true">{ handBrief }</p> }
                            </Show>

                            <ul class="poker-hole" aria-label={ locale.t('poker.hole') }>
                                <For each={ pockets } key={ (one) => one.slot } let={ one }>
                                    <li class="poker-pocket">
                                        <For each={ one.cards } key={ (card) => card } let={ card }>
                                            <span class="flex" role="img" aria-label={ cardSays(card) }>
                                                <CardFace card={ card } />
                                            </span>
                                        </For>
                                    </li>
                                </For>
                            </ul>
                        </div>

                        <div class="poker-side">
                            <Show when={ myTurn }>
                                { () =>
                                    <div class="poker-acts">
                                        <Show when={ owing }>
                                            { () =>
                                                <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void act('fold') }>
                                                    <span class="poker-muck" aria-hidden="true">
                                                        <span class="card-back"></span>
                                                        <span class="card-back"></span>
                                                    </span>
                                                    <span class="poker-thing-says">{ locale.t('poker.fold') }</span>
                                                </button>
                                            }
                                        </Show>
                                        <Show
                                            when={ owing }
                                            fallback={
                                                <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void act('check') }>
                                                    <span class="poker-disc" data-act="check" aria-hidden="true"><Icon name="hand" size={ 18 } /></span>
                                                    <span class="poker-thing-says">{ locale.t('poker.check') }</span>
                                                </button>
                                            }
                                        >
                                            { () =>
                                                <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void act('call') }>
                                                    <span class="poker-disc" data-act="call" aria-hidden="true"></span>
                                                    <span class="poker-thing-says">{ callSays }</span>
                                                </button>
                                            }
                                        </Show>
                                        <Show when={ raisable }>
                                            { () =>
                                                <button type="button" class="poker-thing" aria-pressed={ raising } disabled={ board.busy() } onClick={ openRaise }>
                                                    <span class="poker-disc" data-act="raise" aria-hidden="true"><Icon name="add" size={ 18 } /></span>
                                                    <span class="poker-thing-says">{ opening ? locale.t('poker.bet') : locale.t('poker.raise') }</span>
                                                </button>
                                            }
                                        </Show>
                                        <Show when={ shoving }>
                                            { () =>
                                                <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void raise() }>
                                                    <span class="poker-disc" data-act="allin" aria-hidden="true"></span>
                                                    <span class="poker-thing-says">{ locale.t('poker.allin', { chips: chips(high) }) }</span>
                                                </button>
                                            }
                                        </Show>
                                    </div>
                                }
                            </Show>

                            <CoachLine tip={ tip } lamp />
                        </div>
                    </div>
                }
            </Show>
        </div>

        <Show when={ result }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } rematch={ props.rematch } />
            }
        </Show>

        <div class="board-flight" aria-hidden="true" inert ref={ (element) => layer = element }></div>
    </div>
}
