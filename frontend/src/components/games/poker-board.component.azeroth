import { untrack } from 'azerothjs';

import CardFace from './card-face.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import PokerSeat from './poker-seat.component.azeroth';
import TableResult from './table-result.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import { plateTag, type PlateTag } from './plate-tag.ts';
import Button from '../ui/button.component.azeroth';
import Slider from '../ui/slider.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { FACE_KEY, rankOf, suitOf } from '../../data/cards.ts';
import { seatBets, type Box } from '../../game/chip-spot.ts';
import { pokerOf, type PokerBoard } from '../../data/match.ts';
import { coachOf, outcomeOf, predicted, type PokerVerb } from '../../game/helpers/poker.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { haptic } from '../../lib/haptics.ts';
import { pokerBeats, tableCues } from './table-cues.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';
import type { Rematch } from './boards.ts';

const RADIUS_X = 41;

const RADIUS_Y = 40;

const BOARD_SLOTS = [0, 1, 2, 3, 4];

const CHIP_GAP = 4;

const SHORT_FELT_REM = 16;

const NO_CARDS: number[] = [];

const NO_ROWS: PokerBoard['seats'] = [];

const NO_POTS: PokerBoard['pots'] = [];

const NO_HANDS: NonNullable<PokerBoard['last']>['shown'] = [];

const UNSEATED = {
    row: { seat: -1, stack: 0, bet: 0, folded: false, allIn: false, out: true },
    x: 50,
    y: 50,
    live: false,
    tag: null as PlateTag | null
};

export default component PokerBoard(props: { match: MatchView; starting?: boolean; onAgain?: () => void; rematch?: Rematch; speech?: Record<string, string>; turnMs?: number })
{
    const locale = useLocale();
    const board = useBoard();
    const people = usePeople();

    state amount = 0;

    state raising = false;

    state folding = false;

    derived game = props.match;

    derived view = pokerOf(game);

    derived over = game.finishedAt !== undefined;

    derived mine = game.mine;

    derived viewer = mine ?? 0;

    derived count = view?.seats.length ?? game.seats;

    derived whoAt = (seat: number) => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number) =>
    {
        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const who = whoAt(seat);
        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived chips = (value: number) => locale.n(value);

    derived myTurn = view !== null && !over && mine !== undefined && view.turn === mine;

    const settings = useSettings();

    const cues = tableCues({
        enabled: untrack(() => settings.settings().sound),
        seq: untrack(() => board.events().seq),
        match: untrack(() => ({ id: props.match.id, rev: props.match.rev })),
        beats: (events) => pokerBeats(events.flatMap((one) => (one.log.kind === 'poker' ? one.log.moves : [])), { mine: props.match.mine ?? null, seats: props.match.seats })
    });

    effect
    {
        const batch = board.events();

        untrack(() => cues.hear(batch, { id: props.match.id, rev: props.match.rev }));
    }

    effect
    {
        const yours = myTurn;

        untrack(() => cues.turn(yours && props.match.mine !== undefined));
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => cues.setEnabled(on));
    }

    let root: HTMLElement | null = null;

    state short = false;

    let laying = 0;

    const seatChips = () =>
    {
        laying = 0;

        const felt = root?.querySelector<HTMLElement>('.poker-table') ?? null;

        if (felt === null)
        {
            return;
        }

        const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
        const shallow = felt.getBoundingClientRect().height < SHORT_FELT_REM * rem;

        if (shallow !== short)
        {
            short = shallow;
            reseat();
            return;
        }

        const solid = (element: Element): Box[] =>
        {
            const box = element.getBoundingClientRect();

            return box.width > 0 && box.height > 0 ? [box] : [];
        };
        const reach = (element: Element): Box[] =>
        {
            const halo = getComputedStyle(element, '::before');
            const out = (side: string) => Math.max(0, -(parseFloat(side) || 0));

            return solid(element).map((box) => ({ left: box.left - out(halo.left), top: box.top - out(halo.top), right: box.right + out(halo.right), bottom: box.bottom + out(halo.bottom) }));
        };
        const chips = [...felt.querySelectorAll<HTMLElement>('.poker-seat > .poker-bet')];
        const spots = seatBets(
            chips.map((chip) => ({ plate: chip.parentElement!.getBoundingClientRect(), width: chip.offsetWidth, height: chip.offsetHeight })),
            felt.getBoundingClientRect(),
            [...felt.querySelectorAll('.table-plate')].flatMap(solid),
            [
                ...felt.querySelectorAll('.poker-centre > *, .poker-chips .poker-chip'),
                ...(root?.querySelectorAll('.table-corner > .poker-bar-facts, .table-corner > .table-corner-clock, .table-corner-tools > *') ?? [])
            ].flatMap(reach),
            CHIP_GAP
        );

        chips.forEach((chip, index) =>
        {
            const spot = spots[index];

            if (spot === null)
            {
                chip.style.removeProperty('left');
                chip.style.removeProperty('top');
                chip.style.removeProperty('translate');
                return;
            }

            const from = chip.parentElement!.getBoundingClientRect();

            chip.style.left = `${ (spot.left - from.left).toFixed(1) }px`;
            chip.style.top = `${ (spot.top - from.top).toFixed(1) }px`;
            chip.style.translate = 'none';
        });
    };

    const reseat = () =>
    {
        if (laying === 0 && typeof requestAnimationFrame !== 'undefined')
        {
            laying = requestAnimationFrame(seatChips);
        }
    };

    mount
    {
        const watcher = typeof ResizeObserver === 'undefined' || root === null ? null : new ResizeObserver(reseat);

        if (watcher !== null && root !== null)
        {
            watcher.observe(root);
        }

        void document.fonts?.ready.then(reseat);

        return () =>
        {
            watcher?.disconnect();

            if (laying !== 0)
            {
                cancelAnimationFrame(laying);
            }

            cues.dispose();
        };
    }

    derived toCall = view?.toCall ?? 0;

    derived canRaise = myTurn && view?.minRaiseTo !== undefined && view?.maxRaiseTo !== undefined;

    derived low = view?.minRaiseTo ?? 0;

    derived high = view?.maxRaiseTo ?? 0;

    derived highest = view === null ? 0 : Math.max(0, ...view.seats.map((row) => row.bet));

    derived myRow = view?.seats.find((row) => row.seat === viewer);

    derived tip = view === null || over ? null : coachOf(view, mine);

    derived outcome = view === null || over || !settings.settings().hintOutcome ? null : outcomeOf(view, mine);

    derived handSays = ((): string =>
    {
        const hand = outcome?.hand;

        if (hand == null)
        {
            return '';
        }

        const named = locale.t(`helpers.poker.hand.${ hand.category }` as never, {
            top: locale.t(`helpers.poker.rank.one.${ hand.top }` as never),
            tops: locale.t(`helpers.poker.rank.many.${ hand.top }` as never),
            seconds: hand.second === null ? '' : locale.t(`helpers.poker.rank.many.${ hand.second }` as never)
        });

        return locale.t(hand.board ? 'helpers.poker.board' : 'helpers.poker.best', { hand: named });
    })();

    derived costSays = (() =>
    {
        const call = outcome?.call;

        return call == null ? '' : locale.t('helpers.poker.cost', { chips: chips(call.chips), pot: chips(call.pot) });
    })();

    effect
    {
        const floor = low;
        const rev = game.rev;

        if (rev >= 0)
        {
            amount = floor;
            raising = false;
            folding = false;
        }
    }

    derived chosen = Math.min(high, Math.max(low, amount));

    derived potSized = (share: number) =>
    {
        const target = highest + Math.round(((view?.pot ?? 0) + toCall) * share);

        return Math.min(high, Math.max(low, target));
    };

    state ahead: { rev: number; view: NonNullable<typeof view> } | null = null;

    derived drawn = ahead !== null && ahead.rev === game.rev ? ahead.view : view;

    derived turnSeat = view?.turn;

    derived button = view?.button;

    derived stateOf = (row: { seat: number; out: boolean; folded: boolean; allIn: boolean }): PlateTag | null =>
    {
        if (row.out)
        {
            return { text: locale.t('poker.out'), tone: 'neutral' };
        }

        if (row.allIn)
        {
            return { text: locale.t('poker.allIn'), tone: 'madder' };
        }

        if (row.folded)
        {
            return { text: locale.t('poker.folded'), tone: 'neutral' };
        }

        return plateTag(locale, game.players.find((one) => one.seat === row.seat), over);
    };

    derived plates = new Map((drawn?.seats ?? NO_ROWS).map((row): [number, typeof UNSEATED] =>
    {
        const place = (row.seat - viewer + count) % count;
        const angle = Math.PI / 2 + (place / count) * Math.PI * 2;

        return [row.seat, {
            row,
            x: 50 + Math.cos(angle) * RADIUS_X,
            y: 50 + Math.sin(angle) * RADIUS_Y,
            live: !row.folded && !row.out,
            tag: stateOf(row)
        }];
    }));

    derived chairs = [...plates.keys()];

    const plateAt = (seat: number) => plates.get(seat) ?? UNSEATED;

    effect
    {
        void plates;

        untrack(reseat);
    }

    derived seated = view !== null;

    derived playing = !over;

    derived blindsSay = view === null ? '' : `${ chips(view.blinds.small) }/${ chips(view.blinds.big) }`;

    derived streetSays = locale.t(`poker.street.${ view?.street ?? 'preflop' }` as never);

    derived blindsTold = view === null
        ? ''
        : `${ locale.t('poker.blinds') }, ${ locale.plural('poker.next', view.blinds.next) }, ${ locale.t('poker.hand', { n: locale.n(view.hand) }) }, ${ locale.t('poker.level', { level: locale.n(view.blinds.level) }) }`;

    derived slots = BOARD_SLOTS.map((slot) => ({ slot, cards: (view?.board ?? NO_CARDS).slice(slot, slot + 1) }));

    derived potSays = locale.t('poker.pot', { chips: chips(view?.pot ?? 0) });

    derived layers = view?.pots ?? NO_POTS;

    derived sided = layers.length > 1;

    derived potsSay = locale.list(layers.map((pot, index) => locale.t(index === 0 ? 'poker.main' : 'poker.side', { chips: chips(pot.amount) })));

    derived lastKnown = view?.last !== undefined;

    derived lastShown = view?.last?.shown ?? NO_HANDS;

    derived lastTabled = lastShown.length > 0;

    derived hole = view?.hole ?? NO_CARDS;

    derived opening = highest === 0;

    derived raiseSays = chosen >= high
        ? locale.t('poker.allin', { chips: chips(high) })
        : (opening ? locale.t('poker.betTo', { chips: chips(chosen) }) : locale.t('poker.raiseTo', { chips: chips(chosen) }));

    const rankSays = (card: number) =>
    {
        const rank = rankOf(card);

        return FACE_KEY[rank] === undefined ? locale.n(Number(rank)) : locale.t(FACE_KEY[rank]);
    };

    const cardSays = (card: number) =>
        locale.t('hokm.card', { rank: rankSays(card), suit: locale.t(`hokm.suit.${ suitOf(card) }` as never) });

    const cardsSay = (cards: readonly number[]) => locale.list(cards.map(cardSays));

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (mine !== undefined && myRow?.out === true)
        {
            return locale.t('poker.turn.out');
        }

        if (myTurn)
        {
            return toCall === 0 ? locale.t('poker.turn.check') : locale.t('poker.turn.call', { chips: chips(toCall) });
        }

        return view.turn === undefined ? '' : locale.t('match.turn.theirs', { name: nameOf(view.turn) });
    })();

    derived lastSays = ((): string[] =>
    {
        const last = view?.last;

        if (last === undefined)
        {
            return [];
        }

        return last.pots.map((pot) =>
        {
            const names = locale.list(pot.winners.map(nameOf));
            const shown = last.shown.find((row) => pot.winners.includes(row.seat));

            return shown === undefined
                ? locale.t('poker.last.won', { name: names, chips: chips(pot.amount) })
                : locale.t('poker.last.with', { name: names, chips: chips(pot.amount), category: locale.t(`poker.category.${ shown.category }` as never) });
        });
    })();

    const send = async (verb: PokerVerb, amount?: number) =>
    {
        const current = untrack(() => view);
        const seat = untrack(() => mine);

        if (current !== null && seat !== undefined && !untrack(board.busy))
        {
            ahead = { rev: untrack(() => game.rev), view: predicted(current, seat, verb, amount) };
        }

        const outcome = await board.play(verb === 'raise' ? { kind: 'poker', verb, amount: amount ?? 0 } : { kind: 'poker', verb });

        if (outcome === 'stale' || outcome === 'failed')
        {
            ahead = null;
        }
    };

    const act = async (verb: 'fold' | 'check' | 'call' | 'allin') =>
    {
        haptic('select');
        folding = false;
        raising = false;
        await send(verb);
    };

    derived owing = toCall > 0;

    derived foldable = myTurn && owing;

    derived priced = myTurn && costSays !== '';

    derived choosing = raising && canRaise;

    derived ranged = low < high;

    derived raisable = canRaise && ranged;

    derived shoving = canRaise && !ranged;

    derived named = handSays !== '';

    derived holding = view !== null && !over && view.hole.length === 2;

    derived callSays = toCall >= (myRow?.stack ?? 0)
        ? locale.t('poker.callAllIn', { chips: chips(myRow?.stack ?? 0) })
        : locale.t('poker.call', { chips: chips(toCall) });

    const pressHole = () =>
    {
        if (!foldable || untrack(board.busy))
        {
            return;
        }

        if (folding)
        {
            void act('fold');
            return;
        }

        folding = true;
        raising = false;
        haptic('tick');
    };

    const letGo = (event: PointerEvent) =>
    {
        if (folding && !(event.target instanceof Element && event.target.closest('[data-armed]') !== null))
        {
            folding = false;
        }
    };

    mount
    {
        document.addEventListener('pointerdown', letGo, true);

        return () => document.removeEventListener('pointerdown', letGo, true);
    }

    const openRaise = () =>
    {
        folding = false;
        raising = !raising;
    };

    const raise = async () =>
    {
        haptic('select');
        raising = false;

        await (chosen >= high ? send('allin') : send('raise', chosen));
    };

    <div data-rev={ props.match.rev } data-felt={ short ? 'short' : undefined } class="table-stage poker-stage" ref={ (element) => root = element }>
        <div class="table-grid poker-grid">
            <Show when={ seated }>
                { () =>
                    <div class="table-fit">
                        <div class="table-surface poker-table" role="group" aria-label={ locale.t('poker.table') }>
                            <div class="poker-chips">
                                <span class="poker-chip">
                                    <Icon name="coins" size={ 12 } class="shrink-0 text-gold" />
                                    <span class="tally">{ blindsSay }</span>
                                    <span class="text-white/60">·</span>
                                    <span class="min-w-0 truncate">{ streetSays }</span>
                                    <span class="sr-only">{ blindsTold }</span>
                                </span>

                                <details class="poker-last">
                                    <summary class="poker-chip">
                                        <Icon name="history" size={ 12 } class="shrink-0 text-gold" />
                                        <span class="min-w-0 truncate">{ locale.t('poker.last') }</span>
                                    </summary>
                                    <div class="poker-last-panel" dir={ locale.dir() }>
                                        <Show
                                            when={ lastKnown }
                                            fallback={ <p class="text-ui-xs text-muted">{ locale.t('poker.last.none') }</p> }
                                        >
                                            { () =>
                                                <div class="flex flex-col gap-2">
                                                    <For each={ lastSays } key={ (line, index) => `${ index }-${ line }` } let={ line }>
                                                        <p class="text-ui-xs font-semibold text-text">{ line }</p>
                                                    </For>
                                                    <Show when={ lastTabled }>
                                                        { () =>
                                                            <ul class="flex flex-col gap-1.5 [--card-w:1.9rem]">
                                                                <For each={ lastShown } key={ (row) => row.seat } let={ row }>
                                                                    <li class="flex min-w-0 items-center gap-2">
                                                                        <span class="flex gap-0.5" role="img" aria-label={ cardsSay(row.cards) }>
                                                                            <For each={ row.cards } key={ (card) => card } let={ card }>
                                                                                <span class="flex">
                                                                                    <CardFace card={ card } />
                                                                                </span>
                                                                            </For>
                                                                        </span>
                                                                        <span class="min-w-0 truncate text-ui-2xs text-muted" dir="auto">{ nameOf(row.seat) }</span>
                                                                        <span class="ms-auto shrink-0 text-ui-2xs font-semibold text-text">{ locale.t(`poker.category.${ row.category }` as never) }</span>
                                                                    </li>
                                                                </For>
                                                            </ul>
                                                        }
                                                    </Show>
                                                </div>
                                            }
                                        </Show>
                                    </div>
                                </details>
                            </div>

                            <div class="poker-centre">
                                <ul class="poker-board" aria-label={ locale.t('poker.board') }>
                                    <For each={ slots } key={ (one) => one.slot } let={ one }>
                                        <li class="poker-slot">
                                            <For each={ one.cards } key={ (card) => card } let={ card }>
                                                <span class="flex" role="img" aria-label={ cardSays(card) }>
                                                    <CardFace card={ card } />
                                                </span>
                                            </For>
                                        </li>
                                    </For>
                                </ul>
                                <p class="flex items-center gap-1.5 rounded-full bg-black/35 px-3 py-1 text-ui-xs font-semibold text-white">
                                    <Icon name="coins" size={ 13 } class="text-gold" />
                                    <span>{ potSays }</span>
                                </p>
                                <Show when={ sided }>
                                    { () => <p class="text-ui-2xs text-white/70">{ potsSay }</p> }
                                </Show>
                            </div>

                            <For each={ chairs } key={ (seat) => seat } let={ seat }>
                                <div class="poker-seat" data-seat={ seat } style={ `--x: ${ plateAt(seat).x.toFixed(2) }; --y: ${ plateAt(seat).y.toFixed(2) }` }>
                                    <PokerSeat
                                        who={ whoAt(seat) }
                                        name={ nameOf(seat) }
                                        turn={ !over && turnSeat === seat }
                                        remainingMs={ game.remainingMs }
                                        turnMs={ props.turnMs }
                                        dim={ !plateAt(seat).live }
                                        tag={ plateAt(seat).tag?.text }
                                        tone={ plateAt(seat).tag?.tone }
                                        bubble={ props.speech?.[whoAt(seat)] }
                                        below={ plateAt(seat).y < 50 }
                                        anchor={ plateAt(seat).x > 60 ? 'end' : (plateAt(seat).x < 40 ? 'start' : 'centre') }
                                        button={ button === seat }
                                        stack={ chips(plateAt(seat).row.stack) }
                                        holds={ plateAt(seat).live && seat !== mine }
                                        bet={ plateAt(seat).row.bet > 0 ? chips(plateAt(seat).row.bet) : '' }
                                    />
                                </div>
                            </For>
                        </div>

                        <Show when={ playing }>
                            { () =>
                                <section class="table-bar table-corner poker-rail">
                                    <p class="sr-only" aria-live="polite">{ says }</p>
                                    <Show when={ priced }>
                                        { () => <p class="poker-cost sr-only">{ costSays }</p> }
                                    </Show>
                                    <span class="poker-bar-facts poker-chip" aria-hidden="true">
                                        <Icon name="coins" size={ 12 } class="shrink-0 text-gold" />
                                        <span class="tally">{ blindsSay }</span>
                                    </span>
                                    <TurnClock remainingMs={ game.remainingMs } over={ over } yours={ myTurn } class="table-corner-clock" brief />
                                    <div class="table-corner-tools">
                                        <CoachLine tip={ tip } lamp />
                                    </div>
                                </section>
                            }
                        </Show>
                    </div>
                }
            </Show>

            <Show when={ holding }>
                { () =>
                    <div class="table-hand poker-hand">
                        <Show when={ choosing }>
                            { () =>
                                <div class="poker-raise">
                                    <Show when={ ranged }>
                                        { () =>
                                            <div class="flex flex-col gap-2">
                                                <Slider
                                                    value={ chosen }
                                                    min={ low }
                                                    max={ high }
                                                    step={ 1 }
                                                    label={ locale.t('poker.raise.label') }
                                                    valueText={ chips(chosen) }
                                                    onChange={ (value) => amount = Math.round(value) }
                                                />
                                                <div class="flex flex-wrap gap-1.5">
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = low }>{ locale.t('poker.preset.min') }</Button>
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = potSized(0.5) }>{ locale.t('poker.preset.half') }</Button>
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = potSized(1) }>{ locale.t('poker.preset.pot') }</Button>
                                                </div>
                                            </div>
                                        }
                                    </Show>
                                    <Button variant={ chosen >= high ? 'secondary' : 'primary' } size="lg" block disabled={ board.busy() } onClick={ () => void raise() }>
                                        { raiseSays }
                                    </Button>
                                </div>
                            }
                        </Show>

                        <Show when={ named }>
                            { () => <p class="poker-hand-name">{ handSays }</p> }
                        </Show>

                        <Show
                            when={ foldable }
                            fallback={
                                <ul class="poker-hole" aria-label={ locale.t('poker.hole') }>
                                    <For each={ hole } key={ (card) => card } let={ card }>
                                        <li class="flex" role="img" aria-label={ cardSays(card) }>
                                            <CardFace card={ card } />
                                        </li>
                                    </For>
                                </ul>
                            }
                        >
                            { () =>
                                <span class="contents">
                                    <span class="sr-only">{ locale.t('poker.hole') }: { cardsSay(hole) }</span>
                                    <button
                                        type="button"
                                        class="poker-thing"
                                        data-armed={ folding ? 'true' : undefined }
                                        aria-pressed={ folding }
                                        disabled={ board.busy() }
                                        onClick={ pressHole }
                                        onFocusOut={ () => folding = false }
                                        onKeyDown={ (event) => (event.key === 'Escape' ? folding = false : undefined) }
                                    >
                                        <span class="poker-hole" aria-hidden="true">
                                            <For each={ hole } key={ (card) => card } let={ card }>
                                                <span class="flex"><CardFace card={ card } /></span>
                                            </For>
                                        </span>
                                        <span class="poker-thing-says">{ locale.t('poker.fold') }</span>
                                    </button>
                                </span>
                            }
                        </Show>

                        <Show when={ myTurn }>
                            { () =>
                                <div class="poker-acts">
                                    <Show
                                        when={ owing }
                                        fallback={
                                            <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void act('check') }>
                                                <span class="poker-disc" data-act="check" aria-hidden="true"><Icon name="hand" size={ 18 } /></span>
                                                <span class="poker-thing-says">{ locale.t('poker.check') }</span>
                                            </button>
                                        }
                                    >
                                        { () =>
                                            <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void act('call') }>
                                                <span class="poker-disc" data-act="call" aria-hidden="true"></span>
                                                <span class="poker-thing-says">{ callSays }</span>
                                            </button>
                                        }
                                    </Show>
                                    <Show when={ raisable }>
                                        { () =>
                                            <button type="button" class="poker-thing" aria-pressed={ raising } disabled={ board.busy() } onClick={ openRaise }>
                                                <span class="poker-disc" data-act="raise" aria-hidden="true"><Icon name="add" size={ 18 } /></span>
                                                <span class="poker-thing-says">{ opening ? locale.t('poker.bet') : locale.t('poker.raise') }</span>
                                            </button>
                                        }
                                    </Show>
                                    <Show when={ shoving }>
                                        { () =>
                                            <button type="button" class="poker-thing" disabled={ board.busy() } onClick={ () => void raise() }>
                                                <span class="poker-disc" data-act="allin" aria-hidden="true"></span>
                                                <span class="poker-thing-says">{ locale.t('poker.allin', { chips: chips(high) }) }</span>
                                            </button>
                                        }
                                    </Show>
                                </div>
                            }
                        </Show>
                    </div>
                }
            </Show>
        </div>

        <Show when={ over }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } rematch={ props.rematch } />
            }
        </Show>
    </div>
}
