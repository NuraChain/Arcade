import { Link, createResource } from 'azerothjs';

import { sideOf } from '../../../../backend/src/domains/match/sides.ts';
import { potOf, shareOf } from '../../../../backend/src/domains/stake/policy.ts';
import type { TableSummary } from '../../api.ts';
import { client } from '../../api.ts';
import { BAR_LEFT, BAR_WIDTH, BOTTOM, FIELD_LEFT, FIELD_RIGHT, FRAME, HEIGHT, MIDDLE, SPIKES, TOP, TRAY, TRAY_LEFT, WIDTH } from '../../game/backgammon-layout.ts';
import Icon from '../../icons/icon.component.azeroth';
import { attempt } from '../../lib/attempt.ts';
import { explorerTx, nuraOf } from '../../lib/nura.ts';
import { looking } from '../../lib/looking.ts';
import { whyRefused } from '../../lib/open-table.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { useVault } from '../../stores/vault.store.ts';
import ConfirmSheet from '../app/confirm-sheet.component.azeroth';
import Button from '../ui/button.component.azeroth';
import { stakedOf } from './boards.ts';
import { lobbySeats } from './lobby-seats.ts';
import MatchResult from './match-result.component.azeroth';
import SeatCard from './seat-card.component.azeroth';

const LUDO_INK: readonly string[] = ['red', 'green', 'yellow', 'blue'];

const CROWD = 6;

/**
 * The table, as it stands.
 *
 * Every chair here is a row somebody claimed. Nothing arrives on a timer, nothing is filled with
 * a practice partner to make the grid look busy, and the panel never counts anybody down: the
 * furthest a table goes is every chair taken, because there is no game behind it yet and the one
 * thing this screen must not do is imply there is.
 */
export default component LobbyPanel(props: {
    table: TableSummary;
    starting?: boolean;
    removed?: boolean;
    paused?: boolean;
    onStart?: () => void;
    onSit?: () => void;
    onInvite: () => void;
    onCopyLink: () => void;
    onLeave: () => void;
    onClose?: () => void;
})
{
    const locale = useLocale();
    const lobby = useLobby();
    const people = usePeople();
    const overlay = useOverlay();
    const toasts = useToasts();
    const vaults = useVault();

    state signing = false;

    derived me = lobby.me();

    derived mine = props.table.mine === undefined
        ? null
        : (props.table.chairs.find((chair) => chair.seat === props.table.mine) ?? null);

    derived seated = mine !== null;

    derived amHost = mine?.host === true;

    derived removing = amHost && props.table.quick !== true;

    derived empty = props.table.seats - props.table.taken;

    derived full = empty === 0;

    derived waitingOn = props.table.chairs
        .filter((chair) => chair.who !== undefined && chair.who !== me && !chair.ready)
        .map((chair) => people.byHandle(chair.who!))
        .map((person) => (person === null ? '' : person.displayName.split(' ')[0]))
        .filter(Boolean);

    /**
     * Whether the READER is the one holding it up, which is a different sentence from anybody else
     * being.
     *
     * `waitingOn` names everybody but you - correctly, because "Waiting for Ludo Two" read back to
     * Ludo Two is not a sentence anybody writes. What was missing is that the same exclusion made
     * the line fall through to "Everyone is ready" when you were the only one not ready, while your
     * own seat card two inches below said "Not ready". The status line is the thing a person reads
     * to find out why the game has not started, so on the one occasion they can fix it themselves
     * it has to say so.
     */
    derived meNotReady = mine !== null && mine.who !== undefined && !mine.ready;

    derived searching = looking(props.table);

    derived startable = props.onStart !== undefined;

    derived paused = props.paused === true;

    derived closable = props.onClose !== undefined;

    derived ludo = props.table.game === 'ludo';

    derived nard = props.table.game === 'backgammon';

    derived status = !seated
        ? locale.t(props.removed === true ? 'play.table.removed' : 'play.table.watching')
        : (paused
            ? locale.t('play.lobby.paused')
            : (startable
                ? locale.t('match.startHint')
                : (searching
                    ? locale.t('play.lobby.looking', { here: locale.n(props.table.taken), seats: locale.n(props.table.seats) })
                    : (empty > 0
                        ? locale.plural('play.lobby.emptySeats', empty)
                        : (meNotReady
                            ? locale.t('play.lobby.youNotReady')
                            : (waitingOn.length > 0
                                ? locale.t('play.lobby.waiting', { names: locale.list(waitingOn) })
                                : locale.t('play.lobby.allReady')))))));

    derived room = !seated && empty > 0 ? locale.plural('play.lobby.emptySeats', empty) : '';

    derived held = vaults.state();

    derived vaultFee = held !== null && held.configured ? held.fee : 0;

    derived chainId = held !== null && held.configured ? held.chainId : 0;

    derived staked = stakedOf(props.table, vaultFee, chainId, held !== null && held.configured ? held.balances?.free : undefined);

    derived paid = props.table.stake !== undefined;

    derived short = seated && mine?.ready !== true && staked?.short !== undefined;

    derived shortLine = locale.t('play.stake.short', { free: locale.n(nuraOf(staked?.short ?? '0'), { maximumFractionDigits: 4 }) });

    derived stakeLine = (() =>
    {
        const wei = BigInt(props.table.stake ?? '0');
        const share = shareOf(potOf(wei, props.table.seats), staked?.fee ?? vaultFee, props.table.teams ? 2 : 1);

        return locale.t(props.table.teams ? 'play.stake.eachTeams' : 'play.stake.each', {
            stake: locale.n(nuraOf(wei), { maximumFractionDigits: 4 }),
            share: locale.n(nuraOf(share), { maximumFractionDigits: 4 })
        });
    })();

    derived locking = props.table.money?.state === 'locking';

    derived lockTx = props.table.money?.openTx ?? null;

    derived lockLink = locking && lockTx !== null ? explorerTx(chainId, lockTx) : null;

    derived lockFailed = props.table.money?.state === 'failed' && props.table.matchId === undefined;

    derived failedLine = (() =>
    {
        const blame = props.table.money?.blame;

        if (blame === undefined)
        {
            return locale.t('play.stake.failed.all');
        }

        if (blame === me)
        {
            return locale.t('play.stake.failed.you');
        }

        const person = people.byHandle(blame);

        return locale.t('play.stake.failed.them', { name: person === null ? blame : person.displayName.split(' ')[0] });
    })();

    const sideAt = (seat: number) => sideOf(seat, { seats: props.table.seats, variant: 'teams' });

    derived home = props.table.mine === undefined ? null : sideAt(props.table.mine);

    derived sided = props.table.teams;

    const teamOf = (seat: number) =>
    {
        if (!sided)
        {
            return undefined;
        }

        const side = sideAt(seat);

        return side === home ? locale.t('team.yours') : locale.t('team.n', { n: locale.n(side + 1) });
    };

    derived spots = lobbySeats(props.table.game, props.table.seats, props.table.mine);

    const placed = (seat: number) =>
    {
        const spot = spots.find((one) => one.seat === seat);

        return spot === undefined ? undefined : `--x: ${ spot.x.toFixed(4) }; --y: ${ spot.y.toFixed(4) }`;
    };

    const inkOf = (seat: number) => (props.table.game === 'ludo'
        ? `var(--ludo-${ LUDO_INK[(props.table.seats === 2 ? seat * 2 : seat) % LUDO_INK.length] })`
        : undefined);

    const takeOut = async (handle: string | undefined) =>
    {
        if (handle === undefined)
        {
            return;
        }

        const tableId = props.table.id;
        const title = locale.t('play.remove.title', { name: people.byHandle(handle)?.displayName ?? handle });
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title,
                lead: locale.t('play.remove.lead'),
                confirm: locale.t('play.remove.confirm'),
                destructive: true
            },
            { label: title }
        ).closed;

        if (yes === true && !await attempt(lobby.remove(tableId, handle), undefined, (error) => whyRefused(error, 'common.actionFailed', 'play.remove.started')))
        {
            void lobby.refresh();
        }
    };

    derived ended = props.table.lastMatchId ?? null;

    const last = createResource(
        () => ended,
        (id) => client.matches.view({ params: { id } }),
        { name: 'matches.last' }
    );

    derived read = last.data() ?? null;

    derived lastGame = read !== null && read.id === ended ? read : null;

    const sayReady = async () =>
    {
        const ready = mine?.ready !== true;

        if (!ready || props.table.stake === undefined)
        {
            void attempt(lobby.ready(props.table.id, ready), undefined, (error) => whyRefused(error, 'common.actionFailed'));
            return;
        }

        if (signing)
        {
            return;
        }

        if (staked?.short !== undefined)
        {
            toasts.show({ kind: 'warning', text: locale.t('tables.refused.paid-funds'), dedupe: 'paid-funds' });
            return;
        }

        signing = true;

        const signed = await vaults.signStake(props.table.id);

        signing = false;

        if ('said' in signed)
        {
            toasts.show({ kind: 'warning', text: locale.t(signed.said) });
            return;
        }

        void attempt(lobby.ready(props.table.id, true, signed.signature), undefined, (error) => whyRefused(error, 'common.actionFailed'));
    };

    <section class="lobby flex flex-col gap-4" aria-label={ locale.t('play.title.lobby') }>
        <div class="lobby-table" data-game={ props.table.game } data-crowd={ props.table.seats > CROWD ? 'true' : undefined }>
            <div class={ () => (props.table.game === 'poker' ? 'lobby-top poker-table' : (props.table.game === 'hokm' ? 'lobby-top hokm-table' : 'lobby-top')) } aria-hidden="true">
                <Show when={ ludo }>
                    { () => <span class="lobby-board"></span> }
                </Show>
                <Show when={ nard }>
                    { () =>
                        <svg class="lobby-board" viewBox={ `0 0 ${ WIDTH } ${ HEIGHT }` }>
                            <rect x="0" y="0" width={ WIDTH } height={ HEIGHT } rx="22" fill="var(--nard-frame)" />
                            <rect x={ FIELD_LEFT } y={ TOP } width={ FIELD_RIGHT - FIELD_LEFT } height={ BOTTOM - TOP } rx="6" fill="var(--nard-field)" />
                            <rect x={ BAR_LEFT } y={ TOP - 6 } width={ BAR_WIDTH } height={ BOTTOM - TOP + 12 } fill="var(--nard-frame)" />
                            <rect x={ TRAY_LEFT } y={ TOP } width={ TRAY } height={ BOTTOM - TOP } rx="8" fill="var(--nard-tray)" />
                            <line x1={ TRAY_LEFT + 8 } y1={ MIDDLE } x2={ TRAY_LEFT + TRAY - 8 } y2={ MIDDLE } stroke="var(--nard-frame)" stroke-width="4" />
                            <For each={ [...SPIKES] } key={ (spike) => spike.point } let={ spike }>
                                <polygon points={ spike.path } fill={ spike.shade === 'a' ? 'var(--nard-point-a)' : 'var(--nard-point-b)' } />
                            </For>
                            <rect x={ FRAME / 2 } y={ FRAME / 2 } width={ WIDTH - FRAME } height={ HEIGHT - FRAME } rx="16" fill="none" stroke="var(--nard-inlay)" stroke-width="3" />
                        </svg>
                    }
                </Show>
            </div>
            <ul class="lobby-ring" aria-label={ locale.t('create.seats') }>
                <For each={ props.table.chairs } key={ (chair) => chair.seat } let={ chair }>
                    <li class="lobby-seat" style={ () => placed(chair.seat) }>
                        <SeatCard
                            seat={ chair }
                            me={ me }
                            team={ teamOf(chair.seat) }
                            side={ sided ? sideAt(chair.seat) : undefined }
                            ink={ inkOf(chair.seat) }
                            canInvite={ amHost }
                            canRemove={ removing }
                            onInvite={ () => props.onInvite() }
                            onRemove={ () => void takeOut(chair.who) }
                        />
                    </li>
                </For>
            </ul>
        </div>

        <div class="flex flex-col items-center gap-1 text-center">
            <p class="flex items-center justify-center gap-2 text-ui-base text-muted" aria-live="polite">
                <Show when={ seated && full && !paused } fallback={ <Icon name="clock" size={ 15 } class="shrink-0" /> }>
                    { () => <span class="live-dot h-2.5 w-2.5 shrink-0 rounded-full" aria-hidden="true"></span> }
                </Show>
                <span>{ status }</span>
            </p>
            <Show when={ room !== '' }>
                { () => <p class="text-ui-sm text-faint">{ room }</p> }
            </Show>
            <Show when={ paid }>
                <p class="flex items-center justify-center gap-1.5 text-ui-sm font-semibold text-madder" data-stake>
                    <Icon name="coins" size={ 14 } class="shrink-0" />
                    <span>{ stakeLine }</span>
                </p>
            </Show>
            <Show when={ locking }>
                <p class="flex flex-wrap items-center justify-center gap-x-2 text-ui-sm text-muted" role="status">
                    <span>{ locale.t('play.stake.locking') }</span>
                    <Show when={ lockLink } let={ href }>
                        <a class="font-semibold text-accent hover:underline" href={ href } target="_blank" rel="noopener noreferrer">{ locale.t('vault.tx') }</a>
                    </Show>
                </p>
            </Show>
            <Show when={ lockFailed }>
                <p class="text-ui-sm text-danger" role="alert">{ failedLine }</p>
            </Show>
            <Show when={ short }>
                <div class="flex flex-col items-center" data-short>
                    <p class="text-ui-sm font-semibold text-gold">{ shortLine }</p>
                    <Link to="/app/me/wallet" class="inline-flex min-h-11 items-center text-ui-sm font-semibold text-accent hover:underline">{ locale.t('vault.title') }</Link>
                </div>
            </Show>
        </div>

        <div class="lobby-acts">
            <Show when={ startable }>
                { () =>
                    <Button variant="primary" size="lg" block leading="play" loading={ props.starting === true } onClick={ () => props.onStart?.() }>
                        { locale.t('match.start') }
                    </Button>
                }
            </Show>
            <Show when={ seated }>
                { () =>
                    <Button
                        variant={ mine?.ready === true ? 'live' : 'primary' }
                        size="lg"
                        block
                        leading={ mine?.ready === true ? 'check-circle' : 'zap' }
                        loading={ signing }
                        onClick={ () => void sayReady() }
                    >
                        { mine?.ready === true ? locale.t('play.lobby.readyTag') : locale.t('play.lobby.ready') }
                    </Button>
                }
            </Show>
            <Show when={ !seated && props.onSit !== undefined }>
                { () =>
                    <Button variant="primary" size="lg" block leading="seat" disabled={ full } onClick={ () => props.onSit?.() }>
                        { locale.t('play.table.sitDown') }
                    </Button>
                }
            </Show>
            <div class="flex flex-wrap gap-2">
                <Button variant="outline" size="lg" leading="copy" class="grow basis-[9rem] whitespace-nowrap" onClick={ () => props.onCopyLink() }>{ locale.t('play.lobby.copyLink') }</Button>
                <Show when={ seated }>
                    { () => <Button variant="destructive" size="lg" leading="sign-out" class="grow basis-[9rem] whitespace-nowrap" onClick={ () => props.onLeave() }>{ locale.t('play.lobby.leave') }</Button> }
                </Show>
            </div>
            <Show when={ closable }>
                { () =>
                    <div class="flex justify-center">
                        <Button variant="destructive" size="sm" leading="close" onClick={ () => props.onClose?.() }>
                            { locale.t('play.close.confirm') }
                        </Button>
                    </div>
                }
            </Show>
        </div>

        <Show when={ lastGame } let={ game }>
            <div class="flex flex-col gap-2" data-last-game>
                <p class="label text-ui-xs text-faint">{ locale.t('play.lobby.last') }</p>
                <MatchResult match={ game } mine={ game.mine } stake={ staked } />
            </div>
        </Show>
    </section>
}
