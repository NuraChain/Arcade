import type { TableSeat } from '../../api.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useAccount } from '../../stores/account.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import { useVoice } from '../../stores/voice.store.ts';

export default component SeatCard(props: {
    seat: TableSeat;
    me: string;
    canInvite: boolean;
    canRemove: boolean;
    onInvite?: () => void;
    onRemove?: () => void;
})
{
    const locale = useLocale();
    const presence = usePresence();
    const people = usePeople();
    const voice = useVoice();
    const account = useAccount();

    derived filled = props.seat.who !== undefined;

    derived pending = !filled && props.seat.invited !== undefined;

    derived handle = props.seat.who ?? props.seat.invited ?? null;

    derived mine = props.seat.who !== undefined && props.seat.who === props.me;

    derived hosting = props.seat.host;

    derived inviting = props.canInvite;

    derived removable = props.canRemove && filled && !mine;

    derived person = mine
        ? account.user()
        : (handle === null ? null : (people.byHandle(handle) ?? null));

    derived name = mine
        ? locale.t('common.you')
        : (person === null ? (handle ?? '') : person.displayName);

    derived tag = ((): { text: string; tone: string } | null =>
    {
        if (pending)
        {
            return { text: locale.t('play.lobby.invited'), tone: 'bg-accent/15 text-accent' };
        }
        if (!filled)
        {
            return null;
        }
        return props.seat.ready
            ? { text: locale.t('play.lobby.readyTag'), tone: 'bg-live/15 text-live' }
            : { text: locale.t('play.lobby.notReady'), tone: 'bg-raised text-muted' };
    })();

    derived shell = [
        'relative flex h-full w-full min-w-0 flex-col items-center justify-center gap-2 rounded-panel border p-3 text-center transition-colors duration-200',
        'min-h-[9.5rem]',
        filled && props.seat.ready ? 'border-live/50 bg-live/5 shadow-glow-live' : '',
        filled && !props.seat.ready ? 'border-line bg-field' : '',
        !filled && pending ? 'border-dashed border-accent/50 bg-field' : '',
        !filled && !pending ? 'border-dashed border-line bg-void/40' : ''
    ].filter(Boolean).join(' ');

    <Show
        when={ filled || pending }
        fallback={
            <Show
                when={ inviting }
                fallback={
                    <div class={ shell } aria-label={ locale.t('play.lobby.open') }>
                        <span class="flex h-14 w-14 items-center justify-center rounded-full border border-dashed border-line text-faint">
                            <Icon name="seat" size={ 22 } />
                        </span>
                        <span class="text-ui-sm font-semibold text-muted">{ locale.t('play.lobby.open') }</span>
                    </div>
                }
            >
                { () =>
                    <button type="button" class={ () => [ shell, 'cursor-pointer hover:border-accent/60 hover:bg-raised/40' ].join(' ') } onClick={ () => props.onInvite?.() }>
                        <span class="flex h-14 w-14 items-center justify-center rounded-full border border-dashed border-line text-accent">
                            <Icon name="friend-add" size={ 22 } />
                        </span>
                        <span class="text-ui-sm font-semibold text-accent">{ locale.t('play.lobby.invite') }</span>
                        <span class="text-ui-xs text-faint">{ locale.t('play.lobby.open') }</span>
                    </button>
                }
            </Show>
        }
    >
        { () =>
            <div class={ shell }>
                <Show when={ hosting }>
                    <Badge dot text={ locale.t('play.lobby.host') } tone="accent" class="absolute start-2 top-2" />
                </Show>
                <Show when={ removable }>
                    { () =>
                        <span class="absolute end-1 top-1 z-10 flex">
                            <IconButton icon="close" size="sm" label={ locale.t('play.lobby.remove', { name }) } onClick={ () => props.onRemove?.() } />
                        </span>
                    }
                </Show>
                <span class={ () => [ 'flex rounded-full transition-shadow duration-150', props.seat.who !== undefined && voice.speaking(props.seat.who) ? 'ring-3 ring-live ring-offset-2 ring-offset-field' : '' ].filter(Boolean).join(' ') }>
                    <Avatar
                        person={ person }
                        size="lg"
                        presence={ pending || person === null ? null : presence.dot(person.id) }
                        class={ pending ? 'opacity-60' : '' }
                    />
                </span>
                <span class={ () => [ 'w-full truncate text-ui-base font-semibold', pending ? 'text-muted' : 'text-text' ].join(' ') } dir="auto">{ name }</span>
                <Show when={ tag } let={ mark }>
                    <span class={ () => [ 'rounded-full px-2 py-0.5 text-ui-2xs font-semibold', mark.tone, pending ? 'animate-pulse motion-reduce:animate-none' : '' ].filter(Boolean).join(' ') }>
                        { mark.text }
                    </span>
                </Show>
            </div>
        }
    </Show>
}
