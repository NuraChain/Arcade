import { onCleanup, untrack } from 'azerothjs';

import type { TableSeat } from '../../api.ts';
import Icon from '../../icons/icon.component.azeroth';
import { aboutPerson } from '../../lib/person-menu.ts';
import { runtime } from '../../lib/runtime.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useVoice } from '../../stores/voice.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';

export const CHAIR_OUT = 180;

export default component SeatCard(props: {
    seat: TableSeat;
    me: string;
    team?: string;
    side?: number;
    ink?: string;
    canInvite: boolean;
    canRemove: boolean;
    onInvite?: () => void;
    onRemove?: () => void;
})
{
    const locale = useLocale();
    const presence = usePresence();
    const people = usePeople();
    const voice = useVoice();
    const account = useAccount();
    const device = useDevice();

    state gone = '';

    let sat = untrack(() => props.seat.who ?? '');

    let forget: () => void = () => undefined;

    effect
    {
        const now = props.seat.who ?? '';
        const before = sat;

        sat = now;

        untrack(() =>
        {
            forget();
            forget = () => undefined;

            if (before !== '' && now === '' && !device.reducedMotion())
            {
                gone = before;
                forget = runtime().clock.after(CHAIR_OUT, () => gone = '');
            }
            else
            {
                gone = '';
            }
        });
    }

    onCleanup(() => forget());

    derived leaving = gone !== '';

    derived who = leaving ? gone : (props.seat.who ?? '');

    derived filled = who !== '';

    derived pending = !filled && props.seat.invited !== undefined;

    derived handle = filled ? who : (props.seat.invited ?? '');

    derived mine = filled && who === props.me;

    derived hosting = !leaving && props.seat.host === true;

    derived inviting = props.canInvite;

    derived removable = props.canRemove && filled && !mine && !leaving;

    derived pressable = filled && !mine && !leaving;

    derived person = mine
        ? account.user()
        : (handle === '' ? null : (people.byHandle(handle) ?? null));

    derived fullName = mine
        ? locale.t('common.you')
        : (person === null ? handle : person.displayName);

    derived name = mine || person === null ? fullName : (person.displayName.split(' ')[0] || fullName);

    derived ready = filled && !leaving && props.seat.ready;

    derived says = pending
        ? locale.t('play.lobby.invited')
        : (ready ? locale.t('play.lobby.readyTag') : locale.t('play.lobby.notReady'));

    derived standing = pending ? 'invited' : (ready ? 'ready' : 'waiting');

    <div
        class="lobby-chair"
        data-state={ filled || pending ? standing : 'open' }
        data-leaving={ leaving ? 'true' : undefined }
        data-side={ props.side }
        style={ props.ink === undefined ? undefined : `--ink: ${ props.ink }` }
    >
        <Show
            when={ filled || pending }
            fallback={
                <Show
                    when={ inviting }
                    fallback={
                        <span class="lobby-chair-seat" role="img" aria-label={ locale.t('play.lobby.open') }>
                            <span class="lobby-chair-face" data-open="true"><Icon name="seat" size={ 18 } /></span>
                            <span class="lobby-chair-name" aria-hidden="true">{ locale.t('play.lobby.open') }</span>
                        </span>
                    }
                >
                    { () =>
                        <button type="button" class="lobby-chair-seat" data-invites="true" onClick={ () => props.onInvite?.() }>
                            <span class="lobby-chair-face" data-open="true"><Icon name="friend-add" size={ 18 } /></span>
                            <span class="lobby-chair-name">{ locale.t('play.lobby.invite') }</span>
                            <span class="sr-only">{ locale.t('play.lobby.open') }</span>
                        </button>
                    }
                </Show>
            }
        >
            { () =>
                <span class="lobby-chair-seat" inert={ leaving }>
                    <span class="lobby-chair-face" data-speaking={ filled && voice.speaking(who) ? 'true' : undefined }>
                        <Avatar
                            person={ person }
                            size="md"
                            ringOn="void"
                            presence={ pending || person === null ? null : presence.dot(person.id) }
                        />
                        <Show when={ hosting }>
                            <span class="lobby-chair-host" role="img" aria-label={ locale.t('play.lobby.host') }>
                                <Icon name="crest-crown" size={ 10 } />
                            </span>
                        </Show>
                        <span class="lobby-chair-tick" data-on={ ready ? 'true' : undefined } aria-hidden="true">
                            <Icon name="selected" size={ 10 } />
                        </span>
                    </span>
                    <span class="lobby-chair-name" dir="auto">{ name }</span>
                    <span class="table-plate-tag" data-tone={ ready ? 'live' : 'neutral' }>{ says }</span>
                    <Show when={ props.team } let={ side }>
                        <span class="sr-only">{ side }</span>
                    </Show>
                    <Show when={ pressable }>
                        { () => <button type="button" class="lobby-chair-press" aria-haspopup="dialog" aria-label={ locale.t('actions.about', { name: fullName }) } onClick={ () => aboutPerson(who) }></button> }
                    </Show>
                    <Show when={ removable }>
                        { () =>
                            <span class="lobby-chair-out">
                                <IconButton icon="close" size="sm" label={ locale.t('play.lobby.remove', { name: fullName }) } onClick={ () => props.onRemove?.() } />
                            </span>
                        }
                    </Show>
                </span>
            }
        </Show>
    </div>
}
