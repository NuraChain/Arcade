import type { GameId } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component LiveStats(props: { game: GameId; compact?: boolean; class?: string })
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    derived stats = catalogue.stats(props.game);

    <ul class={ [ 'flex flex-wrap items-center gap-x-4 gap-y-1 text-ui-sm text-muted', props.class ?? '' ].filter(Boolean).join(' ') }>
        <li class="flex items-center gap-2">
            <span class="live-dot h-1.5 w-1.5" aria-hidden="true"></span>
            <span><span class="tally font-semibold text-text">{ locale.n(stats.playersOnline) }</span> { locale.plural('games.live.playingLabel', stats.playersOnline) }</span>
        </li>
        <Show when={ props.compact !== true }>
            <li class="flex items-center gap-2">
                <Icon name="seat" size={ 14 } />
                <span><span class="tally font-semibold text-text">{ locale.n(stats.tablesOpen) }</span> { locale.plural('games.live.tablesLabel', stats.tablesOpen) }</span>
            </li>
        </Show>
    </ul>
}
