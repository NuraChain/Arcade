import { untrack } from 'azerothjs';

import ChessSan from './chess-san.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import { copyText } from '../../lib/clipboard.ts';
import { pgnOf, type PgnGame } from '../../lib/pgn.ts';
import { chessOf } from '../../data/match.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useReview } from '../../stores/review.store.ts';
import type { MatchView } from '../../api.ts';

const PIECE = /^[KQRBN]/;

const PROMOTED = /=([QRBN])/;

const NEAR_END = 24;

/** Where a key takes a finished game being stepped through, from how many of its moves are shown. */
const STEPS: Record<string, ((at: number, count: number) => number) | undefined> = {
    ArrowLeft: (at) => at - 1,
    ArrowRight: (at) => at + 1,
    Home: () => 0,
    End: (_, count) => count
};

/**
 * A move as a score sheet in figurine notation draws it: the piece that moved, the squares, the piece
 * a pawn became. Every figure is drawn from the ivory set, whichever side moved, as a printed sheet
 * draws one shape a piece: the column says the side, and an ebony figure is lost on a dark panel.
 */
export function figuresOf(san: string)
{
    const lead = PIECE.test(san) ? `w${ san[0].toLowerCase() }` : undefined;
    const body = lead === undefined ? san : san.slice(1);
    const promoted = PROMOTED.exec(body);

    return promoted === null
        ? { lead, head: body, promo: undefined, tail: '' }
        : { lead, head: body.slice(0, promoted.index), promo: `w${ promoted[1].toLowerCase() }`, tail: body.slice(promoted.index + 2) };
}

/** A game's result as PGN writes it: who won, a draw, or nothing for a game called off or still going. */
const resultOf = (match: MatchView): PgnGame['result'] =>
{
    const over = chessOf(match)?.over;

    if (match.finishedAt === undefined || over === undefined || over.reason === 'abort')
    {
        return '*';
    }

    if (over.winner === undefined)
    {
        return '1/2-1/2';
    }

    return over.winner === chessOf(match)?.white ? '1-0' : '0-1';
};

export default component ChessMoves(props: { match: MatchView })
{
    const locale = useLocale();
    const review = useReview();

    derived view = chessOf(props.match);

    derived notation = view?.notation ?? [];

    derived plies = notation.map((san, ply) => ({ ply, n: Math.floor(ply / 2) + 1, white: ply % 2 === 0, ...figuresOf(san), san }));

    derived played = notation.length > 0;

    derived finished = played && props.match.finishedAt !== undefined;

    derived shown = (() =>
    {
        const now = review.looking();

        return finished && now !== null && now.match === props.match.id && now.ply < notation.length ? now.ply : notation.length;
    })();

    derived stepping = shown < notation.length;

    derived last = shown - 1;

    derived said = (() =>
    {
        if (!stepping)
        {
            return '';
        }

        const move = plies[shown - 1];

        return move === undefined
            ? locale.t('chess.review.atStart')
            : locale.t('chess.review.at', { move: `${ locale.n(move.n) }${ move.white ? '.' : '...' } ${ move.san }` });
    })();

    let list: HTMLElement | null = null;
    let near = true;

    effect
    {
        void notation.length;

        untrack(() =>
        {
            if (list !== null && near && !stepping)
            {
                list.scrollTop = list.scrollHeight;
            }
        });
    }

    effect
    {
        const at = last;

        untrack(() =>
        {
            if (stepping)
            {
                list?.querySelector<HTMLElement>(`[data-ply="${ at }"]`)?.scrollIntoView?.({ block: 'nearest' });
            }
        });
    }

    /** Shows the board after `ply` of the moves; all of them leave the game as it ended. */
    const go = (ply: number) =>
    {
        const count = untrack(() => notation.length);
        const to = Math.min(Math.max(ply, 0), count);

        if (to === count)
        {
            review.end();

            return;
        }

        review.show(untrack(() => props.match.id), to);
    };

    const step = (event: KeyboardEvent) =>
    {
        const move = STEPS[event.key];

        if (move === undefined || !untrack(() => finished))
        {
            return;
        }

        event.preventDefault();
        go(move(untrack(() => shown), untrack(() => notation.length)));
    };

    const whoAt = (seat: number) => props.match.players.find((one) => one.seat === seat)?.who ?? '';

    const copy = () =>
    {
        const match = props.match;
        const board = chessOf(match);

        if (board === null)
        {
            return;
        }

        void copyText(pgnOf({
            site: location.origin,
            date: new Date(match.startedAt),
            white: whoAt(board.white),
            black: whoAt(1 - board.white),
            result: resultOf(match),
            ...(board.clock === undefined ? {} : { clock: { base: board.clock.base, increment: board.clock.increment } }),
            notation: board.notation
        }), 'chess.moves.copied', { dedupe: 'pgn' });
    };

    <section class="flex min-h-0 flex-1 flex-col" aria-label={ locale.t('chess.moves.title') } onKeyDown={ step }>
        <Show when={ played } fallback={ <p class="m-auto px-4 py-8 text-center text-ui-sm text-muted">{ locale.t('chess.moves.none') }</p> }>
            { () =>
                <ol
                    class="chess-moves"
                    role="list"
                    dir="ltr"
                    ref={ (element) => list = element }
                    onScroll={ () =>
                    {
                        near = list === null || list.scrollHeight - list.scrollTop - list.clientHeight < NEAR_END;
                    } }
                >
                    <For each={ plies } key={ (one) => one.ply } let={ one }>
                        <li class="contents" role="listitem">
                            <span class="chess-moves-n" data-black={ one.white ? undefined : 'true' } aria-hidden="true">{ `${ locale.n(one.n) }.` }</span>
                            <Show
                                when={ finished }
                                fallback={
                                    <span class="chess-san" data-ply={ one.ply } data-last={ one.ply === last ? 'true' : undefined }>
                                        <ChessSan lead={ one.lead } head={ one.head } promo={ one.promo } tail={ one.tail } n={ one.n } white={ one.white } san={ one.san } />
                                    </span>
                                }
                            >
                                { () =>
                                    <button
                                        type="button"
                                        class="chess-san"
                                        data-ply={ one.ply }
                                        data-last={ one.ply === last ? 'true' : undefined }
                                        aria-current={ one.ply === last ? 'step' : undefined }
                                        onClick={ () => go(one.ply + 1) }
                                    >
                                        <ChessSan lead={ one.lead } head={ one.head } promo={ one.promo } tail={ one.tail } n={ one.n } white={ one.white } san={ one.san } />
                                    </button>
                                }
                            </Show>
                        </li>
                    </For>
                </ol>
            }
        </Show>
        <p class="sr-only" aria-live="polite">{ said }</p>
        <footer class="flex shrink-0 items-center gap-2 border-t border-line px-3 py-2">
            <Show when={ finished }>
                { () =>
                    <div class="flex items-center gap-0.5" dir="ltr" role="group" aria-label={ locale.t('chess.review.title') }>
                        <IconButton icon="chevron-first" label={ locale.t('chess.review.start') } variant="ghost" size="sm" disabled={ shown === 0 } onClick={ () => go(0) } />
                        <IconButton icon="chevron-left" label={ locale.t('chess.review.back') } variant="ghost" size="sm" disabled={ shown === 0 } onClick={ () => go(untrack(() => shown) - 1) } />
                        <IconButton icon="chevron-right" label={ locale.t('chess.review.forward') } variant="ghost" size="sm" disabled={ !stepping } onClick={ () => go(untrack(() => shown) + 1) } />
                        <IconButton icon="chevron-last" label={ locale.t('chess.review.end') } variant="ghost" size="sm" disabled={ !stepping } onClick={ () => go(untrack(() => notation.length)) } />
                    </div>
                }
            </Show>
            <Button variant="secondary" size="sm" leading="copy" class="ms-auto" disabled={ !played } onClick={ copy }>{ locale.t('chess.moves.copy') }</Button>
        </footer>
    </section>
}
