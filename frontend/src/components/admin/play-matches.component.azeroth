import { createResource } from 'azerothjs';

import type { MatchList } from '../../../../backend/src/domains/admin/roles.ts';
import type { AdminMatches } from '../../../../backend/src/schemas.ts';
import { client } from '../../api.ts';
import { GAMES } from '../../data/games.ts';
import { attempt } from '../../lib/attempt.ts';
import { createGuesses } from '../../lib/guess.ts';
import { whyStaffRefused } from '../../lib/staff-words.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import ErrorState from '../ui/error-state.component.azeroth';
import LoadMore from '../ui/load-more.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import AdminEmpty from './admin-empty.component.azeroth';
import MatchRow, { MATCH_COLUMNS, type AdminMatchRow, type PlayReader } from './match-row.component.azeroth';
import ReasonSheet from './reason-sheet.component.azeroth';

interface Tail
{
    from: AdminMatches;
    rows: AdminMatchRow[];
    cursor: string | undefined;
}

const queryOf = (list: MatchList) => (list === 'stuck' ? { list } : {});

export default component PlayMatches(props: { list: MatchList; reader?: PlayReader; onEnded?: () => Promise<unknown> })
{
    const locale = useLocale();
    const overlay = useOverlay();

    state tail = null as Tail | null;

    state paging = false;

    const first = createResource(() => props.list, (asked) => client.admin.liveMatches({ query: queryOf(asked) }), { name: 'admin.play.matches' });

    const guesses = createGuesses<AdminMatchRow[]>();

    derived page = first.data() ?? null;

    derived trouble = first.error();

    derived waiting = page === null && trouble === null;

    derived failed = page === null && trouble !== null;

    derived continued = tail !== null && tail.from === page ? tail : null;

    derived rows = page === null ? [] : guesses.over([...page.rows, ...(continued?.rows ?? [])]);

    derived cursor = continued === null ? page?.cursor : continued.cursor;

    derived more = cursor !== undefined;

    derived listed = rows.length > 0;

    derived empty = page !== null && rows.length === 0;

    derived stuckOnly = props.list === 'stuck';

    derived blank = locale.t(stuckOnly ? 'admin.play.matches.noneStuck' : 'admin.play.matches.none');

    derived blankLead = locale.t(stuckOnly ? 'admin.play.matches.noneStuckLead' : 'admin.play.matches.noneLead');

    const older = async () =>
    {
        const from = page;
        const after = cursor;
        const kept = continued?.rows ?? [];

        if (from === null || after === undefined || paging)
        {
            return;
        }

        paging = true;

        await attempt((async () =>
        {
            const next = await client.admin.liveMatches({ query: { ...queryOf(props.list), cursor: after } });

            if (first.data() === from)
            {
                tail = { from, rows: [...kept, ...next.rows], cursor: next.cursor };
            }
        })());

        paging = false;
    };

    const nameOf = (game: string) =>
    {
        const known = GAMES.find((one) => one.id === game);

        return known === undefined ? game : locale.t(known.nameKey);
    };

    const reread = async () =>
    {
        await Promise.all([first.refetch(), props.onEnded?.()]);

        if (first.error() !== null)
        {
            throw first.error();
        }

        guesses.landed();
    };

    const end = async (row: AdminMatchRow) =>
    {
        const game = nameOf(row.game);
        const reason = await overlay.open(
            ReasonSheet,
            {
                title: locale.t('admin.play.end.ask', { game }),
                lead: locale.t(row.stake === undefined ? 'admin.play.end.askLead' : 'admin.play.end.askLeadPaid'),
                confirm: locale.t('admin.play.end.confirm'),
                destructive: true
            },
            { label: locale.t('admin.section.play') }
        ).closed;

        if (typeof reason !== 'string')
        {
            return;
        }

        const sent = guesses.during(
            (held) => held.filter((one) => one.id !== row.id),
            () => client.admin.voidMatch({ params: { id: row.id }, input: { reason } }),
            reread
        );

        if (!await attempt(sent, locale.t('admin.play.end.done', { game, code: row.code.toUpperCase() }), whyStaffRefused))
        {
            await Promise.all([first.refetch(), props.onEnded?.()]);
        }
    };

    <div class="flex flex-col" data-matches>
        <Show when={ waiting }>
            { () => <Skeleton lines={ 4 } avatar /> }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('admin.play.listFailed') } onRetry={ () => void first.refetch() } /> }
        </Show>

        <Show when={ empty }>
            { () => <AdminEmpty icon="games" title={ blank } lead={ blankLead } /> }
        </Show>

        <Show when={ listed }>
            <div class="flex flex-col">
                <div class="overflow-hidden rounded-panel border border-line bg-field">
                    <div class={ `hidden gap-x-4 border-b border-line px-4 py-2.5 text-ui-xs font-semibold text-faint @3xl:grid ${ MATCH_COLUMNS }` } aria-hidden="true" data-columns>
                        <span class="col-start-2">{ locale.t('admin.play.column.game') }</span>
                        <span>{ locale.t('admin.play.column.players') }</span>
                    </div>
                    <ul class="divide-y divide-line" data-match-list>
                        <For each={ rows } key={ (one) => one.id } let={ row }>
                            <li>
                                <MatchRow match={ row } reader={ props.reader } onEnd={ () => void end(row) } />
                            </li>
                        </For>
                    </ul>
                </div>
                <Show when={ more }>
                    <LoadMore label={ locale.t('admin.play.more') } loading={ paging } onMore={ () => void older() } />
                </Show>
            </div>
        </Show>
    </div>
}
