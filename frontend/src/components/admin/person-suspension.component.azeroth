import { SUSPEND_CATEGORIES, type SuspendCategory, type SuspendDays } from '../../../../backend/src/domains/admin/roles.ts';
import { CATEGORY_WORDS, TERM_WORDS } from '../../lib/staff-words.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import ConfirmSheet from '../app/confirm-sheet.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Field from '../ui/field.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import Segmented from '../ui/segmented.component.azeroth';
import Select from '../ui/select.component.azeroth';
import TextArea from '../ui/text-area.component.azeroth';

export interface SuspendAsk
{
    days: SuspendDays | null;
    category: SuspendCategory;
    reason: string;
}

type Term = '1' | '7' | '30' | 'good';

const TERMS: readonly Term[] = ['1', '7', '30', 'good'];

const TERM_DAYS: Readonly<Record<Term, SuspendDays | null>> = { 1: 1, 7: 7, 30: 30, good: null };

const REASON_MIN = 3;

export default component PersonSuspension(props: {
    name: string;
    suspended: boolean;
    guest: boolean;
    onSuspend: (ask: SuspendAsk) => Promise<boolean>;
    onLift: (reason: string) => Promise<boolean>;
})
{
    const locale = useLocale();
    const overlay = useOverlay();

    state term = '1' as Term;

    state category = '';

    state why = '';

    state whyTold = null as string | null;

    state categoryTold = null as string | null;

    state liftWhy = '';

    state liftTold = null as string | null;

    derived suspendable = !props.suspended;

    derived liftable = props.suspended;

    derived missing = categoryTold !== null;

    derived categoryWords = categoryTold ?? '';

    derived terms = TERMS.map((id) => ({ id, label: locale.t(`admin.suspend.days.${ id }`) }));

    derived categories = [
        { value: '', label: locale.t('admin.suspend.categoryNone') },
        ...SUSPEND_CATEGORIES.map((one) => ({ value: one, label: locale.t(CATEGORY_WORDS[one] ?? 'report.category.other') }))
    ];

    const chose = (value: string) =>
    {
        category = value;
        categoryTold = null;
    };

    const typedWhy = (value: string) =>
    {
        why = value;
        whyTold = null;
    };

    const typedLift = (value: string) =>
    {
        liftWhy = value;
        liftTold = null;
    };

    const suspend = async () =>
    {
        const reason = why.trim();
        const kind = SUSPEND_CATEGORIES.find((one) => one === category);
        const days = TERM_DAYS[term];
        const said = locale.t(days === null ? 'admin.suspend.term.good' : TERM_WORDS[String(days)] ?? 'admin.suspend.term.good');

        categoryTold = kind === undefined ? locale.t('admin.suspend.categoryMissing') : null;
        whyTold = reason.length < REASON_MIN ? locale.t('admin.staff.reasonShort') : null;

        if (kind === undefined || whyTold !== null)
        {
            return;
        }

        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('admin.suspend.ask', { name: props.name, term: said }),
                lead: locale.t(props.guest ? 'admin.suspend.askGuest' : 'admin.suspend.askLead'),
                confirm: locale.t('admin.suspend.confirm'),
                destructive: true
            },
            { label: locale.t('admin.suspend.title') }
        ).closed;

        if (yes === true && await props.onSuspend({ days, category: kind, reason }))
        {
            term = '1';
            category = '';
            why = '';
        }
    };

    const lift = async () =>
    {
        const reason = liftWhy.trim();

        liftTold = reason.length < REASON_MIN ? locale.t('admin.staff.reasonShort') : null;

        if (liftTold === null && await props.onLift(reason))
        {
            liftWhy = '';
        }
    };

    <div class="flex flex-col gap-4">
        <Show when={ suspendable }>
            <Panel pad="md" stack="md" labelledBy="person-suspend">
                <div class="flex flex-col gap-1">
                    <h3 id="person-suspend" class="text-ui-md font-semibold text-text">{ locale.t('admin.suspend.title') }</h3>
                    <p class="text-ui-sm text-muted">{ locale.t('admin.suspend.lead') }</p>
                </div>
                <div class="flex flex-col gap-1.5">
                    <span class="text-ui-sm font-semibold text-text" aria-hidden="true">{ locale.t('admin.suspend.howLong') }</span>
                    <Segmented block class="max-w-md" items={ terms } value={ term } label={ locale.t('admin.suspend.howLong') } onChange={ (id) => term = id as Term } />
                </div>
                <div class="flex max-w-md flex-col gap-1.5" data-category>
                    <Select label={ locale.t('admin.suspend.category') } value={ category } options={ categories } onChange={ chose } />
                    <Show when={ missing }>
                        <p class="text-ui-xs font-medium text-danger" role="alert">{ categoryWords }</p>
                    </Show>
                </div>
                <Field id="admin-suspend-why" label={ locale.t('admin.staff.reason') } hint={ locale.t('admin.staff.reasonHint') } error={ whyTold }>
                    <TextArea
                        id="admin-suspend-why"
                        class="max-w-xl"
                        value={ why }
                        maxlength={ 500 }
                        describedBy={ whyTold !== null ? 'admin-suspend-why-error' : 'admin-suspend-why-hint' }
                        onInput={ typedWhy }
                    />
                </Field>
                <Button variant="destructive" class="self-start" onClick={ () => void suspend() }>{ locale.t('admin.suspend.send') }</Button>
            </Panel>
        </Show>

        <Show when={ liftable }>
            <Panel pad="md" stack="md" labelledBy="person-lift">
                <div class="flex flex-col gap-1">
                    <h3 id="person-lift" class="text-ui-md font-semibold text-text">{ locale.t('admin.lift.title') }</h3>
                    <p class="text-ui-sm text-muted">{ locale.t('admin.lift.lead') }</p>
                </div>
                <Field id="admin-lift-why" label={ locale.t('admin.staff.reason') } hint={ locale.t('admin.staff.reasonHint') } error={ liftTold }>
                    <TextArea
                        id="admin-lift-why"
                        class="max-w-xl"
                        value={ liftWhy }
                        maxlength={ 500 }
                        describedBy={ liftTold !== null ? 'admin-lift-why-error' : 'admin-lift-why-hint' }
                        onInput={ typedLift }
                    />
                </Field>
                <Button variant="primary" class="self-start" onClick={ () => void lift() }>{ locale.t('admin.lift.send') }</Button>
            </Panel>
        </Show>
    </div>
}
