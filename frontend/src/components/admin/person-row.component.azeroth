import { Link } from 'azerothjs';

import type { AdminPeople } from '../../../../backend/src/schemas.ts';
import Icon from '../../icons/icon.component.azeroth';
import { ROLE_WORDS } from '../../lib/staff-words.ts';
import { shortAddress } from '../../lib/wallet.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import When from './when.component.azeroth';

export type AdminPersonRow = AdminPeople['rows'][number];

export const PEOPLE_COLUMNS = '@2xl:grid-cols-[minmax(0,2fr)_minmax(0,1.1fr)_minmax(0,1fr)_minmax(0,1.5fr)_1rem]';

export default component PersonRow(props: { person: AdminPersonRow })
{
    const locale = useLocale();

    derived role = props.person.staff ?? null;

    derived ranked = role !== null;

    derived roleWord = role === null ? '' : locale.t(ROLE_WORDS[role]);

    derived suspended = props.person.suspended;

    derived minor = props.person.minor;

    derived reported = props.person.reports > 0;

    derived reports = locale.plural('admin.people.reports', props.person.reports);

    derived joined = locale.t('admin.people.joined', { when: locale.relative(Date.parse(props.person.createdAt), { style: 'short' }) });

    derived since = locale.relative(Date.parse(props.person.createdAt));

    derived wallet = props.person.address === undefined ? '' : shortAddress(props.person.address);

    derived walleted = wallet !== '';

    <Link
        to={ () => `/admin/people/${ encodeURIComponent(props.person.handle) }` }
        class={ `flex min-h-16 items-center gap-3 px-4 py-3 transition-colors duration-150 hover:bg-raised @2xl:grid @2xl:gap-4 ${ PEOPLE_COLUMNS }` }
        data-person={ props.person.handle }
    >
        <span class="flex min-w-0 flex-1 items-center gap-3">
            <Avatar person={ props.person } size="md" />
            <span class="flex min-w-0 flex-col">
                <span class="truncate text-ui-sm font-semibold text-text" dir="auto" data-name>{ props.person.displayName }</span>
                <span class="facts text-ui-xs text-muted">
                    <span class="flex min-w-0"><span class="truncate" dir="ltr">@{ props.person.handle }</span></span>
                    <span class="text-faint @2xl:hidden" data-joined>{ joined }</span>
                </span>
            </span>
        </span>
        <span class="hidden min-w-0 truncate text-ui-xs @2xl:block" data-wallet>
            <span class="tally text-muted" dir="ltr" hidden={ !walleted }>{ wallet }</span>
            <span class="text-faint" hidden={ walleted }>{ locale.t('admin.people.guest') }</span>
        </span>
        <span class="hidden text-ui-xs text-muted @2xl:block" data-since><When at={ props.person.createdAt } said={ since } /></span>
        <span class="flex max-w-[45%] flex-wrap items-center justify-end gap-1.5 @2xl:max-w-none @2xl:justify-start" data-marks>
            <Show when={ ranked }>
                <Badge text={ roleWord } tone="accent" />
            </Show>
            <Show when={ suspended }>
                <Badge text={ locale.t('admin.people.suspended') } tone="danger" />
            </Show>
            <Show when={ minor }>
                <Badge text={ locale.t('admin.people.minor') } tone="gold" />
            </Show>
            <Show when={ reported }>
                <Badge text={ reports } tone="neutral" />
            </Show>
        </span>
        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
    </Link>
}
