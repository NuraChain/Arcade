import { Link } from 'azerothjs';

import type { AdminReports } from '../../../../backend/src/schemas.ts';
import Icon from '../../icons/icon.component.azeroth';
import { CATEGORY_WORDS, handleParts, ROLE_WORDS, STATUS_TONES, STATUS_WORDS } from '../../lib/staff-words.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Said from './said.component.azeroth';
import When from './when.component.azeroth';

export type AdminReportRow = AdminReports['rows'][number];

export const REPORT_COLUMNS = '@3xl:grid-cols-[2.5rem_minmax(0,2.2fr)_minmax(0,1.3fr)_minmax(0,1.1fr)_minmax(0,1fr)_1rem]';

export default component ReportRow(props: { report: AdminReportRow })
{
    const locale = useLocale();

    derived parts = handleParts(locale.t('admin.reports.row', { by: '{by}', about: '{about}' }), { by: props.report.by.handle, about: props.report.about.handle });

    derived category = locale.t(CATEGORY_WORDS[props.report.category] ?? 'report.category.other');

    derived marked = props.report.status;

    derived status = locale.t(STATUS_WORDS[props.report.status]);

    derived tone = STATUS_TONES[props.report.status];

    derived role = props.report.about.staff ?? null;

    derived ranked = role !== null;

    derived roleWord = role === null ? '' : locale.t(ROLE_WORDS[role]);

    derived disclosed = props.report.disclosed;

    <Link
        to={ () => `/admin/reports/${ encodeURIComponent(props.report.id) }` }
        class={ `flex min-h-16 items-center gap-3 px-4 py-3 transition-colors duration-150 hover:bg-raised @3xl:grid @3xl:gap-x-4 ${ REPORT_COLUMNS }` }
        data-report={ props.report.id }
    >
        <span class="flex shrink-0 @3xl:col-start-1 @3xl:row-start-1"><Avatar person={ props.report.about } size="md" /></span>
        <span class="flex min-w-0 flex-1 flex-col gap-1 @3xl:contents">
            <span class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 @3xl:col-start-2 @3xl:row-start-1">
                <span class="text-ui-sm font-semibold text-text" data-said><Said parts={ parts } /></span>
                <span class="flex" hidden={ !ranked } data-role><Badge text={ roleWord } tone="accent" /></span>
            </span>
            <span class="flex flex-wrap items-center gap-1.5 @3xl:contents" data-marks>
                <span class="flex @3xl:col-start-5 @3xl:row-start-1" data-status={ marked }><Badge dot text={ status } tone={ tone } /></span>
                <span class="text-ui-xs text-muted @3xl:col-start-3 @3xl:row-start-1" data-category>{ category }</span>
            </span>
            <span class="facts text-ui-xs text-faint @3xl:col-start-4 @3xl:row-start-1">
                <When at={ props.report.at } />
                <span hidden={ !disclosed } data-disclosed>{ locale.t('admin.reports.withMessage') }</span>
            </span>
        </span>
        <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint @3xl:col-start-6 @3xl:row-start-1" />
    </Link>
}
