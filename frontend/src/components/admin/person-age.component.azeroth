import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import ConfirmSheet from '../app/confirm-sheet.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Field from '../ui/field.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import TextArea from '../ui/text-area.component.azeroth';

const REASON_MIN = 3;

export default component PersonAge(props: {
    name: string;
    minor: boolean;
    onMark: (minor: boolean, reason: string) => Promise<boolean>;
})
{
    const locale = useLocale();
    const overlay = useOverlay();

    state why = '';

    state whyTold = null as string | null;

    derived minor = props.minor;

    derived lead = locale.t(minor ? 'admin.age.leadMinor' : 'admin.age.leadAdult');

    const typedWhy = (value: string) =>
    {
        why = value;
        whyTold = null;
    };

    const mark = async (to: boolean) =>
    {
        const reason = why.trim();

        whyTold = reason.length < REASON_MIN ? locale.t('admin.staff.reasonShort') : null;

        if (whyTold !== null)
        {
            return;
        }

        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t(to ? 'admin.age.askMinor' : 'admin.age.askAdult', { name: props.name }),
                lead: locale.t(to ? 'admin.age.askMinorLead' : 'admin.age.askAdultLead'),
                confirm: locale.t(to ? 'admin.age.markMinor' : 'admin.age.markAdult'),
                destructive: to
            },
            { label: locale.t('admin.age.title') }
        ).closed === true;

        if (yes && await props.onMark(to, reason))
        {
            why = '';
        }
    };

    <Panel pad="md" stack="md" labelledBy="person-age">
        <div class="flex flex-col gap-1">
            <h3 id="person-age" class="text-ui-md font-semibold text-text">{ locale.t('admin.age.title') }</h3>
            <p class="text-ui-sm text-muted" data-age-lead>{ lead }</p>
        </div>
        <Field id="admin-age-why" label={ locale.t('admin.staff.reason') } hint={ locale.t('admin.staff.reasonHint') } error={ whyTold }>
            <TextArea
                id="admin-age-why"
                class="max-w-xl"
                value={ why }
                maxlength={ 500 }
                describedBy={ whyTold !== null ? 'admin-age-why-error' : 'admin-age-why-hint' }
                onInput={ typedWhy }
            />
        </Field>
        <Show
            when={ minor }
            fallback={ <span class="flex self-start" data-mark="minor"><Button variant="destructive" onClick={ () => void mark(true) }>{ locale.t('admin.age.markMinor') }</Button></span> }
        >
            <span class="flex self-start" data-mark="adult"><Button variant="outline" onClick={ () => void mark(false) }>{ locale.t('admin.age.markAdult') }</Button></span>
        </Show>
    </Panel>
}
