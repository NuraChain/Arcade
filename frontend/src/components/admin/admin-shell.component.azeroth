import { Link, Outlet, untrack, useHead, useRoute, type MountNode } from 'azerothjs';

import { may } from '../../../../backend/src/domains/admin/roles.ts';

import '../../icons/all.ts';
import '../../locales/app-catalogue.ts';
import '../../locales/admin-catalogue.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/all.ts';
import { groupsFor, sectionsFor, tabsFor, type AdminSection, type SectionGroup } from '../../lib/admin-sections.ts';
import { ROLE_WORDS } from '../../lib/staff-words.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useReports } from '../../stores/reports.store.ts';
import { useSession } from '../../stores/session.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { ACTIVE_ROW } from '../app/nav-items.ts';
import OverlayHost from '../app/overlay-host.component.azeroth';
import { watchSignedOut } from '../app/sign-out.ts';
import ToastHost from '../app/toast-host.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';
import AdminMore from './admin-more.component.azeroth';

const LOOK: Record<AdminSection, { icon: IconName; label: MessageKey }> = {
    overview: { icon: 'activity', label: 'admin.section.overview' },
    live: { icon: 'signal', label: 'admin.section.live' },
    people: { icon: 'people', label: 'admin.section.people' },
    reports: { icon: 'flag', label: 'admin.section.reports' },
    play: { icon: 'games', label: 'admin.section.play' },
    notice: { icon: 'megaphone', label: 'admin.section.notice' },
    money: { icon: 'coins', label: 'admin.section.money' },
    staff: { icon: 'shield', label: 'admin.section.staff' },
    log: { icon: 'history', label: 'admin.section.log' }
};

const GROUP_WORDS: Record<SectionGroup, MessageKey> = {
    now: 'admin.group.now',
    moderation: 'admin.group.moderation',
    platform: 'admin.group.platform',
    team: 'admin.group.team'
};

export default component AdminShell(props: { children?: MountNode })
{
    const locale = useLocale();
    const session = useSession();
    const overlay = useOverlay();
    const route = useRoute();
    const reports = useReports();

    useHead({ titleTemplate: `%s · ${ locale.t('admin.title') }` });

    mount
    {
        const stops = [useToasts().start(), session.start(), watchSignedOut(), reports.start()];

        return () =>
        {
            for (const stop of [...stops].reverse())
            {
                try
                {
                    stop();
                }
                catch (error)
                {
                    reportError(error);
                }
            }
        };
    }

    derived account = session.account() ?? null;

    derived role = account?.staff ?? null;

    derived handle = account?.handle ?? '';

    derived ranked = role !== null;

    derived roleWord = role === null ? '' : locale.t(ROLE_WORDS[role]);

    derived here = route().pathname.split('/')[2] ?? '';

    const itemOf = (section: AdminSection) => ({ section, to: `/admin/${ section }`, icon: LOOK[section].icon, label: locale.t(LOOK[section].label) });

    derived sections = sectionsFor(role).map(itemOf);

    derived groups = groupsFor(role).map((group) => ({ id: group.id, label: locale.t(GROUP_WORDS[group.id]), items: group.sections.map(itemOf) }));

    derived tabbed = tabsFor(role);

    derived tabs = tabbed.tabs.map(itemOf);

    derived more = tabbed.more.map(itemOf);

    derived extra = more.length > 0;

    derived elsewhere = tabbed.more.some((section) => section === here);

    derived columns = tabs.length + (extra ? 1 : 0) === 5 ? 'grid-cols-5' : 'grid-cols-4';

    derived watching = may(role, 'reports');

    derived waiting = reports.waiting();

    derived waitingLabel = locale.plural('admin.reports.waiting', waiting);

    effect
    {
        if (here !== '' && watching)
        {
            untrack(() =>
            {
                void reports.read();
            });
        }
    }

    const openMore = () =>
    {
        overlay.open(AdminMore, { items: more, here }, { label: locale.t('admin.more') });
    };

    <div class="contents">
        <div id="admin-shell" inert={ overlay.blocking() } class="min-h-dvh bg-void text-text md:grid md:grid-cols-[4.5rem_minmax(0,1fr)] lg:grid-cols-[15rem_minmax(0,1fr)]">
            <aside class="hidden border-e border-line md:block" data-side>
                <div class="safe-t safe-b sticky top-0 flex h-dvh flex-col bg-void">
                    <div class="flex h-16 shrink-0 items-center gap-3 px-3.5 max-lg:justify-center">
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control bg-accent-fill text-accent-ink" aria-hidden="true">
                            <Icon name="shield" size={ 18 } />
                        </span>
                        <span class="hidden min-w-0 flex-col lg:flex">
                            <span class="title truncate text-ui-md text-text">{ locale.t('admin.title') }</span>
                            <span class="truncate text-ui-xs text-faint">{ locale.t('admin.brand') }</span>
                        </span>
                    </div>
                    <nav class="min-h-0 flex-1 overflow-y-auto" aria-label={ locale.t('admin.sections') }>
                        <ul class="flex flex-col items-center gap-1 py-2 lg:hidden" data-rail>
                            <For each={ sections } key={ (item) => item.section } let={ item }>
                                <li class="shrink-0">
                                    <Tooltip label={ item.label } side="end">
                                        <Link
                                            to={ item.to }
                                            aria-label={ item.label }
                                            aria-current={ here === item.section ? 'page' : undefined }
                                            class={ () => [ 'nav-row', ACTIVE_ROW, 'relative flex h-11 w-11 items-center justify-center rounded-tile text-muted transition-colors duration-150 hover:bg-raised hover:text-text', here === item.section ? 'is-active' : '' ].join(' ') }
                                        >
                                            <Icon name={ item.icon } size={ 20 } />
                                            <Badge count={ item.section === 'reports' ? waiting : 0 } size="sm" tone="gold" anchor label={ waitingLabel } />
                                        </Link>
                                    </Tooltip>
                                </li>
                            </For>
                        </ul>
                        <div class="hidden flex-col gap-5 px-3 py-2 lg:flex" data-groups>
                            <For each={ groups } key={ (group) => group.id } let={ group }>
                                <div class="flex flex-col gap-1" data-group={ group.id }>
                                    <p class="label px-3 text-ui-2xs text-faint">{ group.label }</p>
                                    <ul class="flex flex-col gap-0.5">
                                        <For each={ group.items } key={ (item) => item.section } let={ item }>
                                            <li>
                                                <Link
                                                    to={ item.to }
                                                    aria-current={ here === item.section ? 'page' : undefined }
                                                    class={ () => [ 'nav-row', ACTIVE_ROW, 'flex h-10 items-center gap-3 rounded-tile px-3 text-ui-base font-semibold text-muted transition-colors duration-150 hover:bg-raised hover:text-text', here === item.section ? 'is-active' : '' ].join(' ') }
                                                >
                                                    <Icon name={ item.icon } size={ 18 } />
                                                    <span class="min-w-0 flex-1 truncate">{ item.label }</span>
                                                    <Badge count={ item.section === 'reports' ? waiting : 0 } tone="gold" label={ waitingLabel } />
                                                </Link>
                                            </li>
                                        </For>
                                    </ul>
                                </div>
                            </For>
                        </div>
                    </nav>
                    <div class="shrink-0 border-t border-line p-2 lg:p-3" data-staff>
                        <div class="flex justify-center lg:hidden">
                            <IconButton icon="back" label={ locale.t('admin.back') } variant="ghost" size="md" flip tipSide="end" to="/app" />
                        </div>
                        <div class="hidden flex-col gap-2 lg:flex">
                            <div class="flex min-w-0 items-center gap-2.5 px-1">
                                <Avatar person={ account } size="sm" />
                                <div class="flex min-w-0 flex-1 flex-col">
                                    <span class="truncate text-ui-sm font-semibold text-text" dir="ltr" data-staff-handle>@{ handle }</span>
                                    <Show when={ ranked }>
                                        <span class="text-ui-xs text-muted" data-staff-role>{ roleWord }</span>
                                    </Show>
                                </div>
                            </div>
                            <Link to="/app" class="flex h-9 items-center gap-2 rounded-control px-2 text-ui-sm font-semibold text-muted transition-colors duration-150 hover:bg-raised hover:text-text" data-leave>
                                <Icon name="back" size={ 16 } class="icon-flip" />
                                <span>{ locale.t('admin.back') }</span>
                            </Link>
                        </div>
                    </div>
                </div>
            </aside>

            <div class="min-w-0">
                <header class="safe-t sticky top-0 z-20 border-b border-line bg-void/90 backdrop-blur md:hidden" data-top>
                    <div class="flex h-14 items-center gap-1 px-2">
                        <IconButton icon="back" label={ locale.t('admin.back') } variant="ghost" size="md" flip to="/app" />
                        <span class="title text-ui-lg text-text">{ locale.t('admin.title') }</span>
                        <div class="ms-auto flex min-w-0 items-center gap-2 pe-2">
                            <span class="min-w-0 truncate text-ui-sm text-muted" dir="ltr">@{ handle }</span>
                            <Show when={ ranked }>
                                <Badge text={ roleWord } tone="accent" />
                            </Show>
                        </div>
                    </div>
                </header>

                <main id="admin-main" class="min-w-0 px-4 pb-[calc(var(--nav-room)+1.5rem)] pt-5 sm:px-6 md:px-8 md:pb-12 md:pt-8">
                    <div class="mx-auto w-full max-w-[80rem]">
                        <Outlet children={ props.children } />
                    </div>
                </main>
            </div>

            <nav class="pointer-events-none fixed inset-x-0 bottom-0 z-30 px-3 pt-2 pb-[calc(env(safe-area-inset-bottom,0px)+0.5rem)] md:hidden" aria-label={ locale.t('admin.sections') } data-tabs>
                <ul class={ () => `pointer-events-auto mx-auto grid h-[var(--nav-h)] w-full max-w-[28rem] ${ columns } rounded-full border border-line/70 bg-void/80 px-1.5 shadow-[var(--shadow-2)] backdrop-blur-xl backdrop-saturate-150` }>
                    <For each={ tabs } key={ (item) => item.section } let={ item }>
                        <li class="flex min-w-0">
                            <Link
                                to={ item.to }
                                aria-current={ here === item.section ? 'page' : undefined }
                                class="flex min-w-0 flex-1 flex-col items-center justify-center gap-1 rounded-full text-ui-2xs font-semibold text-muted transition-colors duration-150 aria-[current=page]:text-accent"
                            >
                                <span class="relative flex h-6 w-10 items-center justify-center">
                                    <Icon name={ item.icon } size={ 22 } />
                                    <span class="absolute -end-0.5 -top-1.5">
                                        <Badge count={ item.section === 'reports' ? waiting : 0 } tone="gold" label={ waitingLabel } />
                                    </span>
                                </span>
                                <span class="max-w-full truncate px-0.5">{ item.label }</span>
                            </Link>
                        </li>
                    </For>
                    <Show when={ extra }>
                        <li class="flex min-w-0">
                            <button
                                type="button"
                                aria-haspopup="dialog"
                                data-current={ elsewhere ? '' : undefined }
                                onClick={ openMore }
                                class="flex min-w-0 flex-1 cursor-pointer flex-col items-center justify-center gap-1 rounded-full text-ui-2xs font-semibold text-muted transition-colors duration-150 data-current:text-accent"
                                data-more-tab
                            >
                                <span class="flex h-6 w-10 items-center justify-center">
                                    <Icon name="more" size={ 22 } />
                                </span>
                                <span class="max-w-full truncate px-0.5">{ locale.t('admin.more') }</span>
                            </button>
                        </li>
                    </Show>
                </ul>
            </nav>
        </div>
        <OverlayHost />
        <ToastHost />
    </div>
}
