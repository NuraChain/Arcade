import type { GameId } from '../../data/games.ts';

import type { MenuPoint } from './actions.ts';
import ChatActions from './chat-actions.component.azeroth';
import ChatListItem from './chat-list-item.component.azeroth';
import { gameNameOf, groupNameOf, titleOf } from './chat-title.ts';
import ConversationMenu from './conversation-menu.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import LoadMore from '../ui/load-more.component.azeroth';
import SearchInput from '../ui/search-input.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import Tabs from '../ui/tabs.component.azeroth';
import { flip, motion, type MotionKit } from '../../lib/motion.ts';
import { runtime } from '../../lib/runtime.ts';
import { fold } from '../../services/search.service.ts';
import { useDevice } from '../../stores/device.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useGroups } from '../../stores/groups.store.ts';

const kept = { tab: 'all', scroll: 0 };

const MINUTE_MS = 60_000;

export default component ChatList(props: { active?: string; pane?: boolean; folded?: boolean; class?: string })
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const chat = useChat();
    const overlay = useOverlay();
    const groups = useGroups();
    const people = usePeople();
    const device = useDevice();

    const gameName = (game: GameId) => locale.t(catalogue.byId(game).nameKey);

    derived pane = props.pane === true;

    derived folded = props.folded === true;

    derived searching = !folded;

    state tab = props.pane === true ? kept.tab : 'all';
    state query = '';
    state menu = null as { id: string; at: MenuPoint } | null;

    /** What a row's time is measured against: a line of today says its time until midnight, then its weekday. */
    state now = runtime().clock.now();

    let scroller: HTMLElement | null = null;

    let rows: HTMLElement | null = null;

    let kit: MotionKit | null = null;

    const tops = new Map<string, number>();

    const hold = () =>
    {
        kept.scroll = scroller?.scrollTop ?? kept.scroll;
    };

    mount
    {
        void motion().then((loaded) => kit = loaded).catch(() => undefined);

        const untick = runtime().clock.every(MINUTE_MS, () => now = runtime().clock.now());

        if (scroller === null)
        {
            return untick;
        }
        scroller.scrollTop = kept.scroll;
        scroller.addEventListener('scroll', hold, { passive: true });
        return () =>
        {
            untick();
            scroller?.removeEventListener('scroll', hold);
        };
    }

    const choose = (id: string) =>
    {
        tab = id;
        if (pane)
        {
            kept.tab = id;
        }
    };

    derived all = chat.conversations();

    derived loading = chat.listLoading() && all.length === 0;

    derived failed = chat.listError() !== null;

    derived lost = failed && all.length === 0;

    derived mine = chat.me();

    derived filtered = (() =>
    {
        const needle = folded ? '' : fold(query);
        const byTab = all.filter((conversation) => folded || tab === 'all'
            || (tab === 'direct' && conversation.kind === 'direct')
            || (tab === 'groups' && conversation.kind === 'group')
            || (tab === 'games' && conversation.kind === 'game'));
        const matched = needle === ''
            ? byTab
            : byTab.filter((conversation) =>
            {
                const last = chat.lastOf(conversation.id);
                return fold(locale.text(titleOf(conversation, mine, people.byHandle, { group: groupNameOf(conversation, groups.byId), game: gameNameOf(conversation, gameName) }))).includes(needle)
                    || (last !== undefined && fold(locale.text(last.text)).includes(needle));
            });
        return [...matched].sort((a, b) =>
        {
            const pinA = chat.pinned(a.id);
            const pinB = chat.pinned(b.id);
            if (pinA !== pinB)
            {
                return pinA ? -1 : 1;
            }
            return (chat.lastOf(b.id)?.at ?? 0) - (chat.lastOf(a.id)?.at ?? 0);
        });
    })();

    derived none = filtered.length === 0;

    derived older = chat.hasMoreConversations() && query === '' && !folded;

    derived quietly = none && !folded;

    derived failedQuietly = lost && !folded;

    derived failedFolded = lost && folded;

    effect
    {
        const order = filtered.map((conversation) => conversation.id).join('|');

        if (order !== '')
        {
            requestAnimationFrame(() => (rows === null ? undefined : flip(rows, tops, kit, device.reducedMotion())));
        }
    }

    derived items = [
        { id: 'all', label: locale.t('chats.tab.all'), count: chat.totalUnread() },
        { id: 'direct', label: locale.t('chats.tab.direct') },
        { id: 'groups', label: locale.t('chats.tab.groups') },
        { id: 'games', label: locale.t('chats.tab.games') }
    ];

    <div class={ () => [ 'flex min-h-0 flex-col', props.class ?? '' ].filter(Boolean).join(' ') }>
        <Show when={ searching }>
            { () =>
                <div class={ () => pane ? 'shrink-0 px-3' : '' }>
                    <SearchInput
                        value={ query }
                        onInput={ (value) => query = value }
                        placeholder={ locale.t('chats.search') }
                        label={ locale.t('chats.search') }
                        class="mb-3"
                    />

                    <Tabs items={ items } value={ tab } label={ locale.t('app.nav.chats') } class="mb-2" onChange={ choose } />
                </div>
            }
        </Show>

        <div ref={ (element) => scroller = pane ? element : null } class={ () => pane ? 'min-h-0 flex-1 overflow-y-auto px-2 pb-3' : '' }>
            <Switch
                fallback={
                    <>
                        <ul
                            ref={ (element) => rows = element }
                            class={ () => folded
                                ? 'flex flex-col items-center gap-1'
                                : (pane
                                    ? 'flex flex-col gap-0.5'
                                    : 'flex flex-col divide-y divide-line rounded-panel border border-line bg-field px-1.5') }
                            aria-label={ locale.t('app.nav.chats') }
                        >
                            <For each={ filtered } key={ (conversation) => conversation.id } let={ conversation }>
                                <li data-flip={ conversation.id }>
                                    <ChatListItem
                                        conversation={ conversation }
                                        me={ mine }
                                        now={ now }
                                        active={ conversation.id === props.active }
                                        folded={ folded }
                                        onHold={ () => overlay.open(ChatActions, { conversationId: conversation.id }, { label: locale.t('chats.actions') }) }
                                        onMenu={ (at: MenuPoint) => menu = { id: conversation.id, at } }
                                        menued={ menu?.id === conversation.id }
                                    />
                                </li>
                            </For>
                        </ul>
                        <Show when={ older }>
                            { () => <LoadMore label={ locale.t('chats.older') } loading={ chat.listLoading() } class="pt-3" onMore={ () => chat.moreConversations() } /> }
                        </Show>
                    </>
                }
            >
                <Match when={ loading }>
                    <ul class="flex flex-col gap-0.5" aria-label={ locale.t('common.loading') } aria-busy="true">
                        <For each={ [0, 1, 2, 3, 4] } key={ (row) => row } let={ row }>
                            <li class="flex items-center gap-3 rounded-tile px-3 py-3">
                                <Skeleton class="h-11 w-11 shrink-0 rounded-full" />
                                <Show when={ searching }>
                                    { () =>
                                        <span class="flex min-w-0 flex-1 flex-col gap-2">
                                            <Skeleton class="h-3.5 w-32" />
                                            <Skeleton class={ row % 2 === 0 ? 'h-3 w-56' : 'h-3 w-40' } />
                                        </span>
                                    }
                                </Show>
                            </li>
                        </For>
                    </ul>
                </Match>
                <Match when={ failedFolded }>
                    <div class="flex justify-center py-3">
                        <IconButton icon="refresh" label={ locale.t('chats.loadFailed') } variant="ghost" tipSide="end" onClick={ () => void chat.refresh() } />
                    </div>
                </Match>
                <Match when={ failedQuietly }>
                    <EmptyState
                        icon="refresh"
                        title={ locale.t('chats.loadFailed') }
                        lead={ locale.t('chats.loadFailedLead') }
                        action={ locale.t('common.retry') }
                        onAction={ () => void chat.refresh() }
                        class="py-10"
                    />
                </Match>
                <Match when={ quietly }>
                    <EmptyState
                        icon="chats"
                        title={ locale.t(all.length === 0 ? 'chats.empty' : 'chats.emptyFiltered') }
                        lead={ all.length === 0 ? locale.t('chats.emptyLead') : undefined }
                        action={ locale.t('app.nav.friends') }
                        to="/app/friends"
                        class="py-10"
                    />
                </Match>
            </Switch>
        </div>

        <Show when={ menu } let={ open }>
            <ConversationMenu conversationId={ open.id } at={ open.at } onClose={ () => menu = null } />
        </Show>
    </div>
}
