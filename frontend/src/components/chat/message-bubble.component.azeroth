import { useNavigate } from 'azerothjs';

import type { Message, MessageLock } from '../../data/chat.ts';
import Icon from '../../icons/icon.component.azeroth';
import { isLineKey, namedParams } from '../../lib/lines.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { attachHold } from '../../lib/hold.ts';
import { boxOf } from '../../lib/anchor.ts';
import { fitBar } from '../../lib/hover-bar.ts';
import { aboutPerson } from '../../lib/person-menu.ts';
import { attachSwipeReply } from '../../lib/swipe-reply.ts';
import { QUICK_REACTIONS } from '../../data/emoji.ts';
import { isEmoji } from '../../lib/body.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useEmojiPop } from '../../stores/emoji-pop.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import type { MessageKey } from '../../locales/en.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import { plainOf } from '../../lib/markdown.ts';
import ReactionRow from './reaction-row.component.azeroth';
import RichText from './rich-text.component.azeroth';
import { jumboOf } from '../../lib/markdown-dom.ts';
import { STATUS_ICON, STATUS_WORDS } from './status.ts';
import type { MenuPoint } from './actions.ts';

const LOCKED: Record<MessageLock, MessageKey> = {
    'unknown-sender': 'locked.unknownSender',
    'bad-signature': 'locked.badSignature',
    'no-key': 'locked.noKey',
    'no-epoch-key': 'locked.noEpochKey',
    tampered: 'locked.tampered',
    expired: 'expiry.locked'
};

const ALARMING: MessageLock[] = ['bad-signature', 'tampered'];

const JOINED = {
    right: { top: 'rounded-tr-md', bottom: 'rounded-br-md', tail: 'rounded-br-[0.3rem]' },
    left: { top: 'rounded-tl-md', bottom: 'rounded-bl-md', tail: 'rounded-bl-[0.3rem]' }
};

export default component MessageBubble(props: {
    message: Message;
    me: string;
    first?: boolean;
    last?: boolean;
    avatar?: boolean;
    onActions?: (message: Message, pick?: boolean) => void;
    onMenu?: (message: Message, at: MenuPoint, anchor: HTMLElement) => void;
    onReply?: (message: Message) => void;
    onReact?: (message: Message, emoji: string) => void;
    onRetry?: (message: Message) => void;
    onDiscard?: (message: Message) => void;
    quoteOf?: (id: string) => Message | undefined;
    onJump?: (id: string) => void;
    replying?: boolean;

    /** The line the thread's search has brought the reader to. */
    found?: boolean;

    /** Its menu is open, and the bar beside it steps aside so that the two do not stand on each other. */
    menued?: boolean;

    /** Whose line stands just above, or null for a heading or a notice across the middle: the bar over a wide line keeps clear of it. */
    above?: string | null;
})
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const toasts = useToasts();
    const people = usePeople();
    const { navigate } = useNavigate();

    derived mine = props.message.from === props.me;

    derived first = props.first !== false;

    derived last = props.last !== false;

    derived crowd = props.avatar === true && !mine;

    derived joined = JOINED[mine === (locale.dir() === 'rtl') ? 'left' : 'right'];

    derived corners = [ first ? '' : joined.top, last ? joined.tail : joined.bottom ].filter(Boolean).join(' ');

    derived time = locale.date(props.message.at, { hour: 'numeric', minute: '2-digit' });

    /** The time, and that whoever wrote the line has changed it since. */
    derived stamp = props.message.edited === undefined ? time : `${ locale.t('chat.edited') } ${ time }`;

    derived typed = props.message.kind === 'text';

    derived noted = props.message.kind === 'system';

    derived scored = props.message.kind === 'result';

    derived invited = props.message.kind === 'invite';

    derived answering = props.message.reply !== undefined;

    let row: HTMLElement | null = null;

    let cue: HTMLElement | null = null;

    let toolbar: HTMLElement | null = null;

    let unhold: (() => void) | null = null;

    let unswipe: (() => void) | null = null;

    const holds = (element: HTMLElement) =>
    {
        unhold?.();
        unhold = props.onActions === undefined ? null : attachHold(element, () =>
        {
            if (props.message.outgoing === undefined)
            {
                props.onActions?.(props.message);
            }
        });
    };

    const device = useDevice();

    const pop = useEmojiPop();

    const settings = useSettings();

    derived quick = [...new Set([...(Array.isArray(settings.settings().recentEmoji) ? settings.settings().recentEmoji : []).filter(isEmoji), ...QUICK_REACTIONS])].slice(0, 3);

    const pickFor = (anchor: HTMLElement | null) =>
    {
        if (device.coarse() || anchor === null)
        {
            props.onActions?.(props.message, true);
            return;
        }

        pop.toggle({ anchor, pick: (emoji) => props.onReact?.(props.message, emoji), side: 'top', align: mine ? 'end' : 'start', keep: false });
    };

    /**
     * Lays the hover bar where the thread has room for it, measured each time it is about to show.
     * Until then it rests just inside the foot of its line, and its bridge spans only the gaps
     * `fitBar` leaves, so wherever it is laid the thread can scroll no further than before: a bar
     * hanging below the newest line made the thread's reach shrink at the first hover, and the
     * browser's clamp of that scroll closed a menu opened on the line.
     */
    const fit = () =>
    {
        const bar = toolbar;
        const column = bar?.parentElement ?? null;

        if (bar === null || column === null || row === null)
        {
            return;
        }

        const pane = row.closest('.overflow-y-auto');
        const place = fitBar(
            boxOf(row),
            boxOf(column),
            { width: bar.offsetWidth, height: bar.offsetHeight },
            {
                mine,
                rtl: locale.dir() === 'rtl',
                top: pane === null ? 0 : pane.getBoundingClientRect().top,
                ...(props.above === undefined ? {} : { above: props.above === null ? 'middle' : (props.above === props.me ? 'mine' : 'theirs') })
            }
        );

        bar.style.left = `${ Math.round(place.x) }px`;
        bar.style.top = `${ Math.round(place.y) }px`;
        bar.style.bottom = 'auto';
    };

    /** A right click opens the line's menu at the pointer, except on a link or a selection, which the browser's own menu serves. */
    const menu = (event: MouseEvent) =>
    {
        if (props.onMenu === undefined || !typed || locked !== null || !settled || device.coarse() || row === null)
        {
            return;
        }

        const link = event.target instanceof Element ? event.target.closest('a') : null;
        const chosen = window.getSelection();

        if (link !== null || (chosen !== null && !chosen.isCollapsed && row.contains(chosen.anchorNode)))
        {
            return;
        }

        event.preventDefault();
        props.onMenu(props.message, { x: event.clientX, y: event.clientY }, row);
    };

    mount
    {
        if (row !== null && props.onReply !== undefined)
        {
            unswipe = attachSwipeReply(row, cue, () => locale.dir() === 'rtl', () =>
            {
                if (props.message.outgoing === undefined)
                {
                    props.onReply?.(props.message);
                }
            });
        }

        return () =>
        {
            unhold?.();
            unswipe?.();
        };
    }

    derived person = people.byHandle(props.message.from) ?? null;

    derived firstName = person === null ? props.message.from : person.displayName.split(' ')[0];

    const nameOf = (handle: string) =>
    {
        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    derived said = (() =>
    {
        const line = props.message.line;
        if (line === undefined)
        {
            return locale.text(props.message.text);
        }
        return isLineKey(line.key)
            ? locale.t(line.key, namedParams(line.params, nameOf, locale.list))
            : '';
    })();

    derived winners = props.message.ref?.winners ?? [];

    derived others = winners.filter((handle) => handle !== props.me).map(nameOf);

    derived won = scored && winners.length > 0;

    derived locked = props.message.locked ?? null;

    derived relayed = props.message.forwarded === true && locked === null;

    derived quoted = props.message.reply === undefined ? undefined : props.quoteOf?.(props.message.reply);

    derived quoteName = ((): string =>
    {
        if (quoted === undefined || quoted.kind === 'deleted')
        {
            return '';
        }

        return quoted.from === props.me ? locale.t('common.you') : nameOf(quoted.from);
    })();

    derived quoteText = (() =>
    {
        if (quoted === undefined)
        {
            return locale.t('chat.quoteMissing');
        }

        if (quoted.kind === 'deleted')
        {
            return locale.t('chat.quoteDeleted');
        }

        return quoted.locked === undefined ? plainOf(quoted.text, locale.t('chat.spoilerPreview')) : locale.t(LOCKED[quoted.locked]);
    })();

    derived reactions = props.message.reactions ?? [];

    derived reacted = reactions.length > 0 && props.onReact !== undefined;

    derived jumbo = props.message.reply === undefined && props.message.forwarded !== true && jumboOf(said);

    derived alarming = locked !== null && ALARMING.includes(locked);

    derived ticked = mine && typed && locked === null;

    derived seen = props.message.read === true;

    derived settled = props.message.outgoing === undefined;

    derived failed = props.message.outgoing === 'failed';

    derived status = props.message.outgoing ?? (seen ? 'read' : 'sent');

    derived game = props.message.ref?.game === undefined ? null : catalogue.byId(props.message.ref.game);

    derived headline = (() =>
    {
        const played = game === null ? '' : locale.t(game.nameKey);

        if (others.length === winners.length)
        {
            return locale.plural('chat.result.title', others.length, { winners: locale.list(others), game: played });
        }

        return others.length === 0
            ? locale.t('chat.result.you', { game: played })
            : locale.t('chat.result.youAnd', { others: locale.list(others), game: played });
    })();

    const sitDown = () =>
    {
        if (game === null)
        {
            return;
        }
        const tableId = props.message.ref?.tableId;
        if (tableId === undefined)
        {
            toasts.show({ kind: 'info', text: locale.t('chat.invite.closed') });
            return;
        }
        navigate(`/app/play/${ tableId }`);
    };

    <Show
        when={ typed }
        fallback={
            <Show
                when={ noted }
                fallback={
                    <div class={ () => [
                        'flex w-full max-w-[22rem] flex-col gap-3 rounded-panel border p-3',
                        won ? 'border-win/40 bg-win/5' : (scored ? 'border-line bg-field' : 'border-accent/40 bg-accent/5'),
                        mine ? 'ms-auto' : ''
                    ].filter(Boolean).join(' ') }>
                        <div class="flex items-center gap-2.5">
                            <span class={ () => [
                                'flex h-9 w-9 shrink-0 items-center justify-center rounded-full',
                                won ? 'bg-win/20 text-win' : (scored ? 'bg-raised text-muted' : 'bg-accent/20 text-accent')
                            ].join(' ') }>
                                <Icon name={ won ? 'trophy' : (scored ? 'clock' : 'seat') } size={ 18 } />
                            </span>
                            <span class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-ui-base font-semibold text-text">
                                    { won
                                        ? headline
                                        : (scored
                                            ? (game === null ? '' : locale.t(game.nameKey))
                                            : locale.t(mine ? 'chat.invite.titleMine' : 'chat.invite.title', { name: firstName, game: game === null ? '' : locale.t(game.nameKey) })) }
                                </span>
                                <span class="truncate text-ui-xs text-muted">{ said }</span>
                            </span>
                        </div>
                        <Show when={ invited }>
                            { () => <Button variant="primary" size="sm" block leading="seat" onClick={ sitDown }>{ locale.t('chat.invite.join') }</Button> }
                        </Show>
                    </div>
                }
            >
                { () =>
                    <p class="mx-auto max-w-[26rem] rounded-full bg-raised/60 px-3 py-1 text-center text-ui-xs text-muted">
                        { said }
                    </p>
                }
            </Show>
        }
    >
        { () =>
            <div ref={ (element) => row = element } class={ () => [ 'group/row relative flex w-full touch-pan-y items-end gap-2', mine ? 'flex-row-reverse' : '' ].filter(Boolean).join(' ') } data-message={ props.message.id } onContextMenu={ menu } onPointerEnter={ fit } onFocusIn={ fit }>
                <Show when={ props.onReply !== undefined }>
                    { () =>
                        <span ref={ (element) => cue = element } class="pointer-events-none absolute end-1 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full bg-raised text-accent opacity-0" aria-hidden="true">
                            <Icon name="reply" size={ 16 } class="icon-flip" />
                        </span>
                    }
                </Show>
                <Show when={ crowd }>
                    { () =>
                        <span class="flex w-8 shrink-0 self-end">
                            <Show when={ last }>
                                { () =>
                                    <button
                                        type="button"
                                        data-inline
                                        class="shrink-0 cursor-pointer rounded-full"
                                        aria-haspopup="dialog"
                                        aria-label={ locale.t('actions.about', { name: person === null ? props.message.from : locale.text(person.displayName) }) }
                                        onClick={ () => aboutPerson(props.message.from) }
                                    >
                                        <Avatar person={ person } size="sm" />
                                    </button>
                                }
                            </Show>
                        </span>
                    }
                </Show>
                <div class={ () => [ 'relative flex min-w-0 max-w-[min(36rem,80%)] flex-col', mine ? 'items-end' : 'items-start' ].join(' ') }>
                    <Show when={ crowd && first }>
                        { () =>
                            <span class="mb-1 px-3 text-ui-2xs font-semibold" style={ `color: hsl(${ person?.hue ?? 210 } 72% 72%)` } dir="auto">{ firstName }</span>
                        }
                    </Show>
                    <Show when={ relayed }>
                        { () =>
                            <span class="mb-0.5 flex items-center gap-1 px-3 text-ui-2xs font-medium text-muted">
                                <Icon name="forward" size={ 12 } class="icon-flip" />
                                { locale.t('chat.forwarded') }
                            </span>
                        }
                    </Show>
                    <Show
                        when={ locked === null }
                        fallback={
                            <span
                                class={ () => [
                                    'flex items-start gap-2 rounded-tile border border-dashed px-3 py-2 text-ui-sm',
                                    alarming ? 'border-danger/50 bg-danger/10 text-danger' : 'border-line bg-field text-muted'
                                ].join(' ') }
                                role={ alarming ? 'alert' : undefined }
                            >
                                <Icon name={ alarming ? 'alert' : 'lock' } size={ 15 } class="mt-0.5 shrink-0" />
                                <span>{ locale.t(LOCKED[locked ?? 'no-key']) }</span>
                            </span>
                        }
                    >
                        { () =>
                            <span
                                ref={ holds }
                                dir="auto"
                                data-found={ props.found === true ? '' : undefined }
                                class={ () => [
                                    'bubble relative flex max-w-full flex-col rounded-[1.125rem] px-3 pb-1.5 pt-1.5 text-ui-base leading-snug transition-shadow duration-150',
                                    props.replying === true ? 'ring-2 ring-accent ring-offset-2 ring-offset-void' : (props.found === true ? 'ring-2 ring-gold ring-offset-2 ring-offset-void' : ''),
                                    props.onActions === undefined ? '' : 'holdable',
                                    jumbo ? 'bg-transparent text-text' : (mine ? 'bg-accent-fill text-accent-ink' : 'border border-line bg-field text-text'),
                                    corners
                                ].filter(Boolean).join(' ') }
                            >
                                <Show when={ answering }>
                                    { () =>
                                        <button
                                            type="button"
                                            class={ () => [
                                                'mb-1 flex min-w-0 max-w-full cursor-pointer flex-col items-start gap-0.5 rounded-tile border-s-[3px] px-2 py-1 text-start transition-colors',
                                                mine ? 'border-accent-ink/60 bg-black/15 hover:bg-black/25' : 'border-accent bg-raised/70 hover:bg-raised'
                                            ].join(' ') }
                                            aria-label={ locale.t('chat.jumpToQuote') }
                                            onClick={ () => props.onJump?.(props.message.reply ?? '') }
                                        >
                                            <Show when={ quoteName !== '' }>
                                                { () => <span class={ () => [ 'max-w-full truncate text-ui-2xs font-semibold', mine ? 'text-accent-ink' : 'text-accent' ].join(' ') } dir="auto">{ quoteName }</span> }
                                            </Show>
                                            <span class={ () => [ 'line-clamp-2 max-w-full text-ui-xs', mine ? 'text-accent-ink/80' : 'text-muted' ].join(' ') } dir="auto">{ quoteText }</span>
                                        </button>
                                    }
                                </Show>
                                <RichText text={ said } mine={ mine } reserve={ stamp } trail={ ticked } />
                                <time
                                    class={ () => [ 'absolute bottom-1 end-3 text-ui-2xs leading-none', mine && !jumbo ? 'text-accent-ink/70' : 'text-faint' ].join(' ') }
                                    datetime={ new Date(props.message.at).toISOString() }
                                >
                                    <span class="inline-flex items-center gap-0.5" dir={ locale.dir() }>
                                        { stamp }
                                        <Show when={ ticked }>
                                            { () =>
                                                <span class={ () => seen ? (jumbo ? 'flex text-accent' : 'flex text-accent-ink') : 'flex' } data-status={ status }>
                                                    <Icon name={ STATUS_ICON[status] } size={ 14 } />
                                                    <span class="sr-only">{ locale.t(STATUS_WORDS[status]) }</span>
                                                </span>
                                            }
                                        </Show>
                                    </span>
                                </time>
                            </span>
                        }
                    </Show>
                    <Show when={ props.onActions !== undefined && locked === null && settled && !device.coarse() }>
                        { () =>
                            <div
                                ref={ (element) => toolbar = element }
                                class={ () => [
                                    'pointer-events-none absolute bottom-1 left-0 z-10 hidden w-max items-center gap-0.5 rounded-full border border-line-strong bg-lifted p-0.5 shadow-lg shadow-black/30 opacity-0 transition-opacity duration-150 before:absolute before:-inset-x-2 before:-inset-y-1 before:-z-10 group-hover/row:pointer-events-auto group-hover/row:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 pointer-fine:flex motion-reduce:transition-none',
                                    pop.current()?.anchor === toolbar && toolbar !== null ? 'pointer-events-auto opacity-100' : '',
                                    props.menued === true ? 'invisible' : ''
                                ].filter(Boolean).join(' ') }
                            >
                                <Show when={ props.onReact !== undefined }>
                                    { () =>
                                        <span class="hidden items-center gap-0.5 @min-[32rem]/thread:flex">
                                            <For each={ quick } key={ (emoji) => emoji } let={ emoji }>
                                                <button
                                                    type="button"
                                                    class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full text-ui-lg transition-transform duration-150 hover:scale-115 hover:bg-raised motion-reduce:transition-none motion-reduce:hover:scale-100"
                                                    aria-label={ locale.t('chat.reactWith', { emoji: emoji }) }
                                                    onClick={ () => props.onReact?.(props.message, emoji) }
                                                >
                                                    { emoji }
                                                </button>
                                            </For>
                                            <span class="mx-0.5 h-5 w-px bg-line" aria-hidden="true"></span>
                                        </span>
                                    }
                                </Show>
                                <Show when={ props.onReact !== undefined }>
                                    { () => <IconButton icon="react" label={ locale.t('chat.react') } variant="ghost" size="sm" class="rounded-full!" onClick={ () => pickFor(toolbar) } /> }
                                </Show>
                                <Show when={ props.onReply !== undefined }>
                                    { () => <IconButton icon="reply" label={ locale.t('chat.reply') } variant="ghost" size="sm" flip class="rounded-full!" onClick={ () => props.onReply?.(props.message) } /> }
                                </Show>
                                <IconButton icon="more" label={ locale.t('chat.more') } variant="ghost" size="sm" class="rounded-full!" onClick={ () => props.onActions?.(props.message) } />
                            </div>
                        }
                    </Show>
                    <Show when={ failed }>
                        { () =>
                            <span class="mt-1 flex flex-wrap items-center justify-end gap-x-2 text-ui-xs text-danger" role="status">
                                <Icon name="alert" size={ 14 } class="shrink-0" />
                                { locale.t('chat.unsent') }
                                <button type="button" class="cursor-pointer font-semibold hover:underline coarse:min-h-11 coarse:px-1.5" onClick={ () => props.onRetry?.(props.message) }>{ locale.t('common.retry') }</button>
                                <button type="button" class="cursor-pointer font-semibold text-muted hover:underline coarse:min-h-11 coarse:px-1.5" onClick={ () => props.onDiscard?.(props.message) }>{ locale.t('chat.delete') }</button>
                            </span>
                        }
                    </Show>
                    <Show when={ reacted }>
                        { () =>
                            <ReactionRow
                                reactions={ reactions }
                                me={ props.me }
                                end={ mine }
                                onToggle={ (emoji) => props.onReact?.(props.message, emoji) }
                                onAdd={ (anchor) => pickFor(anchor) }
                            />
                        }
                    </Show>
                </div>
            </div>
        }
    </Show>
}
