import type { Message } from '../../data/chat.ts';
import { QUICK_REACTIONS } from '../../data/emoji.ts';
import Icon from '../../icons/icon.component.azeroth';
import { plainOf } from '../../lib/markdown.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import IconButton from '../ui/icon-button.component.azeroth';
import { flips, messageActions, type LineHandlers } from './actions.ts';
import LazyEmojiPicker from './lazy-emoji-picker.component.azeroth';

export default component MessageActions(props: OverlayProps & LineHandlers & {
    message: Message;
    me: string;
    pick?: boolean;
    onReact: (emoji: string) => void;
})
{
    const locale = useLocale();

    state picking = props.pick === true;

    derived preview = plainOf(props.message.text, locale.t('chat.spoilerPreview'));

    const react = (emoji: string) =>
    {
        props.close();
        props.onReact(emoji);
    };

    derived actions = messageActions(locale.t, props.message, props.me, props);

    <div class="flex flex-col gap-2 p-3">
        <header class="flex items-start gap-3 px-2 pt-1">
            <p class="line-clamp-2 min-w-0 flex-1 text-ui-sm text-muted" dir="auto">{ preview }</p>
            <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.close() } />
        </header>

        <Show
            when={ !picking }
            fallback={ <LazyEmojiPicker onPick={ react } /> }
        >
            { () =>
                <ul class="flex items-center justify-between gap-1 rounded-panel border border-line bg-sunk p-1.5" aria-label={ locale.t('chat.react') }>
                    <For each={ [...QUICK_REACTIONS] } key={ (emoji) => emoji } let={ emoji }>
                        <li class="flex-1">
                            <button
                                type="button"
                                class={ () => [
                                    'flex h-11 w-full cursor-pointer items-center justify-center rounded-tile text-ui-2xl transition-transform hover:scale-110 hover:bg-raised motion-reduce:transition-none motion-reduce:hover:scale-100',
                                    (props.message.reactions ?? []).some((one) => one.from === props.me && one.emoji === emoji) ? 'bg-accent/20' : ''
                                ].filter(Boolean).join(' ') }
                                aria-label={ locale.t('chat.reactWith', { emoji: emoji }) }
                                onClick={ () => react(emoji) }
                            >
                                { emoji }
                            </button>
                        </li>
                    </For>
                    <li class="flex-1">
                        <IconButton icon="react" label={ locale.t('chat.moreReactions') } variant="ghost" class="h-11! w-full!" onClick={ () => picking = true } />
                    </li>
                </ul>
            }
        </Show>

        <ul class="flex flex-col gap-0.5">
            <For each={ actions } key={ (action) => action.id } let={ action }>
                <li>
                    <button
                        type="button"
                        class={ () => [
                            'flex min-h-12 w-full cursor-pointer items-center gap-3 rounded-tile px-3 text-start text-ui-md transition-colors hover:bg-raised/70',
                            action.danger === true ? 'text-danger' : 'text-text'
                        ].join(' ') }
                        onClick={ () =>
                        {
                            props.close();
                            action.run();
                        } }
                    >
                        <Icon name={ action.icon } size={ 18 } class={ flips(action.icon) ? 'icon-flip' : undefined } />
                        { action.label }
                    </button>
                </li>
            </For>
        </ul>
    </div>
}
