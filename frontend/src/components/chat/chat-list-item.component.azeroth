import type { GameId } from '../../data/games.ts';
import { Link } from 'azerothjs';

import { isLineKey, namedParams } from '../../lib/lines.ts';
import type { Conversation } from '../../data/chat.ts';
import { attachHold } from '../../lib/hold.ts';
import Icon from '../../icons/icon.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import Badge from '../ui/badge.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';
import type { MenuPoint } from './actions.ts';
import ChatFace from './chat-face.component.azeroth';
import { gameNameOf, groupNameOf, titleOf } from './chat-title.ts';
import { stampOf } from './chat-time.ts';
import { plainOf } from '../../lib/markdown.ts';
import { STATUS_ICON, STATUS_WORDS } from './status.ts';

export default component ChatListItem(props: {
    conversation: Conversation;
    me: string;

    /** The moment its time is said against, which the list moves on once a minute. */
    now: number;
    active?: boolean;
    folded?: boolean;
    onHold?: () => void;
    onMenu?: (at: MenuPoint) => void;

    /** Its menu is open, so the row is marked as the one it acts on. */
    menued?: boolean;
})
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    const gameName = (game: GameId) => locale.t(catalogue.byId(game).nameKey);
    const social = useSocial();
    const chat = useChat();
    const groups = useGroups();
    const people = usePeople();
    const device = useDevice();

    let row: HTMLElement | null = null;

    mount
    {
        if (row === null || props.onHold === undefined)
        {
            return;
        }
        return attachHold(row, () => props.onHold?.());
    }

    /** A right click opens the conversation's menu at the pointer; a finger holds the row for its sheet. */
    const menu = (event: MouseEvent) =>
    {
        if (props.onMenu === undefined || device.coarse())
        {
            return;
        }

        event.preventDefault();
        props.onMenu({ x: event.clientX, y: event.clientY });
    };

    const nameOf = (handle: string) =>
    {
        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    derived title = locale.text(titleOf(props.conversation, props.me, people.byHandle, { group: groupNameOf(props.conversation, groups.byId), game: gameNameOf(props.conversation, gameName) }));

    derived folded = props.folded === true;

    derived last = chat.lastOf(props.conversation.id);

    derived starred = chat.pinned(props.conversation.id);

    derived unread = chat.unread(props.conversation.id);

    derived typing = chat.typing(props.conversation.id);

    derived muted = social.isMuted('conversation', props.conversation.id);

    derived said = last !== undefined && last.kind === 'text' && last.from === props.me && last.locked === undefined;

    derived seen = last?.read === true;

    derived status = last?.outgoing ?? (seen ? 'read' : 'sent');

    derived stamp = last === undefined ? '' : stampOf(locale, last.at, props.now);

    /** What the reader left unsent here, said in place of the last line while they are elsewhere. */
    derived draft = props.active === true ? '' : chat.draft(props.conversation.id).trim();

    derived drafted = draft !== '' && typing.length === 0;

    derived preview = (() =>
    {
        if (typing.length > 0)
        {
            const who = people.byHandle(typing[0]);
            return `${ who === null ? '' : `${ who.displayName.split(' ')[0] } ` }${ locale.t('chats.typing') }`;
        }
        if (drafted)
        {
            return plainOf(draft, locale.t('chat.spoilerPreview'));
        }
        if (last === undefined)
        {
            return locale.t(props.conversation.quiet ? 'chat.emptyQuiet' : 'chat.empty');
        }
        if (last.kind !== 'text')
        {
            const line = last.line;
            if (line !== undefined && isLineKey(line.key))
            {
                return locale.t(line.key, namedParams(line.params, nameOf, locale.list));
            }
            return locale.t(last.kind === 'invite'
                ? 'chats.invitePreview'
                : (last.kind === 'result' ? 'chats.resultPreview' : 'chats.systemPreview'));
        }
        const body = plainOf(locale.text(last.text), locale.t('chat.spoilerPreview'));
        return last.from === props.me ? `${ locale.t('chats.you') }${ body }` : body;
    })();

    <span ref={ (element) => row = element } class="contents" onContextMenu={ menu }>
        <Link
            to={ `/app/chats/${ props.conversation.id }` }
            class={ () => [
                folded
                    ? 'relative flex h-14 w-14 items-center justify-center rounded-tile'
                    : 'flex min-h-16 items-center gap-3 rounded-tile px-2 py-2.5',
                'transition-colors duration-150 hover:bg-raised/60',
                props.onHold === undefined ? '' : 'holdable',
                props.active === true ? 'bg-raised' : (props.menued === true ? 'bg-raised/60' : '')
            ].filter(Boolean).join(' ') }
            aria-label={ folded ? title : undefined }
            data-face={ folded ? '' : undefined }
            prefetch="viewport"
        >
            <Tooltip label={ folded ? title : '' } side="end" class="flex shrink-0">
                <ChatFace conversation={ props.conversation } me={ props.me } />
            </Tooltip>

            <span class={ () => folded ? 'hidden' : 'flex min-w-0 flex-1 flex-col gap-0.5' }>
                <span class="flex items-center gap-1.5">
                    <span class={ () => [ 'truncate text-ui-md', unread > 0 ? 'font-bold text-text' : 'font-semibold text-text' ].join(' ') } dir="auto">
                        { title }
                    </span>
                    <Show when={ starred }>
                        { () => <Icon name="star" size={ 12 } class="shrink-0 text-accent" /> }
                    </Show>
                    <Show when={ muted }>
                        { () => <Icon name="sound-off" size={ 12 } class="shrink-0 text-faint" /> }
                    </Show>
                </span>
                <span class={ () => [ 'truncate text-ui-sm', typing.length > 0 ? 'text-live' : (unread > 0 && !drafted ? 'text-text' : 'text-muted') ].join(' ') }>
                    <Show when={ drafted }>
                        { () => <span class="me-1 text-danger" data-draft>{ locale.t('chats.draft') }</span> }
                    </Show>
                    <span dir="auto">{ preview }</span>
                </span>
            </span>

            <span class={ () => folded ? 'absolute -end-0.5 -top-0.5' : 'flex shrink-0 flex-col items-end gap-1' }>
                <Show when={ last } let={ spoken }>
                    <span class={ () => folded ? 'hidden' : 'flex items-center gap-1 text-ui-2xs text-faint' }>
                        <Show when={ said }>
                            { () =>
                                <span class={ () => seen ? 'flex text-accent' : (status === 'failed' ? 'flex text-danger' : 'flex') } data-status={ status }>
                                    <Icon name={ STATUS_ICON[status] } size={ 14 } />
                                    <span class="sr-only">{ locale.t(STATUS_WORDS[status]) }</span>
                                </span>
                            }
                        </Show>
                        <time datetime={ new Date(spoken.at).toISOString() }>{ stamp }</time>
                    </span>
                </Show>
                <Show when={ unread > 0 }>
                    { () =>
                        <Show
                            when={ muted }
                            fallback={ <Badge count={ unread } tone="accent" label={ locale.plural('common.unread', unread) } /> }
                        >
                            { () => <Badge dot tone="neutral" label={ locale.plural('common.unread', unread) } /> }
                        </Show>
                    }
                </Show>
            </span>
        </Link>
    </span>
}
