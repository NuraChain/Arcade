import Button from '../ui/button.component.azeroth';
import { useConnect } from '../../stores/connect.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component PlayCta(props: { returning: boolean })
{
    const locale = useLocale();
    const connect = useConnect();

    <Show
        when={ props.returning }
        fallback={
            <span class="contents">
                <span class="glow-cta grid rounded-control">
                    <Button variant="primary" size="lg" leading="wallet" onClick={ () => connect.show() }>{ locale.t('landing.cta.start') }</Button>
                </span>
            </span>
        }
    >
        { () =>
            <span class="glow-cta grid rounded-control">
                <Button variant="primary" size="lg" leading="games" to="/app">{ locale.t('landing.cta.back') }</Button>
            </span>
        }
    </Show>
}
