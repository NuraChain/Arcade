import { useLocale } from '../../stores/locale.store.ts';

export default component SiteFooter()
{
    const locale = useLocale();

    const year = new Date().getFullYear();

    <footer class="relative z-10 border-t border-line bg-void">
        <div class="page-pad safe-b flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-3">
            <p class="text-ui-sm text-faint">
                <span class="tally">{ locale.n(year, { useGrouping: false }) }</span> { locale.t('brand.name') }. { locale.t('footer.rights') }
            </p>
            <a href="/#games" class="flex min-h-11 items-center text-ui-sm text-muted transition-colors duration-150 hover:text-accent">
                { locale.t('nav.games') }
            </a>
        </div>
    </footer>
}
