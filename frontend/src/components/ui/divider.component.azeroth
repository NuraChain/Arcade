export default component Divider(props: { label?: string; class?: string })
{
    <Show
        when={ props.label !== undefined }
        fallback={ <hr class={ [ 'border-0 border-t border-line', props.class ?? '' ].filter(Boolean).join(' ') } /> }
    >
        { () =>
            <div class={ [ 'flex items-center gap-3', props.class ?? '' ].filter(Boolean).join(' ') } role="separator" aria-label={ props.label }>
                <span class="h-px flex-1 bg-line"></span>
                <span class="label text-ui-xs text-faint">{ props.label }</span>
                <span class="h-px flex-1 bg-line"></span>
            </div>
        }
    </Show>
}
