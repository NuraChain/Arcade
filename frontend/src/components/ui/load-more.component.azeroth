import Button from './button.component.azeroth';
import type { IconName } from '../../icons/registry.ts';

export default component LoadMore(props: { label: string; loading?: boolean; icon?: IconName; class?: string; onMore: () => void })
{
    <div class={ [ 'flex justify-center pt-3', props.class ?? '' ].filter(Boolean).join(' ') }>
        <Button variant="outline" leading={ props.icon ?? 'chevron-down' } loading={ props.loading === true } class="min-w-[12rem]" onClick={ props.onMore }>
            { props.label }
        </Button>
    </div>
}
