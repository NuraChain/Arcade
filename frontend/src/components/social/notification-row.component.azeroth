import type { Notification } from '../../api.ts';
import { sayOf } from '../../lib/notifications.ts';
import { attempt } from '../../lib/attempt.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import NotificationLead from './notification-lead.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';

export default component NotificationRow(props: {
    item: Notification;
    onOpen: (item: Notification) => void;
    onDismiss: (id: string) => void;
})
{
    const locale = useLocale();
    const social = useSocial();
    const people = usePeople();

    derived person = props.item.actor === undefined ? null : (people.byHandle(props.item.actor) ?? null);

    derived who = person === null ? (props.item.actor ?? '') : person.displayName.split(' ')[0];

    derived said = sayOf(props.item, who, locale);

    derived asked = props.item.kind === 'friend-request'
        ? social.incoming().find((request) => request.from === props.item.actor)?.id ?? ''
        : '';

    derived answerable = asked !== '';

    <div class={ () => [
        'flex flex-col gap-2 px-3 py-2.5',
        props.item.read ? '' : 'bg-accent/5'
    ].filter(Boolean).join(' ') }>
        <div class="flex items-center gap-3">
            <button type="button" class="flex min-h-11 min-w-0 flex-1 cursor-pointer items-center gap-3 text-start" onClick={ () => props.onOpen(props.item) }>
                <NotificationLead item={ props.item } person={ person } />
                <span class="flex min-w-0 flex-1 flex-col">
                    <span class={ () => [ 'line-clamp-2 text-ui-base', props.item.read ? 'text-muted' : 'text-text' ].join(' ') }>
                        { said }
                    </span>
                    <span class="tally text-ui-xs text-faint">{ locale.relative(Date.parse(props.item.at)) }</span>
                </span>
            </button>
            <Show when={ !props.item.read }>
                { () => <span class="h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span> }
            </Show>
            <IconButton
                icon="close"
                label={ locale.t('notifications.dismiss') }
                variant="ghost"
                size="sm"
                onClick={ () => props.onDismiss(props.item.id) }
            />
        </div>

        <Show when={ answerable }>
            { () =>
                <div class="flex gap-2 ps-13">
                    <Button
                        variant="primary"
                        size="sm"
                        loading={ asked !== '' && social.working(asked) }
                        onClick={ () =>
                        {
                            if (asked !== '')
                            {
                                void attempt(social.accept(asked));
                            }
                        } }
                    >
                        { locale.t('person.accept') }
                    </Button>
                    <Button
                        variant="ghost"
                        size="sm"
                        disabled={ asked !== '' && social.working(asked) }
                        onClick={ () =>
                        {
                            if (asked !== '')
                            {
                                void attempt(social.decline(asked));
                            }
                        } }
                    >
                        { locale.t('person.decline') }
                    </Button>
                </div>
            }
        </Show>
    </div>
}
