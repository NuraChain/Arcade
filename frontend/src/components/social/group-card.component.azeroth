import { Link } from 'azerothjs';

import type { GroupSummary } from '../../api.ts';
import type { GameId } from '../../data/games.ts';
import type { Person } from '../../data/person.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import AvatarGroup from '../ui/avatar-group.component.azeroth';
import GroupCrest from './group-crest.component.azeroth';
import { PANEL_HOVER, PANEL_TONE } from '../ui/variants.ts';

export default component GroupCard(props: { group: GroupSummary; class?: string })
{
    const locale = useLocale();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const people = usePeople();

    derived members = props.group.members
        .map((id) => people.byHandle(id))
        .filter((person): person is Person => person !== null);

    derived online = props.group.members.filter((id) => presence.isOnline(id)).length;

    derived lively = online > 0;

    <Link
        to={ `/app/groups/${ props.group.id }` }
        class={ [ `flex min-w-0 items-center gap-2.5 rounded-panel p-2.5 transition duration-200 ${ PANEL_TONE.field } ${ PANEL_HOVER.field }`, props.class ?? '' ].filter(Boolean).join(' ') }
        prefetch="hover"
    >
        <GroupCrest crest={ props.group.crest } hue={ props.group.hue } size="md" />
        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
            <span class="truncate text-ui-md font-semibold text-text" dir="auto">{ props.group.name }</span>
            <span data-facts class="flex min-w-0 items-center gap-1.5 text-ui-xs text-muted">
                <span class="shrink-0">{ locale.plural('chat.members', props.group.memberCount) }</span>
                <Show when={ lively }>
                    <span class="flex shrink-0 items-center gap-1.5 text-live">
                        <span class="h-1 w-1 shrink-0 rounded-full bg-faint" aria-hidden="true"></span>
                        { locale.plural('chat.online', online) }
                    </span>
                </Show>
                <Show when={ props.group.game } let={ game }>
                    <span class="flex min-w-0 items-center gap-1.5">
                        <span class="h-1 w-1 shrink-0 rounded-full bg-faint" aria-hidden="true"></span>
                        <span class="truncate">{ locale.t(catalogue.byId(game as GameId).nameKey) }</span>
                    </span>
                </Show>
            </span>
        </span>
        <AvatarGroup people={ members } size="xs" max={ 3 } class="hidden shrink-0 @xs:flex" />
    </Link>
}
