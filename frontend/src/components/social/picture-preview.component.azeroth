import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import Button from '../ui/button.component.azeroth';

export default component PicturePreview(props: OverlayProps & { src: string; name: string })
{
    const locale = useLocale();

    derived file = `${ props.name.replace(/[^\p{L}\p{N}._-]+/gu, '-') || 'picture' }.${ props.src.split('.').pop() ?? 'webp' }`;

    <div class="flex flex-col gap-4 p-5">
        <img
            src={ props.src }
            alt={ locale.t('profile.pictureOf', { name: props.name }) }
            class="aspect-square w-full rounded-panel border border-line bg-sunk object-cover"
        />
        <div class="flex justify-end gap-2">
            <Button variant="ghost" onClick={ () => props.close() }>{ locale.t('common.close') }</Button>
            <Button variant="primary" leading="download" href={ props.src } download={ file }>{ locale.t('profile.pictureDownload') }</Button>
        </div>
    </div>
}
