import type { GameId } from '../../data/games.ts';
import { Link, untrack, useHead, useParams, useRoute } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import { gameNameOf, groupNameOf, othersOf, sealSentenceOf, titleOf } from '../../components/chat/chat-title.ts';
import { sendBlockOf } from '../../lib/seal-state.ts';
import { attachStick } from '../../lib/stick.ts';
import { runtime } from '../../lib/runtime.ts';
import { haptic } from '../../lib/haptics.ts';
import { threadRows } from '../../lib/thread.ts';
import ChatList from '../../components/chat/chat-list.component.azeroth';
import Composer from '../../components/chat/composer.component.azeroth';
import DayDivider from '../../components/chat/day-divider.component.azeroth';
import MessageBubble from '../../components/chat/message-bubble.component.azeroth';
import SealNotice from '../../components/chat/seal-notice.component.azeroth';
import QuietNote from '../../components/chat/quiet-note.component.azeroth';
import GroupCrest from '../../components/social/group-crest.component.azeroth';
import OpenHereSheet from '../../components/games/open-here-sheet.component.azeroth';
import PersonActions from '../../components/social/person-actions.component.azeroth';
import ConfirmSheet from '../../components/app/confirm-sheet.component.azeroth';
import ForwardSheet from '../../components/chat/forward-sheet.component.azeroth';
import type { Message } from '../../data/chat.ts';
import { plainOf } from '../../lib/markdown.ts';
import { attempt } from '../../lib/attempt.ts';
import Avatar from '../../components/ui/avatar.component.azeroth';
import AvatarGroup from '../../components/ui/avatar-group.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import LoadMore from '../../components/ui/load-more.component.azeroth';
import { CHAT_WELL } from '../../components/ui/variants.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useDevices } from '../../stores/devices.store.ts';
import { useEnrolment } from '../../stores/enrolment.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useSeal } from '../../stores/seal.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

const CHATS = '/app/chats';


export default component ChatPage()
{
    const locale = useLocale();
    const social = useSocial();
    const chat = useChat();
    const people = usePeople();
    const groups = useGroups();
    const presence = usePresence();
    const catalogue = useCatalogue();

    const gameName = (game: GameId): string => locale.t(catalogue.byId(game).nameKey);
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const device = useDevice();
    const params = useParams();
    const route = useRoute();

    let list: HTMLElement | null = null;

    state near = true;

    derived id = params().id ?? '';

    const opened = untrack(() => params().id ?? '');

    derived conversation = chat.conversation(id) ?? null;

    derived quiet = conversation?.quiet === true;

    derived here = conversation !== null;

    derived missing = conversation === null && !chat.listLoading() && chat.conversations().length > 0;

    derived me = chat.me();

    derived others = conversation === null ? [] : othersOf(conversation, me, people.byHandle);

    derived group = conversation?.groupId === undefined || conversation?.groupId === null ? null : (groups.byId(conversation.groupId) ?? null);

    derived title = conversation === null
        ? locale.t(missing ? 'chat.notFound' : 'common.loading')
        : locale.text(titleOf(conversation, me, people.byHandle, { group: groupNameOf(conversation, groups.byId), game: gameNameOf(conversation, gameName) }));

    const seal = useSeal();
    const devices = useDevices();
    const enrolment = useEnrolment();
    const account = useAccount();

    derived all = chat.messages();

    derived messages = all.filter((message) => message.kind !== 'deleted');

    derived stop = sendBlockOf({
        sealability: seal.sealability(),
        readiness: devices.readiness(),
        known: devices.known(),
        isWallet: account.isWallet(),
        pending: seal.loading()
    });

    derived loading = chat.threadLoading() && messages.length === 0;

    derived failed = chat.threadError() !== null;

    derived rows = threadRows(messages);

    derived typing = chat.typing(id);

    derived online = others.filter((person) => presence.isOnline(person.id)).length;

    derived muted = social.isMuted('conversation', id);

    derived subtitle = ((): string =>
    {
        if (typing.length > 0)
        {
            return locale.t('chats.typing');
        }
        if (group !== null || others.length > 1)
        {
            return `${ locale.plural('chat.members', others.length + 1) } · ${ locale.plural('chat.online', online) }`;
        }
        const only = others[0];
        if (only === undefined)
        {
            return '';
        }
        const state = presence.of(only.id);
        if (!state.known)
        {
            return `@${ only.handle }`;
        }
        return locale.t(state.state === 'away' ? 'common.away' : 'common.online');
    })();

    useHead({ title: () => title });

    mount
    {
        const release = shell.claimTitle(() => title);
        const unstick = list === null ? null : attachStick(list, (value) => near = value);
        return () =>
        {
            unstick?.();
            release();

            if (untrack(chat.openId) === opened)
            {
                chat.closeThread();
            }
        };
    }

    effect
    {
        const tail = messages[messages.length - 1]?.id ?? '';
        const typists = typing.length;

        if (list !== null && untrack(() => near) && (tail !== '' || typists > 0))
        {
            list.scrollTop = list.scrollHeight;
        }
    }

    effect
    {
        const here = route().pathname;
        const mine = id;

        if (mine !== '' && here.startsWith(`${ CHATS }/`))
        {
            chat.openThread(mine);
        }
    }

    let anchor: { first: string; from: number } | null = null;

    const showEarlier = (): void =>
    {
        if (list !== null)
        {
            anchor = { first: messages[0]?.id ?? '', from: list.scrollHeight - list.scrollTop };
        }
        chat.earlier();
    };

    effect
    {
        const first = messages[0]?.id ?? '';
        const held = anchor;

        if (held !== null && first !== held.first)
        {
            anchor = null;
            requestAnimationFrame(() =>
            {
                if (list !== null)
                {
                    keepPlace(list, held.from);
                }
            });
        }
    }

    const keepPlace = (target: HTMLElement, from: number): void =>
    {
        const apply = (): void =>
        {
            target.scrollTop = target.scrollHeight - from;
        };

        apply();

        if (typeof ResizeObserver === 'undefined' || target.firstElementChild === null)
        {
            return;
        }

        const watch = new ResizeObserver(apply);
        const release = (): void =>
        {
            watch.disconnect();
            target.removeEventListener('wheel', release);
            target.removeEventListener('touchstart', release);
        };

        watch.observe(target.firstElementChild);
        target.addEventListener('wheel', release, { passive: true });
        target.addEventListener('touchstart', release, { passive: true });
        runtime().clock.after(1200, release);
    };

    derived readable = conversation === null ? '' : id;

    effect
    {
        if (readable !== '')
        {
            chat.markRead(readable);
        }
    }

    const send = (): void =>
    {
        void chat.send(id, chat.draft(id))
            .then(() => haptic('tick'))
            .catch((error) =>
            {
                toasts.show({ kind: 'error', text: sealSentenceOf(error, locale.t), dedupe: `chat-send-${ id }` });
            });
    };

    const warn = (error: unknown): void =>
    {
        toasts.show({ kind: 'error', text: sealSentenceOf(error, locale.t), dedupe: `chat-act-${ id }` });
    };

    const nameOf = (handle: string): string =>
    {
        if (handle === me)
        {
            return locale.t('common.you');
        }

        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    const quoteOf = (quoted: string): Message | undefined => all.find((message) => message.id === quoted);

    derived replying = ((): { name: string; text: string } | null =>
    {
        const target = chat.replyTo(id);

        return target === null ? null : { name: target.from === me ? locale.t('chat.yourself') : nameOf(target.from), text: plainOf(target.text, locale.t('chat.spoilerPreview')) };
    })();

    const reply = (message: Message): void =>
    {
        chat.setReplyTo(id, message);
        requestAnimationFrame(() => document.querySelector<HTMLTextAreaElement>('#chat-thread textarea')?.focus());
    };

    const react = (message: Message, emoji: string): void =>
    {
        void chat.react(message, emoji).then(() => haptic('tick')).catch(warn);
    };

    const flash = (target: Element): void =>
    {
        const bubble = target.querySelector('.bubble');
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        target.scrollIntoView({ block: 'center', behavior: still ? 'auto' : 'smooth' });
        bubble?.animate(
            [{ boxShadow: '0 0 0 3px var(--color-accent)' }, { boxShadow: '0 0 0 3px transparent' }],
            { duration: still ? 1 : 1400, easing: 'ease-out' }
        );
    };

    const jump = (quoted: string): void =>
    {
        const index = messages.findIndex((message) => message.id === quoted);

        if (index === -1)
        {
            toasts.show({ kind: 'info', text: locale.t(quoteOf(quoted)?.kind === 'deleted' ? 'chat.quoteDeleted' : 'chat.quoteMissing'), dedupe: 'chat-jump' });
            return;
        }

        requestAnimationFrame(() =>
        {
            const target = list?.querySelector(`[data-message="${ quoted }"]`);
            if (target !== null && target !== undefined)
            {
                flash(target);
            }
        });
    };

    const remove = async (message: Message): Promise<void> =>
    {
        const yes = await overlay.open(
            ConfirmSheet,
            { title: locale.t('chat.deleteConfirm'), lead: locale.t('chat.deleteLead'), confirm: locale.t('chat.delete'), destructive: true },
            { label: locale.t('chat.deleteConfirm') }
        ).closed;

        if (yes === true)
        {
            await chat.remove(message).then(() => toasts.show({ kind: 'info', text: locale.t('chat.deleted'), dedupe: 'chat-delete' })).catch(warn);
        }
    };

    const actions = (message: Message, pick?: boolean): void =>
    {
        const talk = !quiet;

        void import('../../components/chat/message-actions.component.azeroth').then((module) => overlay.open(
            module.default,
            {
                message,
                me,
                pick: pick === true,
                onReact: (emoji: string) => react(message, emoji),
                ...(talk ? { onReply: () => reply(message) } : {}),
                onForward: () => overlay.open(ForwardSheet, { message }, { label: locale.t('chat.forwardTitle') }),
                onDelete: () => void remove(message),
                onPerson: () => overlay.open(
                    PersonActions,
                    {
                        personId: message.from,
                        ...(message.frankingKey === undefined ? {} : {
                            disclose: {
                                conversationId: message.conversationId,
                                messageId: message.id,
                                text: message.plain ?? message.text,
                                frankingKey: message.frankingKey
                            }
                        })
                    },
                    { label: locale.t('actions.title') }
                )
            },
            { label: locale.t('chat.messageActions') }
        ));
    };

    const startGame = (): void =>
    {
        overlay.open(
            OpenHereSheet,
            { conversationId: id },
            { label: locale.t('openHere.title') }
        );
    };

    derived phone = device.posture() === 'phone';

    derived split = device.posture() === 'sidebar';

    derived crowd = group !== null || others.length > 1 || conversation?.kind === 'game';

    <Page padded={ false } fill label={ title } class="flex">
        <div class="flex h-full min-h-0 w-full">
            <Show when={ split }>
                { () =>
                    <aside class="flex w-[22rem] shrink-0 flex-col border-e border-line bg-void" aria-label={ locale.t('app.nav.chats') }>
                        <h2 class="shrink-0 px-4 pb-2.5 pt-4 text-ui-xl font-bold text-text">{ locale.t('app.nav.chats') }</h2>
                        <ChatList pane active={ id } class="min-h-0 flex-1" />
                    </aside>
                }
            </Show>

            <section id="chat-thread" class="@container flex min-w-0 flex-1 flex-col">
                <Show
                    when={ here }
                    fallback={
                        <Show
                            when={ missing }
                            fallback={
                                <p class="m-auto px-4 py-10 text-center text-ui-base text-muted">
                                    { locale.t('common.loading') }
                                </p>
                            }
                        >
                            { () =>
                                <div class="px-4 py-10">
                                    <EmptyState icon="chats" title={ locale.t('chat.notFound') } action={ locale.t('app.nav.chats') } to="/app/chats" />
                                </div>
                            }
                        </Show>
                    }
                >
                    { () =>
                        <div class="flex h-full min-h-0 flex-col">
                            <header class="safe-t z-topbar sticky top-0 flex min-h-15 items-center gap-1.5 border-b border-line bg-void/90 px-2 py-1.5 backdrop-blur-md sm:px-3">
                                <Show when={ phone }>
                                    { () => <IconButton icon="back" label={ locale.t('app.nav.back') } flip to="/app/chats" /> }
                                </Show>
                                <Show
                                    when={ group !== null }
                                    fallback={
                                        <Show when={ others.length === 1 } fallback={ <AvatarGroup people={ others } size="sm" max={ 2 } class="w-9 shrink-0" /> }>
                                            { () =>
                                                <Link to={ `/app/people/${ others[0].handle }` } class="flex h-11 w-10 shrink-0 items-center justify-center">
                                                    <Avatar person={ others[0] } size="sm" presence={ presence.dot(others[0].id) } />
                                                </Link>
                                            }
                                        </Show>
                                    }
                                >
                                    { () =>
                                        <Link to={ `/app/groups/${ group!.id }` } class="flex h-11 w-10 shrink-0 items-center justify-center" aria-label={ locale.t('chat.openGroup') }>
                                            <GroupCrest crest={ group!.crest } hue={ group!.hue } size="sm" />
                                        </Link>
                                    }
                                </Show>
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <h1 class="truncate text-ui-md font-semibold text-text" dir="auto">{ title }</h1>
                                    <span class={ () => [ 'truncate text-ui-xs', typing.length > 0 ? 'text-live' : 'text-muted' ].join(' ') } dir="auto">{ subtitle }</span>
                                </span>
                                <IconButton icon="dice" label={ locale.t('chat.gameMenu') } variant="ghost" onClick={ startGame } class="hidden @md:inline-flex" />
                                <IconButton
                                    icon={ muted ? 'sound-off' : 'sound' }
                                    label={ locale.t(muted ? 'chat.unmute' : 'chat.mute') }
                                    variant="ghost"
                                    pressed={ muted }
                                    onClick={ () => void attempt(social.toggleMute('conversation', id), { kind: 'info', text: locale.t(muted ? 'chat.unmutedDone' : 'chat.mutedDone') }) }
                                />
                                <Show when={ others.length === 1 }>
                                    { () =>
                                        <IconButton
                                            icon="more"
                                            label={ locale.t('actions.title') }
                                            variant="ghost"
                                            onClick={ () => overlay.open(PersonActions, { personId: others[0].id }, { label: locale.t('actions.title') }) }
                                        />
                                    }
                                </Show>
                            </header>

                            <div ref={ (element) => list = element } class={ [ CHAT_WELL, '@container/thread flex min-h-0 flex-1 flex-col overflow-y-auto overflow-x-hidden px-3 sm:px-5' ].join(' ') }>
                                <div class="mx-auto mt-auto flex w-full max-w-[48rem] flex-col pb-3 pt-4">
                                    <Show when={ !chat.hasEarlier() && stop === null && !seal.loading() && messages.length > 0 }>
                                        { () =>
                                            <div class="mx-auto mb-2 max-w-md rounded-tile border border-line bg-field/80">
                                                <SealNotice stop={ null } />
                                            </div>
                                        }
                                    </Show>

                                    <Show when={ chat.hasEarlier() }>
                                        { () => <LoadMore label={ locale.t('chat.earlier') } icon="history" loading={ chat.earlierLoading() } class="pb-2" onMore={ showEarlier } /> }
                                    </Show>

                                    <Switch
                                        fallback={
                                            <For each={ rows } key={ (row) => row.message.id } let={ row }>
                                                <div class={ () => row.first ? 'pt-3' : 'pt-0.5' }>
                                                    <Show when={ row.day }>
                                                        { () => <DayDivider at={ row.message.at } /> }
                                                    </Show>
                                                    <MessageBubble
                                                        message={ row.message }
                                                        me={ me }
                                                        first={ row.first }
                                                        last={ row.last }
                                                        avatar={ crowd }
                                                        onActions={ actions }
                                                        onReply={ quiet ? undefined : reply }
                                                        onReact={ quiet ? undefined : react }
                                                        quoteOf={ quoteOf }
                                                        onJump={ jump }
                                                        replying={ chat.replyTo(id)?.id === row.message.id }
                                                    />
                                                </div>
                                            </For>
                                        }
                                    >
                                        <Match when={ loading }>
                                            <div class="flex w-full flex-col gap-4 py-4" aria-hidden="true">
                                                <div class="flex animate-pulse flex-col items-start gap-1.5 motion-reduce:animate-none">
                                                    <span class="block h-10 w-44 rounded-[1.125rem] bg-field"></span>
                                                    <span class="block h-10 w-28 rounded-[1.125rem] bg-field"></span>
                                                </div>
                                                <div class="flex animate-pulse flex-col items-end gap-1.5 motion-reduce:animate-none">
                                                    <span class="block h-10 w-52 rounded-[1.125rem] bg-accent-fill/25"></span>
                                                    <span class="block h-10 w-24 rounded-[1.125rem] bg-accent-fill/25"></span>
                                                </div>
                                            </div>
                                        </Match>
                                        <Match when={ failed && messages.length === 0 }>
                                            <div class="flex flex-col items-center gap-3 py-16 text-center">
                                                <p class="text-ui-base text-muted">{ locale.t('chat.loadFailed') }</p>
                                                <Button variant="outline" size="sm" leading="refresh" onClick={ () => void chat.refresh() }>
                                                    { locale.t('common.retry') }
                                                </Button>
                                            </div>
                                        </Match>
                                        <Match when={ messages.length === 0 }>
                                            <div class="flex flex-col items-center gap-3 py-16 text-center">
                                                <Show
                                                    when={ group !== null }
                                                    fallback={
                                                        <Show when={ others.length === 1 } fallback={ <AvatarGroup people={ others } size="md" max={ 3 } /> }>
                                                            { () => <Avatar person={ others[0] } size="xl" /> }
                                                        </Show>
                                                    }
                                                >
                                                    { () => <GroupCrest crest={ group!.crest } hue={ group!.hue } size="lg" /> }
                                                </Show>
                                                <p class="text-ui-lg font-semibold text-text" dir="auto">{ title }</p>
                                                <p class="max-w-xs text-ui-sm text-muted">{ locale.t(quiet ? 'chat.emptyQuiet' : 'chat.empty') }</p>
                                                <Show when={ stop === null && !seal.loading() }>
                                                    { () =>
                                                        <div class="mt-1 max-w-md rounded-tile border border-line bg-field/80 text-start">
                                                            <SealNotice stop={ null } />
                                                        </div>
                                                    }
                                                </Show>
                                            </div>
                                        </Match>
                                    </Switch>

                                    <Show when={ typing.length > 0 }>
                                        { () =>
                                            <div class="flex items-end gap-2 pt-3">
                                                <span class="flex items-center gap-1 rounded-[1.125rem] rounded-es-[0.3rem] border border-line bg-field px-3.5 py-3" aria-hidden="true">
                                                    <span class="inline-1.5 block-1.5 rounded-[9999px] bg-muted animate-[typing-bob_1.2s_var(--ease-ui)_infinite] motion-reduce:animate-none motion-reduce:opacity-70"></span>
                                                    <span class="inline-1.5 block-1.5 rounded-[9999px] bg-muted animate-[typing-bob_1.2s_var(--ease-ui)_0.15s_infinite] motion-reduce:animate-none motion-reduce:opacity-70"></span>
                                                    <span class="inline-1.5 block-1.5 rounded-[9999px] bg-muted animate-[typing-bob_1.2s_var(--ease-ui)_0.3s_infinite] motion-reduce:animate-none motion-reduce:opacity-70"></span>
                                                </span>
                                                <span class="sr-only">{ locale.text(people.byHandle(typing[0])?.displayName ?? { en: typing[0], fa: typing[0] }) } { locale.t('chats.typing') }</span>
                                            </div>
                                        }
                                    </Show>
                                </div>
                            </div>

                            <Show when={ quiet }>
                                { () =>
                                    <div class="border-t border-line bg-void px-3 py-3">
                                        <QuietNote class="mx-auto w-full max-w-[48rem]" />
                                    </div>
                                }
                            </Show>

                            <Show when={ !quiet && !seal.loading() && stop !== null }>
                                { () =>
                                    <div class="border-t border-line bg-void px-3 pt-2">
                                        <div class="mx-auto w-full max-w-[48rem]">
                                            <SealNotice
                                                stop={ stop }
                                                action={ stop?.reason !== 'browser' || stop.readiness === 'unsupported'
                                                    ? undefined
                                                    : (stop.readiness === 'absent'
                                                        ? <Button variant="primary" size="sm" leading="key" loading={ devices.busy() } onClick={ () => void enrolment.give() }>
                                                            { locale.t('devices.enrol') }
                                                        </Button>
                                                        : <Button variant="outline" size="sm" leading="key" to="/app/me/devices">
                                                            { locale.t('devices.title') }
                                                        </Button>) }
                                            />
                                        </div>
                                    </div>
                                }
                            </Show>

                            <Show when={ !quiet }>
                                { () =>
                                    <Composer
                                        value={ chat.draft(id) }
                                        reply={ replying }
                                        onCancelReply={ () => chat.setReplyTo(id, null) }
                                        disabled={ stop !== null }
                                        onInput={ (value) => chat.setDraft(id, value) }
                                        onSend={ send }
                                        onGame={ startGame }
                                    />
                                }
                            </Show>
                        </div>
                    }
                </Show>
            </section>
        </div>
    </Page>
}
