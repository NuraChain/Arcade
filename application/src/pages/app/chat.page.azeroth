import { Link, useHead, useNavigate, useParams } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import { groupNameOf, othersOf, sealSentenceOf, titleOf } from '../../components/chat/chat-title.ts';
import { sendBlockOf } from '../../lib/seal-state.ts';
import { haptic } from '../../lib/haptics.ts';
import Composer from '../../components/chat/composer.component.azeroth';
import MessageBubble from '../../components/chat/message-bubble.component.azeroth';
import SealNotice from '../../components/chat/seal-notice.component.azeroth';
import GroupCrest from '../../components/social/group-crest.component.azeroth';
import PersonActions from '../../components/social/person-actions.component.azeroth';
import Avatar from '../../components/ui/avatar.component.azeroth';
import AvatarGroup from '../../components/ui/avatar-group.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useDevices } from '../../stores/devices.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useSeal } from '../../stores/seal.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { useWallet } from '../../stores/wallet.store.ts';

const WINDOW = 40;

export default component ChatPage()
{
    const locale = useLocale();
    const social = useSocial();
    const chat = useChat();
    const people = usePeople();
    const groups = useGroups();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const device = useDevice();
    const params = useParams();
    const { navigate } = useNavigate();

    state visible = WINDOW;

    let list: HTMLElement | null = null;

    derived id = params().id ?? '';

    derived conversation = chat.conversation(id) ?? null;

    /**
     * Whether this conversation is genuinely not there, as opposed to not there YET.
     *
     * `chat.conversation(id)` reads the list, and on a cold load - somebody opening a link, or
     * reloading on this page - the list has not arrived. Rendering the fallback on "no row" alone
     * meant every cold load flashed "No such conversation" with a button back to the chats list,
     * for a thread that exists and is about to appear. A person who followed a link to a
     * conversation was told it did not exist.
     *
     * `npm run qa` cannot catch this: the matrix checks overflow, hit targets, a `main` landmark
     * and a dirty console, and a page confidently rendering the wrong answer passes all four.
     */
    derived missing = conversation === null && !chat.listLoading() && chat.conversations().length > 0;

    derived me = chat.me();

    derived others = conversation === null ? [] : othersOf(conversation, me, people.byHandle);

    derived group = conversation?.groupId === undefined || conversation?.groupId === null ? null : (groups.byId(conversation.groupId) ?? null);

    derived title = conversation === null
        ? locale.t(missing ? 'chat.notFound' : 'common.loading')
        : locale.text(titleOf(conversation, me, people.byHandle, groupNameOf(conversation, groups.byId)));

    const seal = useSeal();
    const devices = useDevices();
    const account = useAccount();
    const wallet = useWallet();

    /**
     * Gives this browser keys without leaving the thread.
     *
     * The devices page is the other door and stays the whole story - names, confirmation, signing one
     * out. This is the one step somebody stuck at a composer actually needs, offered where they are
     * stuck.
     *
     * `enrol` NEVER rejects: it swallows everything into `failure()`, so awaiting it and carrying on
     * would make a refused wallet signature silent - the button would spin, stop, and nothing would
     * change or be said. Every outcome is read back and spoken here.
     */
    const giveKeys = async (): Promise<void> =>
    {
        if (devices.busy())
        {
            return;
        }

        // A locked extension has no address to sign with, and `sign` answers null rather than
        // throwing - which `publish` turns into "the wallet did not sign", blaming a refusal that
        // never happened. Say the true thing instead.
        if (wallet.address() === null)
        {
            toasts.show({ kind: 'warning', text: locale.t('wallet.error.noWallet'), dedupe: 'devices.enrol' });
            return;
        }

        await devices.enrol(locale.t(device.posture() === 'phone' ? 'devices.namePhone' : 'devices.nameDesktop'));

        const failure = devices.failure();
        if (failure !== null)
        {
            toasts.show({
                kind: 'error',
                text: locale.t(failure === 'refused' ? 'devices.refused' : 'devices.unavailable'),
                dedupe: 'devices.enrol'
            });
            return;
        }

        // The room has to be asked again: whether it can be sealed to now depends on a device that
        // did not exist a moment ago.
        await seal.refresh();

        // On a SECOND browser the new device arrives pending, so nothing was unblocked and saying
        // "done" would be a lie. Confirming it needs a device that already exists, which lives on
        // the devices page.
        toasts.show({
            kind: devices.readiness() === 'ready' ? 'success' : 'warning',
            text: locale.t(devices.readiness() === 'ready' ? 'devices.enrolled' : 'devices.enrolledWaiting'),
            dedupe: 'devices.enrol'
        });
    };

    derived messages = chat.messages();

    /**
     * What stands in the way of sending, which is BOTH questions at once.
     *
     * The room's answer and this browser's answer come from different places and used to be read
     * separately: the composer was disabled on the room alone, while `post` refuses on this
     * browser's own keyring. `sendBlockOf` decides between them in one place, and being a pure
     * function it is pinned by a spec rather than by a rendered page.
     */
    derived stop = sendBlockOf({
        sealability: seal.sealability(),
        readiness: devices.readiness(),
        known: devices.known(),
        isWallet: account.isWallet(),
        pending: seal.loading()
    });

    derived loading = chat.threadLoading();

    derived failed = chat.threadError() !== null;

    derived shown = messages.slice(Math.max(0, messages.length - visible));

    derived hidden = messages.length - shown.length;

    derived typing = chat.typing(id);

    derived online = others.filter((person) => presence.isOnline(person.id)).length;

    derived muted = social.isMuted('conversation', id);

    derived subtitle = ((): string =>
    {
        if (typing.length > 0)
        {
            return locale.t('chats.typing');
        }
        if (group !== null || others.length > 1)
        {
            return `${ locale.plural('chat.members', others.length + 1) } · ${ locale.plural('chat.online', online) }`;
        }
        const only = others[0];
        if (only === undefined)
        {
            return '';
        }
        const state = presence.of(only.id);
        if (!state.known)
        {
            return `@${ only.handle }`;
        }
        if (state.state === 'playing' && state.game !== null)
        {
            return locale.t('common.playing', { game: locale.t(catalogue.byId(state.game).nameKey) });
        }
        return locale.t(state.state === 'away' ? 'common.away' : 'common.online');
    })();

    useHead({ title: () => title });

    mount
    {
        const release = shell.claimTitle(() => title);
        return () =>
        {
            release();
            chat.closeThread();
        };
    }

    effect
    {
        const settled = messages.length + typing.length;
        if (list !== null && settled >= 0)
        {
            list.scrollTop = list.scrollHeight;
        }
    }

    effect
    {
        params();
        visible = WINDOW;
    }

    effect
    {
        chat.openThread(id);
    }

    const showEarlier = (): void =>
    {
        const anchor = list === null ? 0 : list.scrollHeight - list.scrollTop;
        visible += WINDOW;
        requestAnimationFrame(() =>
        {
            if (list !== null)
            {
                list.scrollTop = list.scrollHeight - anchor;
            }
        });
    };

    effect
    {
        if (conversation !== null)
        {
            chat.markRead(id);
        }
    }

    /**
     * Sends, or says why it could not.
     *
     * There is no unsealed message any more, so a thread nobody can be sealed to is a thread
     * nothing can be said in. The composer is disabled for exactly that reason and the notice above
     * it names the person in the way - but the keyboard can still reach a disabled control's form,
     * and a failure that reached the console instead of the screen is what the browser pass found.
     */
    const send = (): void =>
    {
        void chat.send(id, chat.draft(id))
            .then(() => haptic('tick'))
            .catch((error) =>
            {
                toasts.show({ kind: 'error', text: sealSentenceOf(error, locale.t), dedupe: `chat-send-${ id }` });
            });
    };

    const openTable = (game: Parameters<typeof lobby.host>[0]): void =>
    {
        const invitees = others.map((person) => person.id);
        const config = catalogue.defaults(game);
        // The invite CARD is a server-authored line, and the server cannot author one about a
        // table it does not know about yet. Opening the table from here still works; the card
        // comes back when tables are real.
        const tableId = lobby.host(game, { ...config, seats: Math.max(config.seats, Math.min(invitees.length + 1, config.seats)) }, invitees);
        toasts.show({ kind: 'success', text: locale.t('chat.inviteSent') });
        navigate(`/app/play/${ tableId }`);
    };

    derived phone = device.posture() === 'phone';

    <Page padded={ false } width="full" fill label={ title } class="flex flex-col">
        <Show
            when={ conversation !== null }
            fallback={
                <Show
                    when={ missing }
                    fallback={
                        <p class="m-auto px-4 py-10 text-center text-ui-base text-muted">
                            { locale.t('common.loading') }
                        </p>
                    }
                >
                    { () =>
                        <div class="px-4 py-10">
                            <EmptyState icon="chats" title={ locale.t('chat.notFound') } action={ locale.t('app.nav.chats') } to="/app/chats" />
                        </div>
                    }
                </Show>
            }
        >
            { () =>
                <div class="flex h-full min-h-0 flex-col">
                    <header class="glass safe-t z-topbar sticky top-0 flex items-center gap-1 border-b border-line px-1.5 py-1.5">
                        <Show when={ phone }>
                            { () => <IconButton icon="back" label={ locale.t('app.nav.back') } flip to="/app/chats" /> }
                        </Show>
                        <Show
                            when={ group !== null }
                            fallback={
                                <Show when={ others.length === 1 } fallback={ <AvatarGroup people={ others } size="sm" max={ 2 } class="w-9 shrink-0" /> }>
                                    { () =>
                                        <Link to={ `/app/people/${ others[0].handle }` } class="flex h-11 w-10 shrink-0 items-center justify-center">
                                            <Avatar person={ others[0] } size="sm" presence={ presence.dot(others[0].id) } />
                                        </Link>
                                    }
                                </Show>
                            }
                        >
                            { () =>
                                <Link to={ `/app/groups/${ group!.id }` } class="flex h-11 w-10 shrink-0 items-center justify-center" aria-label={ locale.t('chat.openGroup') }>
                                    <GroupCrest crest={ group!.crest } hue={ group!.hue } size="sm" />
                                </Link>
                            }
                        </Show>
                        <span class="flex min-w-0 flex-1 flex-col">
                            <span class="truncate text-ui-base font-semibold text-text">{ title }</span>
                            <span class={ [ 'truncate text-ui-xs', typing.length > 0 ? 'text-live' : 'text-muted' ].join(' ') }>{ subtitle }</span>
                        </span>
                        <Show when={ !phone }>
                            { () =>
                                <IconButton
                                    icon={ muted ? 'sound-off' : 'sound' }
                                    label={ locale.t(muted ? 'chat.unmute' : 'chat.mute') }
                                    variant="ghost"
                                    pressed={ muted }
                                    onClick={ () => void social.toggleMute('conversation', id) }
                                />
                            }
                        </Show>
                        <Show when={ others.length === 1 }>
                            { () =>
                                <IconButton
                                    icon="more"
                                    label={ locale.t('actions.title') }
                                    variant="ghost"
                                    onClick={ () => overlay.open(PersonActions, { personId: others[0].id }, { label: locale.t('actions.title') }) }
                                />
                            }
                        </Show>
                    </header>

                    <div ref={ (element) => list = element } class="flex min-h-0 flex-1 flex-col justify-end gap-3 overflow-y-auto px-4 py-4">
                        <Show when={ hidden > 0 }>
                            { () =>
                                <div class="flex justify-center pb-2">
                                    <Button variant="ghost" size="sm" leading="history" onClick={ showEarlier }>
                                        { locale.t('chat.earlier', { count: locale.n(hidden) }) }
                                    </Button>
                                </div>
                            }
                        </Show>
                        <Switch
                            fallback={
                                <For each={ shown } key={ (message) => message.id } let={ message } index={ index }>
                                    <div>
                                        <MessageBubble
                                            message={ message }
                                            me={ me }
                                            showAuthor={ index === 0 || shown[index - 1].from !== message.from }
                                            onHold={ (held) => overlay.open(
                                                PersonActions,
                                                {
                                                    personId: held.from,

                                                    // Only a message this browser actually opened
                                                    // can be disclosed: the franking key comes out
                                                    // of the ciphertext, so a locked message has
                                                    // none and there is nothing to prove.
                                                    ...(held.frankingKey === undefined ? {} : {
                                                        disclose: {
                                                            conversationId: held.conversationId,
                                                            messageId: held.id,
                                                            text: held.text,
                                                            frankingKey: held.frankingKey
                                                        }
                                                    })
                                                },
                                                { label: locale.t('actions.title') }
                                            ) }
                                        />
                                    </div>
                                </For>
                            }
                        >
                            <Match when={ loading }>
                                <div class="flex w-full flex-col gap-4 p-4" aria-hidden="true">
                                    <div class="flex animate-pulse items-end gap-2 motion-reduce:animate-none">
                                        <span class="h-8 w-8 shrink-0 rounded-full bg-raised"></span>
                                        <div class="flex flex-col gap-1.5">
                                            <span class="block h-10 w-44 rounded-panel bg-raised"></span>
                                            <span class="block h-10 w-28 rounded-panel bg-raised"></span>
                                        </div>
                                    </div>
                                    <div class="flex animate-pulse items-end justify-end gap-2 motion-reduce:animate-none">
                                        <div class="flex flex-col items-end gap-1.5">
                                            <span class="block h-10 w-52 rounded-panel bg-accent/15"></span>
                                            <span class="block h-10 w-24 rounded-panel bg-accent/15"></span>
                                        </div>
                                    </div>
                                    <div class="flex animate-pulse items-end gap-2 motion-reduce:animate-none">
                                        <span class="h-8 w-8 shrink-0 rounded-full bg-raised"></span>
                                        <span class="block h-10 w-36 rounded-panel bg-raised"></span>
                                    </div>
                                </div>
                            </Match>
                            <Match when={ failed && messages.length === 0 }>
                                <div class="m-auto flex flex-col items-center gap-3 text-center">
                                    <p class="text-ui-base text-muted">{ locale.t('chat.loadFailed') }</p>
                                    <Button variant="outline" size="sm" leading="refresh" onClick={ () => void chat.refresh() }>
                                        { locale.t('common.retry') }
                                    </Button>
                                </div>
                            </Match>
                            <Match when={ messages.length === 0 }>
                                <p class="m-auto text-center text-ui-base text-muted">{ locale.t('chat.empty') }</p>
                            </Match>
                        </Switch>
                        <Show when={ typing.length > 0 }>
                            { () =>
                                <p class="flex items-center gap-2 ps-10 text-ui-xs text-live">
                                    <span class="live-dot h-1.5 w-1.5 rounded-full animate-pulse motion-reduce:animate-none" aria-hidden="true"></span>
                                    { locale.text(people.byHandle(typing[0])?.displayName ?? { en: '', fa: '' }) } { locale.t('chats.typing') }
                                </p>
                            }
                        </Show>
                    </div>

                    <Show when={ !seal.loading() }>
                        { () =>
                            <div class="px-3 pb-2">
                                <SealNotice
                                    stop={ stop }
                                    action={ stop?.reason !== 'browser' || stop.readiness === 'unsupported'
                                        ? undefined
                                        : (stop.readiness === 'absent'
                                            ? <Button variant="primary" size="sm" leading="key" loading={ devices.busy() } onClick={ () => void giveKeys() }>
                                                { locale.t('devices.enrol') }
                                            </Button>
                                            : <Button variant="outline" size="sm" leading="key" to="/app/me/devices">
                                                { locale.t('devices.title') }
                                            </Button>) }
                                />
                            </div>
                        }
                    </Show>

                    <Composer
                        value={ chat.draft(id) }
                        disabled={ stop !== null }
                        onInput={ (value) => chat.setDraft(id, value) }
                        onSend={ send }
                        onGame={ openTable }
                    />
                </div>
            }
        </Show>
    </Page>
}
