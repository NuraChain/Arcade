import LoadMore from '../../components/ui/load-more.component.azeroth';
import { useHead, useNavigate } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import NotificationRow from '../../components/social/notification-row.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import type { Notification } from '../../api.ts';
import { targetOf } from '../../lib/notifications.ts';
import { runtime } from '../../lib/runtime.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';
import { usePresence } from '../../stores/presence.store.ts';

export default component NotificationsPage()
{
    const locale = useLocale();
    const notifications = useNotifications();
    const presence = usePresence();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('app.nav.notifications') });

    derived items = notifications.items();

    derived dayStart = ((): number =>
    {
        const reference = new Date(runtime().clock.now());
        reference.setHours(0, 0, 0, 0);
        return reference.getTime();
    })();

    derived today = items.filter((item) => Date.parse(item.at) >= dayStart);

    derived earlier = items.filter((item) => Date.parse(item.at) < dayStart);

    const open = (item: Notification): void =>
    {
        void notifications.markRead(item.id);
        const target = targetOf(item);
        if (target !== null)
        {
            navigate(target);
        }
    };

    <Page label={ locale.t('app.nav.notifications') } onRefresh={ () => presence.refresh() }>
        <header class="flex flex-wrap items-end justify-between gap-3 pb-4">
            <div>
                <h1 class="title text-ui-3xl">{ locale.t('app.nav.notifications') }</h1>
                <p class="mt-2 text-ui-md text-muted">{ locale.t('notifications.lead') }</p>
            </div>
            <Show when={ notifications.unread() > 0 }>
                { () => <Button variant="ghost" size="sm" leading="check-circle" onClick={ () => void notifications.markAllRead() }>{ locale.t('notifications.markAll') }</Button> }
            </Show>
        </header>

        <Show
            when={ items.length > 0 }
            fallback={ <EmptyState icon="bell" title={ locale.t('notifications.empty') } lead={ locale.t('notifications.emptyLead') } class="py-10" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <Show when={ today.length > 0 }>
                        <section>
                            <SectionHeading title={ locale.t('notifications.today') } />
                            <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field" aria-label={ locale.t('notifications.today') }>
                                <For each={ today } key={ (item) => item.id } let={ item }>
                                    <li>
                                        <NotificationRow item={ item } onOpen={ open } onDismiss={ (id) => void notifications.dismiss(id) } />
                                    </li>
                                </For>
                            </ul>
                        </section>
                    </Show>

                    <Show when={ earlier.length > 0 }>
                        <section>
                            <SectionHeading title={ locale.t('notifications.earlier') } />
                            <ul class="flex flex-col divide-y divide-line overflow-hidden rounded-panel border border-line bg-field" aria-label={ locale.t('notifications.earlier') }>
                                <For each={ earlier } key={ (item) => item.id } let={ item }>
                                    <li>
                                        <NotificationRow item={ item } onOpen={ open } onDismiss={ (id) => void notifications.dismiss(id) } />
                                    </li>
                                </For>
                            </ul>
                            <Show when={ notifications.hasMore() }>
                                { () =>
                                    <LoadMore label={ locale.t('common.more') } onMore={ () => void notifications.more() } />
                                }
                            </Show>
                        </section>
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
