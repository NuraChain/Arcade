import { useHead, useNavigate } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import NotificationRow from '../../components/social/notification-row.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import Pagination from '../../components/ui/pagination.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import { personById } from '../../data/mock/index.ts';
import type { Notification } from '../../data/mock/types.ts';
import { runtime } from '../../lib/runtime.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';
import { usePresence } from '../../stores/presence.store.ts';

const EARLIER_PAGE = 8;

export default component NotificationsPage()
{
    const locale = useLocale();
    const notifications = useNotifications();
    const presence = usePresence();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('app.nav.notifications') });

    state earlierPage = 1;

    derived items = notifications.items();

    derived dayStart = ((): number =>
    {
        const reference = new Date(runtime().clock.now());
        reference.setHours(0, 0, 0, 0);
        return reference.getTime();
    })();

    derived today = items.filter((item) => item.at >= dayStart);

    derived allEarlier = items.filter((item) => item.at < dayStart);

    derived earlier = allEarlier.slice(0, earlierPage * EARLIER_PAGE);

    const open = (item: Notification): void =>
    {
        notifications.markRead(item.id);
        // An invitation names the table it is for. There is nothing to reconstruct from a game
        // id and a sender: either the notification carries a table or it is too old to act on.
        if (item.kind === 'invite' && item.ref.tableId !== undefined)
        {
            navigate(`/app/play/${ item.ref.tableId }`);
            return;
        }
        if (item.ref.conversationId !== undefined)
        {
            navigate(`/app/chats/${ item.ref.conversationId }`);
            return;
        }
        if (item.from !== null)
        {
            navigate(`/app/people/${ personById(item.from)?.handle ?? item.from }`);
        }
    };

    <Page label={ locale.t('app.nav.notifications') } onRefresh={ () => presence.refresh() }>
        <header class="flex flex-wrap items-end justify-between gap-3 pb-4">
            <div>
                <h1 class="title text-ui-4xl">{ locale.t('app.nav.notifications') }</h1>
                <p class="mt-2 text-ui-md text-muted">{ locale.t('notifications.lead') }</p>
            </div>
            <Show when={ notifications.unread() > 0 }>
                { () => <Button variant="ghost" size="sm" leading="check-circle" onClick={ () => notifications.markAllRead() }>{ locale.t('notifications.markAll') }</Button> }
            </Show>
        </header>

        <Show
            when={ items.length > 0 }
            fallback={ <EmptyState icon="bell" title={ locale.t('notifications.empty') } lead={ locale.t('notifications.emptyLead') } class="py-10" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <Show when={ today.length > 0 }>
                        <section>
                            <SectionHeading title={ locale.t('notifications.today') } />
                            <ul class="flex flex-col gap-0.5" aria-label={ locale.t('notifications.today') }>
                                <For each={ today } key={ (item) => item.id } let={ item }>
                                    <li>
                                        <NotificationRow item={ item } onOpen={ open } onDismiss={ (id) => notifications.remove(id) } />
                                    </li>
                                </For>
                            </ul>
                        </section>
                    </Show>

                    <Show when={ earlier.length > 0 }>
                        <section>
                            <SectionHeading title={ locale.t('notifications.earlier') } />
                            <ul class="flex flex-col gap-0.5" aria-label={ locale.t('notifications.earlier') }>
                                <For each={ earlier } key={ (item) => item.id } let={ item }>
                                    <li>
                                        <NotificationRow item={ item } onOpen={ open } onDismiss={ (id) => notifications.remove(id) } />
                                    </li>
                                </For>
                            </ul>
                            <Pagination
                                total={ allEarlier.length }
                                size={ EARLIER_PAGE }
                                page={ earlierPage }
                                mode="more"
                                label={ locale.t('notifications.earlier') }
                                onPage={ (page) => earlierPage = page }
                            />
                        </section>
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
