import { useHead, useNavigate } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import GameGrid from '../../components/games/game-grid.component.azeroth';
import Chip from '../../components/ui/chip.component.azeroth';
import Rail from '../../components/ui/rail.component.azeroth';
import type { GameCategory, GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { openTable } from '../../lib/open-table.ts';

export default component GamesPage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('app.nav.games') });

    state filter = 'all' as 'all' | GameCategory;

    derived games = catalogue.games.filter((game) => filter === 'all' || game.category === filter);

    derived totals = catalogue.totals();

    const quickPlay = (game: GameId): void =>
    {
        openTable(lobby.quick(game), navigate);
    };

    <Page label={ locale.t('app.nav.games') } onRefresh={ () => catalogue.refresh() }>
        <header class="flex flex-col gap-3 pb-5 @2xl:flex-row @2xl:items-end @2xl:justify-between">
            <div class="flex flex-col gap-1.5">
                <h1 class="title text-ui-3xl">{ locale.t('app.nav.games') }</h1>
                <p class="text-ui-md text-muted">{ locale.t('games.lead') }</p>
            </div>
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-ui-sm text-muted">
                <span class="flex items-center gap-2">
                    <span class="live-dot h-2 w-2" aria-hidden="true"></span>
                    <span><span class="tally font-semibold text-text">{ locale.n(totals.playersOnline) }</span> { locale.plural('games.live.playingLabel', totals.playersOnline) }</span>
                </span>
                <span class="h-1 w-1 rounded-full bg-faint" aria-hidden="true"></span>
                <span><span class="tally font-semibold text-text">{ locale.n(totals.tablesOpen) }</span> { locale.plural('games.live.tablesLabel', totals.tablesOpen) }</span>
            </p>
        </header>

        <Rail label={ locale.t('games.filter.all') } bleed class="mb-5">
            <Chip selected={ filter === 'all' } onClick={ () => filter = 'all' }>{ locale.t('games.filter.all') }</Chip>
            <Chip icon="cards" selected={ filter === 'cards' } onClick={ () => filter = 'cards' }>{ locale.t('games.category.cards') }</Chip>
            <Chip icon="dice" selected={ filter === 'board' } onClick={ () => filter = 'board' }>{ locale.t('games.category.board') }</Chip>
        </Rail>

        <GameGrid games={ games } detailed label={ locale.t('app.nav.games') } onQuickPlay={ quickPlay } />
    </Page>
}
