import { useHead, useNavigate, useParams } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import CreateGameForm from '../../components/games/create-game-form.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component CreateGamePage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const params = useParams();
    const { navigate } = useNavigate();

    derived game = catalogue.bySlug(params().slug ?? '') ?? null;

    useHead({ title: () => locale.t('create.title') });

    <Page narrow label={ locale.t('create.title') }>
        <Show
            when={ game !== null }
            fallback={ <EmptyState icon="games" title={ locale.t('game.notFound') } action={ locale.t('app.nav.games') } to="/app/games" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <header>
                        <p class="label text-ui-xs text-faint">{ locale.t(game!.nameKey) }</p>
                        <h1 class="mt-1 text-display-md leading-none">{ locale.t('create.title') }</h1>
                        <p class="mt-2 text-ui-base text-muted">{ locale.t('create.lead') }</p>
                    </header>
                    <Show
                        when={ !catalogue.loading() }
                        fallback={
                            <div class="flex flex-col gap-6" aria-busy="true">
                                <Skeleton lines={ 3 } />
                                <Skeleton lines={ 4 } />
                            </div>
                        }
                    >
                        { () =>
                            <CreateGameForm game={ game! } onCreated={ (tableId) => navigate(`/app/play/${ tableId }`, { replace: true }) } />
                        }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
