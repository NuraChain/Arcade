import { Link, useHead, useNavigate } from 'azerothjs';

import type { MatchHistoryEntry } from '../../api.ts';
import Page from '../../components/app/page.component.azeroth';
import GameCard from '../../components/games/game-card.component.azeroth';
import GameTile from '../../components/games/game-tile.component.azeroth';
import TableRow from '../../components/games/table-row.component.azeroth';
import Avatar from '../../components/ui/avatar.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import type { Game, GameId } from '../../data/games.ts';
import type { Person } from '../../data/person.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import { openTable } from '../../lib/open-table.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useRecord } from '../../stores/record.store.ts';
import { useSocial } from '../../stores/social.store.ts';

const RESULT_ICON: Record<MatchHistoryEntry['result'], IconName> = {
    won: 'trophy',
    lost: 'dice',
    abandoned: 'sign-out'
};

export default component HomePage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const presence = usePresence();
    const people = usePeople();
    const social = useSocial();
    const record = useRecord();
    const device = useDevice();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('app.nav.home') });

    derived totals = catalogue.totals();

    derived games = [...catalogue.games].sort((a: Game, b: Game) =>
        Number(catalogue.playable(b.id)) - Number(catalogue.playable(a.id)));

    derived seated = lobby.seated();

    derived recent = record.history().slice(0, 4);

    derived friends = presence.online(social.friends())
        .map((id) => people.byHandle(id))
        .filter((person): person is Person => person !== null);

    derived panelShown = device.posture() === 'sidebar' && device.social();

    const quickPlay = (game: GameId): void =>
    {
        openTable(lobby.quick(game), navigate);
    };

    const said = (row: MatchHistoryEntry): string =>
        locale.t(`home.recent.${ row.result }`, { game: locale.t(catalogue.byId(row.game as GameId).nameKey) });

    const moved = (row: MatchHistoryEntry): number | null =>
        row.ratingAfter === undefined || row.ratingBefore === undefined || row.ratingAfter === row.ratingBefore
            ? null
            : row.ratingAfter - row.ratingBefore;

    mount
    {
        if (record.history().length === 0)
        {
            void record.more();
        }
    }

    <Page
        label={ locale.t('app.nav.home') }
        onRefresh={ () =>
        {
            presence.refresh();
            catalogue.refresh();
        } }
    >
        <div class="flex flex-col gap-8">
            <section class="hero-surface relative overflow-hidden rounded-hero px-5 py-6 @xl:px-7 @xl:py-7" aria-labelledby="home-hero">
                <div class="grid gap-6 @3xl:grid-cols-[minmax(0,1fr)_auto] @3xl:items-center">
                    <div class="min-w-0">
                        <p class="text-ui-xs font-semibold text-accent">{ locale.t('home.hero.eyebrow') }</p>
                        <h1 id="home-hero" class="title mt-2 text-ui-3xl @xl:text-ui-4xl">
                            <span class="block">{ locale.t('home.hero.lead') }</span>
                            <span class="block text-accent">{ locale.t('home.hero.accent') }</span>
                        </h1>
                        <p class="mt-3 max-w-[30rem] text-ui-md text-muted">{ locale.t('home.hero.body') }</p>
                        <div class="mt-5 flex flex-col gap-3 @md:flex-row @md:items-center @md:gap-5">
                            <span class="glow-cta flex shrink-0 rounded-control @md:inline-flex">
                                <Button variant="primary" size="lg" leading="play" icon="forward" block class="whitespace-nowrap" onClick={ () => quickPlay(catalogue.featured()) }>
                                    { locale.t('app.nav.quickPlay') }
                                </Button>
                            </span>
                            <p class="flex items-center justify-center gap-2 text-ui-sm text-muted @md:justify-start">
                                <span class="live-dot h-2 w-2" aria-hidden="true"></span>
                                <span><span class="tally">{ locale.n(totals.playersOnline) }</span> { locale.plural('home.hero.pulse', totals.playersOnline) }</span>
                            </p>
                        </div>
                    </div>
                    <ul class="hidden w-[27rem] grid-cols-4 gap-2.5 @3xl:grid" aria-label={ locale.t('app.nav.games') }>
                        <For each={ games } key={ (game) => game.id } let={ game }>
                            <li class="min-w-0"><GameTile game={ game } /></li>
                        </For>
                    </ul>
                </div>
            </section>

            <section class="@3xl:hidden" aria-labelledby="home-games">
                <SectionHeading id="home-games" title={ locale.t('app.nav.games') } more={ locale.t('common.seeAll') } to="/app/games" />
                <ul class="grid grid-cols-4 gap-2">
                    <For each={ games } key={ (game) => game.id } let={ game }>
                        <li class="min-w-0"><GameTile game={ game } /></li>
                    </For>
                </ul>
            </section>

            <section class="hidden @xl:block" aria-labelledby="home-featured">
                <SectionHeading id="home-featured" title={ locale.t('home.featured.title') } more={ locale.t('common.seeAll') } to="/app/games" />
                <ul class="grid grid-cols-2 gap-4 @3xl:grid-cols-4">
                    <For each={ games } key={ (game) => game.id } let={ game }>
                        <li class="flex min-w-0"><GameCard game={ game } class="flex-1" onQuickPlay={ quickPlay } /></li>
                    </For>
                </ul>
            </section>

            <div class="grid gap-8 @3xl:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] @3xl:gap-6">
                <Show when={ seated.length > 0 }>
                    <section aria-labelledby="home-continue">
                        <SectionHeading id="home-continue" title={ locale.t('home.continue.heading') } />
                        <ul class="grid gap-2.5 @2xl:grid-cols-2 @3xl:grid-cols-1 @5xl:grid-cols-2">
                            <For each={ seated } key={ (table) => table.id } let={ table }>
                                <li class="min-w-0"><TableRow table={ table } /></li>
                            </For>
                        </ul>
                    </section>
                </Show>

                <section class={ () => seated.length > 0 ? '' : '@3xl:col-span-2' } aria-labelledby="home-recent">
                    <SectionHeading id="home-recent" title={ locale.t('home.recent.title') } more={ locale.t('common.seeAll') } to="/app/me" />
                    <Show
                        when={ recent.length > 0 }
                        fallback={
                            <div class="flex items-center gap-3 rounded-panel border border-dashed border-line px-4 py-5">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-accent/12 text-accent">
                                    <Icon name="history" size={ 18 } />
                                </span>
                                <p class="text-ui-sm text-muted">{ locale.t('home.recent.empty') }</p>
                            </div>
                        }
                    >
                        { () =>
                            <ul class="flex flex-col rounded-panel border border-line bg-field px-3.5">
                                <For each={ recent } key={ (row) => row.id } let={ row }>
                                    <li class="flex min-h-14 items-center gap-3 border-b border-line py-2.5 last:border-b-0">
                                        <span class={ () => [
                                            'flex h-9 w-9 shrink-0 items-center justify-center rounded-full',
                                            row.result === 'won' ? 'bg-win/15 text-win' : (row.result === 'abandoned' ? 'bg-danger/12 text-danger' : 'bg-accent/12 text-accent')
                                        ].join(' ') }>
                                            <Icon name={ RESULT_ICON[row.result] } size={ 16 } />
                                        </span>
                                        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                            <span class="truncate text-ui-sm text-text">{ said(row) }</span>
                                            <span class="truncate text-ui-xs text-faint">{ locale.relative(Date.parse(row.finishedAt)) }</span>
                                        </span>
                                        <Show when={ moved(row) !== null }>
                                            { () =>
                                                <span class={ () => [ 'tally shrink-0 text-ui-sm font-semibold', moved(row)! > 0 ? 'text-win' : 'text-muted' ].join(' ') }>
                                                    { `${ moved(row)! > 0 ? '+' : '' }${ locale.n(moved(row)!) }` }
                                                </span>
                                            }
                                        </Show>
                                    </li>
                                </For>
                            </ul>
                        }
                    </Show>
                </section>
            </div>

            <Show when={ !panelShown }>
                <section aria-labelledby="home-friends">
                    <SectionHeading id="home-friends" title={ locale.t('home.friends.title') } more={ locale.t('common.seeAll') } to="/app/friends" />
                    <Show
                        when={ friends.length > 0 }
                        fallback={ <p class="rounded-panel border border-dashed border-line px-4 py-5 text-ui-sm text-muted">{ locale.t('shell.friends.empty') }</p> }
                    >
                        { () =>
                            <ul class="flex flex-col rounded-panel border border-line bg-field px-3.5">
                                <For each={ friends } key={ (person) => person.id } let={ person }>
                                    <li class="border-b border-line last:border-b-0">
                                        <Link to={ `/app/people/${ person.handle }` } class="group flex min-h-14 items-center gap-3 py-2.5">
                                            <Avatar person={ person } size="md" presence={ presence.dot(person.id) } />
                                            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                                <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ person.displayName }</span>
                                                <span class="truncate text-ui-xs text-muted">{ presence.dot(person.id) === 'away' ? locale.t('common.away') : locale.t('common.online') }</span>
                                            </span>
                                            <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint transition-colors group-hover:text-muted" />
                                        </Link>
                                    </li>
                                </For>
                            </ul>
                        }
                    </Show>
                </section>
            </Show>
        </div>
    </Page>
}
