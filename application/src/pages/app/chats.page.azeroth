import { useHead } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import ChatList from '../../components/chat/chat-list.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { useChat } from '../../stores/chat.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';

export default component ChatsPage()
{
    const locale = useLocale();
    const chat = useChat();
    const presence = usePresence();
    const device = useDevice();

    useHead({ title: () => locale.t('app.nav.chats') });

    derived split = device.posture() === 'sidebar';

    <Show
        when={ split }
        fallback={
            <Page
                label={ locale.t('app.nav.chats') }
                onRefresh={ () =>
                {
                    void chat.refresh();
                    presence.refresh();
                } }
            >
                <header class="pb-4">
                    <h1 class="title text-ui-3xl">{ locale.t('app.nav.chats') }</h1>
                    <p class="mt-2 text-ui-md text-muted">{ locale.t('chats.lead') }</p>
                </header>
                <ChatList />
            </Page>
        }
    >
        { () =>
            <Page padded={ false } fill label={ locale.t('app.nav.chats') } class="flex">
                <div class="flex h-full min-h-0 w-full">
                    <aside class="flex w-[22rem] shrink-0 flex-col border-e border-line bg-void" aria-label={ locale.t('app.nav.chats') }>
                        <h1 class="shrink-0 px-5 pb-3 pt-5 text-ui-2xl font-bold text-text">{ locale.t('app.nav.chats') }</h1>
                        <ChatList pane class="min-h-0 flex-1" />
                    </aside>
                    <div class="chat-well flex min-w-0 flex-1 flex-col items-center justify-center gap-3 px-6 text-center">
                        <span class="flex h-16 w-16 items-center justify-center rounded-full border border-line bg-field text-accent shadow-1">
                            <Icon name="chats" size={ 28 } />
                        </span>
                        <p class="text-ui-lg font-semibold text-text">{ locale.t('chats.pick') }</p>
                        <p class="max-w-xs text-ui-sm text-muted">{ locale.t('chats.pickLead') }</p>
                    </div>
                </div>
            </Page>
        }
    </Show>
}
