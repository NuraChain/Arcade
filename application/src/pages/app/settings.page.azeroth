import { useHead, useNavigate } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import FriendRow from '../../components/social/friend-row.component.azeroth';
import LanguageSwitch from '../../components/layout/language-switch.component.azeroth';
import ThemeSwitch from '../../components/layout/theme-switch.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import Slider from '../../components/ui/slider.component.azeroth';
import Toggle from '../../components/ui/switch.component.azeroth';
import { NURA_CHAIN } from '../../data/chain.ts';
import { personById } from '../../data/mock/index.ts';
import type { Person } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import { shortAddress } from '../../lib/wallet.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useConnection } from '../../stores/connection.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSession } from '../../stores/session.store.ts';
import { NOTIFICATION_CATEGORIES, useSettings } from '../../stores/settings.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { useWallet } from '../../stores/wallet.store.ts';
import type { MessageKey } from '../../locales/en.ts';

const PREMIUM: MessageKey[] = ['settings.premium.item.tables', 'settings.premium.item.frames', 'settings.premium.item.emotes', 'settings.premium.item.stats'];

export default component SettingsPage()
{
    const locale = useLocale();
    const account = useAccount();
    const session = useSession();
    const wallet = useWallet();
    const social = useSocial();
    const settings = useSettings();
    const connection = useConnection();
    const device = useDevice();
    const toasts = useToasts();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('settings.title') });

    derived user = account.user();

    derived current = settings.settings();

    derived minor = user?.minor === true;

    derived blocked = social.blocked()
        .map((id) => personById(id))
        .filter((person): person is Person => person !== undefined);

    derived muted = social.muted()
        .map((id) => personById(id))
        .filter((person): person is Person => person !== undefined);

    derived reports = [...social.reports()].sort((a, b) => b.at - a.at);

    const leave = (): void =>
    {
        wallet.disconnect();
        session.signOut();
        navigate('/sign-in', { replace: true });
    };

    <Page narrow label={ locale.t('settings.title') }>
        <header class="pb-5">
            <h1 class="title text-ui-4xl">{ locale.t('settings.title') }</h1>
        </header>

        <div class="flex flex-col gap-8">
            <section aria-labelledby="settings-account">
                <SectionHeading id="settings-account" title={ locale.t('settings.account') } />
                <div class="flex flex-col gap-3 rounded-panel border border-line bg-field p-4">
                    <Show
                        when={ account.isWallet() }
                        fallback={
                            <div class="flex items-start gap-3">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-raised text-muted">
                                    <Icon name="people" size={ 18 } />
                                </span>
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="text-ui-md font-semibold text-text">{ locale.t('settings.account.demo') }</span>
                                    <span class="text-ui-sm text-muted">{ locale.t('settings.account.demoLead') }</span>
                                </span>
                            </div>
                        }
                    >
                        { () =>
                            <div class="flex items-start gap-3">
                                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-live/15 text-live">
                                    <Icon name="key" size={ 18 } />
                                </span>
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="text-ui-md font-semibold text-text">{ locale.t('settings.account.wallet', { wallet: wallet.name() }) }</span>
                                    <code class="tally truncate text-ui-sm text-muted">{ shortAddress(account.address() ?? '') }</code>
                                    <span class="mt-1 text-ui-xs text-faint">{ locale.t('settings.account.network') }: { NURA_CHAIN.name }</span>
                                </span>
                            </div>
                        }
                    </Show>
                    <Show when={ !account.isWallet() }>
                        { () => <Button variant="primary" block leading="key" onClick={ leave }>{ locale.t('me.keepSeat.action') }</Button> }
                    </Show>
                    <Button variant="outline" block leading="sign-out" onClick={ leave }>
                        { account.isWallet() ? locale.t('settings.account.disconnect') : locale.t('settings.account.signOut') }
                    </Button>
                </div>
            </section>

            <section aria-labelledby="settings-safety">
                <SectionHeading id="settings-safety" title={ locale.t('settings.safety') } />
                <div class="flex flex-col gap-4 rounded-panel border border-line bg-field p-4">
                    <Toggle
                        checked={ minor ? true : current.strangerMessages }
                        disabled={ minor }
                        label={ locale.t('settings.safety.strangers') }
                        description={ minor ? locale.t('settings.safety.strangersLocked') : locale.t('settings.safety.strangersHint') }
                        onChange={ (checked) => settings.update({ strangerMessages: checked }) }
                    />
                    <Toggle
                        checked={ current.showOnline }
                        label={ locale.t('settings.safety.online') }
                        description={ locale.t('settings.safety.onlineHint') }
                        onChange={ (checked) => settings.update({ showOnline: checked }) }
                    />

                    <div>
                        <p class="label text-ui-sm text-text">{ locale.t('settings.safety.blocked') }</p>
                        <p class="mt-1 text-ui-xs text-muted">{ locale.t('settings.safety.blockedLead') }</p>
                        <Show
                            when={ blocked.length > 0 }
                            fallback={ <p class="mt-2 text-ui-sm text-faint">{ locale.t('settings.safety.blockedEmpty') }</p> }
                        >
                            { () =>
                                <ul class="mt-2 flex flex-col gap-0.5" aria-label={ locale.t('settings.safety.blocked') }>
                                    <For each={ blocked } key={ (person) => person.id } let={ person }>
                                        <li>
                                            <FriendRow
                                                person={ person }
                                                subtitle={ `@${ person.handle }` }
                                                actions={
                                                    <Button variant="ghost" size="sm" class="whitespace-nowrap" onClick={ () => social.unblock(person.id) }>
                                                        { locale.t('actions.unblock', { name: locale.text(person.name).split(' ')[0] }) }
                                                    </Button>
                                                }
                                            />
                                        </li>
                                    </For>
                                </ul>
                            }
                        </Show>
                    </div>

                    <div>
                        <p class="label text-ui-sm text-text">{ locale.t('settings.safety.muted') }</p>
                        <p class="mt-1 text-ui-xs text-muted">{ locale.t('settings.safety.mutedLead') }</p>
                        <Show
                            when={ muted.length > 0 }
                            fallback={ <p class="mt-2 text-ui-sm text-faint">{ locale.t('settings.safety.mutedEmpty') }</p> }
                        >
                            { () =>
                                <ul class="mt-2 flex flex-col gap-0.5" aria-label={ locale.t('settings.safety.muted') }>
                                    <For each={ muted } key={ (person) => person.id } let={ person }>
                                        <li>
                                            <FriendRow
                                                person={ person }
                                                subtitle={ `@${ person.handle }` }
                                                actions={
                                                    <Button variant="ghost" size="sm" class="whitespace-nowrap" onClick={ () => social.toggleMute(person.id) }>
                                                        { locale.t('actions.unmute', { name: locale.text(person.name).split(' ')[0] }) }
                                                    </Button>
                                                }
                                            />
                                        </li>
                                    </For>
                                </ul>
                            }
                        </Show>
                    </div>

                    <div>
                        <p class="label text-ui-sm text-text">{ locale.t('settings.safety.reports') }</p>
                        <p class="mt-1 text-ui-xs text-muted">{ locale.t('settings.safety.reportsLead') }</p>
                        <Show
                            when={ reports.length > 0 }
                            fallback={ <p class="mt-2 text-ui-sm text-faint">{ locale.t('report.empty') }</p> }
                        >
                            { () =>
                                <ul class="mt-2 flex flex-col gap-1" aria-label={ locale.t('settings.safety.reports') }>
                                    <For each={ reports } key={ (report) => report.id } let={ report }>
                                        <li class="flex items-center gap-3 rounded-tile bg-raised/50 px-3 py-2">
                                            <Icon name="report" size={ 15 } class="shrink-0 text-madder" />
                                            <span class="flex min-w-0 flex-1 flex-col">
                                                <span class="truncate text-ui-sm text-text">
                                                    { locale.text(personById(report.against)?.name ?? { en: report.against, fa: report.against }) }
                                                    <span class="mx-1.5 inline-block h-1 w-1 rounded-full bg-faint align-middle" aria-hidden="true"></span>
                                                    { locale.t(`report.category.${ report.category }`) }
                                                </span>
                                                <span class="text-ui-2xs text-faint">{ locale.relative(report.at) }</span>
                                            </span>
                                            <span class={ [
                                                'shrink-0 rounded-full px-2 py-0.5 text-ui-2xs font-semibold',
                                                report.status === 'actioned' ? 'bg-win/15 text-win' : (report.status === 'reviewed' ? 'bg-live/15 text-live' : 'bg-raised text-muted')
                                            ].join(' ') }>
                                                { locale.t(`report.status.${ report.status }`) }
                                            </span>
                                        </li>
                                    </For>
                                </ul>
                            }
                        </Show>
                    </div>
                </div>
            </section>

            <section aria-labelledby="settings-notifications">
                <SectionHeading id="settings-notifications" title={ locale.t('settings.notifications') } />
                <div class="flex flex-col gap-4 rounded-panel border border-line bg-field p-4">
                    <For each={ NOTIFICATION_CATEGORIES } key={ (category) => category } let={ category }>
                        <div>
                            <Toggle
                                checked={ current.notifications[category] }
                                label={ locale.t(`settings.notifications.${ category }`) }
                                onChange={ (checked) => settings.update({ notifications: { ...current.notifications, [category]: checked } }) }
                            />
                        </div>
                    </For>
                    <Toggle
                        checked={ current.sound }
                        label={ locale.t('settings.notifications.sound') }
                        onChange={ (checked) => settings.update({ sound: checked }) }
                    />
                </div>
            </section>

            <section aria-labelledby="settings-appearance">
                <SectionHeading id="settings-appearance" title={ locale.t('settings.appearance') } />
                <div class="flex flex-col gap-4 rounded-panel border border-line bg-field p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <span class="text-ui-md font-semibold text-text">{ locale.t('settings.appearance.theme') }</span>
                        <ThemeSwitch />
                    </div>
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <span class="text-ui-md font-semibold text-text">{ locale.t('settings.appearance.language') }</span>
                        <LanguageSwitch />
                    </div>
                    <Slider
                        value={ current.railWidth }
                        min={ 0.22 }
                        max={ 0.45 }
                        step={ 0.01 }
                        ticks={ [0.22, 0.3, 0.38, 0.45] }
                        label={ locale.t('settings.appearance.rail') }
                        hint={ locale.t('settings.appearance.railHint') }
                        valueText={ locale.n(current.railWidth, { style: 'percent' }) }
                        onChange={ (value) => settings.update({ railWidth: value }) }
                    />
                    <Show when={ device.reducedMotion() }>
                        { () =>
                            <p class="flex items-center gap-2 text-ui-xs text-muted">
                                <Icon name="info" size={ 13 } />
                                { locale.t('settings.appearance.motion') }
                            </p>
                        }
                    </Show>
                </div>
            </section>

            <section aria-labelledby="settings-premium">
                <SectionHeading id="settings-premium" title={ locale.t('settings.premium') } />
                <div class="rounded-panel border border-accent/30 bg-accent/5 p-4">
                    <h3 class="flex items-center gap-2 title text-ui-lg text-text">
                        <Icon name="sparkles" size={ 18 } class="text-accent" />
                        { locale.t('settings.premium.title') }
                    </h3>
                    <p class="mt-1 text-ui-base text-muted">{ locale.t('settings.premium.lead') }</p>
                    <p class="tally mt-3 title text-ui-2xl text-text">
                        { locale.t('settings.premium.price', { price: locale.n(4, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }) }) }
                    </p>
                    <p class="mt-1 text-ui-xs text-muted">{ locale.t('settings.premium.currency') }</p>
                    <p class="label mt-4 text-ui-xs text-faint">{ locale.t('settings.premium.includes') }</p>
                    <ul class="mt-2 flex flex-col gap-1.5">
                        <For each={ PREMIUM } key={ (item) => item } let={ item }>
                            <li class="flex items-center gap-2 text-ui-sm text-text">
                                <Icon name="check-circle" size={ 14 } class="shrink-0 text-accent" />
                                { locale.t(item) }
                            </li>
                        </For>
                    </ul>
                    <p class="mt-3 text-ui-xs text-muted">{ locale.t('settings.premium.refund') }</p>
                    <Button variant="outline" block class="mt-4" disabled>{ locale.t('settings.premium.subscribe') }</Button>
                    <p class="mt-3 flex items-start gap-2 text-ui-xs text-live">
                        <Icon name="shield" size={ 13 } class="mt-0.5 shrink-0" />
                        { locale.t('settings.premium.never') }
                    </p>
                </div>
            </section>

            <section aria-labelledby="settings-demo">
                <SectionHeading id="settings-demo" title={ locale.t('settings.demo') } />
                <div class="flex flex-col gap-3 rounded-panel border border-dashed border-line p-4">
                    <p class="text-ui-xs text-muted">{ locale.t('settings.demo.lead') }</p>
                    <Button
                        variant="secondary"
                        block
                        leading="wifi-off"
                        onClick={ () =>
                        {
                            connection.simulateDrop(6000);
                            toasts.show({ kind: 'warning', text: locale.t('settings.demo.dropped') });
                        } }
                    >
                        { locale.t('settings.demo.drop') }
                    </Button>
                </div>
            </section>
        </div>
    </Page>
}
