import PersonRecord from '../../components/social/person-record.component.azeroth';
import { createResource, useHead, useNavigate, useParams } from 'azerothjs';

import { client } from '../../api.ts';
import Page from '../../components/app/page.component.azeroth';
import PersonActions from '../../components/social/person-actions.component.azeroth';
import Avatar from '../../components/ui/avatar.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import Chip from '../../components/ui/chip.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { openTable } from '../../lib/open-table.ts';
import Panel from '../../components/ui/panel.component.azeroth';

export default component PersonPage()
{
    const locale = useLocale();
    const social = useSocial();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const chat = useChat();
    const lobby = useLobby();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const params = useParams();
    const people = usePeople();
    const { navigate } = useNavigate();

    /**
     * The profile, from the server, with the relation and the mutual count it already computes.
     *
     * One request for the page whose whole premise is the answer. The version this replaces read a
     * name out of a fixture and recomputed `mutual` from a fixture friend graph - a number the
     * server had already worked out and sent.
     */
    const view = createResource(
        () => params().handle ?? null,
        (handle) => client.social.person({ params: { handle } }),
        { name: 'social.person' }
    );

    derived person = view.data()?.person ?? people.byHandle(params().handle ?? '') ?? null;

    derived name = person === null ? locale.t('person.notFound') : person.displayName;

    useHead({ title: () => name });

    mount
    {
        return shell.claimTitle(() => name);
    }

    derived relation = person === null ? 'none' : social.relation(person.id);

    derived mutual = view.data()?.mutual ?? 0;

    const play = (): void =>
    {
        if (person !== null)
        {
            const game = catalogue.featured();
            openTable(lobby.host(game, catalogue.defaults(game), [person.id]), navigate);
        }
    };

    const message = (): void =>
    {
        if (person !== null)
        {
            void chat.openDirect(person.id).then((id) => navigate(`/app/chats/${ id }`));
        }
    };

    <Page label={ name }>
        <Show
            when={ person !== null }
            fallback={ <EmptyState icon="people" title={ locale.t('person.notFound') } action={ locale.t('app.nav.friends') } to="/app/friends" class="py-12" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <header class="flex flex-col items-center gap-3 pt-2 text-center">
                        <Avatar person={ person } size="2xl" presence={ person === null ? null : presence.dot(person.id) } />
                        <div>
                            <h1 class="title flex items-center justify-center gap-2 text-ui-3xl">
                                { name }
                                <Show when={ person!.isMinor }>
                                    { () => <Icon name="shield" size={ 18 } class="text-live" /> }
                                </Show>
                            </h1>
                            <p class="mt-1 text-ui-base text-muted">@{ person!.handle }</p>
                        </div>
                        <p class="max-w-[46ch] text-ui-base text-text">{ locale.text(person!.bio) }</p>
                        <ul class="flex flex-wrap justify-center gap-2" aria-label={ locale.t('person.tab.overview') }>
                            <Show when={ mutual > 0 }>
                                <li><Chip icon="people"><span class="tally">{ locale.plural('person.mutual', mutual) }</span></Chip></li>
                            </Show>
                        </ul>
                        <Show when={ person!.isMinor }>
                            { () =>
                                <p class="flex items-center gap-2 rounded-full bg-live/10 px-3 py-1.5 text-ui-xs font-semibold text-live">
                                    <Icon name="shield" size={ 13 } />
                                    { locale.t('person.minor') }
                                </p>
                            }
                        </Show>
                    </header>

                    <Show when={ relation === 'blocked' }>
                        { () =>
                            <Panel tone="danger" class="text-center">
                                <p class="text-ui-md font-semibold text-text">{ locale.t('person.blockedTitle', { name: locale.text(person!.displayName).split(' ')[0] }) }</p>
                                <p class="mt-1 text-ui-sm text-muted">{ locale.t('person.blockedLead') }</p>
                                <Button
                                    variant="outline"
                                    size="sm"
                                    class="mt-3"
                                    onClick={ () =>
                                    {
                                        social.unblock(person!.id);
                                        toasts.show({ kind: 'success', text: locale.t('actions.unblocked', { name: locale.text(person!.displayName).split(' ')[0] }) });
                                    } }
                                >
                                    { locale.t('actions.unblock', { name: locale.text(person!.displayName).split(' ')[0] }) }
                                </Button>
                            </Panel>
                        }
                    </Show>

                    <Show when={ relation !== 'blocked' }>
                        { () =>
                            <div class="flex flex-wrap items-center justify-center gap-2">
                                <Button variant="primary" leading="zap" onClick={ play }>{ locale.t('person.play') }</Button>
                                <Button variant="secondary" leading="chats" onClick={ message }>{ locale.t('person.message') }</Button>
                                <Show when={ relation === 'none' }>
                                    { () =>
                                        <Button
                                            variant="outline"
                                            leading="friend-add"
                                            onClick={ () =>
                                            {
                                                social.add(person!.id);
                                                toasts.show({ kind: 'success', text: locale.t('person.added') });
                                            } }
                                        >
                                            { locale.t('person.add') }
                                        </Button>
                                    }
                                </Show>
                                <Show when={ relation === 'outgoing' }>
                                    { () => <Button variant="outline" leading="clock" onClick={ () => social.withdraw(person!.id) }>{ locale.t('person.withdraw') }</Button> }
                                </Show>
                                <Show when={ relation === 'incoming' }>
                                    { () =>
                                        <Button
                                            variant="outline"
                                            leading="friend-check"
                                            onClick={ () => social.accept(social.incoming().find((request) => request.from === person!.id)?.id ?? '') }
                                        >
                                            { locale.t('person.accept') }
                                        </Button>
                                    }
                                </Show>
                                <Show when={ relation === 'friend' }>
                                    { () => <Button variant="outline" leading="friend-check" disabled>{ locale.t('person.friends') }</Button> }
                                </Show>
                                <IconButton icon="more" label={ locale.t('actions.title') } variant="ghost" onClick={ () => overlay.open(PersonActions, { personId: person!.id }, { label: locale.t('actions.title') }) } />
                            </div>
                        }
                    </Show>

                    <PersonRecord handle={ person!.id } />
                </div>
            }
        </Show>
    </Page>
}
