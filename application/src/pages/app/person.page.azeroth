import { useHead, useNavigate, useParams } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import RecordStrip from '../../components/games/record-strip.component.azeroth';
import PeopleStrip from '../../components/social/people-strip.component.azeroth';
import PersonActions from '../../components/social/person-actions.component.azeroth';
import Avatar from '../../components/ui/avatar.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import Chip from '../../components/ui/chip.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import Tabs from '../../components/ui/tabs.component.azeroth';
import { GAMES } from '../../data/games.ts';
import { ACHIEVEMENTS } from '../../data/mock/achievements.ts';
import { dataset, personByHandle, personById } from '../../data/mock/index.ts';
import type { Person } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import { mutualCount } from '../../services/social.service.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

export default component PersonPage()
{
    const locale = useLocale();
    const social = useSocial();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const chat = useChat();
    const lobby = useLobby();
    const account = useAccount();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const params = useParams();
    const { navigate } = useNavigate();

    state tab = 'overview';

    derived person = personByHandle(params().handle ?? '') ?? null;

    derived name = person === null ? locale.t('person.notFound') : locale.text(person.name);

    useHead({ title: () => name });

    mount
    {
        return shell.claimTitle(() => name);
    }

    derived relation = person === null ? 'none' : social.relation(person.id);

    derived state = person === null ? null : presence.of(person.id);

    derived mutual = person === null || account.user() === null ? 0 : mutualCount(dataset().friends, account.user()!.id, person.id);

    derived theirFriends = person === null
        ? []
        : (dataset().friends[person.id] ?? [])
            .map((id) => personById(id))
            .filter((entry): entry is Person => entry !== undefined && !social.isBlocked(entry.id))
            .slice(0, 12);

    derived totals = person === null
        ? { played: 0, won: 0 }
        : GAMES.reduce((sum, game) => ({ played: sum.played + person!.stats[game.id].played, won: sum.won + person!.stats[game.id].won }), { played: 0, won: 0 });

    derived best = person === null
        ? GAMES[0]
        : [...GAMES].sort((a, b) => person!.stats[b.id].won - person!.stats[a.id].won)[0];

    derived items = [
        { id: 'overview', label: locale.t('person.tab.overview') },
        { id: 'games', label: locale.t('person.tab.games') },
        { id: 'achievements', label: locale.t('person.tab.achievements'), count: person?.achievements.length }
    ];

    const play = (): void =>
    {
        if (person !== null)
        {
            navigate(`/app/play/${ lobby.host(person.favourite, catalogue.defaults(person.favourite), [person.id]) }`);
        }
    };

    const message = (): void =>
    {
        if (person !== null)
        {
            navigate(`/app/chats/${ chat.openDirect(person.id) }`);
        }
    };

    <Page label={ name }>
        <Show
            when={ person !== null }
            fallback={ <EmptyState icon="people" title={ locale.t('person.notFound') } action={ locale.t('app.nav.friends') } to="/app/friends" class="py-12" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <header class="flex flex-col items-center gap-3 pt-2 text-center">
                        <Avatar person={ person } size="2xl" presence={ state?.state ?? null } />
                        <div>
                            <h1 class="title flex items-center justify-center gap-2 text-ui-3xl">
                                { name }
                                <Show when={ person!.minor }>
                                    { () => <Icon name="shield" size={ 18 } class="text-live" /> }
                                </Show>
                            </h1>
                            <p class="mt-1 text-ui-base text-muted">@{ person!.handle }</p>
                        </div>
                        <p class="max-w-[46ch] text-ui-base text-text">{ locale.text(person!.bio) }</p>
                        <ul class="flex flex-wrap justify-center gap-2" aria-label={ locale.t('person.tab.overview') }>
                            <li><Chip icon="star"><span class="tally">{ locale.t('person.level', { level: person!.level }) }</span></Chip></li>
                            <li><Chip icon="games">{ locale.t('person.favourite', { game: locale.t(catalogue.byId(person!.favourite).nameKey) }) }</Chip></li>
                            <li><Chip icon="shield" tone="live"><span class="tally">{ locale.t('person.reliability', { score: person!.reliability }) }</span></Chip></li>
                            <Show when={ mutual > 0 }>
                                <li><Chip icon="people"><span class="tally">{ locale.plural('person.mutual', mutual) }</span></Chip></li>
                            </Show>
                        </ul>
                        <Show when={ person!.minor }>
                            { () =>
                                <p class="flex items-center gap-2 rounded-full bg-live/10 px-3 py-1.5 text-ui-xs font-semibold text-live">
                                    <Icon name="shield" size={ 13 } />
                                    { locale.t('person.minor') }
                                </p>
                            }
                        </Show>
                    </header>

                    <Show when={ relation === 'blocked' }>
                        { () =>
                            <div class="rounded-panel border border-madder/40 bg-madder/5 p-4 text-center">
                                <p class="text-ui-md font-semibold text-text">{ locale.t('person.blockedTitle', { name: locale.text(person!.name).split(' ')[0] }) }</p>
                                <p class="mt-1 text-ui-sm text-muted">{ locale.t('person.blockedLead') }</p>
                                <Button
                                    variant="outline"
                                    size="sm"
                                    class="mt-3"
                                    onClick={ () =>
                                    {
                                        social.unblock(person!.id);
                                        toasts.show({ kind: 'success', text: locale.t('actions.unblocked', { name: locale.text(person!.name).split(' ')[0] }) });
                                    } }
                                >
                                    { locale.t('actions.unblock', { name: locale.text(person!.name).split(' ')[0] }) }
                                </Button>
                            </div>
                        }
                    </Show>

                    <Show when={ relation !== 'blocked' }>
                        { () =>
                            <div class="flex flex-wrap items-center justify-center gap-2">
                                <Button variant="primary" leading="zap" onClick={ play }>{ locale.t('person.play') }</Button>
                                <Button variant="secondary" leading="chats" onClick={ message }>{ locale.t('person.message') }</Button>
                                <Show when={ relation === 'none' }>
                                    { () =>
                                        <Button
                                            variant="outline"
                                            leading="friend-add"
                                            onClick={ () =>
                                            {
                                                social.add(person!.id);
                                                toasts.show({ kind: 'success', text: locale.t('person.added') });
                                            } }
                                        >
                                            { locale.t('person.add') }
                                        </Button>
                                    }
                                </Show>
                                <Show when={ relation === 'outgoing' }>
                                    { () => <Button variant="outline" leading="clock" onClick={ () => social.withdraw(person!.id) }>{ locale.t('person.withdraw') }</Button> }
                                </Show>
                                <Show when={ relation === 'incoming' }>
                                    { () =>
                                        <Button
                                            variant="outline"
                                            leading="friend-check"
                                            onClick={ () => social.accept(social.incoming().find((request) => request.from === person!.id)?.id ?? '') }
                                        >
                                            { locale.t('person.accept') }
                                        </Button>
                                    }
                                </Show>
                                <Show when={ relation === 'friend' }>
                                    { () => <Button variant="outline" leading="friend-check" disabled>{ locale.t('person.friends') }</Button> }
                                </Show>
                                <IconButton icon="more" label={ locale.t('actions.title') } variant="ghost" onClick={ () => overlay.open(PersonActions, { personId: person!.id }, { label: locale.t('actions.title') }) } />
                            </div>
                        }
                    </Show>

                    <Tabs items={ items } value={ tab } label={ name } onChange={ (id) => tab = id } />

                    <Show when={ tab === 'overview' }>
                        { () =>
                            <div class="flex flex-col gap-6">
                                <RecordStrip record={ { played: totals.played, won: totals.won, streak: person!.stats[person!.favourite].streak } } />
                                <section>
                                    <SectionHeading title={ locale.t('person.stat.best') } />
                                    <p class="rounded-panel border border-line bg-field p-4 text-ui-md text-text">
                                        { locale.t(best.nameKey) } · <span class="tally">{ locale.plural('game.leaderboard.wins', person!.stats[best.id].won) }</span>
                                    </p>
                                </section>
                                <section>
                                    <SectionHeading title={ locale.t('person.friends') } />
                                    <Show
                                        when={ theirFriends.length > 0 }
                                        fallback={ <p class="rounded-tile border border-dashed border-line p-4 text-ui-sm text-muted">{ locale.t('friends.empty.all') }</p> }
                                    >
                                        { () => <PeopleStrip people={ theirFriends } label={ locale.t('person.friends') } /> }
                                    </Show>
                                </section>
                                <p class="text-center text-ui-xs text-faint">{ locale.t('person.joined', { date: locale.date(person!.joinedAt, { year: 'numeric', month: 'long' }) }) }</p>
                            </div>
                        }
                    </Show>

                    <Show when={ tab === 'games' }>
                        { () =>
                            <ul class="flex flex-col gap-2" aria-label={ locale.t('person.tab.games') }>
                                <For each={ GAMES } key={ (game) => game.id } let={ game }>
                                    <li class="flex items-center gap-3 rounded-panel border border-line bg-field p-3">
                                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-tile bg-raised text-muted">
                                            <Icon name={ game.category === 'cards' ? 'cards' : 'dice' } size={ 18 } />
                                        </span>
                                        <span class="flex min-w-0 flex-1 flex-col">
                                            <span class="truncate text-ui-md font-semibold text-text">{ locale.t(game.nameKey) }</span>
                                            <span class="tally text-ui-xs text-muted">
                                                { locale.t('game.record.played') } { locale.n(person!.stats[game.id].played) } · { locale.t('game.record.won') } { locale.n(person!.stats[game.id].won) }
                                            </span>
                                        </span>
                                        <span class="tally title text-ui-lg text-text">
                                            { locale.n(person!.stats[game.id].played === 0 ? 0 : person!.stats[game.id].won / person!.stats[game.id].played, { style: 'percent' }) }
                                        </span>
                                    </li>
                                </For>
                            </ul>
                        }
                    </Show>

                    <Show when={ tab === 'achievements' }>
                        { () =>
                            <ul class="grid grid-cols-2 gap-2 @lg:grid-cols-3" aria-label={ locale.t('person.tab.achievements') }>
                                <For each={ ACHIEVEMENTS } key={ (achievement) => achievement.id } let={ achievement }>
                                    <li class={ [
                                        'flex flex-col items-center gap-1.5 rounded-panel border p-3 text-center',
                                        person!.achievements.includes(achievement.id) ? 'border-accent/40 bg-accent/5' : 'border-line bg-field opacity-60'
                                    ].join(' ') }>
                                        <span class={ [
                                            'flex h-11 w-11 items-center justify-center rounded-full',
                                            person!.achievements.includes(achievement.id) ? 'bg-accent/20 text-accent' : 'bg-raised text-faint'
                                        ].join(' ') }>
                                            <Icon name={ achievement.icon } size={ 20 } />
                                        </span>
                                        <span class="text-ui-sm font-semibold text-text">{ locale.text(achievement.name) }</span>
                                        <span class="text-ui-2xs text-muted">
                                            { person!.achievements.includes(achievement.id) ? locale.text(achievement.blurb) : locale.t('person.achievements.locked') }
                                        </span>
                                    </li>
                                </For>
                            </ul>
                        }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
