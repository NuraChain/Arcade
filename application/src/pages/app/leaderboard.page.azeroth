import { useHead } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import GameIcon from '../../components/games/game-icon.component.azeroth';
import Leaderboard from '../../components/games/leaderboard.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component LeaderboardPage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    useHead({ title: () => locale.t('app.nav.leaderboard') });

    state picked = null as GameId | null;

    derived games = catalogue.games.filter((game) => catalogue.status(game.id) === 'available');

    derived chosen = picked !== null && games.some((game) => game.id === picked) ? picked : (games[0]?.id ?? null);

    <Page label={ locale.t('app.nav.leaderboard') }>
        <div class="flex flex-col gap-6">
            <header class="flex flex-col gap-1.5">
                <h1 class="title text-ui-3xl">{ locale.t('app.nav.leaderboard') }</h1>
                <p class="max-w-[40rem] text-ui-md text-muted">{ locale.t('leaderboard.lead') }</p>
            </header>

            <Show
                when={ !catalogue.loading() }
                fallback={ <Skeleton lines={ 3 } class="h-40 w-full" /> }
            >
                { () =>
                    <div class="flex flex-col gap-5">
                        <ul class="flex gap-2.5 overflow-x-auto pb-1" role="group" aria-label={ locale.t('leaderboard.pick') }>
                            <For each={ games } key={ (game) => game.id } let={ game }>
                                <li class="shrink-0">
                                    <button
                                        type="button"
                                        class={ () => [
                                            'flex min-h-14 cursor-pointer items-center gap-3 rounded-tile border px-3 py-2 pe-4 text-start transition-colors duration-150',
                                            chosen === game.id ? 'border-accent/60 bg-accent/12 text-text' : 'border-line bg-field text-muted hover:border-line-strong hover:text-text'
                                        ].join(' ') }
                                        aria-pressed={ chosen === game.id }
                                        onClick={ () => picked = game.id }
                                    >
                                        <GameIcon game={ game.id } class="h-9 w-9" />
                                        <span class="text-ui-md font-semibold">{ locale.t(game.nameKey) }</span>
                                    </button>
                                </li>
                            </For>
                        </ul>

                        <Show when={ chosen !== null }>
                            { () => <Leaderboard game={ chosen! } titled={ false } /> }
                        </Show>
                    </div>
                }
            </Show>
        </div>
    </Page>
}
