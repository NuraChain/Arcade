import { useHead, useNavigate, useParams } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import FairPlayPanel from '../../components/games/fair-play-panel.component.azeroth';
import GameHero from '../../components/games/game-hero.component.azeroth';
import RecordStrip from '../../components/games/record-strip.component.azeroth';
import PeopleStrip from '../../components/social/people-strip.component.azeroth';
import Avatar from '../../components/ui/avatar.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import { dataset, personById } from '../../data/mock/index.ts';
import type { Person } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { MessageKey } from '../../locales/en.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useShell } from '../../stores/shell.store.ts';

export default component GamePage()
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const account = useAccount();
    const presence = usePresence();
    const shell = useShell();
    const params = useParams();
    const { navigate } = useNavigate();

    derived game = catalogue.bySlug(params().slug ?? '') ?? null;

    derived name = game === null ? locale.t('game.notFound') : locale.t(game.nameKey);

    useHead({ title: () => name });

    mount
    {
        return shell.claimTitle(() => name);
    }

    derived rules = game === null ? null : catalogue.rules(game.id);

    derived record = ((): { played: number; won: number; streak: number } =>
    {
        const user = account.user();
        return user === null || game === null ? { played: 0, won: 0, streak: 0 } : user.stats[game.id];
    })();

    derived friendsPlaying = ((): Person[] =>
    {
        const user = account.user();
        if (user === null || game === null)
        {
            return [];
        }
        return (dataset().friends[user.id] ?? [])
            .map((id) => personById(id))
            .filter((person): person is Person => person !== undefined)
            .filter((person) => presence.of(person.id).state === 'playing' && presence.of(person.id).game === game!.id);
    })();

    derived leaders = game === null
        ? []
        : [...dataset().people]
            .filter((person) => person.stats[game!.id].won > 0)
            .sort((a, b) => b.stats[game!.id].won - a.stats[game!.id].won)
            .slice(0, 5);

    derived ruleKeys = game === null ? [] : [1, 2, 3].map((index) => `game.rules.${ game!.id }.${ index }` as MessageKey);

    const quickPlay = (): void =>
    {
        if (game !== null)
        {
            navigate(`/app/play/${ lobby.quick(game.id) }`);
        }
    };

    <Page label={ name }>
        <Show
            when={ game !== null }
            fallback={ <EmptyState icon="games" title={ locale.t('game.notFound') } action={ locale.t('app.nav.games') } to="/app/games" class="py-12" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <GameHero game={ game! } onQuickPlay={ quickPlay } />

                    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="flex flex-col gap-6">
                            <section aria-labelledby="game-about">
                                <SectionHeading id="game-about" title={ locale.t('game.about') } />
                                <ol class="flex flex-col gap-2">
                                    <For each={ ruleKeys } key={ (key) => key } let={ key } index={ index }>
                                        <li class="flex items-start gap-3 rounded-tile border border-line bg-field p-3 text-[14px] leading-snug text-text">
                                            <span class="tally flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-lamp/15 text-[13px] font-bold text-lamp">{ locale.n(index + 1) }</span>
                                            <span class="pt-1">{ locale.t(key) }</span>
                                        </li>
                                    </For>
                                </ol>
                                <Show when={ game!.id === 'hokm' }>
                                    <p class="mt-3 flex items-start gap-2 rounded-tile bg-lamp/10 p-3 text-[13px] text-text">
                                        <Icon name="info" size={ 16 } class="mt-0.5 shrink-0 text-lamp" />
                                        <span>{ locale.t('game.needsFour') }</span>
                                    </p>
                                </Show>
                            </section>

                            <section aria-labelledby="game-friends">
                                <SectionHeading id="game-friends" title={ locale.t('game.friendsPlaying') } more={ locale.t('common.seeAll') } to="/app/friends" />
                                <Show
                                    when={ friendsPlaying.length > 0 }
                                    fallback={ <p class="rounded-tile border border-dashed border-line p-4 text-[13px] text-muted">{ locale.t('game.friendsPlayingEmpty', { game: name }) }</p> }
                                >
                                    { () => <PeopleStrip people={ friendsPlaying } label={ locale.t('game.friendsPlaying') } /> }
                                </Show>
                            </section>

                            <section aria-labelledby="game-leaders">
                                <SectionHeading id="game-leaders" title={ locale.t('game.leaderboard') } />
                                <ol class="flex flex-col gap-1 rounded-panel border border-line bg-field p-2">
                                    <For each={ leaders } key={ (person) => person.id } let={ person } index={ index }>
                                        <li class="flex items-center gap-3 rounded-tile px-2 py-1.5">
                                            <span class={ [ 'tally w-6 text-center text-[13px] font-bold', index === 0 ? 'text-lamp' : 'text-faint' ].join(' ') }>{ locale.n(index + 1) }</span>
                                            <Avatar person={ person } size="sm" presence={ presence.of(person.id).state } />
                                            <span class="min-w-0 flex-1 truncate text-[14px] font-semibold text-text">{ locale.text(person.name) }</span>
                                            <span class="tally text-[13px] text-muted">{ locale.plural('game.leaderboard.wins', person.stats[game!.id].won) }</span>
                                        </li>
                                    </For>
                                </ol>
                            </section>
                        </div>

                        <aside class="flex flex-col gap-6">
                            <section aria-labelledby="game-record">
                                <SectionHeading id="game-record" title={ locale.t('game.record.title') } />
                                <RecordStrip record={ record } />
                            </section>
                            <FairPlayPanel game={ game!.id } />
                            <Show when={ rules !== null && rules.stakes === 'play-money' }>
                                <p class="flex items-start gap-2 rounded-tile border border-line bg-field p-3 text-[13px] text-muted">
                                    <Icon name="coins" size={ 16 } class="mt-0.5 shrink-0 text-lamp" />
                                    <span>{ locale.t('games.stakes.playMoneyHint') }</span>
                                </p>
                            </Show>
                        </aside>
                    </div>

                    <div class="glass safe-b sticky -mx-4 bottom-0 z-nav flex gap-2 border-t border-line/60 px-4 py-3 sm:hidden">
                        <Button variant="primary" size="lg" block leading="zap" onClick={ quickPlay }>{ locale.t('app.nav.quickPlay') }</Button>
                        <Button variant="outline" size="lg" leading="add" to={ `/app/games/${ game!.slug }/create` } label={ locale.t('games.create') }>{ locale.t('games.create') }</Button>
                    </div>
                </div>
            }
        </Show>
    </Page>
}
