import { Dynamic, type MountNode, untrack, useHead, useNavigate, useParams, useRoute } from 'azerothjs';

import ConfirmSheet from '../../components/app/confirm-sheet.component.azeroth';
import Page from '../../components/app/page.component.azeroth';
import InviteSheet from '../../components/games/invite-sheet.component.azeroth';
import LobbyPanel from '../../components/games/lobby-panel.component.azeroth';
import PlayHeader from '../../components/games/play-header.component.azeroth';
import WatchBoard from '../../components/games/watch-board.component.azeroth';
import TableChat from '../../components/games/table-chat.component.azeroth';
import TableDock from '../../components/games/table-dock.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { useWatch } from '../../stores/watch.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Panel from '../../components/ui/panel.component.azeroth';
import type { MatchView } from '../../api.ts';

export default component PlayPage()
{
    const locale = useLocale();
    const lobby = useLobby();
    const board = useBoard();
    const settings = useSettings();
    const catalogue = useCatalogue();
    const device = useDevice();
    const watch = useWatch();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const params = useParams();
    const { navigate } = useNavigate();

    const mine = untrack(() => params().id ?? '');

    state chatOpen = false;

    state chatWide = false;

    let arena: HTMLElement | null = null;

    state starting = false;

    let Board: ((props: { match: MatchView; starting?: boolean; onAgain?: () => void }) => MountNode) | null = null;

    state drawn = '';

    const route = useRoute();

    effect
    {
        const here = route().pathname;
        const id = params().id ?? '';

        if (id !== '' && here.startsWith('/app/play/'))
        {
            lobby.open(id);
        }
    }

    mount
    {
        const release = shell.claimTitle(() => title);

        return () =>
        {
            release();

            const held = untrack(lobby.openId);

            if (held === mine || held === '')
            {
                lobby.close();
                board.close();
                watch.close();
            }
        };
    }

    derived table = lobby.table();

    derived loading = lobby.loading() && table === null;

    derived failed = lobby.failed() !== undefined && table === null && !lobby.loading();

    derived seated = table?.mine !== undefined;

    derived amHost = table?.chairs.find((chair) => chair.seat === table!.mine)?.host === true;

    derived showing = board.match() !== null && board.match()!.tableId === table?.id;

    derived ready = table !== null
        && table.status === 'ready'
        && table.chairs.every((chair) => chair.ready);

    derived title = table !== null
        ? locale.t(catalogue.byId(table.game as GameId).nameKey)
        : (loading ? locale.t('common.loading') : locale.t('play.notFound'));

    useHead({ title: () => title });

    derived docked = device.posture() === 'sidebar';

    derived hasChat = seated && table?.conversationId !== undefined;

    derived railOpen = settings.settings().railOpen;

    derived railVisible = docked && hasChat && railOpen;

    derived sheetVisible = !docked && hasChat && chatOpen;

    derived openChat = hasChat && (docked ? !railOpen : !chatOpen)
        ? (): void =>
        {
            if (docked)
            {
                settings.update({ railOpen: true });
                return;
            }

            chatOpen = true;
        }
        : undefined;

    derived resigning = seated && showing && board.match()?.finishedAt === undefined;

    const resign = async (): Promise<void> =>
    {
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('match.resign.title'),
                lead: locale.t('match.resign.lead'),
                confirm: locale.t('match.resign.confirm'),
                destructive: true
            },
            { label: locale.t('match.resign.title') }
        ).closed;

        if (yes === true)
        {
            await board.resign();
        }
    };

    derived playing = showing ? (board.match()?.game ?? '') : '';

    state boardFailed = false;

    let failures = 0;

    const draw = (want: string): void =>
    {
        boardFailed = false;

        const load = want === 'hokm'
            ? import('../../components/games/hokm-board.component.azeroth')
            : import('../../components/games/match-board.component.azeroth');

        void load.then((module) =>
        {
            if (playing !== want)
            {
                return;
            }

            Board = module.default;
            drawn = want;
        }).catch(() =>
        {
            failures += 1;

            if (playing === want)
            {
                boardFailed = true;
            }
        });
    };

    const redraw = (): void =>
    {
        if (failures > 1)
        {
            window.location.reload();
            return;
        }

        draw(playing);
    };

    effect
    {
        const want = playing;

        if (want === '' || want === drawn)
        {
            return;
        }

        draw(want);
    }

    const boardProps = (): { match: MatchView; starting: boolean; onAgain?: () => void } => ({
        match: board.match()!,
        starting,
        onAgain: seated ? () => void begin() : undefined
    });

    effect
    {
        const id = table?.matchId;

        if (id !== undefined && seated)
        {
            if (board.openId() !== id)
            {
                board.open(id);
            }

            return;
        }

        const held = board.match();

        if (held === null || held.tableId !== table?.id)
        {
            board.close();
        }
    }

    effect
    {
        const id = table?.matchId;

        if (id !== undefined && !seated)
        {
            watch.open(id);
        }
        else
        {
            watch.close();
        }
    }

    const begin = async (): Promise<void> =>
    {
        if (table === null || starting)
        {
            return;
        }

        starting = true;

        try
        {
            await lobby.begin(table.id);
        }
        catch
        {
            toasts.show({ kind: 'warning', text: locale.t('state.errorLead') });
        }
        finally
        {
            starting = false;
        }
    };

    const copyLink = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        try
        {
            await navigator.clipboard.writeText(`${ window.location.origin }/app/play/${ table.id }`);
            toasts.show({ kind: 'success', text: locale.t('play.lobby.copied') });
        }
        catch
        {
            toasts.show({ kind: 'warning', text: locale.t('state.errorLead') });
        }
    };

    const sitDown = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const seat = await lobby.claim(table.id);

        toasts.show(seat === null
            ? { kind: 'warning', text: locale.t('play.table.tooLate') }
            : { kind: 'success', text: locale.t('play.table.satDown') });
    };

    const leave = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const last = table.taken <= 1;
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.leave.title'),
                lead: locale.t(last ? 'play.leave.last' : 'play.leave.lead'),
                confirm: locale.t('play.lobby.leave'),
                destructive: true
            },
            { label: locale.t('play.leave.title') }
        ).closed;

        if (yes === true)
        {
            await lobby.leave(table.id);
            navigate('/app/games');
        }
    };

    const end = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.close.title'),
                lead: locale.t('play.close.lead'),
                confirm: locale.t('play.close.confirm'),
                destructive: true
            },
            { label: locale.t('play.close.title') }
        ).closed;

        if (yes === true)
        {
            await lobby.end(table.id);
            navigate('/app/games');
        }
    };

    <Page label={ title } fill>
        <Show when={ loading }>
            { () =>
                <div class="flex flex-col gap-4 pt-4">
                    <Skeleton class="h-8 w-48" />
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                    </div>
                </div>
            }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ () => void lobby.refresh() } class="py-12" /> }
        </Show>

        <Show when={ !loading && !failed && table === null }>
            { () =>
                <EmptyState
                    icon="seat"
                    title={ locale.t('play.notFound') }
                    lead={ locale.t('play.notFoundLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ table?.status === 'closed' }>
            { () =>
                <EmptyState
                    icon="clock"
                    title={ locale.t('play.closed') }
                    lead={ locale.t('play.closedLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ table !== null && table.status !== 'closed' }>
            { () =>
                <div class="flex min-h-0 flex-1 gap-4">
                    <div
                        ref={ (element) => arena = element }
                        class={ () => [ 'flex min-w-0 flex-1 flex-col gap-4 bg-void py-2', sheetVisible ? (chatWide ? '' : 'pb-[48dvh]') : '' ].filter(Boolean).join(' ') }
                    >
                        <PlayHeader
                            table={ table! }
                            others={ lobby.seated().filter((one) => one.id !== table!.id) }
                            tools={
                                <TableDock
                                    code={ table!.code }
                                    target={ arena }
                                    onChat={ openChat }
                                    onResign={ resigning ? () => void resign() : undefined }
                                />
                            }
                        />

                        <Show when={ playing !== '' && drawn === playing }>
                            { () => <Dynamic component={ Board! } props={ boardProps } /> }
                        </Show>

                        <Show when={ playing !== '' && drawn !== playing && boardFailed }>
                            { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ redraw } class="py-12" /> }
                        </Show>

                        <Show when={ playing !== '' && drawn !== playing && !boardFailed }>
                            { () =>
                                <div class="flex flex-col gap-3" aria-busy="true">
                                    <Skeleton class="aspect-[16/10] w-full rounded-hero" />
                                    <Skeleton class="h-24 w-full rounded-panel" />
                                </div>
                            }
                        </Show>

                        <Show when={ !showing && ready && seated }>
                            { () =>
                                <Panel pad="md" stack="sm" class="items-center text-center">
                                    <p class="text-ui-base text-muted">{ locale.t('match.startHint') }</p>
                                    <Button variant="primary" size="lg" leading="play" loading={ starting } onClick={ () => void begin() }>
                                        { locale.t('match.start') }
                                    </Button>
                                </Panel>
                            }
                        </Show>

                        <Show when={ !seated && table?.matchId !== undefined }>
                            { () =>
                                <div class="flex flex-col gap-3">
                                    <Show when={ watch.view() !== null }>
                                        { () => <WatchBoard watch={ watch.view()! } /> }
                                    </Show>
                                    <Show when={ watch.view() === null && !watch.loading() }>
                                        { () =>
                                            <Panel pad="lg" class="items-center text-center">
                                                <p class="text-ui-base text-muted">{ locale.t('watch.waiting') }</p>
                                            </Panel>
                                        }
                                    </Show>
                                </div>
                            }
                        </Show>

                        <Show
                            when={ !showing && seated }
                            fallback={ table === null || showing ? null :
                                <Panel pad="lg" stack="md" class="items-center text-center">
                                    <p class="text-ui-lg text-text">{ locale.t('play.table.watching') }</p>
                                    <p class="max-w-[44ch] text-ui-base text-muted">
                                        { locale.plural('play.lobby.emptySeats', table.seats - table.taken) }
                                    </p>
                                    <Button
                                        variant="primary"
                                        size="lg"
                                        leading="seat"
                                        disabled={ table.taken >= table.seats }
                                        onClick={ () => void sitDown() }
                                    >
                                        { locale.t('play.table.sitDown') }
                                    </Button>
                                </Panel>
                            }
                        >
                            { () =>
                                <LobbyPanel
                                    table={ table! }
                                    onInvite={ () => overlay.open(InviteSheet, { tableId: table!.id }, { label: locale.t('play.lobby.invite') }) }
                                    onCopyLink={ () => void copyLink() }
                                    onLeave={ () => void leave() }
                                />
                            }
                        </Show>

                        <Show when={ amHost && !showing }>
                            { () =>
                                <div class="flex">
                                    <Button variant="destructive" size="sm" leading="close" onClick={ () => void end() }>
                                        { locale.t('play.close.confirm') }
                                    </Button>
                                </div>
                            }
                        </Show>

                    </div>

                    <Show when={ sheetVisible }>
                        { () =>
                            <div
                                class={ () => [
                                    'table-sheet fixed inset-x-0 bottom-0 z-30 flex flex-col overflow-hidden rounded-t-sheet border-t border-line-strong bg-field',
                                    chatWide ? 'top-3' : 'h-[48dvh]'
                                ].join(' ') }
                            >
                                <TableChat
                                    conversationId={ table?.conversationId ?? '' }
                                    class="min-h-0 flex-1"
                                    closeIcon="close"
                                    wide={ chatWide }
                                    onResize={ () => chatWide = !chatWide }
                                    onClose={ () => chatOpen = false }
                                />
                            </div>
                        }
                    </Show>

                    <Show when={ railVisible }>
                        { () =>
                            <aside
                                class={ () => [
                                    'flex min-h-0 shrink-0 flex-col border-s border-line bg-field transition-[width] duration-200',
                                    chatWide ? 'w-[min(30rem,40vw)]' : 'w-[var(--social-w)]'
                                ].join(' ') }
                            >
                                <TableChat
                                    conversationId={ table?.conversationId ?? '' }
                                    class="min-h-0 flex-1"
                                    wide={ chatWide }
                                    onResize={ () => chatWide = !chatWide }
                                    onClose={ () => settings.update({ railOpen: false }) }
                                />
                            </aside>
                        }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
