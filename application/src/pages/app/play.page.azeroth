import { useHead, useNavigate, useParams } from 'azerothjs';

import ConfirmSheet from '../../components/app/confirm-sheet.component.azeroth';
import Page from '../../components/app/page.component.azeroth';
import InviteSheet from '../../components/games/invite-sheet.component.azeroth';
import LobbyPanel from '../../components/games/lobby-panel.component.azeroth';
import TableChat from '../../components/games/table-chat.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

/**
 * One table, as it stands.
 *
 * The version this replaces had seven phases and a state machine to walk between them: searching,
 * found, lobby, starting, playing, result. Six of the seven were a simulation - opponents arriving
 * on a timer, a countdown to a game that never began, a winner nobody beat - and what is left is
 * the one that was always real: people in chairs.
 */
export default component PlayPage()
{
    const locale = useLocale();
    const lobby = useLobby();
    const catalogue = useCatalogue();
    const device = useDevice();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const params = useParams();
    const { navigate } = useNavigate();

    state chatOpen = false;

    mount
    {
        lobby.open(params().id ?? '');
        const release = shell.claimTitle(() => title);

        return () =>
        {
            release();
            lobby.close();
        };
    }

    derived table = lobby.table();

    derived loading = lobby.loading() && table === null;

    derived failed = lobby.failed() !== undefined && table === null;

    derived seated = table?.mine !== undefined;

    derived amHost = table?.chairs.find((chair) => chair.seat === table!.mine)?.host === true;

    derived title = table === null
        ? locale.t('play.notFound')
        : locale.t(catalogue.byId(table.game as GameId).nameKey);

    useHead({ title: () => title });

    derived phone = device.posture() === 'phone';

    derived railVisible = !phone && seated && table?.conversationId !== undefined;

    const copyLink = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        try
        {
            await navigator.clipboard.writeText(`${ window.location.origin }/app/play/${ table.id }`);
            toasts.show({ kind: 'success', text: locale.t('play.lobby.copied') });
        }
        catch
        {
            toasts.show({ kind: 'warning', text: locale.t('state.errorLead') });
        }
    };

    const sitDown = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const seat = await lobby.claim(table.id);

        // No chair is an ANSWER, not a failure: somebody reached the last one first, which is an
        // ordinary thing for a table to do between one page load and one tap.
        toasts.show(seat === null
            ? { kind: 'warning', text: locale.t('play.table.tooLate') }
            : { kind: 'success', text: locale.t('play.table.satDown') });
    };

    const leave = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const last = table.taken <= 1;
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.leave.title'),
                lead: locale.t(last ? 'play.leave.last' : 'play.leave.lead'),
                confirm: locale.t('play.lobby.leave'),
                destructive: true
            },
            { label: locale.t('play.leave.title') }
        ).closed;

        if (yes === true)
        {
            await lobby.leave(table.id);
            navigate('/app/games');
        }
    };

    const end = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.close.title'),
                lead: locale.t('play.close.lead'),
                confirm: locale.t('play.close.confirm'),
                destructive: true
            },
            { label: locale.t('play.close.title') }
        ).closed;

        if (yes === true)
        {
            await lobby.end(table.id);
            navigate('/app/games');
        }
    };

    <Page label={ title } fill>
        <Show when={ loading }>
            { () =>
                <div class="flex flex-col gap-4 pt-4">
                    <Skeleton class="h-8 w-48" />
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                    </div>
                </div>
            }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ () => void lobby.refresh() } class="py-12" /> }
        </Show>

        <Show when={ !loading && !failed && table === null }>
            { () =>
                <EmptyState
                    icon="seat"
                    title={ locale.t('play.notFound') }
                    lead={ locale.t('play.notFoundLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ table !== null && table!.status === 'closed' }>
            { () =>
                <EmptyState
                    icon="clock"
                    title={ locale.t('play.closed') }
                    lead={ locale.t('play.closedLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ table !== null && table!.status !== 'closed' }>
            { () =>
                <div class="flex min-h-0 flex-1 gap-4">
                    <div class="flex min-w-0 flex-1 flex-col gap-5 py-2">
                        <Show
                            when={ seated }
                            fallback={ table === null ? null :
                                <div class="flex flex-col items-center gap-4 rounded-panel border border-line bg-field p-6 text-center">
                                    <p class="text-ui-lg text-text">{ locale.t('play.table.watching') }</p>
                                    <p class="max-w-[44ch] text-ui-base text-muted">
                                        { locale.plural('play.lobby.emptySeats', table.seats - table.taken) }
                                    </p>
                                    <IconButton
                                        icon="seat"
                                        label={ locale.t('play.table.sitDown') }
                                        variant="primary"
                                        size="lg"
                                        disabled={ table.taken >= table.seats }
                                        onClick={ () => void sitDown() }
                                    />
                                </div>
                            }
                        >
                            { () =>
                                <LobbyPanel
                                    table={ table! }
                                    onInvite={ () => overlay.open(InviteSheet, { tableId: table!.id }, { label: locale.t('play.lobby.invite') }) }
                                    onCopyLink={ () => void copyLink() }
                                    onLeave={ () => void leave() }
                                />
                            }
                        </Show>

                        <Show when={ amHost }>
                            { () =>
                                <button
                                    type="button"
                                    class="-ms-3 flex min-h-11 w-fit cursor-pointer items-center rounded-control px-3 text-ui-sm font-semibold text-madder transition-colors duration-150 hover:bg-madder/10"
                                    onClick={ () => void end() }
                                >
                                    { locale.t('play.close.confirm') }
                                </button>
                            }
                        </Show>

                        <Show when={ phone && table!.conversationId !== undefined && chatOpen }>
                            { () =>
                                <TableChat
                                    conversationId={ table!.conversationId! }
                                    class="min-h-[18rem] rounded-panel border border-line bg-field"
                                    onClose={ () => chatOpen = false }
                                />
                            }
                        </Show>

                        <Show when={ phone && table!.conversationId !== undefined && !chatOpen }>
                            { () =>
                                <button
                                    type="button"
                                    class="mx-auto flex min-h-11 cursor-pointer items-center gap-2 rounded-control px-3 text-ui-sm font-semibold text-accent"
                                    onClick={ () => chatOpen = true }
                                >
                                    { locale.t('play.table.chat') }
                                </button>
                            }
                        </Show>
                    </div>

                    <Show when={ railVisible }>
                        { () =>
                            <aside class="hidden w-[var(--social-w)] shrink-0 border-s border-line lg:flex lg:min-h-0 lg:flex-col">
                                <TableChat conversationId={ table!.conversationId! } class="min-h-0 flex-1" />
                            </aside>
                        }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
