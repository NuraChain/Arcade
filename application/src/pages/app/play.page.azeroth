import { useHead, useNavigate, useParams } from 'azerothjs';

import ConfirmSheet from '../../components/app/confirm-sheet.component.azeroth';
import Page from '../../components/app/page.component.azeroth';
import InviteSheet from '../../components/games/invite-sheet.component.azeroth';
import LobbyPanel from '../../components/games/lobby-panel.component.azeroth';
import MatchBoard from '../../components/games/match-board.component.azeroth';
import WatchBoard from '../../components/games/watch-board.component.azeroth';
import TableChat from '../../components/games/table-chat.component.azeroth';
import TableDock from '../../components/games/table-dock.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import ErrorState from '../../components/ui/error-state.component.azeroth';
import Skeleton from '../../components/ui/skeleton.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useWatch } from '../../stores/watch.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Panel from '../../components/ui/panel.component.azeroth';
import { PANEL_TONE } from '../../components/ui/variants.ts';

/**
 * One table, as it stands.
 *
 * The version this replaces had seven phases and a state machine to walk between them: searching,
 * found, lobby, starting, playing, result. Six of the seven were a simulation - opponents arriving
 * on a timer, a countdown to a game that never began, a winner nobody beat - and what is left is
 * the one that was always real: people in chairs.
 */
export default component PlayPage()
{
    const locale = useLocale();
    const lobby = useLobby();
    const board = useBoard();
    const catalogue = useCatalogue();
    const device = useDevice();
    const watch = useWatch();
    const overlay = useOverlay();
    const shell = useShell();
    const toasts = useToasts();
    const params = useParams();
    const { navigate } = useNavigate();

    state chatOpen = false;

    /**
     * The element the fullscreen button fills the screen with.
     *
     * The board and its controls rather than the document, so filling the screen leaves the game
     * and loses the rail, the top bar and the key banner - which is the whole reason somebody
     * presses it on a phone. Captured in a plain `let` because it is read by an event handler and
     * never rendered from; a signal here would be reactivity nothing subscribes to.
     */
    let arena: HTMLElement | null = null;

    /**
     * On a phone the chat opens BELOW the board, the turn panel and the seat list - which on a
     * 390-wide screen is well past the fold, so pressing "Show chat" looked like pressing nothing
     * at all. Bringing it into view is what makes the button honest about what it did.
     *
     * Called from the element's own `ref`, which fires when it mounts, so there is no guessing at
     * when the panel exists; and it follows the reduced-motion setting, because an unexpected
     * smooth scroll is exactly the motion that setting is for.
     */
    const showChat = (element: HTMLElement | null): void =>
    {
        if (element === null)
        {
            return;
        }

        /**
         * `start`, not `nearest`: the panel is taller than whatever is left below the seat list, so
         * `nearest` counts its top as already visible and scrolls almost nothing - sixty pixels of
         * chat at the bottom of the screen. And on the NEXT frame, because this runs from the ref
         * as the element mounts, when it has no box yet and `scrollIntoView` would measure zero.
         */
        const smooth = !device.reducedMotion();

        requestAnimationFrame(() => element.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' }));
    };

    state starting = false;

    mount
    {
        lobby.open(params().id ?? '');
        const release = shell.claimTitle(() => title);

        return () =>
        {
            release();
            lobby.close();
        };
    }

    derived table = lobby.table();

    derived loading = lobby.loading() && table === null;

    derived failed = lobby.failed() !== undefined && table === null;

    derived seated = table?.mine !== undefined;

    derived amHost = table?.chairs.find((chair) => chair.seat === table!.mine)?.host === true;

    /** A board worth drawing: this table's game, live or just finished. */
    derived showing = board.match() !== null && board.match()!.tableId === table?.id;

    derived ready = table !== null
        && table.status === 'ready'
        && table.chairs.every((chair) => chair.ready);

    /**
     * A table still loading is not a table that does not exist.
     *
     * The title read `play.notFound` whenever `table` was null, which is true for the whole first
     * fetch - so every navigation into a perfectly good table flashed "No such table." in the tab
     * and the top bar before the data landed. The same shape `regression-pass.mjs` already guards
     * for a chat thread.
     */
    derived title = table !== null
        ? locale.t(catalogue.byId(table.game as GameId).nameKey)
        : (loading ? locale.t('common.loading') : locale.t('play.notFound'));

    useHead({ title: () => title });

    derived phone = device.posture() === 'phone';

    derived railVisible = !phone && seated && table?.conversationId !== undefined;

    /**
     * The board follows the table.
     *
     * A match id appears on the table the moment somebody starts one, and disappears when it ends,
     * so the store is opened and closed from that rather than from a route parameter - which is
     * also what makes a second person's Start reach this page through the ordinary doorbell.
     */
    effect
    {
        const id = table?.matchId;

        /**
         * Only somebody SITTING here opens the player's board.
         *
         * `GET /matches/:id` resolves the caller's chair and answers 404 to anybody who has none -
         * which is right, and which made a watcher's page fetch it anyway and put a 404 in the
         * console on every visit. A spectator reads `watch` instead, and the two are kept apart
         * here rather than by hoping the route is forgiving.
         */
        if (id !== undefined && seated)
        {
            if (board.openId() !== id)
            {
                board.open(id);
            }

            return;
        }

        /**
         * A finished match is not a match to close, it is a match to LOOK at.
         *
         * `matchId` is the LIVE one, so it clears the instant somebody wins - and closing on that
         * took the board off the screen at the exact moment it had something to say, dropping the
         * winner straight back to a lobby with a Start button. It stays until this page is left or
         * another game is dealt, and the result panel is what offers the rematch.
         *
         * The test is which TABLE the held match belongs to, deliberately, and not whether it has
         * finished yet. Two reads learn about the end separately: the table's own refetch drops
         * `matchId` first and the match view is still the one from before the final move, so asking
         * "has it finished?" here closes the board in the window between them - which is exactly the
         * moment it is wanted. Belonging to this table is true throughout.
         */
        const held = board.match();

        if (held === null || held.tableId !== table?.id)
        {
            board.close();
        }
    }

    /**
     * Watching, which is what a table with a game on it looks like to somebody with no chair.
     *
     * The board that arrives is two minutes old and the server is what holds it back - nothing here
     * waits or buffers, because a delay a client implements is a delay the network tab undoes. It
     * opens only when there is a match AND this reader is not in it: a player reads the live board
     * through `board`, and offering them a stale one beside it would be two boards disagreeing.
     */
    effect
    {
        const id = table?.matchId;

        if (id !== undefined && !seated)
        {
            watch.open(id);
        }
        else
        {
            watch.close();
        }
    }

    /**
     * And it stops when this page is left.
     *
     * The effect above closes the watch when the TABLE stops having a live match, which never
     * happens by navigating away - so the store kept the last match id, went on polling it every
     * ten seconds from whatever page came next, and eventually 404'd into the console once that
     * game had finished. A store that keeps working after its only reader is gone is the same
     * defect as a timer nobody clears.
     */
    mount
    {
        return () =>
        {
            watch.close();
            board.close();
        };
    }

    const begin = async (): Promise<void> =>
    {
        if (table === null || starting)
        {
            return;
        }

        starting = true;

        try
        {
            await lobby.begin(table.id);
        }
        catch
        {
            toasts.show({ kind: 'warning', text: locale.t('state.errorLead') });
        }
        finally
        {
            starting = false;
        }
    };

    const copyLink = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        try
        {
            await navigator.clipboard.writeText(`${ window.location.origin }/app/play/${ table.id }`);
            toasts.show({ kind: 'success', text: locale.t('play.lobby.copied') });
        }
        catch
        {
            toasts.show({ kind: 'warning', text: locale.t('state.errorLead') });
        }
    };

    const sitDown = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const seat = await lobby.claim(table.id);

        // No chair is an ANSWER, not a failure: somebody reached the last one first, which is an
        // ordinary thing for a table to do between one page load and one tap.
        toasts.show(seat === null
            ? { kind: 'warning', text: locale.t('play.table.tooLate') }
            : { kind: 'success', text: locale.t('play.table.satDown') });
    };

    const leave = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const last = table.taken <= 1;
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.leave.title'),
                lead: locale.t(last ? 'play.leave.last' : 'play.leave.lead'),
                confirm: locale.t('play.lobby.leave'),
                destructive: true
            },
            { label: locale.t('play.leave.title') }
        ).closed;

        if (yes === true)
        {
            await lobby.leave(table.id);
            navigate('/app/games');
        }
    };

    const end = async (): Promise<void> =>
    {
        if (table === null)
        {
            return;
        }
        const yes = await overlay.open(
            ConfirmSheet,
            {
                title: locale.t('play.close.title'),
                lead: locale.t('play.close.lead'),
                confirm: locale.t('play.close.confirm'),
                destructive: true
            },
            { label: locale.t('play.close.title') }
        ).closed;

        if (yes === true)
        {
            await lobby.end(table.id);
            navigate('/app/games');
        }
    };

    <Page label={ title } fill>
        <Show when={ loading }>
            { () =>
                <div class="flex flex-col gap-4 pt-4">
                    <Skeleton class="h-8 w-48" />
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                        <Skeleton class="h-[9.5rem] rounded-panel" />
                    </div>
                </div>
            }
        </Show>

        <Show when={ failed }>
            { () => <ErrorState title={ locale.t('state.errorTitle') } lead={ locale.t('state.errorLead') } onRetry={ () => void lobby.refresh() } class="py-12" /> }
        </Show>

        <Show when={ !loading && !failed && table === null }>
            { () =>
                <EmptyState
                    icon="seat"
                    title={ locale.t('play.notFound') }
                    lead={ locale.t('play.notFoundLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ table !== null && table!.status === 'closed' }>
            { () =>
                <EmptyState
                    icon="clock"
                    title={ locale.t('play.closed') }
                    lead={ locale.t('play.closedLead') }
                    action={ locale.t('app.nav.games') }
                    to="/app/games"
                    class="py-12"
                />
            }
        </Show>

        <Show when={ table !== null && table!.status !== 'closed' }>
            { () =>
                <div class="flex min-h-0 flex-1 gap-4">
                    <div
                        ref={ (element) => arena = element }
                        class="flex min-w-0 flex-1 flex-col gap-5 bg-void py-2"
                    >
                        <Show when={ showing }>
                            { () =>
                                <MatchBoard
                                    match={ board.match()! }
                                    starting={ starting }
                                    onAgain={ seated ? () => void begin() : undefined }
                                />
                            }
                        </Show>

                        <Show when={ !showing && ready && seated }>
                            { () =>
                                <Panel pad="md" stack="sm" class="items-center text-center">
                                    <p class="text-ui-base text-muted">{ locale.t('match.startHint') }</p>
                                    <Button variant="primary" size="lg" leading="zap" loading={ starting } onClick={ () => void begin() }>
                                        { locale.t('match.start') }
                                    </Button>
                                </Panel>
                            }
                        </Show>

                        <Show when={ !seated && table!.matchId !== undefined }>
                            { () =>
                                <div class="flex flex-col gap-3">
                                    <Show when={ watch.view() !== null }>
                                        { () => <WatchBoard watch={ watch.view()! } /> }
                                    </Show>
                                    <Show when={ watch.view() === null && !watch.loading() }>
                                        { () =>
                                            <Panel pad="lg" class="items-center text-center">
                                                <p class="text-ui-base text-muted">{ locale.t('watch.waiting') }</p>
                                            </Panel>
                                        }
                                    </Show>
                                </div>
                            }
                        </Show>

                        <Show
                            when={ !showing && seated }
                            fallback={ table === null || showing ? null :
                                <Panel pad="lg" stack="md" class="items-center text-center">
                                    <p class="text-ui-lg text-text">{ locale.t('play.table.watching') }</p>
                                    <p class="max-w-[44ch] text-ui-base text-muted">
                                        { locale.plural('play.lobby.emptySeats', table.seats - table.taken) }
                                    </p>
                                    <Button
                                        variant="primary"
                                        size="lg"
                                        leading="seat"
                                        disabled={ table.taken >= table.seats }
                                        onClick={ () => void sitDown() }
                                    >
                                        { locale.t('play.table.sitDown') }
                                    </Button>
                                </Panel>
                            }
                        >
                            { () =>
                                <LobbyPanel
                                    table={ table! }
                                    onInvite={ () => overlay.open(InviteSheet, { tableId: table!.id }, { label: locale.t('play.lobby.invite') }) }
                                    onCopyLink={ () => void copyLink() }
                                    onLeave={ () => void leave() }
                                />
                            }
                        </Show>

                        <Show when={ amHost && !showing }>
                            { () =>
                                <div class="flex">
                                    <Button variant="destructive" size="sm" leading="close" onClick={ () => void end() }>
                                        { locale.t('play.close.confirm') }
                                    </Button>
                                </div>
                            }
                        </Show>

                        <Show when={ phone && table!.conversationId !== undefined && chatOpen }>
                            { () =>
                                <div ref={ (element) => showChat(element) }>
                                    <TableChat
                                        conversationId={ table!.conversationId! }
                                        class={ `min-h-[18rem] rounded-panel ${ PANEL_TONE.field }` }
                                        onClose={ () => chatOpen = false }
                                    />
                                </div>
                            }
                        </Show>

                        <Show when={ !chatOpen }>
                            { () =>
                                <TableDock
                                    code={ table!.code }
                                    target={ arena }
                                    onChat={ phone && table!.conversationId !== undefined ? () => chatOpen = true : undefined }
                                />
                            }
                        </Show>
                    </div>

                    <Show when={ railVisible }>
                        { () =>
                            <aside class="hidden w-[var(--social-w)] shrink-0 border-s border-line bg-field lg:flex lg:min-h-0 lg:flex-col">
                                <TableChat conversationId={ table!.conversationId! } class="min-h-0 flex-1" />
                            </aside>
                        }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
