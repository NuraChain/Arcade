import { useHead, useNavigate } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import GameGrid from '../../components/games/game-grid.component.azeroth';
import GroupCard from '../../components/social/group-card.component.azeroth';
import UserCard from '../../components/social/user-card.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import type { GameId } from '../../data/games.ts';

import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { openTable } from '../../lib/open-table.ts';

export default component DiscoverPage()
{
    const locale = useLocale();
    const social = useSocial();
    const presence = usePresence();
    const groups_ = useGroups();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const toasts = useToasts();
    const { navigate } = useNavigate();

    useHead({ title: () => locale.t('app.nav.discover') });

    mount
    {
        social.want('suggestions');
        social.want('people');
        groups_.want();
    }

    derived suggestions = social.suggestions().slice(0, 8);

    derived groups = groups_.elsewhere().slice(0, 12);

    derived trending = [...catalogue.games].sort((a, b) => catalogue.stats(b.id).playersOnline - catalogue.stats(a.id).playersOnline).slice(0, 3);

    const quickPlay = (game: GameId): void =>
    {
        openTable(lobby.quick(game), navigate);
    };

    <Page
        label={ locale.t('app.nav.discover') }
        onRefresh={ () =>
        {
            presence.refresh();
            catalogue.refresh();
        } }
    >
        <header class="pb-5">
            <h1 class="title text-ui-4xl">{ locale.t('app.nav.discover') }</h1>
            <p class="mt-2 text-ui-md text-muted">{ locale.t('discover.lead') }</p>
        </header>

        <div class="flex flex-col gap-8">
            <section>
                <SectionHeading title={ locale.t('discover.people') } more={ locale.t('common.seeAll') } to="/app/friends" />
                <ul class="grid grid-cols-2 gap-3 @lg:grid-cols-3 @3xl:grid-cols-4 @5xl:grid-cols-5 @7xl:grid-cols-6" aria-label={ locale.t('discover.people') }>
                    <For each={ suggestions } key={ (person) => person.id } let={ person }>
                        <li class="flex min-w-0">
                            <div class="flex-1">
                                <UserCard
                                    person={ person }
                                    onAdd={ (id) =>
                                    {
                                        social.add(id);
                                        toasts.show({ kind: 'success', text: locale.t('person.added') });
                                    } }
                                />
                            </div>
                        </li>
                    </For>
                </ul>
            </section>

            <section>
                <SectionHeading title={ locale.t('discover.rooms') } />
                <ul class="grid gap-2 @2xl:grid-cols-2 @6xl:grid-cols-3" aria-label={ locale.t('discover.rooms') }>
                    <For each={ groups } key={ (group) => group.id } let={ group }>
                        <li class="flex min-w-0">
                            <GroupCard group={ group } class="flex-1" />
                        </li>
                    </For>
                </ul>
            </section>

            <section>
                <SectionHeading title={ locale.t('discover.trending') } more={ locale.t('common.seeAll') } to="/app/games" />
                <GameGrid games={ trending } compact label={ locale.t('discover.trending') } onQuickPlay={ quickPlay } />
            </section>
        </div>
    </Page>
}
