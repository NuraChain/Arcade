import { useHead } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import PersonRecord, { type RecordPart } from '../../components/social/person-record.component.azeroth';
import ProfileHeader from '../../components/social/profile-header.component.azeroth';
import Badge from '../../components/ui/badge.component.azeroth';
import Tabs from '../../components/ui/tabs.component.azeroth';
import ProfileSheet from '../../components/app/profile-sheet.component.azeroth';
import Panel from '../../components/ui/panel.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import IconButton from '../../components/ui/icon-button.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import Tooltip from '../../components/ui/tooltip.component.azeroth';
import { NURA_CHAIN } from '../../data/chain.ts';
import Icon from '../../icons/icon.component.azeroth';
import { shortAddress } from '../../lib/wallet.ts';
import { copyText } from '../../lib/clipboard.ts';
import type { MessageKey } from '../../locales/en/index.ts';

import { useAccount } from '../../stores/account.store.ts';
import { useChain, type PublishOutcome } from '../../stores/chain.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useRealtime } from '../../stores/realtime.store.ts';
import { useRecord } from '../../stores/record.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

const OUTCOME: Record<PublishOutcome, MessageKey> = {
    published: 'chain.published',
    rejected: 'chain.rejected',
    reverted: 'chain.reverted',
    pending: 'chain.pending',
    unavailable: 'chain.unavailable',
    'wrong-chain': 'chain.wrongChain'
};

export default component MePage()
{
    const locale = useLocale();
    const overlay = useOverlay();
    const account = useAccount();
    const social = useSocial();
    const toasts = useToasts();
    const chain = useChain();
    const live = useRealtime();
    const record = useRecord();

    state tab = 'overview';

    const PARTS: Record<string, RecordPart[]> = {
        overview: ['level', 'achievements', 'history'],
        games: ['record', 'history'],
        achievements: ['achievements'],
        about: []
    };

    const editProfile = (): void =>
    {
        void overlay.open(ProfileSheet, {}, { label: locale.t('profile.title') }).closed;
    };

    const copyAddress = async (): Promise<void> =>
    {
        const address = account.address();
        if (address === null)
        {
            return;
        }
        await copyText(address, 'wallet.address.copied', { dedupe: 'wallet.address' });
    };

    useHead({ title: () => locale.t('app.nav.profile') });

    derived user = account.user();

    derived bio = user === null ? '' : user.bio;

    derived held = record.record();

    derived stats = [
        { label: locale.t('profile.stat.friends'), value: social.friends().length },
        { label: locale.t('profile.stat.games'), value: (held?.games ?? []).reduce((sum, one) => sum + one.played, 0) },
        { label: locale.t('profile.stat.achievements'), value: (held?.achievements.scopes ?? []).reduce((total, one) => total + one.earned, 0) }
    ];

    derived connected = live.status() === 'connected';

    const share = async (): Promise<void> =>
    {
        const link = `${ window.location.origin }/app/people/${ user?.handle ?? '' }`;
        await copyText(link, 'me.shared');
    };

    derived showChain = account.isWallet() && (chain.sync() !== 'off' || chain.failed());

    derived chainNote = chain.failed()
        ? 'chain.failed'
        : chain.sync() === 'absent'
            ? 'chain.absent'
            : chain.sync() === 'synced' ? 'chain.synced' : 'chain.drifted';

    derived publishLabel = chain.sync() === 'absent' ? 'chain.create' : 'chain.publish';

    derived publishable = chain.sync() === 'absent' || chain.sync() === 'drifted' || chain.record() === 'stale';

    derived registryName = (chain.profile()?.username ?? '') === ''
        ? locale.t('chain.noUsername')
        : chain.profile()!.username;

    const publish = async (): Promise<void> =>
    {
        const outcome = await chain.publish();
        toasts.show({ kind: outcome === 'published' ? 'success' : 'warning', text: locale.t(OUTCOME[outcome], { chain: NURA_CHAIN.name }) });
    };

    const adopt = async (): Promise<void> =>
    {
        const taken = await chain.adopt();
        toasts.show({ kind: taken ? 'success' : 'warning', text: locale.t(taken ? 'chain.adopted' : 'profile.failed') });
    };

    <Page label={ locale.t('app.nav.profile') }>
        <Show
            when={ user !== null }
            fallback={ <EmptyState icon="me" title={ locale.t('person.notFound') } action={ locale.t('app.nav.home') } to="/app" class="py-12" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <ProfileHeader
                        person={ { displayName: locale.text(user!.displayName), hue: user!.hue, handle: user!.handle } }
                        presence={ connected ? 'online' : null }
                        bio={ bio }
                        stats={ stats }
                        onEditBio={ editProfile }
                        badges={
                            <span class="contents">
                                <Show when={ connected }>
                                    <Badge dot text={ locale.t('common.online') } tone="live" />
                                </Show>
                                <Show when={ account.isWallet() }>
                                    <span class="inline-flex h-6 items-center gap-1.5 rounded-full border border-line bg-raised px-2.5 text-ui-xs font-semibold text-muted">
                                        <Icon name="key" size={ 12 } class="text-live" />
                                        <span class="tally">{ shortAddress(account.address() ?? '') }</span>
                                    </span>
                                </Show>
                            </span>
                        }
                        actions={
                            <span class="contents">
                                <Button variant="primary" leading="edit" block class="col-span-2" onClick={ editProfile }>{ locale.t('me.edit') }</Button>
                                <Button variant="secondary" leading="settings" block to="/app/me/settings">{ locale.t('me.settings') }</Button>
                                <Button variant="secondary" leading="share" block onClick={ () => void share() }>{ locale.t('me.share') }</Button>
                            </span>
                        }
                    />

                    <Show when={ !account.isWallet() }>
                        { () =>
                            <Panel section tone="accent">
                                <h2 class="flex items-center gap-2 title text-ui-lg text-text">
                                    <Icon name="key" size={ 18 } class="text-accent" />
                                    { locale.t('me.keepSeat.title') }
                                </h2>
                                <p class="mt-1 text-ui-base text-muted">{ locale.t('me.keepSeat.lead') }</p>
                            </Panel>
                        }
                    </Show>

                    <Tabs
                        label={ locale.t('me.tabs') }
                        value={ tab }
                        onChange={ (id) => tab = id }
                        items={ [
                            { id: 'overview', label: locale.t('me.tab.overview') },
                            { id: 'games', label: locale.t('me.tab.games') },
                            { id: 'achievements', label: locale.t('me.tab.achievements') },
                            { id: 'about', label: locale.t('me.tab.about') }
                        ] }
                    />

                    <PersonRecord handle={ user!.handle } history mine show={ PARTS[tab] } />

                    <Show when={ tab === 'about' }>
                    <section>
                        <SectionHeading title={ locale.t('person.friends') } />
                        <Panel class="text-ui-md text-text">
                            { locale.plural('friends.count', social.friends().length) }
                        </Panel>
                    </section>

                    <Show when={ showChain }>
                        { () =>
                            <section>
                                <SectionHeading title={ locale.t('chain.title') } />
                                <Panel class="flex flex-col gap-3">
                                    <p class="text-ui-sm text-muted">{ locale.t('chain.lead', { chain: NURA_CHAIN.name }) }</p>
                                    <p class="text-ui-base text-text">{ locale.t(chainNote) }</p>
                                    <Show when={ chain.record() === 'current' || chain.record() === 'stale' }>
                                        { () =>
                                            <p class="flex items-start gap-2 text-ui-sm text-muted">
                                                <Icon name={ chain.record() === 'current' ? 'check-circle' : 'history' } size={ 16 } class={ chain.record() === 'current' ? 'mt-0.5 shrink-0 text-live' : 'mt-0.5 shrink-0 text-gold' } />
                                                { locale.t(chain.record() === 'current' ? 'chain.recordCurrent' : 'chain.recordStale') }
                                            </p>
                                        }
                                    </Show>

                                    <Show when={ chain.profile() !== null }>
                                        { () =>
                                            <dl class="flex flex-col gap-1 border-t border-line pt-3 text-ui-sm">
                                                <div class="flex flex-wrap items-baseline gap-x-2">
                                                    <dt class="text-muted">{ locale.t('chain.username') }</dt>
                                                    <dd class="min-w-0 text-text" dir="auto">{ registryName }</dd>
                                                </div>
                                                <div class="text-ui-xs text-faint">
                                                    { locale.t('chain.number', { id: chain.profile()?.id ?? '' }) }
                                                </div>
                                            </dl>
                                        }
                                    </Show>

                                    <div class="flex flex-wrap gap-2">
                                        <Show when={ publishable }>
                                            { () =>
                                                <Button variant="primary" leading="send" loading={ chain.busy() } onClick={ () => void publish() }>
                                                    { locale.t(publishLabel) }
                                                </Button>
                                            }
                                        </Show>

                                        <Show when={ chain.sync() === 'drifted' }>
                                            { () =>
                                                <Button variant="outline" leading="refresh" loading={ chain.busy() } onClick={ () => void adopt() }>
                                                    { locale.t('chain.adopt') }
                                                </Button>
                                            }
                                        </Show>
                                    </div>
                                </Panel>
                            </section>
                        }
                    </Show>

                    <Show when={ account.isWallet() }>
                        { () =>
                            <section>
                                <SectionHeading title={ locale.t('wallet.address') } />
                                <Panel class="flex items-center gap-3">
                                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-live/15 text-live">
                                        <Icon name="key" size={ 18 } />
                                    </span>
                                    <span class="flex min-w-0 flex-1 flex-col">
                                        <Tooltip label={ account.address() ?? '' } side="bottom" class="min-w-0 max-w-full">
                                            <code class="tally truncate text-ui-base text-text">{ account.address() }</code>
                                        </Tooltip>
                                        <span class="text-ui-xs text-muted">{ locale.t('wallet.chainReady', { chain: NURA_CHAIN.name }) }</span>
                                    </span>
                                    <IconButton
                                        icon="copy"
                                        label={ locale.t('wallet.address.copy') }
                                        variant="ghost"
                                        onClick={ () => void copyAddress() }
                                    />
                                </Panel>
                                <p class="mt-2 text-ui-xs text-faint">{ locale.t('wallet.address.compare') }</p>
                            </section>
                        }
                    </Show>
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
