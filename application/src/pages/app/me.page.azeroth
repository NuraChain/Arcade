import { useHead } from 'azerothjs';

import Page from '../../components/app/page.component.azeroth';
import Avatar from '../../components/ui/avatar.component.azeroth';
import Button from '../../components/ui/button.component.azeroth';
import Chip from '../../components/ui/chip.component.azeroth';
import EmptyState from '../../components/ui/empty-state.component.azeroth';
import SectionHeading from '../../components/ui/section-heading.component.azeroth';
import { NURA_CHAIN } from '../../data/chain.ts';
import Icon from '../../icons/icon.component.azeroth';
import { shortAddress } from '../../lib/wallet.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

/**
 * Your own profile, and only what is true about it.
 *
 * This page used to carry a level, an XP bar, a career record across four games, a favourite game
 * and twelve achievements. Not one of those had a source: `buildPerson` invented the played counts
 * from a seeded RNG, the level was the square root of that invention, and every real account got
 * `level: 1, skill: 'new', reliability: 100` from `blank()` - numbers about a person that nobody
 * measured and nothing could measure, because no game has ever been played here.
 *
 * What is left is what the server actually knows: who you are, what you wrote about yourself,
 * whether a wallet is behind the account, and how many friends you have. It is a smaller page and
 * a true one, and everything that was removed comes back the day something produces it.
 */
export default component MePage()
{
    const locale = useLocale();
    const account = useAccount();
    const social = useSocial();
    const toasts = useToasts();

    useHead({ title: () => locale.t('app.nav.me') });

    derived user = account.user();

    derived bio = user === null ? '' : user.bio;

    const share = async (): Promise<void> =>
    {
        const link = `${ window.location.origin }/app/people/${ user?.handle ?? '' }`;
        try
        {
            await navigator.clipboard.writeText(link);
            toasts.show({ kind: 'success', text: locale.t('me.shared') });
        }
        catch
        {
            toasts.show({ kind: 'info', text: link });
        }
    };

    <Page label={ locale.t('app.nav.me') }>
        <Show
            when={ user !== null }
            fallback={ <EmptyState icon="me" title={ locale.t('person.notFound') } action={ locale.t('app.nav.home') } to="/app" class="py-12" /> }
        >
            { () =>
                <div class="flex flex-col gap-6">
                    <header class="flex flex-col items-center gap-3 pt-2 text-center">
                        <Avatar person={ user } size="2xl" presence="online" ring />
                        <div class="min-w-0">
                            <h1 class="title text-ui-3xl">{ locale.text(user!.displayName) }</h1>
                            <p class="mt-1 text-ui-base text-muted">@{ user!.handle }</p>
                        </div>

                        <Show when={ bio !== '' }>
                            { () => <p class="max-w-prose text-ui-base text-muted" dir="auto">{ bio }</p> }
                        </Show>

                        <Show when={ account.isWallet() }>
                            { () =>
                                <Chip icon="key" tone="live">
                                    <span class="tally">{ shortAddress(account.address() ?? '') }</span>
                                </Chip>
                            }
                        </Show>
                    </header>

                    <Show when={ !account.isWallet() }>
                        { () =>
                            <section class="rounded-panel border border-accent/40 bg-accent/5 p-4">
                                <h2 class="flex items-center gap-2 title text-ui-lg text-text">
                                    <Icon name="key" size={ 18 } class="text-accent" />
                                    { locale.t('me.keepSeat.title') }
                                </h2>
                                <p class="mt-1 text-ui-base text-muted">{ locale.t('me.keepSeat.lead') }</p>
                                <Button variant="primary" block class="mt-4" leading="key" to="/app/me/settings">{ locale.t('me.keepSeat.action') }</Button>
                            </section>
                        }
                    </Show>

                    <div class="flex flex-wrap items-center justify-center gap-2">
                        <Button variant="secondary" leading="settings" to="/app/me/settings">{ locale.t('me.settings') }</Button>
                        <Button variant="outline" leading="share" onClick={ () => void share() }>{ locale.t('me.share') }</Button>
                    </div>

                    <section>
                        <SectionHeading title={ locale.t('person.friends') } />
                        <p class="tally rounded-panel border border-line bg-field p-4 text-ui-md text-text">
                            { locale.plural('friends.count', social.friends().length) }
                        </p>
                    </section>

                    <Show when={ account.isWallet() }>
                        { () =>
                            <section>
                                <SectionHeading title={ locale.t('wallet.address') } />
                                <div class="flex items-center gap-3 rounded-panel border border-line bg-field p-4">
                                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-live/15 text-live">
                                        <Icon name="key" size={ 18 } />
                                    </span>
                                    <span class="flex min-w-0 flex-1 flex-col">
                                        <code class="tally truncate text-ui-base text-text">{ account.address() }</code>
                                        <span class="text-ui-xs text-muted">{ locale.t('wallet.chainReady', { chain: NURA_CHAIN.name }) }</span>
                                    </span>
                                </div>
                            </section>
                        }
                    </Show>
                </div>
            }
        </Show>
    </Page>
}
