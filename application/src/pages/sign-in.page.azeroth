import { useHead, useNavigate, useQuery } from 'azerothjs';

import WalletPanel from '../components/app/wallet-panel.component.azeroth';
import SiteFooter from '../components/layout/site-footer.component.azeroth';
import SiteHeader from '../components/layout/site-header.component.azeroth';
import Avatar from '../components/ui/avatar.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Divider from '../components/ui/divider.component.azeroth';
import Field from '../components/ui/field.component.azeroth';
import Input from '../components/ui/input.component.azeroth';
import Icon from '../icons/icon.component.azeroth';
import '../locales/app-catalogue.ts';
import { safeNext } from '../lib/guards.ts';
import { useAccount } from '../stores/account.store.ts';
import { useLocale } from '../stores/locale.store.ts';
import { useWallet } from '../stores/wallet.store.ts';

export default component SignInPage()
{
    const locale = useLocale();
    const account = useAccount();
    const wallet = useWallet();
    const query = useQuery();
    const { navigate } = useNavigate();

    useHead({ title: () => `${ locale.t('wallet.title') } · ${ locale.t('app.title') }` });

    state name = '';
    state pending = '';
    state touched = false;
    state showDemo = false;

    mount
    {
        return wallet.start();
    }

    derived identities = account.demoIdentities();

    derived tooShort = name.trim().length < 3;

    const leave = (): void =>
    {
        navigate(safeNext(query().next), { replace: true });
    };

    const enter = async (key: string, sign: () => Promise<unknown>): Promise<void> =>
    {
        if (pending !== '')
        {
            return;
        }
        pending = key;
        await sign();
        leave();
    };

    const submit = (): void =>
    {
        touched = true;
        if (!tooShort)
        {
            void enter(name.trim(), () => account.signIn(name.trim()));
        }
    };

    <div class="relative min-h-dvh overflow-hidden bg-void text-text">
        <div class="pointer-events-none absolute -top-40 start-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-48 -end-24 h-[26rem] w-[26rem] rounded-full bg-live/10 blur-3xl" aria-hidden="true"></div>

        <SiteHeader cta={ false } />

        <main id="main" class="safe-b relative mx-auto flex w-full max-w-[40rem] flex-col px-5 pb-12 pt-24 sm:px-8 sm:pt-28">
            <h1 class="sr-only">{ locale.t('wallet.title') }</h1>

            <WalletPanel
                onConnected={ (established) =>
                {
                    account.adoptWallet(established);
                    leave();
                } }
            />

            <Divider label={ locale.t('wallet.demoTitle') } class="my-8" />

            <p class="-mt-4 mb-5 text-center text-ui-base text-muted">{ locale.t('wallet.demoLead') }</p>

            <Show
                when={ showDemo }
                fallback={
                    <Button variant="outline" size="lg" block leading="people" onClick={ () => showDemo = true }>
                        { locale.t('signIn.demo') }
                    </Button>
                }
            >
                { () =>
                    <div class="flex flex-col gap-6">
                        <ul class="grid gap-3" aria-label={ locale.t('signIn.demo') }>
                            <For each={ identities } key={ (person) => person.id } let={ person }>
                                <li>
                                    <button
                                        type="button"
                                        class={ [
                                            'group flex w-full cursor-pointer items-center gap-4 rounded-panel border border-line bg-field p-4 text-start',
                                            'transition duration-200 ease-[var(--ease-ui)] hover:border-accent/60 hover:bg-raised/60 active:scale-[0.99]',
                                            pending === person.handle ? 'border-accent' : ''
                                        ].filter(Boolean).join(' ') }
                                        disabled={ pending !== '' }
                                        onClick={ () => void enter(person.handle, () => account.signInAsDemo(person.handle)) }
                                    >
                                        <Avatar person={ person } size="lg" presence="online" />
                                        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                            <span class="truncate text-ui-lg font-semibold text-text">{ locale.text(person.name) }</span>
                                            <span class="text-ui-sm text-muted">@{ person.handle }</span>
                                            <span class="mt-1 line-clamp-2 text-ui-sm text-muted">{ locale.text(person.bio) }</span>
                                            <Show when={ person.minor }>
                                                { () =>
                                                    <span class="mt-2 inline-flex w-fit items-center gap-1.5 rounded-full bg-live/15 px-2.5 py-1 text-ui-xs font-semibold text-live">
                                                        <Icon name="shield" size={ 13 } />
                                                        { locale.t('signIn.minor') }
                                                    </span>
                                                }
                                            </Show>
                                        </span>
                                        <Icon name="forward" size={ 16 } class="icon-flip hidden shrink-0 text-accent transition-transform group-hover:translate-x-0.5 sm:block" />
                                    </button>
                                </li>
                            </For>
                        </ul>

                        <form
                            class="flex flex-col gap-4"
                            onSubmit={ (event) =>
                            {
                                event.preventDefault();
                                submit();
                            } }
                        >
                            <Field id="sign-in-name" label={ locale.t('signIn.handle') } hint={ locale.t('signIn.handleHint') } error={ touched && tooShort ? locale.t('signIn.handleShort') : null }>
                                <Input
                                    id="sign-in-name"
                                    value={ name }
                                    onInput={ (value) => name = value }
                                    leading="at"
                                    maxlength={ 24 }
                                    autocomplete="nickname"
                                    enterkeyhint="go"
                                    invalid={ touched && tooShort }
                                    describedBy={ touched && tooShort ? 'sign-in-name-error' : 'sign-in-name-hint' }
                                    onEnter={ submit }
                                />
                            </Field>
                            <Button variant="secondary" size="lg" block submit loading={ pending !== '' && pending === name.trim() } icon="forward">
                                { locale.t('signIn.continue', { name: name.trim() === '' ? locale.t('common.you') : name.trim() }) }
                            </Button>
                        </form>
                    </div>
                }
            </Show>
        </main>

        <SiteFooter />
    </div>
}
