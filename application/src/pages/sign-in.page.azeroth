import { useHead, useNavigate, useQuery, type MountNode } from 'azerothjs';

import { checkHandle, handleFromName } from '../../../server/src/domains/identity/handle.ts';

import '../icons/all.ts';
import WalletPanel from '../components/app/wallet-panel.component.azeroth';
import SiteFooter from '../components/layout/site-footer.component.azeroth';
import SiteHeader from '../components/layout/site-header.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Divider from '../components/ui/divider.component.azeroth';
import Field from '../components/ui/field.component.azeroth';
import Input from '../components/ui/input.component.azeroth';
import '../locales/app-catalogue.ts';
import { ApiError } from '../api.ts';
import { safeNext } from '../lib/guards.ts';
import { useAccount } from '../stores/account.store.ts';
import { useLocale } from '../stores/locale.store.ts';
import { useWallet } from '../stores/wallet.store.ts';

export default component SignInPage()
{
    const locale = useLocale();
    const account = useAccount();
    const wallet = useWallet();
    const query = useQuery();
    const { navigate } = useNavigate();

    useHead({ title: () => `${ locale.t('wallet.title') } · ${ locale.t('app.title') }` });

    state name = '';
    state pending = false;
    state touched = false;
    state refused: 'name' | 'unavailable' | null = null;

    mount
    {
        return wallet.start();
    }

    /**
     * Why this name cannot be used, decided by the SERVER's own rule.
     *
     * `checkHandle` and `handleFromName` are the identity domain's, imported the way
     * `lib/crypto.ts` imports the envelope - the alternative is a second opinion about what a
     * legal name is, and the two halves disagreeing is how a form that says yes meets a server
     * that says no. The length floor stays at three where the server's is two: stricter is always
     * accepted, and "three characters" is what the hint has promised all along.
     *
     * The interesting cases are the ones a length check cannot see. `...` is three characters and
     * folds to nothing; `admin` is well shaped and reserved. Both used to pass this form and be
     * refused by the server, which is exactly the round trip that had nothing to catch it.
     */
    derived refusal = ((): 'short' | 'shape' | 'reserved' | null =>
    {
        const wanted = handleFromName(name);
        if (wanted.length < 3)
        {
            return 'short';
        }
        const answer = checkHandle(wanted);
        if (answer === null)
        {
            return null;
        }
        return answer === 'reserved' ? 'reserved' : (answer === 'too-short' ? 'short' : 'shape');
    })();

    derived fieldError = ((): string | null =>
    {
        if (refused === 'name')
        {
            return locale.t('signIn.handleRefused');
        }
        if (!touched || refusal === null)
        {
            return null;
        }
        if (refusal === 'reserved')
        {
            return locale.t('signIn.handleReserved');
        }
        return locale.t(refusal === 'shape' ? 'signIn.handleShape' : 'signIn.handleShort');
    })();

    const leave = (): void =>
    {
        navigate(safeNext(query().next), { replace: true });
    };

    /**
     * The wallet chooser, on the page that IS the connect surface.
     *
     * `WalletPanel` connects to whichever provider EIP-6963 put first, which is the right default
     * and the wrong only option: somebody with both MetaMask and Trust Wallet installed had no way
     * to say which one, and somebody with neither was told to install MetaMask specifically. The
     * landing page has had the chooser all along and this page did not.
     *
     * Held in a plain `let` with a separate boolean, because a setter treats a bare function as an
     * updater - assigning a component into a signal CALLS it with the previous value.
     */
    let Chooser: ((props: { close: () => void; navigate: (to: string) => void }) => MountNode) | null = null;

    state chooserOpen = false;
    state chooserLoaded = false;

    const openChooser = (): void =>
    {
        chooserOpen = true;
        if (chooserLoaded)
        {
            return;
        }
        void import('../components/layout/connect-dialog.component.azeroth').then((module) =>
        {
            Chooser = module.default;
            chooserLoaded = true;
        });
    };

    /**
     * Signs in as a guest, and survives being told no.
     *
     * The version this replaces set `pending` and awaited with no `try`. `client.auth.guest`
     * throws on any non-2xx - a reserved name, a name that folds to nothing, a 429 from the rate
     * limiter - and on a throw the button stayed `loading` forever, the `pending` guard blocked
     * every retry, and `void submit()` left an unhandled rejection behind. Guest sign-in, which is
     * the actual onboarding for anybody without a wallet, was dead until the page was reloaded.
     */
    const submit = async (): Promise<void> =>
    {
        touched = true;
        refused = null;

        if (pending || refusal !== null)
        {
            return;
        }

        pending = true;
        try
        {
            const person = await account.signIn(name.trim());
            if (person === null)
            {
                refused = 'unavailable';
                return;
            }
            leave();
        }
        catch (error)
        {
            // 400 and 409 are both about the NAME, so they belong on the field rather than in the
            // banner: "try again" is the wrong instruction for a name the server will never take.
            refused = error instanceof ApiError && (error.status === 400 || error.status === 409)
                ? 'name'
                : 'unavailable';
        }
        finally
        {
            pending = false;
        }
    };

    <div class="relative min-h-dvh overflow-hidden bg-void text-text">
        <div class="pointer-events-none absolute -top-40 start-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-48 -end-24 h-[26rem] w-[26rem] rounded-full bg-live/10 blur-3xl" aria-hidden="true"></div>

        <SiteHeader cta={ false } />

        <main id="main" class="safe-b relative mx-auto flex w-full max-w-[40rem] flex-col px-5 pb-12 pt-24 sm:px-8 sm:pt-28">
            <h1 class="sr-only">{ locale.t('wallet.title') }</h1>

            <WalletPanel
                onConnected={ (established) =>
                {
                    account.adoptWallet(established);
                    leave();
                } }
            />

            <div class="mt-3 flex justify-center">
                <Button variant="ghost" size="sm" leading="wallet" onClick={ openChooser }>
                    { locale.t('wallet.other') }
                </Button>
            </div>

            <Show when={ chooserOpen && chooserLoaded }>
                { () => Chooser!({ close: () => chooserOpen = false, navigate: () => leave() }) }
            </Show>

            <Divider label={ locale.t('wallet.guestTitle') } class="my-8" />

            <p class="-mt-4 mb-5 text-center text-ui-base text-muted">{ locale.t('wallet.guestLead') }</p>

            <form
                class="flex flex-col gap-4"
                onSubmit={ (event) =>
                {
                    event.preventDefault();
                    void submit();
                } }
            >
                <Field id="sign-in-name" label={ locale.t('signIn.handle') } hint={ locale.t('signIn.handleHint') } error={ fieldError }>
                    <Input
                        id="sign-in-name"
                        value={ name }
                        onInput={ (value) => name = value }
                        leading="at"
                        maxlength={ 24 }
                        autocomplete="nickname"
                        enterkeyhint="go"
                        invalid={ fieldError !== null }
                        describedBy={ fieldError !== null ? 'sign-in-name-error' : 'sign-in-name-hint' }
                        onEnter={ () => void submit() }
                    />
                </Field>
                <Show when={ refused === 'unavailable' }>
                    <p class="text-ui-sm text-danger" role="alert">{ locale.t('signIn.failed') }</p>
                </Show>
                <Button variant="secondary" size="lg" block submit loading={ pending } icon="forward">
                    { locale.t('signIn.continue', { name: name.trim() === '' ? locale.t('common.you') : name.trim() }) }
                </Button>
            </form>
        </main>

        <SiteFooter />
    </div>
}
