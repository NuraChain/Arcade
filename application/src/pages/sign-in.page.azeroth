import { useHead, useNavigate, useQuery } from 'azerothjs';

import BrandMark from '../components/layout/brand-mark.component.azeroth';
import LanguageSwitch from '../components/layout/language-switch.component.azeroth';
import ThemeSwitch from '../components/layout/theme-switch.component.azeroth';
import Avatar from '../components/ui/avatar.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import Divider from '../components/ui/divider.component.azeroth';
import Field from '../components/ui/field.component.azeroth';
import Input from '../components/ui/input.component.azeroth';
import Icon from '../icons/icon.component.azeroth';
import '../locales/app-catalogue.ts';
import { safeNext } from '../lib/guards.ts';
import { useLocale } from '../stores/locale.store.ts';
import { useAccount } from '../stores/account.store.ts';

export default component SignInPage()
{
    const locale = useLocale();
    const account = useAccount();
    const query = useQuery();
    const { navigate } = useNavigate();

    useHead({ title: () => `${ locale.t('signIn.title') } · ${ locale.t('app.title') }` });

    state name = '';
    state pending = '';
    state touched = false;

    derived identities = account.demoIdentities();

    derived tooShort = name.trim().length < 3;

    const enter = async (handle: string): Promise<void> =>
    {
        if (pending !== '')
        {
            return;
        }
        pending = handle;
        await account.signIn(handle);
        navigate(safeNext(query().next), { replace: true });
    };

    const submit = (): void =>
    {
        touched = true;
        if (!tooShort)
        {
            void enter(name.trim());
        }
    };

    <div class="relative min-h-dvh overflow-hidden bg-void text-text">
        <div class="pointer-events-none absolute -top-40 start-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-lamp/15 blur-3xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-48 -end-24 h-[26rem] w-[26rem] rounded-full bg-live/10 blur-3xl" aria-hidden="true"></div>

        <header class="safe-t relative mx-auto flex w-full max-w-[64rem] items-center justify-between px-5 py-5 sm:px-8">
            <a href="/" class="flex items-center gap-2.5 rounded-full" aria-label={ locale.t('app.nav.landing') }>
                <span class="lit flex h-8 w-8 items-center justify-center rounded-full bg-lamp text-void">
                    <Icon name="games" size={ 16 } />
                </span>
                <BrandMark class="text-[18px] text-text" />
            </a>
            <div class="flex items-center gap-2">
                <ThemeSwitch />
                <LanguageSwitch />
            </div>
        </header>

        <main id="main" class="safe-b relative mx-auto flex w-full max-w-[64rem] flex-col px-5 pb-12 pt-6 sm:px-8 sm:pt-12">
            <h1 class="max-w-[16ch] text-[clamp(2.25rem,7vw,3.75rem)]">{ locale.t('signIn.title') }</h1>
            <p class="mt-3 max-w-[46ch] text-[15px] text-muted sm:text-[17px]">{ locale.t('signIn.lead') }</p>

            <ul class="mt-8 grid gap-3 sm:grid-cols-3" aria-label={ locale.t('signIn.demo') }>
                <For each={ identities } key={ (person) => person.id } let={ person }>
                    <li>
                        <button
                            type="button"
                            class={ [
                                'group flex w-full cursor-pointer items-center gap-4 rounded-panel border border-line bg-field p-4 text-start',
                                'transition duration-200 ease-[var(--ease-ui)] hover:border-lamp/60 hover:bg-raised/60 active:scale-[0.99]',
                                'sm:flex-col sm:items-start sm:gap-3 sm:p-5',
                                pending === person.handle ? 'border-lamp' : ''
                            ].filter(Boolean).join(' ') }
                            disabled={ pending !== '' }
                            onClick={ () => void enter(person.handle) }
                        >
                            <Avatar person={ person } size="lg" presence="online" />
                            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                <span class="truncate text-[17px] font-semibold text-text">{ locale.text(person.name) }</span>
                                <span class="text-[13px] text-muted">@{ person.handle }</span>
                                <span class="mt-1 line-clamp-2 text-[13px] text-muted">{ locale.text(person.bio) }</span>
                                <Show when={ person.minor }>
                                    { () =>
                                        <span class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-live/15 px-2.5 py-1 text-[12px] font-semibold text-live">
                                            <Icon name="shield" size={ 13 } />
                                            { locale.t('signIn.minor') }
                                        </span>
                                    }
                                </Show>
                            </span>
                            <span class="hidden text-lamp sm:mt-1 sm:inline-flex sm:items-center sm:gap-1 sm:text-[13px] sm:font-semibold">
                                { locale.t('signIn.continue', { name: locale.text(person.name).split(' ')[0] }) }
                                <Icon name="forward" size={ 14 } class="icon-flip transition-transform group-hover:translate-x-0.5" />
                            </span>
                        </button>
                    </li>
                </For>
            </ul>

            <Divider label={ locale.t('signIn.custom') } class="my-8" />

            <form
                class="flex max-w-[28rem] flex-col gap-4"
                onSubmit={ (event) =>
                {
                    event.preventDefault();
                    submit();
                } }
            >
                <Field id="sign-in-name" label={ locale.t('signIn.handle') } hint={ locale.t('signIn.handleHint') } error={ touched && tooShort ? locale.t('signIn.handleShort') : null }>
                    <Input
                        id="sign-in-name"
                        value={ name }
                        onInput={ (value) => name = value }
                        leading="at"
                        maxlength={ 24 }
                        autocomplete="nickname"
                        enterkeyhint="go"
                        invalid={ touched && tooShort }
                        describedBy={ touched && tooShort ? 'sign-in-name-error' : 'sign-in-name-hint' }
                        onEnter={ submit }
                    />
                </Field>
                <Button variant="primary" size="lg" submit loading={ pending !== '' && pending === name.trim() } icon="forward">
                    { locale.t('signIn.continue', { name: name.trim() === '' ? locale.t('common.you') : name.trim() }) }
                </Button>
            </form>
        </main>
    </div>
}
