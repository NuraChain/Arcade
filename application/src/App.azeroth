import { ErrorBoundary, RouterProvider, Routes, createMemoryHistory, createRouter, untrack } from 'azerothjs';
import type { LoaderHandoff, RouteTransitionContext } from 'azerothjs';

import { routeMeta } from './lib/route-meta.ts';
import ErrorPage from './pages/error.page.azeroth';
import NotFoundPage from './pages/not-found.page.azeroth';
import { routes } from './routes.ts';
import { useDevice } from './stores/device.store.ts';

function transitionFor(context: RouteTransitionContext): string | null
{
    const { from, to, navigation, delta } = context;
    if (from === null || to === null || from.matched[0] !== to.matched[0] || to.matched[0].path !== '/app')
    {
        return null;
    }
    if (untrack(() => useDevice().posture()) !== 'phone')
    {
        return null;
    }
    if (navigation === 'pop' || delta < 0)
    {
        return 'page-back';
    }
    const target = routeMeta(to);
    const source = routeMeta(from);
    return target.tab !== undefined && source.tab !== undefined && target.parent === undefined ? 'page-fade' : 'page-forward';
}

export default component App(props: { url?: string; handoff?: LoaderHandoff })
{
    const router = createRouter({
        routes,
        history: props.url !== undefined ? createMemoryHistory(props.url) : undefined,
        initialLoaderData: props.handoff,

        scroll: false
    });

    <RouterProvider router={ router }>
        <ErrorBoundary fallback={ (_error, reset) => <ErrorPage reset={ reset } /> }>
            <Routes fallback={ () => <NotFoundPage /> } transition={ transitionFor } transitionDuration={ 400 } />
        </ErrorBoundary>
    </RouterProvider>
}
