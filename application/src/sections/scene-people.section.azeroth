import { GAMES } from '../data/games.ts';
import { useLocale } from '../stores/locale.store.ts';

export default component ScenePeople()
{
    const locale = useLocale();

    const tables = GAMES.length;

    <section class="relative flex min-h-dvh items-center" aria-labelledby="people-title">
        <div class="mx-auto w-full max-w-[80rem] px-5 sm:px-8">
            <div class="flex max-w-[34rem] flex-col gap-5">
                <h2 id="people-title" class="text-display-xl text-text">{ locale.t('people.title') }</h2>
                <p class="max-w-[44ch] text-ui-lg text-muted">{ locale.t('people.lead') }</p>

                <dl class="mt-2 flex flex-col gap-3 border-s-2 border-line ps-5">
                    <div class="flex flex-wrap items-baseline gap-x-3">
                        <dt class="label text-ui-sm text-faint">{ locale.t('people.stat.open') }</dt>
                        <dd class="tally font-display text-ui-xl font-semibold text-accent">{ locale.n(tables) }</dd>
                    </div>
                    <div class="flex flex-wrap items-baseline gap-x-3">
                        <dt class="label text-ui-sm text-faint">{ locale.t('people.stat.seat') }</dt>
                        <dd class="text-ui-md text-text">{ locale.t('people.stat.seatValue') }</dd>
                    </div>
                </dl>
            </div>
        </div>
    </section>
}
