import LandingGameCard from '../components/games/landing-game-card.component.azeroth';
import { GAMES } from '../data/games.ts';
import Icon from '../icons/icon.component.azeroth';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneGames(props: { returning: boolean })
{
    const locale = useLocale();

    <section id="games" data-beat="games" class="scene pt-15" aria-labelledby="games-title">
        <div class="scene-copy copy-plate pb-16">
            <div class="scene-column">
                <div class="reveal flex flex-col gap-2">
                    <h2 id="games-title" class="title text-ui-3xl text-text @lg:text-ui-4xl">{ locale.t('landing.games.title') }</h2>
                    <p class="text-ui-md text-muted">{ locale.t('landing.games.lead') }</p>
                </div>
                <ul class="mt-6 grid grid-cols-2 gap-3">
                    <For each={ GAMES } key={ (game) => game.id } let={ game }>
                        <li class="reveal flex min-w-0">
                            <LandingGameCard game={ game } returning={ props.returning } />
                        </li>
                    </For>
                </ul>
                <p class="reveal mt-5 flex items-start gap-3 text-ui-sm text-muted">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control bg-accent/12 text-accent">
                        <Icon name="idea" size={ 18 } />
                    </span>
                    <span class="pt-2">{ locale.t('landing.games.helpers') }</span>
                </p>
            </div>
        </div>
    </section>
}
