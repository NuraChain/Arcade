import GameRow from '../components/ui/game-row.component.azeroth';
import { GAMES } from '../data/games.ts';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneGames()
{
    const locale = useLocale();

    <section id="games" class="relative flex min-h-dvh items-center pb-16 pt-28" aria-labelledby="games-title">
        <div class="mx-auto w-full max-w-[80rem] px-5 sm:px-8">
            <div class="flex flex-col gap-3">
                <h2 id="games-title" class="max-w-[16ch] text-[clamp(2rem,6vw,3.5rem)] text-text">{ locale.t('games.title') }</h2>
                <p class="max-w-[48ch] text-[16px] text-muted">{ locale.t('games.lead') }</p>
            </div>

            
            <ul class="mt-10 border-b border-line lg:max-w-[54rem]">
                <For each={ GAMES } key={ (game) => game.id } let={ game }>
                    <li>
                        <GameRow game={ game } />
                    </li>
                </For>
            </ul>
        </div>
    </section>
}
