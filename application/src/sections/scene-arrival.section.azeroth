import PlayCta from '../components/layout/play-cta.component.azeroth';
import Button from '../components/ui/button.component.azeroth';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneArrival(props: { returning: boolean })
{
    const locale = useLocale();

    <section data-beat="arrival" class="scene pt-15" aria-labelledby="arrival-title">
        <div class="scene-copy copy-plate pb-[max(2.5rem,env(safe-area-inset-bottom))]">
            <div class="scene-column flex flex-col items-start gap-4">
                <p class="label text-ui-sm text-accent">{ locale.t('landing.arrival.eyebrow') }</p>
                <h1 id="arrival-title" class="title text-display-lg text-text sideways:text-ui-3xl">
                    <span class="block">{ locale.t('landing.arrival.lead') }</span>
                    <span class="block text-accent">{ locale.t('landing.arrival.accent') }</span>
                </h1>
                <p class="max-w-[46ch] text-ui-md text-muted">{ locale.t('landing.arrival.body') }</p>
                <div class="mt-2 flex w-full flex-col gap-3 @sm:w-auto @sm:flex-row">
                    <PlayCta returning={ props.returning } />
                    <Button href="#games" variant="ghost" size="lg" icon="chevron-down">{ locale.t('landing.cta.games') }</Button>
                </div>
            </div>
        </div>
    </section>
}
