import Button from '../components/ui/button.component.azeroth';
import { useConnect } from '../stores/connect.store.ts';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneFinale()
{
    const locale = useLocale();
    const connect = useConnect();

    <section id="join" class="relative flex min-h-dvh items-center justify-center py-24 text-center" aria-labelledby="finale-title">
        <div class="mx-auto flex w-full max-w-[46rem] flex-col items-center gap-5 px-5 sm:px-8">
            <h2 id="finale-title" class="text-display-xl text-text">{ locale.t('finale.title') }</h2>
            <p class="max-w-[42ch] text-ui-lg text-muted">{ locale.t('finale.lead') }</p>
            <Button variant="primary" size="lg" leading="wallet" onClick={ () => connect.show() }>{ locale.t('finale.cta') }</Button>
        </div>
    </section>
}
