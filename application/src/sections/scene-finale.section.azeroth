import PlayCta from '../components/layout/play-cta.component.azeroth';
import { useLocale } from '../stores/locale.store.ts';

export default component SceneFinale(props: { returning: boolean })
{
    const locale = useLocale();

    <section data-beat="finale" class="scene pt-15" aria-labelledby="finale-title">
        <div class="scene-copy copy-plate pb-[max(3rem,env(safe-area-inset-bottom))]">
            <div class="scene-column reveal flex flex-col items-start gap-4">
                <h2 id="finale-title" class="title text-ui-3xl text-text @lg:text-ui-4xl">{ locale.t('landing.finale.title') }</h2>
                <p class="max-w-[46ch] text-ui-md text-muted">{ locale.t('landing.finale.lead') }</p>
                <div class="mt-2 flex w-full flex-col gap-3 @sm:w-auto @sm:flex-row">
                    <PlayCta returning={ props.returning } guest />
                </div>
            </div>
        </div>
    </section>
}
