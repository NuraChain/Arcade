import Icon from '../icons/icon.component.azeroth';
import type { IconName } from '../icons/registry.ts';
import type { MessageKey } from '../locales/en.ts';
import { useLocale } from '../stores/locale.store.ts';

export interface SceneRow
{
    icon: IconName;

    title: MessageKey;

    body: MessageKey;
}

export default component SceneRows(props: { beat: string; title: MessageKey; lead: MessageKey; rows: SceneRow[] })
{
    const locale = useLocale();

    <section data-beat={ props.beat } class="scene pt-15" aria-labelledby={ `${ props.beat }-title` }>
        <div class="scene-copy copy-plate pb-16">
            <div class="scene-column">
                <div class="reveal flex flex-col gap-2">
                    <h2 id={ `${ props.beat }-title` } class="title text-ui-3xl text-text @lg:text-ui-4xl">{ locale.t(props.title) }</h2>
                    <p class="text-ui-md text-muted">{ locale.t(props.lead) }</p>
                </div>
                <ul class="reveal mt-6 divide-y divide-line rounded-panel border border-line bg-field">
                    <For each={ props.rows } key={ (row) => row.title } let={ row }>
                        <li class="flex items-start gap-3 p-4">
                            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-control bg-accent/12 text-accent">
                                <Icon name={ row.icon } size={ 18 } />
                            </span>
                            <div class="flex min-w-0 flex-col gap-0.5">
                                <h3 class="label text-ui-md text-text">{ locale.t(row.title) }</h3>
                                <p class="text-ui-sm text-muted">{ locale.t(row.body) }</p>
                            </div>
                        </li>
                    </For>
                </ul>
            </div>
        </div>
    </section>
}
