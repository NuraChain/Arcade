import { NURA_CHAIN, chainIsConfigured } from '../../data/chain.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useWallet } from '../../stores/wallet.store.ts';
import Button from '../ui/button.component.azeroth';
import Spinner from '../ui/spinner.component.azeroth';

export default component WalletPanel(props: { onConnected: (address: string) => void })
{
    const locale = useLocale();
    const wallet = useWallet();

    derived status = wallet.status();

    derived name = wallet.name();

    derived busy = status === 'connecting' || status === 'signing';

    derived failure = wallet.failure();

    derived errorKey = ((): MessageKey | null =>
    {
        if (failure === null)
        {
            return null;
        }
        if (failure === 'rejected')
        {
            return 'wallet.error.rejected';
        }
        if (failure === 'pending')
        {
            return 'wallet.error.pending';
        }
        if (failure === 'chain')
        {
            return 'wallet.error.chain';
        }
        return failure === 'no-wallet' ? 'wallet.error.noWallet' : 'wallet.error.unknown';
    })();

    derived assurances = [
        { id: 'free', icon: 'key' as const, label: locale.t('wallet.free') },
        { id: 'gas', icon: 'coins' as const, label: locale.t('wallet.noGas') },
        { id: 'keys', icon: 'shield' as const, label: locale.t('wallet.selfCustody') }
    ];

    const connect = async (): Promise<void> =>
    {
        const address = await wallet.connect();
        if (address !== null)
        {
            props.onConnected(address);
        }
    };

    <section class="relative overflow-hidden rounded-panel border border-lamp/30 bg-field p-5 sm:p-6" aria-labelledby="wallet-heading">
        <span class="pointer-events-none absolute -end-16 -top-20 h-48 w-48 rounded-full bg-lamp/15 blur-3xl" aria-hidden="true"></span>

        <div class="relative flex flex-wrap items-center gap-2">
            <span class="flex items-center gap-1.5 rounded-full bg-live/15 px-2.5 py-1 text-[12px] font-semibold text-live">
                <span class="live-dot h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
                { NURA_CHAIN.name }
            </span>
            <a
                href={ NURA_CHAIN.site }
                target="_blank"
                rel="noreferrer noopener"
                class="flex items-center gap-1 rounded-full px-2 py-1 text-[12px] font-semibold text-muted hover:text-lamp"
            >
                { locale.t('wallet.learn', { chain: NURA_CHAIN.name }) }
                <Icon name="forward" size={ 12 } class="icon-flip" />
            </a>
        </div>

        <h2 id="wallet-heading" class="relative mt-3 text-[clamp(1.75rem,5vw,2.5rem)] leading-tight">{ locale.t('wallet.title') }</h2>
        <p class="relative mt-2 max-w-[48ch] text-[15px] text-muted">{ locale.t('wallet.lead', { chain: NURA_CHAIN.name }) }</p>

        <Show when={ status === 'signing' }>
            { () =>
                <p class="relative mt-4 flex items-start gap-2 rounded-tile bg-lamp/10 p-3 text-[13px] text-text">
                    <Icon name="edit" size={ 16 } class="mt-0.5 shrink-0 text-lamp" />
                    <span>
                        <span class="block font-semibold">{ locale.t('wallet.signing', { wallet: name }) }</span>
                        { locale.t('wallet.signingLead') }
                    </span>
                </p>
            }
        </Show>

        <Show when={ errorKey !== null }>
            { () =>
                <p class="relative mt-4 flex items-start gap-2 rounded-tile bg-madder/10 p-3 text-[13px] text-madder" role="alert">
                    <Icon name="alert" size={ 16 } class="mt-0.5 shrink-0" />
                    { locale.t(errorKey!, { chain: NURA_CHAIN.name }) }
                </p>
            }
        </Show>

        <div class="relative mt-5 flex flex-col gap-3">
            <Show
                when={ wallet.available() }
                fallback={
                    <>
                        <p class="text-[14px] text-muted">{ locale.t('wallet.installLead') }</p>
                        <Button variant="primary" size="lg" block href="https://metamask.io/download/" icon="forward">
                            { locale.t('wallet.install') }
                        </Button>
                    </>
                }
            >
                { () =>
                    <Button variant="primary" size="lg" block loading={ busy } leading="key" onClick={ () => void connect() }>
                        { busy ? locale.t('wallet.connecting', { wallet: name }) : locale.t(failure === null ? 'wallet.connect' : 'wallet.retry', { wallet: name }) }
                    </Button>
                }
            </Show>

            <p class="flex items-center gap-1.5 text-[12px] text-faint">
                <Icon name="info" size={ 13 } />
                { chainIsConfigured() ? locale.t('wallet.chainSwitch', { chain: NURA_CHAIN.name }) : locale.t('wallet.chainUnset') }
            </p>

            <ul class="flex flex-wrap gap-x-4 gap-y-1.5" aria-label={ locale.t('wallet.title') }>
                <For each={ assurances } key={ (item) => item.id } let={ item }>
                    <li class="flex items-center gap-1.5 text-[12px] font-semibold text-muted">
                        <Icon name={ item.icon } size={ 13 } class="text-live" />
                        { item.label }
                    </li>
                </For>
            </ul>
        </div>

        <Show when={ busy }>
            { () =>
                <span class="absolute end-5 top-5" aria-hidden="true">
                    <Spinner size={ 20 } class="text-lamp" />
                </span>
            }
        </Show>
    </section>
}
