import { Link, useNavigate } from 'azerothjs';

import { personById } from '../../data/mock/index.ts';
import type { Person } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import SectionHeading from '../ui/section-heading.component.azeroth';

export default component SocialPanel()
{
    const locale = useLocale();
    const presence = usePresence();
    const catalogue = useCatalogue();
    const social = useSocial();
    const lobby = useLobby();
    const { navigate } = useNavigate();

    const playWith = (person: Person): void =>
    {
        const game = person.favourite;
        navigate(`/app/play/${ lobby.host(game, catalogue.defaults(game), [person.id]) }`);
    };

    const peopleOf = (ids: readonly string[]): Person[] => ids
        .map((id) => personById(id))
        .filter((person): person is Person => person !== undefined);

    derived friends = peopleOf(presence.online(social.friends()));

    derived suggestions = friends.length > 0 ? [] : social.suggestions().slice(0, 4);

    derived totals = catalogue.totals();

    <aside class="bar safe-t safe-b flex h-dvh w-[var(--social-w)] flex-col gap-5 overflow-y-auto border-s border-line bg-field px-3 py-4" aria-label={ locale.t('app.nav.friends') }>
        <section>
            <SectionHeading title={ locale.plural('common.friendsOnline', friends.length) } more={ locale.t('common.seeAll') } to="/app/friends" />
            <Show
                when={ friends.length > 0 }
                fallback={
                    <div class="rounded-panel border border-dashed border-line p-3">
                        <p class="text-ui-sm text-muted">{ locale.t('home.friends.empty') }</p>
                        <Show when={ suggestions.length > 0 }>
                            { () =>
                                <ul class="mt-3 flex flex-col gap-1">
                                    <For each={ suggestions } key={ (person) => person.id } let={ person }>
                                        <li>
                                            <Link to={ `/app/people/${ person.handle }` } class="flex items-center gap-2.5 rounded-tile p-1 transition-colors hover:bg-raised">
                                                <Avatar person={ person } size="sm" presence={ presence.of(person.id).state } />
                                                <span class="min-w-0 flex-1 truncate text-ui-sm font-semibold text-text">{ locale.text(person.name) }</span>
                                                <Icon name="friend-add" size={ 14 } class="shrink-0 text-accent" />
                                            </Link>
                                        </li>
                                    </For>
                                </ul>
                            }
                        </Show>
                    </div>
                }
            >
                { () =>
                    <ul class="flex flex-col gap-0.5">
                        <For each={ friends } key={ (person) => person.id } let={ person }>
                            <li class="flex items-center gap-2.5 rounded-tile p-1 transition-colors hover:bg-raised">
                                <Avatar person={ person } size="sm" presence={ presence.of(person.id).state } />
                                <span class="flex min-w-0 flex-1 flex-col">
                                    <span class="truncate text-ui-sm font-semibold text-text">{ locale.text(person.name) }</span>
                                    <span class="truncate text-ui-2xs text-muted">
                                        { presence.of(person.id).state === 'playing' && presence.of(person.id).game !== null
                                            ? locale.t('common.playing', { game: locale.t(catalogue.byId(presence.of(person.id).game!).nameKey) })
                                            : locale.t('common.online') }
                                    </span>
                                </span>
                                <Button variant="secondary" size="sm" class="shrink-0 whitespace-nowrap" onClick={ () => playWith(person) }>{ locale.t('person.play') }</Button>
                            </li>
                        </For>
                    </ul>
                }
            </Show>
        </section>

        <section class="rounded-panel border border-line bg-sunk p-3">
            <p class="label text-ui-2xs text-faint">{ locale.t('people.stat.open') }</p>
            <p class="tally title mt-0.5 text-ui-3xl text-text">{ locale.n(totals.tablesOpen) }</p>
            <p class="mt-1 flex items-center gap-1.5 text-ui-xs text-muted">
                <span class="live-dot h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
                <span class="tally">{ locale.n(totals.playersOnline) }</span> { locale.t('common.online').toLowerCase() }
            </p>
        </section>
    </aside>
}
