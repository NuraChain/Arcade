import { Link, useNavigate } from 'azerothjs';

import type { Notification } from '../../api.ts';
import type { Person } from '../../data/person.ts';
import Icon from '../../icons/icon.component.azeroth';
import { sayOf, targetOf } from '../../lib/notifications.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import NotificationLead from '../social/notification-lead.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import SectionHeading from '../ui/section-heading.component.azeroth';

export default component SocialPanel()
{
    const locale = useLocale();
    const presence = usePresence();
    const social = useSocial();
    const people = usePeople();
    const notifications = useNotifications();
    const { navigate } = useNavigate();

    derived friends = presence.online(social.friends())
        .map((id) => people.byHandle(id))
        .filter((person): person is Person => person !== null);

    derived recent = notifications.items().slice(0, 5);

    const personOf = (item: Notification): Person | null => item.actor === undefined ? null : people.byHandle(item.actor);

    const whoOf = (item: Notification): string =>
    {
        const person = personOf(item);
        return person === null ? (item.actor ?? '') : person.displayName.split(' ')[0];
    };

    const open = (item: Notification): void =>
    {
        void notifications.markRead(item.id);
        const target = targetOf(item);
        if (target !== null)
        {
            navigate(target);
        }
    };

    <aside class="flex min-h-0 w-[var(--social-w)] shrink-0 flex-col gap-7 overflow-y-auto border-s border-line bg-void px-4 py-5" aria-label={ locale.t('shell.panel') }>
        <section aria-labelledby="panel-activity">
            <SectionHeading id="panel-activity" title={ locale.t('shell.activity') } more={ locale.t('common.seeAll') } to="/app/notifications" class="mb-1" />
            <Show
                when={ recent.length > 0 }
                fallback={ <p class="py-2 text-ui-sm text-muted">{ locale.t('shell.activity.empty') }</p> }
            >
                { () =>
                    <ul class="flex flex-col">
                        <For each={ recent } key={ (item) => item.id } let={ item }>
                            <li class="border-b border-line last:border-b-0">
                                <button type="button" class="group flex min-h-14 w-full cursor-pointer items-center gap-3 py-2.5 text-start" onClick={ () => open(item) }>
                                    <NotificationLead item={ item } person={ personOf(item) } />
                                    <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                        <span class={ () => [ 'line-clamp-2 text-ui-sm', item.read ? 'text-muted' : 'text-text' ].join(' ') }>{ sayOf(item, whoOf(item), locale) }</span>
                                        <span class="tally text-ui-xs text-faint">{ locale.relative(Date.parse(item.at)) }</span>
                                    </span>
                                    <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint transition-colors group-hover:text-muted" />
                                </button>
                            </li>
                        </For>
                    </ul>
                }
            </Show>
        </section>

        <section aria-labelledby="panel-friends">
            <SectionHeading id="panel-friends" title={ locale.t('home.friends.title') } more={ locale.t('common.seeAll') } to="/app/friends" class="mb-1" />
            <Show
                when={ friends.length > 0 }
                fallback={ <p class="py-2 text-ui-sm text-muted">{ locale.t('shell.friends.empty') }</p> }
            >
                { () =>
                    <ul class="flex flex-col">
                        <For each={ friends } key={ (person) => person.id } let={ person }>
                            <li class="border-b border-line last:border-b-0">
                                <Link to={ `/app/people/${ person.handle }` } class="group flex min-h-14 items-center gap-3 py-2.5">
                                    <Avatar person={ person } size="md" presence={ presence.dot(person.id) } ringOn="void" />
                                    <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                        <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ person.displayName }</span>
                                        <span class="truncate text-ui-xs text-muted">{ presence.dot(person.id) === 'away' ? locale.t('common.away') : locale.t('common.online') }</span>
                                    </span>
                                    <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint transition-colors group-hover:text-muted" />
                                </Link>
                            </li>
                        </For>
                    </ul>
                }
            </Show>
        </section>
    </aside>
}
