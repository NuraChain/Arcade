import { Link, useMatch, useNavigate } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { routeMeta } from '../../lib/route-meta.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import BrandMark from '../layout/brand-mark.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';

export default component TopBar()
{
    const locale = useLocale();
    const device = useDevice();
    const account = useAccount();
    const shell = useShell();
    const notifications = useNotifications();
    const match = useMatch();
    const { navigate } = useNavigate();

    derived meta = routeMeta(match());

    derived title = shell.title() ?? (meta.title === undefined ? '' : locale.t(meta.title));

    derived phone = device.posture() === 'phone';

    derived unread = notifications.unread();

    mount
    {
        const onKey = (event: KeyboardEvent): void =>
        {
            if (event.key !== '/' || event.defaultPrevented || device.posture() === 'phone')
            {
                return;
            }
            const target = event.target;
            const editable = target instanceof HTMLElement
                && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName));
            if (editable || event.metaKey || event.ctrlKey || event.altKey)
            {
                return;
            }
            event.preventDefault();
            navigate('/app/search');
        };

        window.addEventListener('keydown', onKey);
        return () => window.removeEventListener('keydown', onKey);
    }

    <header class="z-topbar safe-t sticky top-0 border-b border-line bg-void/85 backdrop-blur-md">
        <div class="flex h-[var(--topbar-h)] w-full items-center gap-1.5 px-3 sm:gap-2 sm:px-6">
            <h1 class="sr-only">{ title }</h1>

            <Show
                when={ phone }
                fallback={
                    <div class="flex min-w-0 flex-1 justify-center">
                        <Link to="/app/search" class="flex h-10 w-full max-w-[30rem] items-center gap-2.5 rounded-full border border-line bg-sunk px-4 text-ui-sm text-faint transition-colors duration-150 hover:border-line-strong hover:text-muted coarse:h-11">
                            <Icon name="search" size={ 16 } class="shrink-0" />
                            <span class="truncate">{ locale.t('app.search.placeholder') }</span>
                        </Link>
                    </div>
                }
            >
                { () =>
                    <div class="flex min-w-0 flex-1 items-center">
                        <Link to="/app" class="flex h-11 min-w-0 items-center gap-2.5 rounded-full pe-2" aria-label={ locale.t('app.nav.home') }>
                            <span class="lit flex h-8 w-8 shrink-0 items-center justify-center rounded-control bg-accent-fill text-accent-ink">
                                <Icon name="games" size={ 17 } />
                            </span>
                            <BrandMark class="truncate text-ui-lg text-text" />
                        </Link>
                    </div>
                }
            </Show>

            <Show when={ phone }>
                { () => <IconButton icon="search" label={ locale.t('app.nav.search') } to="/app/search" /> }
            </Show>
            <IconButton icon="bell" label={ locale.t('app.nav.notifications') } to="/app/notifications" count={ unread } />
            <Link to="/app/me" class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full" aria-label={ locale.t('app.nav.profile') }>
                <Avatar person={ account.user() } size="sm" />
            </Link>
        </div>
    </header>
}
