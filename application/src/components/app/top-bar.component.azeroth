import { Link, useMatch, useNavigate } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { routeMeta } from '../../lib/route-meta.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import BrandMark from '../layout/brand-mark.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';

export default component TopBar()
{
    const locale = useLocale();
    const device = useDevice();
    const account = useAccount();
    const shell = useShell();
    const notifications = useNotifications();
    const match = useMatch();
    const { back, replace } = useNavigate();

    derived meta = routeMeta(match());

    derived title = shell.title() ?? (meta.title === undefined ? '' : locale.t(meta.title));

    derived phone = device.posture() === 'phone';

    derived showBack = phone && (meta.parent !== undefined || shell.depth() > 0);

    derived unread = notifications.unread();

    const goBack = (): void =>
    {
        if (shell.depth() > 0)
        {
            back();
            return;
        }
        replace(meta.parent ?? '/app');
    };

    <header class="glass z-topbar safe-t sticky top-0 border-b border-line">
        <div class="mx-auto flex h-[var(--topbar-h)] w-full max-w-[96rem] items-center gap-1 px-2 sm:px-6 lg:px-8">
            <Show
                when={ showBack }
                fallback={
                    <Show when={ phone }>
                        { () =>
                            <Link to="/app" class="flex h-11 items-center gap-2 rounded-full ps-2 pe-3" aria-label={ locale.t('app.nav.home') }>
                                <span class="lit flex h-7 w-7 items-center justify-center rounded-control bg-accent text-accent-ink">
                                    <Icon name="games" size={ 15 } />
                                </span>
                                <BrandMark class="text-ui-lg text-text" />
                            </Link>
                        }
                    </Show>
                }
            >
                { () => <IconButton icon="back" label={ locale.t('app.nav.back') } flip onClick={ goBack } /> }
            </Show>

            <h1 class={ [
                'label min-w-0 flex-1 truncate text-ui-lg font-semibold text-text',
                showBack ? 'text-start' : (phone ? 'sr-only' : 'text-start')
            ].join(' ') }>
                { title }
            </h1>

            <Show when={ !phone }>
                { () =>
                    <Link to="/app/search" class="me-1 flex h-9 w-60 items-center gap-2 rounded-control border border-line bg-sunk px-2.5 text-ui-sm text-faint transition-colors hover:border-line-strong hover:text-muted coarse:h-11">
                        <Icon name="search" size={ 16 } />
                        <span class="truncate">{ locale.t('app.nav.search') }</span>
                    </Link>
                }
            </Show>
            <Show when={ phone }>
                { () => <IconButton icon="search" label={ locale.t('app.nav.search') } to="/app/search" /> }
            </Show>
            <IconButton icon="bell" label={ locale.t('app.nav.notifications') } to="/app/notifications" count={ unread } />
            <Link to="/app/me" class="ms-1 flex h-11 w-11 items-center justify-center rounded-full" aria-label={ locale.t('app.nav.me') }>
                <Avatar person={ account.user() } size="sm" />
            </Link>
        </div>
    </header>
}
