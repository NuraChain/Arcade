import { untrack, useNavigate, useRoute } from 'azerothjs';

import { personById } from '../../data/mock/index.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';

export default component LobbyNotices()
{
    const lobby = useLobby();
    const toasts = useToasts();
    const locale = useLocale();
    const catalogue = useCatalogue();
    const route = useRoute();
    const { navigate } = useNavigate();

    let seen = untrack(() => lobby.notice()?.seq ?? 0);

    effect
    {
        const current = lobby.notice();
        if (current === null || current.seq === seen)
        {
            return;
        }
        seen = current.seq;
        untrack(() =>
        {
            const atTable = route().pathname.startsWith('/app/play/');
            const person = current.playerId === null ? undefined : personById(current.playerId);
            const name = person === undefined ? (current.playerId ?? '') : locale.text(person.name).split(' ')[0];
            const intent = lobby.state().intent;
            const game = intent === null ? '' : locale.t(catalogue.byId(intent.game).nameKey);
            const tableId = lobby.tableId();

            if (current.kind === 'found' && !atTable && tableId !== null)
            {
                toasts.show({
                    kind: 'live',
                    text: locale.t('play.notice.found', { game }),
                    action: { label: locale.t('play.notice.sit'), run: () => navigate(`/app/play/${ tableId }`) }
                });
            }
            else if (current.kind === 'joined' && !atTable)
            {
                toasts.show({ kind: 'live', text: locale.t('play.notice.joined', { name }) });
            }
            else if (current.kind === 'left')
            {
                toasts.show({ kind: 'info', text: locale.t('play.notice.left', { name }) });
            }
            else if (current.kind === 'declined')
            {
                toasts.show({ kind: 'warning', text: locale.t('play.notice.declined', { name }) });
            }
            else if (current.kind === 'invited')
            {
                toasts.show({ kind: 'success', text: locale.t('play.notice.invited', { name }) });
            }
        });
    }

    <span class="hidden" aria-hidden="true"></span>
}
