import { Link, useNavigate } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useSession } from '../../stores/session.store.ts';
import BrandMark from '../layout/brand-mark.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import { NAV, SECONDARY } from './nav-items.ts';

export default component Sidebar()
{
    const locale = useLocale();
    const session = useSession();
    const account = useAccount();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const { navigate } = useNavigate();

    derived user = account.user();

    const quickPlay = (): void =>
    {
        navigate(`/app/play/${ lobby.quick(user?.favourite ?? catalogue.featured()) }`);
    };

    <nav class="safe-t safe-b flex h-dvh w-[var(--sidebar-w)] flex-col border-e border-line/60 bg-field px-3 py-4" aria-label={ locale.t('app.nav.primary') }>
        <Link to="/app" class="mb-5 flex items-center gap-2.5 rounded-full px-2 py-1" aria-label={ locale.t('app.nav.home') }>
            <span class="lit flex h-8 w-8 items-center justify-center rounded-full bg-lamp text-void">
                <Icon name="games" size={ 16 } />
            </span>
            <BrandMark class="text-[18px] text-text" />
        </Link>

        <Button variant="primary" size="md" block leading="zap" onClick={ quickPlay }>{ locale.t('app.nav.quickPlay') }</Button>

        <ul class="mt-5 flex flex-col gap-0.5">
            <For each={ NAV } key={ (item) => item.tab } let={ item }>
                <li>
                    <Link to={ item.to } end={ item.end } activeClass="is-active" prefetch="hover" class="nav-item nav-row flex h-11 items-center gap-3 rounded-tile px-3 text-[15px] font-semibold text-muted transition-colors duration-150 hover:bg-raised/70 hover:text-text">
                        <Icon name={ item.icon } size={ 20 } />
                        <span>{ locale.t(item.labelKey) }</span>
                    </Link>
                </li>
            </For>
            <li class="my-2 h-px bg-line/70" aria-hidden="true"></li>
            <For each={ SECONDARY } key={ (item) => item.tab } let={ item }>
                <li>
                    <Link to={ item.to } activeClass="is-active" class="nav-item nav-row flex h-11 items-center gap-3 rounded-tile px-3 text-[15px] font-semibold text-muted transition-colors duration-150 hover:bg-raised/70 hover:text-text">
                        <Icon name={ item.icon } size={ 20 } />
                        <span>{ locale.t(item.labelKey) }</span>
                    </Link>
                </li>
            </For>
        </ul>

        <div class="mt-auto rounded-panel border border-line bg-void/40 p-2">
            <Link to="/app/me" class="flex items-center gap-3 rounded-tile p-1.5 transition-colors hover:bg-raised/70">
                <Avatar person={ user } size="md" presence="online" />
                <span class="flex min-w-0 flex-1 flex-col">
                    <span class="truncate text-[14px] font-semibold text-text">{ user === null ? '' : locale.text(user.name) }</span>
                    <span class="flex items-center gap-1.5 text-[12px] text-live">
                        <span class="live-dot h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
                        { locale.t('common.online') }
                    </span>
                </span>
            </Link>
            <button
                type="button"
                class="mt-1 flex h-10 w-full cursor-pointer items-center gap-3 rounded-tile px-3 text-[13px] font-semibold text-muted transition-colors hover:bg-raised/70 hover:text-text"
                onClick={ () =>
                {
                    session.signOut();
                    navigate('/sign-in', { replace: true });
                } }
            >
                <Icon name="sign-out" size={ 16 } class="icon-flip" />
                { locale.t('app.nav.signOut') }
            </button>
        </div>
    </nav>
}
