import BrandLogo from '../layout/brand-logo.component.azeroth';
import { Link } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { useAccount } from '../../stores/account.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useRealtime } from '../../stores/realtime.store.ts';
import BrandMark from '../layout/brand-mark.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import { RAIL } from './nav-items.ts';

export default component Sidebar()
{
    const locale = useLocale();
    const account = useAccount();
    const chat = useChat();
    const live = useRealtime();

    derived user = account.user();

    derived unread = chat.totalUnread();

    derived dot = user !== null && live.status() === 'connected' ? 'online' as const : null;

    derived status = dot === 'online' ? locale.t('common.online') : (user === null ? '' : `@${ user.handle }`);

    <nav class="safe-t safe-b flex h-dvh w-[var(--sidebar-w)] flex-col border-e border-line bg-void" aria-label={ locale.t('app.nav.primary') }>
        <Link to="/app" class="flex h-[var(--topbar-h)] shrink-0 items-center gap-3 px-5" aria-label={ locale.t('app.nav.home') }>
            <BrandLogo size="lg" />
            <BrandMark class="truncate text-ui-lg text-text" />
        </Link>

        <ul class="bar flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto px-3 pt-3">
            <For each={ RAIL } key={ (item) => item.to } let={ item }>
                <li>
                    <Link to={ item.to } end={ item.end } activeClass="is-active" prefetch="hover" class="nav-item nav-row flex h-11 items-center gap-3 rounded-tile px-3 text-ui-md font-semibold text-muted transition-colors duration-150 hover:bg-raised hover:text-text">
                        <Icon name={ item.icon } size={ 20 } />
                        <span class="min-w-0 flex-1 truncate">{ locale.t(item.labelKey) }</span>
                        <Show when={ item.tab === 'chats' && unread > 0 }>
                            { () => <Badge count={ unread } tone="accent" label={ locale.plural('common.unread', unread) } /> }
                        </Show>
                    </Link>
                </li>
            </For>
        </ul>

        <Show when={ user !== null }>
            { () =>
                <Link to="/app/me" class="m-3 flex min-h-14 shrink-0 items-center gap-3 rounded-tile border border-line bg-field px-3 py-2 transition-colors hover:border-line-strong hover:bg-raised">
                    <Avatar person={ user } size="md" presence={ dot } />
                    <span class="flex min-w-0 flex-1 flex-col">
                        <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ user?.displayName ?? '' }</span>
                        <span class={ () => [ 'flex min-w-0 items-center gap-1.5 text-ui-xs', dot === 'online' ? 'text-live' : 'text-muted' ].join(' ') }>
                            <Show when={ dot === 'online' }>
                                <span class="live-dot h-1.5 w-1.5" aria-hidden="true"></span>
                            </Show>
                            <span class="truncate">{ status }</span>
                        </span>
                    </span>
                    <Icon name="chevron-right" size={ 16 } class="icon-flip shrink-0 text-faint" />
                </Link>
            }
        </Show>
    </nav>
}
