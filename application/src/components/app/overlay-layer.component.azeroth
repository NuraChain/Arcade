import { Dynamic, untrack } from 'azerothjs';

import { firstTabbable, focusQuietly } from '../../lib/focus.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { settleIndex } from '../../lib/snap.ts';
import { createDrag } from '../../lib/swipe.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay, type OverlayEntry } from '../../stores/overlay.store.ts';

const HALF = 0.46;

export default component OverlayLayer(props: { entry: OverlayEntry })
{
    const overlay = useOverlay();
    const device = useDevice();
    const locale = useLocale();

    const kind = untrack(() => (props.entry.kind === 'auto' ? (device.posture() === 'phone' ? 'sheet' : 'modal') : props.entry.kind));

    const drag = createDrag({ threshold: 96, velocity: 0.6 });

    state detent = 0;

    let panel: HTMLElement | null = null;
    let body: HTMLElement | null = null;
    let returnTo: HTMLElement | null = null;
    let points: number[] = [];

    derived phaseClass = props.entry.phase === 'opening'
        ? `${ kind }-enter-from`
        : (props.entry.phase === 'closing' ? `${ kind }-leave-to` : '');

    const stops = (height: number): number[] =>
        (height >= device.height() * 0.6 ? [0, Math.round(height * HALF), height] : [0, height]);

    const paint = (offset: number | null): void =>
    {
        if (panel === null)
        {
            return;
        }
        panel.style.transition = offset === null ? '' : 'none';
        panel.style.transform = offset === null ? '' : `translateY(${ offset }px)`;
    };

    const settleAt = (index: number): void =>
    {
        paint(null);
        if (index === points.length - 1)
        {
            props.entry.props.close();
            return;
        }
        haptic('tick');
        detent = points[index];
    };

    mount
    {
        returnTo = document.activeElement instanceof HTMLElement ? document.activeElement : null;
        requestAnimationFrame(() => overlay.opened(props.entry.id));
        if (panel !== null)
        {
            focusQuietly(firstTabbable(body ?? panel) ?? panel);
        }
        return () =>
        {
            if (returnTo !== null && returnTo.isConnected)
            {
                focusQuietly(returnTo);
            }
        };
    }

    <div class="overlay-layer" data-overlay-layer={ props.entry.id } data-kind={ kind }>
        <div
            class="overlay-scrim"
            onClick={ () => (props.entry.dismissible ? props.entry.props.close() : undefined) }
        ></div>
        <div
            ref={ (element) => panel = element }
            role="dialog"
            aria-modal="true"
            aria-label={ props.entry.label }
            tabindex="-1"
            class={ [ kind, phaseClass ].filter(Boolean).join(' ') }
            style={ detent > 0 ? `--detent:${ detent }px` : undefined }
            onTransitionEnd={ (event) =>
            {
                if (event.target === panel && props.entry.phase === 'closing')
                {
                    overlay.settle(props.entry.id);
                }
            } }
        >
            <Show when={ kind === 'sheet' }>
                { () =>
                    <button
                        type="button"
                        class="sheet-handle flex shrink-0 cursor-grab justify-center pt-2.5 pb-1"
                        aria-label={ locale.t('overlay.handle') }
                        onClick={ () => (props.entry.dismissible ? props.entry.props.close() : undefined) }
                        onPointerDown={ (event) =>
                        {
                            (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
                            points = stops(panel?.offsetHeight ?? 0);
                            drag.start(event.clientX, event.clientY, runtime().clock.now());
                            paint(detent);
                        } }
                        onPointerMove={ (event) =>
                        {
                            if (!drag.active())
                            {
                                return;
                            }
                            const frame = drag.move(event.clientX, event.clientY, runtime().clock.now());
                            paint(detent + frame.offset);
                        } }
                        onPointerUp={ () =>
                        {
                            if (!drag.active())
                            {
                                return;
                            }
                            const frame = drag.end(runtime().clock.now());
                            const index = settleIndex(detent + frame.offset, drag.speed(), points);
                            settleAt(props.entry.dismissible ? index : Math.min(index, points.length - 2));
                        } }
                        onPointerCancel={ () =>
                        {
                            drag.end(runtime().clock.now());
                            paint(null);
                        } }
                    >
                        <span class="h-1.5 w-10 rounded-full bg-line-strong" aria-hidden="true"></span>
                    </button>
                }
            </Show>
            <div ref={ (element) => body = element } class="sheet-body">
                <Dynamic component={ props.entry.component } props={ props.entry.props } />
            </div>
        </div>
    </div>
}
