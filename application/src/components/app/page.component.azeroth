import { untrack, useRoute, type Child } from 'azerothjs';

import { scrollMemory } from '../../lib/scroll-memory.ts';

export default component Page(props: { children?: Child; padded?: boolean; narrow?: boolean; class?: string; label?: string })
{
    const route = useRoute();

    const key = untrack(() => route().key);
    const restored = untrack(() => route().navigationKind === 'pop');

    let root: HTMLElement | null = null;

    mount
    {
        if (restored && root !== null)
        {
            root.scrollTop = scrollMemory.take(key) ?? 0;
        }
        return () =>
        {
            if (root !== null)
            {
                scrollMemory.save(key, root.scrollTop);
            }
        };
    }

    <div
        ref={ (element) => root = element }
        class={ [
            'page bg-void',
            props.padded === false ? '' : 'px-4 pt-4 sm:px-6 lg:px-8 phone:pb-nav rail:pb-8 sidebar:pb-8',
            props.class ?? ''
        ].filter(Boolean).join(' ') }
        data-route-focus
        tabindex="-1"
        aria-label={ props.label }
    >
        <div class={ [
            'mx-auto w-full',
            props.padded === false ? '' : (props.narrow === true ? 'max-w-[44rem]' : 'max-w-[72rem]')
        ].filter(Boolean).join(' ') }>
            { props.children }
        </div>
    </div>
}
