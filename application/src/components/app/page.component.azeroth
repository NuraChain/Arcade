import { untrack, useMatch, useNavigate, useRoute, type Child } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { attachGestures, PULL_ARM } from '../../lib/gestures.ts';
import { haptic } from '../../lib/haptics.ts';
import { routeMeta } from '../../lib/route-meta.ts';
import { runtime } from '../../lib/runtime.ts';
import { scrollMemory } from '../../lib/scroll-memory.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import Spinner from '../ui/spinner.component.azeroth';

/**
 * How wide the column inside a page is allowed to get.
 *
 * It used to be a `narrow` boolean, and "no cap at all" was not sayable - it happened as a SIDE
 * EFFECT of `padded={ false }`, because the max-width lived inside that guard. Splitting padding
 * from width was right, and it took the chat thread's full bleed with it: the one page that passes
 * `padded={ false }` silently gained a 96rem cap it had never had.
 *
 * Three named intents instead, so the page states what it wants and nothing is inferred from an
 * unrelated prop.
 */
export type PageWidth = 'narrow' | 'normal' | 'full';

const PAGE_WIDTH: Record<PageWidth, string> = {
    narrow: 'max-w-[44rem]',
    normal: 'max-w-[96rem]',
    full: ''
};

export default component Page(props: { children?: Child; padded?: boolean; width?: PageWidth; fill?: boolean; class?: string; label?: string; onRefresh?: () => void })
{
    const route = useRoute();
    const match = useMatch();
    const device = useDevice();
    const locale = useLocale();
    const shell = useShell();
    const { back, replace } = useNavigate();

    const key = untrack(() => route().key);
    const restored = untrack(() => route().navigationKind === 'pop');

    state pull = 0;
    state armed = false;
    state busy = false;
    state slide = 0;

    let root: HTMLElement | null = null;
    let release: (() => void) | null = null;
    let settle: (() => void) | null = null;

    /**
     * How far down this page is, read while it is still in the document.
     *
     * A teardown cannot ask the element where it is scrolled to, because by then it is not
     * anywhere. `<Routes>` plays a leave transition and this app always has one - `transitionFor`
     * in `App.azeroth` returns `page-fade` or `page-forward` and never null - so every navigation
     * takes the animated path, which is `removeChild` then `destroyComponent` then dispose. The
     * teardown runs last, against a detached element, and CSSOM View says an element with no box
     * reports `scrollTop` as zero. So the old save wrote 0 for every page on every navigation and
     * the restore then dutifully put every list back at the top.
     *
     * Nothing could see it. `npm run qa` checks overflow, hit targets, a `main` landmark and a
     * clean console; a page confidently scrolled to the top passes all four. `jsdom` has no layout,
     * so `scrollTop` there is an ordinary property that survives detachment and the bug is invisible
     * in a spec that does not model the real rule - which is why `shell.spec.ts` installs that rule
     * on the element before it navigates.
     */
    let depth = 0;

    const track = (): void =>
    {
        depth = root?.scrollTop ?? depth;
    };

    derived meta = routeMeta(match());

    derived leaving = meta.parent !== undefined || shell.depth() > 0;

    derived indicator = busy ? PULL_ARM : pull;

    const refresh = (): void =>
    {
        if (busy || props.onRefresh === undefined)
        {
            return;
        }
        haptic('select');
        busy = true;
        props.onRefresh();
        settle?.();
        settle = runtime().clock.after(620, () => busy = false);
    };

    const exit = (): void =>
    {
        haptic('tick');
        if (shell.depth() > 0)
        {
            back();
            return;
        }
        replace(meta.parent ?? '/app');
    };

    mount
    {
        if (root !== null)
        {
            depth = restored ? scrollMemory.take(key) ?? 0 : 0;
            root.scrollTop = depth;
            root.addEventListener('scroll', track, { passive: true });

            release = attachGestures(root, {
                rtl: () => locale.dir() === 'rtl',
                refresh: props.onRefresh === undefined ? undefined : refresh,
                back: device.posture() === 'phone' && leaving ? exit : undefined,
                onPull: (distance, ready) =>
                {
                    if (ready && !armed)
                    {
                        haptic('tick');
                    }
                    pull = distance;
                    armed = ready;
                },
                onSlide: (distance) => slide = distance
            });
        }
        return () =>
        {
            root?.removeEventListener('scroll', track);
            release?.();
            settle?.();
            scrollMemory.save(key, depth);
        };
    }

    <div
        ref={ (element) => root = element }
        class={ [
            'page bar bg-void',
            slide > 0 ? 'is-sliding' : '',
            props.padded === false ? '' : 'page-pad pt-4 phone:pb-nav rail:pb-8 sidebar:pb-8',
            props.class ?? ''
        ].filter(Boolean).join(' ') }
        style={ slide > 0 ? `--slide:${ slide }px` : undefined }
        data-route-focus
        tabindex="-1"
        aria-label={ props.label }
    >
        <Show when={ props.onRefresh !== undefined && device.coarse() }>
            { () =>
                <div class="pull-indicator" style={ `--pull:${ indicator }` } aria-hidden={ !busy }>
                    <span class={ [
                        'flex h-9 w-9 items-center justify-center rounded-full border border-line bg-lifted text-muted shadow-2 transition-colors duration-150',
                        armed || busy ? 'border-accent/60 text-accent' : ''
                    ].filter(Boolean).join(' ') }>
                        <Show when={ busy } fallback={ <Icon name="refresh" size={ 17 } class="pull-arrow" /> }>
                            { () => <Spinner size={ 17 } label={ locale.t('app.refreshing') } /> }
                        </Show>
                    </span>
                </div>
            }
        </Show>
        <div class={ [
            '@container mx-auto w-full min-w-0',
            props.fill === true ? 'flex h-full min-h-0 flex-col' : '',
            PAGE_WIDTH[props.width ?? 'normal']
        ].filter(Boolean).join(' ') }>
            { props.children }
        </div>
    </div>
}
