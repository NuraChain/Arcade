import { Link, useMatch, useNavigate } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { haptic } from '../../lib/haptics.ts';
import { routeMeta } from '../../lib/route-meta.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Badge from '../ui/badge.component.azeroth';
import { useNavCounts } from './nav-counts.ts';
import { NAV } from './nav-items.ts';
import type { NavItem } from './nav-items.ts';

export default component BottomNav()
{
    const locale = useLocale();
    const { countOf, labelOf, toneOf } = useNavCounts();
    const match = useMatch();
    const { navigate } = useNavigate();


    const press = (item: NavItem): ((event: MouseEvent) => void) =>
    {
        return (event: MouseEvent) =>
        {
            haptic('select');

            if (routeMeta(match()).tab !== item.tab)
            {
                return;
            }

            event.preventDefault();

            const parent = routeMeta(match()).parent;
            if (parent !== undefined)
            {
                void navigate(item.to);
                return;
            }

            document.querySelector('.page')?.scrollTo({ top: 0, behavior: 'smooth' });
        };
    };

    <nav class="z-nav safe-b border-t border-line bg-void/92 backdrop-blur-md" aria-label={ locale.t('app.nav.primary') }>
        <ul class="mx-auto grid h-[var(--nav-h)] w-full max-w-[40rem] grid-cols-5">
            <For each={ NAV } key={ (item) => item.tab } let={ item }>
                <li class="flex">
                    <Link to={ item.to } end={ item.end } activeClass="is-active" prefetch="hover" onClick={ press(item) } class="[&.is-active]:text-accent flex flex-1 flex-col items-center justify-center gap-1 rounded-tile text-ui-2xs font-semibold text-muted transition-colors duration-150">
                        <span class="nav-pill relative flex h-6 w-10 items-center justify-center">
                            <Icon name={ item.icon } size={ 22 } />
                            <Show when={ countOf(item) > 0 }>
                                { () =>
                                    <span class="absolute -end-0.5 -top-1.5">
                                        <Badge count={ countOf(item) } tone={ toneOf(item) } label={ labelOf(item) } />
                                    </span>
                                }
                            </Show>
                        </span>
                        <span>{ locale.t(item.labelKey) }</span>
                    </Link>
                </li>
            </For>
        </ul>
    </nav>
}
