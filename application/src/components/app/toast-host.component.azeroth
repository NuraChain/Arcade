import { onCleanup, Portal } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import { runtime } from '../../lib/runtime.ts';
import { createDrag } from '../../lib/swipe.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useToasts, type Toast, type ToastKind } from '../../stores/toasts.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Spinner from '../ui/spinner.component.azeroth';

const ICON: Record<ToastKind, IconName> = {
    info: 'info',
    success: 'check-circle',
    warning: 'alert',
    error: 'error-circle',
    live: 'zap',
    pending: 'clock'
};

const TONE: Record<ToastKind, string> = {
    info: 'text-muted',
    success: 'text-win',
    warning: 'text-gold',
    error: 'text-danger',
    live: 'text-live',
    pending: 'text-accent'
};

const BAR: Record<ToastKind, string> = {
    info: 'bg-muted',
    success: 'bg-win',
    warning: 'bg-gold',
    error: 'bg-danger',
    live: 'bg-live',
    pending: 'bg-accent'
};

/**
 * Why a toast pauses, and every way it has to start again.
 *
 * It stops for a pointer resting on it and for FOCUS landing on it - a keyboard reaches the action
 * and close buttons too, and somebody reading with the keyboard needs the countdown to stop for the
 * same reason somebody reading with a mouse does. `focusin`/`focusout` rather than `focus`/`blur`,
 * because only those bubble up from the buttons inside.
 *
 * Starting again is the half that went wrong. `onPointerUp` returns early when no drag was active,
 * and a pointer that is CANCELLED - a scroll taking over, the browser stealing it - never reaches
 * that handler at all, while `onPointerDown` had already paused. The toast then sat on screen for
 * good, waiting for a resume that was never coming. `resume` is idempotent, so saying it twice costs
 * nothing and missing it once costs the toast its whole life.
 */
export default component ToastHost()
{
    const toasts = useToasts();
    const locale = useLocale();
    const device = useDevice();
    const people = usePeople();

    state now = runtime().clock.now();

    /**
     * One drag recogniser per toast on screen - and only per toast on screen.
     *
     * Toast ids come from a counter that only ever goes up and this host is mounted for the whole
     * session, so a map that is only ever written to is a map that grows for as long as the tab is
     * open. Nothing fails; it is simply a slow accumulation nobody would ever see, which is exactly
     * why it needs a rule rather than a memory.
     */
    const drags = new Map<string, ReturnType<typeof createDrag>>();

    const dragFor = (id: string): ReturnType<typeof createDrag> =>
    {
        const existing = drags.get(id);
        if (existing !== undefined)
        {
            return existing;
        }
        const made = createDrag({ threshold: 56, velocity: 0.5, axis: 'y' });
        drags.set(id, made);
        return made;
    };

    mount
    {
        return () => drags.clear();
    }

    derived items = toasts.items();

    /**
     * The clock only runs while something is actually counting down.
     *
     * It used to be armed unconditionally in `mount`, which meant a 120ms interval writing a signal
     * roughly eight times a second for the entire life of the app - the host is mounted by the shell
     * and never unmounts, so "cleared on teardown" was true and meaningless. Nothing was leaked; the
     * cost was that the whole reactive graph was woken eight times a second to animate nothing.
     *
     * A toast with an infinite duration is held open deliberately and has no bar to advance, and a
     * paused one is not moving either, so neither needs the tick.
     *
     * `onCleanup` inside an effect run fires before the NEXT run as well as on disposal, so the
     * previous interval is always cancelled before another is armed.
     */
    effect
    {
        const ticking = items.some((toast) => Number.isFinite(toast.duration) && !toast.paused);
        if (!ticking)
        {
            return;
        }

        now = runtime().clock.now();
        onCleanup(runtime().clock.every(120, () => now = runtime().clock.now()));
    }

    effect
    {
        const alive = new Set(items.map((toast) => toast.id));
        for (const id of [...drags.keys()])
        {
            if (!alive.has(id))
            {
                drags.delete(id);
            }
        }
    }

    derived queued = toasts.queued();

    const held = (toast: Toast): boolean => !Number.isFinite(toast.duration);

    <Portal>
        <div
            class="fixed inset-x-0 z-(--z-toast) flex flex-col items-center gap-2 px-3 pointer-events-none data-[placement=bottom]:inset-be-[calc(var(--nav-h)+env(safe-area-inset-bottom,0px)+0.75rem)] data-[placement=top]:inset-bs-[calc(env(safe-area-inset-top,0px)+0.75rem)] data-[placement=top]:flex-col-reverse rail:data-[placement=bottom]:inset-be-4 rail:data-[placement=bottom]:items-end rail:data-[placement=bottom]:px-4 sidebar:data-[placement=bottom]:inset-be-4 sidebar:data-[placement=bottom]:items-end sidebar:data-[placement=bottom]:px-4"
            data-placement={ toasts.placement() }
            data-posture={ device.posture() }
            role="region"
            aria-label={ locale.t('toast.region') }
            aria-live="polite"
        >
            <For each={ items } key={ (toast) => toast.id } let={ toast }>
                <div
                    class="pointer-events-auto relative flex inline-full max-inline-[26rem] items-center gap-2.5 overflow-hidden rounded-panel border border-line bg-lifted py-2 pr-2 pl-3 [box-shadow:var(--shadow-3)] touch-pan-x [translate:0_var(--swipe,0px)] animate-toast-in before:absolute before:inset-y-0 before:start-0 before:inline-[3px] before:bg-(--toast-tone,var(--accent)) data-[kind=success]:[--toast-tone:var(--live)] data-[kind=live]:[--toast-tone:var(--live)] data-[kind=error]:[--toast-tone:var(--danger)] data-[kind=warning]:[--toast-tone:var(--gold)]"
                    data-kind={ toast.kind }
                    role={ toast.kind === 'error' ? 'alert' : 'status' }
                    aria-live={ toast.kind === 'error' ? 'assertive' : 'polite' }
                    ref={ (element) => element.style.setProperty('--swipe', '0px') }
                    onPointerEnter={ (event) => (event.pointerType === 'mouse' ? toasts.pause(toast.id) : undefined) }
                    onPointerLeave={ (event) => (event.pointerType === 'mouse' ? toasts.resume(toast.id) : undefined) }

                    onFocusIn={ () => toasts.pause(toast.id) }
                    onFocusOut={ () => toasts.resume(toast.id) }
                    onPointerDown={ (event) =>
                    {
                        if (!device.coarse() || !toast.dismissible)
                        {
                            return;
                        }
                        (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
                        toasts.pause(toast.id);
                        dragFor(toast.id).start(event.clientX, event.clientY, runtime().clock.now());
                    } }
                    onPointerMove={ (event) =>
                    {
                        const drag = drags.get(toast.id);
                        if (drag === undefined || !drag.active())
                        {
                            return;
                        }
                        const frame = drag.move(event.clientX, event.clientY, runtime().clock.now());
                        (event.currentTarget as HTMLElement).style.setProperty('--swipe', `${ frame.offset }px`);
                    } }
                    onPointerUp={ (event) =>
                    {
                        const drag = drags.get(toast.id);
                        if (drag === undefined || !drag.active())
                        {
                            return;
                        }
                        const frame = drag.end(runtime().clock.now());
                        (event.currentTarget as HTMLElement).style.setProperty('--swipe', '0px');
                        if (frame.dismiss)
                        {
                            toasts.dismiss(toast.id);
                            return;
                        }
                        toasts.resume(toast.id);
                    } }

                    onPointerCancel={ (event) =>
                    {
                        drags.get(toast.id)?.end(runtime().clock.now());
                        (event.currentTarget as HTMLElement).style.setProperty('--swipe', '0px');
                        toasts.resume(toast.id);
                    } }
                >
                    <span class={ () => [ 'shrink-0', TONE[toast.kind] ].join(' ') } aria-hidden="true">
                        <Show
                            when={ toast.avatar !== null }
                            fallback={
                                <Show when={ toast.kind === 'pending' } fallback={ <Icon name={ toast.icon ?? ICON[toast.kind] } size={ 18 } /> }>
                                    { () => <Spinner size={ 18 } /> }
                                </Show>
                            }
                        >
                            { () => <Avatar person={ people.byHandle(toast.avatar!) ?? null } size="sm" /> }
                        </Show>
                    </span>

                    <span class="flex min-w-0 flex-1 flex-col">
                        <span class="text-ui-base text-text">{ toast.text }</span>
                        <Show when={ toast.detail !== null }>
                            { () => <span class="truncate text-ui-xs text-muted">{ toast.detail }</span> }
                        </Show>
                    </span>

                    <Show when={ toast.action !== null }>
                        { () =>
                            <button
                                type="button"
                                class="shrink-0 cursor-pointer rounded-control px-2 py-1 text-ui-sm font-bold text-accent hover:bg-accent/10"
                                onClick={ () =>
                                {
                                    toast.action?.run();
                                    if (toast.action?.keepOpen !== true)
                                    {
                                        toasts.dismiss(toast.id);
                                    }
                                } }
                            >
                                { toast.action?.label }
                            </button>
                        }
                    </Show>

                    <Show when={ toast.dismissible }>
                        { () =>
                            <button
                                type="button"
                                class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-control text-faint hover:bg-field hover:text-text coarse:h-11 coarse:w-11"
                                aria-label={ locale.t('toast.dismiss') }
                                onClick={ () => toasts.dismiss(toast.id) }
                            >
                                <Icon name="close" size={ 15 } />
                            </button>
                        }
                    </Show>

                    <Show when={ !held(toast) }>
                        { () =>
                            <span class="absolute inset-x-0 inset-be-0 block-[2px] bg-line/60" aria-hidden="true">
                                <span class={ () => [ 'block block-full [transition:inline-size_140ms_linear]', BAR[toast.kind] ].join(' ') } style={ `inline-size: ${ Math.round((1 - toasts.progress(toast.id, now)) * 100) }%` }></span>
                            </span>
                        }
                    </Show>
                </div>
            </For>

            <Show when={ queued > 0 }>
                { () =>
                    <p class="pointer-events-auto rounded-control border border-line bg-field px-2.5 py-1 text-ui-2xs font-semibold text-muted shadow-1">
                        { locale.t('toast.more', { count: locale.n(queued) }) }
                    </p>
                }
            </Show>
        </div>
    </Portal>
}
