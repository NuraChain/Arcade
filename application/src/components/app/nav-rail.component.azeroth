import { Link } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { useChat } from '../../stores/chat.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';
import { NAV, SECONDARY } from './nav-items.ts';

export default component NavRail()
{
    const locale = useLocale();
    const account = useAccount();
    const chat = useChat();

    derived unread = chat.totalUnread();

    <nav class="bar safe-t safe-b flex h-dvh w-[var(--rail-w)] flex-col items-center gap-1 overflow-y-auto border-e border-line bg-field py-3" aria-label={ locale.t('app.nav.primary') }>
        <Link to="/app" class="lit mb-3 flex h-10 w-10 shrink-0 items-center justify-center rounded-control bg-accent text-accent-ink coarse:h-11 coarse:w-11" aria-label={ locale.t('app.nav.home') }>
            <Icon name="games" size={ 18 } />
        </Link>
        <ul class="flex shrink-0 flex-col items-center gap-0.5">
            <For each={ NAV } key={ (item) => item.tab } let={ item }>
                <li class="shrink-0">
                    <Link to={ item.to } end={ item.end } activeClass="is-active" prefetch="hover" class="nav-item flex w-16 flex-col items-center gap-0.5 rounded-tile py-1.5 text-ui-2xs font-semibold text-muted">
                        <span class="nav-pill relative flex h-7 w-11 items-center justify-center rounded-control transition-colors duration-200">
                            <Icon name={ item.icon } size={ 20 } />
                            <Show when={ item.tab === 'chats' && unread > 0 }>
                                { () => <Badge count={ unread } size="sm" anchor label={ locale.plural('common.unread', unread) } /> }
                            </Show>
                        </span>
                        <span>{ locale.t(item.labelKey) }</span>
                    </Link>
                </li>
            </For>
        </ul>
        <ul class="mt-auto flex shrink-0 flex-col items-center gap-0.5 pt-3">
            <For each={ SECONDARY } key={ (item) => item.tab } let={ item }>
                <li class="shrink-0">
                    <Tooltip label={ locale.t(item.labelKey) } side="end">
                        <Link to={ item.to } activeClass="is-active" class="nav-item flex h-11 w-11 items-center justify-center rounded-control text-muted" aria-label={ locale.t(item.labelKey) }>
                            <Icon name={ item.icon } size={ 19 } />
                        </Link>
                    </Tooltip>
                </li>
            </For>
            <li class="mt-1 shrink-0">
                <Tooltip label={ locale.t('app.nav.me') } side="end">
                    <Link to="/app/me" class="flex h-11 w-11 items-center justify-center rounded-control" aria-label={ locale.t('app.nav.me') }>
                        <Avatar person={ account.user() } size="sm" presence="online" />
                    </Link>
                </Tooltip>
            </li>
        </ul>
    </nav>
}
