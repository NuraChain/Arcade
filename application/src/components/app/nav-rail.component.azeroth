import BrandLogo from '../layout/brand-logo.component.azeroth';
import { Link } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { useAccount } from '../../stores/account.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useRealtime } from '../../stores/realtime.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Tooltip from '../ui/tooltip.component.azeroth';
import { RAIL } from './nav-items.ts';

export default component NavRail()
{
    const locale = useLocale();
    const account = useAccount();
    const chat = useChat();
    const live = useRealtime();

    derived user = account.user();

    derived unread = chat.totalUnread();

    const lobby = useLobby();

    derived waiting = lobby.waiting().length;

    <nav class="bar safe-t safe-b flex h-dvh w-[var(--rail-w)] flex-col items-center border-e border-line bg-void" aria-label={ locale.t('app.nav.primary') }>
        <span class="flex h-[var(--topbar-h)] w-full shrink-0 items-center justify-center">
            <Link to="/app" class="flex h-11 w-11 items-center justify-center rounded-control" aria-label={ locale.t('app.nav.home') }>
                <BrandLogo size="lg" />
            </Link>
        </span>
        <ul class="flex min-h-0 flex-1 flex-col items-center gap-1 overflow-y-auto pt-3">
            <For each={ RAIL } key={ (item) => item.to } let={ item }>
                <li class="shrink-0">
                    <Tooltip label={ locale.t(item.labelKey) } side="end">
                        <Link to={ item.to } end={ item.end } activeClass="is-active" prefetch="hover" class="nav-item nav-row relative flex h-11 w-11 items-center justify-center rounded-tile text-muted transition-colors duration-150 hover:bg-raised hover:text-text" aria-label={ locale.t(item.labelKey) }>
                            <Icon name={ item.icon } size={ 20 } />
                            <Show when={ item.tab === 'games' && waiting > 0 }>
                                { () => <Badge count={ waiting } size="sm" tone="live" anchor label={ locale.plural('common.waitingTables', waiting) } /> }
                            </Show>
                            <Show when={ item.tab === 'chats' && unread > 0 }>
                                { () => <Badge count={ unread } size="sm" anchor label={ locale.plural('common.unread', unread) } /> }
                            </Show>
                        </Link>
                    </Tooltip>
                </li>
            </For>
        </ul>
        <div class="shrink-0 py-3">
            <Tooltip label={ locale.t('app.nav.profile') } side="end">
                <Link to="/app/me" class="flex h-11 w-11 items-center justify-center rounded-full" aria-label={ locale.t('app.nav.profile') }>
                    <Avatar person={ user } size="sm" presence={ user !== null && live.status() === 'connected' ? 'online' : null } ringOn="void" />
                </Link>
            </Tooltip>
        </div>
    </nav>
}
