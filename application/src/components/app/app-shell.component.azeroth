import { Outlet, untrack, useHead, useMatch, useRoute, type MountNode } from 'azerothjs';

import '../../icons/all.ts';
import '../../locales/app-catalogue.ts';
import { setHaptics } from '../../lib/haptics.ts';
import { routeMeta } from '../../lib/route-meta.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useSeal } from '../../stores/seal.store.ts';
import { useConnection } from '../../stores/connection.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useWatch } from '../../stores/watch.store.ts';
import { bareFor, useDevice } from '../../stores/device.store.ts';
import { useDevices } from '../../stores/devices.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useNotifications } from '../../stores/notifications.store.ts';
import { useRealtime } from '../../stores/realtime.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useWallet } from '../../stores/wallet.store.ts';
import { useShell } from '../../stores/shell.store.ts';
import BottomNav from './bottom-nav.component.azeroth';
import ConnectionBanner from './connection-banner.component.azeroth';
import KeysBanner from './keys-banner.component.azeroth';
import NavRail from './nav-rail.component.azeroth';
import OverlayHost from './overlay-host.component.azeroth';
import Sidebar from './sidebar.component.azeroth';
import SocialPanel from './social-panel.component.azeroth';
import ToastHost from './toast-host.component.azeroth';
import EmojiPopover from '../chat/emoji-popover.component.azeroth';
import { useToasts } from '../../stores/toasts.store.ts';
import { useVoice } from '../../stores/voice.store.ts';
import TopBar from './top-bar.component.azeroth';


export default component AppShell(props: { children?: MountNode })
{
    const device = useDevice();
    const settings = useSettings();
    const overlay = useOverlay();
    const shell = useShell();
    const locale = useLocale();
    const route = useRoute();
    const match = useMatch();

    useHead({ titleTemplate: `%s · ${ locale.t('app.title') }` });

    let seen = untrack(() => route().key);

    effect
    {
        setHaptics(settings.settings().haptics && device.coarse());
    }

    effect
    {
        const location = route();
        if (location.key === seen)
        {
            return;
        }
        seen = location.key;
        if (location.navigationKind === 'push')
        {
            shell.notePush();
        }
        else if (location.navigationKind === 'pop')
        {
            shell.notePop();
        }
    }

    mount
    {
        shell.resetDepth();
        const stops = [
            useToasts().start(),
            useRealtime().start(),
            useVoice().start(),
            useConnection().start(),
            useCatalogue().start(),
            useSocial().start(),
            useGroups().start(),
            useLobby().start(),
            useBoard().start(),
            useWatch().start(),
            useChat().start(),
            useSeal().start(),
            useNotifications().start(),
            useWallet().start()
        ];

        void useDevices().look();
        return () =>
        {
            for (const stop of [...stops].reverse())
            {
                try
                {
                    stop();
                }
                catch (error)
                {
                    reportError(error);
                }
            }
        };
    }

    derived posture = device.posture();

    derived immersive = routeMeta(match()).immersive === true;

    derived messenger = routeMeta(match()).messenger === true;

    derived showBottomNav = posture === 'phone' && !device.keyboardOpen() && !immersive;

    derived showSocial = posture === 'sidebar' && device.social() && !immersive && !messenger;

    derived bare = bareFor(immersive, posture, device.height());

    derived compact = !bare && (posture === 'rail' || (posture === 'sidebar' && ((immersive && !messenger) || !settings.settings().sidebarOpen)));

    <div class="contents">
        <div
            id="app-shell"
            data-posture={ posture }
            inert={ overlay.blocking() }
            class={ () => [
                'grid h-dvh min-h-0 bg-void text-text',
                posture === 'phone' || bare ? 'grid-cols-1' : (compact ? 'grid-cols-[var(--rail-w)_minmax(0,1fr)]' : 'grid-cols-[var(--sidebar-w)_minmax(0,1fr)]')
            ].join(' ') }
        >
            <Show when={ compact }>{ () => <NavRail /> }</Show>
            <Show when={ posture === 'sidebar' && !compact && !bare }>{ () => <Sidebar /> }</Show>

            <div class="flex h-dvh min-h-0 min-w-0 flex-col">
                <Show when={ !bare }>{ () => <TopBar /> }</Show>
                <ConnectionBanner />
                <Show when={ !immersive }>{ () => <KeysBanner /> }</Show>
                <div class="flex min-h-0 flex-1">
                    <main id="app-main" class="relative min-h-0 min-w-0 flex-1 overflow-hidden">
                        <Outlet children={ props.children } />
                    </main>
                    <Show when={ showSocial }>{ () => <SocialPanel /> }</Show>
                </div>
                <Show when={ showBottomNav }>{ () => <BottomNav /> }</Show>
            </div>
        </div>
        <OverlayHost />
        <EmojiPopover />
        <ToastHost />
    </div>
}
