import { Dynamic, type MountNode, Outlet, useNavigate } from 'azerothjs';

import { useConnect } from '../../stores/connect.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import SiteFooter from './site-footer.component.azeroth';
import SiteHeader from './site-header.component.azeroth';

export default component PublicShell(props: { children?: MountNode })
{
    const locale = useLocale();
    const connect = useConnect();
    const { navigate } = useNavigate();

    let Dialog: ((props: { close: () => void; navigate: (to: string) => void }) => MountNode) | null = null;

    state loaded = false;

    const dialogProps = { close: () => connect.close(), navigate };

    effect
    {
        if (connect.open() && !loaded)
        {
            void import('./connect-dialog.component.azeroth').then((module) =>
            {
                Dialog = module.default;
                loaded = true;
            });
        }
    }

    <div class="min-h-dvh bg-void text-text">

        <a
            href="#main"
            class="sr-only rounded-full bg-accent-fill px-4 py-2 text-ui-base font-semibold text-accent-ink focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-50"
        >
            { locale.t('a11y.skip') }
        </a>

        <SiteHeader />

        <main id="main">
            <Outlet children={ props.children } />
        </main>

        <SiteFooter />

        <Show when={ connect.open() && loaded }>
            { () => <Dynamic component={ Dialog! } props={ dialogProps } /> }
        </Show>
    </div>
}
