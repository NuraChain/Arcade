import { Dynamic, type MountNode } from 'azerothjs';

import BrandLogo from './brand-logo.component.azeroth';
import BrandMark from './brand-mark.component.azeroth';
import LanguageSwitch from './language-switch.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import { beenHere } from '../../lib/been-here.ts';
import { useConnect } from '../../stores/connect.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

interface DrawerProps
{
    open: boolean;
    returning: boolean;
    close: () => void;
}

export default component SiteHeader(props: { cta?: boolean })
{
    const locale = useLocale();
    const connect = useConnect();

    state open = false;

    state returning = false;

    state loaded = false;

    let Drawer: ((props: DrawerProps) => MountNode) | null = null;

    const drawerProps = () => ({
        open,
        returning,
        close: () => open = false
    });

    mount
    {
        returning = beenHere();
    }

    const toggle = (): void =>
    {
        open = !open;
        if (open && !loaded)
        {
            void import('./site-drawer.component.azeroth').then((module) =>
            {
                Drawer = module.default;
                loaded = true;
            });
        }
    };

    <header class="site-header fixed inset-x-0 top-0 z-30 safe-t">
        <div class="page-pad flex h-15 items-center gap-3">
            <a href="/" class="flex min-h-11 items-center gap-2.5 rounded-control" aria-label={ locale.t('brand.name') }>
                <BrandLogo size="md" />
                <BrandMark class="hidden text-ui-lg text-text min-[25rem]:inline" />
            </a>

            <div class="ms-auto flex items-center gap-2">
                <div class="hidden sm:block">
                    <LanguageSwitch />
                </div>
                <Show when={ props.cta !== false }>
                    { () =>
                        <Show
                            when={ returning }
                            fallback={ <Button variant="primary" size="sm" leading="wallet" onClick={ () => connect.show() }>{ locale.t('nav.connect') }</Button> }
                        >
                            { () =>
                                <Button variant="primary" size="sm" leading="games" to="/app">
                                    { locale.t('nav.enter') }
                                </Button>
                            }
                        </Show>
                    }
                </Show>
                <IconButton icon="menu" label={ locale.t('nav.menu') } expanded={ open } onClick={ toggle } />
            </div>
        </div>

        <Show when={ loaded }>
            { () => <Dynamic component={ Drawer! } props={ drawerProps } /> }
        </Show>
    </header>
}
