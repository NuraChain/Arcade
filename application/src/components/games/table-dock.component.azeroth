import TableMenu from './table-menu.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useSettings } from '../../stores/settings.store.ts';

const canFullscreen = (): boolean =>
    typeof document !== 'undefined' && document.fullscreenEnabled === true;

const lockUpright = (): Promise<void> =>
{
    const orientation = screen.orientation as (ScreenOrientation & { lock?: (to: string) => Promise<void> }) | undefined;

    return orientation?.lock?.('portrait').catch(() => undefined) ?? Promise.resolve();
};

export default component TableDock(props: {
    code?: string;
    target?: HTMLElement | null;
    onChat?: () => void;
    onResign?: () => void;
    upright?: boolean;
})
{
    const locale = useLocale();
    const settings = useSettings();
    const overlay = useOverlay();

    state full = false;

    derived sound = settings.settings().sound;

    mount
    {
        const onChanged = (): void =>
        {
            full = document.fullscreenElement !== null;
        };

        document.addEventListener('fullscreenchange', onChanged);

        return () => document.removeEventListener('fullscreenchange', onChanged);
    }

    const toggleFull = (): void =>
    {
        const host = props.target ?? document.documentElement;

        if (document.fullscreenElement === null)
        {
            void host.requestFullscreen?.()
                .then(() => props.upright === true ? lockUpright() : undefined)
                .catch(() => undefined);
            return;
        }

        void document.exitFullscreen?.().catch(() => undefined);
    };

    const openMenu = (): void =>
    {
        overlay.open(
            TableMenu,
            {
                code: props.code ?? '',
                full,
                ...(canFullscreen() ? { onFullscreen: toggleFull } : {}),
                ...(props.onResign === undefined ? {} : { onResign: props.onResign })
            },
            { label: locale.t('play.menu.title') }
        );
    };

    <div class="flex shrink-0 items-center gap-1">
        <span class="hidden items-center gap-1 @2xl:flex">
            <IconButton
                icon={ sound ? 'sound' : 'sound-off' }
                label={ locale.t(sound ? 'play.dock.soundOff' : 'play.dock.soundOn') }
                variant="ghost"
                pressed={ sound }
                onClick={ () => settings.update({ sound: !sound }) }
            />

            <Show when={ canFullscreen() }>
                { () =>
                    <IconButton
                        icon={ full ? 'fullscreen-exit' : 'fullscreen' }
                        label={ locale.t(full ? 'play.dock.windowed' : 'play.dock.fullscreen') }
                        variant="ghost"
                        pressed={ full }
                        onClick={ () => toggleFull() }
                    />
                }
            </Show>

            <Show when={ props.onResign !== undefined }>
                { () =>
                    <IconButton
                        icon="report"
                        label={ locale.t('match.resign') }
                        variant="ghost"
                        onClick={ () => props.onResign?.() }
                    />
                }
            </Show>
        </span>

        <span class="flex @2xl:hidden">
            <IconButton icon="more" label={ locale.t('play.menu.title') } variant="ghost" onClick={ () => openMenu() } />
        </span>

        <Show when={ props.onChat !== undefined }>
            { () =>
                <IconButton
                    icon="chats"
                    label={ locale.t('play.table.chatShow') }
                    variant="secondary"
                    onClick={ () => props.onChat?.() }
                />
            }
        </Show>
    </div>
}
