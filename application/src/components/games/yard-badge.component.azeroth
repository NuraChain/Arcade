import DieFace from './die-face.component.azeroth';
import TablePlate from './table-plate.component.azeroth';
import { MISSES_ALLOWED, type PlateTone } from './plate-tag.ts';
import { INITIAL } from './seats.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { LudoSeat, MatchPlayer } from '../../data/match.ts';

const PIPS = [0, 1, 2, 3];

export default component YardBadge(props: {
    player: MatchPlayer;
    seat: LudoSeat;
    corner: string;
    mine?: number;
    active: boolean;
    die?: number;
    finished: boolean;
    bubble?: string;
    remainingMs?: number;
    turnMs?: number;
})
{
    const locale = useLocale();
    const people = usePeople();

    derived person = people.byHandle(props.player.who);

    derived mine = props.player.seat === props.mine;

    derived turn = props.active && !props.finished;

    derived name = mine
        ? locale.t('match.you')
        : (person === null ? props.player.who : locale.text(person.displayName));

    derived warned = props.player.timeouts >= MISSES_ALLOWED - 1 && !props.finished;

    derived routine = props.player.result === undefined && !props.seat.out && props.player.timeouts === 0;

    derived says = ((): string =>
    {
        if (props.player.result === 'won')
        {
            return locale.t('card.won');
        }

        if (props.seat.out || props.player.result === 'abandoned')
        {
            return locale.t('card.out');
        }

        if (props.player.result === 'lost')
        {
            return locale.t('card.lost');
        }

        if (props.player.timeouts > 0)
        {
            return warned
                ? locale.t('card.lastChance')
                : locale.plural('match.missed', props.player.timeouts);
        }

        if (!turn)
        {
            return locale.t('card.waiting');
        }

        return mine ? locale.t('card.yourTurn') : locale.t('card.turn');
    })();

    derived tone = ((): PlateTone =>
    {
        if (warned)
        {
            return 'danger';
        }

        if (props.player.result === 'won')
        {
            return 'live';
        }

        return props.player.timeouts > 0 && !props.finished ? 'gold' : 'neutral';
    })();

    <div class="yard-badge" data-corner={ props.corner } style={ `--ink: var(--ludo-${ props.seat.colour })` }>
        <TablePlate
            who={ props.player.who }
            name={ name }
            turn={ turn }
            remainingMs={ props.remainingMs }
            turnMs={ props.turnMs }
            ink={ `var(--ludo-${ props.seat.colour })` }
            dim={ props.seat.out }
            tag={ routine ? undefined : says }
            tone={ tone }
            bubble={ props.bubble }
            below={ props.corner.startsWith('top') }
            anchor={ props.corner.endsWith('right') ? 'end' : 'start' }
            marker={ <span class="yard-initial" aria-hidden="true">{ INITIAL[props.seat.colour] }</span> }
            facts={
                <span class="contents">
                    <span class="yard-pips" role="img" aria-label={ locale.plural('match.tokens', props.seat.home) }>
                        <For each={ PIPS } key={ (pip) => pip } let={ pip }>
                            <span class="ludo-pip" data-home={ pip < props.seat.home ? 'true' : 'false' } aria-hidden="true"></span>
                        </For>
                    </span>
                    <Show when={ routine }>
                        { () => <span class="sr-only">{ says }</span> }
                    </Show>
                </span>
            }
            trail={ props.die !== undefined && turn
                ? <span class="yard-die"><DieFace value={ props.die! } size="fill" label={ locale.t('match.turn.rolled', { die: locale.n(props.die!) }) } /></span>
                : undefined }
        />
    </div>
}
