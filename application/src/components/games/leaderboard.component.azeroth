import LoadMore from '../ui/load-more.component.azeroth';
import { createResource } from 'azerothjs';

import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import SectionHeading from '../ui/section-heading.component.azeroth';
import Segmented from '../ui/segmented.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import type { Standing } from '../../api.ts';
import { client } from '../../api.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { GameId } from '../../data/games.ts';
import type { LeaderboardWindow } from '../../api.ts';

const WINDOWS: { id: LeaderboardWindow; key: 'board.today' | 'board.month' | 'board.year' | 'board.all' }[] = [
    { id: 'today', key: 'board.today' },
    { id: 'month', key: 'board.month' },
    { id: 'year', key: 'board.year' },
    { id: 'all', key: 'board.all' }
];

export default component Leaderboard(props: { game: GameId; titled?: boolean })
{
    const locale = useLocale();

    state window = 'month' as LeaderboardWindow;

    const board = createResource(
        () => ({ game: props.game, window }),
        (asked) => client.catalogue.leaderboard({ params: { game: asked.game }, query: { window: asked.window } }),
        { name: 'catalogue.leaderboard' }
    );

    state extra = [] as Standing[];

    state cursor = undefined as number | undefined;

    state paging = false;

    state pageFailed = false;

    effect
    {
        void props.game;
        void window;

        extra = [];
        cursor = undefined;
        pageFailed = false;
    }

    derived standings = [...(board.data()?.standings ?? []), ...extra];

    derived nextFrom = extra.length === 0 ? board.data()?.cursor : cursor;

    const more = async (): Promise<void> =>
    {
        const from = nextFrom;

        if (from === undefined || paging)
        {
            return;
        }

        paging = true;
        pageFailed = false;

        try
        {
            const page = await client.catalogue.leaderboard({
                params: { game: props.game },
                query: { window, after: String(from) }
            });

            extra = [...extra, ...page.standings];
            cursor = page.cursor;
        }
        catch
        {
            pageFailed = true;
        }
        finally
        {
            paging = false;
        }
    };

    derived showing = board.data()?.window ?? window;

    derived failed = board.error() !== null && standings.length === 0;

    derived empty = locale.t(showing === 'all' ? 'board.empty' : 'board.emptyWindow');

    const nameOf = (row: { handle: string; person: { displayName: string } }): string =>
        row.person.displayName === '' ? row.handle : locale.text(row.person.displayName);

    <section aria-labelledby="game-board">
        <Show when={ props.titled !== false }>
            <SectionHeading id="game-board" title={ locale.t('board.title') } />
        </Show>

        <div class="mb-3">
            <Segmented
                block
                label={ locale.t('board.window') }
                value={ window }
                items={ WINDOWS.map((one) => ({ id: one.id, label: locale.t(one.key) })) }
                onChange={ (id) => window = id as LeaderboardWindow }
            />
        </div>

        <Show when={ board.loading() && standings.length === 0 }>
            { () => <Skeleton class="h-32 w-full rounded-panel" /> }
        </Show>

        <Show when={ !board.loading() && failed }>
            { () =>
                <Panel class="flex flex-col items-start gap-2 text-ui-sm text-muted">
                    { locale.t('board.failed') }
                    <Button variant="outline" size="sm" onClick={ () => board.refetch() }>
                        { locale.t('common.retry') }
                    </Button>
                </Panel>
            }
        </Show>

        <Show when={ !board.loading() && !failed && standings.length === 0 }>
            { () => <Panel class="text-ui-sm text-muted">{ empty }</Panel> }
        </Show>

        <Show when={ standings.length > 0 }>
            { () =>
                <Panel pad="none" class="px-2 py-1">
                    <ol class="flex flex-col">
                        <For each={ standings } key={ (row) => row.handle } let={ row }>
                            <li class="flex min-h-14 items-center gap-3 border-b border-line px-2 py-2 last:border-b-0">
                                <span class={ () => [
                                    'tally flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-ui-sm font-bold',
                                    row.rank === 1 ? 'bg-gold/15 text-gold' : (row.rank <= 3 ? 'bg-raised text-text' : 'text-faint')
                                ].join(' ') }>
                                    { locale.n(row.rank) }
                                </span>
                                <Avatar person={ { displayName: row.person.displayName, hue: row.person.hue } } size="sm" />
                                <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                    <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ nameOf(row) }</span>
                                    <span class="truncate text-ui-xs text-muted">
                                        { locale.t('board.line', {
                                            played: locale.plural('board.played', row.played),
                                            rating: locale.n(row.rating)
                                        }) }
                                    </span>
                                </span>
                                <span class="shrink-0 text-ui-sm font-bold text-text">
                                    { locale.t('board.xp', { xp: locale.n(row.xp) }) }
                                </span>
                            </li>
                        </For>
                    </ol>

                    <Show when={ pageFailed }>
                        { () => <p class="mt-2 text-center text-ui-xs text-danger">{ locale.t('board.moreFailed') }</p> }
                    </Show>

                    <Show when={ nextFrom !== undefined }>
                        { () =>
                            <LoadMore label={ locale.t('board.more') } loading={ paging } onMore={ () => void more() } />
                        }
                    </Show>
                </Panel>
            }
        </Show>
    </section>
}
