import type { GameId } from '../../data/games.ts';
import type { TableSummary } from '../../api.ts';
import Icon from '../../icons/icon.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';
import SeatCard from './seat-card.component.azeroth';
import Panel from '../ui/panel.component.azeroth';

/**
 * The table, as it stands.
 *
 * Every chair here is a row somebody claimed. Nothing arrives on a timer, nothing is filled with
 * a practice partner to make the grid look busy, and the panel never counts anybody down: the
 * furthest a table goes is every chair taken, because there is no game behind it yet and the one
 * thing this screen must not do is imply there is.
 */
export default component LobbyPanel(props: {
    table: TableSummary;
    onInvite: () => void;
    onCopyLink: () => void;
    onLeave: () => void;
})
{
    const locale = useLocale();
    const lobby = useLobby();
    const catalogue = useCatalogue();
    const people = usePeople();

    derived me = lobby.me();

    derived mine = props.table.mine === undefined
        ? null
        : (props.table.chairs.find((chair) => chair.seat === props.table.mine) ?? null);

    derived amHost = mine?.host === true;

    derived empty = props.table.seats - props.table.taken;

    derived full = empty === 0;

    derived waitingOn = props.table.chairs
        .filter((chair) => chair.who !== undefined && chair.who !== me && !chair.ready)
        .map((chair) => people.byHandle(chair.who!))
        .map((person) => (person === null ? '' : person.displayName.split(' ')[0]))
        .filter(Boolean);

    derived status = empty > 0
        ? locale.plural('play.lobby.emptySeats', empty)
        : (waitingOn.length > 0 ? locale.t('play.lobby.waiting', { names: locale.list(waitingOn) }) : locale.t('play.lobby.allReady'));

    derived gameName = locale.t(catalogue.byId(props.table.game as GameId).nameKey);

    <section class="flex flex-col gap-5" aria-label={ locale.t('play.title.lobby') }>
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <p class="label text-ui-xs text-faint">{ locale.t('play.title.lobby') }</p>
                <h2 class="title text-ui-2xl text-text">{ gameName }</h2>
            </div>
            <p class="flex items-center gap-2 text-ui-base text-muted" aria-live="polite">
                <Show when={ full } fallback={ <Icon name="clock" size={ 15 } /> }>
                    { () => <span class="live-dot h-2.5 w-2.5 rounded-full" aria-hidden="true"></span> }
                </Show>
                <span>{ status }</span>
            </p>
        </div>

        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4" aria-label={ locale.t('create.seats') }>
            <For each={ props.table.chairs } key={ (chair) => chair.seat } let={ chair }>
                <li class="flex min-w-0">
                    <SeatCard seat={ chair } me={ me } canInvite={ amHost } onInvite={ () => props.onInvite() } />
                </li>
            </For>
        </ul>

        <Show when={ full }>
            { () =>
                <Panel class="text-center text-ui-base text-muted">
                    { locale.t('play.table.notBuilt') }
                </Panel>
            }
        </Show>

        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <Button
                variant={ mine?.ready === true ? 'live' : 'primary' }
                size="lg"
                block
                leading={ mine?.ready === true ? 'check-circle' : 'zap' }
                disabled={ mine === null }
                onClick={ () => void lobby.ready(props.table.id, !(mine?.ready === true)) }
            >
                { mine?.ready === true ? locale.t('play.lobby.readyTag') : locale.t('play.lobby.ready') }
            </Button>
            <div class="flex gap-2 sm:shrink-0">
                <Button variant="outline" size="lg" leading="copy" class="flex-1 sm:flex-none" onClick={ () => props.onCopyLink() }>{ locale.t('play.lobby.copyLink') }</Button>
                <Button variant="ghost" size="lg" leading="sign-out" class="flex-1 text-danger sm:flex-none" onClick={ () => props.onLeave() }>{ locale.t('play.lobby.leave') }</Button>
            </div>
        </div>
    </section>
}
