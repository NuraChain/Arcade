import { personById } from '../../data/mock/index.ts';
import Icon from '../../icons/icon.component.azeroth';
import { openSeats } from '../../lib/matchmaking.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Button from '../ui/button.component.azeroth';
import SeatCard from './seat-card.component.azeroth';

export default component LobbyPanel(props: { onInvite: () => void; onCopyLink: () => void; onLeave: () => void })
{
    const locale = useLocale();
    const lobby = useLobby();
    const catalogue = useCatalogue();

    derived current = lobby.state();

    derived me = lobby.me();

    derived mine = current.seats.find((seat) => seat.playerId === me) ?? null;

    derived amHost = mine?.host === true;

    derived empty = openSeats(current).length;

    derived starting = current.phase === 'starting';

    derived waitingOn = current.seats
        .filter((seat) => seat.playerId !== null && seat.playerId !== me && !seat.ready && !seat.bot)
        .map((seat) => personById(seat.playerId!))
        .map((person) => (person === undefined ? '' : locale.text(person.name).split(' ')[0]))
        .filter(Boolean);

    derived status = starting
        ? locale.t('play.starting.lead')
        : (empty > 0
            ? locale.plural('play.lobby.emptySeats', empty)
            : (waitingOn.length > 0 ? locale.t('play.lobby.waiting', { names: locale.list(waitingOn) }) : locale.t('play.lobby.readyTag')));

    derived gameName = current.intent === null ? '' : locale.t(catalogue.byId(current.intent.game).nameKey);

    derived columns = current.seats.length <= 2 ? 'grid-cols-2' : (current.seats.length === 4 ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-2 sm:grid-cols-4');

    <section class="flex flex-col gap-5" aria-label={ locale.t('play.title.lobby') }>
        <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
                <p class="label text-[12px] text-faint">{ locale.t(starting ? 'play.title.starting' : 'play.title.lobby') }</p>
                <h2 class="font-display text-[26px] font-semibold leading-none text-text">{ gameName }</h2>
            </div>
            <p class="flex items-center gap-2 text-[14px] text-muted" aria-live="polite">
                <Show when={ starting } fallback={ <Icon name="clock" size={ 15 } /> }>
                    { () => <span class="live-dot h-2.5 w-2.5 rounded-full" aria-hidden="true"></span> }
                </Show>
                <span>{ status }</span>
                <Show when={ starting }>
                    { () => <span class="tally font-display text-[28px] font-semibold leading-none text-live">{ locale.n(current.countdown ?? 0) }</span> }
                </Show>
            </p>
        </div>

        <ul class={ [ 'grid gap-3', columns ].join(' ') } aria-label={ locale.t('create.seats') }>
            <For each={ current.seats } key={ (seat) => seat.index } let={ seat }>
                <li class="flex">
                    <div class="flex-1">
                        <SeatCard seat={ seat } me={ me } canInvite={ amHost || current.intent?.mode !== 'private' } onInvite={ () => props.onInvite() } />
                    </div>
                </li>
            </For>
        </ul>

        <Show when={ empty > 0 && amHost && !starting }>
            <Button variant="outline" block leading="bot" onClick={ () => lobby.fillWithBots() }>{ locale.t('play.lobby.fill') }</Button>
        </Show>

        <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
            <Button
                variant={ mine?.ready === true ? 'live' : 'primary' }
                size="lg"
                block
                leading={ mine?.ready === true ? 'check-circle' : 'zap' }
                disabled={ mine === null }
                onClick={ () => lobby.ready(!(mine?.ready === true)) }
            >
                { mine?.ready === true ? locale.t('play.lobby.readyTag') : locale.t('play.lobby.ready') }
            </Button>
            <div class="flex gap-2 sm:shrink-0">
                <Button variant="outline" size="lg" leading="copy" class="flex-1 sm:flex-none" onClick={ () => props.onCopyLink() }>{ locale.t('play.lobby.copyLink') }</Button>
                <Button variant="ghost" size="lg" leading="sign-out" class="flex-1 text-madder sm:flex-none" onClick={ () => props.onLeave() }>{ locale.t('play.lobby.leave') }</Button>
            </div>
        </div>
    </section>
}
