import { personById } from '../../data/mock/index.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import RollLog from './roll-log.component.azeroth';

export function durationText(ms: number, plural: (key: 'common.minutes' | 'common.seconds', count: number) => string): string
{
    const totalSeconds = Math.max(0, Math.round(ms / 1000));
    const minutes = Math.floor(totalSeconds / 60);
    const seconds = totalSeconds % 60;
    return minutes === 0 ? plural('common.seconds', seconds) : `${ plural('common.minutes', minutes) } ${ plural('common.seconds', seconds) }`;
}

export default component ResultPanel(props: {
    onRematch: () => void;
    onAgain: () => void;
    onBack: () => void;
    onShare: (text: string) => void;
    onCopyCode: (code: string) => void;
})
{
    const locale = useLocale();
    const lobby = useLobby();
    const catalogue = useCatalogue();

    derived current = lobby.state();

    derived result = current.result;

    derived me = lobby.me();

    derived game = current.intent === null ? null : catalogue.byId(current.intent.game);

    derived gameName = game === null ? '' : locale.t(game.nameKey);

    derived partners = game !== null && catalogue.rules(game.id).partners;

    derived winners = ((): string[] =>
    {
        if (result === null)
        {
            return [];
        }
        if (!partners)
        {
            return result.winners;
        }
        const out = new Set(result.winners);
        for (const winner of result.winners)
        {
            const seat = current.seats.find((entry) => entry.playerId === winner);
            if (seat !== undefined)
            {
                const partner = current.seats[(seat.index + 2) % current.seats.length]?.playerId;
                if (partner !== null && partner !== undefined)
                {
                    out.add(partner);
                }
            }
        }
        return [...out];
    })();

    derived won = winners.includes(me);

    const nameOf = (id: string): string =>
    {
        if (id === me)
        {
            return locale.t('common.you');
        }
        if (id.startsWith('bot-'))
        {
            return locale.t('play.lobby.bot');
        }
        const person = personById(id);
        return person === undefined ? id : locale.text(person.name).split(' ')[0];
    };

    derived headline = ((): string =>
    {
        if (won)
        {
            const partner = winners.find((id) => id !== me);
            return partners && partner !== undefined ? locale.t('play.result.partnerWin', { name: nameOf(partner) }) : locale.t('play.result.win');
        }
        return locale.t('play.result.loss', { name: winners.map(nameOf).join(' · ') });
    })();

    derived duration = result === null ? '' : durationText(result.durationMs, (key, count) => locale.plural(key, count));

    derived standings = current.players
        .map((id) => ({ id, score: result?.scores[id] ?? 0, winner: winners.includes(id), person: personById(id) ?? null }))
        .sort((a, b) => Number(b.winner) - Number(a.winner) || b.score - a.score);

    derived dice = game !== null && catalogue.rules(game.id).fairness === 'dice';

    derived shareText = locale.t('play.result.shareText', { winner: winners.map(nameOf).join(' & '), game: gameName, duration });

    <section class="flex flex-col gap-5" aria-label={ locale.t('play.title.result') }>
        <div class={ [
            'relative overflow-hidden rounded-panel border p-5 text-center sm:p-8',
            won ? 'border-win/40 bg-win/5' : 'border-line bg-field'
        ].join(' ') }>
            <Show when={ won }>
                <span class="pointer-events-none absolute -top-16 start-1/2 h-48 w-48 -translate-x-1/2 rounded-full bg-win/25 blur-3xl" aria-hidden="true"></span>
            </Show>
            <span class={ [ 'relative mx-auto flex h-16 w-16 items-center justify-center rounded-full', won ? 'bg-win text-accent-ink' : 'bg-raised text-muted' ].join(' ') }>
                <Icon name={ won ? 'trophy' : 'versus' } size={ 30 } />
            </span>
            <p class="label relative mt-4 text-ui-xs text-faint">{ gameName }</p>
            <h2 class="relative mt-1 text-display-lg leading-none">{ headline }</h2>
            <p class="tally relative mt-3 text-ui-base text-muted">{ locale.t('play.result.duration', { duration }) }</p>
        </div>

        <ol class="flex flex-col gap-1 rounded-panel border border-line bg-field p-2" aria-label={ locale.t('play.title.result') }>
            <For each={ standings } key={ (row) => row.id } let={ row } index={ index }>
                <li class={ [ 'flex items-center gap-3 rounded-tile px-3 py-2', row.winner ? 'bg-win/10' : '' ].filter(Boolean).join(' ') }>
                    <span class="tally w-5 text-center text-ui-sm font-semibold text-faint">{ locale.n(index + 1) }</span>
                    <Show when={ !row.id.startsWith('bot-') } fallback={ <span class="flex h-10 w-10 items-center justify-center rounded-full bg-raised text-muted"><Icon name="bot" size={ 20 } /></span> }>
                        { () => <Avatar person={ row.person } size="md" /> }
                    </Show>
                    <span class="min-w-0 flex-1 truncate text-ui-md font-semibold text-text">{ nameOf(row.id) }</span>
                    <Show when={ row.winner }>{ () => <Icon name="trophy" size={ 16 } class="text-win" /> }</Show>
                    <span class="tally title text-ui-lg text-text">{ locale.n(row.score) }</span>
                </li>
            </For>
        </ol>

        <Show when={ dice }>
            { () => <RollLog rolls={ lobby.rolls() } verification={ lobby.verification() } onCopy={ props.onCopyCode } /> }
        </Show>

        <div class="grid gap-2 sm:grid-cols-2">
            <Button variant="primary" size="lg" block leading="refresh" onClick={ () => props.onRematch() }>{ locale.t('play.result.rematch') }</Button>
            <Button variant="secondary" size="lg" block leading="versus" onClick={ () => props.onAgain() }>
                { current.intent?.mode === 'private' ? locale.t('play.result.newTable') : locale.t('play.result.newOpponent') }
            </Button>
            <Button variant="outline" size="lg" block leading="share" onClick={ () => props.onShare(shareText) }>{ locale.t('play.result.share') }</Button>
            <Button variant="ghost" size="lg" block leading="games" onClick={ () => props.onBack() }>{ locale.t('play.result.back') }</Button>
        </div>
    </section>
}
