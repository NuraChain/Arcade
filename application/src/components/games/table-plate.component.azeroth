import { untrack, type Child } from 'azerothjs';

import Avatar from '../ui/avatar.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { runtime } from '../../lib/runtime.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useVoice } from '../../stores/voice.store.ts';
import type { PlateTone } from './plate-tag.ts';

export default component TablePlate(props: {
    who: string;
    name: string;
    turn?: boolean;
    remainingMs?: number;
    turnMs?: number;
    marker?: Child;
    facts?: Child;
    tag?: string;
    tone?: PlateTone;
    dim?: boolean;
    bubble?: string;
    below?: boolean;
    anchor?: 'start' | 'end' | 'centre';
    ink?: string;
    trail?: Child;
})
{
    const people = usePeople();
    const voice = useVoice();

    const STILL_OVER_MS = 10 * 60 * 1000;

    state minute = runtime().clock.now();

    let heardAt = untrack(() => runtime().clock.now());

    effect
    {
        void props.remainingMs;
        heardAt = runtime().clock.now();
    }

    mount
    {
        return runtime().clock.every(60_000, () => minute = runtime().clock.now());
    }

    derived clock = ((): { key: string; style: string; still: boolean }[] =>
    {
        if (props.turn !== true || props.remainingMs === undefined || props.turnMs === undefined || props.turnMs <= 0)
        {
            return [];
        }

        if (props.remainingMs <= STILL_OVER_MS)
        {
            return [{ key: `${ props.who }-${ props.remainingMs }`, style: `--from: ${ Math.min(1, props.remainingMs / props.turnMs).toFixed(4) }; --ms: ${ Math.round(props.remainingMs) }ms`, still: false }];
        }

        const left = Math.max(0, props.remainingMs - (minute - heardAt));

        return [{ key: `${ props.who }-still`, style: `--from: ${ Math.min(1, left / props.turnMs).toFixed(4) }`, still: true }];
    })();

    <div
        class="table-plate"
        data-turn={ props.turn === true ? 'true' : undefined }
        data-dim={ props.dim === true ? 'true' : undefined }
        data-bubble={ props.below === true ? 'below' : undefined }
        data-anchor={ props.anchor }
        style={ props.ink === undefined ? undefined : `--ink: ${ props.ink }` }
        aria-current={ props.turn === true ? 'true' : undefined }
    >
        <span class="table-plate-avatar" data-speaking={ voice.speaking(props.who) ? 'true' : undefined }>
            <Avatar person={ people.byHandle(props.who) } size="sm" ringOn="void" />
            <For each={ clock } key={ (one) => one.key } let={ one }>
                <svg class="table-plate-clock" viewBox="0 0 40 40" style={ one.style } data-still={ one.still ? 'true' : undefined } aria-hidden="true">
                    <circle cx="20" cy="20" r="18.5" pathLength="100"></circle>
                </svg>
            </For>
            <Show when={ props.marker !== undefined }>
                { () => <span class="table-plate-marker">{ props.marker }</span> }
            </Show>
            <Show when={ voice.mark(props.who) } let={ mark }>
                <span class="table-plate-voice" data-mark={ mark } aria-hidden="true">
                    <Icon name={ mark === 'muted' ? 'voice-off' : 'voice' } size={ 10 } />
                </span>
            </Show>
        </span>
        <span class="table-plate-text">
            <span class="table-plate-name" dir="auto">{ props.name }</span>
            <Show when={ props.facts !== undefined }>
                { () => <span class="table-plate-facts">{ props.facts }</span> }
            </Show>
        </span>
        <Show when={ props.tag !== undefined && props.tag !== '' }>
            { () => <span class="table-plate-tag" data-tone={ props.tone ?? 'neutral' }>{ props.tag }</span> }
        </Show>
        <Show when={ props.trail !== undefined }>
            { () => <span class="table-plate-trail">{ props.trail }</span> }
        </Show>
        <Show when={ props.bubble } let={ said }>
            <span class="table-plate-bubble" dir="auto" role="status">{ said }</span>
        </Show>
    </div>
}
