import { dataset, personById } from '../../data/mock/index.ts';
import type { Person } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useAccount } from '../../stores/account.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import SearchInput from '../ui/search-input.component.azeroth';

export default component InviteSheet(props: OverlayProps & { tableId: string })
{
    const locale = useLocale();
    const account = useAccount();
    const presence = usePresence();
    const lobby = useLobby();

    state query = '';

    derived candidates = ((): Person[] =>
    {
        const user = account.user();
        if (user === null)
        {
            return [];
        }
        const table = lobby.table();
        const taken = new Set((table?.chairs ?? [])
            .flatMap((chair) => [chair.who, chair.invited])
            .filter((handle): handle is string => handle !== undefined));
        const needle = query.trim().toLowerCase();
        const people = (dataset().friends[user.id] ?? [])
            .map((id) => personById(id))
            .filter((person): person is Person => person !== undefined && !taken.has(person.id))
            .filter((person) => needle === '' || locale.text(person.name).toLowerCase().includes(needle) || person.handle.includes(needle));
        const rank = (person: Person): number => (presence.isOnline(person.id) ? 0 : 1);
        return people.sort((a, b) => rank(a) - rank(b));
    })();

    <div class="flex max-h-[inherit] min-h-0 flex-col">
        <header class="flex items-center justify-between gap-3 px-5 pb-2 pt-4">
            <h2 class="title text-ui-xl text-text">{ locale.t('play.lobby.invite') }</h2>
            <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.close() } />
        </header>
        <div class="px-5 pb-3">
            <SearchInput value={ query } onInput={ (value) => query = value } placeholder={ locale.t('create.search') } label={ locale.t('create.search') } autofocus />
        </div>
        <Show
            when={ candidates.length > 0 }
            fallback={ <EmptyState icon="people" title={ locale.t('create.noFriends') } class="pb-8" /> }
        >
            <ul class="sheet-body flex flex-col gap-0.5 px-3 pb-4">
                <For each={ candidates } key={ (person) => person.id } let={ person }>
                    <li>
                        <button
                            type="button"
                            class="flex min-h-13 coarse:min-h-14 w-full cursor-pointer items-center gap-3 rounded-tile px-2 py-2 text-start transition-colors hover:bg-raised/70"
                            onClick={ () =>
                            {
                                void lobby.invite(props.tableId, person.id);
                                props.close(person.id);
                            } }
                        >
                            <Avatar person={ person } size="md" presence={ presence.dot(person.id) } />
                            <span class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-ui-base font-semibold text-text">{ locale.text(person.name) }</span>
                                <span class="truncate text-ui-xs text-muted">@{ person.handle }</span>
                            </span>
                            <span class="flex items-center gap-1 text-ui-sm font-semibold text-accent">
                                <Icon name="invite" size={ 15 } />
                                { locale.t('play.lobby.invite') }
                            </span>
                        </button>
                    </li>
                </For>
            </ul>
        </Show>
    </div>
}
