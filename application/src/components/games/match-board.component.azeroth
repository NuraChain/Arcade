import BoardCanvas from './board-canvas.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';
import type { BoardToken, BoardView } from '../../game/bridge.ts';

/**
 * The board, and the controls that are the real interface to it.
 *
 * Every move is takeable without ever pointing at the grid: the die is a button, each legal move is
 * a button that says what it would do, and the turn is a live region. That is what makes the game
 * playable with a keyboard and readable by a screen reader, and it is also what gives `npm run qa`
 * something to hit-test - a drawn board is invisible to both.
 *
 * Colour is never the only signal. Every seat carries its colour's initial beside the swatch, so a
 * player who cannot tell red from green still knows whose token is whose.
 */

const YARDS: Record<string, readonly [number, number]> = {
    red: [0, 0],
    green: [9, 0],
    yellow: [9, 9],
    blue: [0, 9]
};

/**
 * The four wells printed inside each home yard.
 *
 * `atlas.py` draws them at `corner + 3 +/- 0.95` cells - a POSITION on the grid, not a cell index -
 * and `centreOf` adds the half cell that turns an index into a centre. Passing 2 and 4 therefore
 * landed every yard token half a cell down and to the right of the circle it belongs in, which read
 * as "nearly right" and is the hardest kind of wrong to notice.
 */
const YARD_SPOTS: readonly (readonly [number, number])[] = [
    [1.55, 1.55],
    [3.45, 1.55],
    [1.55, 3.45],
    [3.45, 3.45]
];

const INITIAL: Record<string, string> = {
    red: 'R',
    green: 'G',
    yellow: 'Y',
    blue: 'B'
};

export default component MatchBoard(props: { match: MatchView })
{
    const locale = useLocale();
    const board = useBoard();
    const people = usePeople();

    derived game = props.match;

    derived mine = game.mine;

    derived over = game.finishedAt !== undefined;

    derived turnOf = game.players.find((player) => player.seat === game.turn);

    derived nameOf = ((): string =>
    {
        if (turnOf === undefined)
        {
            return '';
        }

        const person = people.byHandle(turnOf.who);

        return person === null ? turnOf.who : person.displayName;
    })();

    derived says = ((): string =>
    {
        if (over)
        {
            if (game.winner === undefined)
            {
                return locale.t('match.abandoned');
            }

            return game.winner === mine
                ? locale.t('match.won.you')
                : locale.t('match.won.them', { name: nameOf });
        }

        if (mine !== undefined && mine === game.turn)
        {
            return game.die === undefined
                ? locale.t('match.turn.yours')
                : locale.t('match.turn.rolled', { die: locale.n(game.die) });
        }

        return locale.t('match.turn.theirs', { name: nameOf });
    })();

    /**
     * Every token on the board, each with the grid square it stands on.
     *
     * Rendered per TOKEN rather than per cell: a token then keeps its element across a move, so the
     * CSS transition on its position animates it walking instead of one square blanking and another
     * lighting up. It is also sixteen nodes instead of two hundred and twenty-five.
     */
    derived tokens = ((): BoardToken[] =>
    {
        const placed: BoardToken[] = [];

        for (const player of game.players)
        {
            const corner = YARDS[player.colour];
            let parked = 0;

            for (const token of player.tokens)
            {
                const key = `${ player.seat }-${ token.piece }`;
                const label = INITIAL[player.colour];

                if (token.cell !== undefined)
                {
                    placed.push({
                        key,
                        colour: player.colour,
                        label,
                        at: token.at,
                        col: token.cell.col,
                        row: token.cell.row,
                        playable: player.seat === mine && game.moves.includes(token.piece)
                    });
                    continue;
                }

                if (token.at >= 0)
                {
                    continue;
                }

                const spot = YARD_SPOTS[parked];
                parked += 1;

                placed.push({
                    key,
                    colour: player.colour,
                    label,
                    at: token.at,
                    col: corner[0] + spot[0],
                    row: corner[1] + spot[1],
                    playable: player.seat === mine && game.moves.includes(token.piece)
                });
            }
        }

        return placed;
    })();

    /**
     * What the renderer is given, as one value.
     *
     * The die, the turn and the winner travel with the tokens rather than as three more props,
     * because the board reads all four together: it tumbles the die only when the number CHANGED,
     * walks a token only when its square changed, and celebrates only on the edge where nobody had
     * won and now somebody has. Four separate props would arrive in four separate effects and every
     * one of those edges would be a race.
     */
    derived view = ((): BoardView => ({
        tokens,
        die: game.die ?? null,
        turn: turnOf?.colour ?? null,
        yours: !over && mine !== undefined && mine === game.turn,
        winner: game.players.find((player) => player.seat === game.winner)?.colour ?? null
    }))();

    /**
     * Pointing at a token is a shortcut to the move list, never a second way to decide a move.
     * The server said which tokens are legal; a tap on anything else does nothing at all.
     */
    const pick = async (key: string): Promise<void> =>
    {
        const [seat, piece] = key.split('-').map(Number);

        if (seat !== mine || !board.moves().includes(piece))
        {
            return;
        }

        await board.move(piece);
    };

    const moveSays = (piece: number): string =>
    {
        const seat = game.players.find((player) => player.seat === game.turn);
        const token = seat?.tokens.find((candidate) => candidate.piece === piece);
        const label = locale.n(piece + 1);

        if (token === undefined || game.die === undefined)
        {
            return locale.t('match.move.step', { token: label, die: locale.n(game.die ?? 0) });
        }

        if (token.at < 0)
        {
            return locale.t('match.move.enter', { token: label });
        }

        return token.at + game.die >= 56
            ? locale.t('match.move.home', { token: label })
            : locale.t('match.move.step', { token: label, die: locale.n(game.die) });
    };

    /**
     * The height constraint belongs to the SIDE-BY-SIDE layout and nowhere else.
     *
     * `flex-1 min-h-0` in a column whose height is bounded gives this element a basis of zero and
     * lets its content run out of the bottom of its own box - so on a phone the seat list and the
     * resign button were drawn straight over the "Show chat" button underneath, and a tap meant to
     * give up opened the chat instead. Stacked, this is as tall as what is in it and the page
     * scrolls; in a row, the board and the controls share a fixed height and each scrolls itself.
     */
    <div class="flex flex-col gap-4 @3xl:min-h-0 @3xl:flex-1 @3xl:flex-row">
        <div class="board-stage">
            <BoardCanvas view={ view } onPick={ (key) => void pick(key) } />
        </div>

        <div class="board-controls flex min-w-0 flex-col gap-3 @3xl:w-[20rem]">
            <Panel pad="md" stack="sm">
                <p class="text-ui-lg font-semibold text-text" aria-live="polite">{ says }</p>

                <Show when={ !over && game.die !== undefined }>
                    { () =>
                        <p class="text-ui-sm text-muted">
                            <output class="tally text-ui-2xl font-bold text-text">{ locale.n(game.die!) }</output>
                        </p>
                    }
                </Show>

                <Show when={ board.canRoll() }>
                    { () =>
                        <Button
                            variant="primary"
                            size="lg"
                            leading="dice"
                            loading={ board.busy() }
                            onClick={ () => void board.roll() }
                        >
                            { locale.t('match.roll') }
                        </Button>
                    }
                </Show>

                <Show when={ !over && mine !== undefined && mine === game.turn && game.die !== undefined }>
                    { () =>
                        <div class="flex flex-col gap-1.5">
                            <p class="label text-ui-xs text-faint">{ locale.t('match.moves') }</p>
                            <ul class="flex flex-col gap-1.5">
                                <For each={ board.moves() } key={ (piece) => piece } let={ piece }>
                                    <li>
                                        <Button
                                            variant="secondary"
                                            class="w-full"
                                            disabled={ board.busy() }
                                            onClick={ () => void board.move(piece) }
                                        >
                                            { moveSays(piece) }
                                        </Button>
                                    </li>
                                </For>
                            </ul>
                        </div>
                    }
                </Show>
            </Panel>

            <Panel pad="md" stack="sm">
                <ul class="flex flex-col gap-2">
                    <For each={ game.players } key={ (player) => player.seat } let={ player }>
                        <li
                            class={ () => [
                                'flex items-center gap-2 rounded-tile px-2 py-1.5',
                                player.seat === game.turn ? 'bg-raised' : ''
                            ].filter(Boolean).join(' ') }
                            aria-current={ player.seat === game.turn ? 'true' : undefined }
                        >
                            <span
                                class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-ui-2xs font-bold text-white"
                                style={ `background: var(--ludo-${ player.colour })` }
                            >
                                { INITIAL[player.colour] }
                            </span>
                            <span class="min-w-0 flex-1 truncate text-ui-sm text-text">
                                { player.seat === mine ? locale.t('match.you') : (people.byHandle(player.who)?.displayName ?? player.who) }
                            </span>
                            <span class="tally shrink-0 text-ui-xs text-muted">
                                { locale.plural('match.tokens', player.home) }
                            </span>
                        </li>
                    </For>
                </ul>
            </Panel>

            <Show when={ !over && mine !== undefined }>
                { () =>
                    <Button variant="ghost" size="md" onClick={ () => void board.resign() }>
                        { locale.t('match.resign') }
                    </Button>
                }
            </Show>
        </div>
    </div>
}
