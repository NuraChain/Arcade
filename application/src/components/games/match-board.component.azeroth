import BoardCanvas from './board-canvas.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import TableResult from './table-result.component.azeroth';
import DieFace from './die-face.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import YardBadge from './yard-badge.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { SHORT_MAX, useDevice } from '../../stores/device.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import type { MatchView } from '../../api.ts';
import type { BoardView, LudoBeat } from '../../game/bridge.ts';
import { chairsOf, ludoOf } from '../../data/match.ts';
import { seatsFor } from './seats.ts';
import { CELL, MARGIN } from '../../game/layout.ts';
import { coachOf, outcomeOf } from '../../game/helpers/ludo.ts';

const STAGE = `--cell-cq: ${ (CELL * 100).toFixed(4) }cqi; --margin-cq: ${ (MARGIN * 100).toFixed(4) }cqi`;


export default component MatchBoard(props: { match: MatchView; starting?: boolean; onAgain?: () => void; speech?: Record<string, string>; turnMs?: number })
{
    const locale = useLocale();
    const board = useBoard();
    const device = useDevice();
    const people = usePeople();
    const settings = useSettings();

    derived game = props.match;

    derived help = settings.settings();

    derived ludo = ludoOf(game) ?? { kind: 'ludo' as const, die: undefined, moves: [], seats: [] };

    derived chairs = chairsOf(game);

    derived mine = game.mine;

    derived over = game.finishedAt !== undefined;

    derived turnOf = game.players.find((player) => player.seat === game.turn);

    derived turnSeat = ludo.seats.find((seat) => seat.seat === game.turn);

    const nameFor = (seat: number | undefined): string =>
    {
        const player = game.players.find((one) => one.seat === seat);

        if (player === undefined)
        {
            return '';
        }

        return people.byHandle(player.who)?.displayName ?? player.who;
    };

    derived nameOf = nameFor(turnOf?.seat);

    derived says = ((): string =>
    {
        if (over)
        {
            if (game.winner === undefined)
            {
                return locale.t('match.abandoned');
            }

            return game.winner === mine
                ? locale.t('match.won.you')
                : locale.t('match.won.them', { name: nameOf });
        }

        if (mine !== undefined && mine === game.turn)
        {
            return ludo.die === undefined
                ? locale.t('match.turn.yours')
                : locale.t('match.turn.rolled', { die: locale.n(ludo.die) });
        }

        return locale.t('match.turn.theirs', { name: nameOf });
    })();

    derived tokens = seatsFor(ludo, mine);

    const CORNER: Record<string, string> = {
        red: 'top-left',
        green: 'top-right',
        blue: 'bottom-left',
        yellow: 'bottom-right'
    };

    derived seatCards = chairs.map((chair) => ({
        player: chair.player,
        seat: chair.seat,
        corner: CORNER[chair.seat.colour] ?? 'top-left'
    }));

    derived sideways = device.landscape() && device.height() <= SHORT_MAX;

    derived hint = ((): string =>
    {
        if (over || mine === undefined || mine !== game.turn)
        {
            return '';
        }

        if (board.canRoll())
        {
            return locale.t('match.hint.roll');
        }

        return ludo.die !== undefined && board.moves().length > 0 ? locale.t(help.hintMoves ? 'match.hint.move' : 'helpers.ludo.hint.move') : '';
    })();

    derived tip = over ? null : coachOf(ludo, mine, game.turn, board.events().events.flatMap((event) => event.log.kind === 'ludo' ? event.log.moves : []));

    derived beats = ((): LudoBeat[] =>
    {
        const colourOf = (seat: number | undefined): string | null =>
            ludo.seats.find((one) => one.seat === seat)?.colour ?? null;

        return board.events().events.flatMap((event) => event.log.kind === 'ludo'
            ? event.log.moves.map((move) => ({ rev: event.rev, e: move.e, colour: colourOf(move.seat), die: move.die, why: move.why }))
            : []);
    })();

    derived view = ((): BoardView => ({
        tokens,
        die: ludo.die ?? null,
        turn: turnSeat?.colour ?? null,
        yours: !over && mine !== undefined && mine === game.turn,
        winner: ludo.seats.find((seat) => seat.seat === game.winner)?.colour ?? null,
        lit: help.hintMoves,
        beats
    }))();

    const pick = async (key: string): Promise<void> =>
    {
        const [seat, piece] = key.split('-').map(Number);

        if (seat !== mine || !board.moves().includes(piece))
        {
            return;
        }

        await board.move(piece);
    };

    const moveSays = (piece: number): string =>
    {
        const token = locale.n(piece + 1);
        const outcome = mine === undefined ? null : outcomeOf(ludo, mine, piece);

        if (outcome?.kind === 'enter')
        {
            return locale.t('match.move.enter', { token });
        }

        if (help.hintOutcome && outcome?.kind === 'home')
        {
            return locale.t('match.move.home', { token });
        }

        if (help.hintOutcome && outcome?.kind === 'safe')
        {
            return locale.t('helpers.ludo.move.safe', { token });
        }

        if (help.hintOutcome && outcome?.kind === 'capture')
        {
            return locale.plural('helpers.ludo.move.capture', outcome.count, { token, name: nameFor(outcome.victim) });
        }

        return locale.t('match.move.step', { token, die: locale.n(ludo.die ?? 0) });
    };

    <div class="table-stage ludo-stage">
        <div class="table-grid ludo-grid">
            <div class="table-fit">
                <div class="ludo-frame">
                    <For each={ seatCards } key={ (entry) => entry.player.seat } let={ entry }>
                        <div class="contents">
                            <YardBadge
                                player={ entry.player }
                                seat={ entry.seat }
                                corner={ entry.corner }
                                mine={ mine }
                                active={ entry.player.seat === game.turn }
                                die={ entry.player.seat === game.turn ? ludo.die : undefined }
                                finished={ over }
                                bubble={ props.speech?.[entry.player.who] }
                                remainingMs={ game.remainingMs }
                                turnMs={ props.turnMs }
                            />
                        </div>
                    </For>

                    <div class="board-stage table-surface" style={ STAGE }>
                        <BoardCanvas game={ game.game } view={ view } onPick={ (key) => void pick(key) } />

                        <Show when={ board.canRoll() }>
                            { () =>
                                <button
                                    type="button"
                                    class="board-roll"
                                    aria-label={ locale.t('match.roll') }
                                    disabled={ board.busy() }
                                    onClick={ () => void board.roll() }
                                >
                                    <span class="board-roll-die" aria-hidden="true">
                                        <DieFace value={ 5 } size="fill" label={ locale.t('match.roll') } />
                                    </span>
                                </button>
                            }
                        </Show>
                    </div>
                </div>
            </div>

            <Show when={ !over }>
                { () =>
                    <section class="table-bar ludo-bar">
                        <div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1.5">
                            <div class="flex min-w-0 flex-[1_1_9rem] flex-col gap-0.5">
                                <p class="text-ui-base font-semibold text-white" aria-live="polite">{ says }</p>
                                <Show when={ hint !== '' }>
                                    { () => <p class="text-ui-xs text-muted">{ hint }</p> }
                                </Show>
                                <Show when={ sideways }>
                                    { () =>
                                        <p class="flex items-center gap-1.5 text-ui-xs text-gold">
                                            <Icon name="phone" size={ 14 } class="shrink-0" />
                                            <span>{ locale.t('match.upright') }</span>
                                        </p>
                                    }
                                </Show>
                            </div>
                            <TurnClock remainingMs={ game.remainingMs } over={ over } yours={ !over && mine !== undefined && mine === game.turn } />
                        </div>

                        <CoachLine tip={ tip } />

                        <Show when={ mine !== undefined && mine === game.turn && ludo.die !== undefined && board.moves().length > 0 }>
                            { () =>
                                <ul class="grid grid-cols-2 gap-2" aria-label={ locale.t('match.moves') }>
                                    <For each={ board.moves() } key={ (piece) => piece } let={ piece }>
                                        <li class="min-w-0">
                                            <Button
                                                variant="secondary"
                                                class="h-auto! min-h-10 w-full py-2 coarse:min-h-11"
                                                disabled={ board.busy() }
                                                onClick={ () => void board.move(piece) }
                                            >
                                                <span class="min-w-0 text-balance leading-snug">{ moveSays(piece) }</span>
                                            </Button>
                                        </li>
                                    </For>
                                </ul>
                            }
                        </Show>
                    </section>
                }
            </Show>
        </div>

        <Show when={ over }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } />
            }
        </Show>
    </div>
}
