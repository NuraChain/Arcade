import BoardCanvas from './board-canvas.component.azeroth';
import MatchResult from './match-result.component.azeroth';
import DieFace from './die-face.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import YardBadge from './yard-badge.component.azeroth';
import Button from '../ui/button.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';
import type { BoardView } from '../../game/bridge.ts';
import { chairsOf, ludoOf } from '../../data/match.ts';
import { seatsFor } from './seats.ts';
import { CELL, MARGIN } from '../../game/layout.ts';

const STAGE = `--cell-cq: ${ (CELL * 100).toFixed(4) }cqi; --margin-cq: ${ (MARGIN * 100).toFixed(4) }cqi`;

/**
 * The board, and the controls that are the real interface to it.
 *
 * Every move is takeable without ever pointing at the grid: the die is a button, each legal move is
 * a button that says what it would do, and the turn is a live region. That is what makes the game
 * playable with a keyboard and readable by a screen reader, and it is also what gives `npm run qa`
 * something to hit-test - a drawn board is invisible to both.
 *
 * Colour is never the only signal. Every seat carries its colour's initial beside the swatch, so a
 * player who cannot tell red from green still knows whose token is whose.
 *
 * **The board owns the column and the controls sit under it.** They used to share a row, which gave
 * the board whatever was left after a 20rem panel and a chat rail - 320px of board at 1280. A game
 * is the thing somebody is looking at, so it gets the width, and the roll button, the moves and the
 * clock go beneath it where they are still a thumb's reach away on a phone and a glance away on a
 * monitor.
 *
 * **The clock and the misses are both shown, and neither was before.** `matches.deadline_at` and
 * `match_players.timeouts` have been on the wire since the domain was written and no screen read
 * either - so a live turn ran out after thirty seconds with no warning, and a seat could be one
 * miss from ending with nobody at the table aware of it. A clock a player cannot see only ever
 * surprises them, and a rule that ends somebody's game silently is a rule they will believe was a
 * bug.
 */

export default component MatchBoard(props: { match: MatchView; starting?: boolean; onAgain?: () => void })
{
    const locale = useLocale();
    const board = useBoard();
    const people = usePeople();

    derived game = props.match;

    /**
     * The board, as the engine composed it for whoever is reading.
     *
     * Asked once and carried, rather than narrowed again in each of the seven places below. The
     * fallback is an empty ludo board rather than a branch: this component is what draws a ludo
     * match and `play.page` is where a game nobody can draw is decided, so a second "we cannot
     * render this" screen here would be a state that exists twice and is reachable from neither.
     */
    derived ludo = ludoOf(game) ?? { kind: 'ludo' as const, die: undefined, moves: [], seats: [] };

    derived chairs = chairsOf(game);

    derived mine = game.mine;

    derived over = game.finishedAt !== undefined;

    derived turnOf = game.players.find((player) => player.seat === game.turn);

    derived turnSeat = ludo.seats.find((seat) => seat.seat === game.turn);

    derived nameOf = ((): string =>
    {
        if (turnOf === undefined)
        {
            return '';
        }

        const person = people.byHandle(turnOf.who);

        return person === null ? turnOf.who : person.displayName;
    })();

    derived says = ((): string =>
    {
        if (over)
        {
            if (game.winner === undefined)
            {
                return locale.t('match.abandoned');
            }

            return game.winner === mine
                ? locale.t('match.won.you')
                : locale.t('match.won.them', { name: nameOf });
        }

        if (mine !== undefined && mine === game.turn)
        {
            return ludo.die === undefined
                ? locale.t('match.turn.yours')
                : locale.t('match.turn.rolled', { die: locale.n(ludo.die) });
        }

        return locale.t('match.turn.theirs', { name: nameOf });
    })();

    derived tokens = seatsFor(ludo, mine);

    const CORNER: Record<string, string> = {
        red: 'top-left',
        green: 'top-right',
        blue: 'bottom-left',
        yellow: 'bottom-right'
    };

    /**
     * Two players sit opposite, which is where the engine seats them - twenty-six squares apart, so
     * neither starts a walk behind the other. With no card in the other two corners the board looks
     * lopsided, so a two-player table puts its cards on one diagonal and leaves the rest empty
     * rather than inventing seats to fill them.
     */
    derived seatCards = chairs.map((chair) => ({
        player: chair.player,
        seat: chair.seat,
        corner: CORNER[chair.seat.colour] ?? 'top-left'
    }));

    derived hint = ((): string =>
    {
        if (over || mine === undefined || mine !== game.turn)
        {
            return '';
        }

        if (board.canRoll())
        {
            return locale.t('match.hint.roll');
        }

        return ludo.die !== undefined && board.moves().length > 0 ? locale.t('match.hint.move') : '';
    })();


    /**
     * What the renderer is given, as one value.
     *
     * The die, the turn and the winner travel with the tokens rather than as three more props,
     * because the board reads all four together: it tumbles the die only when the number CHANGED,
     * walks a token only when its square changed, and celebrates only on the edge where nobody had
     * won and now somebody has. Four separate props would arrive in four separate effects and every
     * one of those edges would be a race.
     */
    derived view = ((): BoardView => ({
        tokens,
        die: ludo.die ?? null,
        turn: turnSeat?.colour ?? null,
        yours: !over && mine !== undefined && mine === game.turn,
        winner: ludo.seats.find((seat) => seat.seat === game.winner)?.colour ?? null
    }))();

    /**
     * Pointing at a token is a shortcut to the move list, never a second way to decide a move.
     * The server said which tokens are legal; a tap on anything else does nothing at all.
     */
    const pick = async (key: string): Promise<void> =>
    {
        const [seat, piece] = key.split('-').map(Number);

        if (seat !== mine || !board.moves().includes(piece))
        {
            return;
        }

        await board.move(piece);
    };

    const moveSays = (piece: number): string =>
    {
        const token = turnSeat?.tokens.find((candidate) => candidate.piece === piece);
        const label = locale.n(piece + 1);

        if (token === undefined || ludo.die === undefined)
        {
            return locale.t('match.move.step', { token: label, die: locale.n(ludo.die ?? 0) });
        }

        if (token.at < 0)
        {
            return locale.t('match.move.enter', { token: label });
        }

        return token.at + ludo.die >= 56
            ? locale.t('match.move.home', { token: label })
            : locale.t('match.move.step', { token: label, die: locale.n(ludo.die) });
    };

    <div class="@container my-auto flex min-w-0 flex-col gap-4">
        <div class="ludo-table">
            <div class="board-stage" style={ STAGE }>
                <BoardCanvas game={ game.game } view={ view } onPick={ (key) => void pick(key) } />

                <For each={ seatCards } key={ (entry) => entry.player.seat } let={ entry }>
                    <div class="contents">
                        <YardBadge
                            player={ entry.player }
                            seat={ entry.seat }
                            corner={ entry.corner }
                            mine={ mine }
                            active={ entry.player.seat === game.turn }
                            die={ entry.player.seat === game.turn ? ludo.die : undefined }
                            finished={ over }
                        />
                    </div>
                </For>

                <Show when={ board.canRoll() }>
                    { () =>
                        <button
                            type="button"
                            class="board-roll"
                            aria-label={ locale.t('match.roll') }
                            disabled={ board.busy() }
                            onClick={ () => void board.roll() }
                        >
                            <span class="board-roll-die" aria-hidden="true">
                                <DieFace value={ 5 } size="fill" label={ locale.t('match.roll') } />
                            </span>
                        </button>
                    }
                </Show>
            </div>

            <Show when={ !over }>
                { () =>
                    <div class="table-actions">
                        <div class="flex min-w-0 flex-wrap items-center justify-between gap-x-3 gap-y-1.5">
                            <div class="flex min-w-0 flex-1 basis-[9rem] flex-col gap-0.5">
                                <p class="text-ui-base font-semibold text-white" aria-live="polite">{ says }</p>
                                <Show when={ hint !== '' }>
                                    { () => <p class="text-ui-xs text-muted">{ hint }</p> }
                                </Show>
                            </div>
                            <TurnClock deadline={ game.deadline } over={ over } />
                        </div>

                        <Show when={ mine !== undefined && mine === game.turn && ludo.die !== undefined && board.moves().length > 0 }>
                            { () =>
                                <ul class="grid grid-cols-2 gap-2" aria-label={ locale.t('match.moves') }>
                                    <For each={ board.moves() } key={ (piece) => piece } let={ piece }>
                                        <li class="min-w-0">
                                            <Button
                                                variant="secondary"
                                                class="w-full"
                                                disabled={ board.busy() }
                                                onClick={ () => void board.move(piece) }
                                            >
                                                <span class="truncate">{ moveSays(piece) }</span>
                                            </Button>
                                        </li>
                                    </For>
                                </ul>
                            }
                        </Show>
                    </div>
                }
            </Show>
        </div>

        <Show when={ over }>
            { () =>
                <div class="mx-auto flex w-full min-w-0 max-w-[34rem] flex-col gap-3">
                    <MatchResult
                        match={ game }
                        mine={ mine }
                        busy={ props.starting === true }
                        onAgain={ props.onAgain }
                    />
                </div>
            }
        </Show>
    </div>
}
