import { Link, type Child } from 'azerothjs';

import Rail from '../ui/rail.component.azeroth';
import GameIcon from './game-icon.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import type { GameId } from '../../data/games.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { TableSummary } from '../../api.ts';
import { copyText } from '../../lib/clipboard.ts';

export default component PlayHeader(props: { table: TableSummary; others: TableSummary[]; tools?: Child })
{
    const locale = useLocale();

    const copyCode = (): void =>
    {
        void copyText(props.table.code, 'play.dock.codeCopied', { dedupe: 'table-code' });
    };
    const catalogue = useCatalogue();

    derived nameOf = (game: string): string => locale.t(catalogue.byId(game as GameId).nameKey);

    derived waiting = props.others.filter((table) => table.yourTurn === true).length;

    <header class="@container min-w-0">
        <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-2">
            <div class="flex min-w-0 flex-1 items-center gap-3">
                <IconButton icon="back" label={ locale.t('app.nav.back') } to="/app/games" flip class="shrink-0" />
                <GameIcon game={ props.table.game as GameId } class="h-10 w-10 shrink-0" />
                <div class="min-w-0 flex-1">
                    <h1 class="truncate text-ui-xl font-bold text-text">{ nameOf(props.table.game) }</h1>
                    <p class="flex min-w-0 items-center gap-2 text-ui-xs text-muted">
                        <span class="shrink-0">{ locale.plural('common.players', props.table.seats) }</span>
                        <span class="h-1 w-1 shrink-0 rounded-full bg-faint" aria-hidden="true"></span>
                        <span class="truncate">{ locale.t(props.table.mode === 'turns' ? 'games.mode.turns' : 'games.mode.live') }</span>
                        <Show when={ props.table.voice }>
                            { () =>
                                <span class="flex shrink-0 items-center gap-1 text-accent">
                                    <Icon name="voice" size={ 12 } />
                                    <span class="hidden @md:inline">{ locale.t('voice.tableHas') }</span>
                                    <span class="sr-only @md:hidden">{ locale.t('voice.tableHas') }</span>
                                </span>
                            }
                        </Show>
                        <span class="hidden h-1 w-1 shrink-0 rounded-full bg-faint @2xl:block" aria-hidden="true"></span>
                        <button
                            type="button"
                            class="tally -my-3 hidden min-h-11 shrink-0 @2xl:flex cursor-pointer items-center gap-1 rounded-control px-1 font-semibold uppercase tracking-wide text-muted transition-colors hover:text-text"
                            aria-label={ locale.t('play.dock.copy', { code: props.table.code.toUpperCase() }) }
                            onClick={ () => copyCode() }
                        >
                            { props.table.code }
                            <Icon name="copy" size={ 12 } class="text-faint" />
                        </button>
                    </p>
                </div>
            </div>

            <Show when={ props.tools !== undefined }>
                { () => <div class="order-2 shrink-0 @2xl:order-3">{ props.tools }</div> }
            </Show>

            <Show when={ props.others.length > 0 }>
                { () =>
                    <nav class="play-others order-3 flex min-w-0 basis-full items-center @2xl:order-2 @2xl:max-w-[45%] @2xl:shrink-0 @2xl:basis-auto" aria-label={ locale.t('play.tables') }>
                        <p class="sr-only">
                            { locale.t('play.tables') }
                            <Show when={ waiting > 0 }>
                                { () => <span>, <span class="tally">{ locale.n(waiting) }</span> { locale.plural('play.tables.waiting', waiting) }</span> }
                            </Show>
                        </p>
                        <Rail class="-mx-1 max-w-full" inner="px-1">
                        <ul class="flex shrink-0 gap-2">
                            <For each={ props.others } key={ (table) => table.id } let={ table }>
                                <li class="shrink-0">
                                    <Link
                                        to={ `/app/play/${ table.id }` }
                                        class={ () => [
                                            'flex h-11 items-center gap-2 rounded-full border ps-1.5 pe-3 text-ui-sm font-semibold transition-colors',
                                            table.yourTurn === true
                                                ? 'border-live/50 bg-live/10 text-text hover:bg-live/15'
                                                : 'border-line bg-field text-muted hover:border-line-strong hover:text-text'
                                        ].join(' ') }
                                    >
                                        <GameIcon game={ table.game as GameId } class="h-8 w-8" />
                                        <span class="max-w-[9rem] truncate">{ nameOf(table.game) }</span>
                                        <span class="shrink-0 text-ui-xs font-normal uppercase tracking-wide opacity-70">{ table.code }</span>
                                        <Show when={ table.yourTurn === true }>
                                            { () => <Badge dot text={ locale.t('card.yourTurn') } tone="live" /> }
                                        </Show>
                                    </Link>
                                </li>
                            </For>
                        </ul>
                        </Rail>
                    </nav>
                }
            </Show>
        </div>
    </header>
}
