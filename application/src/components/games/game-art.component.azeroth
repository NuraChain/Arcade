import type { GameId } from '../../data/games.ts';
import { GAME_HUE, gameArt, gameArtSet } from './art.ts';

export default component GameArt(props: {
    game: GameId;
    alt: string;
    ratio?: 'card' | 'wide' | 'square';
    sizes?: string;
    priority?: boolean;
    class?: string;
})
{
    state failed = false;

    derived ratio = props.ratio === 'wide' ? 'aspect-[16/9]' : (props.ratio === 'square' ? 'aspect-square' : 'aspect-[3/2]');

    <div
        class={ [ 'relative w-full overflow-hidden bg-void', ratio, props.class ?? '' ].filter(Boolean).join(' ') }
        style={ `--hue: ${ GAME_HUE[props.game] }` }
    >
        <div
            class="absolute inset-0"
            style="background: radial-gradient(120% 90% at 30% 15%, hsl(var(--hue) 42% 28% / 0.95), var(--void) 72%)"
            aria-hidden="true"
        ></div>
        <Show when={ !failed }>
            <img
                src={ gameArt(props.game, 640) }
                srcset={ gameArtSet(props.game) }
                sizes={ props.sizes ?? '(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw' }
                alt={ props.alt }
                class="relative h-full w-full object-cover"
                loading={ props.priority === true ? 'eager' : 'lazy' }
                decoding="async"
                onError={ () => failed = true }
            />
        </Show>
    </div>
}
