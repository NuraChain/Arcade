import type { GameRecord } from '../../data/mock/types.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component RecordStrip(props: { record: GameRecord; class?: string })
{
    const locale = useLocale();

    derived rate = props.record.played === 0 ? 0 : Math.round((props.record.won / props.record.played) * 100);

    derived cells = [
        { id: 'played', label: locale.t('game.record.played'), value: locale.n(props.record.played) },
        { id: 'won', label: locale.t('game.record.won'), value: locale.n(props.record.won) },
        { id: 'rate', label: locale.t('game.record.rate'), value: locale.n(rate / 100, { style: 'percent' }) },
        { id: 'streak', label: locale.t('game.record.streak'), value: locale.n(props.record.streak) }
    ];

    <dl class={ [ 'grid grid-cols-4 gap-2', props.class ?? '' ].filter(Boolean).join(' ') }>
        <For each={ cells } key={ (cell) => cell.id } let={ cell }>
            <div class="flex flex-col items-center gap-0.5 rounded-tile bg-raised/60 px-2 py-3 text-center">
                <dt class="label text-[11px] text-faint">{ cell.label }</dt>
                <dd class="tally font-display text-[22px] font-semibold text-text">{ cell.value }</dd>
            </div>
        </For>
    </dl>
}
