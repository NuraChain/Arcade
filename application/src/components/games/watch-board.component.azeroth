import { Dynamic, untrack } from 'azerothjs';

import Panel from '../ui/panel.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { BOARDS, drawable, type BoardComponent } from './boards.ts';
import type { MatchView, MatchWatch } from '../../api.ts';

export default component WatchBoard(props: { watch: MatchWatch })
{
    const locale = useLocale();

    let Board: BoardComponent | null = null;

    state drawn = '';

    derived game = props.watch.match.game;

    effect
    {
        const want = game;
        const load = BOARDS[want];

        if (load === undefined || want === untrack(() => drawn))
        {
            return;
        }

        void load().then((module) =>
        {
            if (untrack(() => props.watch.match.game) !== want)
            {
                return;
            }

            Board = module.default;
            drawn = want;
        }).catch(() => undefined);
    }

    const MINUTE = 60;

    derived behindSays = props.watch.delay < 90
        ? locale.plural('watch.behind.seconds', props.watch.delay)
        : locale.plural('watch.behind', Math.round(props.watch.delay / MINUTE));

    derived quietSays = locale.plural('watch.quiet', Math.round(props.watch.behind / MINUTE));

    const boardProps = (): { match: MatchView } => ({ match: props.watch.match });

    <div class="flex flex-col gap-4">
        <Panel pad="md" stack="sm" tone={ props.watch.live ? 'accent' : 'field' }>
            <p class="flex items-center gap-2 text-ui-sm font-semibold text-text">
                <Icon name={ props.watch.live ? 'activity' : 'trophy' } size={ 16 } class="shrink-0 text-accent" />
                { locale.t(props.watch.live ? 'watch.title' : 'watch.finished') }
            </p>
            <Show when={ props.watch.live }>
                { () => <p class="text-ui-xs text-muted">{ behindSays }</p> }
            </Show>
            <Show when={ props.watch.live && props.watch.behind > props.watch.delay * 2 }>
                { () => <p class="text-ui-xs text-muted">{ quietSays }</p> }
            </Show>
            <p class="text-ui-xs text-faint">{ locale.t('watch.why') }</p>
        </Panel>

        <Show when={ drawn !== '' && drawn === game }>
            { () => <Dynamic component={ Board! } props={ boardProps } /> }
        </Show>

        <Show when={ !drawable(game) }>
            { () =>
                <EmptyState
                    icon="dice"
                    title={ locale.t('match.cannotDraw') }
                    lead={ locale.t('match.cannotDrawLead') }
                    action={ locale.t('match.cannotDrawAction') }
                    onAction={ () => window.location.reload() }
                    class="py-12"
                />
            }
        </Show>

        <Show when={ drawable(game) && drawn !== game }>
            { () => <Skeleton class="aspect-[16/10] w-full rounded-hero" /> }
        </Show>
    </div>
}
