import DieFace from './die-face.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import { INITIAL } from './seats.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { LudoSeat, MatchPlayer } from '../../data/match.ts';

/** Four tokens, so four pips. The board cannot hold a fifth and neither can this. */
const PIPS = [0, 1, 2, 3];

/** Three misses in a row ends a seat. The last one is the one that reads as a warning. */
const MISSES_ALLOWED = 3;

/**
 * One player, beside their own corner of the board.
 *
 * This replaces a list of names in a panel, and the difference is that a list is something you read
 * while this is something you GLANCE at. Whose turn it is, how far they have got and what they just
 * rolled are the three things a player looks up twenty times a game, and putting them in the colour
 * they are playing means the lookup is a glance at a corner rather than a scan down a column.
 *
 * **The die lives here, in whoever's turn it is.** The canvas tumbles one over the middle of the
 * board when a roll lands and then fades it, which is a flourish; this is the one that stays until
 * the move is made. A player who looked away for a second should not have to roll again to find out
 * what they rolled.
 *
 * Colour is never the only signal. The initial is on the swatch, the name is written out, and the
 * turn is an outline AND a word - so a player who cannot tell red from green loses nothing.
 *
 * It takes BOTH halves of a chair, because that is what the wire now sends and what this card is:
 * `player` is who is sitting there and how their match went, which is true of every game, and
 * `seat` is their colour and their four tokens, which the ludo engine composed for this viewer. One
 * prop carrying both would be the flat shape the server just stopped sending.
 */
export default component PlayerCard(props: {
    player: MatchPlayer;
    seat: LudoSeat;
    mine?: number;
    active: boolean;
    die?: number;
    finished: boolean;
})
{
    const locale = useLocale();
    const people = usePeople();

    derived person = people.byHandle(props.player.who);

    derived mine = props.player.seat === props.mine;

    derived name = mine
        ? locale.t('match.you')
        : (person === null ? props.player.who : locale.text(person.displayName));

    /**
     * Two things this sentence used to be unable to say, both because it fell through to a generic
     * word while holding the information to be specific.
     *
     * **Whose card it is.** `card.turn` is "Their go", and it was printed on YOUR card on YOUR
     * turn - the card already knows, because the same comparison writes "You" in the name above it.
     * Persian was worse: `نوبت اوست` says *his or hers* in as many words, about the reader.
     *
     * **That the game is over.** A seat whose `result` is `lost` fell past every branch to
     * "Waiting", so a finished board left three cards saying they were waiting for a turn that is
     * never coming - beside a result panel on the same screen calling them Lost.
     */
    derived says = ((): string =>
    {
        if (props.player.result === 'won')
        {
            return locale.t('card.won');
        }

        if (props.seat.out || props.player.result === 'abandoned')
        {
            return locale.t('card.out');
        }

        if (props.player.result === 'lost')
        {
            return locale.t('card.lost');
        }

        if (props.player.timeouts > 0)
        {
            return props.player.timeouts >= MISSES_ALLOWED - 1
                ? locale.t('card.lastChance')
                : locale.plural('match.missed', props.player.timeouts);
        }

        if (!props.active || props.finished)
        {
            return locale.t('card.waiting');
        }

        return mine ? locale.t('card.yourTurn') : locale.t('card.turn');
    })();

    <div
        class={ () => [
            'ludo-seat',
            props.active && !props.finished ? 'is-turn' : '',
            props.seat.out ? 'opacity-60' : ''
        ].filter(Boolean).join(' ') }
        style={ `--ink: var(--ludo-${ props.seat.colour })` }
        aria-current={ props.active && !props.finished ? 'true' : undefined }
    >
        <span class="relative shrink-0">
            <Avatar person={ person } size="md" ringOn="void" />
            <span
                class="absolute -bottom-1 -end-1 flex h-4 w-4 items-center justify-center rounded-full text-ui-2xs font-bold leading-none text-white ring-2 ring-void"
                style={ `background: var(--ludo-${ props.seat.colour })` }
                aria-hidden="true"
            >
                { INITIAL[props.seat.colour] }
            </span>
        </span>

        <span class="flex min-w-0 flex-1 flex-col gap-1">
            <span class="flex min-w-0 flex-col leading-tight">
                <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ name }</span>
                <span
                    class={ () => [
                        'truncate text-ui-2xs',
                        props.player.timeouts >= MISSES_ALLOWED - 1 && !props.finished ? 'text-danger' : 'text-muted'
                    ].join(' ') }
                >
                    { says }
                </span>
            </span>

            <span class="flex items-center gap-1.5" role="img" aria-label={ locale.plural('match.tokens', props.seat.home) }>
                <For each={ PIPS } key={ (pip) => pip } let={ pip }>
                    <span
                        class="ludo-pip"
                        data-home={ pip < props.seat.home ? 'true' : 'false' }
                        aria-hidden="true"
                    ></span>
                </For>
            </span>
        </span>

        <Show when={ props.die !== undefined && props.active && !props.finished }>
            { () => <DieFace value={ props.die! } size="md" label={ locale.t('match.turn.rolled', { die: locale.n(props.die!) }) } /> }
        </Show>
    </div>
}
