import { Link } from 'azerothjs';

import type { Game, GameId } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Badge from '../ui/badge.component.azeroth';
import Button from '../ui/button.component.azeroth';
import GameArt from './game-art.component.azeroth';
import SeatCount from './seat-count.component.azeroth';

export default component GameCard(props: {
    game: Game;
    compact?: boolean;
    detailed?: boolean;
    class?: string;
    onQuickPlay: (game: GameId) => void;
})
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    derived name = locale.t(props.game.nameKey);

    derived stats = catalogue.stats(props.game.id);

    derived href = `/app/games/${ props.game.slug }`;

    derived known = !catalogue.loading();

    derived playable = known && catalogue.playable(props.game.id);

    derived live = playable && stats.playersOnline > 0;

    <article class={ `group relative flex flex-col overflow-hidden rounded-panel border border-line bg-field transition duration-200 ease-[var(--ease-ui)] hover:-translate-y-0.5 hover:border-line-strong hover:shadow-2 ${ props.class ?? '' }` }>
        <Link to={ href } class="relative block" aria-label={ name } prefetch="hover">
            <GameArt game={ props.game.id } ratio={ props.compact === true ? 'wide' : 'card' } class="transition-transform duration-500 ease-[var(--ease-reveal)] group-hover:scale-[1.03]" />
            <span class="absolute start-2.5 top-2.5 flex rounded-full bg-void/70 backdrop-blur-md">
                <Show when={ live }>
                    <Badge dot text={ locale.t('games.livePill') } tone="live" />
                </Show>
                <Show when={ known && !playable }>
                    <Badge dot text={ locale.t('games.soon') } tone="neutral" />
                </Show>
            </span>
        </Link>
        <div class={ [ 'flex flex-1 flex-col gap-1', props.compact === true ? 'p-3' : 'p-3.5' ].join(' ') }>
            <Link to={ href } data-inline class="title truncate text-ui-md text-text hover:text-accent">{ name }</Link>
            <Show when={ props.detailed === true }>
                <p class="line-clamp-2 text-ui-sm text-muted">{ locale.t(props.game.blurbKey) }</p>
            </Show>
            <SeatCount game={ props.game } class="text-ui-xs text-muted" />
            <p class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-ui-xs text-muted">
                <span class="flex items-center gap-1.5">
                    <Icon name="people" size={ 13 } class="shrink-0" />
                    <span><span class="tally">{ locale.n(stats.playersOnline) }</span> { locale.plural('games.live.playingLabel', stats.playersOnline) }</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <Icon name="seat" size={ 13 } class="shrink-0" />
                    <span><span class="tally">{ locale.n(stats.tablesOpen) }</span> { locale.plural('games.live.tablesLabel', stats.tablesOpen) }</span>
                </span>
            </p>
            <div class="mt-auto pt-3">
                <Show
                    when={ known }
                    fallback={ <span class="block h-10 w-full animate-pulse rounded-control bg-raised motion-reduce:animate-none coarse:h-11" aria-hidden="true"></span> }
                >
                    { () =>
                        <Show
                            when={ playable }
                            fallback={ <Button variant="outline" size="md" block disabled>{ locale.t('games.soon') }</Button> }
                        >
                            { () => <Button variant="primary" size="md" block icon="forward" onClick={ () => props.onQuickPlay(props.game.id) }>{ locale.t('games.play') }</Button> }
                        </Show>
                    }
                </Show>
            </div>
        </div>
    </article>
}
