import { untrack } from 'azerothjs';

import { isLineKey } from '../../lib/lines.ts';
import { attachStick } from '../../lib/stick.ts';
import { sendBlockOf } from '../../lib/seal-state.ts';
import { haptic } from '../../lib/haptics.ts';
import { sealSentenceOf } from '../chat/chat-title.ts';
import SealNotice from '../chat/seal-notice.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useDevices } from '../../stores/devices.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSeal } from '../../stores/seal.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import TextArea from '../ui/text-area.component.azeroth';

/**
 * The table's conversation, which is a CONVERSATION.
 *
 * It used to be a private list of invented lines the lobby store typed to itself. It is now the
 * thread the table owns, read and written through the chat domain like every other one - so the
 * same membership rules, the same watermark, the same delivery, and the same sealing when that
 * lands. A second message system beside the first would have been a second set of all of those.
 */
export default component TableChat(props: { conversationId: string; onClose?: () => void; class?: string })
{
    const locale = useLocale();
    const lobby = useLobby();
    const chat = useChat();
    const people = usePeople();
    const seal = useSeal();
    const devices = useDevices();
    const account = useAccount();
    const toasts = useToasts();

    state draft = '';

    /**
     * Whether the reader was at the bottom BEFORE whatever just arrived.
     *
     * Read through `untrack` below, deliberately: the effect must decide the answer without making
     * itself run again when the answer changes.
     */
    state near = true;

    let list: HTMLElement | null = null;

    mount
    {
        chat.openThread(props.conversationId);
        const unstick = list === null ? null : attachStick(list, (value) => near = value);
        return () =>
        {
            unstick?.();
            chat.closeThread();
        };
    }

    derived messages = chat.messages();

    /**
     * Follow the conversation, unless somebody is reading back through it.
     *
     * This used to read `chat.messages()` for the subscription and then scroll unconditionally, so
     * every change yanked the panel to the bottom - including a revalidation, which is what happens
     * on every realtime nudge. Scrolling up to re-read a line while a table is talking was
     * impossible: the list snapped back before the next word was out.
     *
     * The guard is the chat page's, from the same module, because it is the same rule and a second
     * copy of "near enough to the bottom" would be a second answer to it.
     */
    effect
    {
        const tail = messages[messages.length - 1]?.id ?? '';

        if (list !== null && untrack(() => near) && tail !== '')
        {
            list.scrollTop = list.scrollHeight;
        }
    }

    /**
     * What stands in the way of sending, asked the same way the chat page asks it.
     *
     * This panel used to ask nothing. The composer was always enabled, `send` cleared the box
     * before the post resolved, and a browser with no keys got a rejected promise nobody was
     * listening to - so the message vanished, the box emptied as though it had gone, and the only
     * record was a console error. Clearing on the way in is what made it a lie rather than a
     * failure: an empty box is how this product says a message was sent.
     */
    derived stop = sendBlockOf({
        sealability: seal.sealability(),
        readiness: devices.readiness(),
        known: devices.known(),
        isWallet: account.isWallet(),
        pending: seal.loading()
    });

    const send = (): void =>
    {
        const text = draft.trim();
        if (text === '' || stop !== null)
        {
            return;
        }
        draft = '';
        void chat.send(props.conversationId, text).then(() => haptic('tick')).catch((error) =>
        {
            if (draft === '')
            {
                draft = text;
            }
            toasts.show({ kind: 'error', text: sealSentenceOf(error, locale.t), dedupe: 'table-chat-send' });
        });
    };

    const said = (message: { text: { en: string; fa: string } | string; line?: { key: string; params: Record<string, string> } }): string =>
    {
        const line = message.line;
        if (line === undefined)
        {
            return locale.text(message.text);
        }
        return isLineKey(line.key) ? locale.t(line.key, line.params) : '';
    };

    <section class={ () => [ 'flex min-h-0 flex-col bg-field', props.class ?? '' ].filter(Boolean).join(' ') } aria-label={ locale.t('play.table.chat') }>
        <header class="flex shrink-0 items-center justify-between gap-2 border-b border-line px-4 py-3">
            <h2 class="flex min-w-0 items-center gap-2 text-ui-base font-semibold text-text">
                <Icon name="chats" size={ 16 } class="shrink-0 text-muted" />
                <span class="truncate">{ locale.t('play.table.chat') }</span>
            </h2>
            <Show when={ props.onClose !== undefined }>
                { () => <IconButton icon="panel-close" label={ locale.t('play.table.chatHide') } variant="ghost" size="sm" flip onClick={ () => props.onClose?.() } /> }
            </Show>
        </header>
        <ul ref={ (element) => list = element } class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto px-4 py-3" aria-live="polite">
            <Show when={ messages.length === 0 && !chat.threadLoading() }>
                { () =>
                    <li class="m-auto">
                        <EmptyState icon="chats" title={ locale.t('chat.empty') } lead={ locale.t('play.table.chatLead') } class="px-2 py-6" />
                    </li>
                }
            </Show>
            <For each={ messages } key={ (message) => message.id } let={ message }>
                <li class={ () => [
                    'flex',
                    message.kind === 'text'
                        ? (message.from === lobby.me() ? 'flex-row-reverse items-end gap-2' : 'items-end gap-2')
                        : 'justify-center'
                ].join(' ') }>
                    <Show
                        when={ message.kind === 'text' }
                        fallback={ <span class="rounded-full bg-raised/60 px-3 py-1 text-ui-2xs text-muted">{ said(message) }</span> }
                    >
                        { () =>
                            <>
                                <Avatar person={ people.byHandle(message.from) ?? null } size="xs" />
                                <span class={ () => [
                                    'max-w-[80%] rounded-tile px-3 py-2 text-ui-base leading-snug',
                                    message.from === lobby.me() ? 'bg-accent/15 text-text' : 'bg-raised text-text'
                                ].join(' ') } dir="auto">
                                    <Show when={ message.from !== lobby.me() }>
                                        { () => <span class="mb-0.5 block text-ui-2xs font-semibold text-muted">{ locale.text(people.byHandle(message.from)?.displayName ?? { en: message.from, fa: message.from }) }</span> }
                                    </Show>
                                    { said(message) }
                                </span>
                            </>
                        }
                    </Show>
                </li>
            </For>
        </ul>
        <Show when={ !seal.loading() && stop !== null }>
            { () =>
                <div class="shrink-0 border-t border-line px-3 pt-2">
                    <SealNotice stop={ stop } />
                </div>
            }
        </Show>
        <form
            class="flex shrink-0 items-end gap-2 border-t border-line px-3 py-3"
            onSubmit={ (event) =>
            {
                event.preventDefault();
                send();
            } }
        >
            <TextArea value={ draft } onInput={ (value) => draft = value } placeholder={ locale.t('play.table.say') } label={ locale.t('play.table.say') } enterkeyhint="send" maxlength={ 240 } disabled={ stop !== null } class="min-w-0 flex-1" onEnter={ send } />
            <IconButton icon="send" label={ locale.t('play.table.send') } variant="primary" flip disabled={ stop !== null || draft.trim() === '' } onClick={ send } />
        </form>
    </section>
}
