import { untrack } from 'azerothjs';
import Rail from '../ui/rail.component.azeroth';
import { attachStick } from '../../lib/stick.ts';
import { threadRows } from '../../lib/thread.ts';
import { sendBlockOf } from '../../lib/seal-state.ts';
import { haptic } from '../../lib/haptics.ts';
import { sealSentenceOf } from '../chat/chat-title.ts';
import SealNotice from '../chat/seal-notice.component.azeroth';
import QuietNote from '../chat/quiet-note.component.azeroth';
import DayDivider from '../chat/day-divider.component.azeroth';
import MessageBubble from '../chat/message-bubble.component.azeroth';
import Composer from '../chat/composer.component.azeroth';
import ConfirmSheet from '../app/confirm-sheet.component.azeroth';
import type { Message } from '../../data/chat.ts';
import { plainOf } from '../../lib/markdown.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { ludoOf } from '../../data/match.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useAccount } from '../../stores/account.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useDevices } from '../../stores/devices.store.ts';
import { useEnrolment } from '../../stores/enrolment.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useSeal } from '../../stores/seal.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import { useVoice, type VoicePerson } from '../../stores/voice.store.ts';
import type { MessageKey } from '../../locales/en.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Slider from '../ui/slider.component.azeroth';
import Segmented from '../ui/segmented.component.azeroth';
import { CHAT_WELL } from '../ui/variants.ts';

const QUICK: readonly MessageKey[] = ['play.quick.luck', 'play.quick.nice', 'play.quick.gg', 'play.quick.go'];

export default component TableChat(props: {
    conversationId: string;
    onClose?: () => void;
    onResize?: () => void;
    wide?: boolean;
    closeIcon?: 'panel-close' | 'close';
    class?: string;
})
{
    const locale = useLocale();
    const lobby = useLobby();
    const board = useBoard();
    const chat = useChat();
    const people = usePeople();
    const seal = useSeal();
    const devices = useDevices();
    const enrolment = useEnrolment();
    const account = useAccount();
    const toasts = useToasts();
    const overlay = useOverlay();
    const voice = useVoice();

    derived voiced = voice.people();

    const voiceOf = (who: string): VoicePerson | undefined => voiced.find((person) => person.who === who);

    const hearable = (who: string): string | null =>
        voice.table() !== null && voiceOf(who)?.me === false && voiceOf(who)?.talk === true ? who : null;

    const voiceLine = (who: string): string =>
    {
        const person = voiceOf(who);

        if (person === undefined)
        {
            return '';
        }

        if (!person.talk)
        {
            return locale.t('voice.apart');
        }

        if (person.link === 'failed')
        {
            return locale.t('voice.failed');
        }

        if (person.link !== 'connected')
        {
            return locale.t('voice.connecting');
        }

        if (person.speaking)
        {
            return locale.t('voice.speaking');
        }

        return locale.t(person.muted ? 'voice.muted' : 'voice.inCall');
    };

    state draft = '';

    state near = true;

    state tab = 'chat';

    let list: HTMLElement | null = null;

    let unstick: (() => void) | null = null;

    let opened = '';

    effect
    {
        const id = props.conversationId;

        if (id !== '')
        {
            opened = id;
            chat.openThread(id);
        }
    }

    mount
    {
        return () =>
        {
            unstick?.();

            if (untrack(chat.openId) === opened)
            {
                chat.closeThread();
            }
        };
    }

    const watch = (element: HTMLElement | null): void =>
    {
        unstick?.();
        unstick = null;
        list = element;

        if (element !== null)
        {
            unstick = attachStick(element, (value) => near = value);
            element.scrollTop = element.scrollHeight;
        }
    };

    derived all = chat.messages();

    derived messages = all.filter((message) => message.kind !== 'deleted');

    derived rows = threadRows(messages);

    effect
    {
        const tail = messages[messages.length - 1]?.id ?? '';

        if (list !== null && untrack(() => near) && tail !== '')
        {
            list.scrollTop = list.scrollHeight;
        }
    }

    derived stop = sendBlockOf({
        sealability: seal.sealability(),
        readiness: devices.readiness(),
        known: devices.known(),
        isWallet: account.isWallet(),
        pending: seal.loading()
    });

    const post = (text: string, restore: boolean): void =>
    {
        void chat.send(props.conversationId, text).then(() => haptic('tick')).catch((error) =>
        {
            if (restore && draft === '')
            {
                draft = text;
            }
            toasts.show({ kind: 'error', text: sealSentenceOf(error, locale.t), dedupe: 'table-chat-send' });
        });
    };

    const send = (): void =>
    {
        const text = draft.trim();
        if (text === '' || stop !== null)
        {
            return;
        }
        draft = '';
        post(text, true);
    };

    const quick = (key: MessageKey): void =>
    {
        if (stop === null)
        {
            post(locale.t(key), false);
        }
    };

    const nameOf = (handle: string): string =>
    {
        if (handle === lobby.me())
        {
            return locale.t('match.you');
        }

        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    const warn = (error: unknown): void =>
    {
        toasts.show({ kind: 'error', text: sealSentenceOf(error, locale.t), dedupe: 'table-chat-act' });
    };

    const quoteOf = (quoted: string): Message | undefined => all.find((message) => message.id === quoted);

    const reply = (message: Message): void =>
    {
        chat.setReplyTo(props.conversationId, message);
        requestAnimationFrame(() => list?.closest('section')?.querySelector<HTMLTextAreaElement>('textarea')?.focus());
    };

    const react = (message: Message, emoji: string): void =>
    {
        void chat.react(message, emoji).then(() => haptic('tick')).catch(warn);
    };

    const jump = (quoted: string): void =>
    {
        const target = list?.querySelector(`[data-message="${ quoted }"]`);

        if (target === null || target === undefined)
        {
            toasts.show({ kind: 'info', text: locale.t(quoteOf(quoted)?.kind === 'deleted' ? 'chat.quoteDeleted' : 'chat.quoteMissing'), dedupe: 'table-chat-jump' });
            return;
        }

        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ block: 'center', behavior: still ? 'auto' : 'smooth' });
        target.querySelector('.bubble')?.animate(
            [{ boxShadow: '0 0 0 3px var(--color-accent)' }, { boxShadow: '0 0 0 3px transparent' }],
            { duration: still ? 1 : 1400, easing: 'ease-out' }
        );
    };

    const remove = async (message: Message): Promise<void> =>
    {
        const yes = await overlay.open(
            ConfirmSheet,
            { title: locale.t('chat.deleteConfirm'), lead: locale.t('chat.deleteLead'), confirm: locale.t('chat.delete'), destructive: true },
            { label: locale.t('chat.deleteConfirm') }
        ).closed;

        if (yes === true)
        {
            await chat.remove(message).catch(warn);
        }
    };

    const actions = (message: Message, pick?: boolean): void =>
    {
        void import('../chat/message-actions.component.azeroth').then((module) => overlay.open(
            module.default,
            {
                message,
                me: lobby.me(),
                pick: pick === true,
                onReact: (emoji: string) => react(message, emoji),
                ...(quiet ? {} : { onReply: () => reply(message) }),
                onDelete: () => void remove(message)
            },
            { label: locale.t('chat.messageActions') }
        ));
    };

    derived replying = chat.replyTo(props.conversationId);

    derived table = lobby.table();

    derived quiet = table?.chat === false;

    derived match = board.match();

    derived live = match !== null && match.tableId === table?.id ? match : null;

    derived yards = live === null ? [] : (ludoOf(live)?.seats ?? []);

    derived players = (table?.chairs ?? [])
        .filter((chair) => chair.who !== undefined)
        .map((chair) =>
        {
            const player = live?.players.find((one) => one.seat === chair.seat);
            const yard = yards.find((one) => one.seat === chair.seat);

            return {
                seat: chair.seat,
                who: chair.who!,
                host: chair.host,
                ready: chair.ready,
                turn: live !== null && live.finishedAt === undefined && live.turn === chair.seat,
                colour: yard?.colour,
                home: yard?.home,
                timeouts: player?.timeouts ?? 0
            };
        });

    <section class={ () => [ 'table-panel flex min-h-0 flex-col bg-field', props.class ?? '' ].filter(Boolean).join(' ') } aria-label={ locale.t('play.table.chat') }>
        <header class="flex shrink-0 items-center gap-2 border-b border-line px-3 py-2.5">
            <Segmented
                items={ [
                    { id: 'chat', label: locale.t('play.tab.chat'), icon: 'chats' },
                    { id: 'players', label: locale.t('play.tab.players'), icon: 'people' }
                ] }
                value={ tab }
                label={ locale.t('play.table.chat') }
                onChange={ (next) => tab = next }
                class="min-w-0 flex-1"
                block
            />
            <span class="flex shrink-0 items-center gap-0.5">
                <Show when={ props.onResize !== undefined }>
                    { () =>
                        <IconButton
                            icon={ props.wide === true ? 'compact' : 'expand' }
                            label={ locale.t(props.wide === true ? 'play.table.chatCompact' : 'play.table.chatExpand') }
                            variant="ghost"
                            size="sm"
                            pressed={ props.wide === true }
                            onClick={ () => props.onResize?.() }
                        />
                    }
                </Show>
                <Show when={ props.onClose !== undefined }>
                    { () =>
                        <IconButton
                            icon={ props.closeIcon ?? 'panel-close' }
                            label={ locale.t('play.table.chatHide') }
                            variant="ghost"
                            size="sm"
                            flip={ (props.closeIcon ?? 'panel-close') === 'panel-close' }
                            onClick={ () => props.onClose?.() }
                        />
                    }
                </Show>
            </span>
        </header>

        <Show when={ tab === 'chat' }>
            { () =>
                <div class="flex min-h-0 flex-1 flex-col">
                    <ul ref={ (element) => watch(element) } class={ [ CHAT_WELL, '@container/thread flex min-h-0 flex-1 flex-col overflow-y-auto overflow-x-hidden px-3 py-3 [&>li:first-child]:mt-auto' ].join(' ') } aria-live="polite">
                        <Show when={ messages.length === 0 && !chat.threadLoading() }>
                            { () =>
                                <li class="m-auto flex max-w-[16rem] flex-col items-center gap-2 px-2 py-8 text-center">
                                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent/12 text-accent">
                                        <Icon name={ quiet ? 'chat-off' : 'chats' } size={ 20 } />
                                    </span>
                                    <p class="text-ui-sm font-semibold text-text">{ locale.t(quiet ? 'play.table.quiet' : 'chat.empty') }</p>
                                    <p class="text-ui-xs text-muted">{ locale.t(quiet ? 'play.table.quietLead' : 'play.table.chatLead') }</p>
                                </li>
                            }
                        </Show>
                        <For each={ rows } key={ (row) => row.message.id } let={ row }>
                            <li class={ () => row.first ? 'pt-3 first:pt-0' : 'pt-0.5' }>
                                <Show when={ row.day }>
                                    { () => <DayDivider at={ row.message.at } /> }
                                </Show>
                                <MessageBubble
                                    message={ row.message }
                                    me={ lobby.me() }
                                    first={ row.first }
                                    last={ row.last }
                                    avatar
                                    onActions={ quiet ? undefined : actions }
                                    onReply={ quiet ? undefined : reply }
                                    onReact={ quiet ? undefined : react }
                                    quoteOf={ quoteOf }
                                    onJump={ jump }
                                    replying={ replying?.id === row.message.id }
                                />
                            </li>
                        </For>
                    </ul>

                    <Show when={ !quiet && !seal.loading() && stop !== null }>
                        { () =>
                            <div class="shrink-0 border-t border-line px-3 pt-2">
                                <SealNotice
                                    stop={ stop }
                                    action={ stop?.reason !== 'browser' || stop.readiness === 'unsupported'
                                        ? undefined
                                        : (stop.readiness === 'absent'
                                            ? <Button variant="primary" size="sm" leading="key" loading={ devices.busy() } onClick={ () => void enrolment.give() }>
                                                { locale.t('devices.enrol') }
                                            </Button>
                                            : <Button variant="outline" size="sm" leading="key" to="/app/me/devices">
                                                { locale.t('devices.title') }
                                            </Button>) }
                                />
                            </div>
                        }
                    </Show>

                    <Show when={ quiet && messages.length > 0 }>
                        { () =>
                            <div class="shrink-0 border-t border-line p-3">
                                <QuietNote />
                            </div>
                        }
                    </Show>

                    <div class={ () => quiet ? 'hidden' : 'shrink-0 border-t border-line px-3 pb-3 pt-2.5' }>
                        <Show when={ stop === null }>
                            { () =>
                                <Rail class="-mx-3 mb-2" inner="px-3">
                                <ul class="flex shrink-0 gap-1.5" aria-label={ locale.t('play.quick.label') }>
                                    <For each={ [...QUICK] } key={ (key) => key } let={ key }>
                                        <li class="shrink-0">
                                            <button
                                                type="button"
                                                class="flex min-h-8 cursor-pointer items-center rounded-full border border-line bg-sunk px-3 text-ui-xs font-medium text-muted transition-colors hover:border-accent/60 hover:text-text coarse:min-h-11"
                                                onClick={ () => quick(key) }
                                            >
                                                { locale.t(key) }
                                            </button>
                                        </li>
                                    </For>
                                </ul>
                                </Rail>
                            }
                        </Show>
                        <Composer
                            compact
                            value={ draft }
                            disabled={ stop !== null }
                            placeholder={ locale.t('play.table.say') }
                            maxlength={ 240 }
                            reply={ replying === null ? null : { name: replying.from === lobby.me() ? locale.t('chat.yourself') : nameOf(replying.from), text: plainOf(replying.text, locale.t('chat.spoilerPreview')) } }
                            onCancelReply={ () => chat.setReplyTo(props.conversationId, null) }
                            onInput={ (value) => draft = value }
                            onSend={ send }
                        />
                    </div>
                </div>
            }
        </Show>

        <Show when={ tab === 'players' }>
            { () =>
                <ul class="flex min-h-0 flex-1 flex-col gap-1.5 overflow-y-auto p-3" aria-label={ locale.t('play.tab.players') }>
                    <For each={ players } key={ (row) => row.seat } let={ row }>
                        <li
                            class={ () => [
                                'flex flex-wrap items-center gap-3 rounded-tile border px-3 py-2.5 transition-colors',
                                row.turn ? 'border-accent/60 bg-accent/10' : 'border-line bg-sunk/60'
                            ].join(' ') }
                            aria-current={ row.turn ? 'true' : undefined }
                        >
                            <span
                                class={ () => [ 'relative flex shrink-0 rounded-full transition-shadow duration-150', voiceOf(row.who)?.speaking === true ? 'ring-2 ring-live ring-offset-2 ring-offset-field' : '' ].filter(Boolean).join(' ') }
                                style={ row.colour === undefined ? '' : `--ink: var(--ludo-${ row.colour })` }
                            >
                                <Avatar person={ people.byHandle(row.who) ?? null } size="md" />
                                <Show when={ row.colour !== undefined }>
                                    { () => <span class="absolute -bottom-0.5 -end-0.5 h-3.5 w-3.5 rounded-full ring-2 ring-field" style="background: var(--ink)" aria-hidden="true"></span> }
                                </Show>
                            </span>
                            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                                <span class="flex min-w-0 items-center gap-1.5">
                                    <span class="truncate text-ui-sm font-semibold text-text" dir="auto">{ nameOf(row.who) }</span>
                                    <Show when={ row.host }>
                                        { () => <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" /> }
                                    </Show>
                                </span>
                                <span class={ () => [ 'text-ui-2xs', row.turn ? 'font-semibold text-accent' : 'text-muted' ].join(' ') }>
                                    { row.turn ? locale.t('play.players.turn') : (live === null ? locale.t(row.ready ? 'play.players.ready' : 'play.players.waiting') : locale.t('play.players.waiting')) }
                                </span>
                            </span>
                            <Show when={ voiceOf(row.who) !== undefined }>
                                { () =>
                                    <span
                                        class={ () => [
                                            'flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-ui-2xs font-semibold',
                                            voiceOf(row.who)?.talk === false || voiceOf(row.who)?.link === 'failed' ? 'bg-danger/12 text-danger' : (voiceOf(row.who)?.speaking === true ? 'bg-live/15 text-live' : 'bg-raised text-muted')
                                        ].join(' ') }
                                        title={ voiceLine(row.who) }
                                    >
                                        <Icon name={ voiceOf(row.who)?.muted === true ? 'voice-off' : 'voice' } size={ 12 } />
                                        <span class="sr-only">{ voiceLine(row.who) }</span>
                                    </span>
                                }
                            </Show>
                            <Show when={ voice.table() !== null && voiceOf(row.who) !== undefined && voiceOf(row.who)?.me !== true }>
                                { () =>
                                    <IconButton
                                        icon={ voiceOf(row.who)?.silenced === true ? 'sound-off' : 'sound' }
                                        label={ locale.t(voiceOf(row.who)?.silenced === true ? 'voice.unsilence' : 'voice.silence', { name: nameOf(row.who) }) }
                                        variant="ghost"
                                        size="sm"
                                        pressed={ voiceOf(row.who)?.silenced === true }
                                        onClick={ () => voice.silence(row.who) }
                                    />
                                }
                            </Show>
                            <Show when={ row.timeouts > 0 }>
                                { () => <Badge dot text={ locale.plural('match.missed', row.timeouts) } tone="danger" /> }
                            </Show>
                            <Show when={ row.home !== undefined }>
                                { () =>
                                    <span class="flex shrink-0 items-center gap-1" style={ `--ink: var(--ludo-${ row.colour })` } role="img" aria-label={ locale.plural('match.tokens', row.home!) }>
                                        <For each={ [0, 1, 2, 3] } key={ (pip) => pip } let={ pip }>
                                            <span class="flex-none rounded-[999px] border-[color:color-mix(in_oklab,var(--ink)_75%,transparent)] data-[home=true]:border-[color:var(--ink)] data-[home=true]:bg-(--ink) data-[home=true]:[box-shadow:0_0_6px_-1px_var(--ink)] inline-[0.7rem] block-[0.7rem] border-2" data-home={ pip < row.home! ? 'true' : 'false' } aria-hidden="true"></span>
                                        </For>
                                    </span>
                                }
                            </Show>
                            <Show when={ hearable(row.who) } let={ who }>
                                <div class="basis-full">
                                    <Slider
                                        value={ voice.volumeOf(who) }
                                        min={ 0 }
                                        max={ 1 }
                                        step={ 0.05 }
                                        label={ locale.t('voice.volumeOf', { name: nameOf(who) }) }
                                        valueText={ locale.n(voice.volumeOf(who), { style: 'percent' }) }
                                        onChange={ (value) => voice.setLevel(who, value) }
                                    />
                                </div>
                            </Show>
                        </li>
                    </For>
                </ul>
            }
        </Show>
    </section>
}
