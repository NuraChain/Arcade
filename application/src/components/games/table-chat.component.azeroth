import { personById } from '../../data/mock/index.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Input from '../ui/input.component.azeroth';

export default component TableChat(props: { onClose?: () => void; class?: string })
{
    const locale = useLocale();
    const lobby = useLobby();

    state draft = '';

    let list: HTMLElement | null = null;

    effect
    {
        lobby.chatter();
        if (list !== null)
        {
            list.scrollTop = list.scrollHeight;
        }
    }

    const send = (): void =>
    {
        lobby.say(draft);
        draft = '';
    };

    derived messages = lobby.chatter();

    <section class={ [ 'flex min-h-0 flex-col', props.class ?? '' ].filter(Boolean).join(' ') } aria-label={ locale.t('play.table.chat') }>
        <header class="flex items-center justify-between gap-2 border-b border-line/60 px-4 py-2.5">
            <h2 class="text-ui-base font-semibold text-text">{ locale.t('play.table.chat') }</h2>
            <Show when={ props.onClose !== undefined }>
                { () => <IconButton icon="panel-close" label={ locale.t('play.table.chatHide') } variant="ghost" size="sm" flip onClick={ () => props.onClose?.() } /> }
            </Show>
        </header>
        <ul ref={ (element) => list = element } class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto px-4 py-3" aria-live="polite">
            <For each={ messages } key={ (message) => message.id } let={ message }>
                <li class={ [ 'flex items-end gap-2', message.from === lobby.me() ? 'flex-row-reverse' : '' ].filter(Boolean).join(' ') }>
                    <Avatar person={ personById(message.from) ?? null } size="xs" />
                    <span class={ [
                        'max-w-[80%] rounded-tile px-3 py-2 text-ui-base leading-snug',
                        message.from === lobby.me() ? 'bg-accent/15 text-text' : 'bg-raised text-text'
                    ].join(' ') }>
                        <Show when={ message.from !== lobby.me() }>
                            { () => <span class="mb-0.5 block text-ui-2xs font-semibold text-muted">{ locale.text(personById(message.from)?.name ?? { en: message.from, fa: message.from }) }</span> }
                        </Show>
                        { locale.text(message.text) }
                    </span>
                </li>
            </For>
        </ul>
        <form
            class="flex items-center gap-2 border-t border-line/60 px-3 py-2"
            onSubmit={ (event) =>
            {
                event.preventDefault();
                send();
            } }
        >
            <Input value={ draft } onInput={ (value) => draft = value } placeholder={ locale.t('play.table.say') } label={ locale.t('play.table.say') } enterkeyhint="send" maxlength={ 240 } class="min-w-0 flex-1" onEnter={ send } />
            <IconButton icon="send" label={ locale.t('play.table.send') } variant="primary" flip disabled={ draft.trim() === '' } onClick={ send } />
        </form>
    </section>
}
