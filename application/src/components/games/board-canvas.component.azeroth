import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useOverlay } from '../../stores/overlay.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { CELL, MARGIN } from '../../game/layout.ts';
import { FINISHED } from '../../game/board/path.ts';
import type { BoardHandle, BoardView } from '../../game/bridge.ts';
import { sceneFor } from '../../game/scenes.ts';

/**
 * The one component that reaches a board renderer.
 *
 * The import is dynamic and inside `mount`, which is the shape `world-canvas.component.azeroth` uses
 * for three.js and the reason the library lands in its own chunk. Nothing above this component knows
 * the renderer exists; it is handed a board and gives back which token was pointed at.
 *
 * The canvas is the ILLUSTRATION. Every move is takeable from the buttons beside it, the turn is a
 * live region, and this element is `aria-hidden` under a labelled host - so a keyboard or a screen
 * reader never has to reach in here, and neither does `npm run qa`, which cannot see inside a canvas
 * at all.
 *
 * If a game has no renderer, or its renderer fails to start, `failed` flips and the tokens are drawn as ordinary
 * elements over the same plate, positioned from the same two fractions the canvas uses. A board
 * without animation is still a board; a blank square is not. The fallback is the default state,
 * exactly as it is for the world.
 *
 * **The fallback reads its geometry from `game/layout.ts`, not from a second copy in the CSS.**
 * `.board-token` used to carry the two fractions as percentage literals beside the ones the canvas
 * derives, which is two descriptions of where the grid sits inside the plate - agreeing exactly
 * until somebody edited one. They are set here instead, so a change to the art moves both.
 */
export default component BoardCanvas(props: { game: string; view: BoardView; onPick?: (key: string) => void })
{
    const device = useDevice();
    const locale = useLocale();
    const overlay = useOverlay();
    const settings = useSettings();

    let host: HTMLDivElement | null = null;
    let handle: BoardHandle | null = null;

    state failed = false;

    mount
    {
        let dropped = false;

        void (async (): Promise<void> =>
        {
            if (host === null)
            {
                return;
            }

            try
            {
                /**
                 * Which scene draws this game is `game/scenes.ts`'s decision, not this file's.
                 * A game with no scene is a real state rather than a throw - an old client meeting
                 * a newer server - and it falls through to the same DOM board a browser with no
                 * failed renderer gets.
                 */
                const scene = sceneFor(props.game);

                if (scene === null)
                {
                    failed = true;
                    return;
                }

                const loaded = await scene();

                if (dropped || host === null)
                {
                    return;
                }

                handle = await loaded.open({
                    host,
                    view: props.view,
                    reducedMotion: device.reducedMotion(),
                    sound: settings.settings().sound,
                    onPick: (key) => props.onPick?.(key)
                });

                if (dropped)
                {
                    handle.dispose();
                    handle = null;
                    return;
                }

                handle.show(props.view);
            }
            catch
            {
                /**
                 * Disposed BEFORE the flag, so `failed` always means "there is no canvas". It once
                 * meant "something threw", which is not the same thing: a renderer that booted and
                 * then threw on its first paint left a working canvas on the page with the fallback
                 * drawn over the top of it.
                 */
                handle?.dispose();
                handle = null;
                failed = true;
            }
        })();

        return () =>
        {
            dropped = true;
            handle?.dispose();
            handle = null;
        };
    }

    /**
     * Every one of these reads its signal into a local BEFORE reaching through `handle`, which is
     * the shape `world-canvas` uses and the reason it works. Written the obvious way round,
     * `handle?.show(props.view)` short-circuits while the renderer is still being imported - so the
     * effect's first run reads nothing, registers no dependency, and never runs again. The board
     * then draws the game as it stood at mount and stays there for the rest of the match, with the
     * panel beside it updating correctly the whole time.
     */
    effect
    {
        const view = props.view;

        handle?.show(view);
    }

    effect
    {
        const reduced = device.reducedMotion();

        handle?.setReducedMotion(reduced);
    }

    effect
    {
        const sound = settings.settings().sound;

        handle?.setSound(sound);
    }

    /**
     * A sheet over the board is a board rendering behind something opaque. Sleeping the loop while
     * the overlay blocks costs nothing and stops a phone spinning its GPU for a canvas nobody can
     * see.
     */
    effect
    {
        const blocking = overlay.blocking();

        if (blocking)
        {
            handle?.pause();
        }
        else
        {
            handle?.resume();
        }
    }

    <div
        class="board-plate"
        role="img"
        aria-label={ locale.t('match.board') }
        style={ `--rim:${ (MARGIN * 100).toFixed(4) }%; --cell:${ (CELL * 100).toFixed(4) }%` }
    >
        <div class="board-canvas" aria-hidden="true" ref={ (element) => host = element }></div>

        <Show when={ failed }>
            { () =>
                <For each={ [...props.view.tokens] } key={ (token) => token.key } let={ token }>
                    <span
                        class="board-token"
                        aria-hidden="true"
                        data-home={ token.at === FINISHED ? 'true' : undefined }
                        style={ `--at-col:${ token.col }; --at-row:${ token.row }; --pawn: url('/board/pawn-${ token.colour }.webp'); --tone: var(--ludo-${ token.colour })` }
                    ></span>
                </For>
            }
        </Show>
    </div>
}
