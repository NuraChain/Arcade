import { personById } from '../../data/mock/index.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import GameArt from './game-art.component.azeroth';

export default component TablePlaceholder(props: { onLeave: () => void })
{
    const locale = useLocale();
    const lobby = useLobby();
    const catalogue = useCatalogue();
    const settings = useSettings();

    derived current = lobby.state();

    derived game = current.intent === null ? null : catalogue.byId(current.intent.game);

    derived gameName = game === null ? '' : locale.t(game.nameKey);

    derived sound = settings.settings().sound;

    <section class="flex flex-col gap-4" aria-label={ locale.t('play.table.title', { game: gameName }) }>
        <div class="relative overflow-hidden rounded-panel border border-line bg-field">
            <Show when={ game !== null }>
                { () => <GameArt game={ game!.id } alt="" ratio="wide" priority sizes="(min-width: 1024px) 56rem, 100vw" class="max-h-[24rem] sm:max-h-[30rem]" /> }
            </Show>
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-field via-field/40 to-transparent" aria-hidden="true"></div>
            <div class="absolute start-3 top-3 flex items-center gap-2">
                <span class="flex items-center gap-1.5 rounded-full bg-void/70 px-2.5 py-1 text-[12px] font-semibold text-live backdrop-blur-sm">
                    <span class="live-dot h-2 w-2 rounded-full" aria-hidden="true"></span>
                    { locale.t('play.table.live') }
                </span>
                <span class="rounded-full bg-void/70 px-2.5 py-1 text-[12px] font-semibold text-muted backdrop-blur-sm">{ locale.t('play.table.inProgress') }</span>
            </div>
            <div class="absolute end-3 top-3">
                <IconButton
                    icon={ sound ? 'sound' : 'sound-off' }
                    label={ locale.t('play.table.sound') }
                    variant="secondary"
                    size="sm"
                    pressed={ sound }
                    onClick={ () => settings.update({ sound: !sound }) }
                />
            </div>
            <div class="relative -mt-16 flex flex-col items-center gap-4 p-5 text-center sm:-mt-20 sm:p-8">
                <ul class="flex -space-x-2 rtl:space-x-reverse" aria-label={ locale.t('create.seats') }>
                    <For each={ current.players } key={ (id) => id } let={ id }>
                        <li>
                            <Show when={ !id.startsWith('bot-') } fallback={ <span class="flex h-10 w-10 items-center justify-center rounded-full bg-raised text-muted ring-2 ring-field"><Icon name="bot" size={ 18 } /></span> }>
                                { () => <Avatar person={ personById(id) ?? null } size="md" class="ring-2 ring-field" /> }
                            </Show>
                        </li>
                    </For>
                </ul>
                <h2 class="font-display text-[clamp(1.5rem,5vw,2.25rem)] font-semibold leading-tight text-text">{ locale.t('play.table.placeholder', { game: gameName }) }</h2>
                <p class="max-w-[46ch] text-[14px] text-muted">{ locale.t('play.table.placeholderLead') }</p>
            </div>
        </div>
        <div class="flex flex-col gap-2 sm:flex-row">
            <Button variant="primary" size="lg" block leading="forward" onClick={ () => lobby.finishNow() }>{ locale.t('play.table.skip') }</Button>
            <Button variant="ghost" size="lg" leading="sign-out" class="text-madder sm:shrink-0" onClick={ () => props.onLeave() }>{ locale.t('play.table.leave') }</Button>
        </div>
    </section>
}
