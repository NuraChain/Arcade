import { untrack } from 'azerothjs';

import CardFace from './card-face.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import TableResult from './table-result.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import TablePlate from './table-plate.component.azeroth';
import { plateTag, type PlateTag } from './plate-tag.ts';
import Button from '../ui/button.component.azeroth';
import Slider from '../ui/slider.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { FACE_KEY, rankOf, suitOf } from '../../data/cards.ts';
import { pokerOf } from '../../data/match.ts';
import { coachOf, outcomeOf } from '../../game/helpers/poker.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { haptic } from '../../lib/haptics.ts';
import { pokerBeats, tableCues } from './table-cues.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';

const RADIUS_X = 41;

const RADIUS_Y = 40;

const BET_REACH = 0.5;

const BOARD_SLOTS = [0, 1, 2, 3, 4];

export default component PokerBoard(props: { match: MatchView; starting?: boolean; onAgain?: () => void; speech?: Record<string, string>; turnMs?: number })
{
    const locale = useLocale();
    const board = useBoard();
    const people = usePeople();

    state amount = 0;

    state raising = false;

    derived game = props.match;

    derived view = pokerOf(game);

    derived over = game.finishedAt !== undefined;

    derived mine = game.mine;

    derived viewer = mine ?? 0;

    derived count = view?.seats.length ?? game.seats;

    derived whoAt = (seat: number): string => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number): string =>
    {
        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const who = whoAt(seat);
        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived chips = (value: number): string => locale.n(value);

    derived myTurn = view !== null && !over && mine !== undefined && view.turn === mine;

    const settings = useSettings();

    const cues = tableCues({
        enabled: untrack(() => settings.settings().sound),
        seq: untrack(() => board.events().seq),
        match: untrack(() => ({ id: props.match.id, rev: props.match.rev })),
        beats: (events) => pokerBeats(events.flatMap((one) => (one.log.kind === 'poker' ? one.log.moves : [])), { mine: props.match.mine ?? null, seats: props.match.seats })
    });

    effect
    {
        const batch = board.events();

        untrack(() => cues.hear(batch, { id: props.match.id, rev: props.match.rev }));
    }

    effect
    {
        const yours = myTurn;

        untrack(() => cues.turn(yours && props.match.mine !== undefined));
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => cues.setEnabled(on));
    }

    mount
    {
        return () => cues.dispose();
    }

    derived toCall = view?.toCall ?? 0;

    derived canRaise = myTurn && view!.minRaiseTo !== undefined && view!.maxRaiseTo !== undefined;

    derived low = view?.minRaiseTo ?? 0;

    derived high = view?.maxRaiseTo ?? 0;

    derived highest = view === null ? 0 : Math.max(0, ...view.seats.map((row) => row.bet));

    derived myRow = view?.seats.find((row) => row.seat === viewer);

    derived tip = view === null || over ? null : coachOf(view, mine);

    derived outcome = view === null || over || !settings.settings().hintOutcome ? null : outcomeOf(view, mine);

    derived handSays = ((): string =>
    {
        const hand = outcome?.hand;

        if (hand == null)
        {
            return '';
        }

        const named = locale.t(`helpers.poker.hand.${ hand.category }` as never, {
            top: locale.t(`helpers.poker.rank.one.${ hand.top }` as never),
            tops: locale.t(`helpers.poker.rank.many.${ hand.top }` as never),
            seconds: hand.second === null ? '' : locale.t(`helpers.poker.rank.many.${ hand.second }` as never)
        });

        return locale.t(hand.board ? 'helpers.poker.board' : 'helpers.poker.best', { hand: named });
    })();

    derived costSays = ((): string =>
    {
        const call = outcome?.call;

        return call == null ? '' : locale.t('helpers.poker.cost', { chips: chips(call.chips), pot: chips(call.pot) });
    })();

    effect
    {
        const floor = low;
        const rev = game.rev;

        if (rev >= 0)
        {
            amount = floor;
            raising = false;
        }
    }

    derived chosen = Math.min(high, Math.max(low, amount));

    derived potSized = (share: number): number =>
    {
        const target = highest + Math.round(((view?.pot ?? 0) + toCall) * share);

        return Math.min(high, Math.max(low, target));
    };

    derived plates = view === null ? [] : view.seats.map((row) =>
    {
        const place = (row.seat - viewer + count) % count;
        const angle = Math.PI / 2 + (place / count) * Math.PI * 2;
        const cos = Math.cos(angle);
        const sin = Math.sin(angle);

        return {
            row,
            place,
            x: 50 + cos * RADIUS_X,
            y: 50 + sin * RADIUS_Y,
            betX: 50 + cos * RADIUS_X * BET_REACH,
            betY: 50 + sin * RADIUS_Y * BET_REACH,
            live: !row.folded && !row.out
        };
    });

    derived turnSeat = view?.turn;

    derived stateOf = (row: { seat: number; out: boolean; folded: boolean; allIn: boolean }): PlateTag | null =>
    {
        if (row.out)
        {
            return { text: locale.t('poker.out'), tone: 'neutral' };
        }

        if (row.allIn)
        {
            return { text: locale.t('poker.allIn'), tone: 'madder' };
        }

        if (row.folded)
        {
            return { text: locale.t('poker.folded'), tone: 'neutral' };
        }

        return plateTag(locale, game.players.find((one) => one.seat === row.seat), over);
    };

    derived raiseSays = chosen >= high
        ? locale.t('poker.allin', { chips: chips(high) })
        : (highest === 0 ? locale.t('poker.betTo', { chips: chips(chosen) }) : locale.t('poker.raiseTo', { chips: chips(chosen) }));

    const rankSays = (card: number): string =>
    {
        const rank = rankOf(card);

        return FACE_KEY[rank] === undefined ? locale.n(Number(rank)) : locale.t(FACE_KEY[rank]);
    };

    const cardSays = (card: number): string =>
        locale.t('hokm.card', { rank: rankSays(card), suit: locale.t(`hokm.suit.${ suitOf(card) }` as never) });

    const cardsSay = (cards: readonly number[]): string => locale.list(cards.map(cardSays));

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (over)
        {
            if (game.winner === undefined)
            {
                return locale.t('match.abandoned');
            }

            return game.winner === mine ? locale.t('match.won.you') : locale.t('match.won.them', { name: nameOf(game.winner) });
        }

        if (mine !== undefined && myRow?.out === true)
        {
            return locale.t('poker.turn.out');
        }

        if (myTurn)
        {
            return toCall === 0 ? locale.t('poker.turn.check') : locale.t('poker.turn.call', { chips: chips(toCall) });
        }

        return view.turn === undefined ? '' : locale.t('match.turn.theirs', { name: nameOf(view.turn) });
    })();

    derived lastSays = ((): string[] =>
    {
        const last = view?.last;

        if (last === undefined)
        {
            return [];
        }

        return last.pots.map((pot) =>
        {
            const names = locale.list(pot.winners.map(nameOf));
            const shown = last.shown.find((row) => pot.winners.includes(row.seat));

            return shown === undefined
                ? locale.t('poker.last.won', { name: names, chips: chips(pot.amount) })
                : locale.t('poker.last.with', { name: names, chips: chips(pot.amount), category: locale.t(`poker.category.${ shown.category }` as never) });
        });
    })();

    const act = async (verb: 'fold' | 'check' | 'call' | 'allin'): Promise<void> =>
    {
        haptic('select');
        await board.play({ kind: 'poker', verb });
    };

    const raise = async (): Promise<void> =>
    {
        haptic('select');
        raising = false;

        if (chosen >= high)
        {
            await board.play({ kind: 'poker', verb: 'allin' });
            return;
        }

        await board.play({ kind: 'poker', verb: 'raise', amount: chosen });
    };

    <div class="table-stage poker-stage">
        <div class="table-grid">
            <Show when={ view !== null }>
                { () =>
                    <div class="table-fit">
                        <div class="table-surface poker-table" role="group" aria-label={ locale.t('poker.table') }>
                            <div class="poker-chips">
                                <span class="poker-chip">
                                    <Icon name="coins" size={ 12 } class="shrink-0 text-gold" />
                                    <span class="tally">{ chips(view!.blinds.small) }/{ chips(view!.blinds.big) }</span>
                                    <span class="text-white/60">·</span>
                                    <span>{ locale.t(`poker.street.${ view!.street }` as never) }</span>
                                    <span class="sr-only">
                                        { locale.t('poker.blinds') }, { locale.plural('poker.next', view!.blinds.next) }, { locale.t('poker.hand', { n: locale.n(view!.hand) }) }, { locale.t('poker.level', { level: locale.n(view!.blinds.level) }) }
                                    </span>
                                </span>

                                <details class="poker-last">
                                    <summary class="poker-chip">
                                        <Icon name="history" size={ 12 } class="shrink-0 text-gold" />
                                        <span>{ locale.t('poker.last') }</span>
                                    </summary>
                                    <div class="poker-last-panel" dir={ locale.dir() }>
                                        <Show
                                            when={ view!.last !== undefined }
                                            fallback={ <p class="text-ui-xs text-muted">{ locale.t('poker.last.none') }</p> }
                                        >
                                            { () =>
                                                <div class="flex flex-col gap-2">
                                                    <For each={ lastSays } key={ (line, index) => `${ index }-${ line }` } let={ line }>
                                                        <p class="text-ui-xs font-semibold text-text">{ line }</p>
                                                    </For>
                                                    <Show when={ (view!.last?.shown.length ?? 0) > 0 }>
                                                        { () =>
                                                            <ul class="flex flex-col gap-1.5 [--card-w:1.9rem]">
                                                                <For each={ view!.last!.shown } key={ (row) => row.seat } let={ row }>
                                                                    <li class="flex min-w-0 items-center gap-2">
                                                                        <span class="flex gap-0.5" role="img" aria-label={ cardsSay(row.cards) }>
                                                                            <For each={ row.cards } key={ (card) => card } let={ card }>
                                                                                <span class="flex">
                                                                                    <CardFace card={ card } />
                                                                                </span>
                                                                            </For>
                                                                        </span>
                                                                        <span class="min-w-0 truncate text-ui-2xs text-muted" dir="auto">{ nameOf(row.seat) }</span>
                                                                        <span class="ms-auto shrink-0 text-ui-2xs font-semibold text-text">{ locale.t(`poker.category.${ row.category }` as never) }</span>
                                                                    </li>
                                                                </For>
                                                            </ul>
                                                        }
                                                    </Show>
                                                </div>
                                            }
                                        </Show>
                                    </div>
                                </details>
                            </div>

                            <div class="poker-centre">
                                <ul class="flex items-center gap-1" aria-label={ locale.t('poker.board') }>
                                    <For each={ BOARD_SLOTS } key={ (slot) => slot } let={ slot }>
                                        <li class="flex">
                                            <Show
                                                when={ view!.board[slot] !== undefined }
                                                fallback={ <span class="block aspect-[204/288] w-[var(--card-w)] rounded-[calc(var(--card-w)*0.08)] border border-dashed border-white/25" aria-hidden="true"></span> }
                                            >
                                                { () =>
                                                    <span class="flex" role="img" aria-label={ cardSays(view!.board[slot]) }>
                                                        <CardFace card={ view!.board[slot] } />
                                                    </span>
                                                }
                                            </Show>
                                        </li>
                                    </For>
                                </ul>
                                <p class="flex items-center gap-1.5 rounded-full bg-black/35 px-3 py-1 text-ui-xs font-semibold text-white">
                                    <Icon name="coins" size={ 13 } class="text-gold" />
                                    <span>{ locale.t('poker.pot', { chips: chips(view!.pot) }) }</span>
                                </p>
                                <Show when={ view!.pots.length > 1 }>
                                    { () =>
                                        <p class="text-ui-2xs text-white/70">
                                            { locale.list(view!.pots.map((pot, index) => locale.t(index === 0 ? 'poker.main' : 'poker.side', { chips: chips(pot.amount) }))) }
                                        </p>
                                    }
                                </Show>
                            </div>

                            <For each={ plates } key={ (plate) => plate.row.seat } let={ plate }>
                                <div class="contents">
                                    <Show when={ plate.row.bet > 0 }>
                                        { () =>
                                            <span class="poker-bet" style={ `left: ${ plate.betX.toFixed(2) }%; top: ${ plate.betY.toFixed(2) }%` }>
                                                <span class="h-2.5 w-2.5 rounded-full border-2 border-dashed border-white bg-madder" aria-hidden="true"></span>
                                                <span class="tally">{ chips(plate.row.bet) }</span>
                                            </span>
                                        }
                                    </Show>

                                    <div class="poker-seat" data-seat={ plate.row.seat } style={ `left: ${ plate.x.toFixed(2) }%; top: ${ plate.y.toFixed(2) }%` }>
                                        <TablePlate
                                            who={ whoAt(plate.row.seat) }
                                            name={ nameOf(plate.row.seat) }
                                            turn={ !over && turnSeat === plate.row.seat }
                                            remainingMs={ game.remainingMs }
                                            turnMs={ props.turnMs }
                                            dim={ !plate.live }
                                            tag={ stateOf(plate.row)?.text }
                                            tone={ stateOf(plate.row)?.tone }
                                            bubble={ props.speech?.[whoAt(plate.row.seat)] }
                                            below={ plate.y < 50 }
                                            anchor={ plate.x > 60 ? 'end' : (plate.x < 40 ? 'start' : 'centre') }
                                            marker={ view!.button === plate.row.seat ? <span class="poker-dealer" title={ locale.t('poker.dealer') }>D</span> : undefined }
                                            facts={ <span class="tally font-bold text-gold">{ chips(plate.row.stack) }</span> }
                                        />
                                        <Show when={ plate.live && plate.row.seat !== mine }>
                                            { () =>
                                                <span class="poker-backs" aria-hidden="true">
                                                    <span class="card-back -rotate-6"></span>
                                                    <span class="card-back -ms-1.5 rotate-6"></span>
                                                </span>
                                            }
                                        </Show>
                                    </div>
                                </div>
                            </For>
                        </div>
                    </div>
                }
            </Show>

            <Show when={ view !== null && !over && view!.hole.length === 2 }>
                { () =>
                    <div class="table-hand poker-hand">
                        <ul class="flex gap-1.5" aria-label={ locale.t('poker.hole') }>
                            <For each={ view!.hole } key={ (card) => card } let={ card }>
                                <li class="flex" role="img" aria-label={ cardSays(card) }>
                                    <CardFace card={ card } />
                                </li>
                            </For>
                        </ul>
                        <p class="poker-hand-text flex min-w-0 flex-col text-ui-xs text-muted">
                            <span class="label text-ui-2xs text-faint">{ locale.t('poker.hole') }</span>
                            <span class="line-clamp-2">{ cardsSay(view!.hole) }</span>
                            <Show when={ handSays !== '' }>
                                { () => <span class="line-clamp-2 font-semibold text-text">{ handSays }</span> }
                            </Show>
                        </p>
                    </div>
                }
            </Show>

            <Show when={ view !== null && !over }>
                { () =>
                    <section class="table-bar poker-bar">
                        <Show when={ raising && canRaise }>
                            { () =>
                                <div class="poker-raise">
                                    <Show when={ low < high }>
                                        { () =>
                                            <div class="flex flex-col gap-2">
                                                <Slider
                                                    value={ chosen }
                                                    min={ low }
                                                    max={ high }
                                                    step={ 1 }
                                                    label={ locale.t('poker.raise.label') }
                                                    valueText={ chips(chosen) }
                                                    onChange={ (value) => amount = Math.round(value) }
                                                />
                                                <div class="flex flex-wrap gap-1.5">
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = low }>{ locale.t('poker.preset.min') }</Button>
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = potSized(0.5) }>{ locale.t('poker.preset.half') }</Button>
                                                    <Button variant="secondary" size="sm" onClick={ () => amount = potSized(1) }>{ locale.t('poker.preset.pot') }</Button>
                                                </div>
                                            </div>
                                        }
                                    </Show>
                                    <Button variant={ chosen >= high ? 'secondary' : 'primary' } size="lg" block disabled={ board.busy() } onClick={ () => void raise() }>
                                        { raiseSays }
                                    </Button>
                                </div>
                            }
                        </Show>

                        <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
                            <p class="min-w-0 flex-[1_1_8rem] text-ui-base font-semibold text-text" aria-live="polite">{ says }</p>
                            <span class="poker-bar-facts poker-chip" aria-hidden="true">
                                <Icon name="coins" size={ 12 } class="shrink-0 text-gold" />
                                <span class="tally">{ chips(view!.blinds.small) }/{ chips(view!.blinds.big) }</span>
                                <span class="text-white/60">·</span>
                                <span>{ locale.t(`poker.street.${ view!.street }` as never) }</span>
                            </span>
                            <TurnClock remainingMs={ game.remainingMs } over={ over } yours={ myTurn } />
                        </div>

                        <CoachLine tip={ tip } />

                        <Show when={ mine !== undefined && myRow?.out !== true }>
                            { () =>
                                <div class="flex min-h-11 min-w-0 flex-col justify-center gap-1.5">
                                    <Show when={ myTurn }>
                                        { () =>
                                            <div class="flex min-w-0 flex-col gap-1.5">
                                                <Show when={ costSays !== '' }>
                                                    { () => <p class="poker-cost text-ui-xs text-muted">{ costSays }</p> }
                                                </Show>
                                                <div class="grid auto-cols-fr grid-flow-col gap-2">
                                                    <Show when={ toCall > 0 }>
                                                        { () =>
                                                            <Button variant="destructive" size="lg" disabled={ board.busy() } onClick={ () => void act('fold') }>
                                                                { locale.t('poker.fold') }
                                                            </Button>
                                                        }
                                                    </Show>
                                                    <Show
                                                        when={ toCall > 0 }
                                                        fallback={
                                                            <Button variant="primary" size="lg" loading={ board.busy() } onClick={ () => void act('check') }>
                                                                { locale.t('poker.check') }
                                                            </Button>
                                                        }
                                                    >
                                                        { () =>
                                                            <Button variant="primary" size="lg" loading={ board.busy() } onClick={ () => void act('call') }>
                                                                { toCall >= (myRow?.stack ?? 0) ? locale.t('poker.callAllIn', { chips: chips(myRow?.stack ?? 0) }) : locale.t('poker.call', { chips: chips(toCall) }) }
                                                            </Button>
                                                        }
                                                    </Show>
                                                    <Show when={ canRaise && low < high }>
                                                        { () =>
                                                            <Button variant="secondary" size="lg" pressed={ raising } disabled={ board.busy() } onClick={ () => raising = !raising }>
                                                                { highest === 0 ? locale.t('poker.bet') : locale.t('poker.raise') }
                                                            </Button>
                                                        }
                                                    </Show>
                                                    <Show when={ canRaise && low >= high }>
                                                        { () =>
                                                            <Button variant="secondary" size="lg" disabled={ board.busy() } onClick={ () => void raise() }>
                                                                { locale.t('poker.allin', { chips: chips(high) }) }
                                                            </Button>
                                                        }
                                                    </Show>
                                                </div>
                                            </div>
                                        }
                                    </Show>
                                </div>
                            }
                        </Show>
                    </section>
                }
            </Show>
        </div>

        <Show when={ over }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } />
            }
        </Show>
    </div>
}
