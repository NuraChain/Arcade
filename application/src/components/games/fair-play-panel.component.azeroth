import type { GameId } from '../../data/games.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component FairPlayPanel(props: { game: GameId; class?: string })
{
    const locale = useLocale();
    const catalogue = useCatalogue();

    derived rules = catalogue.rules(props.game);

    derived items = ((): Array<{ id: string; icon: IconName; text: string }> =>
    {
        const out: Array<{ id: string; icon: IconName; text: string }> = [];
        if (rules.fairness === 'dice')
        {
            out.push({ id: 'dice', icon: 'dice', text: locale.t('game.fairPlay.dice') });
        }
        if (rules.fairness === 'deal')
        {
            out.push({ id: 'deal', icon: 'cards', text: locale.t('game.fairPlay.deal') });
        }
        out.push({ id: 'reliability', icon: 'shield', text: locale.t('game.fairPlay.reliability') });
        out.push({ id: 'practice', icon: 'bot', text: locale.t('game.fairPlay.practice') });
        if (rules.stakes === 'play-money')
        {
            out.push({ id: 'stakes', icon: 'coins', text: locale.t('games.stakes.playMoneyHint') });
        }
        return out;
    })();

    <section class={ [ 'rounded-panel border border-live/30 bg-live/5 p-4', props.class ?? '' ].filter(Boolean).join(' ') } aria-labelledby={ `fair-play-${ props.game }` }>
        <h2 id={ `fair-play-${ props.game }` } class="flex items-center gap-2 font-ui text-[13px] font-bold uppercase tracking-[0.08em] text-live [font-variation-settings:normal] [letter-spacing:0.08em]">
            <Icon name="verified" size={ 16 } />
            { locale.t('game.fairPlay.title') }
        </h2>
        <ul class="mt-3 flex flex-col gap-2.5">
            <For each={ items } key={ (item) => item.id } let={ item }>
                <li class="flex items-start gap-3 text-[14px] leading-snug text-text">
                    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-live/15 text-live">
                        <Icon name={ item.icon } size={ 13 } />
                    </span>
                    <span>{ item.text }</span>
                </li>
            </For>
        </ul>
    </section>
}
