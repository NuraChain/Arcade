import { untrack } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { createSound, type SoundHandle } from '../../game/sound.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSettings } from '../../stores/settings.store.ts';

const URGENT_AT = 10;

const MINUTE = 60;

const HOUR = 60 * MINUTE;

const TICK_FROM = 5;

const HIGH_FROM = 2;

export default component TurnClock(props: { remainingMs?: number; over: boolean; yours?: boolean; class?: string })
{
    const locale = useLocale();
    const settings = useSettings();

    let sound: SoundHandle | null = null;

    let told: number | null = null;

    let counted: number | undefined = untrack(() => props.remainingMs);

    let counting = untrack(() => props.yours === true);

    state now = runtime().clock.now();

    state endsAt: number | null = null;

    mount
    {
        sound = createSound(untrack(() => settings.settings().sound));

        const stop = runtime().clock.every(1000, () => now = runtime().clock.now());

        return () =>
        {
            stop();
            sound?.dispose();
            sound = null;
        };
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => sound?.setEnabled(on));
    }

    effect
    {
        const left = props.remainingMs;
        const at = runtime().clock.now();

        endsAt = left === undefined ? null : at + left;
        now = at;
    }

    derived secondsLeft = props.over || endsAt === null
        ? null
        : Math.max(0, Math.round((endsAt - now) / 1000));

    effect
    {
        const left = secondsLeft;
        const yours = props.yours === true;
        const given = props.remainingMs;

        untrack(() =>
        {
            if (given !== counted || yours !== counting)
            {
                counted = given;
                counting = yours;
                told = null;
                return;
            }

            if (!yours || left === null || left > TICK_FROM)
            {
                told = null;
                return;
            }

            if (left < 1 || left === told)
            {
                return;
            }

            told = left;
            sound?.play(left <= HIGH_FROM ? 'tick-hi' : 'tick', { urgent: true });

            if (left === TICK_FROM)
            {
                haptic('warn');
            }
        });
    }

    derived says = ((): string | null =>
    {
        if (secondsLeft === null)
        {
            return null;
        }

        if (secondsLeft === 0)
        {
            return locale.t('match.deadline.expiring');
        }

        if (secondsLeft < 90)
        {
            return locale.t('match.deadline', { seconds: locale.n(secondsLeft) });
        }

        if (secondsLeft < 90 * MINUTE)
        {
            return locale.t('match.deadline.minutes', { minutes: locale.n(Math.round(secondsLeft / MINUTE)) });
        }

        return locale.t('match.deadline.hours', { hours: locale.n(Math.round(secondsLeft / HOUR)) });
    })();

    <Show when={ says !== null }>
        { () =>
            <span
                class={ () => [
                    'inline-flex h-7 shrink-0 items-center gap-1.5 rounded-full border px-2.5 text-ui-xs font-semibold',
                    secondsLeft !== null && secondsLeft <= URGENT_AT ? 'border-danger/40 bg-danger/10 text-danger' : 'border-line bg-raised text-muted',
                    props.class ?? ''
                ].filter(Boolean).join(' ') }
            >
                <Icon name="timer" size={ 13 } />
                <span>{ says }</span>
            </span>
        }
    </Show>
}
