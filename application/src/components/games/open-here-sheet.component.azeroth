import { useNavigate } from 'azerothjs';

import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Segmented from '../ui/segmented.component.azeroth';
import { openTable } from '../../lib/open-table.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { Game, GameId } from '../../data/games.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';

/** The widest table any game in this product plays, used only while the room's size is unknown. */
const MOST_SEATS = 8;

/**
 * Opens a table IN this room, joinable by the people in it and by nobody else.
 *
 * The separation is the whole point and the copy says it in as many words: a table opened here is
 * not in the open list, so quick play cannot drop a stranger into it. The conversation it was
 * opened from IS the guest list - a direct thread means those two people, a group room means that
 * group - which is one membership rather than a second one to keep in step with the first.
 *
 * There is no privacy control on this sheet, deliberately. A table with a room is a room table by
 * construction, and offering the choice would be offering to announce a public table in a private
 * group: the two facts are one, and the server derives the second from the first for exactly that
 * reason.
 *
 * It does not mount until the catalogue has answered, because the seat counts a game plays are the
 * server's word and a `derived` over a resource that has not landed reads an empty list - the
 * create form is gated the same way and for the same reason.
 */
export default component OpenHereSheet(props: OverlayProps & { conversationId: string })
{
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const locale = useLocale();
    const { navigate } = useNavigate();

    const chat = useChat();

    state game = 'ludo' as GameId;
    state pending = false;

    /**
     * The room is the guest list, so the room's size is the table's ceiling.
     *
     * Nobody outside this conversation can ever take a chair here - that is the whole point of a
     * room table - so a four-seat game opened in a thread between two people is a table that can
     * never be ready and a game that can never start. The sheet simply does not offer it: seat
     * counts above the head count are gone, and a game with no seat count that fits is gone with
     * them, which is what takes four-handed hokm off the list in a direct thread.
     *
     * Falling back to the largest seat count any game plays while the conversation is still loading
     * rather than to some small number, because the fallback must not narrow the offer - a group of
     * eight would otherwise see a two-seat choice for a moment and pick it.
     */
    derived capacity = chat.conversation(props.conversationId)?.participants.length ?? MOST_SEATS;

    derived fits = (entry: Game): number[] => catalogue.rules(entry.id).seats.filter((count) => count <= capacity);

    derived playable = catalogue.games
        .filter((entry) => catalogue.status(entry.id) === 'available')
        .filter((entry) => fits(entry).length > 0);

    derived allowed = fits(catalogue.byId(game));

    state seats = 0;

    derived choices = allowed.map((count) => ({ id: String(count), label: locale.n(count) }));

    /**
     * Null rather than a fallback, because there is no safe number to fall back TO.
     *
     * It was `?? 2`, which reads as a harmless default and defeats the whole cap: the only way
     * `allowed` is empty is that no seat count this game plays fits in this room, and answering
     * that with two opens exactly the unfillable table the cap exists to refuse. Nothing can reach
     * it today - a game with no fitting count is filtered out of `playable` - but a default that is
     * wrong whenever it is used is a trap set for whoever changes the filter.
     */
    derived chosen = allowed.includes(seats) ? seats : (allowed[allowed.length - 1] ?? null);

    /**
     * How many people play it, as a range or as one number.
     *
     * Built here rather than in the catalogue, because it is interpolation and punctuation and
     * nothing else - `tests/data.spec.ts` fails on a key whose English and Persian are the same
     * string, which is exactly what a `'{min}-{max}'` entry would be. It wears `tally` so the range
     * does not reverse inside a Persian line.
     */
    const playersOf = (entry: Game): string =>
    {
        const counts = fits(entry);
        const low = counts[0] ?? entry.minPlayers;
        const high = counts[counts.length - 1] ?? entry.maxPlayers;

        return low === high ? locale.n(low) : `${ locale.n(low) }-${ locale.n(high) }`;
    };

    const open = (): void =>
    {
        if (chosen === null)
        {
            return;
        }

        pending = true;
        openTable(
            lobby.host(game, { ...catalogue.defaults(game), seats: chosen, roomId: props.conversationId }, []),
            (to) =>
            {
                props.close(true);
                navigate(to);
            },
            () => { pending = false; }
        );
    };

    <div class="flex flex-col gap-5 p-5">
        <header class="flex items-start justify-between gap-3">
            <div class="min-w-0">
                <h2 class="title text-ui-xl text-text">{ locale.t('openHere.title') }</h2>
                <p class="mt-2 text-ui-base text-muted">{ locale.t('openHere.lead') }</p>
            </div>
            <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.close(false) } />
        </header>

        <fieldset class="flex flex-col gap-2">
            <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('openHere.game') }</legend>
            <ul class="grid grid-cols-2 gap-2">
                <For each={ playable } key={ (entry) => entry.id } let={ entry }>
                    <li>
                        <button
                            type="button"
                            class={ () => [
                                'flex w-full items-center gap-2 rounded-tile border px-3 py-3 text-start text-ui-base coarse:py-4',
                                entry.id === game ? 'border-accent bg-accent/10 text-text' : 'border-line bg-field text-muted'
                            ].join(' ') }
                            aria-pressed={ entry.id === game }
                            onClick={ () => game = entry.id }
                        >
                            <span class="min-w-0 truncate">{ locale.t(entry.nameKey) }</span>
                            <span class="tally shrink-0 text-ui-2xs text-faint">{ playersOf(entry) }</span>
                        </button>
                    </li>
                </For>
            </ul>
        </fieldset>

        <Show when={ choices.length > 1 }>
            <fieldset class="flex flex-col gap-2">
                <legend class="label mb-2 text-ui-sm text-muted">{ locale.t('create.seats') }</legend>
                <Segmented
                    block
                    label={ locale.t('create.seats') }
                    value={ String(chosen ?? '') }
                    items={ choices }
                    onChange={ (id) => seats = Number(id) }
                />
            </fieldset>
        </Show>

        <Button variant="primary" size="lg" block loading={ pending } onClick={ () => open() }>
            { locale.t('openHere.open') }
        </Button>
    </div>
}
