import CardFace from './card-face.component.azeroth';
import MatchResult from './match-result.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { FACE_KEY, SUITS, SUIT_ICON, arrangeHand, rankOf, suitOf, type Suit } from '../../data/cards.ts';
import { aroundTable, type Chair } from './table-seats.ts';
import { hokmOf } from '../../data/match.ts';
import { useBoard } from '../../stores/match.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';

type Side = 'bottom' | 'top' | 'left' | 'right' | 'top-left' | 'top-right';

const FOUR: readonly Side[] = ['bottom', 'right', 'top', 'left'];

const REACH: Record<Side, readonly [number, number]> = {
    'bottom': [0, 1],
    'top': [0, -1],
    'left': [-1, 0],
    'right': [1, 0],
    'top-left': [-0.8, -0.6],
    'top-right': [0.8, -0.6]
};

const SIDE_TONE = ['text-accent', 'text-gold', 'text-live'];

const RED_SUITS: readonly Suit[] = ['hearts', 'diamonds'];

const ROW_LIMIT = 13;

const BACKS_SHOWN = 10;

export default component HokmBoard(props: { match: MatchView; starting?: boolean; onAgain?: () => void })
{
    const locale = useLocale();
    const board = useBoard();
    const people = usePeople();

    state sorted = false;

    derived game = props.match;

    derived view = hokmOf(game);

    derived over = game.finishedAt !== undefined;

    derived mine = game.mine;

    derived whoAt = (seat: number): string => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number): string =>
    {
        const who = whoAt(seat);

        if (who === '')
        {
            return '';
        }

        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (over)
        {
            return game.winner === undefined
                ? locale.t('match.abandoned')
                : (game.winner === mine ? locale.t('match.won.you') : locale.t('match.won.them', { name: nameOf(game.winner) }));
        }

        if (view.phase === 'trump')
        {
            return view.hakem === mine
                ? locale.t('hokm.trump.yours')
                : locale.t('hokm.trump.theirs', { name: nameOf(view.hakem) });
        }

        return view.turn === mine
            ? locale.t('match.turn.yours')
            : locale.t('match.turn.theirs', { name: nameOf(view.turn) });
    })();

    derived chairs = aroundTable(game.seats, mine ?? null);

    const sideOf = (chair: Chair): Side =>
    {
        if (chair.place === 0)
        {
            return 'bottom';
        }

        if (game.seats === 2)
        {
            return 'top';
        }

        if (game.seats === 3)
        {
            return chair.place === 1 ? 'top-right' : 'top-left';
        }

        return FOUR[chair.place] ?? 'top';
    };

    derived plates = view === null ? [] : view.seats.map((row) =>
    {
        const chair = chairs[row.seat];

        return {
            row,
            side: sideOf(chair),
            backs: row.seat === mine ? [] : Array.from({ length: Math.min(row.held, BACKS_SHOWN) }, (_, index) => index)
        };
    });

    derived laid = ((): { cards: { card: number; seat: number; side: Side }[]; took: number | null } =>
    {
        const held = view;

        if (held === null)
        {
            return { cards: [], took: null };
        }

        const spread = (lead: number, cards: readonly number[]): { card: number; seat: number; side: Side }[] =>
            cards.map((card, offset) =>
            {
                const seat = (lead + offset) % game.seats;

                return { card, seat, side: sideOf(chairs[seat]) };
            });

        if (held.trick.length > 0)
        {
            return { cards: spread(held.lead, held.trick), took: null };
        }

        return held.took === undefined
            ? { cards: [], took: null }
            : { cards: spread(held.took.lead, held.took.cards), took: held.took.seat };
    })();

    derived legal = new Set(view === null ? [] : view.plays);

    derived myTurn = view !== null && !over && view.phase === 'tricks' && view.turn === mine;

    derived hand = view === null ? [] : (sorted ? arrangeHand(view.hand, view.trump) : [...view.hand]);

    derived rows = hand.length > ROW_LIMIT
        ? [hand.slice(0, Math.ceil(hand.length / 2)), hand.slice(Math.ceil(hand.length / 2))]
        : [hand];

    derived handTricks = view === null ? [] : view.points.map((_, side) =>
        view!.seats.filter((row) => row.side === side).reduce((sum, row) => sum + row.tricks, 0));

    derived sides = view === null ? [] : view.points.map((points, index) => ({
        index,
        points,
        tricks: handTricks[index] ?? 0,
        names: locale.list(view!.seats.filter((row) => row.side === index).map((row) => nameOf(row.seat)))
    }));

    const fan = (index: number, count: number): string =>
    {
        const middle = (count - 1) / 2;
        const tilt = middle === 0 ? 0 : (index - middle) / middle;

        return `--i: ${ index }; --n: ${ count }; --t: ${ tilt.toFixed(3) }`;
    };

    const rankSays = (card: number): string =>
    {
        const rank = rankOf(card);

        return FACE_KEY[rank] === undefined ? locale.n(Number(rank)) : locale.t(FACE_KEY[rank]);
    };

    const cardSays = (card: number): string =>
        locale.t('hokm.card', { rank: rankSays(card), suit: locale.t(`hokm.suit.${ suitOf(card) }` as never) });

    const playCard = async (card: number): Promise<void> =>
    {
        if (!legal.has(card))
        {
            return;
        }

        await board.play({ kind: 'hokm', verb: 'card', card });
    };

    const callTrump = async (suit: Suit): Promise<void> =>
    {
        await board.play({ kind: 'hokm', verb: 'trump', suit });
    };

    <div class="@container flex min-w-0 flex-col gap-3">
        <Show when={ view !== null }>
            { () =>
        <div class="hokm-arena">
            <div class="hokm-table">
                <For each={ plates } key={ (plate) => plate.row.seat } let={ plate }>
                    <div class="hokm-seat" data-side={ plate.side }>
                        <div
                            class={ () => [
                                'hokm-plate',
                                !over && plate.row.seat === view!.turn ? 'is-turn' : '',
                                plate.row.out ? 'opacity-60' : ''
                            ].filter(Boolean).join(' ') }
                            aria-current={ !over && plate.row.seat === view!.turn ? 'true' : undefined }
                        >
                            <Avatar person={ people.byHandle(whoAt(plate.row.seat)) } size="sm" ringOn="void" />
                            <span class="flex min-w-0 flex-col leading-tight">
                                <span class="flex min-w-0 items-center gap-1">
                                    <span class="truncate text-ui-xs font-semibold text-text" dir="auto">{ nameOf(plate.row.seat) }</span>
                                    <Show when={ plate.row.seat === view!.hakem }>
                                        { () => <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" /> }
                                    </Show>
                                </span>
                                <span class="flex items-center gap-2 text-ui-2xs text-muted" aria-hidden="true">
                                    <span class="flex items-center gap-0.5">
                                        <Icon name="trophy" size={ 11 } class={ SIDE_TONE[plate.row.side % SIDE_TONE.length] } />
                                        <span class="tally">{ locale.n(plate.row.tricks) }</span>
                                    </span>
                                    <span class="flex items-center gap-0.5">
                                        <Icon name="cards" size={ 11 } />
                                        <span class="tally">{ locale.n(plate.row.held) }</span>
                                    </span>
                                </span>
                                <span class="sr-only">{ locale.plural('hokm.tricks', plate.row.tricks) }, { locale.plural('hokm.held', plate.row.held) }</span>
                            </span>
                        </div>
                        <Show when={ plate.backs.length > 0 }>
                            { () =>
                                <span class="hokm-pile" style={ `--n: ${ plate.backs.length }` } aria-hidden="true">
                                    <For each={ plate.backs } key={ (back) => back } let={ back }>
                                        <span class="card-back" style={ `--i: ${ back }` }></span>
                                    </For>
                                </span>
                            }
                        </Show>
                    </div>
                </For>

                <Show when={ laid.cards.length === 0 && !over }>
                    { () =>
                        <div class="hokm-centre" aria-hidden="true">
                            <Icon name="crest-crown" size={ 18 } class="text-gold" />
                            <span class="font-display text-ui-lg font-bold">{ locale.t('games.hokm.name') }</span>
                            <Show when={ view?.trump !== undefined }>
                                { () =>
                                    <span class="flex items-center gap-1 text-ui-2xs">
                                        <Icon name={ SUIT_ICON[view!.trump!] } size={ 12 } class={ RED_SUITS.includes(view!.trump!) ? 'text-danger' : 'text-white' } />
                                        <span>{ locale.t(`hokm.suit.${ view!.trump! }` as never) }</span>
                                    </span>
                                }
                            </Show>
                            <span class="text-ui-2xs font-semibold text-white">{ says }</span>
                        </div>
                    }
                </Show>

                <For each={ laid.cards } key={ (one) => one.card } let={ one }>
                    <div
                        class="hokm-trick"
                        data-took={ one.seat === laid.took ? 'true' : 'false' }
                        style={ `--dx: ${ REACH[one.side][0] }; --dy: ${ REACH[one.side][1] }; --tilt: ${ ((one.card * 37) % 11) - 5 }deg` }
                        aria-hidden="true"
                    >
                        <CardFace card={ one.card } />
                    </div>
                </For>

                <ul class="sr-only">
                    <For each={ laid.cards } key={ (one) => one.card } let={ one }>
                        <li>{ locale.t('hokm.played', { name: nameOf(one.seat), card: cardSays(one.card) }) }</li>
                    </For>
                </ul>
            </div>

            <Show when={ !over }>
            { () =>
        <section class="hokm-play flex min-w-0 flex-col gap-3">
            <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
                <p class="min-w-0 flex-1 basis-[10rem] text-ui-lg font-semibold text-text" aria-live="polite">{ says }</p>
                <TurnClock deadline={ game.deadline } over={ over } />
                <Show when={ (view?.hand.length ?? 0) > 1 }>
                    { () =>
                        <Button variant="secondary" size="sm" leading="sort" pressed={ sorted } onClick={ () => sorted = !sorted }>
                            { locale.t('hokm.sort') }
                        </Button>
                    }
                </Show>
            </div>

            <Show when={ view?.phase === 'trump' && view.hakem === mine }>
                { () =>
                    <div class="flex flex-col gap-2">
                        <p class="label text-ui-xs text-faint">{ locale.t('hokm.trump.choose') }</p>
                        <ul class="grid grid-cols-2 gap-2 @md:grid-cols-4">
                            <For each={ [...SUITS] } key={ (suit) => suit } let={ suit }>
                                <li class="flex min-w-0">
                                    <button
                                        type="button"
                                        class="flex min-h-14 w-full cursor-pointer items-center justify-center gap-2 rounded-tile border border-line-strong bg-raised px-3 text-ui-base font-semibold text-text transition hover:border-accent hover:bg-lifted disabled:cursor-not-allowed disabled:opacity-50"
                                        disabled={ board.busy() }
                                        onClick={ () => void callTrump(suit) }
                                    >
                                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-text">
                                            <Icon name={ SUIT_ICON[suit] } size={ 18 } class={ RED_SUITS.includes(suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                        </span>
                                        <span class="truncate">{ locale.t(`hokm.suit.${ suit }` as never) }</span>
                                    </button>
                                </li>
                            </For>
                        </ul>
                    </div>
                }
            </Show>

            <For each={ rows } key={ (_, index) => index } let={ row }>
                <ul class="hokm-hand" style={ `--n: ${ row.length }` } aria-label={ locale.t('hokm.hand') }>
                    <For each={ row } key={ (card) => card } let={ card } index={ index }>
                        <li style={ fan(index, row.length) }>
                            <button
                                type="button"
                                class="card-hold"
                                data-legal={ myTurn && legal.has(card) ? 'true' : (myTurn ? 'false' : 'idle') }
                                disabled={ !legal.has(card) || board.busy() }
                                aria-label={ locale.t('hokm.play', { card: cardSays(card) }) }
                                onClick={ () => void playCard(card) }
                            >
                                <CardFace card={ card } />
                            </button>
                        </li>
                    </For>
                </ul>
            </For>

            <Show when={ myTurn && legal.size < (view?.hand.length ?? 0) }>
                { () => <p class="text-center text-ui-xs text-muted">{ locale.t('hokm.follow') }</p> }
            </Show>
        </section>
            }
            </Show>

            <aside class="hokm-side" aria-label={ locale.t('hokm.summary') }>
                <section class="hokm-tile">
                    <h3 class="label text-ui-2xs text-faint">{ locale.t('hokm.trump') }</h3>
                    <Show
                        when={ view?.trump !== undefined }
                        fallback={ <p class="text-ui-sm text-muted">{ locale.t('hokm.trump.none') }</p> }
                    >
                        { () =>
                            <p class="flex items-center gap-2">
                                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-text">
                                    <Icon name={ SUIT_ICON[view!.trump!] } size={ 20 } class={ RED_SUITS.includes(view!.trump!) ? 'text-danger-fill' : 'text-bright-ink' } />
                                </span>
                                <span class="text-ui-base font-semibold text-text">{ locale.t(`hokm.suit.${ view!.trump! }` as never) }</span>
                            </p>
                        }
                    </Show>
                    <p class="flex min-w-0 items-center gap-1.5 text-ui-2xs text-muted">
                        <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" />
                        <span class="truncate" dir="auto">
                            { view!.hakem === mine ? locale.t('hokm.hakem.you') : locale.t('hokm.hakem', { name: nameOf(view!.hakem) }) }
                        </span>
                    </p>
                </section>

                <section class="hokm-tile">
                    <h3 class="label text-ui-2xs text-faint">{ locale.t('hokm.score') }</h3>
                    <dl class="flex flex-col gap-2">
                        <For each={ sides } key={ (side) => side.index } let={ side }>
                            <div class="flex min-w-0 items-baseline justify-between gap-2">
                                <dt class={ () => [ 'min-w-0 truncate text-ui-xs', SIDE_TONE[side.index % SIDE_TONE.length] ].join(' ') } dir="auto">{ side.names }</dt>
                                <dd class="flex shrink-0 flex-col items-end">
                                    <span class="tally text-ui-sm font-bold text-text">{ locale.t('hokm.points', { points: locale.n(side.points), target: locale.n(view!.target) }) }</span>
                                    <span class="tally text-ui-2xs text-muted">{ locale.plural('hokm.tricks', side.tricks) }</span>
                                </dd>
                            </div>
                        </For>
                    </dl>
                </section>

                <section class="hokm-tile">
                    <h3 class="label text-ui-2xs text-faint">{ locale.t('hokm.lastTrick') }</h3>
                    <Show
                        when={ view?.took !== undefined }
                        fallback={ <p class="text-ui-sm text-muted">{ locale.t('hokm.lastTrick.none') }</p> }
                    >
                        { () =>
                            <div class="flex flex-col gap-1.5">
                                <ul class="hokm-last" aria-hidden="true">
                                    <For each={ view!.took!.cards } key={ (card) => card } let={ card }>
                                        <li><CardFace card={ card } /></li>
                                    </For>
                                </ul>
                                <p class="truncate text-ui-2xs text-muted" dir="auto">{ locale.t('hokm.table.took', { name: nameOf(view!.took!.seat) }) }</p>
                            </div>
                        }
                    </Show>
                </section>
            </aside>
        </div>
            }
        </Show>

        <Show when={ over }>
            { () => <MatchResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } /> }
        </Show>


        <Show when={ !over && mine !== undefined }>
            { () =>
                <div class="flex justify-center">
                    <Button variant="ghost" size="sm" leading="report" onClick={ () => void board.resign() }>
                        { locale.t('match.resign') }
                    </Button>
                </div>
            }
        </Show>
    </div>
}
