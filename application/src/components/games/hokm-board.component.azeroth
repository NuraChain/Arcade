import { untrack } from 'azerothjs';

import CardFace from './card-face.component.azeroth';
import CoachLine from './coach-line.component.azeroth';
import TableResult from './table-result.component.azeroth';
import TurnClock from './turn-clock.component.azeroth';
import TablePlate from './table-plate.component.azeroth';
import { plateTag } from './plate-tag.ts';
import Button from '../ui/button.component.azeroth';
import Icon from '../../icons/icon.component.azeroth';
import { FACE_KEY, SUITS, SUIT_ICON, arrangeHand, rankOf, suitOf, type Suit } from '../../data/cards.ts';
import { aroundTable, type Chair } from './table-seats.ts';
import { hokmOf } from '../../data/match.ts';
import { coachOf, outcomeOf } from '../../game/helpers/hokm.ts';
import { EMPTY, beatsOf, feltOf, gatherLength, gatherOrder, overflows, scaled, type Beat, type Felt, type HokmMove, type Laid } from '../../game/hokm-beats.ts';
import { EASE, TIMING, centreOf, fly, land, rectIn, type Rect } from '../../game/motion.ts';
import { createSound, type SoundHandle } from '../../game/sound.ts';
import { haptic } from '../../lib/haptics.ts';
import { runtime } from '../../lib/runtime.ts';
import { useBoard, type MatchEvent } from '../../stores/match.store.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSettings } from '../../stores/settings.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import type { MatchView } from '../../api.ts';

type Side = 'bottom' | 'top' | 'left' | 'right' | 'top-left' | 'top-right';

const FOUR: readonly Side[] = ['bottom', 'right', 'top', 'left'];

const REACH: Record<Side, readonly [number, number]> = {
    'bottom': [0, 1],
    'top': [0, -1],
    'left': [-1, 0],
    'right': [1, 0],
    'top-left': [-0.8, -0.6],
    'top-right': [0.8, -0.6]
};

const SIDE_TONE = ['text-accent', 'text-gold', 'text-live'];

const RED_SUITS: readonly Suit[] = ['hearts', 'diamonds'];

const ROW_LIMIT = 13;

const TWO_ROWS_FROM = 480;

const WIDE_FROM = 704;

const WIDE_RATIO = 1.5;

const BAR_BESIDE = 400;

const CARD_MIN = 38.4;

const CARD_MAX = 84;

const BACKS_SHOWN = 10;

const JUMP_OVER = 3000;

const FAST_OVER = 1500;

const BACK_W = 30;

const tiltOf = (card: number): number => ((card * 37) % 11) - 5;

const cardNode = (card: number | null, width: number): HTMLElement =>
{
    const box = document.createElement('div');
    const face = document.createElement('span');

    box.style.setProperty('--card-w', `${ width }px`);
    box.style.setProperty('--back-w', `${ width }px`);

    if (card === null)
    {
        face.className = 'card-back';
    }
    else
    {
        face.className = 'card-face';
        face.style.setProperty('--at-rank', String(card % 13));
        face.style.setProperty('--at-suit', String(Math.floor(card / 13)));
    }

    box.append(face);

    return box;
};

export default component HokmBoard(props: { match: MatchView; starting?: boolean; onAgain?: () => void; speech?: Record<string, string>; turnMs?: number })
{
    const locale = useLocale();
    const board = useBoard();
    const device = useDevice();
    const people = usePeople();
    const settings = useSettings();

    state sorted = false;

    state picked: number | null = null;

    state aimed: number | null = null;

    state shown: Felt | null = null;

    state landing: readonly number[] = [];

    state banner: { points: number; kot: boolean; ours: boolean } | null = null;

    state sending: number | null = null;

    derived game = props.match;

    derived view = hokmOf(game);

    derived over = game.finishedAt !== undefined;

    derived mine = game.mine;

    derived whoAt = (seat: number): string => game.players.find((one) => one.seat === seat)?.who ?? '';

    derived nameOf = (seat: number): string =>
    {
        const who = whoAt(seat);

        if (who === '')
        {
            return '';
        }

        if (seat === mine)
        {
            return locale.t('match.you');
        }

        const person = people.byHandle(who);

        return person === null ? who : locale.text(person.displayName);
    };

    derived says = ((): string =>
    {
        if (view === null)
        {
            return '';
        }

        if (over)
        {
            return game.winner === undefined
                ? locale.t('match.abandoned')
                : (game.winner === mine ? locale.t('match.won.you') : locale.t('match.won.them', { name: nameOf(game.winner) }));
        }

        if (view.phase === 'trump')
        {
            return view.hakem === mine
                ? locale.t('hokm.trump.yours')
                : locale.t('hokm.trump.theirs', { name: nameOf(view.hakem) });
        }

        return view.turn === mine
            ? locale.t('match.turn.yours')
            : locale.t('match.turn.theirs', { name: nameOf(view.turn) });
    })();

    derived chairs = aroundTable(game.seats, mine ?? null);

    const sideOf = (chair: Chair): Side =>
    {
        if (chair.place === 0)
        {
            return 'bottom';
        }

        if (game.seats === 2)
        {
            return 'top';
        }

        if (game.seats === 3)
        {
            return chair.place === 1 ? 'top-right' : 'top-left';
        }

        return FOUR[chair.place] ?? 'top';
    };

    derived plates = view === null ? [] : view.seats.map((row) =>
    {
        const chair = chairs[row.seat];

        return {
            row,
            side: sideOf(chair),
            backs: row.seat === mine ? [] : Array.from({ length: Math.min(row.held, BACKS_SHOWN) }, (_, index) => index)
        };
    });

    derived felt = shown ?? (view === null ? EMPTY : feltOf(view.trick, view.lead, game.seats));

    derived laid = {
        cards: felt.cards.map((one: Laid) => ({ ...one, side: sideOf(chairs[one.seat]) })),
        took: felt.took
    };

    derived legal = new Set(view === null ? [] : view.plays);

    derived myTurn = view !== null && !over && view.phase === 'tricks' && view.turn === mine;

    derived acting = view !== null && !over && mine !== undefined && (view.phase === 'trump' ? view.hakem === mine : view.turn === mine);

    derived chosen = picked !== null && myTurn && legal.has(picked) ? picked : null;

    derived choosing = view !== null && !over && view.phase === 'trump' && view.hakem === mine;

    derived tagOf = (seat: number): ReturnType<typeof plateTag> => plateTag(locale, game.players.find((one) => one.seat === seat), over);

    derived hints = settings.settings();

    derived outcomeFor = (card: number): string | null =>
    {
        const says = hints.hintOutcome && myTurn && legal.has(card) && view !== null ? outcomeOf(card, view, game.seats) : null;

        return says === null ? null : locale.t(says.key);
    };

    derived aimedAt = chosen ?? aimed;

    derived outcome = aimedAt === null ? null : outcomeFor(aimedAt);

    derived tip = view === null || over ? null : coachOf(view, mine);

    derived hand = view === null ? [] : (sorted ? arrangeHand(view.hand, view.trump) : [...view.hand]).filter((card) => card !== sending);

    state room = { width: 0, height: 0 };

    derived rows = ((): number[][] =>
    {
        if (hand.length === 0)
        {
            return [];
        }

        if (hand.length <= ROW_LIMIT || room.height < TWO_ROWS_FROM)
        {
            return [hand];
        }

        const wide = room.width >= WIDE_FROM && room.width >= room.height * WIDE_RATIO;
        const reach = wide ? room.width - BAR_BESIDE : room.width;
        const card = Math.min(CARD_MAX, Math.max(CARD_MIN, Math.min(room.width * 0.125, room.height * 0.1)));
        const step = (reach - card - 20) / (hand.length - 1);

        return step >= card * 0.42 ? [hand] : [hand.slice(0, Math.ceil(hand.length / 2)), hand.slice(Math.ceil(hand.length / 2))];
    })();

    derived handTricks = view === null ? [] : view.points.map((_, side) =>
        view!.seats.filter((row) => row.side === side).reduce((sum, row) => sum + row.tricks, 0));

    derived sides = view === null ? [] : view.points.map((points, index) => ({
        index,
        points,
        tricks: handTricks[index] ?? 0,
        names: locale.list(view!.seats.filter((row) => row.side === index).map((row) => nameOf(row.seat)))
    }));

    const fan = (index: number, count: number): string =>
    {
        const middle = (count - 1) / 2;
        const tilt = middle === 0 ? 0 : (index - middle) / middle;

        return `--i: ${ index }; --n: ${ count }; --t: ${ tilt.toFixed(3) }`;
    };

    const rankSays = (card: number): string =>
    {
        const rank = rankOf(card);

        return FACE_KEY[rank] === undefined ? locale.n(Number(rank)) : locale.t(FACE_KEY[rank]);
    };

    const cardSays = (card: number): string =>
        locale.t('hokm.card', { rank: rankSays(card), suit: locale.t(`hokm.suit.${ suitOf(card) }` as never) });

    const cardLabel = (card: number): string =>
    {
        const play = locale.t('hokm.play', { card: cardSays(card) });
        const says = outcomeFor(card);

        return says === null ? play : `${ play }. ${ says }`;
    };

    const aim = (card: number): void =>
    {
        aimed = card;
    };

    const unaim = (card: number): void =>
    {
        aimed = aimed === card ? null : aimed;
    };

    const playCard = async (card: number): Promise<void> =>
    {
        if (!legal.has(card))
        {
            return;
        }

        const face = arena?.querySelector(`.card-hold[data-card="${ card }"] .card-face`) ?? null;

        if (layer !== null && face !== null)
        {
            origins.set(card, rectIn(layer, face));
        }

        picked = null;
        aimed = null;
        haptic('select');

        const seat = untrack(() => mine);
        const ahead = seat !== undefined && shown === null && holding === null && busyUntil <= runtime().clock.now();

        if (ahead)
        {
            predict(card, seat);
        }

        const outcome = await board.play({ kind: 'hokm', verb: 'card', card });

        if (ahead && sending === card && (outcome === 'stale' || outcome === 'failed'))
        {
            jump();
        }
    };

    const touchCard = (card: number): void =>
    {
        if (!legal.has(card))
        {
            return;
        }

        if (!device.coarse() || chosen === card)
        {
            void playCard(card);
            return;
        }

        picked = card;
        haptic('tick');
    };

    const callTrump = async (suit: Suit): Promise<void> =>
    {
        if (mine !== undefined)
        {
            haptic('select');
        }

        await board.play({ kind: 'hokm', verb: 'trump', suit });
    };

    let arena: HTMLElement | null = null;
    let layer: HTMLElement | null = null;
    let sound: SoundHandle | null = null;
    let timers: (() => void)[] = [];
    let busyUntil = 0;
    let generation = 0;
    let matchId = untrack(() => props.match.id);
    let lastRev = untrack(() => props.match.rev);
    let heardSeq = untrack(() => board.events().seq);
    let wasActing = untrack(() => acting);
    let settled: Felt = untrack(() => felt);
    let heldSince: number | null = null;
    let holding: (() => void) | null = null;
    const origins = new Map<number, Rect>();

    const viewFelt = (): Felt =>
    {
        const held = hokmOf(props.match);

        return held === null ? EMPTY : feltOf(held.trick, held.lead, props.match.seats);
    };

    const later = (ms: number, run: () => void): void =>
    {
        const stop = runtime().clock.after(Math.max(0, ms), () =>
        {
            timers = timers.filter((one) => one !== stop);
            run();
        });

        timers.push(stop);
    };

    const quiet = (): boolean => device.reducedMotion();

    const stopAll = (): void =>
    {
        timers.forEach((stop) => stop());
        timers = [];
        holding?.();
        holding = null;
        heldSince = null;

        if (layer !== null)
        {
            land(layer);
        }
    };

    const jump = (): void =>
    {
        stopAll();
        generation += 1;
        busyUntil = 0;
        sending = null;
        shown = null;
        landing = [];
        banner = null;
        settled = viewFelt();
    };

    const reader = (): { seat: number | null; seats: number; sideOf: (seat: number) => number } => ({
        seat: props.match.mine ?? null,
        seats: props.match.seats,
        sideOf: (seat: number) => hokmOf(props.match)?.seats.find((row) => row.seat === seat)?.side ?? seat % 2
    });

    const find = (selector: string): HTMLElement | null => arena?.querySelector<HTMLElement>(selector) ?? null;

    const panOf = (rect: Rect | null): number =>
    {
        const width = layer?.clientWidth ?? 0;

        return rect === null || width === 0 ? 0 : Math.max(-0.5, Math.min(0.5, centreOf(rect).x / width - 0.5));
    };

    const seatRect = (seat: number): Rect | null =>
    {
        const place = find(`.hokm-seat[data-seat="${ seat }"] .hokm-pile`) ?? find(`.hokm-seat[data-seat="${ seat }"] .table-plate`);

        return place === null || layer === null ? null : rectIn(layer, place);
    };

    const sized = (around: Rect, width: number, height: number): Rect =>
    {
        const middle = centreOf(around);

        return { x: middle.x - width / 2, y: middle.y - height / 2, width, height };
    };

    const flyCard = (card: number, seat: number, duration: number): void =>
    {
        const target = find(`.hokm-trick[data-card="${ card }"]`);

        if (layer === null || target === null)
        {
            return;
        }

        const to = rectIn(layer, target);
        const own = seat === props.match.mine ? origins.get(card) : undefined;
        const from = own ?? sized(seatRect(seat) ?? to, to.width * 0.6, to.height * 0.6);

        origins.delete(card);
        fly(layer, cardNode(card, to.width), from, to, {
            duration,
            easing: EASE.fly,
            toRotate: tiltOf(card),
            fromOpacity: own === undefined ? 0 : 1,
            reduced: quiet()
        });
        sound?.play('card-slide', { pan: panOf(from) });
    };

    const gatherTo = (seat: number, cards: readonly Laid[]): void =>
    {
        const plate = find(`.hokm-seat[data-seat="${ seat }"] .table-plate`);
        const target = plate === null || layer === null ? null : rectIn(layer, plate);

        sound?.play('card-gather', { pan: panOf(target) });

        if (layer === null || target === null || quiet())
        {
            return;
        }

        const measured = cards.map((one) =>
        {
            const real = find(`.hokm-trick[data-card="${ one.card }"]`);

            return real === null ? null : { one, from: rectIn(layer!, real) };
        });

        measured.forEach((entry, index) =>
        {
            if (entry === null)
            {
                return;
            }

            const { one, from } = entry;

            fly(layer!, cardNode(one.card, from.width), from, sized(target, from.width, from.height), {
                duration: TIMING.GATHER,
                easing: EASE.gather,
                delay: index * TIMING.GATHER_GAP,
                fromRotate: tiltOf(one.card),
                toScale: 0.45,
                toOpacity: 0,
                fadeFrom: 0.6
            });
        });
    };

    const dealTo = (from: number, to: readonly number[], gap: number, duration: number, shuffle: boolean): void =>
    {
        if (shuffle)
        {
            sound?.play('card-shuffle', { gain: 0.7 });
        }

        to.forEach((seat, index) =>
        {
            later((shuffle ? 450 : 0) + index * gap, () =>
            {
                const start = seatRect(from);
                const hand = seat === props.match.mine ? find('.hokm-hand') : null;
                const end = hand !== null && layer !== null ? sized(rectIn(layer, hand), BACK_W, BACK_W * 288 / 204) : seatRect(seat);
                const box = end === null ? null : sized(end, BACK_W, BACK_W * 288 / 204);

                sound?.play('card-slide', { pan: panOf(box), rate: 0.97 + (index % 3) * 0.04 });

                if (layer === null || start === null || box === null || quiet())
                {
                    return;
                }

                fly(layer, cardNode(null, BACK_W), sized(start, BACK_W * 0.55, BACK_W * 0.55 * 288 / 204), box, {
                    duration,
                    easing: EASE.fly,
                    toOpacity: 0,
                    fadeFrom: 0.8
                });
            });
        });
    };

    const run = (beat: Beat): void =>
    {
        const spectator = props.match.mine === undefined;

        if (beat.kind === 'card')
        {
            const held = shown ?? EMPTY;

            shown = { cards: [...held.cards, { card: beat.card, seat: beat.seat }], took: held.took };
            landing = [...landing, beat.card];
            flyCard(beat.card, beat.seat, beat.duration);

            if (quiet())
            {
                later(TIMING.FADE, () => landing = landing.filter((card) => card !== beat.card));
            }

            return;
        }

        if (beat.kind === 'land')
        {
            landing = landing.filter((card) => card !== beat.card);
            sound?.play('card-place', { gain: 0.9 });
            return;
        }

        if (beat.kind === 'took')
        {
            shown = { cards: (shown ?? EMPTY).cards, took: beat.seat };

            if (beat.ours && !spectator)
            {
                sound?.play('trick');
                haptic('select');
            }

            return;
        }

        if (beat.kind === 'gather')
        {
            gatherTo(beat.seat, beat.cards);
            shown = EMPTY;
            return;
        }

        if (beat.kind === 'trump')
        {
            sound?.play('trump');
            sound?.play('card-place', { gain: 0.6 });
            return;
        }

        if (beat.kind === 'deal')
        {
            dealTo(beat.from, beat.to, beat.gap, beat.duration, beat.shuffle);
            return;
        }

        if (beat.kind === 'hand')
        {
            banner = { points: beat.points, kot: beat.kot, ours: beat.ours };
            later(TIMING.BANNER, () => banner = null);

            if (beat.kot)
            {
                sound?.play('win');
            }
            else if (beat.ours)
            {
                sound?.play('hand-won');
            }

            if (beat.ours && !spectator)
            {
                haptic(beat.kot ? 'kot' : 'hand');
            }

            return;
        }

        if (beat.kind === 'finish' && beat.won && !spectator)
        {
            sound?.play('win');
            haptic('win');
        }
    };

    const predict = (card: number, seat: number): void =>
    {
        const table = viewFelt();

        generation += 1;
        sending = card;
        shown = table;
        settled = { cards: [...table.cards, { card, seat }], took: null };
        busyUntil = runtime().clock.now() + TIMING.FLY;
        run({ at: 0, kind: 'card', card, seat, duration: TIMING.FLY });
        later(TIMING.FLY, () => run({ at: 0, kind: 'land', card, seat }));
    };

    const release = (round: number): void =>
    {
        if (generation === round)
        {
            shown = null;
            landing = [];
            settled = viewFelt();
            busyUntil = 0;
        }
    };

    const hold = (round: number, tookAt: number): void =>
    {
        const gatherAt = tookAt + TIMING.HOLD;

        heldSince = tookAt;
        busyUntil = gatherAt + gatherLength(settled.cards.length);
        holding = runtime().clock.after(Math.max(0, gatherAt - runtime().clock.now()), () =>
        {
            const table = settled;

            holding = null;
            heldSince = null;

            if (table.took === null)
            {
                return;
            }

            const order = gatherOrder(table.cards, table.took);

            run({ at: 0, kind: 'gather', seat: table.took, cards: order });
            settled = EMPTY;
            later(gatherLength(order.length) + 40, () => release(round));
        });
    };

    const feed = (events: readonly MatchEvent[]): void =>
    {
        const fresh = events.filter((one) => one.rev > lastRev && one.log.kind === 'hokm');

        if (fresh.length === 0)
        {
            return;
        }

        const gap = fresh[0].rev !== lastRev + 1;
        const now = runtime().clock.now();
        const heard = fresh.flatMap((one) => (one.log.kind === 'hokm' ? one.log.moves : [])) as HokmMove[];
        const echo = sending === null ? -1 : heard.findIndex((move) => move.e === 'card' && move.card === sending);
        const moves = echo < 0 ? heard : heard.filter((_, index) => index !== echo);
        let start = Math.max(now, busyUntil);
        let heldFor = 0;

        lastRev = Math.max(lastRev, ...fresh.map((one) => one.rev));

        if (holding !== null)
        {
            holding();
            holding = null;
            start = Math.max(now, heldSince ?? now);
            heldFor = Math.max(0, now - (heldSince ?? now));
            heldSince = null;
        }

        const behind = Math.max(0, start - now);

        if (sending !== null && echo < 0)
        {
            jump();
            return;
        }

        sending = null;

        if (gap || behind > JUMP_OVER || overflows(fresh.length, moves) || layer === null
            || (typeof document !== 'undefined' && document.visibilityState === 'hidden'))
        {
            jump();
            return;
        }

        const plan = beatsOf(moves, settled, reader(), heldFor);
        const timeline = behind > FAST_OVER ? scaled(plan, 0.5) : plan;
        const round = generation + 1;

        if (shown === null)
        {
            shown = settled;
        }

        generation = round;
        settled = timeline.felt;
        busyUntil = start + timeline.ends;

        for (const beat of timeline.beats)
        {
            later(start + beat.at - now, () => run(beat));
        }

        if (timeline.held !== null)
        {
            hold(round, start + timeline.held);
            return;
        }

        later(busyUntil - now + 40, () => release(round));
    };

    effect
    {
        const id = props.match.id;

        untrack(() =>
        {
            if (id === matchId)
            {
                return;
            }

            matchId = id;
            jump();
            lastRev = props.match.rev;
            heardSeq = board.events().seq;
            wasActing = acting;
        });
    }

    effect
    {
        const batch = board.events();

        untrack(() =>
        {
            if (batch.seq <= heardSeq)
            {
                return;
            }

            heardSeq = batch.seq;
            feed(batch.events);
        });
    }

    effect
    {
        const yours = acting;

        untrack(() =>
        {
            if (yours && !wasActing)
            {
                sound?.play('turn', { urgent: true });
                haptic('ready');
            }

            wasActing = yours;
        });
    }

    effect
    {
        const on = settings.settings().sound;

        untrack(() => sound?.setEnabled(on));
    }

    mount
    {
        sound = createSound(untrack(() => settings.settings().sound));

        const watcher = typeof ResizeObserver === 'undefined' || arena === null
            ? null
            : new ResizeObserver(([entry]) =>
            {
                const { width, height } = entry.contentRect;

                if (Math.abs(width - room.width) > 1 || Math.abs(height - room.height) > 1)
                {
                    room = { width, height };
                }
            });

        if (watcher !== null && arena !== null)
        {
            watcher.observe(arena);
        }

        return () =>
        {
            watcher?.disconnect();
            stopAll();
            sound?.dispose();
            sound = null;
        };
    }

    <div data-rev={ props.match.rev } class="table-stage hokm-stage" ref={ (element) => arena = element }>
        <div class="table-grid">
        <Show when={ view !== null }>
            { () =>
                <div class="table-fit">
                    <div class="table-surface hokm-table">
                        <div class="hokm-felt-info" aria-hidden="true">
                            <span class="hokm-chip">
                                <Show
                                    when={ view?.trump !== undefined }
                                    fallback={ <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" /> }
                                >
                                    { () =>
                                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-text">
                                            <Icon name={ SUIT_ICON[view!.trump!] } size={ 12 } class={ RED_SUITS.includes(view!.trump!) ? 'text-danger-fill' : 'text-bright-ink' } />
                                        </span>
                                    }
                                </Show>
                                <span>{ locale.t('hokm.round', { n: locale.n(view!.round) }) }</span>
                            </span>
                            <span class="hokm-chip">
                                <For each={ sides } key={ (side) => side.index } let={ side }>
                                    <span class="flex items-center gap-1">
                                        <span class={ () => [ 'h-2 w-2 rounded-full bg-current', SIDE_TONE[side.index % SIDE_TONE.length] ].join(' ') }></span>
                                        <span class="tally font-bold text-white">{ locale.n(side.points) }</span>
                                    </span>
                                </For>
                                <span class="tally text-white/60">/{ locale.n(view!.target) }</span>
                            </span>
                        </div>

                        <For each={ plates } key={ (plate) => plate.row.seat } let={ plate }>
                            <div class="hokm-seat" data-side={ plate.side } data-seat={ plate.row.seat }>
                                <TablePlate
                                    who={ whoAt(plate.row.seat) }
                                    name={ nameOf(plate.row.seat) }
                                    turn={ !over && plate.row.seat === view!.turn }
                                    remainingMs={ game.remainingMs }
                                    turnMs={ props.turnMs }
                                    dim={ plate.row.out }
                                    tag={ tagOf(plate.row.seat)?.text }
                                    tone={ tagOf(plate.row.seat)?.tone }
                                    bubble={ props.speech?.[whoAt(plate.row.seat)] }
                                    below={ plate.side !== 'bottom' }
                                    anchor={ plate.side.endsWith('right') ? 'end' : (plate.side.endsWith('left') ? 'start' : 'centre') }
                                    marker={ plate.row.seat === view!.hakem ? <Icon name="crest-crown" size={ 14 } class="text-gold" /> : undefined }
                                    facts={
                                        <span class="contents">
                                            <span class="flex items-center gap-0.5" aria-hidden="true">
                                                <Icon name="trophy" size={ 11 } class={ SIDE_TONE[plate.row.side % SIDE_TONE.length] } />
                                                <span class="tally">{ locale.n(plate.row.tricks) }</span>
                                            </span>
                                            <span class="flex items-center gap-0.5" aria-hidden="true">
                                                <Icon name="cards" size={ 11 } />
                                                <span class="tally">{ locale.n(plate.row.held) }</span>
                                            </span>
                                            <span class="sr-only">{ locale.plural('hokm.tricks', plate.row.tricks) }, { locale.plural('hokm.held', plate.row.held) }</span>
                                        </span>
                                    }
                                />
                                <Show when={ plate.backs.length > 0 }>
                                    { () =>
                                        <span class="hokm-pile" style={ `--n: ${ plate.backs.length }` } aria-hidden="true">
                                            <For each={ plate.backs } key={ (back) => back } let={ back }>
                                                <span class="card-back" style={ `--i: ${ back }` }></span>
                                            </For>
                                        </span>
                                    }
                                </Show>
                            </div>
                        </For>

                        <Show when={ laid.cards.length === 0 && !over && !choosing }>
                            { () =>
                                <div class="hokm-centre" dir={ locale.dir() } aria-hidden="true">
                                    <Icon name="crest-crown" size={ 18 } class="text-gold" />
                                    <span class="font-display text-ui-lg font-bold">{ locale.t('games.hokm.name') }</span>
                                    <span class="text-ui-2xs font-semibold text-gold">{ locale.t('hokm.round', { n: locale.n(view!.round) }) }</span>
                                    <Show when={ view?.trump !== undefined }>
                                        { () =>
                                            <span class="flex items-center gap-1 text-ui-2xs">
                                                <Icon name={ SUIT_ICON[view!.trump!] } size={ 12 } class={ RED_SUITS.includes(view!.trump!) ? 'text-danger' : 'text-white' } />
                                                <span>{ locale.t(`hokm.suit.${ view!.trump! }` as never) }</span>
                                            </span>
                                        }
                                    </Show>
                                    <span class="text-ui-2xs font-semibold text-white">{ says }</span>
                                </div>
                            }
                        </Show>

                        <Show when={ choosing }>
                            { () =>
                                <div class="hokm-choose" dir={ locale.dir() }>
                                    <p class="hokm-choose-title">{ locale.t('hokm.trump.choose') }</p>
                                    <ul class="grid grid-cols-2 gap-2">
                                        <For each={ [...SUITS] } key={ (suit) => suit } let={ suit }>
                                            <li class="flex min-w-0">
                                                <button
                                                    type="button"
                                                    class="flex min-h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-tile border border-white/15 bg-void/85 px-2 text-ui-sm font-semibold text-text shadow-2 transition hover:border-accent hover:bg-lifted disabled:cursor-not-allowed disabled:opacity-50"
                                                    disabled={ board.busy() }
                                                    onClick={ () => void callTrump(suit) }
                                                >
                                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-text">
                                                        <Icon name={ SUIT_ICON[suit] } size={ 16 } class={ RED_SUITS.includes(suit) ? 'text-danger-fill' : 'text-bright-ink' } />
                                                    </span>
                                                    <span class="truncate">{ locale.t(`hokm.suit.${ suit }` as never) }</span>
                                                </button>
                                            </li>
                                        </For>
                                    </ul>
                                </div>
                            }
                        </Show>

                        <For each={ laid.cards } key={ (one) => one.card } let={ one }>
                            <div
                                class="hokm-trick"
                                data-card={ one.card }
                                data-landing={ landing.includes(one.card) ? 'true' : undefined }
                                data-took={ one.seat === laid.took ? 'true' : 'false' }
                                style={ `--dx: ${ REACH[one.side][0] }; --dy: ${ REACH[one.side][1] }; --tilt: ${ ((one.card * 37) % 11) - 5 }deg` }
                                aria-hidden="true"
                            >
                                <CardFace card={ one.card } />
                            </div>
                        </For>

                        <Show when={ view?.took !== undefined }>
                            { () =>
                                <div class="hokm-last-tile" aria-hidden="true">
                                    <span class="hokm-last-title">{ locale.t('hokm.lastTrick') }</span>
                                    <ul class="hokm-last">
                                        <For each={ view!.took!.cards } key={ (card) => card } let={ card }>
                                            <li><CardFace card={ card } /></li>
                                        </For>
                                    </ul>
                                </div>
                            }
                        </Show>

                        <Show when={ banner !== null }>
                            { () =>
                                <div class="hokm-banner" data-kot={ banner!.kot ? 'true' : 'false' } data-ours={ banner!.ours ? 'true' : 'false' } dir={ locale.dir() } aria-hidden="true">
                                    <Show when={ banner!.kot } fallback={ <span class="tally">+{ locale.n(banner!.points) }</span> }>
                                        { () => <span>{ locale.t('hokm.kot') }</span> }
                                    </Show>
                                </div>
                            }
                        </Show>

                        <ul class="sr-only">
                            <For each={ laid.cards } key={ (one) => one.card } let={ one }>
                                <li>{ locale.t('hokm.played', { name: nameOf(one.seat), card: cardSays(one.card) }) }</li>
                            </For>
                        </ul>

                        <aside class="hokm-side sr-only" aria-label={ locale.t('hokm.summary') }>
                            <section>
                                <h3>{ locale.t('hokm.trump') }</h3>
                                <p>{ view?.trump === undefined ? locale.t('hokm.trump.none') : locale.t(`hokm.suit.${ view!.trump! }` as never) }</p>
                                <p>{ view!.hakem === mine ? locale.t('hokm.hakem.you') : locale.t('hokm.hakem', { name: nameOf(view!.hakem) }) }</p>
                            </section>
                            <section>
                                <h3>{ locale.t('hokm.score') }</h3>
                                <p>{ locale.t('hokm.round', { n: locale.n(view!.round) }) }</p>
                                <dl>
                                    <For each={ sides } key={ (side) => side.index } let={ side }>
                                        <div>
                                            <dt>{ side.names }</dt>
                                            <dd>
                                                <span>{ locale.t('hokm.points', { points: locale.n(side.points), target: locale.n(view!.target) }) }</span>
                                                <span>{ locale.plural('hokm.tricks', side.tricks) }</span>
                                            </dd>
                                        </div>
                                    </For>
                                </dl>
                            </section>
                            <section>
                                <h3>{ locale.t('hokm.lastTrick') }</h3>
                                <p>{ view?.took === undefined ? locale.t('hokm.lastTrick.none') : locale.t('hokm.table.took', { name: nameOf(view!.took!.seat) }) }</p>
                            </section>
                        </aside>
                    </div>
                </div>
            }
        </Show>

        <Show when={ view !== null && !over && rows.length > 0 }>
            { () =>
                <div class="table-hand hokm-hands" style={ `--rows: ${ rows.length }` }>
                    <For each={ rows } key={ (_, index) => index } let={ row }>
                        <ul class="hokm-hand" style={ `--n: ${ row.length }` } aria-label={ locale.t('hokm.hand') }>
                            <For each={ row } key={ (card) => card } let={ card } index={ index }>
                                <li style={ fan(index, row.length) }>
                                    <button
                                        type="button"
                                        class="card-hold"
                                        data-card={ card }
                                        data-legal={ myTurn ? (hints.hintMoves ? (legal.has(card) ? 'true' : 'false') : 'hidden') : 'idle' }
                                        data-picked={ chosen === card ? 'true' : undefined }
                                        disabled={ !legal.has(card) || board.busy() }
                                        aria-label={ cardLabel(card) }
                                        aria-pressed={ device.coarse() ? chosen === card : undefined }
                                        onClick={ () => touchCard(card) }
                                        onPointerEnter={ (event) => (event.pointerType === 'mouse' ? aim(card) : undefined) }
                                        onPointerLeave={ () => unaim(card) }
                                        onFocus={ () => aim(card) }
                                        onBlur={ () => unaim(card) }
                                    >
                                        <CardFace card={ card } />
                                    </button>
                                </li>
                            </For>
                        </ul>
                    </For>
                </div>
            }
        </Show>

        <Show when={ view !== null && !over }>
            { () =>
                <section class="table-bar hokm-play">
                    <div class="flex min-w-0 flex-wrap items-center gap-x-3 gap-y-1">
                        <p class="min-w-0 flex-[1_1_6.5rem] truncate text-ui-base font-semibold text-text" aria-live="polite">{ says }</p>
                        <span class="hokm-bar-facts" aria-hidden="true">
                            <span class="hokm-chip">
                                <Show
                                    when={ view?.trump !== undefined }
                                    fallback={ <Icon name="crest-crown" size={ 12 } class="shrink-0 text-gold" /> }
                                >
                                    { () =>
                                        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-text">
                                            <Icon name={ SUIT_ICON[view!.trump!] } size={ 12 } class={ RED_SUITS.includes(view!.trump!) ? 'text-danger-fill' : 'text-bright-ink' } />
                                        </span>
                                    }
                                </Show>
                                <For each={ sides } key={ (side) => side.index } let={ side }>
                                    <span class="flex items-center gap-1">
                                        <span class={ () => [ 'h-2 w-2 rounded-full bg-current', SIDE_TONE[side.index % SIDE_TONE.length] ].join(' ') }></span>
                                        <span class="tally font-bold text-white">{ locale.n(side.points) }</span>
                                    </span>
                                </For>
                                <span class="tally text-white/60">/{ locale.n(view!.target) }</span>
                            </span>
                        </span>
                        <TurnClock remainingMs={ game.remainingMs } over={ over } yours={ acting } />
                        <Show when={ (view?.hand.length ?? 0) > 1 }>
                            { () =>
                                <Button variant="secondary" size="sm" leading="sort" pressed={ sorted } onClick={ () => sorted = !sorted }>
                                    { locale.t('hokm.sort') }
                                </Button>
                            }
                        </Show>
                    </div>

                    <Show when={ mine !== undefined }>
                        { () =>
                            <div class="flex min-h-11 min-w-0 flex-col justify-center gap-1">
                                <Show when={ chosen !== null }>
                                    { () =>
                                        <span class="glow-cta mx-auto flex w-full max-w-[22rem] rounded-control">
                                            <Button variant="primary" size="lg" leading="cards" block loading={ board.busy() } label={ cardLabel(chosen!) } onClick={ () => void playCard(chosen!) }>
                                                { locale.t('hokm.play', { card: cardSays(chosen!) }) }
                                            </Button>
                                        </span>
                                    }
                                </Show>
                                <Show when={ hints.hintOutcome && myTurn }>
                                    { () => <p class="hokm-outcome min-h-5 text-center text-ui-xs font-semibold text-text" aria-hidden="true">{ outcome ?? '' }</p> }
                                </Show>
                                <Show when={ chosen === null }>
                                    { () =>
                                        <span class="contents">
                                            <CoachLine tip={ tip } />
                                            <Show when={ myTurn && device.coarse() }>
                                                { () => <p class="text-center text-ui-xs text-muted">{ locale.t('hokm.pick') }</p> }
                                            </Show>
                                            <Show when={ myTurn && legal.size < (view?.hand.length ?? 0) && !(hints.hintRules && tip !== null) }>
                                                { () => <p class="text-center text-ui-xs text-muted">{ locale.t('hokm.follow') }</p> }
                                            </Show>
                                        </span>
                                    }
                                </Show>
                            </div>
                        }
                    </Show>
                </section>
            }
        </Show>
        </div>

        <Show when={ over }>
            { () =>
                <TableResult match={ game } mine={ mine } busy={ props.starting === true } onAgain={ props.onAgain } />
            }
        </Show>

        <div class="board-flight" aria-hidden="true" inert ref={ (element) => layer = element }></div>
    </div>
}
