import { Link, type Child, type NavigateTarget } from 'azerothjs';

export default component Card(props: {
    children?: Child;
    to?: NavigateTarget;
    padded?: boolean;
    glow?: 'accent' | 'live' | null;
    class?: string;
    label?: string;
    onClick?: () => void;
})
{
    derived interactive = props.to !== undefined || props.onClick !== undefined;

    derived shell = [
        'block rounded-panel border border-line bg-field text-start text-text',
        props.padded === false ? '' : 'p-3',
        props.glow === 'accent' ? 'shadow-glow-accent border-accent/40' : '',
        props.glow === 'live' ? 'shadow-glow-live border-live/40' : '',
        interactive ? 'cursor-pointer transition duration-200 ease-[var(--ease-ui)] hover:border-line-strong hover:bg-raised/60 active:scale-[0.995]' : '',
        props.class ?? ''
    ].filter(Boolean).join(' ');

    <Show
        when={ props.to !== undefined }
        fallback={
            <Show
                when={ props.onClick !== undefined }
                fallback={ <div class={ shell }>{ props.children }</div> }
            >
                { () =>
                    <button type="button" class={ [ shell, 'w-full' ].join(' ') } aria-label={ props.label } onClick={ () => props.onClick?.() }>
                        { props.children }
                    </button>
                }
            </Show>
        }
    >
        { () => <Link to={ props.to! } class={ shell } aria-label={ props.label }>{ props.children }</Link> }
    </Show>
}
