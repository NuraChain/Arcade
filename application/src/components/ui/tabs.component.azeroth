import { useLocale } from '../../stores/locale.store.ts';

export interface TabItem
{
    id: string;
    label: string;
    count?: number;
}

export default component Tabs(props: {
    items: TabItem[];
    value: string;
    label: string;
    onChange: (id: string) => void;
    class?: string;
})
{
    const locale = useLocale();

    let list: HTMLElement | null = null;

    /**
     * The selected tab is never off screen, whatever the strip has room for.
     *
     * The strip has always scrolled - `overflow-x-auto` with the scrollbar hidden - and that is
     * exactly why nothing said it did: five tabs at 390 put the last two past the edge with no
     * scrollbar, no fade and no hint, so a page opened on its fifth tab showed a strip whose
     * selected item was somewhere to the right. Nothing overflows the PAGE, so the matrix passes.
     *
     * `nearest` rather than `center`, so a tab already in view is left where it is: scrolling a
     * strip that did not need scrolling is its own small confusion.
     */
    const reveal = (id: string): void =>
    {
        list?.querySelector<HTMLElement>(`[data-tab='${ id }']`)
            ?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    };

    effect
    {
        const selected = props.value;

        if (selected !== '')
        {
            reveal(selected);
        }
    }

    const move = (from: string, step: number): void =>
    {
        const index = props.items.findIndex((item) => item.id === from);
        const next = props.items[(index + step + props.items.length) % props.items.length];
        props.onChange(next.id);
        list?.querySelector<HTMLElement>(`[data-tab='${ next.id }']`)?.focus();
        reveal(next.id);
    };

    <div
        ref={ (element) => list = element }
        class={ () => [ 'flex gap-1 overflow-x-auto border-b border-line [scrollbar-width:none]', props.class ?? '' ].filter(Boolean).join(' ') }
        role="tablist"
        aria-label={ props.label }
    >
        <For each={ props.items } key={ (item) => item.id } let={ item }>
            <button
                type="button"
                role="tab"
                data-tab={ item.id }
                class={ [
                    'relative flex h-11 shrink-0 cursor-pointer items-center gap-1.5 whitespace-nowrap px-3 text-ui-base font-semibold',
                    'transition-colors duration-150',
                    props.value === item.id ? 'text-text' : 'text-muted hover:text-text'
                ].join(' ') }
                aria-selected={ props.value === item.id }
                tabindex={ props.value === item.id ? 0 : -1 }
                onClick={ () => props.onChange(item.id) }
                onKeyDown={ (event) =>
                {
                    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft')
                    {
                        event.preventDefault();
                        const forward = (event.key === 'ArrowRight') === (locale.dir() === 'ltr');
                        move(item.id, forward ? 1 : -1);
                    }
                } }
            >
                { item.label }
                <Show when={ item.count !== undefined && item.count > 0 }>
                    { () => <span class="tally rounded-full bg-raised px-1.5 text-ui-2xs text-muted">{ locale.n(item.count!) }</span> }
                </Show>
                <span
                    class={ [
                        'absolute inset-x-2 bottom-0 h-0.5 rounded-full transition-all duration-200',
                        props.value === item.id ? 'bg-accent' : 'bg-transparent'
                    ].join(' ') }
                    aria-hidden="true"
                ></span>
            </button>
        </For>
    </div>
}
