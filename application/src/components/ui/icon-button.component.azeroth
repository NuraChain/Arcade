import { Link, type NavigateTarget } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import type { Side } from '../../lib/anchor.ts';
import Badge from './badge.component.azeroth';
import Tooltip from './tooltip.component.azeroth';
import { BUTTON_VARIANT, ICON_BUTTON_SIZE, type ButtonSize, type ButtonVariant } from './variants.ts';

export default component IconButton(props: {
    icon: IconName;
    label: string;
    to?: NavigateTarget;
    variant?: ButtonVariant;
    size?: ButtonSize;
    count?: number;
    tone?: 'accent' | 'danger';
    active?: boolean;
    disabled?: boolean;
    flip?: boolean;
    pressed?: boolean;
    expanded?: boolean;
    tip?: boolean;
    tipSide?: Side;
    class?: string;
    onClick?: () => void;
})
{
    derived shell = [
        'relative inline-flex shrink-0 select-none items-center justify-center rounded-control',
        'transition duration-150 ease-[var(--ease-ui)] active:scale-95',
        'disabled:cursor-not-allowed disabled:opacity-50',
        props.active === true ? 'text-accent' : '',
        BUTTON_VARIANT[props.variant ?? 'ghost'],
        ICON_BUTTON_SIZE[props.size ?? 'md'],
        props.disabled === true ? '' : 'cursor-pointer',
        props.class ?? ''
    ].filter(Boolean).join(' ');

    derived iconSize = props.size === 'sm' ? 17 : (props.size === 'lg' ? 22 : 19);

    derived counted = props.count !== undefined && props.count > 0;

    <Tooltip label={ props.label } side={ props.tipSide ?? 'bottom' } class={ props.tip === false ? 'contents' : '' }>
        <Show
            when={ props.to !== undefined }
            fallback={
                <button
                    type="button"
                    class={ shell }
                    aria-label={ props.label }
                    aria-pressed={ props.pressed }
                    aria-expanded={ props.expanded }
                    disabled={ props.disabled === true }
                    onClick={ () => (props.disabled === true ? undefined : props.onClick?.()) }
                >
                    <Icon name={ props.icon } size={ iconSize } class={ props.flip === true ? 'icon-flip' : '' } />
                    <Show when={ counted }>
                        { () => <Badge count={ props.count! } tone={ props.tone ?? 'danger' } size="sm" anchor label={ props.label } /> }
                    </Show>
                </button>
            }
        >
            { () =>
                <Link to={ props.to! } class={ shell } aria-label={ props.label }>
                    <Icon name={ props.icon } size={ iconSize } class={ props.flip === true ? 'icon-flip' : '' } />
                    <Show when={ counted }>
                        { () => <Badge count={ props.count! } tone={ props.tone ?? 'danger' } size="sm" anchor label={ props.label } /> }
                    </Show>
                </Link>
            }
        </Show>
    </Tooltip>
}
