import { type Child } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { stepAlong } from '../../lib/snap.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

const DRAG_FROM = 4;

export default component Rail(props: { children?: Child; label: string; bleed?: boolean; class?: string; inner?: string })
{
    const device = useDevice();
    const locale = useLocale();

    state atStart = true;
    state atEnd = true;

    derived scrolls = !(atStart && atEnd);

    state dragging = false;

    let scroller: HTMLElement | null = null;

    let drag: { id: number; x: number; left: number; moved: boolean } | null = null;

    let swallowUntil = 0;

    const press = (event: PointerEvent): void =>
    {
        if (event.pointerType !== 'mouse' || event.button !== 0 || scroller === null || !scrolls)
        {
            return;
        }
        drag = { id: event.pointerId, x: event.clientX, left: scroller.scrollLeft, moved: false };
    };

    const slide = (event: PointerEvent): void =>
    {
        if (drag === null || scroller === null || event.pointerId !== drag.id)
        {
            return;
        }
        const dx = event.clientX - drag.x;
        if (!drag.moved)
        {
            if (Math.abs(dx) < DRAG_FROM)
            {
                return;
            }
            drag.moved = true;
            dragging = true;
            scroller.setPointerCapture(event.pointerId);
        }
        scroller.scrollLeft = drag.left - dx;
    };

    const release = (event: PointerEvent): void =>
    {
        if (drag === null || event.pointerId !== drag.id)
        {
            return;
        }
        if (drag.moved)
        {
            swallowUntil = performance.now() + 80;
        }
        drag = null;
        dragging = false;
    };

    const swallow = (event: Event): void =>
    {
        if (performance.now() < swallowUntil)
        {
            event.preventDefault();
            event.stopPropagation();
        }
    };

    const still = (event: Event): void =>
    {
        if (drag !== null)
        {
            event.preventDefault();
        }
    };

    const measure = (): void =>
    {
        if (scroller === null)
        {
            return;
        }
        const travelled = Math.abs(scroller.scrollLeft);
        const extent = scroller.scrollWidth - scroller.clientWidth;
        atStart = travelled <= 1;
        atEnd = extent <= 1 || travelled >= extent - 1;
    };

    const step = (direction: 1 | -1): void =>
    {
        if (scroller === null)
        {
            return;
        }
        const page = Math.max(120, Math.round(scroller.clientWidth * 0.8));
        const target = stepAlong(Math.abs(scroller.scrollLeft), scroller.scrollWidth, page, direction);
        scroller.scrollTo({ left: target * (locale.dir() === 'rtl' ? -1 : 1), behavior: device.reducedMotion() ? 'auto' : 'smooth' });
    };

    mount
    {
        measure();
        const observer = typeof ResizeObserver === 'undefined' ? null : new ResizeObserver(measure);
        if (observer !== null && scroller !== null)
        {
            observer.observe(scroller);
        }
        scroller?.addEventListener('click', swallow, true);
        scroller?.addEventListener('dragstart', still);
        return () =>
        {
            observer?.disconnect();
            scroller?.removeEventListener('click', swallow, true);
            scroller?.removeEventListener('dragstart', still);
        };
    }

    <div
        class={ [ 'rail', props.bleed === true ? 'bleed' : '', props.class ?? '' ].filter(Boolean).join(' ') }
        data-start={ atStart ? 'true' : 'false' }
        data-end={ atEnd ? 'true' : 'false' }
        data-dragging={ dragging ? 'true' : undefined }
    >
        <div
            ref={ (element) => scroller = element }
            class={ [ 'rail-x flex snap-x gap-2.5', props.bleed === true ? 'bleed-pad' : '', props.inner ?? '' ].filter(Boolean).join(' ') }
            role="group"
            aria-label={ props.label }
            tabindex={ scrolls ? '0' : undefined }
            onScroll={ measure }
            onPointerDown={ press }
            onPointerMove={ slide }
            onPointerUp={ release }
            onPointerCancel={ release }
            onKeyDown={ (event) =>
            {
                const forward = event.key === (locale.dir() === 'rtl' ? 'ArrowLeft' : 'ArrowRight');
                const backward = event.key === (locale.dir() === 'rtl' ? 'ArrowRight' : 'ArrowLeft');
                if (forward || backward)
                {
                    event.preventDefault();
                    step(forward ? 1 : -1);
                }
            } }
        >
            { props.children }
        </div>
        <Show when={ scrolls && !device.coarse() }>
            { () =>
                <div class="rail-arrows" aria-hidden="true">
                    <button type="button" class="rail-arrow" tabindex="-1" disabled={ atStart } onClick={ () => step(-1) }>
                        <Icon name="chevron-right" size={ 16 } class="icon-flip rotate-180" />
                    </button>
                    <button type="button" class="rail-arrow" tabindex="-1" disabled={ atEnd } onClick={ () => step(1) }>
                        <Icon name="chevron-right" size={ 16 } class="icon-flip" />
                    </button>
                </div>
            }
        </Show>
    </div>
}
