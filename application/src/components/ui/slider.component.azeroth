import { useLocale } from '../../stores/locale.store.ts';

function quantise(value: number, min: number, max: number, step: number): number
{
    const steps = Math.round((value - min) / step);
    return Math.min(max, Math.max(min, Number((min + steps * step).toFixed(6))));
}

export default component Slider(props: {
    value: number;
    min?: number;
    max?: number;
    step?: number;
    label: string;
    hint?: string;
    valueText?: string;
    ticks?: number[];
    disabled?: boolean;
    class?: string;
    onChange: (value: number) => void;
})
{
    const locale = useLocale();

    let track: HTMLElement | null = null;

    derived min = props.min ?? 0;

    derived max = props.max ?? 1;

    derived step = props.step ?? 0.01;

    derived ratio = max === min ? 0 : (props.value - min) / (max - min);

    derived percent = Math.round(Math.min(1, Math.max(0, ratio)) * 100);

    const fromPointer = (clientX: number): void =>
    {
        if (track === null || props.disabled === true)
        {
            return;
        }
        const box = track.getBoundingClientRect();
        const raw = (clientX - box.left) / Math.max(1, box.width);
        const along = locale.dir() === 'rtl' ? 1 - raw : raw;
        props.onChange(quantise(min + along * (max - min), min, max, step));
    };

    const nudge = (direction: number): void =>
    {
        if (props.disabled === true)
        {
            return;
        }
        props.onChange(quantise(props.value + direction * step, min, max, step));
    };

    <div class={ [ 'flex flex-col gap-2', props.class ?? '' ].filter(Boolean).join(' ') }>
        <div class="flex items-center justify-between gap-3">
            <span class="text-ui-base font-semibold text-text">{ props.label }</span>
            <span class="tally text-ui-sm text-muted">{ props.valueText ?? locale.n(props.value) }</span>
        </div>

        <div
            ref={ (element) => track = element }
            role="slider"
            tabindex={ props.disabled === true ? -1 : 0 }
            aria-label={ props.label }
            aria-valuemin={ min }
            aria-valuemax={ max }
            aria-valuenow={ props.value }
            aria-valuetext={ props.valueText }
            aria-disabled={ props.disabled === true }
            class={ [
                'relative flex h-11 w-full touch-none items-center',
                props.disabled === true ? 'cursor-not-allowed opacity-50' : 'cursor-pointer'
            ].join(' ') }
            onPointerDown={ (event) =>
            {
                if (props.disabled === true)
                {
                    return;
                }
                (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);
                fromPointer(event.clientX);
            } }
            onPointerMove={ (event) =>
            {
                if (event.buttons > 0)
                {
                    fromPointer(event.clientX);
                }
            } }
            onKeyDown={ (event) =>
            {
                const forward = locale.dir() === 'rtl' ? -1 : 1;
                if (event.key === 'ArrowRight')
                {
                    event.preventDefault();
                    nudge(forward);
                }
                else if (event.key === 'ArrowLeft')
                {
                    event.preventDefault();
                    nudge(-forward);
                }
                else if (event.key === 'ArrowUp')
                {
                    event.preventDefault();
                    nudge(1);
                }
                else if (event.key === 'ArrowDown')
                {
                    event.preventDefault();
                    nudge(-1);
                }
                else if (event.key === 'Home')
                {
                    event.preventDefault();
                    props.onChange(min);
                }
                else if (event.key === 'End')
                {
                    event.preventDefault();
                    props.onChange(max);
                }
            } }
        >
            <span class="absolute inset-x-0 h-1.5 rounded-full bg-sunk" aria-hidden="true"></span>
            <span class="absolute inset-inline-start-0 h-1.5 rounded-full bg-accent" style={ `inline-size: ${ percent }%` } aria-hidden="true"></span>
            <Show when={ props.ticks !== undefined }>
                { () =>
                    <For each={ props.ticks! } key={ (tick) => tick } let={ tick }>
                        <span
                            class="absolute h-2.5 w-0.5 -translate-x-1/2 rounded-full bg-line-strong"
                            style={ `inset-inline-start: ${ Math.round(((tick - min) / Math.max(1, max - min)) * 100) }%` }
                            aria-hidden="true"
                        ></span>
                    </For>
                }
            </Show>
            <span
                class="absolute h-5 w-5 -translate-x-1/2 rounded-full border-2 border-accent bg-field shadow-1 transition-transform duration-100 active:scale-110"
                style={ `inset-inline-start: ${ percent }%` }
                aria-hidden="true"
            ></span>
        </div>

        <Show when={ props.hint !== undefined }>
            <p class="text-ui-xs text-faint">{ props.hint }</p>
        </Show>
    </div>
}
