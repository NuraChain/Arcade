import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component Input(props: {
    id?: string;
    value: string;
    onInput: (value: string) => void;
    type?: string;
    placeholder?: string;
    leading?: IconName;
    clearable?: boolean;
    invalid?: boolean;
    disabled?: boolean;
    autofocus?: boolean;
    autocomplete?: string;
    inputmode?: string;
    enterkeyhint?: string;
    maxlength?: number;
    describedBy?: string;
    label?: string;
    class?: string;
    onEnter?: () => void;
    onFocus?: () => void;
    onBlur?: () => void;
})
{
    const locale = useLocale();

    let field: HTMLInputElement | null = null;

    derived shell = [
        'flex h-12 items-center gap-2 rounded-control border bg-field px-3 text-text',
        'transition-colors duration-150 focus-within:border-accent',
        props.invalid === true ? 'border-danger' : 'border-line',
        props.disabled === true ? 'opacity-50' : '',
        props.class ?? ''
    ].filter(Boolean).join(' ');

    <div class={ shell }>
        <Show when={ props.leading !== undefined }>
            { () => <Icon name={ props.leading! } size={ 18 } class="shrink-0 text-faint" /> }
        </Show>
        <input
            ref={ (element) => field = element }
            id={ props.id }
            class="h-full min-w-0 flex-1 bg-transparent text-ui-input text-text outline-none placeholder:text-faint"
            dir="auto"
            type={ props.type ?? 'text' }
            value={ props.value }
            placeholder={ props.placeholder }
            disabled={ props.disabled === true }
            autofocus={ props.autofocus === true }
            autocomplete={ props.autocomplete }
            inputmode={ props.inputmode }
            enterkeyhint={ props.enterkeyhint }
            maxlength={ props.maxlength }
            aria-invalid={ props.invalid === true }
            aria-describedby={ props.describedBy }
            aria-label={ props.label }
            onInput={ (event) => props.onInput((event.target as HTMLInputElement).value) }
            onKeyDown={ (event) =>
            {
                if (event.key === 'Enter' && props.onEnter !== undefined)
                {
                    event.preventDefault();
                    props.onEnter();
                }
            } }
            onFocus={ () => props.onFocus?.() }
            onBlur={ () => props.onBlur?.() }
        />
        <Show when={ props.clearable === true && props.value !== '' }>
            { () =>
                <button
                    type="button"
                    class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-full text-faint hover:bg-raised hover:text-text coarse:h-11 coarse:w-11"
                    aria-label={ locale.t('common.clear') }
                    onClick={ () =>
                    {
                        props.onInput('');
                        field?.focus();
                    } }
                >
                    <Icon name="close" size={ 16 } />
                </button>
            }
        </Show>
    </div>
}
