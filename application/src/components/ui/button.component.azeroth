import { Link, type Child, type NavigateTarget } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import Spinner from './spinner.component.azeroth';
import { BUTTON_SIZE, BUTTON_VARIANT, type ButtonSize, type ButtonVariant } from './variants.ts';

export default component Button(props: {
    children?: Child;
    href?: string;
    to?: NavigateTarget;
    variant?: ButtonVariant;
    size?: ButtonSize;
    icon?: IconName;
    leading?: IconName;
    block?: boolean;
    disabled?: boolean;
    loading?: boolean;
    pressed?: boolean;
    submit?: boolean;
    label?: string;
    class?: string;
    onClick?: () => void;
})
{
    derived inert = props.disabled === true || props.loading === true;

    derived shell = [
        'relative inline-flex select-none items-center justify-center rounded-control font-semibold',
        'transition duration-150 ease-[var(--ease-ui)] active:scale-[0.985]',
        'disabled:cursor-not-allowed disabled:opacity-50',
        props.pressed === true ? 'border border-accent/60 bg-accent/15 text-accent' : BUTTON_VARIANT[props.variant ?? 'outline'],
        BUTTON_SIZE[props.size ?? 'md'],
        props.block === true ? 'w-full' : '',
        inert ? '' : 'cursor-pointer',
        props.class ?? ''
    ].filter(Boolean).join(' ');

    derived contentClass = [
        'inline-flex items-center justify-center gap-[inherit]',
        props.loading === true ? 'invisible' : ''
    ].filter(Boolean).join(' ');

    <Show
        when={ props.to !== undefined }
        fallback={
            <Show
                when={ props.href !== undefined }
                fallback={
                    <button
                        type={ props.submit === true ? 'submit' : 'button' }
                        class={ shell }
                        disabled={ inert }
                        aria-busy={ props.loading === true }
                        aria-pressed={ props.pressed }
                        aria-label={ props.label }
                        onClick={ () => (inert ? undefined : props.onClick?.()) }
                    >
                        <span class={ contentClass }>
                            <Show when={ props.leading !== undefined }>
                                { () => <Icon name={ props.leading! } size={ 16 } /> }
                            </Show>
                            { props.children }
                            <Show when={ props.icon !== undefined }>
                                { () => <Icon name={ props.icon! } size={ 16 } class="icon-flip" /> }
                            </Show>
                        </span>
                        <Show when={ props.loading === true }>
                            <span class="absolute inset-0 flex items-center justify-center">
                                <Spinner size={ 18 } />
                            </span>
                        </Show>
                    </button>
                }
            >
                { () =>
                    <a href={ props.href } class={ shell } aria-label={ props.label }>
                        <Show when={ props.leading !== undefined }>
                            { () => <Icon name={ props.leading! } size={ 16 } /> }
                        </Show>
                        { props.children }
                        <Show when={ props.icon !== undefined }>
                            { () => <Icon name={ props.icon! } size={ 16 } class="icon-flip" /> }
                        </Show>
                    </a>
                }
            </Show>
        }
    >
        { () =>
            <Link to={ props.to! } class={ shell } aria-label={ props.label } onClick={ () => props.onClick?.() }>
                <Show when={ props.leading !== undefined }>
                    { () => <Icon name={ props.leading! } size={ 16 } /> }
                </Show>
                { props.children }
                <Show when={ props.icon !== undefined }>
                    { () => <Icon name={ props.icon! } size={ 16 } class="icon-flip" /> }
                </Show>
            </Link>
        }
    </Show>
}
