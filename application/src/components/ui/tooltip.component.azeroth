import { Portal, type Child } from 'azerothjs';

import { boxOf, place, viewportOf, type Placed, type Side } from '../../lib/anchor.ts';
import { runtime } from '../../lib/runtime.ts';
import { useDevice } from '../../stores/device.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

/**
 * The bubble takes its direction from the LABEL, not from the page.
 *
 * It is portalled to `.anchor-root`, which sits under the document and inherits `rtl` on a Persian
 * page - so a Latin label went into an RTL box. `dir="auto"` on the bubble is the rule a chat
 * message and a display name already follow, and the case it exists for is the wallet address:
 * *Whose device is that?* asks somebody to compare `0xf39F...` out of band, and an address whose
 * `0x` renders at the far end is an address nobody can compare.
 *
 * The PLACEMENT was already both-ways - `place()` is handed `rtl` from the locale, so the bubble
 * flips and shifts against the right edge on a Persian page. It is the text inside that was not.
 */
let openTooltip: (() => void) | null = null;

export default component Tooltip(props: {
    label: string;
    children?: Child;
    side?: Side;
    delay?: number;
    id?: string;
    class?: string;
})
{
    const locale = useLocale();
    const device = useDevice();

    state shown = false;
    state placed = false;
    state at = { x: 0, y: 0, side: 'top', align: 'center', arrow: 12 } as Placed;

    let host: HTMLElement | null = null;
    let bubble: HTMLElement | null = null;
    let cancel: (() => void) | null = null;

    derived tipId = props.id ?? `tip-${ props.label.replace(/[^a-zA-Z0-9]+/g, '-').toLowerCase() }`;

    const settle = (): void =>
    {
        if (host === null || bubble === null)
        {
            return;
        }
        at = place(
            boxOf(host),
            { width: bubble.offsetWidth, height: bubble.offsetHeight },
            viewportOf(),
            { side: props.side ?? 'top', gap: 8, padding: 10, rtl: locale.dir() === 'rtl' }
        );
        placed = true;
    };

    /**
     * The scroll and resize watch, held only while this tooltip is actually on screen.
     *
     * It used to be armed in `mount` for every instance. The listeners exist to HIDE a visible
     * tooltip when the page moves under it - so for the overwhelming majority of tooltips, which are
     * not showing, they had nothing to do. And `IconButton` wraps every icon-only control in a
     * `Tooltip`, with `capture: true` so the handler runs for a scroll of ANY scrollable element:
     * scrolling the chat thread ran one hide-a-hidden-tooltip callback per icon button on screen,
     * per scroll event.
     *
     * Released on hide as well as on teardown, so it lives exactly as long as the thing it serves.
     */
    let watching: (() => void) | null = null;

    const unwatch = (): void =>
    {
        watching?.();
        watching = null;
    };

    const hide = (): void =>
    {
        cancel?.();
        cancel = null;
        shown = false;
        placed = false;
        unwatch();
        if (openTooltip === hide)
        {
            openTooltip = null;
        }
    };

    const watch = (): void =>
    {
        if (watching !== null)
        {
            return;
        }

        const onMoved = (): void => hide();
        window.addEventListener('scroll', onMoved, true);
        window.addEventListener('resize', onMoved, { passive: true });

        watching = (): void =>
        {
            window.removeEventListener('scroll', onMoved, true);
            window.removeEventListener('resize', onMoved);
        };
    };

    /**
     * Nothing to say is not a reason to open an empty box.
     *
     * A caller that wraps something whose tooltip is OPTIONAL - `Badge` does - passes the empty
     * string when there is none, and without this guard the host still armed every handler and
     * flashed a bubble with no text in it on hover. The alternative was making each such caller
     * duplicate its markup in a `<Show>` and its `fallback`, which is two copies of one element.
     */
    const show = (immediate: boolean): void =>
    {
        if (shown || props.label === '')
        {
            return;
        }
        openTooltip?.();
        openTooltip = hide;
        cancel?.();
        cancel = null;
        if (immediate)
        {
            shown = true;
            watch();
            requestAnimationFrame(settle);
            return;
        }
        cancel = runtime().clock.after(props.delay ?? 350, () =>
        {
            cancel = null;
            shown = true;
            watch();
            requestAnimationFrame(settle);
        });
    };

    /**
     * A tooltip belongs to a KEYBOARD focus, not to every focus.
     *
     * `onFocusIn` fires for a programmatic `.focus()` too, and every sheet in this product moves
     * focus to its close button as it opens - so each one opened with the word "Close" floating over
     * its own first paragraph, which on the table sheet covered the sentence saying who can sit
     * down. Nothing failed: the matrix reads overflow, hit targets, a landmark and the console, and
     * a tooltip in the wrong place is none of those.
     *
     * `:focus-visible` is the browser's own answer to "did a person tab here", so it shows for a
     * keyboard user - who needs the name and cannot hover for it - and stays quiet for focus the
     * page moved itself. Wrapped because `matches` throws on a selector an engine does not know,
     * and a tooltip must not be the thing that breaks a render; an engine without it shows the
     * tooltip as before.
     */
    const tabbedTo = (target: EventTarget | null): boolean =>
    {
        if (!(target instanceof Element))
        {
            return false;
        }

        try
        {
            return target.matches(':focus-visible');
        }
        catch
        {
            return true;
        }
    };

    mount
    {
        return () => hide();
    }

    <span
        ref={ (element) => host = element }
        class={ [ 'inline-flex shrink-0', props.class ?? '' ].filter(Boolean).join(' ') }
        aria-describedby={ shown ? tipId : undefined }
        onPointerEnter={ (event) => (event.pointerType === 'mouse' ? show(false) : undefined) }
        onPointerLeave={ () => hide() }
        onPointerDown={ () => (device.coarse() ? undefined : hide()) }
        onFocusIn={ (event) => (tabbedTo(event.target) ? show(true) : undefined) }
        onFocusOut={ () => hide() }
        onKeyDown={ (event) => (event.key === 'Escape' ? hide() : undefined) }
        onContextMenu={ (event) =>
        {
            if (device.coarse())
            {
                event.preventDefault();
                show(true);
            }
        } }
    >
        { props.children }
        <Show when={ shown }>
            { () =>
                <Portal>
                    <div class="anchor-root">
                        <div
                            ref={ (element) => bubble = element }
                            id={ tipId }
                            role="tooltip"
                            dir="auto"
                            class="tooltip"
                            data-side={ at.side }
                            data-placed={ placed ? 'true' : 'false' }
                            style={ `--x: ${ at.x }px; --y: ${ at.y }px; --arrow: ${ at.arrow }px` }
                        >
                            { props.label }
                        </div>
                    </div>
                </Portal>
            }
        </Show>
    </span>
}
