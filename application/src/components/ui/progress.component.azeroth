import { useLocale } from '../../stores/locale.store.ts';
import { TONE_BAR, type Tone } from './variants.ts';

export default component Progress(props: { value: number; max?: number; tone?: Tone; label: string; glow?: boolean; class?: string })
{
    const locale = useLocale();

    derived max = props.max ?? 100;

    derived ratio = Math.min(1, Math.max(0, max === 0 ? 0 : props.value / max));

    <div
        class={ [ 'h-2 w-full overflow-hidden rounded-full bg-raised', props.class ?? '' ].filter(Boolean).join(' ') }
        role="progressbar"
        aria-label={ props.label }
        aria-valuemin={ 0 }
        aria-valuemax={ max }
        aria-valuenow={ props.value }
        aria-valuetext={ `${ locale.n(props.value) } / ${ locale.n(max) }` }
    >
        <div
            class={ [
                'h-full rounded-full transition-[width] duration-500 ease-[var(--ease-reveal)]',
                TONE_BAR[props.tone ?? 'accent'],
                props.glow === true ? (props.tone === 'live' ? 'shadow-glow-live' : 'shadow-glow-accent') : ''
            ].filter(Boolean).join(' ') }
            style={ `width: ${ Math.round(ratio * 100) }%` }
        ></div>
    </div>
}
