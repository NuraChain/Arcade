import type { NavigateTarget } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import Button from './button.component.azeroth';

export default component EmptyState(props: {
    icon?: IconName;
    title: string;
    lead?: string;
    action?: string;
    to?: NavigateTarget;
    tone?: 'accent' | 'live';
    class?: string;
    onAction?: () => void;
})
{
    <div class={ [ 'flex flex-col items-center px-6 py-10 text-center', props.class ?? '' ].filter(Boolean).join(' ') }>
        <Show when={ props.icon !== undefined }>
            { () =>
                <span class="empty-art" data-tone={ props.tone ?? 'accent' } aria-hidden="true">
                    <span class="empty-art-card"></span>
                    <span class="empty-art-card is-back"></span>
                    <span class="empty-art-disc">
                        <Icon name={ props.icon! } size={ 26 } />
                    </span>
                </span>
            }
        </Show>
        <p class="title text-ui-xl text-text">{ props.title }</p>
        <Show when={ props.lead !== undefined }>
            { () => <p class="mt-1.5 max-w-[34ch] text-ui-base text-muted">{ props.lead }</p> }
        </Show>
        <Show when={ props.action !== undefined }>
            { () =>
                <div class="mt-5">
                    <Button variant="primary" size="md" to={ props.to } onClick={ props.onAction }>{ props.action }</Button>
                </div>
            }
        </Show>
    </div>
}
