import Tooltip from './tooltip.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import {
    BADGE_DOT_SIZE,
    BADGE_SIZE,
    TONE_DOT,
    TONE_FILL,
    TONE_OUTLINE,
    TONE_PILL,
    TONE_SOFT,
    type BadgeSize,
    type BadgeVariant,
    type Tone
} from './variants.ts';

export default component Badge(props: {
    count?: number;
    text?: string;
    dot?: boolean;
    max?: number;
    tone?: Tone;
    variant?: BadgeVariant;
    size?: BadgeSize;
    anchor?: boolean;
    showZero?: boolean;
    label?: string;
    tip?: string;
    class?: string;
})
{
    const locale = useLocale();

    derived tone = props.tone ?? 'accent';

    derived size = props.size ?? 'md';

    derived limit = props.max ?? 99;

    derived pill = props.dot === true && props.text !== undefined;

    derived hidden = props.dot !== true
        && props.text === undefined
        && (props.count ?? 0) <= 0
        && props.showZero !== true;

    derived body = props.text ?? (props.count === undefined
        ? ''
        : (props.count > limit ? `${ locale.n(limit) }+` : locale.n(props.count)));

    derived paint = props.variant === 'soft'
        ? TONE_SOFT[tone]
        : (props.variant === 'outline' ? TONE_OUTLINE[tone] : TONE_FILL[tone]);

    derived anchored = props.anchor === true ? 'absolute -end-0.5 -top-0.5' : '';

    derived onHost = props.tip === undefined ? 'contents' : anchored;

    derived onBadge = props.tip === undefined ? anchored : '';

    <Show when={ !hidden }>
        <Tooltip label={ props.tip ?? '' } class={ onHost }>
            <Show
                when={ pill }
                fallback={
                    <Show
                        when={ props.dot === true }
                        fallback={
                            <span
                                class={ [
                                    'tally inline-flex items-center justify-center rounded-full font-bold leading-none',
                                    BADGE_SIZE[size],
                                    paint,
                                    onBadge,
                                    props.anchor === true ? 'ring-2 ring-void' : '',
                                    props.class ?? ''
                                ].filter(Boolean).join(' ') }
                                aria-label={ props.label }
                                role={ props.label === undefined ? undefined : 'status' }
                            >
                                { body }
                            </span>
                        }
                    >
                        { () =>
                            <span
                                class={ [
                                    'inline-block shrink-0 rounded-full',
                                    BADGE_DOT_SIZE[size],
                                    TONE_DOT[tone],
                                    onBadge,
                                    props.anchor === true ? 'ring-2 ring-void' : '',
                                    props.class ?? ''
                                ].filter(Boolean).join(' ') }
                                aria-label={ props.label }
                                role={ props.label === undefined ? undefined : 'status' }
                            ></span>
                        }
                    </Show>
                }
            >
                { () =>
                    <span
                        class={ [
                            'inline-flex h-6 shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full border px-2.5 text-ui-xs font-semibold leading-none',
                            TONE_PILL[tone],
                            onBadge,
                            props.class ?? ''
                        ].filter(Boolean).join(' ') }
                        aria-label={ props.label }
                        role={ props.label === undefined ? undefined : 'status' }
                    >
                        <span class={ `h-1.5 w-1.5 shrink-0 rounded-full ${ TONE_DOT[tone] }` } aria-hidden="true"></span>
                        { body }
                    </span>
                }
            </Show>
        </Tooltip>
    </Show>
}
