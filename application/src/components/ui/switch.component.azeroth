export default component Switch(props: {
    checked: boolean;
    label: string;
    description?: string;
    disabled?: boolean;
    class?: string;
    onChange: (checked: boolean) => void;
})
{
    <button
        type="button"
        role="switch"
        aria-checked={ props.checked }
        class={ [
            'flex min-h-11 w-full cursor-pointer items-center justify-between gap-4 rounded-tile px-1 py-1.5 text-start',
            props.disabled === true ? 'cursor-not-allowed opacity-50' : '',
            props.class ?? ''
        ].filter(Boolean).join(' ') }
        disabled={ props.disabled === true }
        onClick={ () => (props.disabled === true ? undefined : props.onChange(!props.checked)) }
    >
        <span class="flex min-w-0 flex-col">
            <span class="text-[15px] font-semibold text-text">{ props.label }</span>
            <Show when={ props.description !== undefined }>
                { () => <span class="text-[13px] text-muted">{ props.description }</span> }
            </Show>
        </span>
        <span
            class={ [
                'relative h-7 w-12 shrink-0 rounded-full transition-colors duration-200',
                props.checked ? 'bg-lamp' : 'bg-line'
            ].join(' ') }
            aria-hidden="true"
        >
            <span
                class={ [
                    'absolute top-1 h-5 w-5 rounded-full bg-white shadow-1 transition-all duration-200',
                    props.checked ? 'start-6' : 'start-1'
                ].join(' ') }
            ></span>
        </span>
    </button>
}
