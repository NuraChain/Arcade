import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import Button from './button.component.azeroth';

export default component ErrorState(props: { title?: string; lead?: string; class?: string; onRetry?: () => void })
{
    const locale = useLocale();

    <div class={ [ 'flex flex-col items-center px-6 py-10 text-center', props.class ?? '' ].filter(Boolean).join(' ') } role="alert">
        <span class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-madder/15 text-madder" aria-hidden="true">
            <Icon name="alert" size={ 26 } />
        </span>
        <p class="title text-ui-xl text-text">{ props.title ?? locale.t('state.errorTitle') }</p>
        <p class="mt-1.5 max-w-[34ch] text-ui-base text-muted">{ props.lead ?? locale.t('state.errorLead') }</p>
        <Show when={ props.onRetry !== undefined }>
            { () =>
                <div class="mt-5">
                    <Button variant="secondary" size="md" leading="refresh" onClick={ () => props.onRetry?.() }>{ locale.t('common.retry') }</Button>
                </div>
            }
        </Show>
    </div>
}
