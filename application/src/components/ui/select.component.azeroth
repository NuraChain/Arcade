import { Portal } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import { boxOf, place, viewportOf } from '../../lib/anchor.ts';
import { useLocale } from '../../stores/locale.store.ts';

export interface SelectOption
{
    value: string;
    label: string;
}

let serial = 0;

export default component Select(props: {
    label: string;
    value: string;
    options: readonly SelectOption[];
    hint?: string;
    disabled?: boolean;
    class?: string;
    onChange: (value: string) => void;
})
{
    const locale = useLocale();

    serial += 1;
    const id = `select-${ serial }`;

    state open = false;
    state active = 0;
    state at = { x: 0, y: 0, width: 0, placed: false };

    let trigger: HTMLElement | null = null;
    let list: HTMLElement | null = null;
    let stop: (() => void) | null = null;

    derived chosen = props.options.find((one) => one.value === props.value) ?? props.options[0];

    derived rows = props.options.map((one, index) => ({ ...one, index }));

    const reveal = (): void =>
    {
        requestAnimationFrame(() => list?.querySelector(`[data-index="${ active }"]`)?.scrollIntoView({ block: 'nearest' }));
    };

    const settle = (): void =>
    {
        if (trigger === null || list === null)
        {
            return;
        }

        const box = boxOf(trigger);
        const spot = place(box, { width: box.width, height: list.offsetHeight }, viewportOf(), { side: 'bottom', align: 'start', gap: 6, padding: 8 });

        at = { x: spot.x, y: spot.y, width: box.width, placed: true };
        list.focus({ preventScroll: true });
        reveal();
    };

    const close = (refocus: boolean): void =>
    {
        open = false;
        at = { ...at, placed: false };
        stop?.();
        stop = null;

        if (refocus)
        {
            trigger?.focus();
        }
    };

    const show = (): void =>
    {
        if (props.disabled === true || open || props.options.length === 0)
        {
            return;
        }

        active = Math.max(0, props.options.findIndex((one) => one.value === props.value));
        open = true;
        requestAnimationFrame(settle);

        const outside = (event: PointerEvent): void =>
        {
            const target = event.target as Node | null;

            if (target !== null && (trigger?.contains(target) === true || list?.contains(target) === true))
            {
                return;
            }
            close(false);
        };

        const moved = (event: Event): void =>
        {
            if (event.target instanceof Node && list?.contains(event.target) === true)
            {
                return;
            }
            close(false);
        };

        document.addEventListener('pointerdown', outside, true);
        window.addEventListener('scroll', moved, true);
        window.addEventListener('resize', moved);

        stop = () =>
        {
            document.removeEventListener('pointerdown', outside, true);
            window.removeEventListener('scroll', moved, true);
            window.removeEventListener('resize', moved);
        };
    };

    const pick = (index: number): void =>
    {
        const one = props.options[index];

        if (one !== undefined && one.value !== props.value)
        {
            props.onChange(one.value);
        }
        close(true);
    };

    const move = (index: number): void =>
    {
        active = Math.min(Math.max(index, 0), props.options.length - 1);
        reveal();
    };

    const seek = (letter: string): void =>
    {
        const count = props.options.length;

        for (let step = 1; step <= count; step += 1)
        {
            const index = (active + step) % count;

            if (props.options[index].label.toLocaleLowerCase().startsWith(letter))
            {
                move(index);
                return;
            }
        }
    };

    const onTrigger = (event: KeyboardEvent): void =>
    {
        if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key))
        {
            event.preventDefault();
            show();
        }
    };

    const onList = (event: KeyboardEvent): void =>
    {
        if (event.key === 'ArrowDown')
        {
            event.preventDefault();
            move(active + 1);
        }
        else if (event.key === 'ArrowUp')
        {
            event.preventDefault();
            move(active - 1);
        }
        else if (event.key === 'Home' || event.key === 'PageUp')
        {
            event.preventDefault();
            move(0);
        }
        else if (event.key === 'End' || event.key === 'PageDown')
        {
            event.preventDefault();
            move(props.options.length - 1);
        }
        else if (event.key === 'Enter' || event.key === ' ')
        {
            event.preventDefault();
            pick(active);
        }
        else if (event.key === 'Escape')
        {
            event.preventDefault();
            close(true);
        }
        else if (event.key === 'Tab')
        {
            close(false);
        }
        else if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey)
        {
            seek(event.key.toLocaleLowerCase());
        }
    };

    mount
    {
        return () => stop?.();
    }

    <div class={ [ 'flex min-w-0 flex-col gap-1.5', props.class ?? '' ].filter(Boolean).join(' ') }>
        <span id={ `${ id }-label` } class="text-ui-sm font-semibold text-text">{ props.label }</span>
        <button
            ref={ (element) => trigger = element }
            type="button"
            class={ () => [
                'flex h-11 w-full min-w-0 cursor-pointer items-center gap-2 rounded-control border bg-sunk px-3 text-start text-ui-md text-text transition-colors duration-150 disabled:cursor-not-allowed disabled:opacity-50',
                open ? 'border-accent' : 'border-line hover:border-line-strong'
            ].join(' ') }
            aria-haspopup="listbox"
            aria-expanded={ open }
            aria-controls={ open ? `${ id }-list` : undefined }
            aria-labelledby={ `${ id }-label ${ id }-value` }
            aria-describedby={ props.hint === undefined ? undefined : `${ id }-hint` }
            disabled={ props.disabled === true }
            onClick={ () => (open ? close(true) : show()) }
            onKeyDown={ onTrigger }
        >
            <span id={ `${ id }-value` } class="min-w-0 flex-1 truncate" dir="auto">{ chosen?.label ?? '' }</span>
            <Icon name="chevron-down" size={ 16 } class={ open ? 'shrink-0 rotate-180 text-accent transition-transform duration-150' : 'shrink-0 text-muted transition-transform duration-150' } />
        </button>
        <Show when={ props.hint !== undefined }>
            { () => <p id={ `${ id }-hint` } class="text-ui-xs text-muted">{ props.hint }</p> }
        </Show>
        <Show when={ open }>
            { () =>
                <Portal>
                    <div class="anchor-root">
                        <ul
                            ref={ (element) => list = element }
                            id={ `${ id }-list` }
                            role="listbox"
                            tabindex="-1"
                            class="select-list"
                            data-placed={ at.placed ? 'true' : 'false' }
                            style={ `--x: ${ at.x }px; --y: ${ at.y }px; --w: ${ at.width }px` }
                            aria-labelledby={ `${ id }-label` }
                            aria-activedescendant={ `${ id }-option-${ active }` }
                            onKeyDown={ onList }
                        >
                            <For each={ rows } key={ (one) => one.value } let={ one }>
                                <li
                                    id={ `${ id }-option-${ one.index }` }
                                    role="option"
                                    class="select-option"
                                    data-index={ one.index }
                                    data-active={ one.index === active ? 'true' : undefined }
                                    aria-selected={ one.value === props.value }
                                    onPointerMove={ () => active = one.index }
                                    onClick={ () => pick(one.index) }
                                >
                                    <span class="min-w-0 flex-1 truncate" dir="auto">{ one.label }</span>
                                    <Show when={ one.value === props.value }>
                                        { () => <Icon name="selected" size={ 16 } class="shrink-0 text-accent" /> }
                                    </Show>
                                </li>
                            </For>
                        </ul>
                    </div>
                </Portal>
            }
        </Show>
    </div>
}
