import { useLocale } from '../../stores/locale.store.ts';
import IconButton from './icon-button.component.azeroth';

export default component SheetHeader(props: { title: string; lead?: string; onClose: () => void })
{
    const locale = useLocale();

    <header class="flex items-start justify-between gap-3">
        <div class="min-w-0">
            <h2 class="title text-ui-xl text-text">{ props.title }</h2>
            <Show when={ props.lead !== undefined }>
                { () => <p class="mt-2 text-ui-base text-muted">{ props.lead }</p> }
            </Show>
        </div>
        <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.onClose() } />
    </header>
}
