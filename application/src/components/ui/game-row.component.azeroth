import type { Game } from '../../data/games.ts';
import { useFocus } from '../../stores/focus.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component GameRow(props: { game: Game })
{
    const locale = useLocale();
    const focus = useFocus();

    derived active = focus.game() === props.game.id;

    derived seats = props.game.minPlayers === props.game.maxPlayers
        ? locale.n(props.game.minPlayers)
        : `${ locale.n(props.game.minPlayers) }–${ locale.n(props.game.maxPlayers) }`;

    <button
        type="button"
        class={ [
            'group grid w-full cursor-pointer grid-cols-[auto_1fr_auto] items-baseline gap-x-4 gap-y-1.5',
            'border-t border-line py-4 text-start transition-colors duration-150',
            active ? 'border-lamp/40' : ''
        ].filter(Boolean).join(' ') }
        onPointerEnter={ () => focus.focus(props.game.id) }
        onPointerLeave={ () => focus.focus(null) }
        onFocus={ () => focus.focus(props.game.id) }
        onBlur={ () => focus.focus(null) }
        onClick={ () => focus.focus(props.game.id) }
    >
        
        <span
            class={ [
                'mt-2 h-2 w-2 shrink-0 rounded-full transition-all duration-300',
                active ? 'bg-lamp shadow-[0_0_12px_2px_var(--lamp)]' : 'bg-line'
            ].join(' ') }
            aria-hidden="true"
        ></span>

        <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class={ [
                'font-display text-[clamp(1.15rem,2.4vw,1.5rem)] font-semibold transition-colors duration-150',
                active ? 'text-lamp' : 'text-text'
            ].join(' ') }>
                { locale.t(props.game.nameKey) }
            </span>
            <span class="label text-[12px] text-faint">{ locale.t(props.game.categoryKey) }</span>
        </span>

        <span class="label text-[13px] text-muted">
            <span class="tally">{ seats }</span> { locale.t('games.players') }
        </span>

        
        <p class="col-start-2 col-end-4 max-w-[62ch] text-[13px] text-muted">
            { locale.t(props.game.blurbKey) }
        </p>
    </button>
}
