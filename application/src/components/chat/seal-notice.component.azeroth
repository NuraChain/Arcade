import type { Child } from 'azerothjs';

import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import type { Readiness } from '../../lib/device-state.ts';
import type { MemberSealState, SendBlock } from '../../lib/seal-state.ts';
import type { MessageKey } from '../../locales/en.ts';
import { useLocale } from '../../stores/locale.store.ts';

type Blocked = Exclude<MemberSealState, 'ready'>;

/**
 * A stop this notice can actually render a sentence for.
 *
 * `pending` means the room's answer has not landed; both pages hide the notice for it and the
 * composer stands down instead. The guard below already filters it out, but the `let` binding is
 * typed from the accessor's ANNOTATION rather than its body - so annotating it `SendBlock` put
 * `pending` back into the union inside the branch, and every `sealed.member` read failed to
 * compile. Naming the narrowed type is what makes the guard and the type agree.
 */
type Shown = Exclude<SendBlock, { reason: 'pending' }>;

const ICON: Record<Blocked, IconName> = {
    'no-wallet': 'info',
    'no-device': 'info',
    'needs-chain': 'info',
    tampered: 'alert'
};

const SAYS: Record<Blocked, MessageKey> = {
    'no-wallet': 'seal.noWallet',
    'no-device': 'seal.noDevice',
    'needs-chain': 'seal.needsChain',
    tampered: 'seal.tampered'
};

/**
 * The three states THIS BROWSER can be stuck in, which are not the same question as the four above.
 *
 * Those are about accounts and say who to wait for. These are about the machine in front of the
 * reader, and each one has a different answer: `absent` takes one signature, `waiting` takes another
 * device, and `unsupported` takes a different browser. Collapsing them into one boolean would leave
 * the notice unable to tell somebody which of the three they are in.
 *
 * An exhaustive `Record`, like every other map in this file, so a readiness added later fails to
 * compile rather than rendering as nothing.
 */
const BROWSER: Record<Exclude<Readiness, 'ready'>, MessageKey> = {
    unsupported: 'seal.deviceUnsupported',
    absent: 'seal.noKeysHere',
    waiting: 'seal.deviceWaiting'
};

const BROWSER_ICON: Record<Exclude<Readiness, 'ready'>, IconName> = {
    unsupported: 'error-circle',
    absent: 'key',
    waiting: 'clock'
};

/**
 * The same four reasons, about the person reading them.
 *
 * Being told "alex is signed in without a wallet" when you ARE alex reads like a bug, and it is
 * also the one case where the sentence can say what to do about it rather than who to wait for.
 */
const SAYS_MINE: Record<Blocked, MessageKey> = {
    'no-wallet': 'seal.noWalletMine',
    'no-device': 'seal.noDeviceMine',
    'needs-chain': 'seal.needsChainMine',
    tampered: 'seal.tamperedMine'
};

/**
 * Whether the messages in this thread are sealed, and when they are not, why.
 *
 * The negative case names the person it is about, because "sara.k is signed in without a wallet"
 * is something somebody can act on and "this conversation cannot be encrypted" is not.
 *
 * The POSITIVE case exists now, and only because the mechanism does. This component shipped with a
 * comment saying there would deliberately be no "this conversation IS sealed" line, because a
 * padlock ahead of its mechanism is a claim rather than a fact - and at the time nothing was
 * sealed. What it says now is what actually happens: the bodies are ciphertext, the server stores
 * them, and it cannot open them. It is a quiet line rather than a badge, because the interesting
 * state is still the one where sealing is NOT possible.
 *
 * `tampered` is the one that is not a shrug. Everything else here says a proof is ABSENT; that one
 * says a proof was present and did not check out, which means the device list this browser was
 * handed is not a truthful statement about who is in the conversation.
 */
export default component SealNotice(props: { stop: SendBlock | null; action?: Child })
{
    const locale = useLocale();

    <>
        <Show when={ (): boolean => props.stop === null }>
            { () =>
                <p class="flex items-start gap-2 px-3 py-1.5 text-ui-xs text-faint">
                    <Icon name="lock" size={ 14 } class="mt-0.5 shrink-0" />
                    <span>{ locale.t('seal.sealed') }</span>
                </p>
            }
        </Show>

        {/*
            The narrowed form, and why the obvious deriveds are gone.

            The first cut kept `here`/`member`/`state` as memos over `props.stop` and guarded the
            branch with a separate `when`. Guard and sentence were then two reads of a moving
            value: across a flip - and `pending` now flips on every refetch - a build could run
            with a truthy `when` and a `member` memo that had already settled to null, which sent
            `state` to 'ready', looked up a sentence key that does not exist, and took the page
            down. The narrowed accessor is a pull memo over the same `when` this branch was built
            from, so every read below sees one stop - the one the guard saw.
        */}
        <Show when={ (): Shown | null => (props.stop !== null && props.stop.reason !== 'pending' ? props.stop : null) } let={ sealed }>
            <div
                class={ [
                    'flex flex-wrap items-start gap-2 rounded-tile border px-3 py-2 text-ui-sm',
                    sealed.reason === 'member' && sealed.member.state === 'tampered'
                        ? 'border-danger/40 bg-danger/10 text-danger'
                        : 'border-line bg-field text-muted'
                ].join(' ') }
                role={ sealed.reason === 'member' && sealed.member.state === 'tampered' ? 'alert' : undefined }
            >
                <Icon
                    name={ sealed.reason === 'browser' ? BROWSER_ICON[sealed.readiness] : ICON[sealed.member.state] }
                    size={ 16 }
                    class="mt-0.5 shrink-0"
                />
                <span class="min-w-0 flex-1">
                    { sealed.reason === 'browser'
                        ? locale.t(BROWSER[sealed.readiness])
                        : (sealed.member.isMe
                            ? locale.t(SAYS_MINE[sealed.member.state])
                            : locale.t(SAYS[sealed.member.state], { who: sealed.member.handle })) }
                </span>
                <Show when={ props.action !== undefined }>
                    { () => <span class="shrink-0">{ props.action }</span> }
                </Show>
            </div>
        </Show>
    </>
}
