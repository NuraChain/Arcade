import { Link, useNavigate } from 'azerothjs';

import type { Message, MessageLock } from '../../data/chat.ts';
import Icon from '../../icons/icon.component.azeroth';
import { isLineKey, namedParams } from '../../lib/lines.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { attachHold } from '../../lib/hold.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import type { MessageKey } from '../../locales/en.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';

const LOCKED: Record<MessageLock, MessageKey> = {
    'unknown-sender': 'locked.unknownSender',
    'bad-signature': 'locked.badSignature',
    'no-key': 'locked.noKey',
    'no-epoch-key': 'locked.noEpochKey',
    tampered: 'locked.tampered',
    expired: 'expiry.locked'
};

const ALARMING: MessageLock[] = ['bad-signature', 'tampered'];

const JOINED = {
    right: { top: 'rounded-tr-md', bottom: 'rounded-br-md', tail: 'rounded-br-[0.3rem]' },
    left: { top: 'rounded-tl-md', bottom: 'rounded-bl-md', tail: 'rounded-bl-[0.3rem]' }
};

export default component MessageBubble(props: {
    message: Message;
    me: string;
    first?: boolean;
    last?: boolean;
    avatar?: boolean;
    onHold?: (message: Message) => void;
})
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const toasts = useToasts();
    const people = usePeople();
    const { navigate } = useNavigate();

    derived mine = props.message.from === props.me;

    derived first = props.first !== false;

    derived last = props.last !== false;

    derived crowd = props.avatar === true && !mine;

    derived joined = JOINED[mine === (locale.dir() === 'rtl') ? 'left' : 'right'];

    derived corners = [ first ? '' : joined.top, last ? joined.tail : joined.bottom ].filter(Boolean).join(' ');

    derived time = locale.date(props.message.at, { hour: 'numeric', minute: '2-digit' });

    let bubble: HTMLElement | null = null;

    mount
    {
        if (bubble === null || props.onHold === undefined || props.message.from === props.me)
        {
            return;
        }
        return attachHold(bubble, () => props.onHold?.(props.message));
    }

    derived person = people.byHandle(props.message.from) ?? null;

    derived firstName = person === null ? props.message.from : person.displayName.split(' ')[0];

    const nameOf = (handle: string): string =>
    {
        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    derived said = ((): string =>
    {
        const line = props.message.line;
        if (line === undefined)
        {
            return locale.text(props.message.text);
        }
        return isLineKey(line.key)
            ? locale.t(line.key, namedParams(line.params, nameOf))
            : '';
    })();

    derived locked = props.message.locked ?? null;

    derived alarming = locked !== null && ALARMING.includes(locked);

    derived game = props.message.ref?.game === undefined ? null : catalogue.byId(props.message.ref.game);

    const sitDown = (): void =>
    {
        if (game === null)
        {
            return;
        }
        const tableId = props.message.ref?.tableId;
        if (tableId === undefined)
        {
            toasts.show({ kind: 'info', text: locale.t('chat.invite.closed') });
            return;
        }
        navigate(`/app/play/${ tableId }`);
    };

    <Show
        when={ props.message.kind === 'text' }
        fallback={
            <Show
                when={ props.message.kind === 'system' }
                fallback={
                    <div class={ () => [
                        'flex w-full max-w-[22rem] flex-col gap-3 rounded-panel border p-3',
                        props.message.kind === 'result' ? 'border-win/40 bg-win/5' : 'border-accent/40 bg-accent/5',
                        mine ? 'ms-auto' : ''
                    ].filter(Boolean).join(' ') }>
                        <div class="flex items-center gap-2.5">
                            <span class={ () => [
                                'flex h-9 w-9 shrink-0 items-center justify-center rounded-full',
                                props.message.kind === 'result' ? 'bg-win/20 text-win' : 'bg-accent/20 text-accent'
                            ].join(' ') }>
                                <Icon name={ props.message.kind === 'result' ? 'trophy' : 'seat' } size={ 18 } />
                            </span>
                            <span class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-ui-base font-semibold text-text">
                                    { props.message.kind === 'result'
                                        ? locale.t('chat.result.title', {
                                            winner: props.message.ref?.winnerId === props.me
                                                ? locale.t('common.you')
                                                : (people.byHandle(props.message.ref?.winnerId ?? '')?.handle ?? firstName),
                                            game: game === null ? '' : locale.t(game.nameKey)
                                        })
                                        : locale.t(mine ? 'chat.invite.titleMine' : 'chat.invite.title', { name: firstName, game: game === null ? '' : locale.t(game.nameKey) }) }
                                </span>
                                <span class="truncate text-ui-xs text-muted">{ said }</span>
                            </span>
                        </div>
                        <Show when={ props.message.kind === 'invite' }>
                            { () => <Button variant="primary" size="sm" block leading="seat" onClick={ sitDown }>{ locale.t('chat.invite.join') }</Button> }
                        </Show>
                    </div>
                }
            >
                { () =>
                    <p class="mx-auto max-w-[26rem] rounded-full bg-raised/60 px-3 py-1 text-center text-ui-xs text-muted">
                        { said }
                    </p>
                }
            </Show>
        }
    >
        { () =>
            <div class={ () => [ 'flex w-full items-end gap-2', mine ? 'flex-row-reverse' : '' ].filter(Boolean).join(' ') }>
                <Show when={ crowd }>
                    { () =>
                        <span class="flex w-8 shrink-0 self-end">
                            <Show when={ last }>
                                { () =>
                                    <Link to={ `/app/people/${ person?.handle ?? props.message.from }` } data-inline class="shrink-0" aria-label={ person === null ? props.message.from : locale.text(person.displayName) }>
                                        <Avatar person={ person } size="sm" />
                                    </Link>
                                }
                            </Show>
                        </span>
                    }
                </Show>
                <div class={ () => [ 'flex min-w-0 max-w-[min(34rem,80%)] flex-col', mine ? 'items-end' : 'items-start' ].join(' ') }>
                    <Show when={ crowd && first }>
                        { () =>
                            <span class="mb-1 px-3 text-ui-2xs font-semibold" style={ `color: hsl(${ person?.hue ?? 210 } 72% 72%)` } dir="auto">{ firstName }</span>
                        }
                    </Show>
                    <Show
                        when={ locked === null }
                        fallback={
                            <span
                                class={ () => [
                                    'flex items-start gap-2 rounded-tile border border-dashed px-3 py-2 text-ui-sm',
                                    alarming ? 'border-danger/50 bg-danger/10 text-danger' : 'border-line bg-field text-muted'
                                ].join(' ') }
                                role={ alarming ? 'alert' : undefined }
                            >
                                <Icon name={ alarming ? 'alert' : 'lock' } size={ 15 } class="mt-0.5 shrink-0" />
                                <span>{ locale.t(LOCKED[locked ?? 'no-key']) }</span>
                            </span>
                        }
                    >
                        { () =>
                            <span
                                ref={ (element) => bubble = element }
                                dir="auto"
                                class={ () => [
                                    'bubble relative max-w-full rounded-[1.125rem] px-3 pb-1.5 pt-1.5 text-ui-base leading-snug',
                                    mine ? 'bg-accent-fill text-accent-ink' : 'border border-line bg-field text-text',
                                    corners
                                ].join(' ') }
                            >
                                <span class="whitespace-pre-wrap break-words">{ said }</span>
                                <span class="invisible ms-2 inline-block text-ui-2xs" dir={ locale.dir() } aria-hidden="true">{ time }</span>
                                <time
                                    class={ () => [ 'absolute bottom-1 end-3 text-ui-2xs leading-none', mine ? 'text-accent-ink/70' : 'text-faint' ].join(' ') }
                                    datetime={ new Date(props.message.at).toISOString() }
                                    dir={ locale.dir() }
                                >
                                    { time }
                                </time>
                            </span>
                        }
                    </Show>
                </div>
            </div>
        }
    </Show>
}
