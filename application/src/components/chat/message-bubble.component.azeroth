import { Link, useNavigate } from 'azerothjs';

import { personById } from '../../data/mock/index.ts';
import type { Message } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLobby } from '../../stores/lobby.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';

export default component MessageBubble(props: { message: Message; me: string; showAuthor: boolean })
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const lobby = useLobby();
    const toasts = useToasts();
    const { navigate } = useNavigate();

    derived mine = props.message.from === props.me;

    derived person = personById(props.message.from) ?? null;

    derived firstName = person === null ? props.message.from : locale.text(person.name).split(' ')[0];

    derived game = props.message.ref?.game === undefined ? null : catalogue.byId(props.message.ref.game);

    const sitDown = (): void =>
    {
        if (game === null)
        {
            return;
        }
        if (lobby.tableId() === props.message.ref?.tableId && lobby.active())
        {
            navigate(`/app/play/${ lobby.tableId() ?? '' }`);
            return;
        }
        toasts.show({ kind: 'info', text: locale.t('chat.invite.closed') });
        navigate(`/app/play/${ lobby.joinInvite(game.id, props.message.from) }`);
    };

    <Show
        when={ props.message.kind === 'text' }
        fallback={
            <Show
                when={ props.message.kind === 'system' }
                fallback={
                    <div class={ [
                        'flex w-full max-w-[22rem] flex-col gap-3 rounded-panel border p-3',
                        props.message.kind === 'result' ? 'border-win/40 bg-win/5' : 'border-lamp/40 bg-lamp/5',
                        mine ? 'ms-auto' : ''
                    ].filter(Boolean).join(' ') }>
                        <div class="flex items-center gap-2.5">
                            <span class={ [
                                'flex h-9 w-9 shrink-0 items-center justify-center rounded-full',
                                props.message.kind === 'result' ? 'bg-win/20 text-win' : 'bg-lamp/20 text-lamp'
                            ].join(' ') }>
                                <Icon name={ props.message.kind === 'result' ? 'trophy' : 'seat' } size={ 18 } />
                            </span>
                            <span class="flex min-w-0 flex-1 flex-col">
                                <span class="truncate text-[14px] font-semibold text-text">
                                    { props.message.kind === 'result'
                                        ? locale.t('chat.result.title', {
                                            winner: props.message.ref?.winnerId === props.me
                                                ? locale.t('common.you')
                                                : (personById(props.message.ref?.winnerId ?? '')?.handle ?? firstName),
                                            game: game === null ? '' : locale.t(game.nameKey)
                                        })
                                        : locale.t(mine ? 'chat.invite.titleMine' : 'chat.invite.title', { name: firstName, game: game === null ? '' : locale.t(game.nameKey) }) }
                                </span>
                                <span class="truncate text-[12px] text-muted">{ locale.text(props.message.text) }</span>
                            </span>
                        </div>
                        <Show when={ props.message.kind === 'invite' }>
                            { () => <Button variant="primary" size="sm" block leading="seat" onClick={ sitDown }>{ locale.t('chat.invite.join') }</Button> }
                        </Show>
                    </div>
                }
            >
                { () =>
                    <p class="mx-auto max-w-[26rem] rounded-full bg-raised/60 px-3 py-1 text-center text-[12px] text-muted">
                        { locale.text(props.message.text) }
                    </p>
                }
            </Show>
        }
    >
        { () =>
            <div class={ [ 'flex w-full items-end gap-2', mine ? 'flex-row-reverse' : '' ].filter(Boolean).join(' ') }>
                <Show when={ !mine && props.showAuthor } fallback={ <span class="w-8 shrink-0" aria-hidden="true"></span> }>
                    { () =>
                        <Link to={ `/app/people/${ person?.handle ?? props.message.from }` } class="shrink-0">
                            <Avatar person={ person } size="sm" />
                        </Link>
                    }
                </Show>
                <div class={ [ 'flex max-w-[min(30rem,78%)] flex-col gap-0.5', mine ? 'items-end' : 'items-start' ].join(' ') }>
                    <Show when={ !mine && props.showAuthor }>
                        { () => <span class="px-1 text-[11px] font-semibold text-muted">{ firstName }</span> }
                    </Show>
                    <span class={ [
                        'rounded-tile px-3 py-2 text-[14px] leading-snug',
                        mine ? 'bg-lamp text-void' : 'bg-raised text-text'
                    ].join(' ') }>
                        { locale.text(props.message.text) }
                    </span>
                    <span class="px-1 text-[11px] text-faint">{ locale.relative(props.message.at) }</span>
                </div>
            </div>
        }
    </Show>
}
