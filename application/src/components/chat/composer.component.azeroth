import { useLocale } from '../../stores/locale.store.ts';
import IconButton from '../ui/icon-button.component.azeroth';
import TextArea from '../ui/text-area.component.azeroth';

/**
 * The composer ASKS for a table rather than picking one.
 *
 * It carried its own rail of games and handed back an id, which made it the second game picker in
 * the product and the one with no seat count - so opening a ludo table from a chat always took the
 * default four, and a thread between two people got a table that needed two more. It also listed
 * every game in the catalogue, available or not.
 *
 * `onGame` now opens the sheet that already knows how to ask both questions, which is one picker
 * rather than two that disagree.
 */
export default component Composer(props: {
    value: string;
    disabled?: boolean;
    onInput: (value: string) => void;
    onSend: () => void;
    onGame: () => void;
})
{
    const locale = useLocale();

    <div class="glass safe-b border-t border-line/60">
        <form
            class="flex items-end gap-1.5 px-2 py-2"
            onSubmit={ (event) =>
            {
                event.preventDefault();
                props.onSend();
            } }
        >
            <IconButton
                icon="add"
                label={ locale.t('chat.gameMenu') }
                variant="secondary"
                disabled={ props.disabled === true }
                onClick={ () => props.onGame() }
            />
            <TextArea
                value={ props.value }
                onInput={ props.onInput }
                placeholder={ locale.t('chat.composer') }
                label={ locale.t('chat.composer') }
                disabled={ props.disabled === true }
                enterkeyhint="send"
                maxlength={ 500 }
                class="min-w-0 flex-1"
                onEnter={ () => props.onSend() }
            />
            <IconButton
                icon="send"
                label={ locale.t('chat.send') }
                variant="primary"
                flip
                disabled={ props.disabled === true || props.value.trim() === '' }
                onClick={ () => props.onSend() }
            />
        </form>
    </div>
}
