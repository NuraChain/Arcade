import { Link } from 'azerothjs';

import { isLineKey } from '../../lib/lines.ts';
import type { Conversation } from '../../data/mock/types.ts';
import { attachHold } from '../../lib/hold.ts';
import Icon from '../../icons/icon.component.azeroth';
import { usePeople } from '../../stores/people.store.ts';
import { useChat } from '../../stores/chat.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useGroups } from '../../stores/groups.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import AvatarGroup from '../ui/avatar-group.component.azeroth';
import Badge from '../ui/badge.component.azeroth';
import GroupCrest from '../social/group-crest.component.azeroth';
import { groupNameOf, othersOf, titleOf } from './chat-title.ts';

export default component ChatListItem(props: { conversation: Conversation; me: string; active?: boolean; onHold?: () => void })
{
    const locale = useLocale();
    const social = useSocial();
    const chat = useChat();
    const presence = usePresence();
    const groups = useGroups();
    const people = usePeople();

    let row: HTMLElement | null = null;

    mount
    {
        if (row === null || props.onHold === undefined)
        {
            return;
        }
        return attachHold(row, () => props.onHold?.());
    }

    derived others = othersOf(props.conversation, props.me, people.byHandle);

    derived group = props.conversation.groupId === null ? undefined : groups.byId(props.conversation.groupId);

    derived last = chat.lastOf(props.conversation.id);

    derived unread = chat.unread(props.conversation.id);

    derived typing = chat.typing(props.conversation.id);

    derived muted = social.isMuted('conversation', props.conversation.id);

    derived preview = ((): string =>
    {
        if (typing.length > 0)
        {
            const who = people.byHandle(typing[0]);
            return `${ who === null ? '' : `${ who.displayName.split(' ')[0] } ` }${ locale.t('chats.typing') }`;
        }
        if (last === undefined)
        {
            return locale.t('chat.empty');
        }
        // A server-authored line says what it says, here as well as in the bubble: "alex joined"
        // is a better row than "Table update", and it follows a language switch for free. The
        // generic strings stay as the fallback for a key this client has never heard of.
        if (last.kind !== 'text')
        {
            const line = last.line;
            if (line !== undefined && isLineKey(line.key))
            {
                return locale.t(line.key, line.params);
            }
            return locale.t(last.kind === 'invite'
                ? 'chats.invitePreview'
                : (last.kind === 'result' ? 'chats.resultPreview' : 'chats.systemPreview'));
        }
        const body = locale.text(last.text);
        return last.from === props.me ? `${ locale.t('chats.you') }${ body }` : body;
    })();

    <span ref={ (element) => row = element } class="contents">
        <Link
            to={ `/app/chats/${ props.conversation.id }` }
            class={ [
                'flex min-h-14 items-center gap-2.5 rounded-tile px-2 py-1.5 transition-colors duration-150 hover:bg-raised coarse:min-h-16',
                props.onHold === undefined ? '' : 'holdable',
                props.active === true ? 'bg-raised' : ''
            ].filter(Boolean).join(' ') }
            prefetch="viewport"
        >
            <Show
                when={ group === undefined && others.length === 1 }
                fallback={
                    <Show
                        when={ group !== undefined }
                        fallback={ <AvatarGroup people={ others } size="sm" max={ 2 } class="w-10 shrink-0" /> }
                    >
                        { () => <GroupCrest crest={ group!.crest } hue={ group!.hue } size="sm" /> }
                    </Show>
                }
            >
                { () => <Avatar person={ others[0] } size="md" presence={ presence.dot(others[0].id) } /> }
            </Show>

            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="flex items-center gap-1.5">
                    <span class={ [ 'truncate text-ui-md', unread > 0 ? 'font-bold text-text' : 'font-semibold text-text' ].join(' ') }>
                        { locale.text(titleOf(props.conversation, props.me, people.byHandle, groupNameOf(props.conversation, groups.byId))) }
                    </span>
                    <Show when={ chat.pinned(props.conversation.id) }>
                        { () => <Icon name="star" size={ 12 } class="shrink-0 text-accent" /> }
                    </Show>
                    <Show when={ muted }>
                        { () => <Icon name="sound-off" size={ 12 } class="shrink-0 text-faint" /> }
                    </Show>
                </span>
                <span class={ [ 'truncate text-ui-sm', typing.length > 0 ? 'text-live' : (unread > 0 ? 'text-text' : 'text-muted') ].join(' ') }>
                    <span dir="auto">{ preview }</span>
                </span>
            </span>

            <span class="flex shrink-0 flex-col items-end gap-1">
                <Show when={ last !== undefined }>
                    { () => <span class="text-ui-2xs text-faint">{ locale.relative(last!.at) }</span> }
                </Show>
                <Show when={ unread > 0 }>
                    { () =>
                        <Show
                            when={ muted }
                            fallback={ <Badge count={ unread } tone="accent" label={ locale.plural('common.unread', unread) } /> }
                        >
                            { () => <Badge dot tone="neutral" label={ locale.plural('common.unread', unread) } /> }
                        </Show>
                    }
                </Show>
            </span>
        </Link>
    </span>
}
