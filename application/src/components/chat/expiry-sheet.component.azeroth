import Icon from '../../icons/icon.component.azeroth';
import { useChat } from '../../stores/chat.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import IconButton from '../ui/icon-button.component.azeroth';

/**
 * How long a message in this room lasts.
 *
 * A property of the ROOM, changeable by anybody in it. The version where each browser decides for
 * its own messages is the one that reads as broken: somebody turns it on, watches their own lines
 * vanish, and the other half of the conversation sits there forever.
 *
 * The copy says what this does NOT do before it says what it does. A disappearing message reads as
 * a promise that the words are recallable, and they are not - anybody who saw one can screenshot it
 * or simply remember it. What is real is narrower and still worth having: the row leaves this
 * server and it leaves the thread of everybody following the rule.
 */

type ExpiryLabel = 'expiry.off' | 'expiry.hour' | 'expiry.day' | 'expiry.week';

const CHOICES: { id: string; seconds: number | null; label: ExpiryLabel }[] = [
    { id: 'off', seconds: null, label: 'expiry.off' },
    { id: 'hour', seconds: 3600, label: 'expiry.hour' },
    { id: 'day', seconds: 86_400, label: 'expiry.day' },
    { id: 'week', seconds: 604_800, label: 'expiry.week' }
];

export default component ExpirySheet(props: OverlayProps & { conversationId: string })
{
    const locale = useLocale();
    const chat = useChat();

    derived current = chat.expireAfter(props.conversationId);

    const choose = async (seconds: number | null): Promise<void> =>
    {
        await chat.setExpiry(props.conversationId, seconds);
        props.close(true);
    };

    <div class="flex flex-col gap-5 p-5">
        <header class="flex items-start justify-between gap-3">
            <div>
                <h2 class="title text-ui-xl text-text">{ locale.t('expiry.title') }</h2>
                <p class="mt-2 text-ui-base text-muted">{ locale.t('expiry.lead') }</p>
            </div>
            <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.close(false) } />
        </header>

        <ul class="flex flex-col gap-2">
            <For each={ CHOICES } key={ (choice) => choice.id } let={ choice }>
                <li>
                    <button
                        type="button"
                        class={ [
                            'flex w-full items-center gap-3 rounded-tile border px-3 py-3 text-start text-ui-base coarse:py-4',
                            choice.seconds === current ? 'border-accent bg-accent/10 text-text' : 'border-line bg-field text-muted'
                        ].join(' ') }
                        onClick={ () => void choose(choice.seconds) }
                    >
                        <Icon name={ choice.seconds === null ? 'close' : 'timer' } size={ 16 } class="shrink-0" />
                        <span class="flex-1">{ locale.t(choice.label) }</span>
                        <Show when={ choice.seconds === current }>
                            { () => <Icon name="check-circle" size={ 16 } class="shrink-0 text-accent" /> }
                        </Show>
                    </button>
                </li>
            </For>
        </ul>

        <div class="flex flex-col gap-2">
            <p class="flex items-start gap-2 text-ui-xs text-faint">
                <Icon name="alert" size={ 13 } class="mt-0.5 shrink-0" />
                <span>{ locale.t('expiry.honest') }</span>
            </p>
            <p class="flex items-start gap-2 text-ui-xs text-faint">
                <Icon name="info" size={ 13 } class="mt-0.5 shrink-0" />
                <span>{ locale.t('expiry.past') }</span>
            </p>
        </div>
    </div>
}
