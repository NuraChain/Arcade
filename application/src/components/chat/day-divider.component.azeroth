import { dayKindOf } from '../../lib/thread.ts';
import { runtime } from '../../lib/runtime.ts';
import { useLocale } from '../../stores/locale.store.ts';

export default component DayDivider(props: { at: number })
{
    const locale = useLocale();

    derived kind = dayKindOf(props.at, runtime().clock.now());

    derived label = kind === 'older'
        ? locale.date(props.at, { weekday: 'long', day: 'numeric', month: 'long' })
        : locale.t(kind === 'today' ? 'chat.day.today' : 'chat.day.yesterday');

    <div class="sticky top-2 z-10 flex justify-center py-2" role="separator" aria-label={ label }>
        <span class="rounded-full border border-line bg-lifted/90 px-3 py-1 text-ui-2xs font-semibold text-muted shadow-1 backdrop-blur-sm" aria-hidden="true">{ label }</span>
    </div>
}
