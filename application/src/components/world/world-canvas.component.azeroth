import type { Beat, WorldHandle } from '../../world/bridge.ts';
import { useFocus } from '../../stores/focus.store.ts';
import { useLocale } from '../../stores/locale.store.ts';

const FADE_MS = 400;

export default component WorldCanvas()
{
    const locale = useLocale();
    const focus = useFocus();

    let host: HTMLDivElement | null = null;
    let canvas: HTMLCanvasElement | null = null;

    state live = false;

    let world: WorldHandle | null = null;
    let reframe: (() => void) | null = null;

    mount
    {
        let disposed = false;
        let broken = false;
        let detach: (() => void) | null = null;

        const retire = (): void =>
        {
            broken = true;
            live = false;
            detach?.();
            detach = null;
            const handle = world;
            world = null;
            window.setTimeout(() => handle?.dispose(), FADE_MS);
        };

        const start = async (): Promise<void> =>
        {
            if (host === null || canvas === null)
            {
                return;
            }

            const { openWorld } = await import('../../world/gate.ts');
            const opened = disposed ? null : openWorld(canvas);
            if (opened === null)
            {
                return;
            }

            const { createWorld } = await import('../../world/world.ts');
            if (disposed)
            {
                opened.context.getExtension('WEBGL_lose_context')?.loseContext();
                return;
            }

            const handle = await createWorld({
                canvas,
                context: opened.context,
                choice: opened.choice,
                assetBase: '/world',
                callbacks:
                {
                    onReady: () =>
                    {
                        if (!broken)
                        {
                            live = true;
                        }
                    },
                    onFailed: () => retire()
                }
            });

            if (disposed || broken)
            {
                handle.dispose();
                return;
            }

            world = handle;
            const page = host.parentElement ?? document.body;

            const measure = (): void =>
            {
                const middle = host!.clientHeight / 2;
                const beats: Beat[] = [...page.querySelectorAll<HTMLElement>('[data-beat]')].map((element, index) => ({
                    name: element.dataset.beat ?? '',
                    at: index === 0 ? 0 : Math.max(0, element.getBoundingClientRect().top + window.scrollY - middle)
                }));
                handle.measure(beats);
            };

            const frame = (): void =>
            {
                const style = getComputedStyle(host!);
                const x = Number.parseFloat(style.getPropertyValue('--subject-x'));
                const y = Number.parseFloat(style.getPropertyValue('--subject-y'));
                handle.setFrame(Number.isFinite(x) ? x : 0.5, Number.isFinite(y) ? y : 0.5);
            };

            const onScroll = (): void => handle.setScroll(window.scrollY);

            const onPointer = (event: PointerEvent): void =>
            {
                if (event.pointerType === 'mouse')
                {
                    handle.setPointer((event.clientX / window.innerWidth) * 2 - 1, (event.clientY / window.innerHeight) * -2 + 1);
                }
            };

            const onResize = (): void =>
            {
                frame();
                measure();
            };

            const layout = new ResizeObserver(() => measure());
            layout.observe(page);

            const visibility = new IntersectionObserver((entries) =>
            {
                if (entries[0].isIntersecting)
                {
                    handle.resume();
                }
                else
                {
                    handle.pause();
                }
            });
            visibility.observe(host);

            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onResize, { passive: true });
            window.addEventListener('pointermove', onPointer, { passive: true });

            reframe = frame;
            frame();
            measure();
            onScroll();
            void document.fonts?.ready.then(() =>
            {
                if (world === handle)
                {
                    measure();
                }
            });

            detach = (): void =>
            {
                window.removeEventListener('scroll', onScroll);
                window.removeEventListener('resize', onResize);
                window.removeEventListener('pointermove', onPointer);
                layout.disconnect();
                visibility.disconnect();
                reframe = null;
            };
        };

        void start().catch(() => retire());

        return () =>
        {
            disposed = true;
            detach?.();
            world?.dispose();
            world = null;
        };
    }

    effect
    {
        const id = focus.game();
        world?.focus(id);
    }

    effect
    {
        locale.dir();
        const again = reframe;
        if (again !== null)
        {
            requestAnimationFrame(() => again());
        }
    }

    <div ref={ (element) => host = element } class="stage bg-void" aria-hidden="true">
        <canvas
            ref={ (element) => canvas = element }
            class={ () => ['world-canvas', live ? 'is-live' : ''].join(' ') }
        ></canvas>
        <div class="scrim"></div>
    </div>
}
