import { Link } from 'azerothjs';

import type { Person } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import type { Child } from 'azerothjs';

export default component FriendRow(props: {
    person: Person;
    subtitle?: string;
    actions?: Child;
    class?: string;
})
{
    const locale = useLocale();
    const presence = usePresence();
    const catalogue = useCatalogue();

    derived state = presence.of(props.person.id);

    derived status = props.subtitle ?? (state.state === 'playing' && state.game !== null
        ? locale.t('common.playing', { game: locale.t(catalogue.byId(state.game).nameKey) })
        : (state.state === 'online'
            ? locale.t('common.online')
            : (state.state === 'away' ? locale.t('common.away') : locale.relative(state.since))));

    <div class={ [ 'flex min-h-14 coarse:min-h-16 items-center gap-3 rounded-tile px-2 py-2 transition-colors duration-150 hover:bg-raised/60', props.class ?? '' ].filter(Boolean).join(' ') }>
        <Link to={ `/app/people/${ props.person.handle }` } class="flex min-w-0 flex-1 items-center gap-3" prefetch="hover">
            <Avatar person={ props.person } size="md" presence={ state.state } />
            <span class="flex min-w-0 flex-1 flex-col">
                <span class="flex items-center gap-1.5">
                    <span class="truncate text-ui-md font-semibold text-text">{ locale.text(props.person.name) }</span>
                    <Show when={ props.person.minor }>
                        { () => <Icon name="shield" size={ 13 } class="shrink-0 text-live" /> }
                    </Show>
                </span>
                <span class="truncate text-ui-sm text-muted">{ status }</span>
            </span>
        </Link>
        <Show when={ props.actions !== undefined }>
            <span class="flex shrink-0 items-center gap-1.5">{ props.actions }</span>
        </Show>
    </div>
}
