import { Link } from 'azerothjs';

import type { Person } from '../../data/person.ts';
import { attachHold } from '../../lib/hold.ts';
import Icon from '../../icons/icon.component.azeroth';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import type { Child } from 'azerothjs';

export default component FriendRow(props: {
    person: Person;
    subtitle?: string;
    actions?: Child;
    class?: string;
    onHold?: () => void;
})
{
    const locale = useLocale();
    const presence = usePresence();

    let row: HTMLElement | null = null;

    mount
    {
        if (row === null || props.onHold === undefined)
        {
            return;
        }
        return attachHold(row, () => props.onHold?.());
    }

    derived state = presence.of(props.person.id);

    derived status = props.subtitle ?? (!state.known
        ? `@${ props.person.handle }`
        : (state.state === 'away' ? locale.t('common.away') : locale.t('common.online')));

    <div
        ref={ (element) => row = element }
        class={ [
            'flex min-h-14 items-center gap-3 rounded-tile px-2 py-2 transition-colors duration-150 hover:bg-raised/60 coarse:min-h-16',
            props.onHold === undefined ? '' : 'holdable',
            props.class ?? ''
        ].filter(Boolean).join(' ') }
    >
        <Link to={ `/app/people/${ props.person.handle }` } class="flex min-h-11 min-w-0 flex-1 items-center gap-3" prefetch="hover">
            <Avatar person={ props.person } size="md" presence={ presence.dot(props.person.id) } />
            <span class="flex min-w-0 flex-1 flex-col">
                <span class="flex items-center gap-1.5">
                    <span class="truncate text-ui-md font-semibold text-text" dir="auto">{ props.person.displayName }</span>
                    <Show when={ props.person.isMinor }>
                        { () => <Icon name="shield" size={ 13 } class="shrink-0 text-live" /> }
                    </Show>
                </span>
                <span class="truncate text-ui-sm text-muted">{ status }</span>
            </span>
        </Link>
        <Show when={ props.actions !== undefined }>
            <span class="flex shrink-0 items-center gap-1.5">{ props.actions }</span>
        </Show>
    </div>
}
