import type { Notification, NotificationKind } from '../../api.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import type { MessageKey } from '../../locales/en.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';

const ICON: Record<NotificationKind, IconName> = {
    'friend-request': 'friend-add',
    'friend-accepted': 'friend-check',
    'group-added': 'people',
    'table-invite': 'seat',
    'message': 'chats',
    'turn': 'dice'
};

/**
 * What each kind SAYS, composed here rather than stored.
 *
 * The row used to carry a bilingual sentence baked in when it was written, which could not follow
 * a language switch - the same defect the chat lines had and the same fix. `message` is the only
 * one that counts, because it is the only one that can happen twelve times before somebody looks.
 */
const SAYS: Record<NotificationKind, MessageKey> = {
    'friend-request': 'notify.friendRequest',
    'friend-accepted': 'notify.friendAccepted',
    'group-added': 'notify.groupAdded',
    'table-invite': 'notify.tableInvite',
    'turn': 'notify.turn',
    'message': 'notify.message'
};

export default component NotificationRow(props: {
    item: Notification;
    onOpen: (item: Notification) => void;
    onDismiss: (id: string) => void;
})
{
    const locale = useLocale();
    const social = useSocial();
    const people = usePeople();

    derived person = props.item.actor === undefined ? null : (people.byHandle(props.item.actor) ?? null);

    derived who = person === null ? (props.item.actor ?? '') : person.displayName.split(' ')[0];

    derived said = props.item.kind === 'message'
        ? locale.plural('notify.message', props.item.count, { who })
        : locale.t(SAYS[props.item.kind], { who });

    derived answerable = props.item.kind === 'friend-request'
        && social.incoming().some((request) => request.from === props.item.actor);

    <div class={ [
        'flex flex-col gap-2 rounded-tile px-2 py-2',
        props.item.read ? '' : 'bg-accent/5'
    ].filter(Boolean).join(' ') }>
        <div class="flex items-center gap-3">
            <button type="button" class="flex min-h-11 min-w-0 flex-1 cursor-pointer items-center gap-3 text-start" onClick={ () => props.onOpen(props.item) }>
                <Show
                    when={ person !== null }
                    fallback={
                        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-raised text-muted">
                            <Icon name={ ICON[props.item.kind] } size={ 18 } />
                        </span>
                    }
                >
                    { () => <Avatar person={ person } size="md" /> }
                </Show>
                <span class="flex min-w-0 flex-1 flex-col">
                    <span class={ [ 'line-clamp-2 text-ui-base', props.item.read ? 'text-muted' : 'text-text' ].join(' ') }>
                        { said }
                    </span>
                    <span class="tally text-ui-xs text-faint">{ locale.relative(Date.parse(props.item.at)) }</span>
                </span>
            </button>
            <Show when={ !props.item.read }>
                { () => <span class="h-2 w-2 shrink-0 rounded-full bg-accent" aria-hidden="true"></span> }
            </Show>
            <IconButton
                icon="close"
                label={ locale.t('notifications.dismiss') }
                variant="ghost"
                size="sm"
                onClick={ () => props.onDismiss(props.item.id) }
            />
        </div>

        <Show when={ answerable }>
            { () =>
                <div class="flex gap-2 ps-13">
                    <Button
                        variant="primary"
                        size="sm"
                        onClick={ () =>
                        {
                            const request = social.incoming().find((entry) => entry.from === props.item.actor);
                            if (request !== undefined)
                            {
                                void social.accept(request.id);
                            }
                        } }
                    >
                        { locale.t('person.accept') }
                    </Button>
                    <Button
                        variant="ghost"
                        size="sm"
                        onClick={ () =>
                        {
                            const request = social.incoming().find((entry) => entry.from === props.item.actor);
                            if (request !== undefined)
                            {
                                void social.decline(request.id);
                            }
                        } }
                    >
                        { locale.t('person.decline') }
                    </Button>
                </div>
            }
        </Show>
    </div>
}
