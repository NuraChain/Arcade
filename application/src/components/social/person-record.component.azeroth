import AchievementTile from './achievement-tile.component.azeroth';
import RecordStrip from './record-strip.component.azeroth';
import Button from '../ui/button.component.azeroth';
import EmptyState from '../ui/empty-state.component.azeroth';
import Panel from '../ui/panel.component.azeroth';
import LevelBar from './level-bar.component.azeroth';
import SectionHeading from '../ui/section-heading.component.azeroth';
import Skeleton from '../ui/skeleton.component.azeroth';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useRecord } from '../../stores/record.store.ts';

export type RecordPart = 'level' | 'record' | 'achievements' | 'history';

export default component PersonRecord(props: { handle: string; history?: boolean; mine?: boolean; show?: RecordPart[] })
{
    const locale = useLocale();
    const record = useRecord();
    const people = usePeople();
    const catalogue = useCatalogue();

    mount
    {
        record.open(props.handle);

        if (props.history === true)
        {
            void record.more();
        }

        return () => record.close();
    }

    derived parts = props.show ?? (props.history === true ? ['level', 'record', 'achievements', 'history'] : ['level', 'record', 'achievements']);

    derived held = record.record();

    derived progress = held?.progress ?? null;

    derived games = held?.games ?? [];

    derived achievements = held?.achievements ?? [];

    derived earned = achievements.filter((one) => one.earnedAt !== undefined).length;

    const nameOf = (handle: string): string =>
    {
        const person = people.byHandle(handle);

        return person === null ? handle : locale.text(person.displayName);
    };

    const beside = (players: readonly string[]): string =>
        players.filter((one) => one !== props.handle).map(nameOf).join(locale.t('list.separator'));

    <>
        <Show when={ progress !== null && parts.includes('level') }>
            { () => <LevelBar progress={ progress! } mine={ props.mine === true } /> }
        </Show>

        <Show when={ parts.includes('record') }>
            <section>
                <SectionHeading title={ locale.t('record.title') } />

                <Show when={ record.loading() && held === null }>
                { () => <Skeleton class="h-28 w-full rounded-panel" /> }
                </Show>

                <Show when={ !record.loading() && games.length === 0 }>
                { () =>
                    <Panel>
                        <EmptyState icon="dice" title={ locale.t('record.empty') } lead={ locale.t('record.emptyLead') } class="py-6" />
                    </Panel>
                }
                </Show>

                <Show when={ games.length > 0 }>
                { () =>
                    <ul class="grid gap-3 @2xl:grid-cols-2">
                        <For each={ games } key={ (row) => row.game } let={ row }>
                            <li class="min-w-0"><RecordStrip record={ row } /></li>
                        </For>
                    </ul>
                }
                </Show>
            </section>
        </Show>

        <Show when={ achievements.length > 0 && parts.includes('achievements') }>
            { () =>
                <section>
                    <SectionHeading
                        title={ locale.t('achievements.title') }
                        actions={ <span class="tally text-ui-xs text-muted">{ locale.plural('achievements.earned', earned) }</span> }
                    />
                    <ul class="grid gap-2 @xl:grid-cols-2 @4xl:grid-cols-3">
                        <For each={ achievements } key={ (one) => one.id } let={ one }>
                            <li class="min-w-0"><AchievementTile achievement={ one } /></li>
                        </For>
                    </ul>
                </section>
            }
        </Show>

        <Show when={ props.history === true && parts.includes('history') }>
            { () =>
                <section>
                    <SectionHeading title={ locale.t('history.title') } />

                    <Show when={ record.history().length === 0 && !record.historyLoading() && record.historyFailed() }>
                        { () =>
                            <Panel class="flex flex-col items-start gap-2 text-ui-sm text-muted">
                                { locale.t('record.moreFailed') }
                                <Button variant="outline" size="sm" onClick={ () => void record.more() }>
                                    { locale.t('common.retry') }
                                </Button>
                            </Panel>
                        }
                    </Show>

                    <Show when={ record.history().length === 0 && !record.historyLoading() && !record.historyFailed() }>
                        { () => <Panel class="text-ui-sm text-muted">{ locale.t('history.empty') }</Panel> }
                    </Show>

                    <Show when={ record.history().length > 0 }>
                        { () =>
                            <ul class="flex flex-col gap-2">
                                <For each={ record.history() } key={ (row) => row.id } let={ row }>
                                    <li class="flex items-center gap-3 rounded-tile border border-line bg-field px-3 py-2.5">
                                        <span
                                            class={ () => [
                                                'flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-ui-2xs font-bold',
                                                row.result === 'won' ? 'bg-win/15 text-win'
                                                    : (row.result === 'abandoned' ? 'bg-danger/15 text-danger' : 'bg-raised text-muted')
                                            ].join(' ') }
                                        >
                                            { locale.t(`history.result.${ row.result }`) }
                                        </span>
                                        <span class="flex min-w-0 flex-1 flex-col">
                                            <span class="truncate text-ui-sm font-semibold text-text">
                                                { locale.t(catalogue.byId(row.game as never).nameKey) }
                                            </span>
                                            <span class="truncate text-ui-2xs text-muted">
                                                { locale.t('history.against', { players: beside(row.players) }) }
                                            </span>
                                        </span>
                                        <Show when={ row.ratingAfter !== undefined && row.ratingBefore !== undefined }>
                                            { () =>
                                                <span
                                                    class={ () => [
                                                        'tally shrink-0 text-ui-xs font-semibold',
                                                        row.ratingAfter! >= row.ratingBefore! ? 'text-win' : 'text-muted'
                                                    ].join(' ') }
                                                >
                                                    { locale.n(row.ratingAfter!) }
                                                </span>
                                            }
                                        </Show>
                                    </li>
                                </For>
                            </ul>
                        }
                    </Show>

                    <Show when={ record.historyFailed() && record.history().length > 0 }>
                        { () => <p class="mt-3 text-center text-ui-xs text-danger">{ locale.t('record.moreFailed') }</p> }
                    </Show>

                    <Show when={ record.hasMore() && record.history().length > 0 }>
                        { () =>
                            <div class="mt-3 flex justify-center">
                                <Button variant="outline" size="sm" loading={ record.historyLoading() } onClick={ () => void record.more() }>
                                    { locale.t('history.more') }
                                </Button>
                            </div>
                        }
                    </Show>
                </section>
            }
        </Show>
    </>
}
