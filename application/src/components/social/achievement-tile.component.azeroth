import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { AchievementTier } from '../../api.ts';
import type { LocalizedText } from '../../lib/text.ts';

export interface Medal
{
    name: LocalizedText;
    blurb: LocalizedText;
    icon: string;
    tier: AchievementTier;
    earnedAt?: string;
}

export default component AchievementTile(props: { achievement: Medal; class?: string })
{
    const locale = useLocale();

    derived earned = props.achievement.earnedAt !== undefined;

    <div class={ [ 'flex items-center gap-3 p-3', props.class ?? '' ].join(' ') }>
        <span class="medal" data-tier={ earned ? props.achievement.tier : 'locked' } aria-hidden="true">
            <Icon name={ props.achievement.icon as IconName } size={ 20 } />
        </span>

        <div class="min-w-0 flex-1">
            <p class={ () => [ 'truncate text-ui-sm font-semibold', earned ? 'text-text' : 'text-muted' ].join(' ') }>
                { locale.text(props.achievement.name) }
            </p>
            <p class="text-ui-2xs text-muted">{ locale.text(props.achievement.blurb) }</p>
        </div>

        <Show
            when={ earned }
            fallback={
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sunk text-faint">
                    <Icon name="lock" size={ 13 } />
                    <span class="sr-only">{ locale.t('achievements.locked') }</span>
                </span>
            }
        >
            { () =>
                <span class="flex shrink-0 flex-col items-end gap-1">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-live/15 text-live">
                        <Icon name="selected" size={ 14 } />
                        <span class="sr-only">{ locale.t('achievements.earnedOne') }</span>
                    </span>
                    <span class="text-ui-2xs text-faint">{ locale.date(new Date(props.achievement.earnedAt!), { dateStyle: 'medium' }) }</span>
                </span>
            }
        </Show>
    </div>
}
