import { Link } from 'azerothjs';

import { achievementById } from '../../data/mock/achievements.ts';
import { groupById, personById } from '../../data/mock/index.ts';
import type { Activity } from '../../data/mock/types.ts';
import Icon from '../../icons/icon.component.azeroth';
import type { IconName } from '../../icons/registry.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';

const ICON: Record<Activity['kind'], IconName> = {
    played: 'games',
    won: 'trophy',
    joined: 'people',
    achievement: 'medal',
    invited: 'invite'
};

export default component ActivityItem(props: { activity: Activity })
{
    const locale = useLocale();
    const catalogue = useCatalogue();
    const presence = usePresence();

    derived person = personById(props.activity.personId) ?? null;

    derived name = person === null ? props.activity.personId : locale.text(person.name);

    derived game = props.activity.game === null ? '' : locale.t(catalogue.byId(props.activity.game).nameKey);

    derived target = ((): string =>
    {
        if (props.activity.targetId === null)
        {
            return '';
        }
        const group = groupById(props.activity.targetId);
        if (group !== undefined)
        {
            return locale.text(group.name);
        }
        const achievement = achievementById(props.activity.targetId);
        return achievement === undefined ? props.activity.targetId : locale.text(achievement.name);
    })();

    derived text = locale.t(`activity.${ props.activity.kind }`, { name, game, target });

    derived href = props.activity.kind === 'joined' && props.activity.targetId !== null
        ? `/app/groups/${ props.activity.targetId }`
        : (props.activity.game === null ? '/app/games' : `/app/games/${ props.activity.game }`);

    <Link to={ href } class="flex items-center gap-3 rounded-tile px-2 py-2 transition-colors duration-150 hover:bg-raised/60">
        <Avatar person={ person } size="md" presence={ person === null ? null : presence.of(person.id).state } />
        <span class="flex min-w-0 flex-1 flex-col">
            <span class="truncate text-ui-base text-text">{ text }</span>
            <span class="text-ui-xs text-faint">{ locale.relative(props.activity.at) }</span>
        </span>
        <span class={ [ 'flex h-8 w-8 shrink-0 items-center justify-center rounded-full', props.activity.kind === 'won' ? 'bg-win/15 text-win' : 'bg-raised text-muted' ].join(' ') } aria-hidden="true">
            <Icon name={ ICON[props.activity.kind] } size={ 15 } />
        </span>
    </Link>
}
