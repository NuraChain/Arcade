import type { ReportCategory } from '../../data/chat.ts';
import { usePeople } from '../../stores/people.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import type { OverlayProps } from '../../stores/overlay.store.ts';
import { useSocial } from '../../stores/social.store.ts';
import { useToasts } from '../../stores/toasts.store.ts';
import Button from '../ui/button.component.azeroth';
import IconButton from '../ui/icon-button.component.azeroth';
import Toggle from '../ui/switch.component.azeroth';

const CATEGORIES: ReportCategory[] = ['harassment', 'spam', 'cheating', 'inappropriate', 'other'];

/**
 * Filing a report, and choosing whether to show a message with it.
 *
 * `disclose` is passed by whatever opened this sheet - a long press on a message hands over that
 * message and nothing else. The sheet says plainly which of the two is happening, because "report
 * this person" and "show a moderator this sentence" are different acts and somebody should know
 * which one they are performing.
 */
export default component ReportSheet(props: OverlayProps & {
    personId: string;
    disclose?: { conversationId: string; messageId: string; text: string; frankingKey: string };
})
{
    const locale = useLocale();
    const social = useSocial();
    const toasts = useToasts();
    const people = usePeople();

    state category = 'harassment' as ReportCategory;
    state alsoBlock = false;

    derived person = people.byHandle(props.personId);

    derived name = person === null ? props.personId : person.displayName.split(' ')[0];

    /**
     * Files the report, and says what actually happened.
     *
     * It used to show "Report sent" and close before the request resolved, so a refused disclosure -
     * a message that expired, a verification that failed, a network that dropped - read as success
     * and the person believed moderation had their evidence. On a safety surface that is the worst
     * possible failure mode: somebody stops looking for another way to get help.
     */
    const submit = async (): Promise<void> =>
    {
        try
        {
            await social.report(props.personId, category, props.disclose);
        }
        catch
        {
            toasts.show({ kind: 'error', text: locale.t('report.failed') });
            return;
        }

        if (alsoBlock)
        {
            await social.block(props.personId).catch(() => undefined);
        }

        toasts.show({ kind: 'success', text: locale.t('report.sent') });
        props.close(true);
    };

    <div class="flex flex-col gap-5 p-5">
        <header class="flex items-start justify-between gap-3">
            <div>
                <h2 class="title text-ui-xl text-text">{ locale.t('report.title', { name }) }</h2>
                <p class="mt-2 text-ui-base text-muted">{ locale.t('report.lead') }</p>

                <Show when={ props.disclose !== undefined }>
                    { () =>
                        <p class="mt-3 rounded-tile border border-line bg-sunk px-3 py-2 text-ui-sm text-muted">
                            <span class="block text-ui-xs text-faint">{ locale.t('report.showing') }</span>
                            <span dir="auto" class="mt-1 block text-text">{ props.disclose?.text }</span>
                        </p>
                    }
                </Show>
            </div>
            <IconButton icon="close" label={ locale.t('common.close') } variant="ghost" onClick={ () => props.close(false) } />
        </header>

        <fieldset>
            <legend class="sr-only">{ locale.t('report.title', { name }) }</legend>
            <ul class="flex flex-col gap-1">
                <For each={ CATEGORIES } key={ (entry) => entry } let={ entry }>
                    <li>
                        <button
                            type="button"
                            class={ [
                                'flex min-h-12 w-full cursor-pointer items-center gap-3 rounded-tile border px-3 text-start text-ui-base transition-colors',
                                category === entry ? 'border-danger bg-danger/10 text-text' : 'border-line text-muted hover:bg-raised/60'
                            ].join(' ') }
                            aria-pressed={ category === entry }
                            onClick={ () => category = entry }
                        >
                            <span class={ [
                                'flex h-5 w-5 shrink-0 items-center justify-center rounded-full border',
                                category === entry ? 'border-danger bg-danger' : 'border-line'
                            ].join(' ') } aria-hidden="true"></span>
                            { locale.t(`report.category.${ entry }`) }
                        </button>
                    </li>
                </For>
            </ul>
        </fieldset>

        <Toggle checked={ alsoBlock } label={ locale.t('report.alsoBlock') } onChange={ (checked) => alsoBlock = checked } />

        <div class="flex flex-col gap-2 sm:flex-row-reverse">
            <Button variant="destructive" block leading="report" onClick={ submit }>{ locale.t('report.submit') }</Button>
            <Button variant="ghost" block onClick={ () => props.close(false) }>{ locale.t('common.cancel') }</Button>
        </div>
    </div>
}
