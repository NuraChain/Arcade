import { Link } from 'azerothjs';

import type { Person } from '../../data/person.ts';
import { useCatalogue } from '../../stores/catalogue.store.ts';
import { useLocale } from '../../stores/locale.store.ts';
import { usePresence } from '../../stores/presence.store.ts';
import Avatar from '../ui/avatar.component.azeroth';
import Rail from '../ui/rail.component.azeroth';

export default component PeopleStrip(props: { people: Person[]; label: string; class?: string })
{
    const locale = useLocale();
    const presence = usePresence();
    const catalogue = useCatalogue();

    const status = (person: Person): string =>
    {
        const current = presence.of(person.id);
        if (!current.known)
        {
            return `@${ person.handle }`;
        }
        if (current.state === 'playing' && current.game !== null)
        {
            return locale.t(catalogue.byId(current.game).nameKey);
        }
        return current.state === 'away' ? locale.t('common.away') : locale.t('common.online');
    };

    <Rail label={ props.label } class={ [ '-mx-4 sm:-mx-6 lg:-mx-8', props.class ?? '' ].filter(Boolean).join(' ') } inner="gap-3 px-4 pb-1 scroll-px-4 sm:px-6 sm:scroll-px-6 lg:px-8 lg:scroll-px-8">
        <For each={ props.people } key={ (person) => person.id } let={ person }>
            <div class="shrink-0 snap-start">
                <Link to={ `/app/people/${ person.handle }` } class="flex w-[4.75rem] flex-col items-center gap-1.5 rounded-tile py-1 text-center" prefetch="hover">
                    <Avatar person={ person } size="lg" presence={ presence.dot(person.id) } />
                    <span class="w-full truncate text-ui-xs font-semibold text-text">{ person.displayName.split(' ')[0] }</span>
                    <span class="w-full truncate text-ui-2xs text-faint">{ status(person) }</span>
                </Link>
            </div>
        </For>
    </Rail>
}
