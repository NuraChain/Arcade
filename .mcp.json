{
    "mcpServers": {
        "blender": {
            "command": "uvx",
            "args": ["blender-mcp"]
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@playwright/mcp@latest"],
            "env": {}
        },
        "context7": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp"
        },
        "ui-ux-suite": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "ui-ux-suite@0.6.1", "--mcp"],
            "env": {}
        }
    }
}
