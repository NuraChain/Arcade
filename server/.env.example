# The api half. Copy to server/.env and adjust.
#
# Every variable here is declared in server/src/env.ts through `loadConfig`, which reports all
# missing ones in a single boot error rather than dying on the first.

# The port this process binds. 3200, because vite holds 3100 and Explorer reserves 3000/3001.
PORT=3200

NODE_ENV=development

# The database. Create it once with:
#   psql -U postgres -c "create database nura_games"
DATABASE_URL=postgres://postgres:root@127.0.0.1:5432/nura_games
DATABASE_POOL_MAX=10

# Signs session cookies and realtime tickets. There is no default and there must not be one:
# `serializeCookie` has no `signed` option and the framework ships no keyring, so this value is
# the only thing standing between a cookie and a forged session.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The origin the browser actually uses. It is the SIWE `domain` and `URI`, the WebSocket origin
# check, and the cookie's site. Never derived from a request header - a header is
# attacker-controlled, and this value decides what a signature means.
PUBLIC_ORIGIN=http://localhost:3100

# The chain a wallet signature is made against, as a DECIMAL EIP-155 id. It is the SIWE message's
# `Chain ID` field, which parsers read as a number - a chain NAME there is rejected by every one
# of them. Empty means "whatever network the wallet is already on", and no switch is requested.
NURA_CHAIN_ID=

# A JSON-RPC url, used only for the ERC-1271 `eth_call` that verifies a smart-contract wallet
# (a Safe, say). Without it a contract wallet cannot sign in; ordinary key-holding wallets are
# verified locally and need nothing here.
NURA_RPC_URL=

# Requests a minute per address, for /api and /ws. The responsive matrix pulls 600 pages from
# one address as fast as it can, which is abusive traffic by any honest measure - raise this for
# a load run rather than shipping a limit shaped around a test.
API_RATE_MAX=600

# Serving the built client from this process. Off in development, where vite owns the browser
# and proxies /api, /ws and /_image here.
SERVE_PAGES=false

# Stack traces point into dist/ without this, because the CLI spawns node with no flags.
NODE_OPTIONS=--enable-source-maps
