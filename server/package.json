{
  "name": "nura-games-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "azeroth dev",
    "build": "tsc -p tsconfig.json",
    "check": "azeroth check",
    "check:tests": "tsc --noEmit -p tsconfig.test.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shuffle": "vitest run --sequence.shuffle",
    "test:db": "vitest run --no-file-parallelism .db.spec. seat-race.spec.",
    "test:ws": "vitest run --config vitest.socket.config.ts",
    "schema:sync": "npm run build && node dist/db/sync-cli.js"
  },
  "dependencies": {
    "@azerothjs/cron": "2.1.0",
    "@azerothjs/http": "2.1.0",
    "@azerothjs/kit": "2.1.0",
    "@azerothjs/logger": "2.1.0",
    "@azerothjs/schema": "2.1.0",
    "@azerothjs/ws": "2.1.0",
    "azerothjs": "2.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@azerothjs/cli": "2.1.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
