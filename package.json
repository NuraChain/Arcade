{
    "name": "nura-games",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=24.11.0"
    },
    "workspaces": [
        "application",
        "server"
    ],
    "scripts": {
        "dev": "azeroth dev",
        "build": "azeroth build && node tools/budgets.mjs",
        "check": "azeroth check && npm run check:tests --workspace server",
        "test": "azeroth test",
        "test:watch": "npm run test:watch --workspace application",
        "test:shuffle": "npm run test:shuffle --workspaces --if-present",
        "start": "npm start --workspace server",
        "schema:sync": "npm run schema:sync --workspace server",
        "assets": "node tools/blender/build.mjs",
        "art": "node tools/art/games.mjs && node tools/art/boards.mjs && node tools/art/deck.mjs && node tools/art/raster.mjs",
        "qa": "node tools/qa/matrix.mjs",
        "sound": "node tools/art/sound.mjs"
    },
    "devDependencies": {
        "@azerothjs/cli": "2.1.0",
        "playwright": "^1.63.0"
    }
}
